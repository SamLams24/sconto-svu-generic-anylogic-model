			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000830</Id>
					<Name><![CDATA[decider]]></Name>
					<X>210</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();
// C14.50 -- CAUSE RACINE FINALE de la desynchronisation. Cette fonction
// (decider(), appelee par cycleDecision toutes les 10s sur les 55 agents)
// ECRASAIT l'etat calcule par analyserEtat() (qui tourne toutes les 2s sur
// l'occupation REELLE des postes). Deux fonctions concurrentes pilotaient donc
// le meme champ etatHolon avec des logiques incompatibles :
//   - analyserEtat() : etat physique reel (file/traitement en cours)
//   - decider()      : moyenne CUMULEE d'attente (k.avgWaitTime()), qui ne
//                      redescend quasiment jamais et ne reflete aucun etat
//                      instantane
// "NORMAL" etant mappe sur le VERT dans couleurOperational() au meme titre que
// "WORKING", des dizaines d'agents viraient au vert simultanement des que
// leurs moyennes passaient sous le seuil -- typiquement apres la cloture d'une
// commande -- alors qu'aucune entite ne les traversait. C'est exactement le
// symptome observe : "tous ces voyants passent au vert" sans flux reel.
// decider() n'ecrit plus dans etatHolon : analyserEtat() devient la source
// unique de verite pour l'affichage, coherente avec la vue des micro-activites.
// Le suivi de surcharge reste disponible via les KPI et l'etat GOULOT.
if (main == null || main.board == null) return;
double wt = 0;
boolean trouve = false;
for (PosteGenericAgent p : postesLies) {
    KPIBundle k = main.board.kpiParPoste.get(main.cleKPI(p));
    if (k != null) { wt = Math.max(wt, k.avgWaitTime()); trouve = true; }
}
if (!trouve) return;
surchargeDetectee = (wt > seuilSurcharge);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000831</Id>
					<Name><![CDATA[executerTache]]></Name>
					<X>210</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instruction]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[Main main = (Main) getOwner();
if ("ACTIVER".equals(instruction)) {
    etatHolon = "ACTIF";
    if (main != null && main.board != null) main.board.logEvent("[OPERATIONAL] " + idPoste + " active");
} else if ("PAUSE".equals(instruction)) {
    etatHolon = "EN_PAUSE";
} else if ("PRIORITE_HAUTE".equals(instruction)) {
    etatHolon = "PRIORITAIRE";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781622427964</Id>
					<Name><![CDATA[initialiser]]></Name>
					<X>210</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// codeSCOR ici est la CLEF DE GROUPE complete (ex "ACT_4|M1.3"), pas le
// code SCOR individuel du poste. Le libelle lisible ([XXX] N3) est calcule
// separement pour l'affichage (badges/pastilles), sans jamais servir de clef.
Main main = (Main) getOwner();
this.idPoste   = p.idPoste;
this.nomPoste  = p.nom;
this.codeSCOR  = codeSCOR;
this.libelleAffichage = main.libelleGroupeF(p);
this.roleHolonique = main.rolePourCodeSCOR(p.codeSCOR);
this.strategieRealisation = main.strategieDepuisCodeSCOR(p.codeSCOR);
this.idTactiqueRattache = main.idTactiquePourCodeSCOR(p.codeSCOR);
this.idCoordinateurRattache = main.idCoordinateurPourCodeSCOR(p.codeSCOR);
this.idSuperviseurRattache = main.idSuperviseurPourCodeSCOR(p.codeSCOR);
this.idRoleHierarchique = Main.ROLE_SUPERVISEUR.equals(this.roleHolonique)
    ? this.idSuperviseurRattache
    : (Main.ROLE_EXECUTION.equals(this.roleHolonique) ? "AOe-s" + main.codeN3Architecture(p.codeSCOR) : this.roleHolonique);
this.categorieOP = Main.ROLE_SUPERVISEUR.equals(this.roleHolonique) ? "PILOTAGE" : "EXECUTION";
this.idActeurSC = p.idActeurResponsable;
this.nomActeurSC = p.nomActeurResponsable;
this.postesLies.add(p);
this.etatHolon = "IDLE";

this.surchargeDetectee = false;

this.tDernierMessageAER = -1;
this.tEntreeEtatCourant = time();

main.board.logEvent(
    "[HOLON-OP] " + idPoste + " (" + nomPoste + ") initialisé"
    + " | groupe=" + libelleAffichage
    + " | ISA-95 N" + p.niveauISA95
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1799300000020</Id>
					<Name><![CDATA[ajouterPosteLie]]></Name>
					<X>210</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Body><![CDATA[// Rattache un poste supplementaire a un operationnel DEJA existant
// (regroupement global par (acteur, SCOR N3) : voir Main.recalculerTousLesGroupesOperationnels()).
// Le nom du poste "chef de file" (nomPoste) et le libelle d'affichage NE
// changent PAS a chaque ajout : concatener tous les noms rendait le badge
// illisible des le 2e poste rattache. Le detail des postes du groupe reste
// consultable via postesLies (ex. dans un rapport ou une infobulle).
this.postesLies.add(p);
((Main) getOwner()).board.logEvent(
    "[HOLON-OP] " + p.nom + " rattache au groupe " + libelleAffichage + " (operationnel " + idPoste + ")"
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000007201</Id>
					<Name><![CDATA[signalerPanne]]></Name>
					<X>210</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[posteEnPanne]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[dureeEstimeeSec]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Escalade IMMEDIATE au moment ou une panne survient, sans attendre le
// prochain cycle regulier de analyserEtat() (jusqu'a 10s de latence).
// Reutilise le meme canal AER que les goulots, avec le sujet "PANNE".
Main main = (Main) getOwner();
BlackboardAgent board = main.board;
if (board == null) return;

etatHolon = "PANNE";
tEntreeEtatCourant = time();
nbGoulotsDetectes++;
nbAlertesEmises++;

AERMessage msg = new AERMessage(
    AERMessage.REPORT,
    posteEnPanne.idPoste,
    (idSuperviseurRattache == null || idSuperviseurRattache.isEmpty()) ? "AOp-" + main.macroPrefixe(codeSCOR) : idSuperviseurRattache,
    "PANNE",
    "duree_estimee=" + String.format("%.0f", dureeEstimeeSec) + "s"
    + ";poste=" + posteEnPanne.nom,
    time()
);
board.logEvent("[HOLON-OP] " + idPoste + " -> PANNE (poste " + posteEnPanne.nom
    + ", duree estimee " + String.format("%.0f", dureeEstimeeSec / 60.0) + " min)");

board.journaliserAER(
    "OPERATIONNEL_RAPPORTE",
    msg,
    "Panne signalée par l'agent opérationnel d'exécution ; poste=" + posteEnPanne.idPoste
);
board.publierAlerte(msg);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781622490774</Id>
					<Name><![CDATA[analyserEtat]]></Name>
					<X>210</X><Y>160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (postesLies == null || postesLies.isEmpty()) return;
// Bloc A.5 -- C14.54 : recalculerTousLesGroupesOperationnels() cree 1
// OperationalAgent par (acteur, code SCOR N3) SUR TOUS LES POSTES DU MODELE,
// Plan (codes Px.y, roleHolonique=TACTIQUE) compris. Cette porte restreignait
// encore la mise a jour d'etatHolon aux roles SUPERVISEUR/EXECUTION : les
// groupes Plan (ex. sP2.4.1, sP3.4.1, sP4.4.x, tous traverses par des jetons
// visuels de commande reels) recevaient bien une pastille dans la grille
// OperationalAgents, mais elle restait figee a "IDLE" (valeur d'initialisation)
// A VIE, quel que soit le flux reel les traversant -- contrairement a
// Source/Make/Deliver/Return. Le garde n'a plus lieu d'etre : le filtre
// precedent (postesLies vide) suffit deja a exclure les groupes purement
// Strategique/Tactique sans poste physique rattache ; ceux qui EN ONT un
// (comme les groupes Plan) doivent refleter leur occupation reelle au meme
// titre que Source/Make/Deliver/Return. Portage generique du correctif
// collegue (reference/colleague, C14.54) -- aucun changement de routage/
// production, uniquement de la representation d'etat.

Main main = (Main) getOwner();
BlackboardAgent board = main.board;

// ── Lecture de l'état physique agrégé sur tous les postes du groupe ──
int tailleFile = 0;
int enTraitement = 0;
double wtMoyen = 0;
double ctMoyen = 0;
// Bloc A.5 -- C14.52 : un jeton VISUEL SEUL (ex. animation MTS servie depuis
// le stock) trace toujours une commande REELLE, mais ne doit jamais compter
// dans fileReelle/wtMoyen (aucun risque de faux GOULOT) -- sa PRESENCE
// COURANTE sert seulement a distinguer WORKING de IDLE ci-dessous. Portage
// generique du correctif collegue (reference/colleague, C14.52).
boolean visuelEnCours = false;
// C14.27 -- ETAT REEL INSTANTANE au lieu d'une moyenne cumulee. wtMoyen lisait
// auparavant kpi.avgWaitTime(), une moyenne cumulee depuis le debut du run qui
// ne redescend quasiment jamais (voir C14.21/C14.24). Une fois le seuil franchi
// une seule fois, le poste restait affiche en GOULOT indefiniment meme si sa
// file etait vide au moment de l'observation -- incoherent avec la vue des
// micro-activites qui montre l'etat reel. wtMoyen mesure desormais le temps
// d'attente REELLEMENT en cours pour l'entite la plus ancienne encore en file,
// a l'instant present.
// C14.49 -- CAUSE RACINE de la desynchronisation vue hierarchique / vue
// micro-activites. tailleFile et enTraitement comptaient p.queue.size() et
// p.delay.size() BRUTS, donc y compris les jetons purement VISUELS
// (VISUEL_*, TRACE_VISUEL_SCOR) utilises pour animer le schema. Consequence
// exacte du symptome observe : apres la cloture d'une commande,
// lancerFluxVisuelDeliverClient() lance un jeton visuel qui parcourt toute la
// chaine Deliver ; chaque poste traverse passait alors a WORKING (vert) alors
// qu'AUCUN flux reel ne s'y trouvait -- d'ou "tous les voyants passent au vert
// quelques secondes apres la livraison". A l'inverse, un jeton visuel qui
// traverse un poste entre deux ticks d'observation (2s) n'etait jamais vu, ce
// qui explique que certains voyants "ne repondaient pas". Seules les entites
// METIER reelles determinent desormais l'occupation, comme sur la vue des
// micro-activites.
for (PosteGenericAgent p : postesLies) {
    // C14.51 -- CORRECTIF DU CORRECTIF (C14.49). Le for-each Java sur p.queue
    // / p.delay peut echouer silencieusement selon le comportement exact des
    // blocs Queue/Delay d'AnyLogic ; le "catch" precedent revenait alors,
    // SANS AUCUNE ERREUR VISIBLE, a p.queue.size()/p.delay.size() -- c'est a
    // dire exactement le comportement bugue d'avant C14.49, jetons visuels
    // inclus. Remplace par un acces indexe via .get(i), dont on sait qu'il
    // fonctionne (deja utilise ailleurs avec succes), et SANS repli sur
    // .size() en cas d'erreur : en cas de probleme, l'entite concernee est
    // simplement ignoree plutot que de fausser le compte dans le mauvais sens.
    int fileReelle = 0;
    int traitementReel = 0;
    int nq = p.queue.size();
    for (int qi = 0; qi < nq; qi++) {
        try {
            FluxEntity e = p.queue.get(qi);
            if (e != null && !main.estFluxVisuelSeulement(e)) fileReelle++;
            if (e != null && main.estFluxVisuelSeulement(e)) visuelEnCours = true;
        } catch (Throwable ignored) {}
    }
    int nd = p.delay.size();
    for (int di = 0; di < nd; di++) {
        try {
            FluxEntity e = p.delay.get(di);
            if (e != null && !main.estFluxVisuelSeulement(e)) traitementReel++;
            if (e != null && main.estFluxVisuelSeulement(e)) visuelEnCours = true;
        } catch (Throwable ignored) {}
    }

    tailleFile   += fileReelle;
    enTraitement += traitementReel;

    KPIBundle kpi = board.kpiParPoste.get(main.cleKPI(p));
    if (kpi != null) {
        ctMoyen = Math.max(ctMoyen, kpi.avgCycleTime());
    }
    // Attente reelle : premiere entite METIER encore en file (les jetons
    // visuels ne doivent pas non plus declencher un faux GOULOT).
    for (int qi = 0; qi < nq; qi++) {
        try {
            FluxEntity e = p.queue.get(qi);
            if (e != null && !main.estFluxVisuelSeulement(e)) {
                wtMoyen = Math.max(wtMoyen, time() - e.tDebutAttente);
                break;
            }
        } catch (Throwable ignored) {}
    }
}
boolean positionOccupee = (tailleFile > 0 || enTraitement > 0);

// ── Panne en cours ? Prioritaire sur la determination normale ────
boolean panneActive = false;
for (PosteGenericAgent p : postesLies) {
    if (p.enPanne) { panneActive = true; break; }
}

// ── Détermination de l'état holonique ────────────────────────────
String nouvelEtat;
if (panneActive) {
    nouvelEtat = "PANNE";
} else if (tailleFile > seuilAlertFile || wtMoyen > seuilGoulotWT) {
    // C14.27 -- goulot determine sur l'etat REEL courant (file actuelle et
    // attente actuelle de l'entite la plus ancienne), plus sur une moyenne
    // historique. Un poste desengorge repasse donc bien a WORKING/IDLE des
    // que sa file se vide, conformement a ce qui est visible sur la vue des
    // micro-activites.
    nouvelEtat = "GOULOT";
} else if (!positionOccupee) {
    // C14.52 -- un jeton visuel present (sans entite metier physique) signale
    // qu'une commande reelle traverse ce poste (ex. animation MTS) : WORKING
    // transitoire, jamais GOULOT/PANNE (voir boucle ci-dessus).
    nouvelEtat = visuelEnCours ? "WORKING" : "IDLE";
} else {
    nouvelEtat = "WORKING";
}

// ── Transition d'état : log uniquement si changement ─────────────
if (!nouvelEtat.equals(etatHolon)) {
    etatHolon = nouvelEtat;
    tEntreeEtatCourant = time();
    // C14.13 -- les passages a IDLE ne sont plus logges : chaque poste y
    // revient apres chaque entite, ce qui noyait la console. Les etats
    // significatifs (WORKING, PANNE, BLOQUE...) restent traces.
    // C14.15 -- logs [HOLON-OP] entierement desactives (transitions d'etat
    // trop frequentes). L'etat courant reste lisible sur chaque poste.
}

// ── Mise à jour du flag goulot sur TOUS les postes du groupe ──────
for (PosteGenericAgent p : postesLies) {
    p.goulot = etatHolon.equals("GOULOT") || etatHolon.equals("PANNE");
}

// ── Émission alerte AER vers CoordinatorAgent si GOULOT ou PANNE ──
if (etatHolon.equals("GOULOT") || etatHolon.equals("PANNE")) {
    nbGoulotsDetectes++;
    nbAlertesEmises++;

    // Construire le message AER (Amendment → décision remontée)
    AERMessage msg = new AERMessage(
        AERMessage.REPORT,
        idPoste,
        (idSuperviseurRattache == null || idSuperviseurRattache.isEmpty()) ? "AOp-" + main.macroPrefixe(codeSCOR) : idSuperviseurRattache,
        etatHolon,
        "poste=" + idPoste
        + ";WT=" + String.format("%.2f", wtMoyen)
        + ";file=" + tailleFile
        + ";tempsTraitement=" + String.format("%.2f", ctMoyen),
        time()
    );

    // Publication réelle dans le Blackboard : l'agent opérationnel d'exécution
    // ne court-circuite plus le niveau tactique. Le TacticalAgent de son macro-
    // processus lit cette alerte, l'arbitre, puis escalade vers la supervision.
    board.journaliserAER(
        "OPERATIONNEL_RAPPORTE",
        msg,
        "Alerte émise par l'agent opérationnel d'exécution ; poste=" + idPoste
        + "; codeSCOR=" + codeSCOR + "; file=" + tailleFile
    );
    board.publierAlerte(msg);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781622520217</Id>
					<Name><![CDATA[getRapportHolon]]></Name>
					<X>250</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (postesLies == null || postesLies.isEmpty()) return idPoste + " : non initialisé";

BlackboardAgent board = ((Main) getOwner()).board;
double ct = 0, wt = 0; long n = 0; int tailleFile = 0;
for (PosteGenericAgent p : postesLies) {
    KPIBundle kpi = board.kpiParPoste.get(((Main) getOwner()).cleKPI(p));
    if (kpi != null) {
        ct = Math.max(ct, kpi.avgCycleTime());
        wt = Math.max(wt, kpi.avgWaitTime());
        n += kpi.count;
    }
    tailleFile += p.queue.size();
}

double dureeDansEtat = time() - tEntreeEtatCourant;

return String.format(
    "[%s] %-18s %-6s | Etat:%-8s (%5.0fs) | file:%2d | Temps traitement:%5.1fs | Attente:%5.1fs | N:%d | G:%d",
    idPoste, nomPoste, codeSCOR, etatHolon, dureeDansEtat,
    tailleFile, ct, wt, n, nbGoulotsDetectes
);]]></Body>
				</Function>
			</Functions>
