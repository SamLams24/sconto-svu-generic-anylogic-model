					<TextCode><![CDATA["Somme actuelle : " + String.format("%.3f", champPoidsRL + champPoidsRS + champPoidsAG + champPoidsCO + champPoidsAM) + (Math.abs(champPoidsRL + champPoidsRS + champPoidsAG + champPoidsCO + champPoidsAM - 1.0) <= 0.001 ? " (valide)" : " (DOIT VALOIR 1.000)")]]></TextCode>
