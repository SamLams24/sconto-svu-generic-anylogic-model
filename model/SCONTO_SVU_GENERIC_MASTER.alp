java.util.LinkedHashSet<String> noms = new java.util.LinkedHashSet<String>();
for (FicheMatiere f : fichesMatiere) noms.add(f.idMatiere);
for (ScenarioFlux sc : scenarios) {
    for (LigneNomenclature l : sc.nomenclature) noms.add(l.idMatiere);
}
if (noms.isEmpty()) return new String[] { "" };
return noms.toArray(new String[0]);]]></Body>
