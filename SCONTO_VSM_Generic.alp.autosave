					<Id>1781897581952</Id>
					<Name><![CDATA[tableDashboardMacroSCORText]]></Name>
					<X>-300</X><Y>1800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {22, 10, 12, 12, 12, 14, 8, 8};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "DASHBOARD — KPI AGREGEES PAR MACRO-PROCESSUS SCOR",
        w
    ));

    sb.append(tableRow(new String[]{
        "Macro-processus",
        "N echant.",
        "CT moy (s)",
        "WT moy (s)",
        "LT moy (s)",
        "PCE % (avec taux VA)",
        "Rebuts",
        "Rework"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (board.kpiParMacro == null || board.kpiParMacro.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", "0", "0", "0", "0", "0", "0", "0"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    for (java.util.Map.Entry<String, KPIBundle> e : board.kpiParMacro.entrySet()) {
        KPIBundle k = e.getValue();
        String code = e.getKey();
        String libelle = code + " (" + libelleMacroProcessusSCOR(code) + ")";

        sb.append(tableRow(new String[]{
            libelle,
            String.valueOf(k.count),
            fmt2(k.avgCycleTime()),
            fmt2(k.avgWaitTime()),
            fmt2(k.avgLeadTime()),
            fmt1(k.pce() * 100),
            String.valueOf(k.nbRebut),
            String.valueOf(k.nbRework)
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

    return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
