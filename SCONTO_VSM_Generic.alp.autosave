			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781100000040</Id>
					<Name><![CDATA[notifierPassage]]></Name>
					<X>50</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cycleTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[waitTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[vat]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[ if (codeSCOR == null || codeSCOR.isEmpty()) return;

    String microKey = (idPoste != null && !idPoste.isEmpty()) ? idPoste : codeSCOR;

    // 1. Agrégation par micro-activité réelle
    KPIBundle bMicro = kpiParMicroActivite.get(microKey);
    if (bMicro == null) {
        bMicro = new KPIBundle();
        kpiParMicroActivite.put(microKey, bMicro);
    }
    bMicro.count++;
    bMicro.sumCycleTime += cycleTime;
    bMicro.sumWaitTime += waitTime;
    bMicro.sumVAT += vat;

    // 2. Agrégation existante par code SCOR N3
    KPIBundle bPoste = kpiParPoste.get(codeSCOR);
    if (bPoste == null) {
        bPoste = new KPIBundle();
        kpiParPoste.put(codeSCOR, bPoste);
    }
    bPoste.count++;
    bPoste.sumCycleTime += cycleTime;
    bPoste.sumWaitTime += waitTime;
    bPoste.sumVAT += vat;

    // 3. Agrégation macro SCOR
    // codeSCOR peut etre une clef composite "IDACTEUR|N3" (ex "ACT_4|M1.3"). On
    // extrait le N3 pur, puis on utilise la MEME convention de prefixe macro que
    // celle lue par les TacticalAgent/Coordinateurs (sS/sM/sD/sR via macroPrefixe),
    // sinon la cle serait "M1"/"S1"... et kpiParMacro.get("sM") renverrait toujours
    // null -> couleurs tactiques/coordinateurs figees en vert.
    String n3Pur = codeSCOR.contains("|") ? codeSCOR.substring(codeSCOR.indexOf('|') + 1) : codeSCOR;
    String macro = ((Main) getOwner()).macroPrefixe(n3Pur);
    KPIBundle bMacro = kpiParMacro.get(macro);
    if (bMacro == null) {
        bMacro = new KPIBundle();
        kpiParMacro.put(macro, bMacro);
    }
    bMacro.count++;
    bMacro.sumCycleTime += cycleTime;
    bMacro.sumWaitTime += waitTime;
    bMacro.sumVAT += vat;

    // 4. Trace d’agrégation
    Main main = (Main) getOwner();

    main.addTrace(
        "AGG_MICRO",
        "BlackboardAgent",
        "",
        microKey,
        codeSCOR,
        "KPI_UPDATE",
        "CT_MOY",
        cycleTime,
        "s",
        "MICRO_ACTIVITE",
        bMicro.avgCycleTime(),
        "sumCycleTime / count",
        "Agrégation dynamique par micro-activité"
    );

    main.addTrace(
        "AGG_SCOR",
        "BlackboardAgent",
        "",
        microKey,
        codeSCOR,
        "KPI_UPDATE",
        "PCE",
        vat,
        "ratio",
        "SCOR_N3",
        bPoste.pce() * 100,
        "sumVAT / (sumCycleTime + sumWaitTime)",
        "Agrégation dynamique au niveau SCOR N3"
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781100000041</Id>
					<Name><![CDATA[notifierFin]]></Name>
					<X>50</X><Y>430</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[leadTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[waitTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[vat]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[typeProduit]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[totalTerminees++;
kpiGlobal.count++; kpiGlobal.sumCycleTime += leadTime; kpiGlobal.sumWaitTime += waitTime; kpiGlobal.sumVAT += vat;
if (typeProduit != null && typeProduit.toUpperCase().contains("MTO")) {
    nbMTO++;
    sumLeadTimeMTO += leadTime;
} else {
    nbMTS++;
    sumLeadTimeMTS += leadTime;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000022</Id>
					<Name><![CDATA[notifierRebut]]></Name>
					<X>50</X><Y>470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[totalRebuts++;
String n3PurR = (codeSCOR != null && codeSCOR.contains("|")) ? codeSCOR.substring(codeSCOR.indexOf('|') + 1) : codeSCOR;
String macro = ((Main) getOwner()).macroPrefixe(n3PurR);

KPIBundle bp = kpiParPoste.get(codeSCOR);
if (bp == null) { bp = new KPIBundle(); kpiParPoste.put(codeSCOR, bp); }
bp.nbRebut++;

KPIBundle bm = kpiParMacro.get(macro);
if (bm == null) { bm = new KPIBundle(); kpiParMacro.put(macro, bm); }
bm.nbRebut++;

// Correction : faire remonter le rebut aussi sur la cle micro-activite,
// sinon les tableaux "Dashboard Micro-activites" affichent toujours 0 rebuts.
if (idPoste != null && !idPoste.isEmpty()) {
    KPIBundle bMicro = kpiParMicroActivite.get(idPoste);
    if (bMicro == null) { bMicro = new KPIBundle(); kpiParMicroActivite.put(idPoste, bMicro); }
    bMicro.nbRebut++;
}

logEvent("REBUT detecte @ " + (idPoste != null && !idPoste.isEmpty() ? idPoste + " " : "") + "[" + codeSCOR + "]");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000023</Id>
					<Name><![CDATA[notifierRework]]></Name>
					<X>50</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[totalRework++;
// idPoste est l'idPoste ; on retrouve la clef composite (acteur,N3) via Main
Main mainRef = (Main) getOwner();
PosteGenericAgent p = mainRef.trouverPoste(idPoste);
if (p != null) {
    String code = mainRef.cleKPI(p);
    String macro = mainRef.macroPrefixe(p.codeSCOR);

    KPIBundle bp = kpiParPoste.get(code);
    if (bp == null) { bp = new KPIBundle(); kpiParPoste.put(code, bp); }
    bp.nbRework++;

    KPIBundle bm = kpiParMacro.get(macro);
    if (bm == null) { bm = new KPIBundle(); kpiParMacro.put(macro, bm); }
    bm.nbRework++;
}

// Correction : faire remonter le rework aussi sur la cle micro-activite
KPIBundle bMicro = kpiParMicroActivite.get(idPoste);
if (bMicro == null) { bMicro = new KPIBundle(); kpiParMicroActivite.put(idPoste, bMicro); }
bMicro.nbRework++;

logEvent("REWORK @ " + idPoste);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781100000042</Id>
					<Name><![CDATA[avgWIP]]></Name>
					<X>50</X><Y>490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (wipSnapshots.isEmpty()) return 0;
double sum = 0;
for (double v : wipSnapshots) sum += v;
return sum / wipSnapshots.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781100000043</Id>
					<Name><![CDATA[logEvent]]></Name>
					<X>50</X><Y>550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[message]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String entry = String.format("[T=%.1f] %s", time(), message);
logEvenements.add(entry);
if (logEvenements.size() > 200) logEvenements.remove(0);
traceln(entry);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781100000044</Id>
					<Name><![CDATA[reset]]></Name>
					<X>250</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[kpiParPoste.clear(); kpiParMacro.clear();
kpiGlobal = new KPIBundle(); wipSnapshots.clear(); logEvenements.clear();
totalTerminees = 0; totalRebuts = 0; totalRework = 0;
nbMTS = 0; nbMTO = 0; sumLeadTimeMTS = 0; sumLeadTimeMTO = 0;

kpiParMicroActivite.clear();

alertesPubliees.clear();
alertesParPoste.clear();
historiqueGoulots.clear();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
