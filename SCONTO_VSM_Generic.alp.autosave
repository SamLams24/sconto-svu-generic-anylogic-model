		<JavaClass>
			<Id>1782600000100</Id>
			<Name><![CDATA[SimpleJsonWriter]]></Name>
			<Text><![CDATA[/**
 * Sérialiseur JSON minimal — ne nécessite aucune dépendance externe.
 * Gère : Map (LinkedHashMap recommandé), List, String, Number, Boolean, null.
 * Produit un JSON indenté, UTF-8, avec échappement correct des caractères spéciaux.
 */
public class SimpleJsonWriter {

    /** Convertit une Map racine en JSON indenté. */
    public static String toJson(java.util.Map<String,Object> root, int indent) {
        StringBuilder sb = new StringBuilder();
        writeMap(sb, root, indent);
        return sb.toString();
    }

    private static void writeValue(StringBuilder sb, Object v, int indent) {
        if (v == null) {
            sb.append("null");
        } else if (v instanceof Boolean) {
            sb.append(((Boolean) v).booleanValue() ? "true" : "false");
        } else if (v instanceof Number) {
            // Éviter la notation scientifique pour les entiers stockés comme double
            double d = ((Number) v).doubleValue();
            if (d == Math.floor(d) && !Double.isInfinite(d) && Math.abs(d) < 1e15) {
                sb.append((long) d);
            } else {
                sb.append(v.toString());
            }
        } else if (v instanceof java.util.Map) {
            writeMap(sb, (java.util.Map) v, indent);
        } else if (v instanceof java.util.List) {
            writeList(sb, (java.util.List) v, indent);
        } else {
            // String
            sb.append('"').append(escapeJson(v.toString())).append('"');
        }
    }

    private static void writeMap(StringBuilder sb, java.util.Map m, int indent) {
        if (m == null || m.isEmpty()) { sb.append("{}"); return; }
        String pad  = spaces(indent + 2);
        String pad0 = spaces(indent);
        sb.append("{");
        boolean first = true;
        for (Object ko : m.keySet()) {
            if (!first) sb.append(",");
            sb.append("\n").append(pad);
            sb.append('"').append(escapeJson(ko.toString())).append('"');
            sb.append(": ");
            writeValue(sb, m.get(ko), indent + 2);
            first = false;
        }
        sb.append("\n").append(pad0).append("}");
    }

    private static void writeList(StringBuilder sb, java.util.List lst, int indent) {
        if (lst == null || lst.isEmpty()) { sb.append("[]"); return; }
        String pad  = spaces(indent + 2);
        String pad0 = spaces(indent);
        sb.append("[");
        boolean first = true;
        for (Object item : lst) {
            if (!first) sb.append(",");
            sb.append("\n").append(pad);
            writeValue(sb, item, indent + 2);
            first = false;
        }
        sb.append("\n").append(pad0).append("]");
    }

    private static String escapeJson(String s) {
        if (s == null) return "";
        StringBuilder sb = new StringBuilder(s.length() + 8);
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            switch (c) {
                case '"':  sb.append("\\\""); break;
                case '\\': sb.append("\\\\"); break;
                case '\b': sb.append("\\b"); break;
                case '\f': sb.append("\\f"); break;
                case '\n': sb.append("\\n"); break;
                case '\r': sb.append("\\r"); break;
                case '\t': sb.append("\\t"); break;
                default:
                    if (c < 0x20) {
                        sb.append(String.format("\\u%04x", (int) c));
                    } else {
                        sb.append(c);
                    }
            }
        }
        return sb.toString();
    }

    private static String spaces(int n) {
        StringBuilder sb = new StringBuilder(n);
        for (int i = 0; i < n; i++) sb.append(' ');
        return sb.toString();
    }
}
]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1782600000101</Id>
			<Name><![CDATA[SimpleJsonParser]]></Name>
			<Text><![CDATA[/**
 * Parseur JSON récursif descendant minimal.
 * Supporte : objet {}, tableau [], chaîne "...", nombre, true/false/null.
 * Gère correctement l'UTF-8, les accents, les échappements JSON standard.
 * Retourne une Map<String,Object> pour un objet JSON racine.
 */
public class SimpleJsonParser {

    private final String src;
    private int pos;

    private SimpleJsonParser(String src) {
        this.src = src;
        this.pos = 0;
    }

    /** Point d'entrée principal. */
    @SuppressWarnings("unchecked")
    public static java.util.Map<String,Object> parse(String json) throws Exception {
        if (json == null || json.trim().isEmpty())
            throw new Exception("JSON vide");
        SimpleJsonParser p = new SimpleJsonParser(json.trim());
        p.skipWs();
        Object val = p.parseValue();
        if (val instanceof java.util.Map)
            return (java.util.Map<String,Object>) val;
        throw new Exception("Le JSON racine doit être un objet {}");
    }

    private Object parseValue() throws Exception {
        skipWs();
        if (pos >= src.length()) throw new Exception("JSON tronqué à pos " + pos);
        char c = src.charAt(pos);
        if (c == '{')  return parseObject();
        if (c == '[')  return parseArray();
        if (c == '"')  return parseString();
        if (c == 't')  return parseLiteral("true", Boolean.TRUE);
        if (c == 'f')  return parseLiteral("false", Boolean.FALSE);
        if (c == 'n')  return parseLiteral("null", null);
        if (c == '-' || Character.isDigit(c)) return parseNumber();
        throw new Exception("Valeur JSON inattendue à pos " + pos + " : '" + c + "'");
    }

    @SuppressWarnings("unchecked")
    private java.util.Map<String,Object> parseObject() throws Exception {
        java.util.Map<String,Object> m = new java.util.LinkedHashMap<String,Object>();
        pos++; // skip '{'
        skipWs();
        if (pos < src.length() && src.charAt(pos) == '}') { pos++; return m; }
        while (true) {
            skipWs();
            String key = parseString();
            skipWs();
            expect(':');
            skipWs();
            Object val = parseValue();
            m.put(key, val);
            skipWs();
            if (pos >= src.length()) break;
            char c = src.charAt(pos);
            if (c == '}') { pos++; break; }
            if (c == ',') { pos++; continue; }
            throw new Exception("Attendu ',' ou '}' à pos " + pos);
        }
        return m;
    }

    private java.util.List<Object> parseArray() throws Exception {
        java.util.List<Object> lst = new java.util.ArrayList<Object>();
        pos++; // skip '['
        skipWs();
        if (pos < src.length() && src.charAt(pos) == ']') { pos++; return lst; }
        while (true) {
            skipWs();
            lst.add(parseValue());
            skipWs();
            if (pos >= src.length()) break;
            char c = src.charAt(pos);
            if (c == ']') { pos++; break; }
            if (c == ',') { pos++; continue; }
            throw new Exception("Attendu ',' ou ']' à pos " + pos);
        }
        return lst;
    }

    private String parseString() throws Exception {
        if (src.charAt(pos) != '"') throw new Exception("Attendu '\"' à pos " + pos);
        pos++;
        StringBuilder sb = new StringBuilder();
        while (pos < src.length()) {
            char c = src.charAt(pos);
            if (c == '"') { pos++; return sb.toString(); }
            if (c == '\\') {
                pos++;
                if (pos >= src.length()) break;
                char esc = src.charAt(pos);
                switch (esc) {
                    case '"': sb.append('"');  break;
                    case '\\': sb.append('\\'); break;
                    case '/': sb.append('/'); break;
                    case 'b': sb.append('\b'); break;
                    case 'f': sb.append('\f'); break;
                    case 'n': sb.append('\n'); break;
                    case 'r': sb.append('\r'); break;
                    case 't': sb.append('\t'); break;
                    case 'u': {
                        if (pos + 4 >= src.length())
                            throw new Exception("Séquence \\u incomplète à pos " + pos);
                        String hex = src.substring(pos + 1, pos + 5);
                        sb.append((char) Integer.parseInt(hex, 16));
                        pos += 4;
                        break;
                    }
                    default: sb.append(esc);
                }
                pos++;
            } else {
                sb.append(c);
                pos++;
            }
        }
        throw new Exception("Chaîne JSON non terminée");
    }

    private Number parseNumber() throws Exception {
        int start = pos;
        if (pos < src.length() && src.charAt(pos) == '-') pos++;
        while (pos < src.length() && Character.isDigit(src.charAt(pos))) pos++;
        if (pos < src.length() && src.charAt(pos) == '.') {
            pos++;
            while (pos < src.length() && Character.isDigit(src.charAt(pos))) pos++;
        }
        if (pos < src.length() && (src.charAt(pos) == 'e' || src.charAt(pos) == 'E')) {
            pos++;
            if (pos < src.length() && (src.charAt(pos) == '+' || src.charAt(pos) == '-')) pos++;
            while (pos < src.length() && Character.isDigit(src.charAt(pos))) pos++;
        }
        String numStr = src.substring(start, pos);
        try { return Double.parseDouble(numStr); }
        catch (Exception ex) { throw new Exception("Nombre JSON invalide : " + numStr); }
    }

    private Object parseLiteral(String expected, Object value) throws Exception {
        if (src.startsWith(expected, pos)) { pos += expected.length(); return value; }
        throw new Exception("Littéral JSON invalide à pos " + pos);
    }

    private void skipWs() {
        while (pos < src.length()) {
            char c = src.charAt(pos);
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') pos++;
            else break;
        }
    }

    private void expect(char expected) throws Exception {
        if (pos >= src.length() || src.charAt(pos) != expected)
            throw new Exception("Attendu '" + expected + "' à pos " + pos);
        pos++;
    }
}
]]></Text>
		</JavaClass>
