		<ActiveObjectClass>
			<Id>1781100000001</Id>
			<Name><![CDATA[BlackboardAgent]]></Name>
			<AdditionalClassCode><![CDATA[java.util.ArrayList<AERMessage> alertesPubliees = new java.util.ArrayList<AERMessage>();

// Journal AER réel du run : chaque ligne est produite au moment où un message
// est émis, lu, arbitré ou appliqué. Il sert de source unique à la feuille
// "Audit propagation AER" ; aucune ligne de cette feuille ne doit être mockée.
java.util.ArrayList<String> journalAER = new java.util.ArrayList<String>();

java.util.LinkedHashMap<String, double[]> alertesParPoste = new java.util.LinkedHashMap<String, double[]>();

java.util.LinkedHashMap<String, Integer> historiqueGoulots = new java.util.LinkedHashMap<String, Integer>();

double intervalleMinReeq = 60.0;

// ============================================================
// JOURNAL FLUX HIERARCHIQUES GENERATION 2
// Source de preuve des communications normales Amendment/Execution/Reporting.
// ============================================================
java.util.ArrayList<String> journalFluxHierarchique = new java.util.ArrayList<String>();

void journaliserFluxHierarchique(AERMessage msg, String idCommande, String processus, String statut) {
    if (msg == null) return;
    String contenu = msg.contenu == null ? "" : msg.contenu.replace("\t", " ").replace("\n", " ");
    String ligne = String.format(java.util.Locale.US, "%.1f", time()) + "\t"
        + (idCommande == null ? "" : idCommande) + "\t"
        + (msg.type == null ? "" : msg.type) + "\t"
        + (msg.emetteur == null ? "" : msg.emetteur) + "\t"
        + (msg.destinataire == null ? "" : msg.destinataire) + "\t"
        + (msg.sujet == null ? "" : msg.sujet) + "\t"
        + contenu + "\t"
        + (processus == null ? "" : processus) + "\t"
        + (statut == null ? "" : statut);
    journalFluxHierarchique.add(ligne);
    if (journalFluxHierarchique.size() > 1000) journalFluxHierarchique.remove(0);
}


// S2.2 C03 — WIP contextualisé par buffer logique de micro-activité.
// Clé unique = idActeur|idPoste afin d'éviter les collisions multi-acteurs.
public java.util.LinkedHashMap<String, java.util.ArrayList<Double>> wipSnapshotsParBuffer =
    new java.util.LinkedHashMap<String, java.util.ArrayList<Double>>();

void snapshotWIPContextuel() {
    Main main = (Main)getOwner();
    if (main == null) return;
    int global = 0;
    // C14.57 -- meme correctif que pour la carte "Work In Process" : exclut les
    // jetons d'animation purement visuels (TRACE_VISUEL_SCOR), qui accompagnent
    // chaque commande meme sans production reelle. Sans cette exclusion, le WIP
    // moyen alimentant l'attribut SCOR AG (taux d'occupation = WIP/capacite)
    // etait lui aussi gonfle artificiellement.
    try { global = main.wipReelSansJetonsVisuels(); } catch (Throwable ignored) {}
    wipSnapshots.add((double)global);
    for (PosteGenericAgent p : main.postes) {
        if (p == null) continue;
        String acteur = (p.idActeurResponsable == null || p.idActeurResponsable.isEmpty()) ? "ACTEUR_INCONNU" : p.idActeurResponsable;
        String key = acteur + "|" + p.idPoste;
        int local = 0;
        try { local = p.queue.size() + p.delay.size(); } catch (Throwable ignored) {}
        java.util.ArrayList<Double> vals = wipSnapshotsParBuffer.get(key);
        if (vals == null) { vals = new java.util.ArrayList<Double>(); wipSnapshotsParBuffer.put(key, vals); }
        vals.add((double)local);
        if (vals.size() > 1000) vals.remove(0);
    }
    if (wipSnapshots.size() > 1000) wipSnapshots.remove(0);
}

double avgWIPBuffer(String key) {
    java.util.ArrayList<Double> vals = wipSnapshotsParBuffer.get(key);
    if (vals == null || vals.isEmpty()) return 0.0;
    double s=0.0; for (double v : vals) s += v;
    return s / vals.size();
}
]]></AdditionalClassCode>
