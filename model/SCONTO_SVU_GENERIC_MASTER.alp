				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1801000000026</Id>
					<Name><![CDATA[codePosteCorrespondAuxPrefixes]]></Name>
					<X>-440</X><Y>5230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codePoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[prefixes]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (codePoste == null || prefixes == null || prefixes.trim().isEmpty()) return false;
String cp = codePoste.trim().toUpperCase(java.util.Locale.ROOT);
String[] parts = prefixes.split(",");
for (String p : parts) {
    if (p == null) continue;
    String pref = p.trim().toUpperCase(java.util.Locale.ROOT);
    if (pref.isEmpty()) continue;
    if (pref.endsWith(".")) {
        if (cp.startsWith(pref)) return true;
    } else {
        if (cp.equals(pref) || cp.startsWith(pref + ".")) return true;
    }
}
return false;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1801000000027</Id>
					<Name><![CDATA[metriquesSCORLieesAuPoste]]></Name>
					<X>-440</X><Y>5260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codePoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[avecValeurs]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[if (codePoste == null || codePoste.trim().isEmpty()) return "-";
java.util.ArrayList<String> out = new java.util.ArrayList<String>();
String[] lignes = catalogueMetriquesAHPRaw().split("\n");
for (String ligne : lignes) {
    if (ligne == null || ligne.trim().isEmpty()) continue;
    String[] p = ligne.split("\\|", -1);
    if (p.length < 7) continue;
    String code = p[1].trim();
    if (!estMetriqueSCORDisponiblePourTableaux(code)) continue;
    String prefixes = codesProcessusPourMetriqueSCOR(code);
    if (!codePosteCorrespondAuxPrefixes(codePoste, prefixes)) continue;
    String item = code + " — " + p[3];
    if (avecValeurs) item = code + "=" + fmt3(valeurRuntimeMetriqueSCOR(code)) + " " + uniteMetriqueSCOR(code);
    out.add(item);
}
if (out.isEmpty()) return "-";
return String.join(" ; ", out);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1801000000028</Id>
					<Name><![CDATA[metriquesSCORLieesMacro]]></Name>
					<X>-440</X><Y>5290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[macroKey]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[avecValeurs]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[String mk = macroKey == null ? "" : macroKey.trim();
String prefixes = "";
if (mk.equals("sP")) prefixes = "P";
else if (mk.equals("sS")) prefixes = "S1.";
else if (mk.equals("sM")) prefixes = "M1.";
else if (mk.equals("sD")) prefixes = "D1.";
else if (mk.equals("sR")) prefixes = "DR1.,SR1.";
else prefixes = mk;

java.util.ArrayList<String> out = new java.util.ArrayList<String>();
String[] lignes = catalogueMetriquesAHPRaw().split("\n");
for (String ligne : lignes) {
    if (ligne == null || ligne.trim().isEmpty()) continue;
    String[] p = ligne.split("\\|", -1);
    if (p.length < 7) continue;
    String code = p[1].trim();
    if (!estMetriqueSCORDisponiblePourTableaux(code)) continue;
    String c = code.toUpperCase(java.util.Locale.ROOT);
    String codes = codesProcessusPourMetriqueSCOR(code);
    boolean match = false;
    if (mk.equals("sS") && (c.equals("RS.2.1") || codePosteCorrespondAuxPrefixes("S1.2", codes) || codePosteCorrespondAuxPrefixes("S1.3", codes) || codePosteCorrespondAuxPrefixes("S1.1", codes))) match = true;
    if (mk.equals("sM") && (c.equals("RS.2.2") || c.equals("AG.3.38") || c.equals("AG.3.2") || codePosteCorrespondAuxPrefixes("M1.3", codes))) match = true;
    if (mk.equals("sD") && (c.equals("RS.2.3") || c.equals("AG.3.32") || c.equals("AG.3.1") || codePosteCorrespondAuxPrefixes("D1.12", codes))) match = true;
    if (mk.equals("sR") && (c.equals("RS.2.5") || codePosteCorrespondAuxPrefixes("DR1.1", codes) || codePosteCorrespondAuxPrefixes("SR1.1", codes))) match = true;
    if (mk.equals("sP") && (c.startsWith("CO.3.1") || codePosteCorrespondAuxPrefixes("P3.4", codes))) match = true;
    if (!match && !prefixes.isEmpty() && codePosteCorrespondAuxPrefixes(prefixes, codes)) match = true;
    if (!match) continue;
    String item = code + " — " + p[3];
    if (avecValeurs) item = code + "=" + fmt3(valeurRuntimeMetriqueSCOR(code)) + " " + uniteMetriqueSCOR(code);
    out.add(item);
}
if (out.isEmpty()) return "-";
return String.join(" ; ", out);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1801000000029</Id>
					<Name><![CDATA[resumeMetriquesSCORGlobales]]></Name>
					<X>-440</X><Y>5320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[avecValeurs]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[int nbCalc = 0, nbEstimation = 0;
java.util.ArrayList<String> exemples = new java.util.ArrayList<String>();
String[] lignes = catalogueMetriquesAHPRaw().split("\n");
for (String ligne : lignes) {
    if (ligne == null || ligne.trim().isEmpty()) continue;
    String[] p = ligne.split("\\|", -1);
    if (p.length < 7) continue;
    String code = p[1].trim();
    if (!estMetriqueSCORDisponiblePourTableaux(code)) continue;
    String statut = statutMetriqueSCOR(code);
    if (statut != null && (statut.toUpperCase(java.util.Locale.ROOT).contains("PROXY") || statut.toUpperCase(java.util.Locale.ROOT).contains("ESTIMATION") || statut.toUpperCase(java.util.Locale.ROOT).contains("APPROXIMATION"))) nbEstimation++; else nbCalc++;
    if (exemples.size() < 10) {
        if (avecValeurs) exemples.add(code + "=" + fmt3(valeurRuntimeMetriqueSCOR(code)) + " " + uniteMetriqueSCOR(code));
        else exemples.add(code + " — " + p[3]);
    }
}
String prefixe = "Calculées=" + nbCalc + " ; estimations=" + nbEstimation;
if (exemples.isEmpty()) return prefixe + " ; aucune valeur de simulation disponible";
return prefixe + " ; exemples : " + String.join(" ; ", exemples);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
