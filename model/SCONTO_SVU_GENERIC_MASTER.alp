String nomScenario(ScenarioFlux sc) {
    return (sc != null && sc.typeProduit != null) ? sc.typeProduit : "";
}

boolean estScenarioCasTest(ScenarioFlux sc) {
    String n = nomScenario(sc).toUpperCase(java.util.Locale.ROOT);
    return n.contains("ZENER CAS 1") || n.contains("ZENER CAS 2") || n.contains("ZENER CAS 3");
}

int indexScenarioNominal() {
    if (scenarios == null || scenarios.isEmpty()) return -1;

    // Priorité : un scénario qui ressemble au flux nominal ZENER/Distribution
    for (int i = 0; i < scenarios.size(); i++) {
        ScenarioFlux sc = scenarios.get(i);
        String n = nomScenario(sc).toUpperCase(java.util.Locale.ROOT);
        if (!estScenarioCasTest(sc) && (n.contains("DISTRIBUTION") || n.contains("ZENER"))) return i;
    }

    // Sinon : premier scénario non "Cas 1/2/3"
    for (int i = 0; i < scenarios.size(); i++) {
        ScenarioFlux sc = scenarios.get(i);
        if (!estScenarioCasTest(sc)) return i;
    }

    return 0;
}

void forcerScenarioNominalPourProfilTest() {
    int idx = indexScenarioNominal();
    if (idx >= 0 && idx < scenarios.size()) {
        ScenarioFlux sc = scenarios.get(idx);
        champScenarioSelectionne = (idx + 1) + ": " + nomScenario(sc);
        board.logEvent("[PROFIL TEST] Scenario nominal force pour profil de test : " + champScenarioSelectionne);
    }
}

// C14.53 -- BUG RACINE CORRIGE. Cette fonction alimente e.typeProduit sur
// chaque entite de production reellement creee. Or e.typeProduit est aussi
// la cle EXACTE utilisee par consommerMatieresPour() pour retrouver la
// nomenclature du produit (comparaison avec ScenarioFlux.typeProduit, ex.
// "SCENARIO DISTRIBUTION"). Les deux premieres branches ci-dessous
// renvoyaient un libelle decoratif ("Profil CAS 1 - livraison directe /
// CMD_6") des qu'un profil de test etait actif -- ce qui est le cas dans
// TOUS les runs observes cette session (cf. logs [DEBUG CAS] profil=...).
// Cette chaine ne correspondant a aucun ScenarioFlux.typeProduit connu, la
// consommation de matiere echouait silencieusement a chaque unite produite,
// depuis le debut : le stock ne baissait jamais, quelle que soit sa valeur
// initiale, et le Cas 3 ne pouvait donc jamais se declencher par manque de
// matiere reellement constate. Le libelle "Profil ..." pouvait avoir un
// interet pour l'affichage/tracage, mais ne doit jamais remplacer la valeur
// FONCTIONNELLE necessaire aux correspondances de nomenclature : on renvoie
// desormais toujours le nom reel du scenario.
String libelleTypeProduitTrace(CommandeAgent cmd, ScenarioFlux sc) {
    String n = nomScenario(sc);
    return (n != null && !n.trim().isEmpty()) ? n : ((cmd != null ? cmd.typeCommande : "MTS") + ":" + (cmd != null ? cmd.idCommande : ""));
}

ScenarioFlux scenarioSelectionneInterface() {
    if (scenarios == null || scenarios.isEmpty()) return null;
    if (champScenarioSelectionne == null || champScenarioSelectionne.trim().isEmpty()) return null;
    try {
        int idx = Integer.parseInt(champScenarioSelectionne.split(":")[0].trim()) - 1;
        if (idx >= 0 && idx < scenarios.size()) return scenarios.get(idx);
    } catch (Throwable ex) {
        board.logEvent("[SCENARIO] Selection illisible : " + champScenarioSelectionne);
    }
    return null;
}

void synchroniserProfilAvecScenarioSelectionne(ScenarioFlux sc) {
    if (sc == null || !estScenarioCasTest(sc)) return;

    String n = nomScenario(sc).toUpperCase(java.util.Locale.ROOT);
    String cible = n.contains("CAS 1") ? "CAS 1"
        : (n.contains("CAS 2") ? "CAS 2" : "CAS 3");
    String actif = profilTestActif == null ? "" : profilTestActif.toUpperCase(java.util.Locale.ROOT);

    // Ne pas réinitialiser les stocks à chaque commande si le même profil est déjà actif.
    if (!actif.contains(cible)) {
        board.logEvent("[PROFIL AUTO] Le scénario sélectionné " + nomScenario(sc)
            + " active automatiquement le profil " + cible + ".");
        appliquerProfilTest(cible);
    } else {
        forcerScenarioNominalPourProfilTest();
    }
}

void appliquerProfilTest(String profil) {
    String p = profil == null ? "" : profil.trim().toUpperCase(java.util.Locale.ROOT);
    profilTestActif = "";
    if (p.contains("CAS 1")) {
        profilTestActif = "CAS 1 - livraison directe";
        champStockInitialProduitFini = 100.0;
        champStockInitialMatiereGlobal = 100.0;
        modeTestSansRetours = true;
    } else if (p.contains("CAS 2")) {
        profilTestActif = "CAS 2 - production avec matiere disponible";
        champStockInitialProduitFini = 0.0;
        champStockInitialMatiereGlobal = 100.0;
        modeTestSansRetours = true;
    } else if (p.contains("CAS 3")) {
        profilTestActif = "CAS 3 - approvisionnement + production";
        champStockInitialProduitFini = 0.0;
        champStockInitialMatiereGlobal = 0.0;
        modeTestSansRetours = true;
    } else {
        profilTestActif = "PERSONNALISE";
    }

    // Important : un profil de test n'est pas un scénario.
    // On force donc le scénario nominal et on laisse les stocks orienter l'exécution.
    forcerScenarioNominalPourProfilTest();

    // C14.20 -- les stocks initiaux ne sont (re)appliques QUE hors execution.
    // appliquerStocksInitiauxConfig() fait un ECRASEMENT (p.niveauStock = valeur
    // du profil), pas un ajout. Or creerCommande() appelle
    // synchroniserProfilAvecScenarioSelectionne() -> appliquerProfilTest() a
    // CHAQUE commande lorsque le scenario selectionne est un cas de test
    // (ZENER CAS 1/2/3, qui sont des profils d'etat initial et non des gammes
    // executables). Le stock produit fini etait donc remis a sa valeur initiale
    // a chaque nouvelle commande, remontant "tout seul" sans aucune production.
    // En cours de run, on conserve les seuils du profil (champStockInitial*)
    // pour les decisions a venir, mais on ne touche plus a l'etat courant.
    if (!modeExecution) {
        appliquerStocksInitiauxConfig();
    } else {
        board.logEvent("[PROFIL TEST] " + profil
            + " : profil synchronise en cours d'execution, stocks courants preserves.");
    }
    board.logEvent("[PROFIL TEST] " + profil + " applique : " + stockInitialResume() + " | " + resumeRetoursQualite()
        + " | scenario=" + champScenarioSelectionne);
}

void ouvrirProfilsTest() {
    javax.swing.SwingUtilities.invokeLater(new Runnable() {
        public void run() {
            try {
                String[] choix = new String[] {
                    "Cas 1 - Livraison directe : stock fini=100, matiere=100",
                    "Cas 2 - Production : stock fini=0, matiere=100",
                    "Cas 3 - Approvisionnement + production : stock fini=0, matiere=0",
                    "Personnalise - ne rien changer"
                };
                Object sel = javax.swing.JOptionPane.showInputDialog(null,
                    "Choisissez un profil d'etat initial.\nLe scenario reste la sequence nominale ; le profil modifie seulement les stocks et les retours.",
                    "Profils de test", javax.swing.JOptionPane.PLAIN_MESSAGE, null, choix, choix[0]);
                if (sel != null) {
                    appliquerProfilTest(String.valueOf(sel));
                    afficherMessageTopMost("Profil applique :\n" + sel + "\n\n" + stockInitialResume(), "Profils de test");
                }
            } catch (Throwable ex) {
                afficherMessageTopMost("Erreur dans les profils de test : " + ex.getMessage(), "Erreur");
            }
        }
    });
}

ScenarioFlux choisirScenarioPourCommande() {
    if (scenarios == null || scenarios.isEmpty()) return null;

    ScenarioFlux choisiInterface = scenarioSelectionneInterface();
    if (choisiInterface != null) {
        if (estScenarioCasTest(choisiInterface)) {
            // Une entrée « ZENER CAS 1/2/3 » représente un état initial.
            // Sa sélection active désormais automatiquement le profil correspondant,
            // puis la commande utilise la gamme nominale portant la nomenclature réelle.
            synchroniserProfilAvecScenarioSelectionne(choisiInterface);
            int idxNominal = indexScenarioNominal();
            return (idxNominal >= 0 && idxNominal < scenarios.size())
                ? scenarios.get(idxNominal)
                : choisiInterface;
        }
        return choisiInterface;
    }

    double total = 0.0;
    for (ScenarioFlux sc : scenarios) {
        if (sc == null) continue;
        if (profilTestActif != null && !profilTestActif.trim().isEmpty() && estScenarioCasTest(sc)) continue;
        total += Math.max(0.0, sc.debitParHeure);
    }

    if (total <= 0.0) {
        int idxNominal = indexScenarioNominal();
        return (idxNominal >= 0 && idxNominal < scenarios.size()) ? scenarios.get(idxNominal) : scenarios.get(0);
    }

    double r = getDefaultRandomGenerator().nextDouble() * total;
    double acc = 0.0;
    for (ScenarioFlux sc : scenarios) {
        if (sc == null) continue;
        if (profilTestActif != null && !profilTestActif.trim().isEmpty() && estScenarioCasTest(sc)) continue;
        acc += Math.max(0.0, sc.debitParHeure);
        if (r <= acc) return sc;
    }

    int idxNominalFin = indexScenarioNominal();
    return (idxNominalFin >= 0 && idxNominalFin < scenarios.size()) ? scenarios.get(idxNominalFin) : scenarios.get(scenarios.size() - 1);
}


String bilanMatierePourScenario(ScenarioFlux sc, int qte) {
    if (sc == null || sc.nomenclature == null || sc.nomenclature.isEmpty()) return "Aucune nomenclature declaree";
    StringBuilder sb = new StringBuilder();
    for (LigneNomenclature l : sc.nomenclature) {
        FicheMatiere f = trouverFicheMatiere(l.idMatiere);
        double besoin = l.quantiteParUnite * Math.max(1, qte);
        double dispo = f != null ? f.stockDisponible : 0.0;
        if (sb.length() > 0) sb.append(" ; ");
        sb.append(l.idMatiere).append(" besoin=").append(String.format("%.1f", besoin))
          .append(" disponible=").append(String.format("%.1f", dispo));
    }
    return sb.toString();
}

boolean matieresSuffisantesPourScenario(ScenarioFlux sc, int qte) {
    if (sc == null) {
        if (board != null) board.logEvent("[ERREUR MATIERE] Scenario null : disponibilite matiere refusee.");
        return false;
    }
    if (sc.nomenclature == null || sc.nomenclature.isEmpty()) {
        if (board != null) board.logEvent("[ERREUR MATIERE] Nomenclature absente pour " + nomScenario(sc)
            + " : disponibilite matiere refusee (fail-closed).");
        return false;
    }
    for (LigneNomenclature l : sc.nomenclature) {
        if (l == null || l.idMatiere == null || l.idMatiere.trim().isEmpty() || l.quantiteParUnite <= 0) {
            if (board != null) board.logEvent("[ERREUR MATIERE] Ligne de nomenclature invalide pour " + nomScenario(sc));
            return false;
        }
        FicheMatiere f = trouverFicheMatiere(l.idMatiere);
        if (f == null) {
            if (board != null) board.logEvent("[ERREUR MATIERE] Fiche matiere absente : " + l.idMatiere
                + " / scenario=" + nomScenario(sc));
            return false;
        }
        double besoin = l.quantiteParUnite * Math.max(1, qte);
        if (f.stockDisponible + 1e-9 < besoin) return false;
    }
    return true;
}

String idCommandeDepuisFlux(FluxEntity e) {
    if (e == null) return "";
    String ref = (e.idFlux == null ? "" : e.idFlux) + " " + (e.typeProduit == null ? "" : e.typeProduit);
    java.util.regex.Matcher m = java.util.regex.Pattern.compile("CMD_\\d+").matcher(ref);
    return m.find() ? m.group() : "";
}

void evaluerRetourClientApresLivraison(CommandeAgent cmd) {
    if (cmd == null) return;
    double pRetour = Math.max(0, Math.min(1, champProbabiliteRetourProduits));
    if (!retoursProduitsActifs || modeTestSansRetours || pRetour <= 0) {
        ajouterSuiviDetailleHorodate(
            time() + 27.5,
            "Controle client",
            "Reception client conforme",
            "Le client receptionne la commande. Les retours client sont desactives pour ce test nominal.",
            "Client",
            "Agent client S1.3",
            "Commande " + cmd.idCommande,
            "Quantite=" + cmd.qte,
            "CUSTOMER:AO-sS1.2",
            "CUSTOMER:AO-sS1.4",
            "Reception client -> verification -> transfert",
            "D1.13 / S1.2 -> S1.3 -> S1.4",
            "Accepter la livraison.",
            "Commande livree",
            "Commande acceptee par le client",
            "Taux de conformite reception client ; retours desactives"
        );
        return;
    }

    boolean retour = getDefaultRandomGenerator().nextDouble() < pRetour;
    if (!retour) {
        ajouterSuiviDetailleHorodate(
            time() + 27.5,
            "Controle client",
            "Reception client conforme",
            "Le client receptionne la commande et ne declenche pas de retour.",
            "Client",
            "Agent client S1.3",
            "Commande " + cmd.idCommande,
            "Quantite=" + cmd.qte,
            "CUSTOMER:AO-sS1.2",
            "CUSTOMER:AO-sS1.4",
            "Reception client -> verification -> transfert",
            "D1.13 / S1.2 -> S1.3 -> S1.4",
            "Accepter la livraison.",
            "Commande livree",
            "Commande acceptee par le client",
            "Taux de conformite reception client ; taux de retour client"
        );
        return;
    }

    ajouterSuiviDetailleHorodate(
        time() + 27.5,
        "Retour client",
        "Non-conformite detectee chez le client",
        "Le client detecte une non-conformite apres reception et renvoie le produit vers ZENER SA Togo.",
        "Client",
        "Agent client S1.3 / Agent Return",
        "Commande " + cmd.idCommande,
        "Quantite retournee=1 sur " + cmd.qte,
        "CLIENT GENERIQUE",
        "ZENER SA Togo",
        "Customer Return -> Manufacturer Return",
        "DR1.1 -> DR1.3 / Flux RETOUR",
        "Declencher un retour client.",
        "Commande livree",
        "Retour client en cours",
        "Taux de retour client ; cout de non-qualite ; delai de traitement retour"
    );

    emettreFluxLog(FluxLog.RETOUR, "CUSTOMER:AOe-sSR1.5", "MANUFACTURER:AOe-sDR1.3", 1);
    animerVehiculePhysiqueAllerRetour("CUSTOMER:AOe-sSR1.5", "MANUFACTURER:AOe-sDR1.3", "returnTruck", "SCOR Return client -> Manufacturer Return | Flux physique retour client " + cmd.idCommande);
    emettreFluxInformationnelAnime("CUSTOMER:ASup-sSR", "MANUFACTURER:ASup-sDR", "ReturnNotice", "AER RETURN : retour client " + cmd.idCommande);
    afficherFluxAnimation(
        "RETOUR",
        "DR1.1 -> DR1.3",
        "Customer / Agent Return",
        "ZENER SA Togo / Agent Return",
        "Retour client de " + cmd.idCommande + " apres reception non conforme"
    );

    // C14.48 -- OPTION A appliquee au Return (point 9) : jusqu'ici, le retour
    // client n'etait represente que par un jeton purement visuel, exclu des
    // KPI (kpiZener). Comme pour Deliver, on trace desormais chaque etape
    // reelle du retour avec un echantillon reel de sa loiTemps, pour que le
    // traitement des retours contribue enfin a Process Time / Waiting Time /
    // PCE cote ZENER, au lieu d'etre invisible dans les indicateurs.
    enregistrerTraceExecutionCommande(cmd, "sSR1.3.1", "SR1.3", "DEMANDE_AUTORISATION_RETOUR", (trouverPoste("sSR1.3.1") != null ? trouverPoste("sSR1.3.1").dureeTraitement() : 0.0), 0.0, 1, "Demande d'autorisation de retour formulee par le client");
    enregistrerTraceExecutionCommande(cmd, "sDR1.1.1", "DR1.1", "INSTRUCTION_RETOUR", (trouverPoste("sDR1.1.1") != null ? trouverPoste("sDR1.1.1").dureeTraitement() : 0.0), 0.0, 1, "Instruction du retour par ZENER (autorisation ou rejet)");
    enregistrerTraceExecutionCommande(cmd, "sDR1.3.1", "DR1.3", "RECEPTION_RETOUR", (trouverPoste("sDR1.3.1") != null ? trouverPoste("sDR1.3.1").dureeTraitement() : 0.0), 0.0, 1, "Reception physique du produit retourne");
    enregistrerTraceExecutionCommande(cmd, "sDR1.4.1", "DR1.4", "INSPECTION_RETOUR", (trouverPoste("sDR1.4.1") != null ? trouverPoste("sDR1.4.1").dureeTraitement() : 0.0), 0.0, 1, "Inspection du produit retourne avant decision rejet/reintegration");

    // C14.3 — chaîne Return validée dans le JSON collègue.
    lancerFluxVisuelRetourClient(cmd);
}



String fournisseurPourMatiere(String idMatiere) {
    String k = keyAnim(idMatiere);
    if (k.contains("GPL")) return "Fournisseur du GPL";
    if (k.contains("BOUTEILLE")) return "Fournisseur de bouteilles vides";
    if (k.contains("ACCESSOIRE") || k.contains("ACCESSOIRES")) return "Fournisseur des accessoires";

    for (ActeurSC a : acteursSC) {
        if (a != null && a.actif && ActeurSC.FOURNISSEUR.equals(a.categorie)) return a.nom;
    }
    return "Fournisseur";
}


// C14.57 -- La carte "Work In Process" affichait fluxEntites.size(), qui
// compte aussi les jetons d'animation purement visuels (VISUEL_EMISSION_*,
// VISUEL_DELIVER_*, VISUEL_RETOUR_*, etc., crees via lancerFluxVisuelRuntime()
// et typeProduit="TRACE_VISUEL_SCOR"). Ces jetons accompagnent CHAQUE
// commande, meme une simple livraison directe sans aucune production : le
// WIP affichait donc une hausse a chaque commande, sans rapport avec un
// encours de fabrication reel. On exclut ici ces jetons, comme deja fait
// pour l'occupation des postes (C14.49).
int wipReelSansJetonsVisuels() {
    int n = 0;
    for (FluxEntity e : fluxEntites) {
        if (e != null && !estFluxVisuelSeulement(e)) n++;
    }
    return n;
}

boolean estFluxVisuelSeulement(FluxEntity e) {
    if (e == null) return false;
    String t = e.typeProduit == null ? "" : e.typeProduit.toUpperCase(java.util.Locale.ROOT);
    String id = e.idFlux == null ? "" : e.idFlux.toUpperCase(java.util.Locale.ROOT);
    return t.startsWith("TRACE_VISUEL") || id.startsWith("VISUEL_");
}

boolean estFluxBranche(FluxEntity e) {
    // Un flux "branche" est un petit flux (2 arrets) genere par
    // envoyerFluxVersAutresSuccesseurs() pour illustrer un embranchement.
    // Il ne doit JAMAIS lui-meme redeclencher une diffusion vers d'autres
    // successeurs, sous peine de cascade combinatoire.
    if (e == null || e.idFlux == null) return false;
    return e.idFlux.toUpperCase(java.util.Locale.ROOT).startsWith("VISUEL_BRANCHE_");
}

void envoyerFluxVersAutresSuccesseurs(PosteGenericAgent source, PosteGenericAgent successeurPrincipal) {
    // Pour un poste a embranchements (plusieurs successeurs declares dans le
    // scenario), envoie egalement un petit flux visuel vers chaque AUTRE
    // successeur existant, en plus de celui reellement emprunte par l'entite
    // metier. Les jetons envoyes sont purement visuels (TRACE_VISUEL_SCOR) et
    // ne sont jamais eux-memes source de nouvelles diffusions (voir garde dans
    // routerEntite) afin d'eviter toute cascade combinatoire.
    for (PosteGenericAgent p : postes) {
        if (p == source || p == successeurPrincipal) continue;
        boolean estSuccesseur = false;
        for (String nomPrec : p.chainesPrecedents.split(",")) {
            if (nomPrec.trim().equals(source.nom)) { estSuccesseur = true; break; }
        }
        if (!estSuccesseur) continue;
        java.util.ArrayList<String> routeBranche = new java.util.ArrayList<String>();
        routeBranche.add(source.idPoste);
        routeBranche.add(p.idPoste);
        lancerFluxVisuelRuntime("VISUEL_BRANCHE_" + source.idPoste.replaceAll("[^A-Za-z0-9]", "_")
            + "_" + p.idPoste.replaceAll("[^A-Za-z0-9]", "_"), routeBranche);
    }
}

// ============================================================
// C14.3 — INTEGRATION DES POSTES VALIDES DU JSON COLLEGUE
// Les données métier restent portées par le JSON validé ; ces méthodes
// assurent uniquement leur exploitation sûre dans la baseline C14.2.1.
// ============================================================


java.util.ArrayList<String> routeApresEjectionQualite(String idPosteOrigine, String idPosteCible) {
    // Apres ejection qualite (routerVersCibleEchec), l'entite atterrit sur
    // idPosteCible (typiquement sSR1.1.2 pour un rejet matiere, ou sDR1.4.2 pour
    // un rejet retour client) sans savoir vers quel SINK final continuer. On
    // construit ici une route dediee, choisie selon le poste d'origine du rejet
    // (qui identifie la matiere concernee).
    java.util.ArrayList<String> route = new java.util.ArrayList<String>();
    route.add(idPosteCible);
    String o = idPosteOrigine == null ? "" : idPosteOrigine;
    if ("sS1.3.1".equals(o)) {
        route.add("sSR1.5.1");   // bouteilles non conformes
    } else if ("sS1.3.2".equals(o)) {
        route.add("sSR1.5.2");   // accessoires non conformes
    } else if ("sS1.3.4".equals(o)) {
        route.add("sSR1.5.4");   // GPL non conforme
    }
    // sDR1.1.1 (retour client) : la cible d'echec (sDR1.4.2) est deja le SINK
    // final, pas d'etape supplementaire necessaire.

    java.util.ArrayList<String> propre = new java.util.ArrayList<String>();
    for (String id : route) {
        if (trouverPoste(id) != null) propre.add(id);
    }
    return propre;
}

void lancerFluxVisuelAllerRetour(String idA, String idB, String suffix) {
    // Represente un echange requete/reponse entre deux micro-activites : un
    // flux aller (idA -> idB) puis un flux retour (idB -> idA), lances en
    // sequence immediate (flux visuels quasi instantanes, ~0.05s/arret).
    java.util.ArrayList<String> aller = new java.util.ArrayList<String>();
    if (trouverPoste(idA) != null) aller.add(idA);
    if (trouverPoste(idB) != null) aller.add(idB);
    if (aller.size() >= 2) {
        lancerFluxVisuelRuntime("VISUEL_MSG_" + idA.replaceAll("[^A-Za-z0-9]", "_") + "_" + idB.replaceAll("[^A-Za-z0-9]", "_") + "_" + suffix, aller);
    }
    java.util.ArrayList<String> retour = new java.util.ArrayList<String>();
    if (trouverPoste(idB) != null) retour.add(idB);
    if (trouverPoste(idA) != null) retour.add(idA);
    if (retour.size() >= 2) {
        lancerFluxVisuelRuntime("VISUEL_RETOUR_" + idB.replaceAll("[^A-Za-z0-9]", "_") + "_" + idA.replaceAll("[^A-Za-z0-9]", "_") + "_" + suffix, retour);
    }
}

void lancerFluxVisuelCommandeEmission(CommandeAgent cmd) {
    // C14.6 -- nouveau schema de flux "commande" : sP4.4.4/sD1.1.1 ne
    // reagissent plus en parallele de sP2.4.1/sS1.1.2 des l'emission. Le flux
    // client va jusqu'a sD1.3.4, qui contacte alors sD1.8.1 (verification stock,
    // aller-retour) puis sP4.4.4 (plan de livraison, aller-retour) avant de
    // continuer vers sD1.4.4 (couvert ici -- routeDeliverClientNominale a ete
    // tronquee en consequence pour ne pas dupliquer ce trajet).
    String suffix = cmd != null && cmd.idCommande != null ? cmd.idCommande.replaceAll("[^A-Za-z0-9]", "_") : "CMD";

    java.util.ArrayList<String> route = new java.util.ArrayList<String>();
    for (String id : new String[] { "sP2.4.1", "sS1.1.2", "sD1.2.1", "sD1.3.4", "sD1.4.4" }) {
        if (trouverPoste(id) != null) route.add(id);
    }
    if (route.size() >= 2) {
        lancerFluxVisuelRuntime("VISUEL_EMISSION_" + suffix, route);
    }

    // Echanges bidirectionnels inities par sD1.3.4.
    lancerFluxVisuelAllerRetour("sD1.3.4", "sD1.8.1", suffix);
    lancerFluxVisuelAllerRetour("sD1.3.4", "sP4.4.4", suffix);

    // Si le stock de produit fini est insuffisant pour cette commande, sP4.4.4
    // remonte l'information a sP3.4.1 (planification production) -- cas verifie
    // lors de l'echange sD1.3.4 <-> sD1.8.1 puis remonte a sP4.4.4.
    double stockDisponible = stockProduitFiniDisponibleTotal();
    if (cmd != null && stockDisponible < cmd.qte) {
        java.util.ArrayList<String> routeStockInsuffisant = new java.util.ArrayList<String>();
        for (String id : new String[] { "sP4.4.4", "sP3.4.1" }) {
            if (trouverPoste(id) != null) routeStockInsuffisant.add(id);
        }
        if (routeStockInsuffisant.size() >= 2) {
            lancerFluxVisuelRuntime("VISUEL_STOCK_INSUFFISANT_" + suffix, routeStockInsuffisant);
        }
    }
}

void lancerFluxVisuelLancementProduction(CommandeAgent cmd) {
    // Flux visuel de lancement de production, cote ZENER : planification
    // (sP3.4.1) puis ordonnancement (sM1.1.1). S'arrete avant sM1.2.1 : la suite
    // (sM1.2.1 -> sM1.6.1, embranchements controle de poids sM1.3.4->sM1.3.5/
    // sM1.3.6 et sM1.3.6->sM1.4.1/sM1.7.1 compris) est deja parcourue par les
    // entites produit reelles (routeProductionMakeDepuisScenario), qui declenchent
    // elles-memes la diffusion vers les autres successeurs. Aller plus loin ici
    // dupliquerait le flux reel de production (meme piege que sP4.4.4). Un seul
    // flux de planification est lance par commande, quelle que soit la quantite :
    // la multiplicite par produit (un flux reel par unite de cmd.qte) reste geree
    // independamment par lancerProductionCommandeOrchestree, a partir de sM1.2.1.
    java.util.ArrayList<String> route = new java.util.ArrayList<String>();
    for (String id : new String[] { "sP3.4.1", "sM1.1.1" }) {
        if (trouverPoste(id) != null) route.add(id);
    }
    if (route.size() >= 2) {
        String suffix = cmd != null && cmd.idCommande != null ? cmd.idCommande.replaceAll("[^A-Za-z0-9]", "_") : "CMD";
        lancerFluxVisuelRuntime("VISUEL_LANCEMENT_PROD_" + suffix, route);

        // C14.6 -- sM1.1.1 verifie le stock de matiere disponible (sS1.4.4)
        // avant de relancer l'appro : echange aller-retour.
        lancerFluxVisuelAllerRetour("sM1.1.1", "sS1.4.4", suffix);
    }
}

void lancerFluxVisuelApproMatiereProduction(CommandeAgent cmd) {
    // Flux visuel representant la sortie de matiere (bonbonnes vides/accessoires
    // deja transferees en magasin, sS1.4.4) vers sM1.2.1, declenche en parallele
    // du flux de planification (sP3.4.1 -> sM1.1.1). sM1.2.1 a deux predecesseurs
    // reels (sS1.4.4 et sM1.1.1) et a besoin des deux pour demarrer son travail :
    // contrairement a la convergence sD1.2.1, ces deux flux ne doivent PAS
    // fusionner -- les deux entrees a sM1.2.1 sont legitimes.
    java.util.ArrayList<String> route = new java.util.ArrayList<String>();
    for (String id : new String[] { "sS1.4.4", "sM1.2.1" }) {
        if (trouverPoste(id) != null) route.add(id);
    }
    if (route.size() >= 2) {
        String suffix = cmd != null && cmd.idCommande != null ? cmd.idCommande.replaceAll("[^A-Za-z0-9]", "_") : "CMD";
        lancerFluxVisuelRuntime("VISUEL_APPRO_MATIERE_" + suffix, route);
    }
}

void lancerFluxVisuelRetourClient(CommandeAgent cmd) {
    // Flux visuel du retour client : demande d'autorisation (sSR1.3.1), decision
    // ZENER (sDR1.1.1, AIGUILLAGE reel : 85% autorise / 15% rejet immediat vers
    // sDR1.4.2), transit par sSR1.5.3 (etape reelle du graphe, sans laquelle
    // sDR1.3.1 n'est jamais atteint), reception (sDR1.3.1), transfert vers
    // inspection (sDR1.4.1), puis issue nominale (sDR1.4.2). sDR1.4.1 n'a pas de
    // regleAiguillage propre entre rejet (sDR1.4.2) et reintegration (sDR1.4.3)
    // -- non corrige ici (hors perimetre demande) ; le mecanisme de diffusion
    // vers les autres successeurs illustrera sDR1.4.3 comme branche alternative.
    java.util.ArrayList<String> route = new java.util.ArrayList<String>();
    for (String id : new String[] { "sSR1.3.1", "sDR1.1.1", "sSR1.5.3", "sDR1.3.1", "sDR1.4.1", "sDR1.4.2" }) {
        if (trouverPoste(id) != null) route.add(id);
    }
    if (route.size() >= 2) {
        String suffix = cmd != null && cmd.idCommande != null ? cmd.idCommande.replaceAll("[^A-Za-z0-9]", "_") : "CMD";
        lancerFluxVisuelRuntime("VISUEL_RETOUR_CLIENT_" + suffix, route);
    }
}

java.util.ArrayList<String> routeSourceApprovisionnementPourMatiere(String idMatiere) {
    java.util.ArrayList<String> route = new java.util.ArrayList<String>();
    String m = idMatiere == null ? "" : idMatiere.toUpperCase(java.util.Locale.ROOT);

    if (m.contains("GPL")) {
        route.add("sS1.1.1");   // planifier les livraisons GPL côté ZENER
        route.add("sD1.2.2");   // réception/validation de la commande côté fournisseur GPL
        route.add("sD1.3.1");   // réserver le stock fournisseur GPL
        route.add("sD1.11.1");  // charger le transporteur GPL
        route.add("sD1.12.1");  // expédier le GPL vers ZENER
        route.add("sS1.2.1");   // réception GPL vrac chez ZENER
        route.add("sS1.3.4");   // contrôle conformité GPL
        route.add("sS1.4.4");   // stock partagé (alimente sM1.2.1)
    } else if (m.contains("BOUTEILLE") || m.contains("BONBONNE")) {
        route.add("sS1.1.3");   // planifier les livraisons bonbonnes vides
        route.add("sD1.2.3");   // réception/validation de la commande côté fournisseur bouteilles
        route.add("sD1.3.2");   // réserver le stock fournisseur bouteilles
        route.add("sD1.11.2");  // charger camion bouteilles
        route.add("sD1.12.2");  // expédier bouteilles vers ZENER
        route.add("sS1.2.2");   // réception bouteilles chez ZENER
        route.add("sS1.3.1");   // contrôle conformité bouteilles
        route.add("sS1.4.4");   // stock partagé (alimente sM1.2.1)
    } else if (m.contains("ACCESS") || m.contains("KIT")) {
        route.add("sS1.1.4");   // planifier les livraisons accessoires
        route.add("sD1.2.4");   // réception/validation de la commande côté fournisseur accessoires
        route.add("sD1.3.3");   // réserver le stock fournisseur accessoires
        route.add("sD1.11.3");  // charger camion accessoires
        route.add("sD1.12.3");  // expédier accessoires vers ZENER
        route.add("sS1.2.3");   // réception accessoires chez ZENER
        route.add("sS1.3.2");   // contrôle conformité accessoires
        route.add("sS1.4.4");   // stock partagé (alimente sM1.2.1)
    }

    // Securite : retirer les postes inexistants dans le JSON charge.
    java.util.ArrayList<String> propre = new java.util.ArrayList<String>();
    for (String id : route) {
        if (trouverPoste(id) != null) propre.add(id);
    }
    return propre;
}

java.util.ArrayList<String> routeDeliverClientNominale() {
    // C14.6 -- sD1.3.4 et sD1.4.4 sont desormais couverts par
    // lancerFluxVisuelCommandeEmission (des l'emission de la commande, avec les
    // echanges aller-retour sD1.3.4<->sD1.8.1 et sD1.3.4<->sP4.4.4). Cette route
    // demarre donc a sD1.5.4 pour eviter de les parcourir en double.
    java.util.ArrayList<String> route = new java.util.ArrayList<String>();
    String[] ids = new String[] {
        "sD1.5.4", "sD1.6.1", "sD1.7.1",
        "sD1.8.1", "sD1.9.1", "sD1.10.1", "sD1.11.4", "sD1.12.4",
        "sS1.2.4", "sS1.3.3", "sS1.4.5"
    };
    for (String id : ids) {
        if (trouverPoste(id) != null) route.add(id);
    }
    return route;
}

void lancerFluxVisuelRuntime(String prefix, java.util.ArrayList<String> route) {
    if (route == null || route.isEmpty()) return;
    PosteGenericAgent premier = trouverPoste(route.get(0));
    if (premier == null) return;

    FluxEntity e = add_fluxEntites();
    String pfx = prefix == null || prefix.trim().isEmpty() ? "VISUEL" : prefix.trim();
    e.idFlux = pfx + "_" + (++seqFlux);
    e.tEntreeSysteme = time();
    e.feuilleDeRoute = new java.util.ArrayList<String>(route);
    e.typeProduit = "TRACE_VISUEL_SCOR";
    e.etapeCourante = 0;
    try { positionnerEntiteSurPoste(e, premier); } catch (Throwable ignored) {}
    try { premier.enter.take(e); } catch (Throwable ex) { board.logEvent("[VISUEL-FLOW] impossible de lancer " + e.idFlux + " : " + ex.getMessage()); }
}

String idSS14PourMatiere(String idMatiere) {
    String m = idMatiere == null ? "" : idMatiere.toUpperCase(java.util.Locale.ROOT);
    if (m.contains("GPL")) return "sS1.4.1";
    if (m.contains("BOUTEILLE") || m.contains("BONBONNE")) return "sS1.4.2";
    if (m.contains("ACCESS") || m.contains("KIT")) return "sS1.4.3";
    return null;
}

String idSP44PourMatiere(String idMatiere) {
    String m = idMatiere == null ? "" : idMatiere.toUpperCase(java.util.Locale.ROOT);
    if (m.contains("GPL")) return "sP4.4.1";
    if (m.contains("BOUTEILLE") || m.contains("BONBONNE")) return "sP4.4.2";
    if (m.contains("ACCESS") || m.contains("KIT")) return "sP4.4.3";
    return null;
}

String idSD13PourMatiere(String idMatiere) {
    String m = idMatiere == null ? "" : idMatiere.toUpperCase(java.util.Locale.ROOT);
    if (m.contains("GPL")) return "sD1.3.1";
    if (m.contains("BOUTEILLE") || m.contains("BONBONNE")) return "sD1.3.2";
    if (m.contains("ACCESS") || m.contains("KIT")) return "sD1.3.3";
    return null;
}

void lancerFluxVisuelSourceApprovisionnement(String idMatiere) {
    java.util.ArrayList<String> route = routeSourceApprovisionnementPourMatiere(idMatiere);
    String suffix = idMatiere == null ? "MATIERE" : idMatiere.replaceAll("[^A-Za-z0-9]", "_");
    lancerFluxVisuelRuntime("VISUEL_SOURCE_" + suffix, route);

    // C14.6 -- a sD1.3.x : echange aller-retour avec sS1.4.x (stock
    // fournisseur), puis avec sP4.4.x (plan fournisseur), avant de continuer
    // vers sD1.11.x. Remplace l'ancien flux parallele independant
    // (routePlanFournisseurPourMatiere) : sP4.4.x n'est plus contacte
    // directement des la demande, mais via sD1.3.x.
    String idD13 = idSD13PourMatiere(idMatiere);
    String idS14 = idSS14PourMatiere(idMatiere);
    String idP44 = idSP44PourMatiere(idMatiere);
    if (idD13 != null && idS14 != null) lancerFluxVisuelAllerRetour(idD13, idS14, suffix);
    if (idD13 != null && idP44 != null) lancerFluxVisuelAllerRetour(idD13, idP44, suffix);

    // Retour fournisseur (matiere non conforme) : le mecanisme de diffusion vers
    // les autres successeurs illustre deja sS1.3.x -> sSR1.1.2 (2 arrets) quand
    // le flux d'approvisionnement principal passe par le controle qualite, mais
    // s'arrete la (garde anti-cascade). Ce flux dedie complete la demonstration
    // jusqu'au SINK final specifique a la matiere.
    lancerFluxVisuelRetourFournisseur(idMatiere);
}

void lancerFluxVisuelRetourFournisseur(String idMatiere) {
    // Flux visuel du retour fournisseur : controle qualite (sS1.3.x) ->
    // identification/isolement du defaut (sSR1.1.2) -> SINK final specifique a
    // la matiere (sSR1.5.1 bouteilles / sSR1.5.2 accessoires / sSR1.5.4 GPL).
    java.util.ArrayList<String> route = new java.util.ArrayList<String>();
    String m = idMatiere == null ? "" : idMatiere.toUpperCase(java.util.Locale.ROOT);

    if (m.contains("GPL")) {
        route.add("sS1.3.4");
        route.add("sSR1.1.2");
        route.add("sSR1.5.4");
    } else if (m.contains("BOUTEILLE") || m.contains("BONBONNE")) {
        route.add("sS1.3.1");
        route.add("sSR1.1.2");
        route.add("sSR1.5.1");
    } else if (m.contains("ACCESS") || m.contains("KIT")) {
        route.add("sS1.3.2");
        route.add("sSR1.1.2");
        route.add("sSR1.5.2");
    }

    java.util.ArrayList<String> propre = new java.util.ArrayList<String>();
    for (String id : route) {
        if (trouverPoste(id) != null) propre.add(id);
    }
    if (propre.size() >= 2) {
        String suffix = idMatiere == null ? "MATIERE" : idMatiere.replaceAll("[^A-Za-z0-9]", "_");
        lancerFluxVisuelRuntime("VISUEL_RETOUR_FOURNISSEUR_" + suffix, propre);
    }
}

void lancerFluxVisuelDeliverClient(CommandeAgent cmd) {
    lancerFluxVisuelRuntime("VISUEL_DELIVER_" + (cmd != null ? cmd.idCommande : "CMD"), routeDeliverClientNominale());
}

void enregistrerTraceSourceApprovisionnementCommande(CommandeAgent cmd, String idMatiere, String fournisseur, double quantite) {
    if (cmd == null) return;
    java.util.ArrayList<String> route = routeSourceApprovisionnementPourMatiere(idMatiere);
    if (route == null || route.isEmpty()) return;

    int q = Math.max(1, (int) Math.ceil(quantite));
    for (String id : route) {
        PosteGenericAgent p = trouverPoste(id);
        if (p == null) continue;
        String code = p.codeSCOR == null ? "" : codeGroupeL3(p.codeSCOR);
        String evt = "APPRO_" + (idMatiere == null ? "MATIERE" : idMatiere.toUpperCase(java.util.Locale.ROOT)) + "_" + code.replace('.', '_');
        double duree = 2.0;
        if (code.startsWith("S1.1")) duree = 2.0;
        else if (code.startsWith("D1.2")) duree = 2.0;
        else if (code.startsWith("D1.3")) duree = 3.0;
        else if (code.startsWith("D1.11")) duree = 2.0;
        else if (code.startsWith("D1.12")) duree = 6.0;
        else if (code.startsWith("S1.2")) duree = 2.0;
        else if (code.startsWith("S1.3")) duree = 1.5;
        else if (code.startsWith("S1.4")) duree = 1.0;

        enregistrerTraceExecutionCommande(
            cmd,
            p.idPoste,
            code,
            evt,
            duree,
            0.0,
            q,
            "Approvisionnement réel SCOR pour " + idMatiere + " via " + p.nom + " / fournisseur=" + fournisseur
        );
    }
}

// C14.32 -- meme correction que le MRP (C14.29/31), appliquee ici au chemin
// SEPARE de l'approvisionnement declenche directement par une commande (Cas
// 3, declencherApprovisionnementCommande). Ce chemin utilisait sa propre
// fenetre fixe (delaiApprovisionnementCommandeMinSec/MaxSec, 12-20s), sans
// aucun rapport avec delaiObtentionHeures ni les loiTemps des postes sS1.2.x
// / sS1.3.x -- doublon independant du MRP, avec le meme defaut. Le delai reel
// est le maximum, parmi les matieres effectivement manquantes, du delai
// fournisseur plus reception/controle : la production ne peut demarrer que
// lorsque TOUTES les matieres necessaires sont arrivees.
double delaiApprovisionnementReelMax(ScenarioFlux sc, int qteCommande) {
    if (sc == null || sc.nomenclature == null) return 0.0;
    double maxDelai = 0.0;
    boolean retardVirtuelUtilise = false;
    for (LigneNomenclature l : sc.nomenclature) {
        if (l == null) continue;
        FicheMatiere f = trouverFicheMatiere(l.idMatiere);
        double besoin = l.quantiteParUnite * Math.max(1, qteCommande);
        double disponible = f != null ? f.stockDisponible : 0.0;
        if (besoin - disponible <= 0.0001) continue;
        double heures = f != null ? Math.max(0.0, f.delaiObtentionHeures) : 0.0;
        if (f != null && retardFournisseurCibleCorrespond(f)
            && !(retardFournisseurUneSeuleReception && retardFournisseurConsomme)
            && !(retardFournisseurUneSeuleReception && retardVirtuelUtilise)) {
            heures = delaiFournisseurConfigureEffectifHeures(f);
            retardVirtuelUtilise = true;
        }
        double delaiObtention = heures * 3600.0;
        double delaiTotal = delaiObtention + dureeReceptionEtControleReelle(l.idMatiere);
        maxDelai = Math.max(maxDelai, delaiTotal);
    }
    return maxDelai;
}

void declencherApprovisionnementCommande(CommandeAgent cmd, ScenarioFlux sc, int qteCommande) {
    if (cmd == null || sc == null || sc.nomenclature == null || sc.nomenclature.isEmpty()) return;

    double decalageSourceSuiviSec = 0.0;
    for (LigneNomenclature l : sc.nomenclature) {
        if (l == null) continue;
        FicheMatiere f = trouverFicheMatiere(l.idMatiere);
        double besoin = l.quantiteParUnite * Math.max(1, qteCommande);
        double disponible = f != null ? f.stockDisponible : 0.0;
        double manque = Math.max(0, besoin - disponible);
        if (manque <= 0.0001) continue;

        String fournisseur = fournisseurPourMatiere(l.idMatiere);

        ajouterSuiviDetailleHorodate(
            time() + decalageSourceSuiviSec,
            "Approvisionnement",
            "Commande fournisseur declenchee par manque matiere",
            "La commande client ne peut pas etre produite avec le stock matiere disponible. ZENER commande la matiere manquante avant de lancer la production.",
            "Agent operationnel de pilotage Source",
            "Agent d'execution S1.1 / fournisseur",
            "Matiere " + l.idMatiere + " pour commande " + cmd.idCommande,
            "Besoin=" + String.format("%.1f", besoin) + " ; disponible=" + String.format("%.1f", disponible) + " ; manque=" + String.format("%.1f", manque),
            "ZENER SA Togo",
            fournisseur,
            "MRP -> commande fournisseur",
            "P2.3 / S1.1 / Supplier D1.2-D1.12 / Manufacturer S1.2-S1.4",
            "Commander la matiere manquante avant production.",
            "Matiere insuffisante",
            "Approvisionnement declenche",
            "Besoin brut ; stock disponible ; besoin net ; delai d'approvisionnement"
        );

        // Correction cohérence SCOR : l'approvisionnement ne doit plus être une
        // simple ligne synthétique. On alimente les vrais postes Source/Fournisseur
        // et les postes de réception ZENER, puis on lance un flux visuel rapide
        // pour que la vue globale ne reste pas à zéro.
        enregistrerTraceSourceApprovisionnementCommande(cmd, l.idMatiere, fournisseur, manque);
        lancerFluxVisuelSourceApprovisionnement(l.idMatiere);
        enregistrerFluxSupplyChainMetier(
            "APPROVISIONNEMENT_PHYSIQUE",
            fournisseur,
            "ZENER SA Togo",
            (int) Math.ceil(manque),
            "Approvisionnement physique réel SCOR pour " + l.idMatiere + " / " + cmd.idCommande
        );

        emettreFluxLog(FluxLog.APPRO, fournisseur, "ZENER SA Togo", (int) Math.ceil(manque));

        if (f != null) {
            ajouterSuiviDetailleHorodate(
                time() + decalageSourceSuiviSec + 1.0,
                "Approvisionnement en transit",
                "Reception matiere planifiee",
                "La matiere commandee reste en transit. Le stock ne sera credite qu'au message MaterialReceived.",
                "Agent operationnel de pilotage Source",
                "Agent d'execution fournisseur / transport",
                "Matiere " + l.idMatiere,
                "A recevoir=" + String.format("%.1f", manque) + " ; stock courant=" + String.format("%.1f", f.stockDisponible),
                fournisseur,
                "ZENER SA Togo",
                "Supplier D1.2-D1.12 -> Manufacturer S1.2 -> S1.3 -> S1.4",
                "S1.1 / D1.2 / D1.3 / D1.11 / D1.12 / S1.2 / S1.3 / S1.4",
                "Attendre la reception et le controle avant Make.",
                "Commande fournisseur emise",
                "Matiere en transit",
                "Besoin net ; quantite en transit ; temps d'approvisionnement"
            );
        }
        decalageSourceSuiviSec += 2.0;
    }
}



java.util.ArrayList<String> routeProductionMakeDepuisScenario(ScenarioFlux sc) {
    java.util.ArrayList<String> route = new java.util.ArrayList<String>();

    // Cas 2 / Cas 3 : lorsque le stock produit fini est insuffisant, le produit
    // fabriqué doit entrer dans Make. Les étapes fournisseur Source/Deliver ne
    // doivent pas être rejouées si les matières sont déjà disponibles. La livraison
    // client est déclenchée ensuite au niveau commande, après complétion du lot.
    if (sc != null && sc.sequence != null) {
        for (String id : sc.sequence) {
            PosteGenericAgent p = trouverPoste(id);
            String code = p != null && p.codeSCOR != null ? codeGroupeL3(p.codeSCOR) : "";
            if (code.toUpperCase(java.util.Locale.ROOT).startsWith("M")) {
                route.add(id);
            }
        }
    }

    // Fallback : si le scénario sélectionné ne contient pas explicitement Make,
    // on récupère tous les postes Make configurés dans le référentiel.
    if (route.isEmpty() && postes != null) {
        for (PosteGenericAgent p : postes) {
            if (p == null || p.idPoste == null || p.codeSCOR == null) continue;
            String code = codeGroupeL3(p.codeSCOR);
            if (code.toUpperCase(java.util.Locale.ROOT).startsWith("M")) route.add(p.idPoste);
        }
    }

    return route;
}


void enregistrerPreparationProductionCommande(CommandeAgent cmd) {
    if (cmd == null) return;

    // Ces étapes sont des décisions/activités de préparation au niveau commande.
    // Elles précèdent le flux produit Make et ne doivent pas rester à zéro dans le Cas 2.
    enregistrerTraceExecutionCommande(
        cmd,
        "sP3.4.1",
        "P3.4",
        "PLANIFICATION_PRODUCTION_COMMANDE",
        2.0,
        0.0,
        cmd.qte,
        "Plan de production établi après constat de stock fini insuffisant et matière disponible"
    );
    enregistrerTraceExecutionCommande(
        cmd,
        "sM1.1.1",
        "M1.1",
        "ORDONNANCEMENT_PRODUCTION_COMMANDE",
        2.0,
        0.0,
        cmd.qte,
        "Ordonnancement des activités Make pour produire le lot complet demandé"
    );

    ajouterSuiviDetaille(
        "Planification production",
        "Production planifiée et ordonnancée",
        "Avant d’envoyer les unités dans Make, le modèle enregistre la planification de production et l’ordonnancement du lot complet.",
        "Agent tactique / agent opérationnel de pilotage Make",
        "Agent de planification production",
        "Commande " + cmd.idCommande,
        "Quantite=" + cmd.qte,
        "Decision matière",
        "Atelier Make",
        "Plan production -> ordonnancement Make",
        "P3.4 / M1.1",
        "Préparer correctement la production avant l’exécution des micro-activités Make.",
        "Production autorisée",
        "Production ordonnancée",
        "Temps de planification ; temps d’ordonnancement ; quantité à produire"
    );
}


void ajouterSuiviEtapeDeliver(CommandeAgent cmd, String titre, String description, String poste, String flux, String decision, String statutAvant, String statutApres, double duree, double decalageSuiviSec) {
    if (cmd == null) return;
    ajouterSuiviDetailleHorodate(
        time() + Math.max(0.0, decalageSuiviSec),
        "Livraison",
        titre,
        description,
        "Agent operationnel de pilotage Deliver",
        poste,
        "Commande " + cmd.idCommande,
        "Quantite=" + cmd.qte + " ; duree tracee=" + String.format("%.1f", duree) + "s",
        "Atelier Make / magasin produits finis",
        "Client final",
        flux,
        poste,
        decision,
        statutAvant,
        statutApres,
        "Temps Deliver ; quantite livree ; taux de service"
    );
}

void enregistrerTraceDeliverApresProduction(CommandeAgent cmd) {
    if (cmd == null) return;

    // Après production, Deliver ne doit pas être sauté. On enregistre la chaîne Deliver
    // complète du lot avant la réception client. Cela rend visibles D1.5 à D1.12,
    // notamment le chargement et l’expédition physique.
    // C14.29 -- OPTION A : chaque duree tracee est desormais un echantillon
    // reel de la loiTemps configuree pour le poste correspondant (au lieu
    // d'une constante codee en dur), via dureeTraitement().
    enregistrerTraceExecutionCommande(cmd, "sD1.3.4",  "D1.3",  "PREPARATION_EXPEDITION_APRES_PRODUCTION", (trouverPoste("sD1.3.4") != null ? trouverPoste("sD1.3.4").dureeTraitement() : 0.0), 0.0, cmd.qte, "Préparation de l'expédition du lot complet après production");
    enregistrerTraceExecutionCommande(cmd, "sD1.4.4",  "D1.4",  "REGROUPEMENT_COMMANDE_APRES_PRODUCTION", (trouverPoste("sD1.4.4") != null ? trouverPoste("sD1.4.4").dureeTraitement() : 0.0), 0.0, cmd.qte, "Regroupement de la commande produite avant constitution du chargement");
    enregistrerTraceExecutionCommande(cmd, "sD1.5.4",  "D1.5",  "CONSTITUTION_CHARGEMENT_CLIENT", (trouverPoste("sD1.5.4") != null ? trouverPoste("sD1.5.4").dureeTraitement() : 0.0), 0.0, cmd.qte, "Constitution du chargement client pour le lot complet");
    enregistrerTraceExecutionCommande(cmd, "sD1.6.1",  "D1.6",  "PLANIFICATION_ITINERAIRE_LIVRAISON", (trouverPoste("sD1.6.1") != null ? trouverPoste("sD1.6.1").dureeTraitement() : 0.0), 0.0, cmd.qte, "Planification de l’itinéraire de livraison client");
    enregistrerTraceExecutionCommande(cmd, "sD1.7.1",  "D1.7",  "SELECTION_TRANSPORTEUR", (trouverPoste("sD1.7.1") != null ? trouverPoste("sD1.7.1").dureeTraitement() : 0.0), 0.0, cmd.qte, "Sélection du transporteur et tarification de la livraison");
    enregistrerTraceExecutionCommande(cmd, "sD1.8.1",  "D1.8",  "RECEPTION_PRODUIT_DEPUIS_STOCK", (trouverPoste("sD1.8.1") != null ? trouverPoste("sD1.8.1").dureeTraitement() : 0.0), 0.0, cmd.qte, "Réception du produit produit/libéré depuis le magasin produits finis pour Deliver");
    enregistrerTraceExecutionCommande(cmd, "sD1.9.1",  "D1.9",  "PRELEVEMENT_BONBONNES_STOCK", (trouverPoste("sD1.9.1") != null ? trouverPoste("sD1.9.1").dureeTraitement() : 0.0), 0.0, cmd.qte, "Prélèvement des bonbonnes produites pour la commande client");
    enregistrerTraceExecutionCommande(cmd, "sD1.10.1", "D1.10", "CONDITIONNEMENT_EXPEDITION", (trouverPoste("sD1.10.1") != null ? trouverPoste("sD1.10.1").dureeTraitement() : 0.0), 0.0, cmd.qte, "Conditionnement du produit pour expédition client");
    enregistrerTraceExecutionCommande(cmd, "sD1.11.4", "D1.11", "CHARGEMENT_CAMION_CLIENT_APRES_PRODUCTION", (trouverPoste("sD1.11.4") != null ? trouverPoste("sD1.11.4").dureeTraitement() : 0.0), 0.0, cmd.qte, "Chargement physique du camion client pour le lot complet produit");
    enregistrerTraceExecutionCommande(cmd, "sD1.12.4", "D1.12", "EXPEDITION_CLIENT_APRES_PRODUCTION", (trouverPoste("sD1.12.4") != null ? trouverPoste("sD1.12.4").dureeTraitement() : 0.0), 0.0, cmd.qte, "Expédition physique des bonbonnes produites vers le client");
    enregistrerTraceExecutionCommande(cmd, "sS1.2.4",  "S1.2",  "RECEPTION_LIVRAISON_CLIENT", (trouverPoste("sS1.2.4") != null ? trouverPoste("sS1.2.4").dureeTraitement() : 0.0), 0.0, cmd.qte, "Réception physique du lot complet par le client");
    enregistrerTraceExecutionCommande(cmd, "sS1.3.3",  "S1.3",  "VERIFICATION_CONFORMITE_CLIENT", (trouverPoste("sS1.3.3") != null ? trouverPoste("sS1.3.3").dureeTraitement() : 0.0), 0.0, cmd.qte, "Vérification de conformité du lot complet reçu");

    // Lignes explicites dans le tableau de suivi : le Deliver n'est pas saute,
    // il est parcouru en étapes lisibles avant la réception client.
    ajouterSuiviEtapeDeliver(cmd,
        "Préparation de l'expédition du lot produit",
        "Le lot complet est préparé pour quitter le magasin produits finis.",
        "D1.3 / D1.4",
        "Make -> préparation expédition",
        "Préparer et regrouper la commande produite.",
        "Lot complet prêt",
        "Expédition préparée",
        5.0,
        0.0
    );
    ajouterSuiviEtapeDeliver(cmd,
        "Constitution et planification du chargement",
        "Le modèle constitue le chargement client, planifie l'itinéraire et sélectionne le transporteur.",
        "D1.5 / D1.6 / D1.7",
        "Préparation expédition -> transporteur",
        "Constituer le chargement et organiser le transport.",
        "Expédition préparée",
        "Chargement planifié",
        5.5,
        5.0
    );
    ajouterSuiviEtapeDeliver(cmd,
        "Prélèvement et conditionnement pour expédition",
        "Les bonbonnes produites sont prélevées puis conditionnées avant le chargement physique.",
        "D1.8 / D1.9 / D1.10",
        "Stock produits finis -> zone chargement",
        "Prélever et conditionner le lot complet.",
        "Chargement planifié",
        "Lot prêt au chargement",
        5.0,
        10.5
    );
    ajouterSuiviEtapeDeliver(cmd,
        "Chargement camion et expédition physique",
        "Le camion client est chargé puis expédié vers le client final.",
        "D1.11 / D1.12",
        "ZENER SA Togo -> Client final",
        "Charger le camion et expédier physiquement le lot.",
        "Lot prêt au chargement",
        "Expédition physique effectuée",
        10.0,
        15.5
    );

    ajouterSuiviDetailleHorodate(
        time() + 25.5,
        "Livraison",
        "Chaîne Deliver exécutée après production",
        "Le lot complet produit passe par la préparation, la constitution du chargement, le chargement camion, l’expédition physique puis la réception client.",
        "Agent opérationnel de pilotage Deliver",
        "Agents d’exécution D1.3 à D1.12 puis agent client S1.2/S1.3",
        "Commande " + cmd.idCommande,
        "Quantite=" + cmd.qte,
