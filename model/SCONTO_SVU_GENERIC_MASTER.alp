String _nom = nomAffiche == null ? "" : nomAffiche.trim();
if (_nom.matches("(?i)ASup-sD[123]")) {
    String _occ = _nom.substring(_nom.length() - 1);
    String _p = "sD" + _occ;
    message = "Deliver Supervisor Agent :\n\n"
        + "Cet agent encapsule les responsabilités suivantes : "
        + _p + ".3, " + _p + ".4, " + _p + ".5, " + _p + ".6, " + _p + ".7";
} else if (_nom.equalsIgnoreCase("ASup-sSR")) {
    String _occ = String.valueOf(main.indiceModeSCOR());
    message = "Source Return Supervisor Agent :\n\n"
        + "Cet agent encapsule les responsabilités suivantes : "
        + "sSR" + _occ + ".2, sSR" + _occ + ".3, sSR" + _occ + ".4";
} else if (_nom.equalsIgnoreCase("ASup-sDR")) {
    String _occ = String.valueOf(main.indiceModeSCOR());
    message = "Deliver Return Supervisor Agent :\n\n"
        + "Cet agent encapsule les responsabilités suivantes : "
        + "sDR" + _occ + ".1, sDR" + _occ + ".2";
} else {
    String codeSCOR = main.extraireCodeSCORDepuisNomMovable(_nom);
    if (codeSCOR.isEmpty()) {
        message = "Aucun code SCOR détecté pour cet agent.";
    } else {
        message = main.rapportPostesParCodeSCOR(codeSCOR);
    }
}

