				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782200003003</Id>
					<Name><![CDATA[viderActeursSC]]></Name>
					<X>-300</X><Y>1180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[acteursSC.clear(); fluxLogs.clear(); selectedActeurIdx = -1;
messageStatut = "Acteurs supprimes.";
board.logEvent("[LOG] Acteurs SC vides.");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782200003004</Id>
					<Name><![CDATA[emettreFluxLog]]></Name>
					<X>-300</X><Y>1220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[typeFlux]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idSrc]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idCib]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[qte]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (fluxLogs == null) fluxLogs = new java.util.ArrayList<FluxLog>();
String typeNormalise = typeFluxLisible(typeFlux);
String src = idSrc == null ? "" : idSrc;
String dst = idCib == null ? "" : idCib;
int quantite = Math.max(1, qte);

boolean doublonRecent = false;
for (FluxLog f : fluxLogs) {
    if (f == null) continue;
    String ft = typeFluxLisible(f.typeFlux);
    if (ft.equals(typeNormalise)
        && src.equals(f.idSource)
        && dst.equals(f.idCible)
        && f.qte == quantite
        && Math.abs(time() - f.tEmission) <= 1.0) {
        doublonRecent = true;
        break;
    }
}

if (!doublonRecent) {
    fluxLogs.add(new FluxLog(typeNormalise, src, dst, quantite, time()));
    while (fluxLogs.size() > 200) fluxLogs.remove(0);
}

// Les flux physiques sont maintenant documentés dans Flux Supply Chain et par des
// lignes métier dédiées. On évite donc la ligne générique "Flux métier" dans le suivi.
if (FluxLog.INFO.equals(typeFlux)) {
    ajouterSuivi("Flux metier", "Declenchement du flux " + typeFlux, "Quantite=" + quantite, src, dst, typeFlux);
}

// Portage ancienne version : APPRO/LIVRAISON ne sont plus seulement des emails,
// ils utilisent une icone Vehicle comme sourcingTruck/deliveryTruck.
if (FluxLog.APPRO.equals(typeFlux)) {
    animerApprovisionnementVehicule(src, dst, quantite);
} else if (FluxLog.LIVRAISON.equals(typeFlux)) {
    animerLivraisonVehicule(src, dst, quantite);
} else if (FluxLog.RETOUR.equals(typeFlux)) {
    ajouterSuiviDetaille(
        "Retour",
        "Flux retour declenche",
        "Un produit ou une commande fait l'objet d'un retour vers l'entreprise focale.",
        "Agent Return / Client",
        "Vehicule retour",
        "Flux retour",
        "Quantite=" + quantite,
        src,
        dst,
        src + " -> " + dst,
        "DR1 / SR1",
        "Retourner le produit pour traitement.",
        "Produit livre ou non conforme",
        "Retour en cours",
        "Taux de retour ; cout de non-qualite ; delai retour"
    );
    String srcAnim = puppet(src) != null ? src : "CUSTOMER:AOe-sSR1.5";
    String dstAnim = puppet(dst) != null ? dst : "MANUFACTURER:AOe-sDR1.3";
    animerVehiculePhysiqueAllerRetour(srcAnim, dstAnim, "returnTruck", "SCOR DR1 -> RETURN | Flux physique retour x" + quantite);
} else {
    emettreFluxInformationnelAnime(src, dst, typeNormalise, typeNormalise + " x" + quantite);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ActeurSC]]></ReturnType>
					<Id>1783700000040</Id>
					<Name><![CDATA[trouverPremierActeurParCategorie]]></Name>
					<X>-300</X><Y>1240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[categorie]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String cat = normaliserCategorieActeur(categorie);
for (ActeurSC a : acteursSC) {
    if (a == null || !a.actif) continue;
    if (cat.equals(normaliserCategorieActeur(a.categorie))) return a;
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783700000041</Id>
					<Name><![CDATA[mapCategorieToType]]></Name>
					<X>-300</X><Y>1260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[categorie]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Choix d'icone station (type) selon la categorie de l'acteur, parmi
// les icones deja cablees dans la presentation de Movable.
if (ActeurSC.FOURNISSEUR.equals(categorie))       return "Warehouse";
if (ActeurSC.ENTREPRISE_FOCALE.equals(categorie)) return "Strategique";
if (ActeurSC.CLIENT.equals(categorie))            return "sP1";
return "Tactique";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783700000042</Id>
					<Name><![CDATA[mapCodeSCORToType]]></Name>
					<X>-300</X><Y>1280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Choix d'icone station (type) selon la lettre de tete du code SCOR
// du poste, parmi les icones deja cablees dans la presentation de Movable.
if (codeSCOR == null || codeSCOR.isEmpty()) return "Operationnel";
char c = Character.toUpperCase(codeSCOR.charAt(0));
if (c == 'S') return "Warehouse";
if (c == 'M') return "Machine";
if (c == 'D') return "Vehicle";
return "box";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783700000043</Id>
					<Name><![CDATA[positionnerStationAnimation]]></Name>
					<X>-300</X><Y>1300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[m]]></Name>
						<Type><![CDATA[Movable]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[index]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[xStart]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[yStart]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[colWidth]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[rowHeight]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[maxCols]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int col = index % maxCols;
int row = index / maxCols;
m.setXY(xStart + col * colWidth, yStart + row * rowHeight);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783700000044</Id>
					<Name><![CDATA[creerStationsAnimation]]></Name>
					<X>-300</X><Y>1320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Synchronise la vue animée avec les Movables statiques réalignés.
while (stationsAnimation.size() > 0) {
    remove_stationsAnimation(stationsAnimation.get(stationsAnimation.size() - 1));
}
puppets.clear();
puppetXY.clear();

registerViewAnimationStaticPuppets();
garantirActeurEntrepriseFocale();

// Alias des acteurs configurés vers les domaines visuels correspondants.
for (ActeurSC a : acteursSC) {
    if (a == null || !a.actif) continue;
    a.categorie = normaliserCategorieActeur(a.categorie);
    if (ActeurSC.FOURNISSEUR.equals(a.categorie)) {
        registerPuppetAnchor(a.nom, CA_sD1, 400, 6620);
        registerPuppetAnchor(a.idActeur, CA_sD1, 400, 6620);
    } else if (ActeurSC.ENTREPRISE_FOCALE.equals(a.categorie)) {
        registerPuppetAnchor(a.nom, AS_sP1, 1320, 6340);
        registerPuppetAnchor(a.idActeur, AS_sP1, 1320, 6340);
        registerPuppetAnchor("ENTREPRISE", AS_sP1, 1320, 6340);
        registerPuppetAnchor("ENTREPRISE_FOCALE", AS_sP1, 1320, 6340);
        registerPuppetAnchor(nomEntreprise, AS_sP1, 1320, 6340);
    } else if (ActeurSC.CLIENT.equals(a.categorie)) {
        registerPuppetAnchor(a.nom, CA_sS1_3, 2100, 6580);
        registerPuppetAnchor(a.idActeur, CA_sS1_3, 2100, 6580);
    }
}

// Les postes réels sont rattachés aux agents opérationnels Manufacturer.
for (PosteGenericAgent p : postes) {
    if (p == null) continue;
    String c = p.codeSCOR == null ? "" : p.codeSCOR.trim();
    String u = c.toUpperCase(java.util.Locale.ROOT);
    Movable anchor = null;
    double ax = 1320, ay = 6340;
    if (u.matches("SS[123]\\.1.*")) { anchor=AOp_sS1_1; ax=740; ay=6720; }
    else if (u.matches("SS[123]\\.2.*")) { anchor=AOe_sS1_2; ax=660; ay=6860; }
    else if (u.matches("SS[123]\\.3.*")) { anchor=AOe_sS1_3; ax=920; ay=6860; }
    else if (u.matches("SS[123]\\.4.*")) { anchor=AOe_sS1_4; ax=820; ay=6960; }
    else if (u.matches("SM[123]\\.1.*")) { anchor=AOp_sM1_1; ax=1360; ay=6760; }
    else if (u.matches("SM[123]\\.2.*")) { anchor=AOe_sM1_2; ax=1140; ay=6900; }
    else if (u.matches("SM[123]\\.3.*")) { anchor=AOe_sM1_3; ax=1400; ay=6900; }
    else if (u.matches("SM[123]\\.4.*")) { anchor=AOe_sM1_4; ax=1240; ay=7060; }
    else if (u.matches("SM[123]\\.5.*")) { anchor=AOe_sM1_5; ax=1720; ay=7060; }
    else if (u.matches("SM[123]\\.6.*")) { anchor=AOe_sM1_6; ax=1720; ay=6960; }
    else if (u.matches("SM[123]\\.7.*")) { anchor=AOe_sM1_7; ax=1480; ay=7020; }
    else if (u.matches("SD[123]\\.2.*")) { anchor=AOe_sD1_2; ax=1920; ay=6840; }
    else if (u.matches("SD[123]\\.[3-7].*")) { anchor=ASup_sD1; ax=1680; ay=6840; }
    else if (u.matches("SD[123]\\.8.*")) { anchor=AOe_sD1_8_3; ax=1620; ay=6730; }
    else if (u.matches("SD[123]\\.9.*")) { anchor=AOe_sD1_9_manufacturer; ax=1580; ay=6980; }
    else if (u.matches("SD[123]\\.10.*")) { anchor=AOe_sD1_10_manufacturer; ax=1660; ay=6980; }
    else if (u.matches("SD[123]\\.11.*")) { anchor=AOe_sD1_11_manufacturer; ax=1740; ay=6980; }
    else if (u.matches("SD[123]\\.12.*")) { anchor=AOe_sD1_12_2; ax=1840; ay=6980; }
    else if (u.matches("SSR[123]\\.[2-4].*")) { anchor=ASup_sSR_manufacturer; ax=1880; ay=7180; }
    else if (u.matches("SSR[123]\\.1.*")) { anchor=AOe_sSR1_1_manufacturer; ax=1840; ay=7300; }
    else if (u.matches("SSR[123]\\.5.*")) { anchor=AOe_sSR1_5_manufacturer; ax=1940; ay=7300; }
    else if (u.matches("SDR[123]\\.[12].*")) { anchor=ASup_sDR; ax=1560; ay=7180; }
    else if (u.matches("SDR[123]\\.3.*")) { anchor=AOe_sDR1_3; ax=1640; ay=7300; }
    else if (u.matches("SDR[123]\\.4.*")) { anchor=AOe_sDR1_4_manufacturer; ax=1740; ay=7300; }
    if (anchor != null) {
        registerPuppetAnchor(p.nom, anchor, ax, ay);
        registerPuppetAnchor(p.idPoste, anchor, ax, ay);
        registerPuppetAnchor(c, anchor, ax, ay);
    }
}

board.logEvent("[ANIM] Vue réalignée enregistrée : flux informationnels pointillés et flux physiques pleins.");]]></Body>
				</Function>
