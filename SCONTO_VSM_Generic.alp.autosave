					<Action><![CDATA[// Met a jour le timer simule puis traite les actions metier differees.
actualiserTempsSimulation();
if (modeExecution) traiterActionsMetierDifferees();
// Doit fonctionner aussi AVANT modeExecution pour permettre les flux T=0.
for (Movable m : messagesAnimes) {
    if (!m.libre && m.arriveeAt >= 0 && time() >= m.arriveeAt) {
        onMessageArrived(m);
    }
}]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000050</Id>
					<Name><![CDATA[ajouterPoste]]></Name>
					<X>2520</X><Y>-1000</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// 1. CONTRÔLE : Nom de la micro-activité obligatoire
if (champNom == null || champNom.trim().isEmpty()) {
    messageStatut = "ERREUR : Nom de la micro-activité obligatoire.";
    getExperimentHost().showMessageDialog(
        "⚠️ Champ manquant\n\nLe nom de la micro-activité is obligatoire.\nVeuillez saisir un nom avant de valider.");
    return;
}
String nomNettoye = champNom.trim();

// 2. CONTRÔLE unicité du nom
for (PosteGenericAgent posteExistant : postes) {
    if (posteExistant.nom.equalsIgnoreCase(nomNettoye)) {
        messageStatut = "ERREUR : Une micro-activité '" + nomNettoye + "' existe déjà.";
        getExperimentHost().showMessageDialog(
            "⚠️ Doublon détecté\n\nUne micro-activité nommée '" + nomNettoye + "' existe déjà.\nChoisissez un nom différent.");
        return;
    }
}

// 3. EXTRACTION du code SCOR depuis le ComboBox
String selectionSCOR = champCodeSCOR != null ? champCodeSCOR.trim() : "";
String codeSCORExtrait = selectionSCOR;
if (selectionSCOR.contains(" — ")) {
    codeSCORExtrait = selectionSCOR.split(" — ")[0].trim();
}
if (codeSCORExtrait.isEmpty()) {
    messageStatut = "ERREUR : Activité SCOR N3 non sélectionnée.";
    getExperimentHost().showMessageDialog(
        "⚠️ Activité SCOR manquante\n\nVeuillez sélectionner une activité SCOR Niveau 3\ndans la liste déroulante avant d'ajouter la micro-activité.");
    return;
}

// Contrôle : acteur responsable obligatoire
String idActeurSelectionne = extraireIdActeurDepuisCombo(champActeurLieMicro);
ActeurSC acteurResp = trouverActeurParId(idActeurSelectionne);

if (acteurResp == null) {
    messageStatut = "ERREUR : aucun acteur responsable sélectionné.";

    getExperimentHost().showMessageDialog(
        "⚠️ Acteur responsable manquant\n\n"
        + "Avant d'ajouter une micro-activité, vous devez choisir\n"
        + "l'acteur de la chaîne auquel cette micro-activité est rattachée.\n\n"
        + "Ordre recommandé :\n"
        + "1. Configurer les acteurs de la chaîne\n"
        + "2. Configurer les micro-activités\n"
        + "3. Assigner chaque micro-activité à un acteur"
    );

    return;
}

// 4. CONTRÔLE ET RECHERCHE DES POSTES PRÉCÉDENTS
String chaineSaisie = editbox7.getText() != null ? editbox7.getText().trim() : "";

// Si l'utilisateur a saisi des parents, on valide qu'ils existent bien tous avant de créer le poste
if (!chaineSaisie.isEmpty()) {
    String[] elements = chaineSaisie.split(",");
    for (String nomParent : elements) {
        String nomParentNettoye = nomParent.trim();
        if (nomParentNettoye.isEmpty()) continue;
        
        // Vérification de l'existence dans la collection
        boolean existe = false;
        for (PosteGenericAgent ex : postes) {
            if (ex.nom.equalsIgnoreCase(nomParentNettoye)) {
                existe = true;
                break;
            }
        }
        if (!existe) {
            messageStatut = "ERREUR : Le poste précédent '" + nomParentNettoye + "' n'existe pas.";
            getExperimentHost().showMessageDialog(
                "⚠️ Poste précédent introuvable\n\nLe poste '" + nomParentNettoye + "' n'existe pas dans le système.");
            return; 
        }
    }
}

// 5. GÉNÉRATION DE L'ID AUTOMATIQUE
int indexSousActivite = 1;
String prefixId = "s" + codeSCORExtrait + ".";
for (PosteGenericAgent ex : postes) {
    if (ex.idPoste.startsWith(prefixId)) indexSousActivite++;
}
String idGenere = prefixId + indexSousActivite;

// 6. CRÉATION ET CONFIGURATION DE L'AGENT
PosteGenericAgent p = add_postes();
p.idPoste            = idGenere;
p.nom                = nomNettoye;
p.codeSCOR           = codeSCORExtrait;
p.typePoste          = TypePoste.valueOf(champTypePoste);
p.loiTemps           = new LoiTemps(champLoiDist, champP1, champP2);
p.capaciteSimultanee = champCapacite;
p.tauxVA = Math.max(0.0, Math.min(1.0, champTauxVA));
p.coutHoraireMainOeuvre = Math.max(0.0, champCoutHoraireMainOeuvre);
p.coutMatierePremiereParUnite = Math.max(0.0, champCoutMatierePremiereParUnite);
p.valeurActifFixe = Math.max(0.0, champValeurActifFixe);

// Mode du poste : genere ses propres entites (autonome) ou attend uniquement
// de recevoir d'un poste amont (comportement historique par defaut).
p.genereAutonome = champGenereAutonome;
p.politiqueApproPoste = (champPolitiqueApproPoste != null) ? champPolitiqueApproPoste.trim() : "";
p.intervalleApproPoste = Math.max(0.0, champIntervalleApproPoste);
p.tauxArriveePoissonPoste = Math.max(0.0, champTauxArriveePoissonPoste);
p.quantiteParApproPoste = Math.max(1.0, champQuantiteParApproPoste);

// Taille de lot de traitement (batch) : 1 = comportement historique (unite par unite).
p.tailleLot = Math.max(1, (int) Math.round(champTailleLot));

// Jonction multi-amont : si coche, le poste attend une entite de CHACUNE de
// ses branches amont declarees (chainesPrecedents) avant de relacher la suite.
// On reutilise le meme mecanisme de lot (tailleLot/lotEnCours) : la taille de
// lot est alors automatiquement alignee sur le nombre de predecesseurs.
p.attendTousLesPredecesseurs = champAttendTousLesPredecesseurs;
if (p.attendTousLesPredecesseurs) {
    int nbParents = 1;
    if (p.chainesPrecedents != null && !p.chainesPrecedents.trim().isEmpty()) {
        nbParents = Math.max(1, p.chainesPrecedents.split(",").length);
    }
    p.tailleLot = nbParents;
}

// Controle qualite / aiguillage (Phase 2) — disponible sur tout type de poste
if (champControleQualiteActif) {
    String cible = (champCibleEchec != null) ? champCibleEchec.trim() : "";
    p.regleAiguillage = new RegleAiguillage(champTypeControleQualite, champTauxConforme, cible);
} else {
    p.regleAiguillage = null;
}

// Liaison micro-activité -> acteur de chaîne
p.idActeurResponsable = acteurResp.idActeur;
p.nomActeurResponsable = acteurResp.nom;
p.categorieActeurResponsable = acteurResp.categorie;
p.typeAnnexeActeurResponsable = acteurResp.typeAnnexe;

// Liaison acteur -> micro-activité
acteurResp.ajouterMicroActivite(p.idPoste);

// ON STOCKE LE STRING DIRECTEMENT DANS L'AGENT
p.chainesPrecedents  = chaineSaisie; 
p.estUnPosteAlternatif = checkbox.isSelected();

// Connexion logique AnyLogic à la volée (split)
if (!p.chainesPrecedents.isEmpty()) {
    String[] elements = p.chainesPrecedents.split(",");
    for (String nomParent : elements) {
        String nomParentNettoye = nomParent.trim();
        for (PosteGenericAgent ex : postes) {
            if (ex.nom.equalsIgnoreCase(nomParentNettoye)) {
                p.connectTo(ex); // Connexion réseau AnyLogic
                break;
            }
        }
    }
}

// 7. POSITIONNEMENT + AGENT OPÉRATIONNEL
positionnerPoste(p);
OperationalAgent op = add_opAgents();
op.initialiser(p, p.codeSCOR);
board.logEvent("[HOLON] OperationalAgent créé pour " + p.idPoste);

// OperationalAgent automatique de base
op.idAgentLogique = "OP_AUTO_" + p.idPoste;
op.idActeurSC = acteurResp.idActeur;
op.nomActeurSC = acteurResp.nom;
op.niveauHierarchique = "OPERATIONAL";
op.numeroInstance = 1;

if (!p.idsOperationalAgents.contains(op.idAgentLogique)) {
    p.idsOperationalAgents.add(op.idAgentLogique);
}

refreshMicroActiviteComboBox();
rafraichirComboPostes();
MicroResponsabilite r = new MicroResponsabilite();

r.idResponsabilite = "RESP_" + (++seqResponsabilite);
r.idMicroActivite = p.idPoste;
r.nomMicroActivite = p.nom;

r.idActeur = acteurResp.idActeur;
r.nomActeur = acteurResp.nom;
r.categorieActeur = acteurResp.categorie;
r.typeAnnexeActeur = acteurResp.typeAnnexe;

r.niveauHierarchique = "OPERATIONAL";
r.typeAgent = "OperationalAgent";
r.isTactic = false;
r.quantite = 1;
r.actif = true;

r.idsAgentsCrees.add(op.idAgentLogique);

responsabilitesMicro.add(r);
p.idsResponsabilites.add(r.idResponsabilite);
messageStatut = "Micro-activité '" + p.nom + "' (" + p.idPoste + ") ajoutée.";
board.logEvent("Micro-activité ajoutée : " + p.idPoste);
refreshActeursMicroComboBox();
refreshMicroActiviteComboBox();

// Fusionne automatiquement ce nouveau poste avec un OperationalAgent existant
// s'il partage le meme (acteur, SCOR N3) qu'un poste deja configure.
recalculerTousLesGroupesOperationnels();

// Replace proprement l'ensemble des postes (le nouveau poste peut creer une
// nouvelle colonne / decaler ses successeurs).
relayoutTousLesPostes();
// Maintient viewAnimation synchronisée avec les postes créés manuellement.
creerStationsAnimation();
fluxInfoInitialDejaDeclenche = false;
declencherFluxInformationInitiale();

// 8. CONFIRMATION VISUELLE
getExperimentHost().showMessageDialog(
     "✅ Micro-activité ajoutée avec succès\n\n"
    + "Nom                : " + p.nom + "\n"
    + "ID généré          : " + p.idPoste + "\n"
    + "SCOR N3            : " + p.codeSCOR + "\n"
    + "Acteur responsable : " + acteurResp.nom + " [" + acteurResp.typeAffiche() + "]\n"
    + "Précédents         : " + (p.chainesPrecedents.isEmpty() ? "—" : p.chainesPrecedents) + "\n"
    + "Total micro-activités : " + postes.size()
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000051</Id>
					<Name><![CDATA[positionnerPoste]]></Name>
					<X>2520</X><Y>-940</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Body><![CDATA[if (p.positionManuelle) {
    p.setXY(p.xManuel, p.yManuel);
    return;
}
// Placement initial simple (bande du bon acteur). Le placement fin topologique
// est fait globalement par relayoutTousLesPostes() apres chargement/ajout.
int indexActeur = indexActeurDe(p.idActeurResponsable);
Integer nbRacines = nbRacinesParActeur.get(p.idActeurResponsable);
int rangLigne = (nbRacines == null) ? 0 : nbRacines;
nbRacinesParActeur.put(p.idActeurResponsable, rangLigne + 1);
double y = LAYOUT_Y_BASE + indexActeur * LAYOUT_BAND_HEIGHT + rangLigne * LAYOUT_LANE_HEIGHT;
p.setXY(LAYOUT_X_START, y);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1791000001201</Id>
					<Name><![CDATA[indexActeurDe]]></Name>
					<X>2520</X><Y>-910</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idActeur]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < acteursSC.size(); i++) {
    if (acteursSC.get(i).idActeur.equals(idActeur)) return i;
}
return 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000001203</Id>
					<Name><![CDATA[relayoutTousLesPostes]]></Name>
					<X>2520</X><Y>-850</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (postes.isEmpty()) return;

java.util.HashMap<String,PosteGenericAgent> parNom = new java.util.HashMap<String,PosteGenericAgent>();
for (PosteGenericAgent p : postes) {
    if (p.nom != null) parNom.put(p.nom.trim().toLowerCase(), p);
    if (p.idPoste != null) parNom.put(p.idPoste.trim().toLowerCase(), p);
}

java.util.HashMap<PosteGenericAgent, java.util.ArrayList<PosteGenericAgent>> parents =
    new java.util.HashMap<PosteGenericAgent, java.util.ArrayList<PosteGenericAgent>>();
for (PosteGenericAgent p : postes) {
    java.util.ArrayList<PosteGenericAgent> lst = new java.util.ArrayList<PosteGenericAgent>();
    if (p.chainesPrecedents != null && !p.chainesPrecedents.trim().isEmpty()) {
        for (String np : p.chainesPrecedents.split(",")) {
            PosteGenericAgent par = parNom.get(np.trim().toLowerCase());
            if (par != null && par != p) lst.add(par);
        }
    }
    parents.put(p, lst);
}

java.util.HashMap<PosteGenericAgent,Integer> profondeur = new java.util.HashMap<PosteGenericAgent,Integer>();
for (PosteGenericAgent p : postes) {
    calculerProfondeur(p, parents, profondeur, new java.util.HashSet<PosteGenericAgent>());
}

nbRacinesParActeur.clear();
final java.util.HashMap<PosteGenericAgent,Integer> profF = profondeur;
java.util.HashMap<String,Integer> occupationColonne = new java.util.HashMap<String,Integer>();

java.util.ArrayList<PosteGenericAgent> ordre = new java.util.ArrayList<PosteGenericAgent>();
for (PosteGenericAgent pp : postes) ordre.add(pp);
java.util.Collections.sort(ordre, new java.util.Comparator<PosteGenericAgent>() {
    public int compare(PosteGenericAgent a, PosteGenericAgent b) {
        int ia = indexActeurDe(a.idActeurResponsable);
        int ib = indexActeurDe(b.idActeurResponsable);
        if (ia != ib) return Integer.compare(ia, ib);
        int pa = profF.get(a), pb = profF.get(b);
        if (pa != pb) return Integer.compare(pa, pb);
        return a.idPoste.compareTo(b.idPoste);
    }
});

for (PosteGenericAgent p : ordre) {
    if (p.positionManuelle) continue;
    int prof = profF.get(p);
    int idxActeur = indexActeurDe(p.idActeurResponsable);
    String cle = p.idActeurResponsable + "#" + prof;
    int rang = occupationColonne.containsKey(cle) ? occupationColonne.get(cle) : 0;
    occupationColonne.put(cle, rang + 1);

    double x = LAYOUT_X_START + prof * LAYOUT_X_STEP;
    double yLigne = rang * LAYOUT_LANE_HEIGHT;
    if (p.estUnPosteAlternatif) yLigne += LAYOUT_ALT_OFFSET;
    double y = LAYOUT_Y_BASE + idxActeur * LAYOUT_BAND_HEIGHT + yLigne;
    p.setXY(x, y);
}

board.logEvent("[LAYOUT] Relayout global effectue sur " + postes.size() + " poste(s).");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1791000001204</Id>
					<Name><![CDATA[calculerProfondeur]]></Name>
					<X>2520</X><Y>-820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[parents]]></Name>
						<Type><![CDATA[java.util.HashMap<PosteGenericAgent, java.util.ArrayList<PosteGenericAgent>>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[memo]]></Name>
						<Type><![CDATA[java.util.HashMap<PosteGenericAgent,Integer>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[enCours]]></Name>
						<Type><![CDATA[java.util.HashSet<PosteGenericAgent>]]></Type>
					</Parameter>
					<Body><![CDATA[if (memo.containsKey(p)) return memo.get(p);
if (enCours.contains(p)) return 0;
enCours.add(p);
java.util.ArrayList<PosteGenericAgent> pars = parents.get(p);
int prof = 0;
if (pars != null) {
    for (PosteGenericAgent par : pars) {
        prof = Math.max(prof, 1 + calculerProfondeur(par, parents, memo, enCours));
    }
}
enCours.remove(p);
memo.put(p, prof);
return prof;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1781300000052</Id>
					<Name><![CDATA[validerConfig]]></Name>
					<X>2520</X><Y>-880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (acteursSC.size() == 0) {
    messageStatut = "ERREUR : aucun acteur de la chaîne défini.";
    return false;
}

if (postes.size() == 0) {
    messageStatut = "ERREUR : Aucun poste defini.";
    return false;
}

for (PosteGenericAgent p : postes) {
    if (macroPrefixe(p.codeSCOR).equals("??")) {
        messageStatut =
            "ERREUR : Code SCOR invalide sur poste "
            + p.idPoste
            + " ("
            + p.codeSCOR
            + ")";
        return false;
    }

    if (p.idActeurResponsable == null || p.idActeurResponsable.trim().isEmpty()) {
        messageStatut =
            "ERREUR : la micro-activité "
            + p.idPoste
            + " n'est liée à aucun acteur responsable.";
        return false;
    }

    if (trouverActeurParId(p.idActeurResponsable) == null) {
        messageStatut =
            "ERREUR : la micro-activité "
            + p.idPoste
            + " référence un acteur inexistant : "
            + p.idActeurResponsable;
        return false;
    }
}

if (scenarios.isEmpty()) {
    messageStatut = "ERREUR : Aucun scenario defini. Ajoutez au moins un scenario.";
    return false;
}

for (ScenarioFlux sc : scenarios) {
    for (String id : sc.sequence) {
        if (trouverPoste(id) == null) {
            StringBuilder idsValides = new StringBuilder();

            for (PosteGenericAgent p : postes) {
                idsValides.append(p.idPoste).append(" ");
            }

            messageStatut =
                "ERREUR : scenario '"
                + sc.typeProduit
                + "' reference un poste inconnu : "
                + id
                + ". IDs valides : "
                + idsValides.toString().trim();

            return false;
        }
    }
}

messageStatut =
    "Configuration valide. "
    + postes.size()
    + " postes, "
    + scenarios.size()
    + " scenarios, "
    + acteursSC.size()
    + " acteurs prêts.";

return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000053</Id>
					<Name><![CDATA[demarrerSimulation]]></Name>
					<X>2520</X><Y>-820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!validerConfig()) return;

// Panneau de depart : date simulee, echelle temps et budgets.
// Le demarrage est annule si l'utilisateur ferme/annule ce panneau.
if (afficherPopupTempsBudgetAuDemarrage || !paramsTempsBudgetValides) {
    if (!ouvrirParametresTempsBudgetDebut()) {
        messageStatut = "Demarrage annule : parametres temps/budget non valides.";
        board.logEvent("[TEMPS/BUDGET] demarrage annule avant execution");
        return;
    }
} else {
    initialiserHorlogeSimulation();
}

String avertissementsMRP = verifierCoherenceMRP();
if (!avertissementsMRP.isEmpty()) {
    getExperimentHost().showMessageDialog(
        "⚠️ Avertissement configuration MRP (non bloquant) : " + avertissementsMRP
        + "La simulation va démarrer normalement ; corrigez ces points dans \"Configurer nomenclature\" si besoin."
    );
}

// Phase de preparation : on garde modeExecution=false pour garantir
// qu'aucun evenement metier cyclique ne se declenche avant la fin du demarrage.
modeExecution = false;
tempsDebutSimulation = -1;
commandesGenereesDepuisDemarrage = 0;
messageLimiteCommandesDejaAffiche = false;
actionsMetierDifferees.clear();
dernierPopupMetierA = -999999.0;
try { arrivee.reset(); } catch (Throwable ignored) {}
try { generateurCommandes.reset(); } catch (Throwable ignored) {}
try { tickAppro.reset(); } catch (Throwable ignored) {}

board.reset();
resetSuiviSimulation();
if (fluxLogs != null) fluxLogs.clear();
if (tracesBrutes != null) tracesBrutes.clear();
if (tracesAgregees != null) tracesAgregees.clear();
seqTrace = 0;
seqTraceBrute = 0;
seqTraceAgregee = 0;
commandesClotureesTracees.clear();
seqFlux = 0;
seqProduitRuntime = 0;

ajouterSuivi("Simulation", "Demarrage de la simulation", "Validation terminee : postes=" + postes.size() + ", scenarios=" + scenarios.size() + ", acteurs=" + acteursSC.size(), "Utilisateur", "Modele", "START");

orderRegistry.clear();
produitRegistry.clear();
produitsTerminesParCommandeRuntime.clear();
appliquerStocksInitiauxConfig();
creerStationsAnimation();
fluxInfoInitialDejaDeclenche = false;

// Initialiser les agents tactiques
while (tacticals.size() > 0) {
    remove_tacticals(tacticals.get(tacticals.size() - 1));
}

// Initialiser les coordinateurs dedies (1 par macro-processus)
while (supervisorsMacro.size() > 0) {
    remove_supervisorsMacro(supervisorsMacro.get(supervisorsMacro.size() - 1));
}

initTacticals();
initSupervisorsMacro();

// Activation metier officielle : a partir de cette ligne seulement,
// les commandes, productions, livraisons et retours sont autorises.
modeExecution = true;
tempsDebutSimulation = time();
simStartRealMillis = 0L;
initialiserHorlogeSimulation();
actualiserTempsSimulation();

ajouterSuiviDetaille(
    "Parametrage temps/budget",
    "Parametres temporels et budgetaires appliques",
    "Le modele fixe la date simulee de depart, l'echelle de conversion temps simulation vers temps reel, puis les budgets de reference.",
    "Utilisateur",
    "Modele SCONTO-VSM",
    "Horloge simulee et budgets SCOR",
    resumeTempsBudgetSimulation(),
    "Panneau de demarrage",
    "Modele de simulation",
    "Parametres utilisateur -> horloge et budgets",
    "PLAN / SCOR",
    "Initialiser l'horloge et les budgets avant les flux metier.",
    "Parametres non appliques",
    "Parametres appliques",
    "Date simulee ; echelle temps ; budget global ; budgets Plan/Source/Make/Deliver/Return"
);

// Communications initiales : elles restent informationnelles et ne declenchent
// ni approvisionnement, ni production, ni livraison.
declencherFluxInformationInitiale();

messageStatut = "Simulation demarree. " + postes.size() + " postes actifs.";
board.logEvent("=== SIMULATION DEMARREE ===");
ajouterSuivi("Simulation", "Simulation demarree", messageStatut, "Modele", "Utilisateur", "START");

// Mode cas d'etude : la commande client pilote toute la chaine.
// Les anciens flux autonomes sont desactives pour eviter les incoherences.
if (modePilotageParCommande) {
    try { arrivee.reset(); } catch (Throwable ignored) {}
    try { tickAppro.reset(); } catch (Throwable ignored) {}

    // En mode cas d'etude, la generation est orchestree par notre file d'actions
    // pour maitriser les delais et le nombre de commandes. L'ancien event cyclique
    // reste desactive afin de ne pas polluer les tests.
    try { generateurCommandes.reset(); } catch (Throwable ignored) {}

    ajouterSuiviDetaille(
        "Mode de pilotage",
        "Pilotage par commande client active",
        "Le modele attend ou genere des commandes client : chaque approvisionnement, production ou livraison doit etre la consequence d'une commande.",
        "Utilisateur",
        "Modele SCONTO-VSM",
        "Scenario de simulation",
        "Stocks par defaut : produit fini=" + String.format("%.0f", champStockInitialProduitFini) + " ; matiere=" + String.format("%.0f", champStockInitialMatiereGlobal) + " ; " + resumeNombreCommandes(),
        "Vue Configuration",
        "Generateur de commandes",
        "Commande client -> Analyse stock -> Source/Make/Deliver",
        "D1.1 / D1.2",
        "Utiliser la commande comme declencheur principal.",
        "Mode preparation",
        "Mode execution par commande",
        "Temps de traitement commande ; taux de service ; stock fini ; besoin matiere"
    );

    // Premiere commande demonstrative planifiee avec un petit delai : elle apparait
    // apres le lancement et devient le vrai declencheur du cas.
    planifierPremiereCommandeDemonstrative();
} else {
    try { arrivee.restart(); } catch (Throwable ignored) {}
    try { tickAppro.restart(); } catch (Throwable ignored) {}
    try { generateurCommandes.reset(); } catch (Throwable ignored) {}
}

viewExecution.navigateTo();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000054</Id>
					<Name><![CDATA[arreterSimulation]]></Name>
					<X>2520</X><Y>-760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[modeExecution = false;
arrivee.reset();
strategic.piGlobalCourant = strategic.calculerPIGlobal();
board.logEvent("=== SIMULATION ARRETEE - PI=" + String.format("%.3f", strategic.piGlobalCourant) + " ===");
//viewDashboard.navigateTo();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000055</Id>
					<Name><![CDATA[navigate]]></Name>
					<X>2520</X><Y>-700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[va]]></Name>
						<Type><![CDATA[ViewArea]]></Type>
					</Parameter>
					<Body><![CDATA[va.navigateTo();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782940000002</Id>
					<Name><![CDATA[positionnerEntiteSurPoste]]></Name>
					<X>-300</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[poste]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Body><![CDATA[// Positionne instantanement l'entite sur le poste de creation/entree
// et la rend visible dans viewAll (utilise a la creation ou lors d'une
// reprise pour eviter un \"saut\" visuel non justifie).
if (poste == null || e == null) return;
e.setXY(poste.getX(), poste.getY());
e.estVisible = true;
ajouterSuivi("Entree poste", "Arrivee sur une micro-activite", "Flux=" + e.idFlux + " | Poste=" + poste.nom + " | Produit=" + e.typeProduit, "Flux", poste.nom, poste.codeSCOR);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782940000003</Id>
					<Name><![CDATA[deplacerEntiteVersPoste]]></Name>
					<X>-300</X><Y>280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cible]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Body><![CDATA[// Deplacement visuel anime (moveTo AnyLogic) de l'entite vers le poste
// suivant de sa feuille de route. La logique de process (enter.take)
// reste inchangee ; ceci ne pilote que la representation physique.
if (cible == null || e == null) return;
e.estVisible = true;
e.moveTo(cible.getX(), cible.getY());
ajouterSuivi("Deplacement", "Deplacement du produit vers le poste suivant", "Flux=" + e.idFlux + " | Destination=" + cible.nom, "Poste courant", cible.nom, cible.codeSCOR);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782940000004</Id>
					<Name><![CDATA[masquerEntite]]></Name>
					<X>-300</X><Y>290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Body><![CDATA[// Masque l'entite (fin de parcours, rebut, ejection) sans affecter
// sa position courante, au cas ou elle serait reutilisee.
if (e == null) return;
e.estVisible = false;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000060</Id>
					<Name><![CDATA[routerEntite]]></Name>
					<X>-300</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Body><![CDATA[e.etapeCourante++;
String idCible = e.prochainPoste();
if (idCible == null) {
    finDeParcours(e);
    return;
}
PosteGenericAgent cible = trouverPoste(idCible);
if (cible == null) {
    traceln("ERREUR : poste introuvable -> " + idCible);
    finDeParcours(e);
    return;
}
mettreAJourProduitPassage(e, cible);
ajouterSuivi("Micro-activite", "Passage vers une nouvelle etape", "Flux=" + e.idFlux + " | Poste=" + cible.nom + " | Produit=" + e.typeProduit, "Etape precedente", cible.nom, cible.codeSCOR);
deplacerEntiteVersPoste(e, cible);
cible.enter.take(e);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PosteGenericAgent]]></ReturnType>
					<Id>1781300000061</Id>
					<Name><![CDATA[trouverPoste]]></Name>
					<X>-300</X><Y>360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[id]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[for (PosteGenericAgent p : postes) {
    if (p.idPoste.equals(id)) return p;
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PosteGenericAgent]]></ReturnType>
					<Id>1782700000099</Id>
					<Name><![CDATA[trouverPosteParNomOuId]]></Name>
					<X>-300</X><Y>365</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ref]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Recherche un poste par son idPoste (priorité) ou par son nom.
// Tolère les deux formats : JSON produit par code (IDs) et JSON natif AnyLogic (noms).
if (ref == null || ref.trim().isEmpty()) return null;
String r = ref.trim();
// 1) Par idPoste
for (PosteGenericAgent p : postes) {
    if (p.idPoste.equals(r)) return p;
}
// 2) Par nom (insensible à la casse)
for (PosteGenericAgent p : postes) {
    if (p.nom != null && p.nom.equalsIgnoreCase(r)) return p;
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000062</Id>
					<Name><![CDATA[finDeParcours]]></Name>
					<X>-300</X><Y>420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Body><![CDATA[String idFlux = e == null || e.idFlux == null ? "" : e.idFlux;
double leadTimeProduit = time() - e.tEntreeSysteme;
double waitTime = e.sommeWaitTime;
double vat      = e.sommeVAT;
double pce      = (leadTimeProduit > 0) ? vat / leadTimeProduit : 0;

// Les flux visuels servent uniquement à synchroniser les compteurs natifs de la vue globale
// avec les traces métier. Ils ne doivent pas être comptés comme des commandes terminées
// ni polluer le tableau de suivi utilisateur.
if (estFluxVisuelSeulement(e)) {
    try { masquerEntite(e); } catch (Throwable ignored) {}
    try { remove_fluxEntites(e); } catch (Throwable ignored) {}
    return;
}

ajouterSuivi("Fin de parcours", "Produit termine son parcours", "Flux=" + e.idFlux + " | Type=" + e.typeProduit + " | Lead Time=" + String.format("%.1f", leadTimeProduit) + "s", "Processus interne", "Make / Deliver", "FIN");
strategic.piGlobalCourant = strategic.calculerPIGlobal();
board.logEvent("Entite terminee LT=" + String.format("%.1f", leadTimeProduit) + "s PCE=" + String.format("%.0f", pce*100) + "%");
traceln("=== Entite terminee === LT=" + String.format("%.1f", leadTimeProduit) + "s  PCE=" + String.format("%.0f%%", pce*100));

// --- Fermeture propre du cycle commande multi-unités ---
String refCommandeFlux = (e.typeProduit == null ? "" : e.typeProduit) + " " + idFlux;
if (refCommandeFlux.contains("CMD_")) {
    for (CommandeAgent cmd : commandes) {
        if (cmd == null || cmd.idCommande == null) continue;
        if (("EN_COURS".equals(cmd.statut) || "EN_LIVRAISON".equals(cmd.statut)) && refCommandeFlux.contains(cmd.idCommande)) {

            int termines = 1;
            try {
                Integer ancien = produitsTerminesParCommandeRuntime.get(cmd.idCommande);
                termines = (ancien == null ? 0 : ancien.intValue()) + 1;
                produitsTerminesParCommandeRuntime.put(cmd.idCommande, termines);
            } catch (Throwable ignored) {}

            ajouterSuiviDetaille(
                "Production",
                termines < cmd.qte ? "Unite produite en attente du lot complet" : "Lot de production termine",
                termines < cmd.qte
                    ? "Une unite de la commande est terminee, mais la livraison client attend que toutes les unites demandees soient disponibles."
                    : "Toutes les unites de la commande sont terminees. Le modele declenche maintenant la livraison globale du lot.",
                "Agent operationnel de pilotage Make/Deliver",
                "Agent Produit / Order",
                "Commande " + cmd.idCommande,
                "Unites terminees=" + termines + "/" + cmd.qte,
                "Make",
                termines < cmd.qte ? "Attente lot complet" : "Deliver client",
                termines < cmd.qte ? "Produit fini -> regroupement commande" : "Make -> Deliver",
                "M1.6 -> D1.3",
                termines < cmd.qte ? "Attendre les autres unites avant livraison." : "Autoriser la livraison du lot complet.",
                "Production en cours",
                termines < cmd.qte ? "Lot incomplet" : "Lot complet pret a livrer",
                "Progression lot commande ; WIP ; quantite produite"
            );

            cloturerProduitAgent(e, "TERMINE");
            masquerEntite(e);
            remove_fluxEntites(e);

            if (termines < Math.max(1, cmd.qte)) {
                return;
            }

            double leadTimeCommande = Math.max(0.001, time() - cmd.tCreation);
            cmd.statut = (time() <= cmd.tPromise) ? "SERVIE" : "EN_RETARD";

            if ("MTS".equals(cmd.typeCommande)) {
                board.nbMTS++;
                board.sumLeadTimeMTS += leadTimeCommande;
            } else {
                board.nbMTO++;
                board.sumLeadTimeMTO += leadTimeCommande;
            }

            board.logEvent(
                "[DELIVER] " + cmd.idCommande + " -> " + cmd.statut
                + " (LT=" + String.format("%.1f", leadTimeCommande) + "s, qte=" + cmd.qte + ")"
            );
            cloturerOrderDepuisCommande(cmd);

            enregistrerTraceDeliverApresProduction(cmd);
            lancerFluxVisuelDeliverClient(cmd);

            enregistrerFluxSupplyChainMetier(
                "LIVRAISON_PHYSIQUE",
                "ZENER SA Togo",
                "CLIENT GENERIQUE",
                cmd.qte,
                "Livraison physique du lot complet pour " + cmd.idCommande
            );
            enregistrerFluxSupplyChainMetier(
                "RECEPTION_CLIENT",
                "CLIENT GENERIQUE / AO-sS1.2",
                "CLIENT GENERIQUE / AO-sS1.4",
                cmd.qte,
                "Reception et verification du lot complet pour " + cmd.idCommande
            );

            ajouterSuiviDetaille(
                "Livraison",
                "Reception finale de la commande par le client",
                "Le client receptionne le lot complet produit. La commande est cloturee ; son statut final depend du respect du delai promis.",
                "Agent operationnel de pilotage Deliver",
                "Agent d'execution D1.12 puis agent client S1.2/S1.3",
                "Commande " + cmd.idCommande,
                "Quantite=" + cmd.qte,
                "ZENER SA Togo / AO-sD1.12",
                "CLIENT GENERIQUE / AO-sS1.2",
                "Manufacturer D1.12 -> Customer S1.2 -> S1.3 -> S1.4",
                "D1.12 -> D1.13 / S1.2 -> S1.3 -> S1.4",
                "Cloturer la livraison et mettre a jour le statut commande.",
                "Lot complet pret a livrer",
                "Commande cloturee : " + cmd.statut,
                "Lead time=" + String.format("%.1f", leadTimeCommande) + "s ; PCE=" + String.format("%.0f", pce*100) + "% ; taux de service"
            );

            animerLivraisonVehicule("MANUFACTURER:AO-sD1.12", "CUSTOMER:AO-sS1.2", cmd.qte);
            afficherFluxAnimation("deliveryTruck", "D1.12 -> S1.2", "Manufacturer AO-sD1.12", "Customer AO-sS1.2", "Livraison/cloture de " + cmd.idCommande + " statut=" + cmd.statut + " qte=" + cmd.qte);

            enregistrerFinCommandeGlobale(
                cmd,
                leadTimeCommande,
                cmd.qte,
                "Commande produite puis livree avec statut=" + cmd.statut
            );

            evaluerRetourClientApresLivraison(cmd);
            return;
        }
    }
}

// Flux non rattaché à une commande : comportement historique conservé.
nbTermines++;
nbTerminesParProduit.merge(e.typeProduit, 1L, Long::sum);
board.notifierFin(leadTimeProduit, waitTime, vat, e.typeProduit);
addTrace(
    "BRUT",
    "System",
    e.idFlux,
    "NON_APPLICABLE",
    "N/A",
    "FIN_PARCOURS",
    "LEAD_TIME",
    leadTimeProduit,
    "s",
    "",
    Double.NaN,
    "",
    "Entite terminee : " + e.typeProduit
);
addTrace(
    "AGG_GLOBAL",
    "BlackboardAgent",
    e.idFlux,
    "NON_APPLICABLE",
    "GLOBAL",
    "GLOBAL_UPDATE",
    "PCE_GLOBAL",
    pce * 100,
    "%",
    "GLOBAL",
    board.kpiGlobal.pce() * 100,
    "sumVAT / (sumCycleTime + sumWaitTime)",
    "Mise a jour du PCE global"
);
cloturerProduitAgent(e, "TERMINE");
masquerEntite(e);
remove_fluxEntites(e);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000901</Id>
					<Name><![CDATA[genererCommande]]></Name>
					<X>10</X><Y>-610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!peutGenererNouvelleCommande()) return;

if (modePilotageParCommande) {
    commandesGenereesDepuisDemarrage++;
}

long n = commandes.size() + 1;
CommandeAgent cmd = add_commandes();
cmd.idCommande  = "CMD_" + n;
cmd.typeCommande = (getDefaultRandomGenerator().nextDouble() < 0.7) ? "MTS" : "MTO";
cmd.qte         = quantitePourNouvelleCommande();
cmd.tCreation   = time();
cmd.tPromise    = time() + (cmd.typeCommande.equals("MTS") ? 300 : 1800);
cmd.statut      = "EN_ATTENTE";

ScenarioFlux scenarioCommande = choisirScenarioPourCommande();
if (scenarioCommande != null) {
    cmd.idScenario = scenarioCommande.typeProduit;

    // Pour les cas ZENER ajoutes, la commande reste MTS : le choix exact
    // Stock/Make/Source depend ensuite des stocks initiaux et de la nomenclature.
    String nomSc = scenarioCommande.typeProduit == null ? "" : scenarioCommande.typeProduit.toUpperCase(java.util.Locale.ROOT);
    if (nomSc.contains("ZENER CAS 1") || nomSc.contains("ZENER CAS 2") || nomSc.contains("ZENER CAS 3")) {
        cmd.typeCommande = "MTS";
    }
}

cmd.tPromise = time() + (cmd.typeCommande.equals("MTS") ? 300 : 1800);

Order order = creerOuSynchroniserOrder(cmd);

ajouterSuiviDetaille(
    "Commande",
    "Emission d'une commande client",
    "Le client generique envoie une commande a ZENER SA Togo.",
    "Agent Order " + cmd.idCommande,
    "Client generique",
    "Commande " + cmd.idCommande,
    "Quantite=" + cmd.qte + " ; Strategie=" + cmd.typeCommande,
    "CLIENT GENERIQUE",
    "ZENER SA Togo",
    "Client -> Entreprise focale",
    "D1.1 / D1.2",
    "Transmettre la commande pour reception et validation.",
    "Demande client creee",
    "Commande envoyee",
    "Debut du delai client ; debut du temps de traitement commande"
);

enregistrerFluxSupplyChainMetier(
    "INFO_COMMANDE",
    "CLIENT GENERIQUE",
    "ZENER SA Togo",
    cmd.qte,
    "Commande client emise : " + cmd.idCommande
);

afficherPopupMetier(
    "Commande client",
    "Emission de " + cmd.idCommande,
    "Le client envoie une commande de " + cmd.qte + " unite(s) a ZENER SA Togo.",
    "ESSENTIEL"
);

board.logEvent("[DELIVER] Commande " + cmd.idCommande + " type=" + cmd.typeCommande + " qte=" + cmd.qte
    + " | " + (modePilotageParCommande ? ("commande " + commandesGenereesDepuisDemarrage + "/" + (limiterNombreCommandes ? Math.max(1, nombreCommandesATester) : "∞")) : "mode continu"));

afficherFluxAnimation("ORDER", "D1.2 / D2.2", "Customer / Order Agent", "Manufacturer AO-sD1.2", order != null ? order.descriptionFlux() : cmd.idCommande);
animerCommandeClientAncienne(cmd);

// La reception et les decisions suivantes sont decalees dans le temps.
planifierActionCommande("RECEPTION_COMMANDE", cmd, delaiAleatoireCourt(delaiReceptionCommandeMinSec, delaiReceptionCommandeMaxSec));
planifierProchaineCommandeSiBesoin();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000902</Id>
					<Name><![CDATA[traiterCommande]]></Name>
					<X>10</X><Y>-570</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[cmd]]></Name>
						<Type><![CDATA[CommandeAgent]]></Type>
					</Parameter>
					<Body><![CDATA[if (!modeExecution) return;

Order order = creerOuSynchroniserOrder(cmd);
if (order != null) order.valider(time());

animerMessage(
    "MANUFACTURER:AO-sD1.2",
    "AS-sP1",
    "message",
    "[D1.2] Commande validee transmise au Plan " + cmd.idCommande + " (" + cmd.typeCommande + ", qte=" + cmd.qte + ")"
);

ajouterSuiviDetaille(
    "Commande",
    "Commande recue et validee par l'entreprise focale",
    "ZENER SA Togo recoit la commande, verifie les informations et la rend exploitable par le modele.",
    "Agent operationnel de pilotage Deliver",
    "Agent d'execution D1.2",
    "Commande " + cmd.idCommande,
    "Quantite=" + cmd.qte + " ; Strategie=" + cmd.typeCommande,
    "CLIENT GENERIQUE",
    "ZENER SA Togo",
    "Reception commande -> analyse interne",
    "D1.2 / D2.2",
    "Accepter la commande pour analyse stock/production.",
    "Commande envoyee",
    "Commande validee",
    "Temps de reception commande ; temps de validation ; debut traitement Deliver"
);

enregistrerTraceExecutionCommande(
    cmd,
    "sD1.1.1",
    "D1.1",
    "RECEPTION_VALIDATION_COMMANDE",
    Math.max(0.5, time() - cmd.tCreation),
    0.0,
    cmd.qte,
    "Reception et validation de la commande client avant analyse du stock"
);

afficherPopupMetier(
    "Commande recue",
    cmd.idCommande + " validee par ZENER SA Togo",
    "La commande est maintenant transmise au systeme de pilotage pour verification du stock fini.",
    "DETAILLE"
);

ScenarioFlux sc = scenarioPourCommande(cmd);
if (sc != null && (cmd.idScenario == null || cmd.idScenario.trim().isEmpty())) cmd.idScenario = sc.typeProduit;

planifierActionCommande("ANALYSE_STOCK", cmd, delaiAleatoireCourt(delaiDecisionStockMinSec, delaiDecisionStockMaxSec));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000008301</Id>
					<Name><![CDATA[lancerProductionCommande]]></Name>
					<X>10</X><Y>-540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[cmd]]></Name>
						<Type><![CDATA[CommandeAgent]]></Type>
					</Parameter>
					<Body><![CDATA[lancerProductionCommandeOrchestree(cmd);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783878397124</Id>
					<Name><![CDATA[ConnectAgents]]></Name>
					<X>-550</X><Y>6550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ============================================================
// Connexions directes entre agents (remplace les lignes statiques
// emmelees). Reconstruit a partir des 47 polylignes d'origine de la
// vue "Structure animee".
// ============================================================

// --- SUPPLIER (interne) ---
AS_sP1.connectTo(AT_sP4);
ASup_sD1.connectTo(AT_sP4);
ASup_sS1.connectTo(ASup_sD1);
AO_sS1_4_3.connectTo(ASup_sS1);
AO_sS1_4_3.connectTo(AO_sD1_8);
AO_sD1_8.connectTo(ASup_sD1);
AO_sD1_8.connectTo(AO_sD1_12);
AO_sD1_12.connectTo(ASup_sD1);

// --- PONT Supplier -> Manufacturer ---
AO_sD1_12.connectTo(AO_sS1_2);
ASup_sD1.connectTo(ASup_sS1_2);

// --- MANUFACTURER : tactiques -> hub strategique ---
AT_sP2.connectTo(AS_sP1);
AT_sP3.connectTo(AS_sP1);
AT_sP4_2.connectTo(AS_sP1);
AS_sP1.connectTo(AT_sP5);

// --- MANUFACTURER : chaine horizontale des coordinateurs ---
ASup_sS1_2.connectTo(ASup_sM1);
ASup_sM1.connectTo(ASup_sD1_3);
ASup_sD1_3.connectTo(ASup_sR);

// --- MANUFACTURER : coordinateurs -> leur tactique ---
ASup_sM1.connectTo(AT_sP3);
ASup_sD1_3.connectTo(AT_sP4_2);
ASup_sR.connectTo(AT_sP5);

// --- MANUFACTURER : Source ---
AO_sS1_2.connectTo(AO_sS1_1);
AO_sS1_1.connectTo(AO_sS1_3);
AO_sS1_4.connectTo(AO_sDR);

// --- MANUFACTURER : Make ---
AO_sM1_1.connectTo(ASup_sM1);
AO_sM1_1_2.connectTo(AO_sM1_1);
AO_sM1_3.connectTo(AO_sM1_1);
AO_sM1_3.connectTo(AO_sM1_7);
AO_sM1_4.connectTo(AO_sM1_1);
AO_sM1_4.connectTo(AO_sM1_3);
AO_sM1_1.connectTo(AO_sM1_5);
AO_sM1_1.connectTo(AO_sM1_6);
AO_sM1_5.connectTo(AO_sM1_6);

// --- MANUFACTURER : Make -> Deliver ---
AO_sM1_6.connectTo(AO_sD1_8_3);

// --- MANUFACTURER : Deliver / Return ---
ASup_sD1_3.connectTo(AO_sD1_2);
AO_sD1_8_3.connectTo(AO_sD1_2);
AO_sD1_8_3.connectTo(AO_sD1_12_2);
AO_sD1_2.connectTo(AO_sD1_12_2);
AO_sDR.connectTo(ASup_sR);

// --- PONT Manufacturer -> Customer ---
ASup_sD1_3.connectTo(ASup_sS1_3);
AS_sP1.connectTo(AT_sP2_2);
AO_sD1_12_2.connectTo(AO_sS1_4_4);

// --- CUSTOMER ---
ASup_sS1_3.connectTo(ASup_sD1_2);
AO_sSR.connectTo(AO_sS1_4_4);
AO_sSR.connectTo(ASup_sR);
AO_sDR.connectTo(AO_sSR);
AO_sD1_12_3.connectTo(AO_sD1_8_2);
AO_sD1_8_2.connectTo(AO_sD1_12_3);

// ============================================================
// FLUX PHYSIQUE DE LA MATIERE (traits épais) — connexions manquantes
// identifiées visuellement sur la vue de référence : entrepôt Matière
// Première -> chaîne de production -> entrepôt Produits Finis ->
// livraison vers le Customer.
// ============================================================
AO_sS1_4.connectTo(AO_sM1_1_2);
AO_sM1_1_2.connectTo(AO_sM1_3);
AO_sM1_3.connectTo(AO_sM1_4);
AO_sM1_4.connectTo(AO_sM1_5);
AO_sM1_6.connectTo(AO_sS1_4_4);

// ============================================================
// CONNEXIONS MANQUANTES identifiées visuellement (traits rouges) :
// flux physique interne au Supplier et au Customer.
// ============================================================
AO_sS1_4_3.connectTo(AO_sD1_12);    // Supplier : entrepôt -> camion de livraison
AT_sP2_2.connectTo(ASup_sS1_3);     // Customer : tactique -> coordinateur source
ASup_sS1_3.connectTo(AO_sS1_4_4);   // Customer : coordinateur -> entrepôt réception
AO_sS1_4_4.connectTo(AO_sD1_8_2);   // Customer : entrepôt -> réception produit livré
AO_sD1_8_2.connectTo(AO_sSR);       // Customer : réception -> retour (Source Return)]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782000000903</Id>
					<Name><![CDATA[verifierFillRate]]></Name>
					<X>360</X><Y>-90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int total = commandes.size();
if (total == 0) return 1.0;
int servies = 0;
for (CommandeAgent cmd : commandes) {
    // Correction : ne pas re-comparer time() ici. Le statut SERVIE/EN_RETARD
    // est fixe definitivement au moment de la livraison (voir finDeParcours()).
    // Reutiliser time() <= cmd.tPromise ici ferait basculer retroactivement en
    // "hors delai" une commande livree a temps, simplement parce que l'horloge
    // de simulation a continue d'avancer depuis sa livraison.
    if ("SERVIE".equals(cmd.statut)) servies++;
}
return (double) servies / total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000301</Id>
					<Name><![CDATA[tauxCommandesConformes]]></Name>
					<X>20</X><Y>-470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Proxy pour RL.3.31 (Compliance / Documentation Accuracy) : faute de donnees
// documentaires reelles dans ce modele, on mesure la part des commandes dont
// le cycle complet s'est termine sans incident de statut (ni EN_ATTENTE bloque,
// ni EN_RETARD). Ne couvre QUE les commandes deja closes (SERVIE ou EN_RETARD) :
// les commandes encore EN_COURS ou EN_ATTENTE sont exclues du denominateur,
// car leur issue n'est pas encore connue.
int closes = 0, conformes = 0;
for (CommandeAgent cmd : commandes) {
    if ("SERVIE".equals(cmd.statut) || "EN_RETARD".equals(cmd.statut)) {
        closes++;
        if ("SERVIE".equals(cmd.statut)) conformes++;
    }
}
if (closes == 0) return 1.0; // aucune commande close : score neutre, pas de penalite arbitraire
return (double) conformes / closes;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1790000000302</Id>
					<Name><![CDATA[calculerCoutsCumules]]></Name>
					<X>20</X><Y>-440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Cout main d'oeuvre = taux horaire declare x temps de cycle cumule reellement observe sur ce poste
// (sumCycleTime, deja mesure par le Blackboard -- pas une estimation supplementaire).
// Cout matiere = cout/unite declare x nombre d'unites reellement passees par ce poste.
// Si l'utilisateur n'a renseigne aucun cout (valeurs par defaut 0), le resultat est 0 -- jamais invente.
double coutMainOeuvre = 0;
double coutMatiere = 0;

for (PosteGenericAgent p : postes) {
    KPIBundle k = board.kpiParMicroActivite.get(p.idPoste);
    if (k == null) continue;

    double heuresCumulees = k.sumCycleTime / 3600.0;
    coutMainOeuvre += p.coutHoraireMainOeuvre * heuresCumulees;
    coutMatiere    += p.coutMatierePremiereParUnite * k.count;
}

double total = coutMainOeuvre + coutMatiere;
return new double[] { coutMainOeuvre, coutMatiere, total };]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000303</Id>
					<Name><![CDATA[calculerValeurActifsFixes]]></Name>
					<X>20</X><Y>-410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Somme simple des valeurs d'actif fixe declarees poste par poste.
// Reste a 0 si l'utilisateur n'a renseigne aucune valeur (comportement par defaut).
double total = 0;
for (PosteGenericAgent p : postes) total += p.valeurActifFixe;
return total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000304</Id>
					<Name><![CDATA[calculerDisponibiliteMachinesMoyenne]]></Name>
					<X>20</X><Y>-380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Moyenne de la disponibilite theorique (MTBF / (MTBF+MTTR)) de toutes les
// machines logiques actives. disponibiliteTheorique() est deja une formule
// existante sur MachineSim -- on ne fait qu'agreger ce qui est deja calcule.
if (machinesSim == null || machinesSim.isEmpty()) return 1.0; // aucune machine declaree : pas de penalite
double somme = 0; int n = 0;
for (MachineSim m : machinesSim) {
    if (!m.active) continue;
    somme += m.disponibiliteTheorique();
    n++;
}
if (n == 0) return 1.0;
return somme / n;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000305</Id>
					<Name><![CDATA[calculerInventoryDaysOfSupply]]></Name>
					<X>20</X><Y>-350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Jours de stock = niveau de stock physique reel (niveauStock, deja maintenu
// par les postes STOCKAGE a chaque passage) divise par le debit de sortie
// journalier observe. Si aucun poste STOCKAGE n'existe ou si le debit est nul,
// retourne 0 plutot qu'une valeur fictive.
double stockTotal = 0;
boolean aDesStocks = false;
for (PosteGenericAgent p : postes) {
    if (p.typePoste == TypePoste.STOCKAGE) {
        stockTotal += p.niveauStock;
        aDesStocks = true;
    }
}
if (!aDesStocks) return 0;

double terminees = nbTermines;
try {
    if (board != null && board.totalTerminees > terminees) terminees = board.totalTerminees;
    if (board != null && board.kpiGlobal != null && board.kpiGlobal.count > terminees) terminees = board.kpiGlobal.count;
} catch (Throwable ignored) {}

double debitJournalier = (time() > 0) ? (terminees * 86400.0 / time()) : 0;
if (debitJournalier <= 0) return 0;

return stockTotal / debitJournalier;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1790000000510</Id>
					<Name><![CDATA[appliquerPoidsAttributsSCOR]]></Name>
					<X>20</X><Y>-320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Validation stricte : la somme des 5 poids doit valoir 1.0 (tolerance flottante 0.001).
// En cas d'echec, on REFUSE d'appliquer et on previent l'utilisateur -- on ne normalise
// jamais silencieusement, car cela appliquerait une ponderation differente de celle saisie
// sans que l'utilisateur s'en rende compte.
double somme = champPoidsRL + champPoidsRS + champPoidsAG + champPoidsCO + champPoidsAM;

if (champPoidsRL < 0 || champPoidsRS < 0 || champPoidsAG < 0 || champPoidsCO < 0 || champPoidsAM < 0) {
    messageStatut = "ERREUR : les poids des attributs SCOR doivent etre positifs ou nuls.";
    getExperimentHost().showMessageDialog(
        "⚠️ Poids invalide\n\nAucun poids ne peut etre negatif.\nValeurs saisies : RL=" + champPoidsRL
        + " RS=" + champPoidsRS + " AG=" + champPoidsAG + " CO=" + champPoidsCO + " AM=" + champPoidsAM
    );
    return false;
}

if (Math.abs(somme - 1.0) > 0.001) {
    messageStatut = "ERREUR : la somme des poids vaut " + String.format("%.3f", somme) + " au lieu de 1.000.";
    getExperimentHost().showMessageDialog(
        "⚠️ Somme des poids invalide\n\n"
        + "RL=" + String.format("%.3f", champPoidsRL)
        + "  RS=" + String.format("%.3f", champPoidsRS)
        + "  AG=" + String.format("%.3f", champPoidsAG)
        + "  CO=" + String.format("%.3f", champPoidsCO)
        + "  AM=" + String.format("%.3f", champPoidsAM)
        + "\n\nSomme actuelle : " + String.format("%.3f", somme) + "\n"
        + "La somme doit valoir exactement 1.000 (tolerance 0.001).\n\n"
        + "Aucune normalisation automatique n'est appliquee : ajustez vos valeurs."
    );
    return false;
}

strategic.w_RL = champPoidsRL;
strategic.w_RS = champPoidsRS;
strategic.w_AG = champPoidsAG;
strategic.w_CO = champPoidsCO;
strategic.w_AM = champPoidsAM;

board.logEvent(String.format(
    "[CONFIG] Poids des attributs SCOR mis a jour : RL=%.3f RS=%.3f AG=%.3f CO=%.3f AM=%.3f",
    champPoidsRL, champPoidsRS, champPoidsAG, champPoidsCO, champPoidsAM));

messageStatut = "Poids des attributs SCOR appliques (somme=1.000).";
getExperimentHost().showMessageDialog(
    "✅ Poids appliques\n\n"
    + "RL (Reliability)     : " + String.format("%.0f", champPoidsRL * 100) + "%\n"
    + "RS (Responsiveness)  : " + String.format("%.0f", champPoidsRS * 100) + "%\n"
    + "AG (Agility)         : " + String.format("%.0f", champPoidsAG * 100) + "%\n"
    + "CO (Cost)            : " + String.format("%.0f", champPoidsCO * 100) + "%\n"
    + "AM (Asset Mgmt)      : " + String.format("%.0f", champPoidsAM * 100) + "%"
);
return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1790000000630</Id>
					<Name><![CDATA[listeMetriquesN3Disponibles]]></Name>
					<X>20</X><Y>-290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Force un calcul si detailN3 n'a jamais ete rempli (avant le premier
// appel reel a calculerPIGlobal(), par exemple avant le demarrage de la
// simulation). Cette fonction est uniquement de lecture : elle ne modifie
// aucun etat de simulation, seulement le contenu informatif de detailN3.
if (strategic.detailN3.isEmpty()) {
    strategic.calculerPIGlobal();
}

java.util.ArrayList<String> noms = new java.util.ArrayList<String>();
String[] attrs = {"RL", "RS", "AG", "CO", "AM"};
for (String attr : attrs) {
    java.util.ArrayList<MetriqueN3> lst = strategic.detailN3.get(attr);
    if (lst == null) continue;
    for (MetriqueN3 m : lst) {
        if (m.poids > 0) { // seules les metriques scorees (poids > 0) sont pilotables
            noms.add(attr + " | " + m.nom);
        }
    }
}

if (noms.isEmpty()) {
    return new String[] { "(aucune metrique disponible - demarrez la simulation au moins une fois)" };
}
return noms.toArray(new String[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000631</Id>
					<Name><![CDATA[definirPoidsMetriqueN3UI]]></Name>
					<X>20</X><Y>-260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (champMetriqueN3Selectionnee == null || champMetriqueN3Selectionnee.trim().isEmpty()
    || champMetriqueN3Selectionnee.startsWith("(aucune")) {
    messageStatut = "ERREUR : selectionnez une metrique N3 dans la liste.";
    return;
}

if (champPoidsMetriqueN3 < 0) {
    messageStatut = "ERREUR : le poids d'une metrique N3 ne peut pas etre negatif.";
    getExperimentHost().showMessageDialog("⚠️ Poids invalide\n\nLe poids saisi est negatif.");
    return;
}

// champMetriqueN3Selectionnee est au format "ATTR | Nom exact de la metrique"
String[] parts = champMetriqueN3Selectionnee.split(" \\| ", 2);
if (parts.length < 2) {
    messageStatut = "ERREUR : selection de metrique invalide.";
    return;
}
String attr = parts[0].trim();
String nomMetrique = parts[1].trim();

strategic.poidsN3Personnalises.put(nomMetrique, champPoidsMetriqueN3);

// Recalcule immediatement pour que l'effet soit visible, et pour mettre a jour
// la somme des poids affichee a l'utilisateur pour cet attribut.
strategic.calculerPIGlobal();

double sommeAttr = 0;
java.util.ArrayList<MetriqueN3> lst = strategic.detailN3.get(attr);
if (lst != null) {
    for (MetriqueN3 m : lst) sommeAttr += m.poids;
}

board.logEvent(String.format(
    "[CONFIG] Poids N3 personnalise : [%s] %s -> %.3f (somme %s = %.3f)",
    attr, nomMetrique, champPoidsMetriqueN3, attr, sommeAttr));

messageStatut = String.format(
    "Poids applique : [%s] %s = %.3f (somme des poids de %s = %.3f)",
    attr, nomMetrique, champPoidsMetriqueN3, attr, sommeAttr);

String avertissement = "";
if (Math.abs(sommeAttr - 1.0) > 0.01) {
    avertissement = "\n\n⚠️ Note : la somme des poids de l'attribut " + attr
        + " vaut maintenant " + String.format("%.3f", sommeAttr)
        + " (au lieu de 1.000). Le calcul reste mathematiquement valide\n"
        + "(moyenne ponderee normalisee), mais les poids relatifs entre\n"
        + "metriques de cet attribut ne sont plus equilibres autour de 1/N.";
}

getExperimentHost().showMessageDialog(
    "✅ Poids de metrique N3 applique\n\n"
    + "Attribut          : " + attr + "\n"
    + "Metrique          : " + nomMetrique + "\n"
    + "Nouveau poids     : " + String.format("%.3f", champPoidsMetriqueN3) + "\n"
    + "Somme attribut " + attr + " : " + String.format("%.3f", sommeAttr)
    + avertissement
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000632</Id>
					<Name><![CDATA[reinitialiserPoidsN3UI]]></Name>
					<X>20</X><Y>-230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[strategic.poidsN3Personnalises.clear();
strategic.calculerPIGlobal();
board.logEvent("[CONFIG] Poids N3 personnalises reinitialises (retour a 1/N par defaut).");
messageStatut = "Tous les poids N3 ont ete reinitialises a 1/N (egalitaire par attribut).";
getExperimentHost().showMessageDialog("✅ Reinitialisation effectuee\n\nTous les poids de metriques N3 sont revenus a leur valeur par defaut (1/N par attribut).");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1790000000633</Id>
					<Name><![CDATA[rapportPoidsN3Text]]></Name>
					<X>20</X><Y>-200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (strategic.detailN3.isEmpty()) {
    strategic.calculerPIGlobal();
}

StringBuilder sb = new StringBuilder();
sb.append("═══ PONDERATION DETAILLEE DES METRIQUES N3 (par attribut) ═══\n\n");

String[] attrs = {"RL", "RS", "AG", "CO", "AM"};
for (String attr : attrs) {
    java.util.ArrayList<MetriqueN3> lst = strategic.detailN3.get(attr);
    sb.append("── ").append(attr).append(" ──\n");
    if (lst == null || lst.isEmpty()) {
        sb.append("  (aucune metrique)\n\n");
        continue;
    }
    double somme = 0;
    for (MetriqueN3 m : lst) {
        boolean personnalise = strategic.poidsN3Personnalises.containsKey(m.nom);
        sb.append(String.format("  %-55s poids=%.3f%s%s\n",
            m.nom, m.poids,
            m.poids == 0 ? " (informatif, hors score)" : "",
            personnalise ? " [PERSONNALISE]" : ""));
        somme += m.poids;
    }
    sb.append(String.format("  -> Somme des poids scores de cet attribut : %.3f%s\n\n",
        somme, Math.abs(somme - 1.0) > 0.01 && somme > 0 ? "  ⚠️ different de 1.000" : ""));
}

return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000010</Id>
					<Name><![CDATA[rebuter]]></Name>
					<X>-300</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idPosteRebut]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCORPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Ejection definitive d'une entite (rebut)
board.notifierRebut(idPosteRebut, codeSCORPoste);
ajouterSuivi("Controle qualite", "Produit rejete", "Flux=" + e.idFlux + " | Poste=" + idPosteRebut, idPosteRebut, "Rebut / sortie", codeSCORPoste);

addTrace(
    "BRUT",
    "Poste/Aiguillage",
    e.idFlux,
    "",
    codeSCORPoste,
    "REBUT",
    "REBUT",
    1,
    "unité",
    "",
    Double.NaN,
    "",
    "Entité éjectée définitivement"
);
masquerEntite(e);
remove_fluxEntites(e);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000011</Id>
					<Name><![CDATA[rerouterRework]]></Name>
					<X>-300</X><Y>840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idCible]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idPosteCourant]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Reprise (rework) : renvoi vers le poste cible, ou repasse le poste courant
board.notifierRework(idPosteCourant);
PosteGenericAgent cible = null;
if (idCible != null && !idCible.isEmpty()) cible = trouverPosteParNomOuId(idCible);
if (cible == null) cible = trouverPosteParNomOuId(idPosteCourant);
if (cible == null) { routerEntite(e); return; }
deplacerEntiteVersPoste(e, cible);
cible.enter.take(e);

//AJOUT 19-06
PosteGenericAgent p = trouverPoste(idPosteCourant);
String code = p != null ? p.codeSCOR : "";

addTrace(
    "BRUT",
    "Poste/Aiguillage:" + idPosteCourant,
    e.idFlux,
    idPosteCourant,
    code,
    "REWORK",
    "REWORK",
    1,
    "unité",
    "",
    Double.NaN,
    "",
    "Reprise vers " + (idCible == null || idCible.isEmpty() ? idPosteCourant : idCible)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1789100001001</Id>
					<Name><![CDATA[routerVersCibleEchec]]></Name>
					<X>-300</X><Y>870</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idCible]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idPosteCourant]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Ejection "fuite" avec transit reel vers le poste cible (ex. SINK de rejet securite),
// au lieu d'une destruction immediate sur place. Le poste cible comptabilise le passage,
// puis se charge lui-meme de detruire l'entite comme un rebut (voir exit.onExit generique).
PosteGenericAgent cible = trouverPosteParNomOuId(idCible);
if (cible == null) {
    // Cible introuvable : repli sur l'ancien comportement (destruction immediate)
    PosteGenericAgent origineFallback = trouverPosteParNomOuId(idPosteCourant);
    rebuter(e, idPosteCourant, origineFallback != null ? cleKPI(origineFallback) : "");
    return;
}
PosteGenericAgent origine = trouverPosteParNomOuId(idPosteCourant);
e.destineeAuRebut = true;
e.codeSCOROrigineRebut = origine != null ? cleKPI(origine) : "";

addTrace(
    "BRUT",
    "Poste/Aiguillage:" + idPosteCourant,
    e.idFlux,
    idPosteCourant,
    e.codeSCOROrigineRebut,
    "EJECTION",
    "EJECTION",
    1,
    "unité",
    "",
    Double.NaN,
    "",
    "Ejection vers " + idCible + " (rejet securite)"
);

deplacerEntiteVersPoste(e, cible);
cible.enter.take(e);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000012</Id>
					<Name><![CDATA[ajouterScenario]]></Name>
					<X>-300</X><Y>550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[typeProduit]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[sequenceCsv]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[debit]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Ajoute un scenario de flux (sequenceCsv = "P1,P2,P4")
ScenarioFlux sc = new ScenarioFlux(typeProduit, debit);
sc.debitParHeureBase = debit;
for (String id : sequenceCsv.split(",")) {
    String t = id.trim();
    if (!t.isEmpty()) sc.sequence.add(t);
}
scenarios.add(sc);
rafraichirComboScenarios();
recalculerTousLesGroupesOperationnels();
board.logEvent("Scenario '" + typeProduit + "' ajoute (" + sc.sequence.size() + " etapes, " + debit + "/h)");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000013</Id>
					<Name><![CDATA[ajouterScenarioUI]]></Name>
					<X>-300</X><Y>600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Validation nom
if (champScenarioNom == null || champScenarioNom.trim().isEmpty()) {
    messageStatut = "ERREUR : nom de scénario obligatoire.";
    getExperimentHost().showMessageDialog(
        "⚠️ Nom de scénario manquant\n\nVeuillez saisir un nom de produit/scénario\navant de valider.");
    return;
}
// Validation séquence
if (champScenarioSeq == null || champScenarioSeq.trim().isEmpty()) {
    messageStatut = "ERREUR : séquence obligatoire.";
    getExperimentHost().showMessageDialog(
        "⚠️ Séquence manquante\n\nSaisissez la séquence de micro-activités séparées par des virgules.\nExemple : sM1.3.1, sM1.4.1, sD1.5.1");
    return;
}
// Validation débit
double d;
try { d = Double.parseDouble(champScenarioDebit.trim()); }
catch (Exception ex) {
    messageStatut = "ERREUR : débit invalide.";
    getExperimentHost().showMessageDialog(
        "⚠️ Débit invalide\n\nLe débit doit être un nombre décimal positif.\nExemple : 60.0 (produits/heure)");
    return;
}
if (d <= 0) {
    messageStatut = "ERREUR : débit doit être > 0.";
    getExperimentHost().showMessageDialog("⚠️ Débit invalide\n\nLe débit doit être strictement positif (> 0).");
    return;
}
// Ajout
ajouterScenario(champScenarioNom.trim(), champScenarioSeq, d);
messageStatut = "Scénario '" + champScenarioNom.trim() + "' ajouté. Total : " + scenarios.size();
getExperimentHost().showMessageDialog(
    "✅ Scénario de flux ajouté\n\n" +
    "Nom/Produit  : " + champScenarioNom.trim() + "\n" +
    "Séquence     : " + champScenarioSeq.trim() + "\n" +
    "Débit        : " + String.format("%.1f", d) + " produits/h\n\n" +
    "Total scénarios configurés : " + scenarios.size() + "\n\n" +
    "💡 Vérifiez que les IDs de micro-activités correspondent\naux postes déjà configurés.");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781500000014</Id>
					<Name><![CDATA[debitTotal]]></Name>
					<X>-300</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Debit total d'entree (somme des scenarios, sinon champDebit global)
if (scenarios.isEmpty()) return champDebit;
double t = 0;
for (ScenarioFlux sc : scenarios) t += sc.debitParHeure;
return t > 0 ? t : champDebit;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000015</Id>
					<Name><![CDATA[sauverConfig]]></Name>
					<X>-300</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
        java.io.PrintWriter pw = new java.io.PrintWriter(
            new java.io.FileWriter("config_" + nomEntreprise + ".csv")
        );

        // 1. Acteurs d'abord
        pw.println("# ACTEUR;idActeur;nom;categorie;typeAnnexe;description;actif;microActivites;delaiPaiementJours");

        for (ActeurSC a : acteursSC) {
            pw.println(
                "ACTEUR;"
                + a.idActeur + ";"
                + a.nom + ";"
                + a.categorie + ";"
                + a.typeAnnexe + ";"
                + a.description + ";"
                + a.actif + ";"
                + a.microActivitesText() + ";"
                + a.delaiPaiementJours + ";"
                + a.modeApproMRP
            );
        }

        // 2. Micro-activités ensuite
        pw.println("# POSTE;id;nom;codeSCOR;type;dist;p1;p2;capacite;idActeurResponsable;nomActeurResponsable;categorieActeurResponsable;typeAnnexeActeurResponsable;ctrlType;tauxTrue;cibleEchec;tauxVA;coutHoraireMainOeuvre;coutMatierePremiereParUnite;valeurActifFixe");

        for (PosteGenericAgent p : postes) {
            String ra = (p.regleAiguillage != null)
                ? p.regleAiguillage.typeControle
                    + ";"
                    + p.regleAiguillage.tauxTrue
                    + ";"
                    + (p.regleAiguillage.idCibleEchec == null ? "" : p.regleAiguillage.idCibleEchec)
                : ";;";

            pw.println(
                "POSTE;"
                + p.idPoste + ";"
                + p.nom + ";"
                + p.codeSCOR + ";"
                + p.typePoste + ";"
                + p.loiTemps.distribution + ";"
                + p.loiTemps.p1 + ";"
                + p.loiTemps.p2 + ";"
                + p.capaciteSimultanee + ";"
                + p.idActeurResponsable + ";"
                + p.nomActeurResponsable + ";"
                + p.categorieActeurResponsable + ";"
                + p.typeAnnexeActeurResponsable + ";"
                + ra + ";"
				+ p.tauxVA + ";"
				+ p.coutHoraireMainOeuvre + ";"
				+ p.coutMatierePremiereParUnite + ";"
				+ p.valeurActifFixe + ";"
				+ p.consommeMatiere
            );
        }

        // 3. Responsabilités hiérarchiques
        pw.println("# RESPONSABILITE;idResponsabilite;idMicroActivite;idActeur;niveau;typeAgent;isTactic;quantite;idsAgents;idsMachines");

        for (MicroResponsabilite r : responsabilitesMicro) {
            pw.println(
                "RESPONSABILITE;"
                + r.idResponsabilite + ";"
                + r.idMicroActivite + ";"
                + r.idActeur + ";"
                + r.niveauHierarchique + ";"
                + r.typeAgent + ";"
                + r.isTactic + ";"
                + r.quantite + ";"
                + r.idsAgentsText() + ";"
                + r.idsMachinesText()
            );
        }

        // 4. Machines logiques
        pw.println("# MACHINE;idMachine;nom;idMicroActivite;idOperationalAgent;type;capacite;cycleTime;mtbf;mttr;active");

        for (MachineSim m : machinesSim) {
            pw.println(
                "MACHINE;"
                + m.idMachine + ";"
                + m.nom + ";"
                + m.idMicroActivite + ";"
                + m.idOperationalAgent + ";"
                + m.type + ";"
                + m.capacite + ";"
                + m.cycleTime + ";"
                + m.mtbf + ";"
                + m.mttr + ";"
                + m.active
            );
        }

        // 5. Scénarios
        for (ScenarioFlux sc : scenarios) {
            pw.println(
                "SCENARIO;"
                + sc.typeProduit + ";"
                + String.join(",", sc.sequence) + ";"
                + sc.debitParHeure
            );
        }

        // 6. Fiches matière (MRP)
        pw.println("# MATIERE;idMatiere;stockDisponible;stockSecurite;delaiObtentionHeures;idFournisseur");
        for (FicheMatiere f : fichesMatiere) {
            pw.println(
                "MATIERE;"
                + f.idMatiere + ";"
                + f.stockDisponible + ";"
                + f.stockSecurite + ";"
                + f.delaiObtentionHeures + ";"
                + f.idFournisseur
            );
        }

        // 7. Nomenclatures (MRP)
        pw.println("# NOMENCLATURE;typeProduit;idMatiere;quantiteParUnite");
        for (ScenarioFlux sc : scenarios) {
            for (LigneNomenclature l : sc.nomenclature) {
                pw.println(
                    "NOMENCLATURE;"
                    + sc.typeProduit + ";"
                    + l.idMatiere + ";"
                    + l.quantiteParUnite
                );
            }
        }

        pw.close();

        messageStatut = "Config sauvée : config_" + nomEntreprise + ".csv";

        getExperimentHost().showMessageDialog(
            "✅ Configuration sauvegardée\n\n"
            + "Fichier : config_" + nomEntreprise + ".csv\n"
            + "Acteurs : " + acteursSC.size() + "\n"
            + "Micro-activités : " + postes.size() + "\n"
            + "Responsabilités : " + responsabilitesMicro.size() + "\n"
            + "Machines : " + machinesSim.size() + "\n"
            + "Scénarios : " + scenarios.size()
        );

    } catch (Exception ex) {
        messageStatut = "Erreur sauvegarde : " + ex.getMessage();

        getExperimentHost().showMessageDialog(
            "❌ Erreur de sauvegarde\n\n" + ex.getMessage()
        );
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000016</Id>
					<Name><![CDATA[chargerConfig]]></Name>
					<X>-300</X><Y>750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Recharge la configuration depuis le fichier CSV de l'entreprise
try {
    java.io.BufferedReader br = new java.io.BufferedReader(
        new java.io.FileReader("config_" + nomEntreprise + ".csv")
    );

	while (opAgents.size() > 0) remove_opAgents(opAgents.get(opAgents.size() - 1));
    // Nettoyage des structures existantes
    while (postes.size() > 0) remove_postes(postes.get(postes.size() - 1));
    scenarios.clear();
	acteursSC.clear();
	responsabilitesMicro.clear();
	machinesSim.clear();
	fichesMatiere.clear();
    String ligne;
    while ((ligne = br.readLine()) != null) {
        ligne = ligne.trim();
        if (ligne.isEmpty() || ligne.startsWith("#")) continue;

        String[] c = ligne.split(";", -1);
        if (c[0].equals("ACTEUR") && c.length >= 7) {
    ActeurSC a = new ActeurSC();

    a.idActeur = c[1];
    a.nom = c[2];
    a.categorie = c[3];
    a.typeAnnexe = c[4];
    a.description = c[5];
    a.actif = Boolean.parseBoolean(c[6]);
    a.idsMicroActivites = new java.util.ArrayList<String>();

    // delaiPaiementJours : colonne ajoutee ulterieurement, absente des anciens fichiers CSV.
    // Fallback a 30.0 (valeur par defaut neutre de la classe ActeurSC).
    if (c.length >= 9 && !c[8].trim().isEmpty()) {
        try { a.delaiPaiementJours = Math.max(0.0, Double.parseDouble(c[8].trim())); }
        catch (Exception ex) { a.delaiPaiementJours = 30.0; }
    } else {
        a.delaiPaiementJours = 30.0;
    }

    // modeApproMRP : colonne ajoutee ulterieurement (MRP), absente des anciens
    // fichiers CSV. Fallback a false (comportement autonome inchange par defaut).
    if (c.length >= 10 && !c[9].trim().isEmpty()) {
        a.modeApproMRP = Boolean.parseBoolean(c[9].trim());
    } else {
        a.modeApproMRP = false;
    }

    if (c.length >= 8 && c[7] != null && !c[7].equals("-") && !c[7].trim().isEmpty()) {
        String[] ids = c[7].split(",");

        for (String id : ids) {
            if (!id.trim().isEmpty()) {
                a.idsMicroActivites.add(id.trim());
            }
        }
    }

    acteursSC.add(a);
    continue;
}
        if (c[0].equals("POSTE") && c.length >= 9) {
            PosteGenericAgent p = add_postes();
            p.idPoste = c[1];
            p.nom = c[2];
            p.codeSCOR = c[3];
            p.typePoste = TypePoste.valueOf(c[4]);
            p.loiTemps = new LoiTemps(c[5], Double.parseDouble(c[6]), Double.parseDouble(c[7]));
            p.capaciteSimultanee = (int) Double.parseDouble(c[8]);
			if (c.length >= 13) {
    p.idActeurResponsable = c[9];
    p.nomActeurResponsable = c[10];
    p.categorieActeurResponsable = c[11];
    p.typeAnnexeActeurResponsable = c[12];

    ActeurSC a = trouverActeurParId(p.idActeurResponsable);
    if (a != null) {
        a.ajouterMicroActivite(p.idPoste);
    }
}
           if (c.length >= 15 && !c[13].isEmpty()) {
    String cible = (c.length >= 16 && !c[15].isEmpty()) ? c[15] : null;

    p.regleAiguillage = new RegleAiguillage(
        c[13],
        Double.parseDouble(c[14]),
        cible
    );
}

			// tauxVA : colonne ajoutee ulterieurement, absente des anciens fichiers CSV.
			// Fallback a 1.0 (comportement historique : tout le CT est compte comme valeur ajoutee).
			if (c.length >= 17 && !c[16].trim().isEmpty()) {
			    try { p.tauxVA = Math.max(0.0, Math.min(1.0, Double.parseDouble(c[16].trim()))); }
			    catch (Exception ex) { p.tauxVA = 1.0; }
			} else {
			    p.tauxVA = 1.0;
			}

			// coutHoraireMainOeuvre / coutMatierePremiereParUnite / valeurActifFixe :
			// colonnes ajoutees ulterieurement, absentes des anciens fichiers CSV.
			// Fallback a 0.0 (aucune donnee financiere = aucun cout calcule, jamais invente).
			if (c.length >= 18 && !c[17].trim().isEmpty()) {
			    try { p.coutHoraireMainOeuvre = Math.max(0.0, Double.parseDouble(c[17].trim())); }
			    catch (Exception ex) { p.coutHoraireMainOeuvre = 0.0; }
			} else {
			    p.coutHoraireMainOeuvre = 0.0;
			}

			if (c.length >= 19 && !c[18].trim().isEmpty()) {
			    try { p.coutMatierePremiereParUnite = Math.max(0.0, Double.parseDouble(c[18].trim())); }
			    catch (Exception ex) { p.coutMatierePremiereParUnite = 0.0; }
			} else {
			    p.coutMatierePremiereParUnite = 0.0;
			}

			if (c.length >= 20 && !c[19].trim().isEmpty()) {
			    try { p.valeurActifFixe = Math.max(0.0, Double.parseDouble(c[19].trim())); }
			    catch (Exception ex) { p.valeurActifFixe = 0.0; }
			} else {
			    p.valeurActifFixe = 0.0;
			}

			// consommeMatiere : colonne ajoutee ulterieurement (MRP), absente des
			// anciens fichiers CSV. Fallback a false (aucun impact si non renseigne).
			if (c.length >= 21 && !c[20].trim().isEmpty()) {
			    p.consommeMatiere = Boolean.parseBoolean(c[20].trim());
			} else {
			    p.consommeMatiere = false;
			}

            positionnerPoste(p);

            // ── Création du OperationalAgent jumelé (holarchie ADACOR) ──────
            OperationalAgent op = add_opAgents();
            op.initialiser(p, p.codeSCOR);
            board.logEvent("[HOLON] OperationalAgent créé pour " + p.idPoste);
            continue;
        } // <-- fermeture du if POSTE

        if (c[0].equals("RESPONSABILITE") && c.length >= 10) {
            MicroResponsabilite r = new MicroResponsabilite();

            r.idResponsabilite = c[1];
            r.idMicroActivite = c[2];
            r.idActeur = c[3];
            r.niveauHierarchique = c[4];
            r.typeAgent = c[5];
            r.isTactic = Boolean.parseBoolean(c[6]);
            r.quantite = Integer.parseInt(c[7]);

            r.idsAgentsCrees = new java.util.ArrayList<String>();
            if (c[8] != null && !c[8].equals("-") && !c[8].trim().isEmpty()) {
                for (String id : c[8].split(",")) {
                    if (!id.trim().isEmpty()) r.idsAgentsCrees.add(id.trim());
                }
            }

            r.idsMachinesAffectees = new java.util.ArrayList<String>();
            if (c[9] != null && !c[9].equals("-") && !c[9].trim().isEmpty()) {
                for (String id : c[9].split(",")) {
                    if (!id.trim().isEmpty()) r.idsMachinesAffectees.add(id.trim());
                }
            }

            PosteGenericAgent p = trouverPoste(r.idMicroActivite);
            if (p != null && !p.idsResponsabilites.contains(r.idResponsabilite)) {
                p.idsResponsabilites.add(r.idResponsabilite);
                r.nomMicroActivite = p.nom;
            }

            ActeurSC a = trouverActeurParId(r.idActeur);
            if (a != null) {
                r.nomActeur = a.nom;
                r.categorieActeur = a.categorie;
                r.typeAnnexeActeur = a.typeAnnexe;
                a.ajouterMicroActivite(r.idMicroActivite);
            }

            responsabilitesMicro.add(r);
            continue;
        }

        if (c[0].equals("MACHINE") && c.length >= 11) {
            MachineSim m = new MachineSim();

            m.idMachine = c[1];
            m.nom = c[2];
            m.idMicroActivite = c[3];
            m.idOperationalAgent = c[4];
            m.type = c[5];
            m.capacite = Integer.parseInt(c[6]);
            m.cycleTime = Double.parseDouble(c[7]);
            m.mtbf = Double.parseDouble(c[8]);
            m.mttr = Double.parseDouble(c[9]);
            m.active = Boolean.parseBoolean(c[10]);

            PosteGenericAgent p = trouverPoste(m.idMicroActivite);
            if (p != null) {
                m.nomMicroActivite = p.nom;
                if (!p.idsMachines.contains(m.idMachine)) {
                    p.idsMachines.add(m.idMachine);
                }
            }

            machinesSim.add(m);
            continue;
        }

        if (c[0].equals("SCENARIO") && c.length >= 4) {
            ScenarioFlux sc = new ScenarioFlux(c[1], Double.parseDouble(c[3]));

            if (c[2] != null && !c[2].trim().isEmpty()) {
                for (String id : c[2].split(",")) {
                    if (!id.trim().isEmpty()) {
                        sc.sequence.add(id.trim());
                    }
                }
            }

            scenarios.add(sc);
            continue;
        }

        // MATIERE;idMatiere;stockDisponible;stockSecurite;delaiObtentionHeures;idFournisseur
        if (c[0].equals("MATIERE") && c.length >= 5) {
            FicheMatiere f = new FicheMatiere();
            f.idMatiere = c[1];
            try { f.stockDisponible = Double.parseDouble(c[2]); } catch (Exception ex) { f.stockDisponible = 0; }
            try { f.stockSecurite = Double.parseDouble(c[3]); } catch (Exception ex) { f.stockSecurite = 0; }
            try { f.delaiObtentionHeures = Double.parseDouble(c[4]); } catch (Exception ex) { f.delaiObtentionHeures = 0; }
            f.idFournisseur = (c.length >= 6) ? c[5] : "";
            fichesMatiere.add(f);
            continue;
        }

        // NOMENCLATURE;typeProduit;idMatiere;quantiteParUnite
        if (c[0].equals("NOMENCLATURE") && c.length >= 4) {
            for (ScenarioFlux sc : scenarios) {
                if (sc.typeProduit.equalsIgnoreCase(c[1])) {
                    try {
                        sc.nomenclature.add(new LigneNomenclature(c[2], Double.parseDouble(c[3])));
                    } catch (Exception ex) { /* ligne ignoree si quantite invalide */ }
                    break;
                }
            }
            continue;
        }
    }

    br.close();
    refreshActeursMicroComboBox();
    refreshMicroActiviteComboBox();
    updateRespMachineFieldsVisibility();
	rafraichirComboPostes();
	rafraichirComboScenarios();
	updateRespMachineFieldsVisibility();
	updateActeurAnnexeVisibility();
    messageStatut = "Config chargée : " + postes.size() + " micro-activités, " + scenarios.size() + " scénarios.";
getExperimentHost().showMessageDialog(
    "✅ Configuration chargée avec succès\n\n" +
    "Fichier : config_" + nomEntreprise + ".csv\n" +
    "Micro-activités chargées : " + postes.size() + "\n" +
    "Responsabilités chargées : " + responsabilitesMicro.size() + "\n" +
    "Machines chargées        : " + machinesSim.size() + "\n" +
    "Scénarios chargés        : " + scenarios.size() + "\n\n" +
    "Vous pouvez maintenant démarrer la simulation.");
} catch (Exception ex) {
    messageStatut = "Erreur chargement : " + ex.getMessage();
	getExperimentHost().showMessageDialog("❌ Erreur de chargement\n\nFichier attendu : config_" + nomEntreprise + ".csv\n\n" + ex.getMessage());
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782600000001</Id>
					<Name><![CDATA[scenarioJsonFileName]]></Name>
					<X>-300</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Retourne un nom de fichier JSON propre basé sur nomEntreprise
String base = (nomEntreprise == null || nomEntreprise.trim().isEmpty()) ? "scenario" : nomEntreprise.trim();
// Remplacer espaces et caractères dangereux
base = base.replaceAll("[\\s]+", "_")
           .replaceAll("[^a-zA-Z0-9_\\-]", "")
           .replaceAll("_+", "_");
if (base.isEmpty()) base = "scenario";
return "scenario_" + base + ".json";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782600000002</Id>
					<Name><![CDATA[jsonString]]></Name>
					<X>-300</X><Y>810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[jmap]]></Name>
						<Type><![CDATA[java.util.Map]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[jkey]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[jdef]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (jmap == null || jkey == null) return jdef;
Object v = jmap.get(jkey);
if (v == null) return jdef;
return v.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782600000003</Id>
					<Name><![CDATA[jsonDouble]]></Name>
					<X>-300</X><Y>820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[jmap]]></Name>
						<Type><![CDATA[java.util.Map]]></Type>
					</Parameter>
					<Parameter>
