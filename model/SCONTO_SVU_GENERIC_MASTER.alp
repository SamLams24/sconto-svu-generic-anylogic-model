					<Id>1901000000002</Id>
					<Name><![CDATA[piCoverageColumns]]></Name>
					<X>2250</X><Y>-90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Attribut SCOR/AHP",
    "Total métriques catalogue",
    "Calculables sur le run",
    "Estimations / proxys assumés",
    "Non calculables actuellement",
    "Taux de couverture (%)",
    "Exemples de métriques calculables",
    "Principale justification des limites"
};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1901000000003</Id>
					<Name><![CDATA[piCoverageRows]]></Name>
					<X>2250</X><Y>-60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.LinkedHashMap<String, int[]> stats = new java.util.LinkedHashMap<String, int[]>();
java.util.LinkedHashMap<String, java.util.ArrayList<String>> exemples = new java.util.LinkedHashMap<String, java.util.ArrayList<String>>();
String[] attrsInit = new String[] {"RL", "RS", "AG", "CO", "AM", "AUTRE"};
for (String a : attrsInit) {
    stats.put(a, new int[] {0, 0, 0, 0}); // total, calculables, estimations, non calculables
    exemples.put(a, new java.util.ArrayList<String>());
}

String[] lignes = catalogueMetriquesAHPRaw().split("\\r?\\n");
for (String ligne : lignes) {
    if (ligne == null || ligne.trim().isEmpty()) continue;
    String[] p = ligne.split("\\|", -1);
    if (p.length < 7) continue;
    String code = p[1].trim();
    String attr = attributCourtSCOR(p[5]);
    if (!stats.containsKey(attr)) { stats.put(attr, new int[] {0,0,0,0}); exemples.put(attr, new java.util.ArrayList<String>()); }
    int[] s = stats.get(attr);
    s[0]++;
    String statut = statutMetriqueSCOR(code);
    boolean dispo = estMetriqueSCORDisponiblePourTableaux(code);
    boolean estimation = statut != null && (statut.toUpperCase(java.util.Locale.ROOT).contains("ESTIMATION") || statut.toUpperCase(java.util.Locale.ROOT).contains("APPROXIMATION") || statut.toUpperCase(java.util.Locale.ROOT).contains("PROXY"));
    if (dispo) {
        s[1]++;
        if (estimation) s[2]++;
        if (exemples.get(attr).size() < 5) exemples.get(attr).add(code + " — " + p[3]);
    } else {
        s[3]++;
    }
}

java.util.ArrayList<Object[]> rows = new java.util.ArrayList<Object[]>();
for (java.util.Map.Entry<String, int[]> e : stats.entrySet()) {
    String attr = e.getKey();
    int[] s = e.getValue();
    if (s[0] == 0 && attr.equals("AUTRE")) continue;
    double taux = s[0] > 0 ? (100.0 * s[1] / s[0]) : 0.0;
    String limite = "";
    if (attr.equals("RL")) limite = "Les données documentaires, dommages réels, installation et paiement ne sont pas toutes observées.";
    else if (attr.equals("RS")) limite = "Seules les durées des postes réellement exécutés sont calculables.";
    else if (attr.equals("AG")) limite = "Les scénarios de capacité maximale, risque et adaptabilité avancée restent à modéliser.";
    else if (attr.equals("CO")) limite = "Les coûts horaires/matière existent partiellement ; les risques, taxes et paiements restent incomplets.";
    else if (attr.equals("AM")) limite = "Les stocks sont observables, mais plusieurs données financières d'actifs/cash restent absentes.";
    else limite = "Attribut non classé dans les cinq groupes principaux.";
    rows.add(new Object[] {
        attr,
        String.valueOf(s[0]),
        String.valueOf(s[1]),
        String.valueOf(s[2]),
        String.valueOf(s[3]),
        fmt1(taux),
        exemples.get(attr).isEmpty() ? "-" : String.join(" ; ", exemples.get(attr)),
        limite
    });
}
return rows.toArray(new Object[0][]);]]></Body>
				</Function>
