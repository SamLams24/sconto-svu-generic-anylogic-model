					<Body><![CDATA[if (messagesAnimes.size() > 0) return;
for (int i = 0; i < TAILLE_POOL_MESSAGES; i++) {
    Movable m = add_messagesAnimes();
    m.libre = true;
    m.type = "";
    m.kindMessage = "";
    m.name = "";
    m.setXY(-1000, -1000);
}
board.logEvent("[ANIM] Pool de " + TAILLE_POOL_MESSAGES + " messages/vehicules initialise.");]]></Body>
