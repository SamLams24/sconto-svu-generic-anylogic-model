			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781200000052</Id>
					<Name><![CDATA[getGoulotsRapport]]></Name>
					<X>250</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[BlackboardAgent board = ((Main) getOwner()).board;
if (board == null || board.kpiParPoste.isEmpty()) return "Aucune donnee";
StringBuilder sb = new StringBuilder();
String pirePoste = null; double maxWT = 0;
for (java.util.Map.Entry<String, KPIBundle> e : board.kpiParPoste.entrySet()) {
    double wt = e.getValue().avgWaitTime();
    if (wt > maxWT) { maxWT = wt; pirePoste = e.getKey(); }
}
sb.append("Goulot principal : ").append(pirePoste != null ? pirePoste : "N/A");
sb.append(String.format(" (WT moy=%.1f s)\n", maxWT));
for (java.util.Map.Entry<String, KPIBundle> e : board.kpiParPoste.entrySet()) {
    KPIBundle k = e.getValue();
    sb.append(String.format("  %s  CT=%.1f  WT=%.1f  PCE=%.0f%%\n", e.getKey(), k.avgCycleTime(), k.avgWaitTime(), k.pce() * 100));
}
return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781200000053</Id>
					<Name><![CDATA[getRapportVSM]]></Name>
					<X>250</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[BlackboardAgent board = ((Main) getOwner()).board;
if (board == null) return "Blackboard non initialise";
StringBuilder sb = new StringBuilder();
sb.append("=== VSM PAR MACRO-PROCESSUS ===\n");
for (java.util.Map.Entry<String, KPIBundle> e : board.kpiParMacro.entrySet()) {
    KPIBundle k = e.getValue();
    sb.append(String.format("%s  CT=%.1f s  LT=%.1f s  WT=%.1f s  PCE=%.0f%%  N=%d\n",
        e.getKey(), k.avgCycleTime(), k.avgLeadTime(), k.avgWaitTime(), k.pce() * 100, k.count));
}
sb.append("\n=== GLOBAL ===\n");
KPIBundle g = board.kpiGlobal;
sb.append(String.format("LT=%.1f s  WT=%.1f s  PCE=%.0f%%  WIP moy=%.1f  N=%d\n",
    g.avgLeadTime(), g.avgWaitTime(), g.pce() * 100, board.avgWIP(), g.count));
sb.append(String.format("\n=== PI GLOBAL SCOR ===\n%.3f / %.2f (cible)\n", main.strategic.piGlobalCourant, main.strategic.ciblePIGlobal));
sb.append(String.format("RL=%.2f  RS=%.2f  AG=%.2f  CO=%.2f  AM=%.2f\n", main.strategic.scoreRL, main.strategic.scoreRS, main.strategic.scoreAG, main.strategic.scoreCO, main.strategic.scoreAM));
sb.append(String.format("\n=== QUALITE ===\nRebuts : %d   Rework : %d\n", board.totalRebuts, board.totalRework));
main.kpi_RL_score = main.strategic.scoreRL;
main.kpi_RS_score = main.strategic.scoreRS;
main.kpi_AG_score = main.strategic.scoreAG;
main.kpi_CO_score = main.strategic.scoreCO;
main.kpi_AM_score = main.strategic.scoreAM;
main.waitingTime = g.avgWaitTime();
main.kpi_PI = main.strategic.piGlobalCourant;
return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781700000021</Id>
					<Name><![CDATA[getDetailN3Rapport]]></Name>
					<X>-500</X><Y>320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[StrategicAgent strategic = main.strategic;
StringBuilder sb = new StringBuilder();
sb.append("=== DETAIL N3 -> N1 ===\n");
String[] attrs = {"RL","RS","AG","CO","AM"};
double[] scores = {strategic.scoreRL, strategic.scoreRS, strategic.scoreAG, strategic.scoreCO, strategic.scoreAM};
double[] poids = {strategic.w_RL, strategic.w_RS, strategic.w_AG, strategic.w_CO, strategic.w_AM};
int idx = 0;
for (String a : attrs) {
    java.util.ArrayList<MetriqueN3> lst = strategic.detailN3.get(a);
    sb.append(String.format("\n[%s] score=%.2f (poids %.2f)\n", a, scores[idx], poids[idx]));
    if (lst != null) {
        for (MetriqueN3 m : lst) {
            sb.append(String.format("   - %-22s brut=%.2f  norm=%.2f  (p=%.2f)\n",
                m.nom, m.valeurBrute, m.valeurNorm, m.poids));
        }
    }
    idx++;
}
return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781200000054</Id>
					<Name><![CDATA[exporterCSV]]></Name>
					<X>50</X><Y>530</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nomEntreprise]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Export des KPIs vers un fichier CSV tagge entreprise
BlackboardAgent board = ((Main) getOwner()).board;
if (board == null) return;
String nomE = ((Main) getOwner()).nomEntreprise;
try {
    java.io.PrintWriter pw = new java.io.PrintWriter(new java.io.FileWriter("export_" + nomE + ".csv"));
    pw.println("entreprise;niveau;cle;avgCycleTime_s;avgWaitTime_s;avgLeadTime_s;pce_pct;count");
    for (java.util.Map.Entry<String, KPIBundle> e : board.kpiParPoste.entrySet()) {
        KPIBundle k = e.getValue();
        pw.println(String.format("%s;POSTE;%s;%.3f;%.3f;%.3f;%.2f;%d",
            nomE, e.getKey(), k.avgCycleTime(), k.avgWaitTime(), k.avgLeadTime(), k.pce() * 100, k.count));
    }
    for (java.util.Map.Entry<String, KPIBundle> e : board.kpiParMacro.entrySet()) {
        KPIBundle k = e.getValue();
        pw.println(String.format("%s;MACRO;%s;%.3f;%.3f;%.3f;%.2f;%d",
            nomE, e.getKey(), k.avgCycleTime(), k.avgWaitTime(), k.avgLeadTime(), k.pce() * 100, k.count));
    }
    KPIBundle g = board.kpiGlobal;
    pw.println(String.format("%s;GLOBAL;ALL;%.3f;%.3f;%.3f;%.2f;%d",
        nomE, g.avgCycleTime(), g.avgWaitTime(), g.avgLeadTime(), g.pce() * 100, g.count));
    pw.println(String.format("%s;QUALITE;rebuts;%d;;;;", nomE, board.totalRebuts));
    pw.println(String.format("%s;QUALITE;rework;%d;;;;", nomE, board.totalRework));
    pw.println(String.format("%s;SCOR;PI_GLOBAL;%.4f;;;;", nomE, ((Main) getOwner()).strategic.piGlobalCourant));
    pw.close();
    traceln("Export CSV ecrit : export_" + nomE + ".csv");
} catch (Exception ex) {
    traceln("Erreur export CSV : " + ex.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781621322752</Id>
					<Name><![CDATA[recevoirAlerteGoulot]]></Name>
					<X>250</X><Y>480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[nomPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[wtMoyen]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[tailleFile]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[msg]]></Name>
						<Type><![CDATA[AERMessage]]></Type>
					</Parameter>
					<Body><![CDATA[// ── 1. Enregistrer l'alerte dans la file ─────────────────────────────
alertesGoulot.add(msg);

// ── 2. Mettre à jour l'historique de persistance ─────────────────────
int cumul = historiqueGoulots.getOrDefault(idPoste, 0) + 1;
historiqueGoulots.put(idPoste, cumul);
dernierGoulot = idPoste + " [" + codeSCOR + "] WT=" + String.format("%.1f", wtMoyen) + "s";
tDernierGoulotTraite = time();
BlackboardAgent board = ((Main) getOwner()).board;
board.logEvent("[HOLON-SUP] " + msg.toString()
    + " | persistance=" + cumul + "x");

// ── 3. Déclencher immédiatement l'évaluation AHP si cooldown écoulé ──
// (le cycle de 120s de evaluerGoulots assure aussi un filet de secours)
if (time() - dernierReeq >= intervalleMinReeq) {
    prendreDecisionAHP();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781621371170</Id>
					<Name><![CDATA[scorerGoulotAHP]]></Name>
					<X>250</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[wtMoyen]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[tailleFile]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// ══════════════════════════════════════════════════════════════════
// AHP simplifié — 4 critères, poids calibrés SCONTO-VSM
// Saaty (1980) + MAUT normalisé [0..1] par critère
// ══════════════════════════════════════════════════════════════════

// ── Critère 1 — Urgence (WT vs seuil goulot), poids : 0.40 ──────
double seuilWT = 30.0; // secondes
double urgence = Math.min(wtMoyen / seuilWT, 3.0) / 3.0; // clip à 3× le seuil

// ── Critère 2 — Impact macro-processus SCOR, poids : 0.30 ───────
double impactSCOR = 0.5; // valeur neutre
if (codeSCOR != null && codeSCOR.length() >= 2) {
    String pref = ((Main) getOwner()).macroPrefixe(codeSCOR.contains("|") ? codeSCOR.substring(codeSCOR.indexOf('|')+1) : codeSCOR);
    switch (pref) {
        case "sM": impactSCOR = 1.0; break; // Make = cœur production
        case "sR": impactSCOR = 0.9; break; // Return = critique qualité
        case "sD": impactSCOR = 0.8; break; // Deliver = proximité client
        case "sS": impactSCOR = 0.6; break; // Source = amont, plus de marge
        case "sP": impactSCOR = 0.4; break; // Plan = indirect
    }
}

// ── Critère 3 — Persistance (nb alertes cumulées), poids : 0.20 ─
int nbAlertes = historiqueGoulots.getOrDefault(idPoste, 1);
double persistance = Math.min((double) nbAlertes / 10.0, 1.0); // plateau à 10 alertes

// ── Critère 4 — Volume file d'attente, poids : 0.10 ─────────────
double seuilFile = 5.0;
double volume = Math.min((double) tailleFile / seuilFile, 2.0) / 2.0;

// ── Score AHP pondéré final ──────────────────────────────────────
double score = 0.40 * urgence
             + 0.30 * impactSCOR
             + 0.20 * persistance
             + 0.10 * volume;

return score;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781621466026</Id>
					<Name><![CDATA[prendreDecisionAHP]]></Name>
					<X>250</X><Y>550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (alertesGoulot.isEmpty()) return;
if (time() - dernierReeq < intervalleMinReeq && dernierReeq > 0) return;

Main main = (Main) getOwner();
BlackboardAgent board = main.board;
board.logEvent("[HOLON-SUP] ══ Cycle AHP T=" + String.format("%.0f", time())
    + "s — " + alertesGoulot.size() + " alertes ══");

// ── 1. Déduplication : garder 1 entrée par poste (la plus récente) ──
java.util.LinkedHashMap<String, AERMessage> parPoste = new java.util.LinkedHashMap<>();
for (AERMessage m : alertesGoulot) {
    parPoste.put(m.emetteur, m);
}
alertesGoulot.clear();

// ── 2. Construire la matrice AHP et scorer chaque alternative ─────────
java.util.ArrayList<double[]> scores = new java.util.ArrayList<>();
// double[]: [score, wtMoyen, tailleFile, index dans parPoste]
java.util.ArrayList<String> keys = new java.util.ArrayList<>(parPoste.keySet());

for (String idP : keys) {
    AERMessage m = parPoste.get(idP);
    double wt = 0; int file = 0;
    // Parser "WT=34.2;file=7;CT=8.5"
    for (String part : m.contenu.split(";")) {
        if (part.startsWith("WT="))   { try { wt   = Double.parseDouble(part.substring(3)); } catch(Exception e){} }
        if (part.startsWith("file=")) { try { file = Integer.parseInt(part.substring(5));   } catch(Exception e){} }
    }
    PosteGenericAgent p = main.trouverPoste(idP);
    String scor = (p != null) ? p.codeSCOR : "";
    double s = scorerGoulotAHP(idP, wt, file, scor);
    scores.add(new double[]{ s, wt, file });

    board.logEvent(String.format(
        "[HOLON-SUP] AHP %-6s score=%.3f | WT=%.1fs file=%d SCOR=%-6s persist=%dx",
        idP, s, wt, file, scor,
        historiqueGoulots.getOrDefault(idP, 0)));
}

// ── 3. Trouver le goulot prioritaire (score max) ──────────────────────
int idxMax = 0;
for (int i = 1; i < scores.size(); i++) {
    if (scores.get(i)[0] > scores.get(idxMax)[0]) idxMax = i;
}
String idPrioritaire = keys.get(idxMax);
double scorePrio = scores.get(idxMax)[0];

board.logEvent(String.format(
    "[HOLON-SUP] ★ DÉCISION AHP → %s (score=%.3f)",
    idPrioritaire, scorePrio));

// ── 4. Action holonique : AER Amendment vers l'OperationalAgent ───────
AERMessage decision = new AERMessage(
    AERMessage.AMENDMENT,
    "SUPERVISOR",
    idPrioritaire,
    "REBALANCE",
    "Priorite AHP. Score=" + String.format("%.3f", scorePrio)
    + ". Action: surveillance_renforcee",
    time()
);
board.logEvent("[HOLON-SUP] " + decision.toString());

// ── 5. Action concrète sur l'OperationalAgent ciblé ──────────────────
for (OperationalAgent op : main.opAgents) {
    if (op.idPoste.equals(idPrioritaire)) {
        // Renforcer la sensibilité : abaisser le seuil de détection de 20%
        op.seuilGoulotWT = Math.max(8.0, op.seuilGoulotWT * 0.80);
        board.logEvent("[HOLON-SUP] " + idPrioritaire
            + " seuilWT abaissé → " + String.format("%.1f", op.seuilGoulotWT) + "s");
    }
    // Relâcher légèrement les autres (éviter sur-détection)
    if (!op.idPoste.equals(idPrioritaire) && op.seuilGoulotWT < 30.0) {
        op.seuilGoulotWT = Math.min(30.0, op.seuilGoulotWT * 1.05);
    }
}

// ── 6. Accusé AER (EXECUTION) en retour ──────────────────────────────
AERMessage ack = new AERMessage(
    AERMessage.EXECUTION,
    idPrioritaire,
    "SUPERVISOR",
    "ACK_REBALANCE",
    "Ordre reçu. Sensibilité renforcée.",
    time()
);
board.logEvent("[HOLON-SUP] " + ack.toString());

dernierReeq = time();
nbReequilibrages++;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781621491990</Id>
					<Name><![CDATA[getDecisionRapport]]></Name>
					<X>450</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[StringBuilder sb = new StringBuilder();
sb.append("=== DÉCISIONS AHP — CoordinatorAgent ===\n");
sb.append(String.format("Dernier cycle AHP : T=%.0fs | Cooldown: %.0fs\n",
    dernierReeq, intervalleMinReeq));
sb.append(String.format("Alertes en attente: %d\n\n", alertesGoulot.size()));

sb.append("Historique de persistance des goulots:\n");
if (historiqueGoulots.isEmpty()) {
    sb.append("  (aucun goulot détecté)\n");
} else {
    for (java.util.Map.Entry<String, Integer> e : historiqueGoulots.entrySet()) {
        PosteGenericAgent p = ((Main) getOwner()).trouverPoste(e.getKey());
        String scor = (p != null) ? p.codeSCOR : "?";
        String cleKpi = (p != null) ? ((Main) getOwner()).cleKPI(p) : "?";
        // Re-calculer le score AHP pour affichage
        KPIBundle kpi = ((Main) getOwner()).board.kpiParPoste.get(cleKpi);
        double wt = (kpi != null) ? kpi.avgWaitTime() : 0;
        int file  = (p != null) ? p.queue.size() : 0;
        double s  = scorerGoulotAHP(e.getKey(), wt, file, scor);
        sb.append(String.format("  %-6s [%-7s] persist=%2dx | WT=%5.1fs file=%2d | score=%.3f\n",
            e.getKey(), scor, e.getValue(), wt, file, s));
    }
}

sb.append(String.format("\nAgents OP actifs: %d\n",
    ((Main) getOwner()).opAgents.size()));
return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782074378015</Id>
					<Name><![CDATA[traiterAlertesTactiques]]></Name>
					<X>257</X><Y>-54</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();
if (!main.modeExecution) return;
BlackboardAgent board = main.board;
if (board == null) return;

// --- Mise a jour de l'etat visible du coordinateur ---
// Detection DIRECTE et fiable : y a-t-il actuellement au moins un
// OperationalAgent en GOULOT dans MON macro-processus ? (plus robuste que
// de compter les alertes sur le blackboard, qui sont consommees dans le
// meme cycle et donc trop fugaces pour etre observees a l'ecran).
int goulotsActifsChezMoi = 0;
for (OperationalAgent op : main.opAgents) {
    if (!"GOULOT".equals(op.etatHolon)) continue;
    // op.codeSCOR est une clef composite "IDACTEUR|N3" -> extraire le N3 pur
    String n3 = (op.codeSCOR != null && op.codeSCOR.contains("|"))
        ? op.codeSCOR.substring(op.codeSCOR.indexOf('|') + 1) : op.codeSCOR;
    if (n3 != null && main.macroPrefixe(n3).equals(idMacroProcessus)) goulotsActifsChezMoi++;
}
String nouvelEtat;
boolean goulotRecent = (tDernierGoulotTraite > 0 && time() - tDernierGoulotTraite < 90);
boolean reeqRecent   = (dernierReeq > 0 && time() - dernierReeq < 120);
if (goulotsActifsChezMoi > 0 || goulotRecent) nouvelEtat = "ESCALADE";   // rouge
else if (reeqRecent)                          nouvelEtat = "AJUSTEMENT"; // orange
else                                          nouvelEtat = "SURVEILLANCE"; // vert
if (!nouvelEtat.equals(etatAgent)) { etatAgent = nouvelEtat; tEntreeEtat = time(); }

if (board.alertesPubliees.isEmpty()) return;

double seuilOrphelin = 60.0; // secondes : alerte Operational jamais ramassee par un Tactical
java.util.ArrayList<AERMessage> traitees = new java.util.ArrayList<AERMessage>();

for (AERMessage m : board.alertesPubliees) {
    String idPoste = "";
    double wt = 0;
    if (m.emetteur.startsWith("TACTICAL_")) {
        for (String part : m.contenu.split(";")) {
            if (part.startsWith("poste=")) idPoste = part.substring(6);
            if (part.startsWith("WT="))    { try { wt = Double.parseDouble(part.substring(3)); } catch(Exception ex){} }
        }
    } else if (time() - m.timestamp > seuilOrphelin) {
        idPoste = m.emetteur;
        for (String part : m.contenu.split(";")) {
            if (part.startsWith("WT=")) { try { wt = Double.parseDouble(part.substring(3)); } catch(Exception ex){} }
        }
    } else {
        continue; // laisser le temps au Tactical de la ramasser
    }
    if (idPoste.isEmpty()) continue;
    PosteGenericAgent p = main.trouverPoste(idPoste);
    String scor = (p != null) ? p.codeSCOR : "";
    // FILTRE MACRO-PROCESSUS : ce coordinateur ne traite QUE les alertes qui
    // relevent de SON macro-processus. Sans ce filtre, les 4 coordinateurs
    // traitaient toutes les alertes (d'ou sR rouge sans poste Return, et pas
    // de correspondance entre un goulot et le coordinateur reellement concerne).
    if (p == null || !main.macroPrefixe(p.codeSCOR).equals(idMacroProcessus)) continue;
    recevoirAlerteGoulot(idPoste, idPoste, scor, wt, 0, m);
    nbAlertesTraitees++;
    traitees.add(m);
}
board.alertesPubliees.removeAll(traitees);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000008201</Id>
					<Name><![CDATA[ordonnancerProduction]]></Name>
					<X>257</X><Y>-20</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ============================================================
// ORDONNANCEMENT REEL DE LA PRODUCTION (role concret du Coordinateur Make).
//
// Les commandes qui necessitent une production complete (stock insuffisant
// en MTS, ou MTO) ne sont plus injectees immediatement dans la chaine : elles
// attendent dans le carnet du Coordinateur du macro-processus Make, qui
// decide QUAND et LAQUELLE liberer vers la production. C'est le vrai
// pendant du "sM1.1 Schedule Production Activities" du referentiel SCOR --
// jusqu'ici un simple poste de passage sans decision reelle.
//
// Regle de priorite : EDD (Earliest Due Date) -- la commande dont le delai
// promis est le plus proche est produite en premier. Regle standard et
// explicable, qui evite qu'une commande urgente attende derriere une commande
// moins pressee arrivee avant elle.
//
// Regle de charge : si le Make est deja en GOULOT ou en PANNE (au moins un
// agent operationnel du macro-processus dans cet etat), la liberation d'une
// NOUVELLE commande est retenue -- sauf si son delai promis est deja depasse
// (auquel cas on force le lancement pour eviter une famine indefinie de
// cette commande). Un seul ordre est libere par cycle : liberation cadencee,
// pas un deversement en bloc de tout le carnet.
// ============================================================
if (!"sM".equals(idMacroProcessus)) return; // seul le Coordinateur Make ordonnance la production ici
if (carnetCommandesMTO.isEmpty()) return;

Main main = (Main) getOwner();
BlackboardAgent board = main.board;
if (board == null) return;

// Regle de priorite a deux niveaux :
//   1. priorite explicite de la commande (1 = urgente, 2 = normale, 3 = basse) ;
//   2. a priorite egale, EDD (Earliest Due Date) : le delai promis le plus proche.
// Une commande urgente passe donc systematiquement devant une commande normale,
// meme si cette derniere a un delai plus court -- c'est la difference entre un
// ordonnancement purement mecanique et un ordonnancement qui porte une decision.
java.util.Collections.sort(carnetCommandesMTO, new java.util.Comparator<CommandeAgent>() {
    public int compare(CommandeAgent a, CommandeAgent b) {
        if (a.priorite != b.priorite) return Integer.compare(a.priorite, b.priorite);
        return Double.compare(a.tPromise, b.tPromise);
    }
});

CommandeAgent prochaine = carnetCommandesMTO.get(0);
boolean urgent = time() >= prochaine.tPromise;

boolean chargeDisponible = true;
for (OperationalAgent op : main.opAgents) {
    String n3 = (op.codeSCOR != null && op.codeSCOR.contains("|"))
        ? op.codeSCOR.substring(op.codeSCOR.indexOf('|') + 1) : op.codeSCOR;
    if (n3 == null || !main.macroPrefixe(n3).equals("sM")) continue;
    if ("GOULOT".equals(op.etatHolon) || "PANNE".equals(op.etatHolon)) { chargeDisponible = false; break; }
}

if (!chargeDisponible && !urgent) {
    board.logEvent("[ORDONNANCEMENT] Make chargé (goulot/panne en cours) : libération de "
        + prochaine.idCommande + " différée (" + carnetCommandesMTO.size() + " en attente).");
    return;
}

carnetCommandesMTO.remove(0);
main.lancerProductionCommande(prochaine);
nbCommandesOrdonnancees++;
String libPrio = (prochaine.priorite == 1) ? "URGENTE" : (prochaine.priorite == 3 ? "BASSE" : "normale");
board.logEvent("[ORDONNANCEMENT] " + prochaine.idCommande + " (priorité " + libPrio + ") libérée vers production ("
    + (urgent ? "délai déjà dépassé" : "règle priorité + EDD") + "). Restant en carnet : "
    + carnetCommandesMTO.size());]]></Body>
				</Function>
			</Functions>
