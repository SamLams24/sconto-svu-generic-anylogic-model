				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781968000004</Id>
					<Name><![CDATA[dashboardMacroRows]]></Name>
					<X>-440</X><Y>4130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (board.kpiParMacro == null || board.kpiParMacro.isEmpty()) {
    return emptyRows("Aucune donnée macro-processus", dashboardMacroColumns().length);
}

Object[][] rows = new Object[board.kpiParMacro.size()][dashboardMacroColumns().length];

int i = 0;
for (java.util.Map.Entry<String, KPIBundle> e : board.kpiParMacro.entrySet()) {
    KPIBundle k = e.getValue();
    String code = e.getKey();
    String libelle = libelleMacroProcessusSCOR(code);

    rows[i][0] = code + " (" + libelle + ")";
    rows[i][1] = String.valueOf(k.count);
    rows[i][2] = fmt2(k.avgCycleTime());
    rows[i][3] = fmt2(k.avgWaitTime());
    rows[i][4] = fmt2(k.avgLeadTime());
    rows[i][5] = fmt1(k.pce() * 100);
    rows[i][6] = String.valueOf(k.nbRebut);
    rows[i][7] = String.valueOf(k.nbRework);
    rows[i][8] = metriquesSCORLieesMacro(code, false);
    rows[i][9] = metriquesSCORLieesMacro(code, true);
    i++;
}

return rows;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
