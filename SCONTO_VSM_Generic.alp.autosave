		<JavaClass>
			<Id>1780999596487</Id>
			<Name><![CDATA[RegleAiguillage]]></Name>
			<Text><![CDATA[public class RegleAiguillage implements java.io.Serializable {
    public String typeControle = "conformite";
    public double tauxTrue = 1.0;
    // Poste cible en cas d'echec (rework). null/vide = repasser le poste courant.
    public String idCibleEchec = null;

    public RegleAiguillage() {}
    public RegleAiguillage(String typeControle, double tauxTrue) {
        this.typeControle = typeControle; this.tauxTrue = tauxTrue;
    }
    public RegleAiguillage(String typeControle, double tauxTrue, String idCibleEchec) {
        this.typeControle = typeControle; this.tauxTrue = tauxTrue; this.idCibleEchec = idCibleEchec;
    }
}]]></Text>
