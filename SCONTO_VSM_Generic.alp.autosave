					<Body><![CDATA[String cat = normaliserCategorieActeur(categorie);
for (ActeurSC a : acteursSC) {
    if (a == null || !a.actif) continue;
    if (cat.equals(normaliserCategorieActeur(a.categorie))) return a;
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783700000041</Id>
					<Name><![CDATA[mapCategorieToType]]></Name>
					<X>-300</X><Y>1260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[categorie]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Choix d'icone station (type) selon la categorie de l'acteur, parmi
// les icones deja cablees dans la presentation de Movable.
if (ActeurSC.FOURNISSEUR.equals(categorie))       return "Warehouse";
if (ActeurSC.ENTREPRISE_FOCALE.equals(categorie)) return "Strategique";
if (ActeurSC.CLIENT.equals(categorie))            return "sP1";
return "Tactique";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783700000042</Id>
					<Name><![CDATA[mapCodeSCORToType]]></Name>
					<X>-300</X><Y>1280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Choix d'icone station (type) selon la lettre de tete du code SCOR
// du poste, parmi les icones deja cablees dans la presentation de Movable.
if (codeSCOR == null || codeSCOR.isEmpty()) return "Operationnel";
char c = Character.toUpperCase(codeSCOR.charAt(0));
if (c == 'S') return "Warehouse";
if (c == 'M') return "Machine";
if (c == 'D') return "Vehicle";
return "box";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783700000043</Id>
					<Name><![CDATA[positionnerStationAnimation]]></Name>
					<X>-300</X><Y>1300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[m]]></Name>
						<Type><![CDATA[Movable]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[index]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[xStart]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[yStart]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[colWidth]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[rowHeight]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[maxCols]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int col = index % maxCols;
int row = index / maxCols;
m.setXY(xStart + col * colWidth, yStart + row * rowHeight);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783700000044</Id>
					<Name><![CDATA[creerStationsAnimation]]></Name>
					<X>-300</X><Y>1320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Synchronise viewAnimation avec les agents statiques deja dessines dans la vue.
// On ne cree plus de Movable supplementaire pour les acteurs/postes : les cadres
// Supplier / Manufacturer / Customer et les agents AO/ASup/AT/AS existants sont
// les points d'ancrage SCOR. Les flux se deplacent ENTRE ces agents.
while (stationsAnimation.size() > 0) {
    remove_stationsAnimation(stationsAnimation.get(stationsAnimation.size() - 1));
}
puppets.clear();
puppetXY.clear();

registerViewAnimationStaticPuppets();

garantirActeurEntrepriseFocale();

// Alias des acteurs reels vers les agents/domaines deja representes graphiquement.
for (ActeurSC a : acteursSC) {
    if (a == null || !a.actif) continue;
    a.categorie = normaliserCategorieActeur(a.categorie);
    if (ActeurSC.FOURNISSEUR.equals(a.categorie)) {
        registerPuppetAnchor(a.nom, ASup_sS1, 310, 6720);
        registerPuppetAnchor(a.idActeur, ASup_sS1, 310, 6720);
    } else if (ActeurSC.ENTREPRISE_FOCALE.equals(a.categorie)) {
        registerPuppetAnchor(a.nom, AS_sP1, 1320, 6340);
        registerPuppetAnchor(a.idActeur, AS_sP1, 1320, 6340);
        registerPuppetAnchor("ENTREPRISE", AS_sP1, 1300, 6340);
        registerPuppetAnchor("ENTREPRISE_FOCALE", AS_sP1, 1300, 6340);
        registerPuppetAnchor(nomEntreprise, AS_sP1, 1320, 6340);
    } else if (ActeurSC.CLIENT.equals(a.categorie)) {
        registerPuppetAnchor(a.nom, ASup_sD1_2, 2340, 6580);
        registerPuppetAnchor(a.idActeur, ASup_sD1_2, 2340, 6580);
    }
}

// Alias des postes reels vers les agents SCOR deja dessines, quand le code SCOR est represente.
for (PosteGenericAgent p : postes) {
    if (p == null) continue;
    String code = p.codeSCOR == null ? "" : p.codeSCOR.trim();
    Movable anchor = null;
    double ax = 1320, ay = 6340;
    if (code.startsWith("sS1.1")) { anchor = AO_sS1_1; ax = 740; ay = 6720; }
    else if (code.startsWith("sS1.2")) { anchor = AO_sS1_2; ax = 660; ay = 6860; }
    else if (code.startsWith("sS1.3")) { anchor = AO_sS1_3; ax = 920; ay = 6860; }
    else if (code.startsWith("sS1.4")) { anchor = AO_sS1_4; ax = 820; ay = 6960; }
    else if (code.startsWith("sM1.1")) { anchor = AO_sM1_1; ax = 1360; ay = 6760; }
    else if (code.startsWith("sM1.2")) { anchor = AO_sM1_1_2; ax = 1140; ay = 6900; }
    else if (code.startsWith("sM1.3")) { anchor = AO_sM1_3; ax = 1400; ay = 6900; }
    else if (code.startsWith("sM1.4")) { anchor = AO_sM1_4; ax = 1240; ay = 7060; }
    else if (code.startsWith("sM1.5")) { anchor = AO_sM1_5; ax = 1720; ay = 7060; }
    else if (code.startsWith("sM1.6")) { anchor = AO_sM1_6; ax = 1720; ay = 6960; }
    else if (code.startsWith("sM1.7")) { anchor = AO_sM1_7; ax = 1480; ay = 7020; }
    else if (code.startsWith("sD1.2")) { anchor = AO_sD1_2; ax = 1920; ay = 6840; }
    else if (code.startsWith("sD1.8")) { anchor = AO_sD1_8_3; ax = 1620; ay = 6730; }
    else if (code.startsWith("sD1.12")) { anchor = AO_sD1_12_2; ax = 1840; ay = 6730; }
    if (anchor != null) {
        registerPuppetAnchor(p.nom, anchor, ax, ay);
        registerPuppetAnchor(p.idPoste, anchor, ax, ay);
        registerPuppetAnchor(code, anchor, ax, ay);
    }
}

board.logEvent("[ANIM] Agents statiques viewAnimation enregistres. Aucun nouvel acteur visuel cree. Cles=" + puppets.keySet());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Movable]]></ReturnType>
					<Id>1783700000045</Id>
					<Name><![CDATA[getMovableLibre]]></Name>
					<X>-300</X><Y>1340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (Movable m : messagesAnimes) {
    if (m.libre) return m;
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783700000046</Id>
					<Name><![CDATA[onMessageArrived]]></Name>
					<X>-300</X><Y>1360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[m]]></Name>
						<Type><![CDATA[Movable]]></Type>
					</Parameter>
					<Body><![CDATA[m.kindMessage = "";
m.type = "";
m.name = "";
m.MovableInfo = "";
m.arriveeAt = -1;
m.libre = true;
m.setXY(-1000, -1000);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783700000047</Id>
					<Name><![CDATA[animerMessage]]></Name>
					<X>-300</X><Y>1380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idSrc]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idCib]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[kind]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[info]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Point d'entree unique pour animer un message (workOrder / commande /
// message generique) depuis l'agent SCOR "idSrc" vers l'agent SCOR "idCib".
// Les points d'ancrage sont les agents statiques de viewAnimation, pas des
// stations dynamiques creees artificiellement.
if (messagesAnimes.size() == 0) initialiserPoolMessages();
if (puppets == null || puppets.isEmpty()) {
    creerStationsAnimation();
}

Movable src = puppet(idSrc);
Movable dst = puppet(idCib);
double[] xySrc = xyPuppet(idSrc);
double[] xyDst = xyPuppet(idCib);
if (src == null || dst == null || xySrc == null || xyDst == null) {
    String details = "Agent SCOR introuvable pour " + kind + " : " + idSrc + " -> " + idCib;
    board.logEvent("[ANIM] " + details + " - animation ignoree. Cles disponibles=" + puppets.keySet());
    return;
}

Movable msg = getMovableLibre();
if (msg == null) {
    board.logEvent("[ANIM] pool de messages sature (" + TAILLE_POOL_MESSAGES + "), animation ignoree pour " + idSrc + " -> " + idCib + ".");
    return;
}

msg.libre = false;
msg.type = "";
msg.kindMessage = kind;
msg.name = "";
msg.MovableInfo = info;
msg.setXY(xySrc[0], xySrc[1]);
double dx = xyDst[0] - xySrc[0];
double dy = xyDst[1] - xySrc[1];
double distance = Math.sqrt(dx * dx + dy * dy);
double duree = dureeAnimationDepuisDistance(distance, false);
double vitesseEffective = vitessePourRespecterDuree(distance, duree);
appliquerVitesseAnimation(msg, vitesseEffective);

msg.arriveeAt = time() + duree + Math.max(0.0, pauseApresArriveeAnimationSec);
String scor = extraireSCORDepuisInfo(info);
board.logEvent("[ANIM MOVE] " + kind + " " + idSrc + " -> " + idCib + " src=(" + String.format("%.1f", xySrc[0]) + "," + String.format("%.1f", xySrc[1]) + ") dst=(" + String.format("%.1f", xyDst[0]) + "," + String.format("%.1f", xyDst[1]) + ") duree=" + String.format("%.1f", duree) + "s");
ajouterSuivi("Communication", "Message envoye entre agents", info, idSrc, idCib, scor);
afficherFluxAnimation(kind, scor, idSrc, idCib, info);
msg.moveTo(xyDst[0], xyDst[1]);]]></Body>
				</Function>
