					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[  StringBuilder sb = new StringBuilder();
  sb.append("  AMENDMENT  : Coordinateur -> Opérationnel (ordre de reequilibrage, abaissement seuil d’attente)\n");
  sb.append("  EXECUTION  : Operationnel -> Coordinateur (accuse de reception, mise en oeuvre)\n");
  sb.append("  REPORT     : Operationnel -> Coordinateur (rapport goulot, Attente moyenneen, taille file)\n");
  sb.append(String.format("\n  Dernier cycle AHP : T=%.0fs | PI courant : %.3f | Nb ajustements debit: %d",
    supervisor.dernierReeq, strategic.piGlobalCourant, strategic.nbAjustements));
return sb.toString();]]></Body>
