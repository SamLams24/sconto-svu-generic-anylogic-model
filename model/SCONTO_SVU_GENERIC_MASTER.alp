				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PosteGenericAgent]]></ReturnType>
					<Id>1895000000106</Id>
					<Name><![CDATA[trouverPostePourActeurEtId]]></Name>
					<X>-300</X><Y>952</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idActeur]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (idPoste == null || idPoste.trim().isEmpty()) return null;
for (PosteGenericAgent p : postes) {
    if (p == null || p.idPoste == null) continue;
    boolean memePoste = p.idPoste.equalsIgnoreCase(idPoste.trim());
    boolean memeActeur = (idActeur == null || idActeur.trim().isEmpty())
        || (p.idActeurResponsable != null && p.idActeurResponsable.equalsIgnoreCase(idActeur.trim()));
    if (memePoste && memeActeur) return p;
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1895000000107</Id>
					<Name><![CDATA[typeISA95Valide]]></Name>
					<X>-300</X><Y>954</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[type]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (type == null) return false;
String t = type.trim();
return t.equals("EnterpriseUnit")
    || t.equals("Site")
    || t.equals("Area")
    || t.equals("Workshop")
    || t.equals("ProductionLine")
    || t.equals("WorkCenter")
    || t.equals("WorkCell")
    || t.equals("Workstation")
    || t.equals("Machine");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1895000000108</Id>
					<Name><![CDATA[validerHierarchieISA95]]></Name>
					<X>-300</X><Y>956</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[StringBuilder erreurs = new StringBuilder();
java.util.HashMap<String,ISA95EquipmentNode> parId = new java.util.HashMap<String,ISA95EquipmentNode>();
java.util.HashSet<String> clesAffectations = new java.util.HashSet<String>();

for (ISA95EquipmentNode n : isa95Hierarchy) {
    if (n == null) continue;
    String id = n.id == null ? "" : n.id.trim();
    if (id.isEmpty()) {
        erreurs.append("- Noeud ISA-95 sans id.\n");
        continue;
    }
    String cle = id.toLowerCase();
    if (parId.containsKey(cle)) erreurs.append("- Id ISA-95 duplique : ").append(id).append("\n");
    else parId.put(cle, n);

    if (!typeISA95Valide(n.typeISA95))
        erreurs.append("- Type ISA-95 invalide pour ").append(id).append(" : ").append(n.typeISA95).append("\n");

    if (n.idActeur != null && !n.idActeur.trim().isEmpty() && trouverActeurParId(n.idActeur) == null)
        erreurs.append("- Acteur introuvable pour noeud ").append(id).append(" : ").append(n.idActeur).append("\n");
}

for (ISA95EquipmentNode n : isa95Hierarchy) {
    if (n == null || n.id == null || n.id.trim().isEmpty()) continue;
    String parent = n.parentId == null ? "" : n.parentId.trim();
    if (!parent.isEmpty() && !parId.containsKey(parent.toLowerCase()))
        erreurs.append("- Parent ISA-95 introuvable pour ").append(n.id).append(" : ").append(parent).append("\n");
    if (!parent.isEmpty() && parent.equalsIgnoreCase(n.id))
        erreurs.append("- Noeud ISA-95 parent de lui-meme : ").append(n.id).append("\n");

    java.util.HashSet<String> vus = new java.util.HashSet<String>();
    ISA95EquipmentNode courant = n;
    while (courant != null && courant.id != null && !courant.id.trim().isEmpty()) {
        String c = courant.id.toLowerCase();
        if (!vus.add(c)) {
            erreurs.append("- Cycle ISA-95 detecte a partir de ").append(n.id).append("\n");
            break;
        }
        String p = courant.parentId == null ? "" : courant.parentId.trim();
        if (p.isEmpty()) break;
        courant = parId.get(p.toLowerCase());
    }

    if ("Machine".equals(n.typeISA95) && n.refMachineId != null && !n.refMachineId.trim().isEmpty()) {
        boolean trouvee = false;
        for (MachineSim m : machinesSim) {
            if (m != null && m.idMachine != null && m.idMachine.equalsIgnoreCase(n.refMachineId.trim())) {
                trouvee = true; break;
            }
        }
        if (!trouvee) erreurs.append("- Machine referencee introuvable pour noeud ").append(n.id)
            .append(" : ").append(n.refMachineId).append("\n");
    }
}

for (ISA95ActivityAssignment a : isa95Assignments) {
    if (a == null) continue;
    String cle = (a.idActeur == null ? "" : a.idActeur.trim().toLowerCase())
        + "|" + (a.idPoste == null ? "" : a.idPoste.trim().toLowerCase());
    if (!clesAffectations.add(cle))
        erreurs.append("- Affectation ISA-95 dupliquee pour ").append(cle).append("\n");

    PosteGenericAgent p = trouverPostePourActeurEtId(a.idActeur, a.idPoste);
    if (p == null)
        erreurs.append("- Poste introuvable pour affectation ISA-95 : ")
            .append(a.idActeur).append("/").append(a.idPoste).append("\n");

    ISA95EquipmentNode n = trouverNoeudISA95(a.idEquipment);
    if (n == null)
        erreurs.append("- Equipement ISA-95 introuvable pour affectation ")
            .append(a.idActeur).append("/").append(a.idPoste)
            .append(" : ").append(a.idEquipment).append("\n");
}

return erreurs.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1895000000109</Id>
					<Name><![CDATA[appliquerAffectationsISA95AuxPostes]]></Name>
					<X>-300</X><Y>958</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (isa95Assignments == null || isa95Assignments.isEmpty()) return;
int appliques = 0;
for (ISA95ActivityAssignment a : isa95Assignments) {
    if (a == null) continue;
    PosteGenericAgent p = trouverPostePourActeurEtId(a.idActeur, a.idPoste);
    ISA95EquipmentNode n = trouverNoeudISA95(a.idEquipment);
    if (p != null && n != null) {
        p.niveauISA95 = n.typeISA95 != null ? n.typeISA95 : "";
        appliques++;
    }
}
if (board != null) board.logEvent("[ISA95] " + appliques + " affectations micro-activite -> equipement appliquees.");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782600000020</Id>
					<Name><![CDATA[clearScenarioBeforeJsonLoad]]></Name>
					<X>-300</X><Y>950</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Nettoie proprement tout l'état avant chargement JSON
// 1. Stopper le mode exécution et supprimer tout profil de test résiduel.
modeExecution = false;
tempsDebutSimulation = -1;
aboxRunId = "";
dernierFichierABox = "";
c14SnapshotFinalEffectue = false;
profilTestActif = "";
champScenarioSelectionne = "";
// Valeurs de repli rétro-compatibles si un ancien JSON ne contient pas encore
// les nouveaux paramètres globaux. Les fiches matière détaillées restent conservées.
champStockInitialProduitFini = 100.0;
champStockInitialMatiereGlobal = 100.0;

// 2. Supprimer les OperationalAgents dynamiques
while (opAgents.size() > 0) remove_opAgents(opAgents.get(opAgents.size() - 1));

// 3. Supprimer les postes
while (postes.size() > 0) remove_postes(postes.get(postes.size() - 1));

// 4. Vider les listes
scenarios.clear();
acteursSC.clear();
responsabilitesMicro.clear();
machinesSim.clear();
fichesMatiere.clear();
isa95Hierarchy.clear();
isa95Assignments.clear();
normalizationProfiles.clear();

// 5. Vider les logs de flux (conserver les structures, juste vider)
if (fluxLogs != null) fluxLogs.clear();
if (tracesBrutes != null) tracesBrutes.clear();
if (tracesAgregees != null) tracesAgregees.clear();

// 6. Remettre les compteurs séquentiels
seqFlux          = 0;
seqResponsabilite = 0;
seqMachineSim    = 0;
seqTrace         = 0;

// 7. Réinitialiser les KPI courants
nbTermines = 0;
waitingTime = 0;
kpi_PI = 0; kpi_RL_score = 0; kpi_RS_score = 0;
kpi_AG_score = 0; kpi_CO_score = 0; kpi_AM_score = 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782600000021</Id>
					<Name><![CDATA[sauverScenarioJSON]]></Name>
					<X>-300</X><Y>960</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    String fichier = scenarioJsonFileName();
    java.util.Map<String,Object> root = new java.util.LinkedHashMap<String,Object>();

    // ── 1. Métadonnées ─────────────────────────────────────────────
    java.util.Map<String,Object> meta = new java.util.LinkedHashMap<String,Object>();
    meta.put("schemaVersion", "2.1");
    meta.put("modelName", "SCONTO_VSM_Generic");
    meta.put("javaPackageName", "sconto_vsm_generic");
    meta.put("createdAt", new java.util.Date().toString());
    meta.put("updatedAt", new java.util.Date().toString());
    meta.put("nomEntreprise", nomEntreprise);
    meta.put("nbActeurs", acteursSC.size());
    meta.put("nbPostes", postes.size());
    meta.put("nbScenarios", scenarios.size());
    meta.put("nbResponsabilites", responsabilitesMicro.size());
    meta.put("nbMachines", machinesSim.size());
    meta.put("nbISA95Nodes", isa95Hierarchy.size());
    meta.put("nbISA95Assignments", isa95Assignments.size());
    meta.put("isa95Reference", "SCONTO-SVU Core v4.3.0 / ISA-95-inspired equipment hierarchy");
    meta.put("agentOntologyReference", "SCONTO-VSM Agent Extension v1.1.2 / versionIRI 1.1.2");
    meta.put("coreOntologyReference", "SCONTO-SVU Core v4.3.0");
    meta.put("aerOntologyReference", "SCONTO-VSM AER Communication Extension v1.1.2");
    meta.put("performancePipeline", "VSM_RAW->SCOR_RAW_VALUE->BOTTOM_PERFECT_SCORE_0_10->FUZZY_A_F->PERFORMANCE_ATTRIBUTE->PI_0_10");
    meta.put("agentArchitecture", "Strategic>Tactical>Coordinator>OperationalPilot>OperationalExecution");
    meta.put("legacySupervisorPolicy", "SupervisorAgent deprecated alias; runtime exports OperationalPilotAgent");
    root.put("meta", meta);

    // ── 2. Paramètres globaux ──────────────────────────────────────
    java.util.Map<String,Object> params = new java.util.LinkedHashMap<String,Object>();
    params.put("nomEntreprise", nomEntreprise);
    params.put("champDebit", champDebit);
    params.put("chiffreAffaireParUnite", chiffreAffaireParUnite);
    params.put("champCoutHoraireMainOeuvre", champCoutHoraireMainOeuvre);
    params.put("champCoutMatierePremiereParUnite", champCoutMatierePremiereParUnite);
    params.put("champValeurActifFixe", champValeurActifFixe);
    params.put("champDelaiPaiementJours", champDelaiPaiementJours);
    params.put("champPoidsRL", champPoidsRL);
    params.put("champPoidsRS", champPoidsRS);
    params.put("champPoidsAG", champPoidsAG);
    params.put("champPoidsCO", champPoidsCO);
    params.put("champPoidsAM", champPoidsAM);
    params.put("champStockInitialProduitFini", champStockInitialProduitFini);
    params.put("champStockInitialMatiereGlobal", champStockInitialMatiereGlobal);
    // Bloc M.1 -- champs multi-produit optionnels : absents d'un ancien JSON, ils
    // se rechargent a leurs valeurs par defaut (false / map vide), comportement
    // historique inchange (voir chargement plus bas).
    params.put("modeMultiProduitActif", modeMultiProduitActif);
    params.put("rotationProduitsActive", rotationProduitsActive);
    params.put("stockInitialParProduit", stockInitialParProduit != null
        ? new java.util.LinkedHashMap<String,Double>(stockInitialParProduit)
        : new java.util.LinkedHashMap<String,Double>());
    params.put("seqFlux", seqFlux);
    params.put("seqResponsabilite", seqResponsabilite);
    params.put("seqMachineSim", seqMachineSim);
    params.put("seqTrace", seqTrace);
    root.put("parametresGlobaux", params);

    // ── 2bis. Echelles bottom/perfect du pipeline de performance C14 ───────────────
    initialiserProfilsNormalisationDefaut();
    java.util.List<Object> normList = new java.util.ArrayList<Object>();
    for (NormalizationProfile np : normalizationProfiles.values()) {
        java.util.Map<String,Object> nm = new java.util.LinkedHashMap<String,Object>();
        nm.put("code", np.code); nm.put("direction", np.direction);
        nm.put("min", np.min); nm.put("max", np.max); nm.put("bottom",np.bottom()); nm.put("perfect",np.perfect());
        nm.put("source", np.source); nm.put("version", np.version);
        normList.add(nm);
    }
    root.put("normalizationProfiles", normList);

    java.util.Map<String,Object> perf = new java.util.LinkedHashMap<String,Object>();
    perf.put("method","THEERANUPHATTANA_CHAN_QI_ADAPTED");
    perf.put("scoreScale","0..10");
    perf.put("fuzzyProfile","A~10,B~8,C~6,D~4,E~2,F~0_LINEAR_TRIANGULAR");
    perf.put("attributeWeightSource","CONFIGURED_EXPERT_INPUT_TO_VALIDATE");
    java.util.Map<String,Object> pw = new java.util.LinkedHashMap<String,Object>();
    pw.put("RL",strategic.w_RL); pw.put("RS",strategic.w_RS); pw.put("AG",strategic.w_AG); pw.put("CO",strategic.w_CO); pw.put("AM",strategic.w_AM);
    perf.put("attributeWeights",pw);
    perf.put("metricWeightPolicy","EQUAL_BY_DEFAULT_OR_USER_CONFIGURED");
    perf.put("referenceSelfTest","POF 90.1 [70,100] => 6.700 ; grades B=.350 C=.650 ; PI Table VIII => 4.050");
    root.put("performanceMeasurement",perf);

    // ── 2ter. Configuration AHP pairwise ───────────────────────────
    java.util.Map<String,Object> ahp = new java.util.LinkedHashMap<String,Object>();
    ahp.put("consistencyThreshold", ahpConsistencyThreshold);
    java.util.Map<String,Object> ahpS = new java.util.LinkedHashMap<String,Object>();
    ahpS.put("criteria", java.util.Arrays.asList("RL","RS","AG","CO","AM"));
    ahpS.put("source", sourceAHPStrategique); ahpS.put("usage","DIAGNOSTIC_ONLY_NOT_PI");
    ahpS.put("pairwiseMatrix", matriceAHPToJson(ahpStrategiquePairwise));
    java.util.Map<String,Object> ahpG = new java.util.LinkedHashMap<String,Object>();
    ahpG.put("criteria", java.util.Arrays.asList("URGENCE","IMPACT_SCOR","PERSISTANCE","VOLUME_FILE"));
    ahpG.put("source", sourceAHPGoulot); ahpG.put("usage","BOTTLENECK_DECISION");
    ahpG.put("pairwiseMatrix", matriceAHPToJson(ahpGoulotPairwise));
    ahp.put("strategic", ahpS); ahp.put("bottleneck", ahpG);
    root.put("ahpConfiguration", ahp);

    // ── 2quater. Export ABox runtime final C14 ──────────────────────────
    java.util.Map<String,Object> aboxCfg = new java.util.LinkedHashMap<String,Object>();
    aboxCfg.put("enabled", aboxExportActif);
    aboxCfg.put("exportOnOrderClosure", aboxExportSurClotureCommande);
    aboxCfg.put("exportOnStop", aboxExportSurArret);
    aboxCfg.put("maxRawEvents", aboxMaxRawEvents);
    aboxCfg.put("format", "Turtle");
    aboxCfg.put("coreNamespace", "http://www.sconto-vsm.org/core#");
    aboxCfg.put("agentNamespace", "http://www.sconto-vsm.org/agent-extension#");
    aboxCfg.put("agentOntologyVersionIRI", "http://www.sconto-vsm.org/agent-extension/1.1.2");
    aboxCfg.put("coreOntologyVersion", "4.3.0");
    aboxCfg.put("aerOntologyVersionIRI", "http://www.sconto-vsm.org/aer-extension/1.1.2");
    aboxCfg.put("performancePipeline", "VSM_TO_SCOR_RAW_TO_SCORE_0_10_TO_FUZZY_TO_ATTRIBUTE_TO_PI");
    aboxCfg.put("agentAerPolicy", "OFFICIAL_AGENT_V1_1_2_PLUS_OFFICIAL_AER_V1_1_2");
    root.put("aboxExport", aboxCfg);

    // ── 3. Acteurs ─────────────────────────────────────────────────
    java.util.List<Object> lstActeurs = new java.util.ArrayList<Object>();
    for (ActeurSC a : acteursSC) lstActeurs.add(acteurToJson(a));
    root.put("acteurs", lstActeurs);

    // ── 4. Postes / micro-activités ────────────────────────────────
    java.util.List<Object> lstPostes = new java.util.ArrayList<Object>();
    for (PosteGenericAgent p : postes) lstPostes.add(posteToJson(p));
    root.put("postes", lstPostes);

    // ── 5. Scénarios ───────────────────────────────────────────────
    java.util.List<Object> lstScenarios = new java.util.ArrayList<Object>();
    for (ScenarioFlux sc : scenarios) lstScenarios.add(scenarioToJson(sc));
    root.put("scenarios", lstScenarios);

    // ── 6. Responsabilités ─────────────────────────────────────────
    java.util.List<Object> lstResp = new java.util.ArrayList<Object>();
    for (MicroResponsabilite r : responsabilitesMicro) lstResp.add(responsabiliteToJson(r));
    root.put("responsabilites", lstResp);

    // ── 7. Machines ────────────────────────────────────────────────
    java.util.List<Object> lstMachines = new java.util.ArrayList<Object>();
    for (MachineSim mac : machinesSim) lstMachines.add(machineToJson(mac));
    root.put("machines", lstMachines);

    // ── 8. Hiérarchie ISA-95 / équipements ─────────────────────────
    java.util.List<Object> lstISA95 = new java.util.ArrayList<Object>();
    for (ISA95EquipmentNode n : isa95Hierarchy) lstISA95.add(isa95NodeToJson(n));
    root.put("isa95Hierarchy", lstISA95);

    java.util.List<Object> lstISA95Assignments = new java.util.ArrayList<Object>();
    for (ISA95ActivityAssignment a : isa95Assignments) lstISA95Assignments.add(isa95AssignmentToJson(a));
    root.put("isa95Assignments", lstISA95Assignments);

    // ── 9. Fiches matière (MRP) ─────────────────────────────────────
java.util.List<Object> lstFiches = new java.util.ArrayList<Object>();
for (FicheMatiere f : fichesMatiere) {
    java.util.Map<String,Object> fm = new java.util.LinkedHashMap<String,Object>();
    fm.put("idMatiere", f.idMatiere);
    fm.put("stockDisponible", f.stockDisponible);
    fm.put("stockSecurite", f.stockSecurite);
    fm.put("delaiObtentionHeures", f.delaiObtentionHeures);
    fm.put("idFournisseur", f.idFournisseur != null ? f.idFournisseur : "");
    lstFiches.add(fm);
}
root.put("fichesMatiere", lstFiches);

    // ── Écriture JSON ──────────────────────────────────────────────
    String json = SimpleJsonWriter.toJson(root, 0);
    java.io.PrintWriter writerJson = new java.io.PrintWriter(
        new java.io.OutputStreamWriter(
            new java.io.FileOutputStream(fichier), java.nio.charset.StandardCharsets.UTF_8));
    writerJson.print(json);
    writerJson.close();

    messageStatut = "Config JSON sauvée : " + fichier;
    getExperimentHost().showMessageDialog(
        "✅ Configuration JSON sauvegardée\n\n"
        + "Fichier : " + fichier + "\n"
        + "Acteurs          : " + acteursSC.size() + "\n"
        + "Micro-activités  : " + postes.size() + "\n"
        + "Responsabilités  : " + responsabilitesMicro.size() + "\n"
        + "Machines         : " + machinesSim.size() + "\n"
        + "Scénarios        : " + scenarios.size() + "\n"
        + "Noeuds ISA-95    : " + isa95Hierarchy.size() + "\n"
        + "Affectations ISA : " + isa95Assignments.size()
    );

} catch (Exception ex) {
    messageStatut = "Erreur sauvegarde JSON : " + ex.getMessage();
    getExperimentHost().showMessageDialog(
        "❌ Erreur de sauvegarde JSON\n\n" + ex.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782600000022</Id>
					<Name><![CDATA[chargerScenarioJSON]]></Name>
					<X>-300</X><Y>970</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    String fichier = scenarioJsonFileName();

    // ── 1. Lecture du fichier JSON ──────────────────────────────────
    java.io.InputStream is = new java.io.FileInputStream(fichier);
    java.io.BufferedReader br = new java.io.BufferedReader(
        new java.io.InputStreamReader(is, java.nio.charset.StandardCharsets.UTF_8));
    StringBuilder sb = new StringBuilder();
    String ligne;
    while ((ligne = br.readLine()) != null) sb.append(ligne).append("\n");
    br.close();
    String jsonText = sb.toString().trim();

    // ── 2. Parsing JSON ────────────────────────────────────────────
    java.util.Map<String,Object> root = SimpleJsonParser.parse(jsonText);

    // ── 3. Vérification schemaVersion ──────────────────────────────
    Object metaObj = root.get("meta");
    if (metaObj instanceof java.util.Map) {
        java.util.Map meta = (java.util.Map) metaObj;
        String sv = jsonString(meta, "schemaVersion", "");
        if (!sv.equals("1.0") && !sv.equals("1.1") && !sv.equals("1.2") && !sv.equals("1.3") && !sv.equals("1.4") && !sv.equals("1.5") && !sv.equals("1.6") && !sv.equals("1.7") && !sv.equals("1.8") && !sv.equals("1.9") && !sv.equals("2.0") && !sv.equals("2.1")) {
            getExperimentHost().showMessageDialog(
                "⚠️ Version de schéma non reconnue : " + sv +
                "\nLe chargement peut être incomplet.");
        }
    }

    // ── 4. Bloquer si simulation en cours ──────────────────────────
    if (modeExecution) {
        getExperimentHost().showMessageDialog(
            "⚠️ Impossible de charger : la simulation est en cours.\n" +
            "Arrêtez la simulation d'abord (bouton Arrêter).");
        return;
    }

    // ── 5. Nettoyage complet de l'état courant ─────────────────────
    clearScenarioBeforeJsonLoad();

    // ── 6. Paramètres globaux ──────────────────────────────────────
    Object paramsObj = root.get("parametresGlobaux");
    if (paramsObj instanceof java.util.Map) {
        java.util.Map pg = (java.util.Map) paramsObj;
        nomEntreprise                  = jsonString(pg, "nomEntreprise", nomEntreprise);
        champDebit                     = jsonDouble(pg, "champDebit", champDebit);
        chiffreAffaireParUnite         = jsonDouble(pg, "chiffreAffaireParUnite", chiffreAffaireParUnite);
        champCoutHoraireMainOeuvre     = jsonDouble(pg, "champCoutHoraireMainOeuvre", champCoutHoraireMainOeuvre);
        champCoutMatierePremiereParUnite = jsonDouble(pg, "champCoutMatierePremiereParUnite", champCoutMatierePremiereParUnite);
        champValeurActifFixe           = jsonDouble(pg, "champValeurActifFixe", champValeurActifFixe);
        champDelaiPaiementJours        = jsonDouble(pg, "champDelaiPaiementJours", champDelaiPaiementJours);
        champPoidsRL                   = jsonDouble(pg, "champPoidsRL", champPoidsRL);
        champPoidsRS                   = jsonDouble(pg, "champPoidsRS", champPoidsRS);
        champPoidsAG                   = jsonDouble(pg, "champPoidsAG", champPoidsAG);
        champPoidsCO                   = jsonDouble(pg, "champPoidsCO", champPoidsCO);
        champPoidsAM                   = jsonDouble(pg, "champPoidsAM", champPoidsAM);
        champStockInitialProduitFini   = jsonDouble(pg, "champStockInitialProduitFini", champStockInitialProduitFini);
        champStockInitialMatiereGlobal = jsonDouble(pg, "champStockInitialMatiereGlobal", champStockInitialMatiereGlobal);
        // Bloc M.1 -- champs multi-produit optionnels. Absents d'un JSON existant
        // (cas ZENER actuel notamment) : modeMultiProduitActif/rotationProduitsActive
        // retombent sur leur defaut false, stockInitialParProduit reste une map
        // vide -- comportement mono-produit historique strictement inchange.
        modeMultiProduitActif  = jsonBool(pg, "modeMultiProduitActif", false);
        rotationProduitsActive = jsonBool(pg, "rotationProduitsActive", false);
        stockInitialParProduit.clear();
        Object sipObj = pg.get("stockInitialParProduit");
        if (sipObj instanceof java.util.Map) {
            java.util.Map sip = (java.util.Map) sipObj;
            for (Object kObj : sip.keySet()) {
                if (kObj == null) continue;
                String cle = cleProduit(kObj.toString());
                Object vObj = sip.get(kObj);
                double val = 0.0;
                if (vObj instanceof Number) val = ((Number) vObj).doubleValue();
                else if (vObj != null) { try { val = Double.parseDouble(vObj.toString()); } catch (Exception ignored) {} }
                if (!cle.isEmpty()) stockInitialParProduit.put(cle, Math.max(0.0, val));
            }
        }
        // Restauration des compteurs
        seqFlux           = jsonInt(pg, "seqFlux", 0);
        seqResponsabilite = jsonInt(pg, "seqResponsabilite", 0);
        seqMachineSim     = jsonInt(pg, "seqMachineSim", 0);
        seqTrace          = (long) jsonDouble(pg, "seqTrace", 0.0);
    }

    // ── 6bis. Profils de normalisation S2.2 ───────────────────────
    normalizationProfiles.clear();
    Object normObj = root.get("normalizationProfiles");
    if (normObj instanceof java.util.List) {
        for (Object no : (java.util.List)normObj) {
            if (!(no instanceof java.util.Map)) continue;
            java.util.Map nm = (java.util.Map)no;
            String code = jsonString(nm,"code","").trim().toUpperCase(java.util.Locale.ROOT);
            if (code.isEmpty()) continue;
            NormalizationProfile np = new NormalizationProfile(
                code, jsonString(nm,"direction","BENEFIT"),
                jsonDouble(nm,"min",0.0), jsonDouble(nm,"max",1.0),
                jsonString(nm,"source","JSON"), jsonString(nm,"version","1.0"));
            normalizationProfiles.put(code,np);
        }
    }
    initialiserProfilsNormalisationDefaut();
    board.logEvent("[S2.2-SCORING] " + normalizationProfiles.size() + " profils bottom/perfect actifs pour score 0..10.");

    // ── 6ter. AHP pairwise ─────────────────────────────────────────
    Object ahpObj = root.get("ahpConfiguration");
    if (ahpObj instanceof java.util.Map) {
        java.util.Map ahp = (java.util.Map)ahpObj;
        ahpConsistencyThreshold = jsonDouble(ahp,"consistencyThreshold",0.10);
        Object sObj = ahp.get("strategic");
        if (sObj instanceof java.util.Map) {
            java.util.Map sm = (java.util.Map)sObj;
            sourceAHPStrategique = jsonString(sm,"source",sourceAHPStrategique);
            ahpStrategiquePairwise = matriceAHPFromJson(sm.get("pairwiseMatrix"),5,ahpStrategiquePairwise);
        }
        Object gObj = ahp.get("bottleneck");
        if (gObj instanceof java.util.Map) {
            java.util.Map gm = (java.util.Map)gObj;
            sourceAHPGoulot = jsonString(gm,"source",sourceAHPGoulot);
            ahpGoulotPairwise = matriceAHPFromJson(gm.get("pairwiseMatrix"),4,ahpGoulotPairwise);
        }
    } else {
        // Legacy : reconstruction cohérente à partir des poids experts déjà présents.
        ahpStrategiquePairwise = matriceAHPDepuisPoids(new double[]{champPoidsRL,champPoidsRS,champPoidsAG,champPoidsCO,champPoidsAM});
    }
    AHPResult ahpS2 = calculerAHP(ahpStrategiquePairwise); // diagnostic historique uniquement
    AHPResult ahpG2 = calculerAHP(ahpGoulotPairwise);      // reste utilise pour les goulots
    dernierCR_AHPStrategique = ahpS2.cr; dernierCR_AHPGoulot = ahpG2.cr;
    double sommePoidsPerf=champPoidsRL+champPoidsRS+champPoidsAG+champPoidsCO+champPoidsAM;
    if(sommePoidsPerf<=0){ champPoidsRL=0.35; champPoidsRS=0.20; champPoidsAG=0.10; champPoidsCO=0.20; champPoidsAM=0.15; sommePoidsPerf=1.0; }
    strategic.w_RL=champPoidsRL/sommePoidsPerf; strategic.w_RS=champPoidsRS/sommePoidsPerf; strategic.w_AG=champPoidsAG/sommePoidsPerf; strategic.w_CO=champPoidsCO/sommePoidsPerf; strategic.w_AM=champPoidsAM/sommePoidsPerf;
    champPoidsRL=strategic.w_RL; champPoidsRS=strategic.w_RS; champPoidsAG=strategic.w_AG; champPoidsCO=strategic.w_CO; champPoidsAM=strategic.w_AM;
    board.logEvent(String.format(java.util.Locale.US,"[AHP] diagnostic only : CR strategic=%.6f ; CR goulot=%.6f ; seuil=%.3f", ahpS2.cr, ahpG2.cr, ahpConsistencyThreshold));
    board.logEvent(String.format(java.util.Locale.US,"[THEERANUPHATTANA-WEIGHTS] JSON : RL=%.4f RS=%.4f AG=%.4f CO=%.4f AM=%.4f | AHP strategic NOT_USED_FOR_PI",strategic.w_RL,strategic.w_RS,strategic.w_AG,strategic.w_CO,strategic.w_AM));
    testerReferenceTheeranuphattana();

    // ── 6quater. Configuration export ABox runtime ────────────────
    Object aboxObj = root.get("aboxExport");
    if (aboxObj instanceof java.util.Map) {
        java.util.Map am = (java.util.Map)aboxObj;
        aboxExportActif = jsonBool(am,"enabled",true);
        aboxExportSurClotureCommande = jsonBool(am,"exportOnOrderClosure",true);
        aboxExportSurArret = jsonBool(am,"exportOnStop",false);
        aboxMaxRawEvents = Math.max(0,jsonInt(am,"maxRawEvents",5000));
    }
    board.logEvent("[S2.2-ABOX] Config : actif="+aboxExportActif+" ; cloture="+aboxExportSurClotureCommande+" ; stop="+aboxExportSurArret+" ; maxEvents="+aboxMaxRawEvents);
        board.logEvent("[S2.2-PERF] C14.3.2 / pipeline final + JSON metier valide + Vue Globale finalisee : VSM -> valeur SCOR reelle -> bottom/perfect -> score 0..10 -> fuzzy A..F -> attributs -> PI actif : CoordinatorAgent > OperationalPilotAgent > OperationalExecutionAgent ; SupervisorAgent legacy non exporte ; IdentityPolicy=ACTOR_SCOPED_OPERATIONAL_V1.");

    // ── 7. Acteurs ─────────────────────────────────────────────────
    Object acteursObj = root.get("acteurs");
    if (acteursObj instanceof java.util.List) {
        for (Object ao : (java.util.List) acteursObj) {
            if (ao instanceof java.util.Map) {
                try { acteursSC.add(acteurFromJson((java.util.Map) ao)); }
                catch (Exception ex) { board.logEvent("[JSON WARN] acteur ignoré : " + ex.getMessage()); }
            }
        }
    }

    // ── 8. Postes — 1re passe : création ───────────────────────────
    java.util.List postesJson = new java.util.ArrayList();
    Object postesObj = root.get("postes");
    if (postesObj instanceof java.util.List) postesJson = (java.util.List) postesObj;

    for (Object po : postesJson) {
        if (!(po instanceof java.util.Map)) continue;
        java.util.Map pm = (java.util.Map) po;
        try {
            PosteGenericAgent p = add_postes();
            p.idPoste = jsonString(pm, "idPoste", "");
            p.nom     = jsonString(pm, "nom", "");
            p.codeSCOR= jsonString(pm, "codeSCOR", "");
            String tpStr = jsonString(pm, "typePoste", "TRAITEMENT");
            try { p.typePoste = TypePoste.valueOf(tpStr); }
            catch (Exception ex) { p.typePoste = TypePoste.DELAI; }
            // LoiTemps
            Object ltObj = pm.get("loiTemps");
            if (ltObj instanceof java.util.Map) {
                java.util.Map lt = (java.util.Map) ltObj;
                String dist = jsonString(lt, "distribution", "uniform");
                double p1   = jsonDouble(lt, "p1", 1.0);
                double p2   = jsonDouble(lt, "p2", 1.0);
                double p3   = jsonDouble(lt, "p3", 1.0);
                p.loiTemps = new LoiTemps(dist, p1, p2);
                p.loiTemps.p3 = p3;
            } else {
                p.loiTemps = new LoiTemps("uniform", 1.0, 1.0);
            }
            p.capaciteSimultanee          = jsonInt(pm, "capaciteSimultanee", 1);
            p.niveauStock                 = jsonDouble(pm, "niveauStock", 0.0);
            p.chainesPrecedents           = jsonString(pm, "chainesPrecedents", "");
            p.estUnPosteAlternatif        = jsonBool(pm, "estUnPosteAlternatif", false);
            p.idActeurResponsable         = jsonString(pm, "idActeurResponsable", "");
            p.nomActeurResponsable        = jsonString(pm, "nomActeurResponsable", "");
            p.categorieActeurResponsable  = jsonString(pm, "categorieActeurResponsable", "");
            p.typeAnnexeActeurResponsable = jsonString(pm, "typeAnnexeActeurResponsable", "");
            // RegleAiguillage
            Object raObj = pm.get("regleAiguillage");
            if (raObj instanceof java.util.Map) {
                java.util.Map ra = (java.util.Map) raObj;
                String tc    = jsonString(ra, "typeControle", "conformite");
                double taux  = jsonDouble(ra, "tauxTrue", 1.0);
                String cible = jsonString(ra, "idCibleEchec", "");
                p.regleAiguillage = new RegleAiguillage(tc, taux, cible.isEmpty() ? null : cible);
            }
            p.niveauISA95              = jsonString(pm, "niveauISA95", "");
            p.politiqueStock           = jsonString(pm, "politiqueStock", "");
            p.tauxVA                   = jsonDouble(pm, "tauxVA", 1.0);
            p.coutHoraireMainOeuvre    = jsonDouble(pm, "coutHoraireMainOeuvre", 0.0);
            p.coutMatierePremiereParUnite = jsonDouble(pm, "coutMatierePremiereParUnite", 0.0);
            p.valeurActifFixe          = jsonDouble(pm, "valeurActifFixe", 0.0);
            p.idsResponsabilites       = jsonStringList(pm, "idsResponsabilites");
            p.idsOperationalAgents     = jsonStringList(pm, "idsOperationalAgents");
            p.idsMachines              = jsonStringList(pm, "idsMachines");

            // Nouveaux champs (génère/attend, batch, jonction multi-amont, position manuelle) —
            // valeurs par défaut = comportement historique si absent du JSON (retro-compatible).
            p.genereAutonome           = jsonBool(pm, "genereAutonome", false);
            p.politiqueApproPoste      = jsonString(pm, "politiqueApproPoste", "");
            p.intervalleApproPoste     = jsonDouble(pm, "intervalleApproPoste", 0.0);
            p.tauxArriveePoissonPoste  = jsonDouble(pm, "tauxArriveePoissonPoste", 0.0);
            p.quantiteParApproPoste    = jsonDouble(pm, "quantiteParApproPoste", 1.0);
            p.attendTousLesPredecesseurs = jsonBool(pm, "attendTousLesPredecesseurs", false);
            int tailleLotJson          = jsonInt(pm, "tailleLot", 1);
            p.tailleLot                = Math.max(1, tailleLotJson);
            if (p.attendTousLesPredecesseurs) {
                int nbParents = 1;
                if (p.chainesPrecedents != null && !p.chainesPrecedents.trim().isEmpty()) {
                    nbParents = Math.max(1, p.chainesPrecedents.split(",").length);
                }
                p.tailleLot = nbParents;
            }
            p.positionManuelle         = jsonBool(pm, "positionManuelle", false);
            p.xManuel                  = jsonDouble(pm, "xManuel", 0.0);
            p.yManuel                  = jsonDouble(pm, "yManuel", 0.0);
            p.estPointEclatement       = jsonBool(pm, "estPointEclatement", false);
            p.consommeMatiere = jsonBool(pm, "consommeMatiere", false);
            p.nbProduitsParLot         = jsonInt(pm, "nbProduitsParLot", 1);
            p.mtbfHeures               = jsonDouble(pm, "mtbfHeures", 0.0);
            p.mttrHeures               = jsonDouble(pm, "mttrHeures", 0.0);

            // Rattacher l'acteur responsable
            ActeurSC aResp = trouverActeurParId(p.idActeurResponsable);
            if (aResp != null) aResp.ajouterMicroActivite(p.idPoste);

            // Positionner
            positionnerPoste(p);

            // Créer le OperationalAgent jumelé (holarchie ADACOR)
            OperationalAgent op = add_opAgents();
            op.initialiser(p, p.codeSCOR);
            if (!p.idsOperationalAgents.contains(op.idAgentLogique)) {
                p.idsOperationalAgents.add(op.idAgentLogique);
            }
            board.logEvent("[JSON-LOAD] Poste créé : " + p.idPoste + " / " + p.nom);

        } catch (Exception ex) {
            board.logEvent("[JSON WARN] poste ignoré : " + ex.getMessage());
        }
    }

    // ── 9. Postes — 2e passe : connexions chainesPrecedents ────────
    // Recherche par idPoste OU par nom (les deux formats sont acceptés)
    for (PosteGenericAgent p : postes) {
        if (p.chainesPrecedents == null || p.chainesPrecedents.trim().isEmpty()) continue;
        String[] parents = p.chainesPrecedents.split(",");
        for (String idParent : parents) {
            idParent = idParent.trim();
            if (idParent.isEmpty()) continue;
            // 1) Recherche par idPoste (format JSON produit par code)
            PosteGenericAgent parent = trouverPosteParNomOuId(idParent);
            if (parent != null) {
                try { connecterPostes(p, parent, estFluxInformationnel(parent, p)); }
                catch (Exception ex) { board.logEvent("[JSON WARN] connexion impossible " + idParent + " -> " + p.idPoste); }
            } else {
                board.logEvent("[JSON WARN] parent introuvable : " + idParent + " pour poste " + p.idPoste);
            }
        }
    }

    // ── 10. Scénarios ───────────────────────────────────────────────
    Object scenObj = root.get("scenarios");
    if (scenObj instanceof java.util.List) {
        for (Object so : (java.util.List) scenObj) {
            if (so instanceof java.util.Map) {
                try { scenarios.add(scenarioFromJson((java.util.Map) so)); }
                catch (Exception ex) { board.logEvent("[JSON WARN] scénario ignoré : " + ex.getMessage()); }
            }
        }
    }

	// ── 10bis. Fiches matière (MRP) ──────────────────────────────────
Object fichesObj = root.get("fichesMatiere");
if (fichesObj instanceof java.util.List) {
    for (Object fo : (java.util.List) fichesObj) {
        if (fo instanceof java.util.Map) {
            java.util.Map fm = (java.util.Map) fo;
            try {
                FicheMatiere f = new FicheMatiere();
                f.idMatiere = jsonString(fm, "idMatiere", "");
                f.stockDisponible = jsonDouble(fm, "stockDisponible", 0.0);
                f.stockInitialConfigure = Math.max(0.0, f.stockDisponible);
                f.stockInitialConfigureDefini = true;
                f.stockSecurite = jsonDouble(fm, "stockSecurite", 0.0);
                f.delaiObtentionHeures = jsonDouble(fm, "delaiObtentionHeures", 0.0);
                f.idFournisseur = jsonString(fm, "idFournisseur", "");
                fichesMatiere.add(f);
            } catch (Exception ex) { board.logEvent("[JSON WARN] fiche matière ignorée : " + ex.getMessage()); }
        }
    }
}
    // ── 11. Responsabilités ─────────────────────────────────────────
    Object respObj = root.get("responsabilites");
    if (respObj instanceof java.util.List) {
        for (Object ro : (java.util.List) respObj) {
            if (!(ro instanceof java.util.Map)) continue;
            try {
                MicroResponsabilite r = responsabiliteFromJson((java.util.Map) ro);
                // Reconstituer liens croisés
                PosteGenericAgent pPoste = trouverPoste(r.idMicroActivite);
                if (pPoste != null) {
                    if (r.nomMicroActivite.isEmpty()) r.nomMicroActivite = pPoste.nom;
                    if (!pPoste.idsResponsabilites.contains(r.idResponsabilite))
                        pPoste.idsResponsabilites.add(r.idResponsabilite);
                }
                ActeurSC aAct = trouverActeurParId(r.idActeur);
                if (aAct != null) {
                    if (r.nomActeur.isEmpty()) r.nomActeur = aAct.nom;
                    if (r.categorieActeur.isEmpty()) r.categorieActeur = aAct.categorie;
                    aAct.ajouterMicroActivite(r.idMicroActivite);
                }
                // Recalcul seqResponsabilite pour éviter doublons
                try {
                    int num = Integer.parseInt(r.idResponsabilite.replace("RESP_", ""));
                    if (num > seqResponsabilite) seqResponsabilite = num;
                } catch (Exception ignore) {}
                responsabilitesMicro.add(r);
            } catch (Exception ex) { board.logEvent("[JSON WARN] responsabilité ignorée : " + ex.getMessage()); }
        }
    }

    // ── 12. Machines ────────────────────────────────────────────────
    Object machObj = root.get("machines");
    if (machObj instanceof java.util.List) {
        for (Object mo : (java.util.List) machObj) {
            if (!(mo instanceof java.util.Map)) continue;
            try {
                MachineSim mac = machineFromJson((java.util.Map) mo);
                PosteGenericAgent pPoste = trouverPoste(mac.idMicroActivite);
                if (pPoste != null) {
                    if (mac.nomMicroActivite.isEmpty()) mac.nomMicroActivite = pPoste.nom;
                    if (!pPoste.idsMachines.contains(mac.idMachine))
                        pPoste.idsMachines.add(mac.idMachine);
                }
                // Recalcul seqMachineSim
                try {
                    int num = Integer.parseInt(mac.idMachine.replace("MAC_", "").replace("MACHINE_", ""));
                    if (num > seqMachineSim) seqMachineSim = num;
                } catch (Exception ignore) {}
                machinesSim.add(mac);
            } catch (Exception ex) { board.logEvent("[JSON WARN] machine ignorée : " + ex.getMessage()); }
        }
    }

    // ── 13. Hiérarchie ISA-95 / équipements ───────────────────────
    Object isaObj = root.get("isa95Hierarchy");
    if (isaObj instanceof java.util.List) {
        for (Object io : (java.util.List) isaObj) {
            if (!(io instanceof java.util.Map)) continue;
            try { isa95Hierarchy.add(isa95NodeFromJson((java.util.Map) io)); }
            catch (Exception ex) { board.logEvent("[JSON WARN] noeud ISA-95 ignore : " + ex.getMessage()); }
        }
    }

    Object isaAssObj = root.get("isa95Assignments");
    if (isaAssObj instanceof java.util.List) {
        for (Object ao : (java.util.List) isaAssObj) {
            if (!(ao instanceof java.util.Map)) continue;
            try { isa95Assignments.add(isa95AssignmentFromJson((java.util.Map) ao)); }
            catch (Exception ex) { board.logEvent("[JSON WARN] affectation ISA-95 ignoree : " + ex.getMessage()); }
        }
    }

    if (!isa95Hierarchy.isEmpty()) {
        String erreursISA95 = validerHierarchieISA95();
        if (erreursISA95 != null && !erreursISA95.trim().isEmpty()) {
            board.logEvent("[ISA95 WARN] Hierarchie chargee avec incoherences : " + erreursISA95.replace("\n", " | "));
            getExperimentHost().showMessageDialog(
                "⚠️ Hiérarchie ISA-95 chargée avec des incohérences :\n\n" + erreursISA95
                + "\nLa simulation métier reste chargeable, mais S2.1/S2.2 doit corriger ces points.");
        } else {
            appliquerAffectationsISA95AuxPostes();
            board.logEvent("[ISA95] Hierarchie valide : " + isa95Hierarchy.size()
                + " noeuds, " + isa95Assignments.size() + " affectations.");
        }
    } else {
        board.logEvent("[ISA95 WARN] Aucun bloc isa95Hierarchy dans le JSON. Compatibilite legacy conservee.");
    }

    // ── 13ter. Relayout topologique global : replace TOUS les postes de
    //    facon coherente (profondeur = colonne, bande = acteur), independamment
    //    de l'ordre de creation. Corrige les postes dessines dans la mauvaise bande.
    relayoutTousLesPostes();

    // ── 13bis. Regroupement operationnel global (1 OA par (acteur, SCOR N3)) ──
    // NECESSAIRE apres un chargement JSON : contrairement a l'ajout manuel d'un
    // scenario via l'UI, le chargement JSON ne fusionnait auparavant JAMAIS les
    // OperationalAgent crees 1 par poste -> corrige ici.
    recalculerTousLesGroupesOperationnels();

    // ── 13. Rafraîchir l'UI ─────────────────────────────────────────
    refreshActeursMicroComboBox();
    refreshMicroActiviteComboBox();
    updateRespMachineFieldsVisibility();
    rafraichirComboPostes();
    rafraichirComboScenarios();
    updateActeurAnnexeVisibility();

    // ETAPE 3.3 -- SECURISATION DU SCENARIO APRES CHARGEMENT JSON.
    // Le JSON ZENER contient plusieurs gammes (dont DELIVER RETURN CLIENT).
    // Si aucune selection explicite n'est faite apres chargement, l'ancien
    // tirage pondere pouvait choisir une gamme sans nomenclature alors que le
    // test exige une reconstitution PF -> Source -> Make. Dans ce cas la
    // commande attendait indefiniment : la politique produit, calculee sur le
    // scenario nominal, ne voyait aucune demande pour ce produit. On fixe donc
    // systématiquement la gamme nominale comme selection PAR DEFAUT juste apres
    // le chargement. L'utilisateur peut toujours changer de scenario ensuite.
    int idxNominalCharge = indexScenarioNominal();
    if (idxNominalCharge >= 0 && idxNominalCharge < scenarios.size()) {
        ScenarioFlux nominalCharge = scenarios.get(idxNominalCharge);
        champScenarioSelectionne = (idxNominalCharge + 1) + ": " + nomScenario(nominalCharge);
        board.logEvent("[SCENARIO] JSON charge : scenario nominal selectionne par defaut = " + champScenarioSelectionne);
    }

    // Reconstruit les stations d'animation (viewAnimation) pour representer
    // les acteurs et postes reels du scenario tout juste charge.
    creerStationsAnimation();
    fluxInfoInitialDejaDeclenche = false;
    declencherFluxInformationInitiale();

    messageStatut = "Config JSON chargée : " + postes.size() +
        " postes, " + scenarios.size() + " scénarios.";
    getExperimentHost().showMessageDialog(
        "✅ Configuration JSON chargée avec succès\n\n"
        + "Fichier : " + fichier + "\n"
        + "Acteurs          : " + acteursSC.size() + "\n"
        + "Micro-activités  : " + postes.size() + "\n"
        + "Responsabilités  : " + responsabilitesMicro.size() + "\n"
        + "Machines         : " + machinesSim.size() + "\n"
        + "Scénarios        : " + scenarios.size() + "\n"
        + "Fiches matière   : " + fichesMatiere.size() + "\n"
        + "Noeuds ISA-95    : " + isa95Hierarchy.size() + "\n"
        + "Affectations ISA : " + isa95Assignments.size() + "\n\n"
        + "Les nomenclatures et stocks matière détaillés du JSON sont conservés.\n"
        + "La sélection d'un scénario ZENER CAS 1/2/3 active automatiquement son profil de stock.\n\n"
        + "Vous pouvez maintenant démarrer la simulation."
    );

} catch (java.io.FileNotFoundException ex) {
    messageStatut = "Fichier JSON introuvable : " + scenarioJsonFileName();
    getExperimentHost().showMessageDialog(
        "❌ Fichier introuvable\n\n" +
        "Fichier attendu : " + scenarioJsonFileName() + "\n\n" +
        "Vérifiez que le fichier existe dans le répertoire de travail d'AnyLogic\n" +
        "(le même dossier que le fichier .alp).");
} catch (Exception ex) {
    messageStatut = "Erreur chargement JSON : " + ex.getMessage();
    getExperimentHost().showMessageDialog(
        "❌ Erreur de chargement JSON\n\n" + ex.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782600000023</Id>
					<Name><![CDATA[migrerConfigCsvVersJson]]></Name>
					<X>-300</X><Y>980</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Migration optionnelle : charge le CSV existant puis sauvegarde en JSON
try {
    chargerConfig();   // Charge depuis le CSV historique
    sauverScenarioJSON(); // Exporte immédiatement en JSON
    messageStatut = "Migration CSV -> JSON réussie : " + scenarioJsonFileName();
    getExperimentHost().showMessageDialog(
        "✅ Migration CSV → JSON terminée\n\n" +
        "Le fichier JSON a été créé : " + scenarioJsonFileName() + "\n" +
        "Vous pouvez maintenant utiliser les boutons JSON.");
} catch (Exception ex) {
    messageStatut = "Erreur migration CSV->JSON : " + ex.getMessage();
    getExperimentHost().showMessageDialog(
        "❌ Erreur lors de la migration CSV → JSON\n\n" + ex.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781183582575</Id>
					<Name><![CDATA[kpiParPosteText]]></Name>
					<X>-300</X><Y>470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {12, 18, 8, 8, 10, 10, 8, 8};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "KPI PAR POSTE — AFFICHAGE DYNAMIQUE",
        w
    ));

    sb.append(tableRow(new String[]{
        "ID Poste",
        "Nom",
        "SCOR",
        "N",
        "Temps traitement moy.",
        "Attente moyenne",
        "File",
        "Efficacité (%)"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (postes.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", "Aucun poste", "-", "0", "0", "0", "0", "0"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    for (PosteGenericAgent p : postes) {
        KPIBundle k = null;

        if (board.kpiParMicroActivite != null) {
            k = board.kpiParMicroActivite.get(p.idPoste);
        }

        if (k == null) {
            k = board.kpiParPoste.get(cleKPI(p));
        }

        long n = k != null ? k.count : 0;
        double ct = k != null ? k.avgCycleTime() : 0;
        double wt = k != null ? k.avgWaitTime() : 0;
        double pce = k != null ? k.pce() * 100 : 0;

        int file = 0;
        try {
            file = p.queue.size();
        } catch (Exception ex) {
            file = 0;
        }

        sb.append(tableRow(new String[]{
            p.idPoste,
            p.nom,
            p.codeSCOR,
            String.valueOf(n),
            fmt2(ct),
            fmt2(wt),
            String.valueOf(file),
            fmt1(pce)
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

    return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781183745912</Id>
					<Name><![CDATA[dernierLogEvenementsText]]></Name>
					<X>-300</X><Y>510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (board == null || board.logEvenements == null || board.logEvenements.isEmpty()) {
    return "Aucun événement enregistré pour le moment.";
}

String log = "";

java.util.List<String> evts = board.logEvenements;

int debut = Math.max(0, evts.size() - 20);

for (int i = debut; i < evts.size(); i++) {
    log += evts.get(i) + "\n";
}

return log;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781184097296</Id>
					<Name><![CDATA[pceGlobalText]]></Name>
					<X>-300</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (board == null || board.kpiZener == null) {
    return "PCE ZENER estime : non disponible";
}

double pce = board.kpiZener.pce() * 100;

String barre = "";

int nb = (int)(pce / 5);

// Sécurité : éviter que nb dépasse 20 si pce > 100
nb = Math.max(0, Math.min(20, nb));

for (int i = 0; i < 20; i++) {
    barre += (i < nb ? "█" : "░");
}

return String.format("PCE ZENER estime : %s %.1f%%", barre, pce);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781900000031</Id>
					<Name><![CDATA[orderLeadTimeText]]></Name>
					<X>-300</X><Y>860</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// C14.4 -- application de l'echelle temps simulation -> temps reel
// (simToRealSeconds) aux cards KPI "metier" (lead time / cycle time / MTS-MTO),
// pour que le temps affiche corresponde a l'echelle definie au demarrage,
// plutot qu'au temps brut de simulation (secondes de discretisation interne).
double mts = board.nbMTS > 0 ? (board.sumLeadTimeMTS / board.nbMTS) / 60.0 : 0;
double mto = board.nbMTO > 0 ? (board.sumLeadTimeMTO / board.nbMTO) / 60.0 : 0;
double glob = board.kpiGlobal.avgLeadTime() / 60.0;
// C14.23 -- lead time scope ZENER : kpiZener.avgLeadTime() = kpiZener.avgCycleTime()
// + kpiZener.avgWaitTime(), c'est-a-dire exactement Process Time(ZENER) + Waiting
// Time(ZENER) puisque les trois cartes lisent le meme bundle. Contrairement au
// "Global" ci-dessus (transversal fournisseur+ZENER+client, mesure de bout en
// bout de la commande), cette ligne referme l'identite VSM Lead Time = Process
// Time + Waiting Time strictement a l'interieur du perimetre ZENER SA Togo.
double zener = board.kpiZener.avgLeadTime() / 60.0;
return "MTS : " + String.format("%.1f", mts) + " min\n"
     + "MTO : " + String.format("%.1f", mto) + " min\n"
     + "Global : " + String.format("%.1f", glob) + " min\n"
     + "ZENER : " + String.format("%.1f", zener) + " min";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781900000032</Id>
					<Name><![CDATA[tauxRemplissagePct]]></Name>
					<X>-300</X><Y>890</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// C14.45 -- BUG CORRIGE : le denominateur melangeait kpiGlobal.count (nombre
// de COMMANDES closes) avec totalRebuts (nombre d'UNITES rejetees). Des que le
// volume produit depassait le nombre de commandes (cas normal : une commande
// de 30 unites = 30 passages aux controles qualite), le taux etait faussement
// gonfle ou ecrase. nbTerminesProduction (unites reellement achevees) est la
// bonne echelle, homogene avec totalRebuts.
long total = nbTerminesProduction + board.totalRebuts;
if (total == 0) return 100;
return nbTerminesProduction * 100.0 / total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781900000033</Id>
					<Name><![CDATA[oeeDisponibilite]]></Name>
					<X>-300</X><Y>920</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// S2.2 C01 : Availability n'est jamais dérivée du rework.
return calculerDisponibiliteMachinesOEE();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781900000034</Id>
					<Name><![CDATA[oeePerformance]]></Name>
					<X>-300</X><Y>950</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[KPIBundle sM = board.kpiParMacro.get("sM");
if (sM == null || sM.avgCycleTime() == 0) return 0;
return Math.min(1.0, makeCycleTime_ref_6kg / sM.avgCycleTime());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781900000035</Id>
					<Name><![CDATA[oeeQualite]]></Name>
					<X>-300</X><Y>980</Y>
					<Label><X>10</X><Y>0</Y></Label>
