				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782940000002</Id>
					<Name><![CDATA[positionnerEntiteSurPoste]]></Name>
					<X>-300</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[poste]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Body><![CDATA[// Positionne instantanement l'entite sur le poste de creation/entree
// et la rend visible dans viewAll (utilise a la creation ou lors d'une
// reprise pour eviter un \"saut\" visuel non justifie).
if (poste == null || e == null) return;
e.setXY(poste.getX(), poste.getY());
e.estVisible = true;
ajouterSuivi("Entree poste", "Arrivee sur une micro-activite", "Flux=" + e.idFlux + " | Poste=" + poste.nom + " | Produit=" + e.typeProduit, "Flux", poste.nom, poste.codeSCOR);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782940000003</Id>
					<Name><![CDATA[deplacerEntiteVersPoste]]></Name>
					<X>-300</X><Y>280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cible]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Body><![CDATA[// Deplacement visuel anime (moveTo AnyLogic) de l'entite vers le poste
// suivant de sa feuille de route. La logique de process (enter.take)
// reste inchangee ; ceci ne pilote que la representation physique.
if (cible == null || e == null) return;
e.estVisible = true;
e.moveTo(cible.getX(), cible.getY());
ajouterSuivi("Deplacement", "Deplacement du produit vers le poste suivant", "Flux=" + e.idFlux + " | Destination=" + cible.nom, "Poste courant", cible.nom, cible.codeSCOR);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782940000004</Id>
					<Name><![CDATA[masquerEntite]]></Name>
					<X>-300</X><Y>290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Body><![CDATA[// Masque l'entite (fin de parcours, rebut, ejection) sans affecter
// sa position courante, au cas ou elle serait reutilisee.
if (e == null) return;
e.estVisible = false;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000060</Id>
					<Name><![CDATA[routerEntite]]></Name>
					<X>-300</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Body><![CDATA[e.etapeCourante++;
String idCible = e.prochainPoste();
if (idCible == null) {
    finDeParcours(e);
    return;
}
PosteGenericAgent cible = trouverPoste(idCible);
if (cible == null) {
    traceln("ERREUR : poste introuvable -> " + idCible);
    finDeParcours(e);
    return;
}
mettreAJourProduitPassage(e, cible);
ajouterSuivi("Micro-activite", "Passage vers une nouvelle etape", "Flux=" + e.idFlux + " | Poste=" + cible.nom + " | Produit=" + e.typeProduit, "Etape precedente", cible.nom, cible.codeSCOR);
// C14.11 -- DIFFUSION AUTOMATIQUE DESACTIVEE (choix utilisateur) : elle
// generait un flux VISUEL_BRANCHE_ vers CHAQUE autre successeur a chaque
// deplacement, ce qui multipliait les compteurs de facon proportionnelle au
// nombre de connexions (sD1.3.4 atteignait 11 passages par commande).
// Seuls subsistent les flux explicites : routes nominales + aller-retours.
// Pour reactiver : positionner diffusionAutomatiqueSuccesseursActive=true.
if (diffusionAutomatiqueSuccesseursActive && !estFluxBranche(e) && e.etapeCourante - 1 >= 0 && e.etapeCourante - 1 < e.feuilleDeRoute.size()) {
    try {
        PosteGenericAgent source = trouverPoste(e.feuilleDeRoute.get(e.etapeCourante - 1));
        if (source != null) envoyerFluxVersAutresSuccesseurs(source, cible);
    } catch (Throwable ignored) {}
}
deplacerEntiteVersPoste(e, cible);
cible.enter.take(e);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PosteGenericAgent]]></ReturnType>
					<Id>1781300000061</Id>
					<Name><![CDATA[trouverPoste]]></Name>
					<X>-300</X><Y>360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[id]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[for (PosteGenericAgent p : postes) {
    if (p.idPoste.equals(id)) return p;
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PosteGenericAgent]]></ReturnType>
					<Id>1782700000099</Id>
					<Name><![CDATA[trouverPosteParNomOuId]]></Name>
					<X>-300</X><Y>365</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ref]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Recherche un poste par son idPoste (priorité) ou par son nom.
// C14.3 : le JSON validé par le chef contient plusieurs libellés bilingues
// du type "(SCOR English Name) Libellé français", alors que certaines cibles
// historiques ne contiennent que le libellé français. On conserve le JSON
// intact et on rend uniquement la résolution de noms tolérante.
if (ref == null || ref.trim().isEmpty()) return null;
String r = ref.trim();

// 1) Par idPoste
for (PosteGenericAgent p : postes) {
    if (p != null && p.idPoste != null && p.idPoste.equals(r)) return p;
}

// 2) Par nom exact
for (PosteGenericAgent p : postes) {
    if (p != null && p.nom != null && p.nom.equalsIgnoreCase(r)) return p;
}

// 3) Par libellé normalisé : suppression des segments entre parenthèses,
// ponctuation de séparation et espaces multiples.
String rn = r.replaceAll("\\([^\\)]*\\)", " ")
             .replaceAll("[\\p{Punct}\\p{Pd}]+", " ")
             .replaceAll("\\s+", " ")
             .trim()
             .toLowerCase(java.util.Locale.ROOT);

for (PosteGenericAgent p : postes) {
    if (p == null || p.nom == null) continue;
    String pn = p.nom.replaceAll("\\([^\\)]*\\)", " ")
                     .replaceAll("[\\p{Punct}\\p{Pd}]+", " ")
                     .replaceAll("\\s+", " ")
                     .trim()
                     .toLowerCase(java.util.Locale.ROOT);
    if (!rn.isEmpty() && (pn.equals(rn) || pn.contains(rn) || rn.contains(pn))) return p;
}
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000062</Id>
					<Name><![CDATA[finDeParcours]]></Name>
					<X>-300</X><Y>420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Body><![CDATA[String idFlux = e == null || e.idFlux == null ? "" : e.idFlux;
double leadTimeProduit = time() - e.tEntreeSysteme;
double waitTime = e.sommeWaitTime;
double vat      = e.sommeVAT;
double pce      = (leadTimeProduit > 0) ? vat / leadTimeProduit : 0;

// Les flux visuels servent uniquement à synchroniser les compteurs natifs de la vue globale
// avec les traces métier. Ils ne doivent pas être comptés comme des commandes terminées
// ni polluer le tableau de suivi utilisateur.
if (estFluxVisuelSeulement(e)) {
    try { masquerEntite(e); } catch (Throwable ignored) {}
    try { remove_fluxEntites(e); } catch (Throwable ignored) {}
    return;
}

ajouterSuivi("Fin de parcours", "Produit termine son parcours", "Flux=" + e.idFlux + " | Type=" + e.typeProduit + " | Délai total=" + String.format("%.1f", leadTimeProduit) + "s", "Processus interne", "Make / Deliver", "FIN");
strategic.piGlobalCourant = strategic.calculerPIGlobal();
board.logEvent("Entite terminee LT=" + String.format("%.1f", leadTimeProduit) + "s efficacité cycle=" + String.format("%.0f", pce*100) + "%");
traceln("=== Entite terminee === LT=" + String.format("%.1f", leadTimeProduit) + "s  efficacité cycle=" + String.format("%.0f%%", pce*100));

// --- Fermeture propre du cycle commande multi-unités ---
// C14.54 -- REGRESSION CORRIGEE. Ce test s'appuyait sur la concatenation de
// typeProduit et idFlux pour retrouver "CMD_x" et fermer le lot. Le correctif
// C14.53 (typeProduit = nom reel du scenario, necessaire pour que la
// consommation de matiere fonctionne) a retire "CMD_x" de typeProduit : le
// test ne matchait donc plus jamais, et aucune commande MTO ne se fermait
// (compteur produitsTerminesParCommandeRuntime jamais incremente). Or idFlux
// seul (ex. "CMD_6_F_32", affecte a la creation de l'entite de production)
// contient DEJA l'identifiant de commande complet : la concatenation avec
// typeProduit etait redondante pour cet usage, on s'appuie desormais
// uniquement sur idFlux, qui ne depend pas de ce que vaut typeProduit.
String refCommandeFlux = idFlux;
// C14.59 -- Les ordres de fabrication autonomes portent un identifiant
// "REAPPRO_x" (et leurs unites "REAPPRO_x_F_n"), qui ne contient pas "CMD_".
// Le filtre ne les reconnaissait donc pas : tout le bloc de cloture etait
// saute pour ces unites, avec deux consequences visibles au tableau de bord :
//   - nbTerminesProduction n'etait jamais incremente -> "Production
//     Throughput" restait a 0 et "Scrap Rate"/"Rework Rate" affichaient "--"
//     alors que la production tournait reellement ;
//   - chaque unite retombait sur le chemin de secours en fin de fonction, qui
//     appelle notifierFin() et incrementait nbMTS a chaque unite -> "Order
//     Mode" affichait des dizaines de commandes alors que le client n'en
//     avait passe que deux ou trois.
if (refCommandeFlux.contains("CMD_") || refCommandeFlux.contains("REAPPRO_")) {
    for (CommandeAgent cmd : commandes) {
        if (cmd == null || cmd.idCommande == null) continue;
        if (("EN_COURS".equals(cmd.statut) || "EN_LIVRAISON".equals(cmd.statut)) && fluxAppartientACommande(refCommandeFlux, cmd.idCommande)) {

            int termines = 1;
            try {
                Integer ancien = produitsTerminesParCommandeRuntime.get(cmd.idCommande);
                termines = (ancien == null ? 0 : ancien.intValue()) + 1;
                produitsTerminesParCommandeRuntime.put(cmd.idCommande, termines);
                nbTerminesProduction++;

                Double waitAncien = sommeWaitProductionParCommandeRuntime.get(cmd.idCommande);
                sommeWaitProductionParCommandeRuntime.put(cmd.idCommande,
                    (waitAncien == null ? 0.0 : waitAncien.doubleValue()) + e.sommeWaitTime);
            } catch (Throwable ignored) {}

            ajouterSuiviDetaille(
                "Production",
                termines < cmd.qte ? "Unite produite en attente du lot complet" : "Lot de production termine",
                termines < cmd.qte
                    ? "Une unite de la commande est terminee, mais la livraison client attend que toutes les unites demandees soient disponibles."
                    : "Toutes les unites de la commande sont terminees. Le modele declenche maintenant la livraison globale du lot.",
                "Agent operationnel de pilotage Make/Deliver",
                "Agent Produit / Order",
                "Commande " + cmd.idCommande,
                "Unites terminees=" + termines + "/" + cmd.qte,
                "Make",
                termines < cmd.qte ? "Attente lot complet" : "Deliver client",
                termines < cmd.qte ? "Produit fini -> regroupement commande" : "Make -> Deliver",
                "M1.6 -> D1.3",
                termines < cmd.qte ? "Attendre les autres unites avant livraison." : "Autoriser la livraison du lot complet.",
                "Production en cours",
                termines < cmd.qte ? "Lot incomplet" : "Lot complet pret a livrer",
                "Progression lot commande ; WIP ; quantite produite"
            );

            cloturerProduitAgent(e, "TERMINE");
            masquerEntite(e);
            remove_fluxEntites(e);

            String aoMProgress = idExecutionCommande("M", 3, cmd);
            String supMProgress = idSuperviseurCommande("M", 1, cmd);
            tracerFluxHierarchique("EXECUTION", aoMProgress, supMProgress, "ExecutionProgress",
                "produit=" + codeProduitCommande(cmd) + ";terminees=" + termines + ";total=" + cmd.qte,
                cmd, "Make", "Progression de la production transmise");

            if (termines < Math.max(1, cmd.qte)) {
                return;
            }

            // C14.55 -- Un ordre de fabrication AUTONOME (reapprovisionnement
            // de stock, sans client) ne doit jamais suivre le chemin de
            // cloture/livraison ci-dessous : il n'y a pas de client a livrer,
            // et tracerFluxHierarchique() referencerait des agents de
            // livraison sans objet. Le stock a deja ete credite naturellement
            // au poste de stockage (sM1.5.1), comme pour toute production :
            // il suffit ici de clore proprement la commande synthetique et de
            // lever la garde anti-doublon.
            if (cmd.idCommande != null && cmd.idCommande.startsWith("REAPPRO_")) {
                cmd.statut = "SERVIE";
                // VSM-FIX-03 -- Make n'utilise pas l'echelle Source/Deliver.
                // Sa duree metier est donc l'ecart simule observe, ajoute une
                // seule fois avant l'imputation aux commandes clientes liees.
                if (cmd.tDebutProduction >= 0) {
                    cmd.dureeReelleAccumulee += Math.max(0.0, time() - cmd.tDebutProduction);
                    cmd.tDebutProduction = -1;
                }
                finaliserDependanceReappro(cmd);
                double stockApresProduction = 0.0;
                try {
                    ScenarioFlux scStock = scenarioPourCommande(cmd);
                    PosteGenericAgent pStock = trouverStockFiniPourScenario(scStock);
                    stockApresProduction = stockFiniDisponiblePourScenario(scStock, pStock);
                } catch (Throwable ignored) {}
                board.logEvent("[STOCK] " + cmd.idCommande + " : production autonome terminee ("
                    + cmd.qte + " unites), stock PF disponible=" + String.format("%.0f", stockApresProduction) + ".");
                // Bloc M.3 -- cmd.statut vient d'etre mis a "SERVIE" ci-dessus :
                // existeReapproOuvert() l'exclut donc deja de son propre calcul.
                // En mono, resultat strictement identique a l'ancien "= false"
                // (un seul REAPPRO possible a la fois). En multi, preserve la
                // garde pour calculerBesoinsNets() si un AUTRE produit a encore
                // un REAPPRO ouvert, au lieu de la lever a tort.
                productionAutonomeEnCours = existeReapproOuvert();

                // ETAPE 3.3 -- reveil immediat des commandes clientes en
                // attente sur le meme produit. Sans cela elles pouvaient
                // patienter jusqu'au prochain retry ANALYSE_STOCK (30 s), ou
                // etre arretees manuellement avant cloture, empechant alors
                // l'export ABox. Le stock est maintenant physiquement credite,
                // donc Deliver peut reserver et poursuivre sans delai inutile.
                java.util.ArrayList<CommandeAgent> aReanalyser = new java.util.ArrayList<CommandeAgent>();
                for (CommandeAgent cAttente : commandes) {
                    if (cAttente == null || cAttente.idCommande == null || cAttente.idCommande.startsWith("REAPPRO_")) continue;
                    if (cmd.idScenario != null && !cmd.idScenario.equals(cAttente.idScenario)) continue;
                    boolean close = "SERVIE".equals(cAttente.statut) || "EN_RETARD".equals(cAttente.statut) || "EN_LIVRAISON".equals(cAttente.statut);
                    if (!close) aReanalyser.add(cAttente);
                }
                for (CommandeAgent cAttente : aReanalyser) analyserStockCommandeOrchestree(cAttente);
                return;
            }

            tracerFluxHierarchique("EXECUTION", aoMProgress, supMProgress, "ExecutionEnd",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
                cmd, "Make", "Toutes les opérations de production sont terminées");

            double leadTimeCommande = Math.max(0.001, time() - cmd.tCreation);
            cmd.statut = (time() <= cmd.tPromise) ? "SERVIE" : "EN_RETARD";

            // C14.46 -- ce chemin de cloture (post-production) est synchrone : il
            // n'appelle jamais planifierAvecEchelle("LIVRAISON_DIRECTE"/
            // "RECEPTION_CLIENT_DIRECTE", ...), contrairement au chemin de
            // livraison directe. Le tronçon Deliver reel manquait donc entierement
            // a cmd.dureeReelleAccumulee pour les commandes MTO/Cas2-3, faisant
            // apparaitre un lead time reel MTO plus court que MTS -- l'inverse de
            // la realite physique. On ajoute ici la meme duree reelle que le
            // chemin direct, sans re-planifier (le deroule visuel de cette
            // livraison est deja gere ailleurs par lancerFluxVisuelDeliverClient).
            double dureeDeliverClientReelle = dureeReelleChaine(new String[]{
                "sD1.5.4","sD1.6.1","sD1.7.1","sD1.8.1","sD1.9.1","sD1.10.1",
                "sD1.11.4","sD1.12.4","sS1.2.4","sS1.3.3"
            });
            cmd.dureeReelleAccumulee += dureeDeliverClientReelle;
            if (!estOrdreReappro(cmd)) cmd.dureeTraitementClientReelleSec += dureeDeliverClientReelle;

            // C14.9 -- meme double comptage que dans
            // finaliserReceptionClientDirecte : enregistrerFinCommandeGlobale()
            // (appelee plus bas) incremente deja MTS/MTO via notifierFin().

            board.logEvent(
                "[DELIVER] " + cmd.idCommande + " -> " + cmd.statut
                + " (LT=" + String.format("%.1f", leadTimeCommande) + "s, qte=" + cmd.qte + ")"
            );
            cloturerOrderDepuisCommande(cmd);

            String supM = idSuperviseurCommande("M", 1, cmd);
            String caM = idCoordinateurCommande("M", cmd);
            // Le tableau Flux global impose ExecutionEnd -> OperationalReport.
            // ProductionCompleted est ensuite émis par CA-Make vers AT-sP3 ;
            // aucun doublon d'exécution ne doit s'intercaler ici.
            tracerFluxHierarchique("REPORT", supM, caM, "OperationalReport",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";production=terminee",
                cmd, "Make", "Résultats Make consolidés");
            tracerFluxHierarchique("REPORT", caM, "AT-sP3", "ProductionCompleted",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
                cmd, "Plan Make", "Produit fini disponible");
            tracerFluxHierarchique("REPORT", "AT-sP3", "AT-sP4", "ProductAvailableForDelivery",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
                cmd, "Plan Make -> Plan Deliver", "Coordination inter-processus tactique");

            String caD = idCoordinateurCommande("D", cmd);
            String supDPlan = idSuperviseurCommande("D", 3, cmd);
            String aoDPlan = idExecutionCommande("D", 8, cmd);
            tracerFluxHierarchique("AMENDMENT", "AT-sP4", caD, "DeliveryPlan",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
                cmd, "Deliver", "Plan de livraison après production");
            tracerFluxHierarchique("AMENDMENT", caD, supDPlan, "DeliveryOrder",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
                cmd, "Deliver", "Ordre transmis au superviseur Deliver");
            tracerFluxHierarchique("AMENDMENT", supDPlan, aoDPlan, "DeliveryTaskAssignment",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
                cmd, "Deliver", "Tâches de préparation/expédition affectées");
            tracerSequencePreparationDeliver(cmd, "apres_production");
            String aoDTransport = idExecutionCommande("D", 12, cmd);
            tracerFluxHierarchique("EXECUTION", aoDTransport, supDPlan, "ExecutionStart",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte
                + ";operation=transport_apres_production",
                cmd, "Deliver", "Transport/livraison démarré après ShipmentOrder");

            enregistrerTraceDeliverApresProduction(cmd);
            lancerFluxVisuelDeliverClient(cmd);

            // C14.18 -- PRELEVEMENT DU STOCK A LA LIVRAISON APRES PRODUCTION.
            // Chaque unite produite traverse sM1.5.1 (type STOCKAGE), qui
            // incremente niveauStock de +1 : le stock fini montait donc a chaque
            // production sans jamais redescendre, puisque seul le chemin
            // "livraison directe depuis stock" (finaliserReceptionClientDirecte)
            // appelait consommerStockFiniProduit(). Les unites fabriquees pour
            // cette commande sont maintenant prelevees au moment ou le lot part
            // en livraison, ce qui equilibre production (+qte) et livraison
            // (-qte) et rend la carte "Stock Fini" coherente dans les deux modes.
            try {
                ScenarioFlux scLivraison = scenarioPourCommande(cmd);
                PosteGenericAgent stockFiniLivraison = trouverStockFiniPourScenario(scLivraison);
                consommerStockFiniProduit(scLivraison, cmd.qte, stockFiniLivraison);
                board.logEvent("[DELIVER] " + cmd.idCommande + " : " + cmd.qte
                    + " unite(s) prelevee(s) du stock fini pour livraison"
                    + (stockFiniLivraison != null
                        ? " (reste " + (int) stockFiniLivraison.niveauStock + ")" : ""));
            } catch (Throwable ignored) {}

            enregistrerFluxSupplyChainMetier(
                "LIVRAISON_PHYSIQUE",
                "ZENER SA Togo",
                "CLIENT GENERIQUE",
                cmd.qte,
                "Livraison physique du lot complet pour " + cmd.idCommande
            );
            enregistrerFluxSupplyChainMetier(
                "RECEPTION_CLIENT",
                "CLIENT GENERIQUE / AO-sS1.2",
                "CLIENT GENERIQUE / AO-sS1.4",
                cmd.qte,
                "Reception et verification du lot complet pour " + cmd.idCommande
            );

            ajouterSuiviDetailleHorodate(
                time() + 26.5,
                "Livraison",
                "Reception finale de la commande par le client",
                "Le client receptionne le lot complet produit. La commande est cloturee ; son statut final depend du respect du delai promis.",
                "Agent operationnel de pilotage Deliver",
                "Agent d'execution D1.12 puis agent client S1.2/S1.3",
                "Commande " + cmd.idCommande,
                "Quantite=" + cmd.qte,
                "ZENER SA Togo / AO-sD1.12",
                "CLIENT GENERIQUE / AO-sS1.2",
                "Manufacturer D1.12 -> Customer S1.2 -> S1.3 -> S1.4",
                "D1.12 -> D1.13 / S1.2 -> S1.3 -> S1.4",
                "Cloturer la livraison et mettre a jour le statut commande.",
                "Lot complet pret a livrer",
                "Commande cloturee : " + cmd.statut,
                "Lead time=" + String.format("%.1f", leadTimeCommande) + "s ; efficacité du cycle=" + String.format("%.0f", pce*100) + "% ; taux de service"
            );

            animerLivraisonVehicule("MANUFACTURER:AO-sD1.12", "CUSTOMER:AO-sS1.2", cmd.qte);
            afficherFluxAnimation("deliveryTruck", "D1.12 -> S1.2", "Manufacturer AO-sD1.12", "Customer AO-sS1.2", "Livraison/cloture de " + cmd.idCommande + " statut=" + cmd.statut + " qte=" + cmd.qte);

            // C14.36 -- Make etant toujours en temps reel, le temps ecoule pendant
            // la production (time() - tDebutProduction) EST deja la vraie duree,
            // sans aucune conversion necessaire : on l'ajoute telle quelle a
            // l'accumulateur pour completer les etapes Source/Deliver/Plan.
            if (cmd.tDebutProduction >= 0) {
                double dureeMakeReelle = Math.max(0.0, time() - cmd.tDebutProduction);
                cmd.dureeReelleAccumulee += dureeMakeReelle;
                if (!estOrdreReappro(cmd)) cmd.dureeTraitementClientReelleSec += dureeMakeReelle;
                cmd.tDebutProduction = -1;
            }

            double waitMoyenCommande = 0.0;
            try {
                Double waitCumule = sommeWaitProductionParCommandeRuntime.get(cmd.idCommande);
                if (waitCumule != null) waitMoyenCommande = waitCumule / Math.max(1, cmd.qte);
                sommeWaitProductionParCommandeRuntime.remove(cmd.idCommande);
            } catch (Throwable ignored) {}

            enregistrerFinCommandeGlobale(
                cmd,
                leadTimeCommande,
                waitMoyenCommande, // C14.21 -- moyenne des files d'attente reellement traversees par les unites du lot
                cmd.qte,
                "Commande produite puis livree avec statut=" + cmd.statut
            );

            String aoDFin = idExecutionCommande("D", 12, cmd);
            String supDFin = idSuperviseurCommande("D", 7, cmd);
            tracerFluxHierarchique("EXECUTION", aoDFin, supDFin, "DeliveryCompleted",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";statut=" + cmd.statut,
                cmd, "Deliver", "Livraison terminée et réception confirmée");
            tracerFluxHierarchique("REPORT", supDFin, caD, "OperationalReport",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";statut=" + cmd.statut,
                cmd, "Deliver", "Résultat opérationnel Deliver consolidé");
            tracerFluxHierarchique("REPORT", caD, "AT-sP4", "ProcessStatusReport",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";statut=" + cmd.statut,
                cmd, "Plan Deliver", "Rapport macro Deliver transmis");
            tracerFluxHierarchique("REPORT", "AT-sP4", "AS-sP1", "MacroProcessReport",
                "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";statut=" + cmd.statut
                + ";delaiTotal=" + String.format(java.util.Locale.US, "%.1f", leadTimeCommande),
                cmd, "Plan Deliver -> Strategic", "Performance finale transmise");

            evaluerRetourClientApresLivraison(cmd);
    if (aboxExportActif && aboxExportSurClotureCommande) {
        String fichierABoxFinal = exporterABoxRuntimeTTL("ORDER_CLOSED_" + cmd.idCommande);
        exporterToutesLesTablesExcel();
        c14SnapshotFinalEffectue = true;
        if(board!=null) board.logEvent(String.format(java.util.Locale.US,
            "[C14-FINAL] Snapshot synchronise cloture commande | PI=%.3f/10 | ABox=%s | Excel=%s | t=%.1fs",
            strategic!=null?strategic.calculerPIGlobal():0.0, fichierABoxFinal, excelFileName(), time()));
    }
            return;
        }
    }
}

// Flux non rattaché à une commande : comportement historique conservé.
// C14.59 -- GARDE DE SECURITE. notifierFin() incremente nbMTS/nbMTO, c'est-a-dire
// les compteurs de COMMANDES du tableau de bord. Une unite de production isolee
// qui atterrit ici (par exemple si son rattachement a la commande a echoue pour
// une raison quelconque) ne doit jamais y etre comptee comme une commande
// cliente : c'est ce qui faisait grimper "Order Mode" a plusieurs dizaines. On
// conserve le comptage d'unites (nbTermines) mais on n'alimente les compteurs
// de commandes que pour des flux qui ne sont pas des unites de production.
boolean estUniteDeProduction = (e.idFlux != null)
    && (e.idFlux.contains("_F_") || e.idFlux.startsWith("REAPPRO_") || e.idFlux.startsWith("PRD_"));
nbTermines++;
nbTerminesParProduit.merge(e.typeProduit, 1L, Long::sum);
if (!estUniteDeProduction && board != null) {
    board.logEvent("[VSM] Flux non rattache a une CMD exclu de kpiGlobal : " + e.idFlux);
}
addTrace(
    "BRUT",
    "System",
    e.idFlux,
    "NON_APPLICABLE",
    "N/A",
    "FIN_PARCOURS",
    "LEAD_TIME",
    leadTimeProduit,
    "s",
    "",
    Double.NaN,
    "",
    "Entite terminee : " + e.typeProduit
);
addTrace(
    "AGG_GLOBAL",
    "BlackboardAgent",
    e.idFlux,
    "NON_APPLICABLE",
    "GLOBAL",
    "GLOBAL_UPDATE",
    "EFFICACITE_CYCLE_GLOBAL",
    pce * 100,
    "%",
    "GLOBAL",
    board.kpiZener.pce() * 100,
    "temps utile / (temps de traitement + temps d’attente)",
    "Mise a jour de l'efficacite globale du cycle"
);
cloturerProduitAgent(e, "TERMINE");
masquerEntite(e);
remove_fluxEntites(e);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000901</Id>
					<Name><![CDATA[genererCommande]]></Name>
					<X>10</X><Y>-610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (!peutGenererNouvelleCommande()) return;

// ETAPE 3.1 : le numero client est indépendant des ordres REAPPRO_* internes.
// On choisit aussi le scénario AVANT de créer la commande afin de pouvoir
// refuser proprement un test retard fournisseur mal configuré.
long n = prochainNumeroCommandeClient();
ScenarioFlux scenarioCommande = modeMultiProduitActif
    ? choisirScenarioProduit(n)
    : choisirScenarioPourCommande();

// ETAPE 3.3 -- GARDE RUN A/B. Pour une campagne controlee d'une seule
// commande avec stock PF initial nul, une gamme sans nomenclature ne peut pas
// reconstituer le stock et conduirait necessairement a une attente infinie.
// On bascule alors automatiquement sur la gamme nominale productible.
boolean runValidationReconstitution = modePilotageParCommande
    && limiterNombreCommandes && nombreCommandesATester == 1
    && quantiteCommandeFixeActive && champStockInitialProduitFini <= 0.0001;
if (runValidationReconstitution
        && (scenarioCommande == null || scenarioCommande.nomenclature == null || scenarioCommande.nomenclature.isEmpty())) {
    int idxNominalRun = indexScenarioNominal();
    if (idxNominalRun >= 0 && idxNominalRun < scenarios.size()) {
        ScenarioFlux avant = scenarioCommande;
        scenarioCommande = scenarios.get(idxNominalRun);
        champScenarioSelectionne = (idxNominalRun + 1) + ": " + nomScenario(scenarioCommande);
        board.logEvent("[RUN A/B][AUTO-CORRECTION] Scenario non productible '"
            + (avant == null ? "<aucun>" : nomScenario(avant))
            + "' remplace par le nominal '" + nomScenario(scenarioCommande) + "'.");
    }
}

if (retardFournisseurTestActif && !scenarioCompatibleRetardFournisseur(scenarioCommande)) {
    String nomSc = scenarioCommande == null ? "<aucun>" : nomScenario(scenarioCommande);
    String msg = "Test retard fournisseur refuse : le scenario selectionne '" + nomSc
        + "' ne consomme pas la matiere cible '" + retardFournisseurCible
        + "'. Chargez/selectionnez le scenario de test avec nomenclature avant de relancer.";
    if (board != null) board.logEvent("[TEST RETARD FOURNISSEUR][CONFIG ERROR] " + msg);
    afficherPopupMetier("Configuration invalide", "Retard fournisseur non testable", msg, "ESSENTIEL");
    return;
}

if (modePilotageParCommande) {
    commandesGenereesDepuisDemarrage++;
}

CommandeAgent cmd = add_commandes();
cmd.idCommande  = "CMD_" + n;
cmd.typeCommande = modeSCORActif();
cmd.qte         = quantitePourNouvelleCommande();
cmd.tCreation   = time();
cmd.tPromise    = time() + delaiPromessePourMode(cmd.typeCommande);
cmd.statut      = "EN_ATTENTE";
// Les entrées « ZENER CAS 1/2/3 » sont des profils d'état initial et non des
// produits/scénarios exécutables. Si l'une d'elles reste sélectionnée dans
// l'interface, la commande est automatiquement rattachée au scénario nominal.
if (scenarioCommande != null && estScenarioCasTest(scenarioCommande)) {
    synchroniserProfilAvecScenarioSelectionne(scenarioCommande);
    int idxNominal = indexScenarioNominal();
    if (idxNominal >= 0 && idxNominal < scenarios.size()) {
        ScenarioFlux nominal = scenarios.get(idxNominal);
        board.logEvent("[PROFIL TEST] " + nomScenario(scenarioCommande)
            + " synchronise avec son profil puis rattache a la gamme nominale " + nomScenario(nominal)
            + " pour " + cmd.idCommande);
        scenarioCommande = nominal;
    }
}
if (scenarioCommande != null) {
    cmd.idScenario = scenarioCommande.typeProduit;
}
enregistrerLigneProduitCommande(cmd, scenarioCommande, cmd.qte);
// Les profils Cas 1/2/3 pilotent uniquement les stocks. Le mode SCOR reste celui choisi au lancement.
cmd.typeCommande = modeSCORActif();

cmd.tPromise = time() + delaiPromessePourMode(cmd.typeCommande);

Order order = creerOuSynchroniserOrder(cmd);

tracerFluxHierarchique("EXECUTION", "CUSTOMER:AOp-sS" + suffixeStrategieCommande(cmd) + ".1", idExecutionCommande("D", 2, cmd),
    "CustomerOrder", "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte
    + ";priorite=" + cmd.priorite + ";strategie=" + cmd.typeCommande,
    cmd, "Deliver", "Commande client reçue par l'exécution Deliver");

ajouterSuiviDetaille(
    "Commande",
    "Emission d'une commande client",
    "Le client generique envoie une commande a ZENER SA Togo.",
    "Agent Order " + cmd.idCommande,
    "Client generique",
    "Commande " + cmd.idCommande,
    "Produit=" + codeProduitCommande(cmd) + " ; Quantite=" + cmd.qte + " ; Strategie=" + cmd.typeCommande,
    "CLIENT GENERIQUE",
    "ZENER SA Togo",
    "Client -> Entreprise focale",
    "D1.1 / D1.2",
    "Transmettre la commande pour reception et validation.",
    "Demande client creee",
    "Commande envoyee",
    "Debut du delai client ; debut du temps de traitement commande"
);

enregistrerFluxSupplyChainMetier(
    "INFO_COMMANDE",
    "CLIENT GENERIQUE",
    "ZENER SA Togo",
    cmd.qte,
    "Commande client emise : " + cmd.idCommande
);

afficherPopupMetier(
    "Commande client",
    "Emission de " + cmd.idCommande,
    "Le client envoie une commande de " + cmd.qte + " unite(s) a ZENER SA Togo.",
    "ESSENTIEL"
);

// C14.3 — flux visuel des activités de planification/réception de commande
// validées dans le JSON collègue. Ce flux est purement visuel.
lancerFluxVisuelCommandeEmission(cmd);

board.logEvent("[DELIVER] Commande " + cmd.idCommande + " type=" + cmd.typeCommande + " qte=" + cmd.qte
    + " | " + (modePilotageParCommande ? ("commande " + commandesGenereesDepuisDemarrage + "/" + (limiterNombreCommandes ? Math.max(1, nombreCommandesATester) : "∞")) : "mode continu"));

afficherFluxAnimation("ORDER", "D1.2 / D2.2", "Customer / Order Agent", "Manufacturer AO-sD1.2", order != null ? order.descriptionFlux() : cmd.idCommande);
// CustomerOrder est déjà animé et journalisé par tracerFluxHierarchique().

// La reception et les decisions suivantes sont decalees dans le temps.
planifierAvecEchelle("RECEPTION_COMMANDE", cmd, dureeReelleChaine(new String[]{"sD1.2.1"}));
planifierProchaineCommandeSiBesoin();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000902</Id>
					<Name><![CDATA[traiterCommande]]></Name>
					<X>10</X><Y>-570</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[cmd]]></Name>
						<Type><![CDATA[CommandeAgent]]></Type>
					</Parameter>
					<Body><![CDATA[if (!modeExecution) return;

Order order = creerOuSynchroniserOrder(cmd);
if (order != null) order.valider(time());

String aoReception = idExecutionCommande("D", 2, cmd);
String supReception = idSuperviseurCommande("D", 1, cmd);
String caDeliver = idCoordinateurCommande("D", cmd);
String supInventory = idSuperviseurCommande("D", 3, cmd);
String aoInventory = idExecutionCommande("D", 8, cmd);
// Tronc commun strict C2 -> C6 du document Flux global :
// OrderReceived -> InventoryCheckRequest -> InventoryAvailabilityResponse
// -> OrderValidated -> OrderFeasibilityRequest.
// Aucun message de validation ne doit précéder la réponse du stock.
tracerFluxHierarchique("REPORT", aoReception, supReception, "OrderReceived",
    "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";controleForme=OK",
    cmd, "Deliver", "Commande enregistrée par l'exécution");
tracerFluxHierarchique("AMENDMENT", supInventory, aoInventory, "InventoryCheckRequest",
    "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";horizonReservation=commande",
    cmd, "Deliver", "Demande d'état de disponibilité du stock");
tracerFluxHierarchique("REPORT", aoInventory, supInventory, "InventoryAvailabilityResponse",
    "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";etatStock=analyse",
    cmd, "Deliver", "Stock physique, stock réservé, ATP et quantité manquante transmis");
tracerFluxHierarchique("REPORT", supReception, caDeliver, "OrderValidated",
    "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";validation=OK;stockAnalyse=OK",
    cmd, "Deliver", "Commande validée après réception de l'état du stock");
tracerFluxHierarchique("REPORT", caDeliver, "AT-sP4", "OrderFeasibilityRequest",
    "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";strategie=" + cmd.typeCommande,
    cmd, "Plan Deliver", "Demande de décision transmise au tactique après validation et analyse du stock");

ajouterSuiviDetaille(
    "Commande",
    "Commande recue, stock analyse puis commande validee",
    "ZENER SA Togo recoit la commande, interroge le stock, attend la reponse de disponibilite puis valide la commande.",
    "Agent operationnel de pilotage Deliver",
    "Agent d'execution D1.2",
    "Commande " + cmd.idCommande,
    "Quantite=" + cmd.qte + " ; Strategie=" + cmd.typeCommande,
    "CLIENT GENERIQUE",
    "ZENER SA Togo",
    "Reception commande -> verification stock -> validation",
    "D1.2 / D1.3",
    "Enregistrer la commande, consulter le stock puis la valider pour décision tactique.",
    "Commande envoyee",
    "Commande validee apres analyse stock",
    "Temps de reception ; temps de consultation stock ; temps de validation ; debut traitement Deliver"
);

enregistrerTraceExecutionCommande(
    cmd,
    "sD1.1.1",
    "D1.1",
    "RECEPTION_VALIDATION_COMMANDE",
    Math.max(0.5, time() - cmd.tCreation),
    0.0,
    cmd.qte,
    "Reception de la commande, consultation du stock, reception de la disponibilite puis validation"
);

afficherPopupMetier(
    "Commande recue",
    cmd.idCommande + " validee par ZENER SA Togo",
    "L'etat de disponibilite du stock a ete recu. La commande validee est transmise au niveau tactique pour selection du scenario.",
    "DETAILLE"
);

ScenarioFlux sc = scenarioPourCommande(cmd);
if (sc != null && (cmd.idScenario == null || cmd.idScenario.trim().isEmpty())) cmd.idScenario = sc.typeProduit;

planifierAvecEchelle("ANALYSE_STOCK", cmd, dureeReelleChaine(new String[]{"sD1.3.4"}));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000008301</Id>
					<Name><![CDATA[lancerProductionCommande]]></Name>
					<X>10</X><Y>-540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[cmd]]></Name>
						<Type><![CDATA[CommandeAgent]]></Type>
					</Parameter>
					<Body><![CDATA[lancerProductionCommandeOrchestree(cmd);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783878397124</Id>
					<Name><![CDATA[ConnectAgents]]></Name>
					<X>-550</X><Y>6550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ============================================================
// FLUX INFORMATIONNELS — TRAITS DISCONTINUS
// Le réseau par défaut "connections" reste bidirectionnel.
// Les flux physiques sont câblés séparément dans ConnectPhysicalFlows().
// ============================================================

// --- SUPPLIER ---
AS_sP1.connectTo(AT_sP4);                 // Manufacturer AS-sP1 <-> Supplier AT-sP4
AT_sP4.connectTo(CA_sD1);
CA_sD1.connectTo(ASup_sD1_1);                 // Superviseur Deliver côté Supplier
ASup_sD1_1.connectTo(AOe_sD1_2_2);              // Exécution Order Management côté Supplier
ASup_sD1_1.connectTo(AOe_sD1_11_supplier);

// --- MANUFACTURER : stratégique et tactique ---
AS_sP1.connectTo(AT_sP2);
AS_sP1.connectTo(AT_sP3);
AS_sP1.connectTo(AT_sP4_2);
AS_sP1.connectTo(AT_sP5);
AS_sP1.connectTo(AT_sP2_2);               // lien vers le Plan Source Customer
AS_sP1.connectTo(AT_sP5_customer);         // lien vers le Plan Return Customer

AT_sP2.connectTo(AT_sP3);
AT_sP3.connectTo(AT_sP4_2);
AT_sP4_2.connectTo(AT_sP5);

// --- MANUFACTURER : Source ---
AT_sP2.connectTo(CA_sS1_2);
CA_sS1_2.connectTo(AOp_sS1_1);
AOp_sS1_1.connectTo(AOe_sS1_2);
AOp_sS1_1.connectTo(AOe_sS1_3);
AOp_sS1_1.connectTo(AOe_sS1_4);
// Liaison informationnelle Manufacturer -> prise en charge de commande Supplier.
AOp_sS1_1.connectTo(AOe_sD1_2_2);

// --- MANUFACTURER : Make ---
AT_sP3.connectTo(CA_sM1);
CA_sM1.connectTo(AOp_sM1_1);
AOp_sM1_1.connectTo(AOe_sM1_2);         // AOe-sM1.2
AOp_sM1_1.connectTo(AOe_sM1_3);
AOp_sM1_1.connectTo(AOe_sM1_4);
AOp_sM1_1.connectTo(AOe_sM1_5);
AOp_sM1_1.connectTo(AOe_sM1_6);
AOp_sM1_1.connectTo(AOe_sM1_7);

// --- MANUFACTURER : Deliver ---
AT_sP4_2.connectTo(CA_sD1_3);
CA_sD1_3.connectTo(AOp_sD1_1);            // conservé : pilotage de sD1.1
AOp_sD1_1.connectTo(AOe_sD1_2);           // saisie/validation de commande
CA_sD1_3.connectTo(ASup_sD1);             // superviseur encapsulant sD1.3 à sD1.7
ASup_sD1.connectTo(AOe_sD1_8_3);
ASup_sD1.connectTo(AOe_sD1_2);

// C14.3.1 — correction validée utilisateur : compléter les flux informationnels
// du superviseur Deliver Manufacturer vers ses opérationnels d'exécution aval.
ASup_sD1.connectTo(AOe_sD1_9_manufacturer);
ASup_sD1.connectTo(AOe_sD1_10_manufacturer);
ASup_sD1.connectTo(AOe_sD1_11_manufacturer);
ASup_sD1.connectTo(AOe_sD1_12_2);
// --- MANUFACTURER : Return ---
AT_sP5.connectTo(CA_sR);
CA_sR.connectTo(ASup_sDR);              // AOp_sDR1_1 représente ASup-sDR
CA_sR.connectTo(ASup_sSR_manufacturer);
ASup_sDR.connectTo(AOe_sDR1_3);         // AOp_sDR1_2 représente AOe-sDR1.3
ASup_sSR_manufacturer.connectTo(AOe_sSR1_1_manufacturer);

// --- CUSTOMER ---
AT_sP2_2.connectTo(CA_sS1_3);
CA_sS1_3.connectTo(AOp_sS1_1_2);          // Pilotage Source côté Customer
AOp_sS1_1_2.connectTo(AOe_sD1_2);         // lien avec AOe-sD1.2 Manufacturer
AOp_sS1_1_2.connectTo(AOe_sS1_2_2);
AOp_sS1_1_2.connectTo(AOe_sS1_3_customer);
AOp_sS1_1_2.connectTo(AOe_sS1_4_4);

AT_sP5_customer.connectTo(CA_sR_2);       // Coordinateur Return côté Customer
CA_sR_2.connectTo(ASup_sSR);           // AOp_sSR1_2 représente ASup-sSR Customer
ASup_sSR.connectTo(AOe_sSR1_1);         // AOp_sSR1_4 représente AOe-sSR1.1
ASup_sSR.connectTo(AOe_sSR1_5);       // AOe_sD1_12_3 représente AOe-sSR1.5
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782000000903</Id>
					<Name><![CDATA[verifierFillRate]]></Name>
					<X>360</X><Y>-90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ETAPE 3.1 : cette fonction historique mesure en pratique la ponctualite
// client (RL.2.2), pas le Fill Rate de production. Le denominateur contient
// uniquement les commandes CLIENTES closes ; REAPPRO_* et commandes ouvertes
// sont exclus.
int closes = 0;
int serviesATemps = 0;
for (CommandeAgent cmd : commandes) {
    if (!estCommandeClient(cmd)) continue;
    if ("SERVIE".equals(cmd.statut) || "EN_RETARD".equals(cmd.statut)) {
        closes++;
        // Le statut est fige au moment de la livraison : ne jamais re-comparer time().
        if ("SERVIE".equals(cmd.statut)) serviesATemps++;
    }
}
if (closes == 0) return Double.NaN;
return (double) serviesATemps / closes;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000301</Id>
					<Name><![CDATA[tauxCommandesConformes]]></Name>
					<X>20</X><Y>-470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Estimation pour RL.3.31 (Compliance / Documentation Accuracy) : faute de donnees
// documentaires reelles dans ce modele, on mesure la part des commandes dont
// le cycle complet s'est termine sans incident de statut (ni EN_ATTENTE bloque,
// ni EN_RETARD). Ne couvre QUE les commandes deja closes (SERVIE ou EN_RETARD) :
// les commandes encore EN_COURS ou EN_ATTENTE sont exclues du denominateur,
// car leur issue n'est pas encore connue.
int closes = 0, conformes = 0;
for (CommandeAgent cmd : commandes) {
    if (!estCommandeClient(cmd)) continue;
    if ("SERVIE".equals(cmd.statut) || "EN_RETARD".equals(cmd.statut)) {
        closes++;
        if ("SERVIE".equals(cmd.statut)) conformes++;
    }
}
if (closes == 0) return Double.NaN; // aucune commande cliente close : donnee non observable
return (double) conformes / closes;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1790000000302</Id>
					<Name><![CDATA[calculerCoutsCumules]]></Name>
					<X>20</X><Y>-440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Cout main d'oeuvre = taux horaire declare x temps de cycle cumule reellement observe sur ce poste
// (sumCycleTime, deja mesure par le Blackboard -- pas une estimation supplementaire).
// Cout matiere = cout/unite declare x nombre d'unites reellement passees par ce poste.
// Si l'utilisateur n'a renseigne aucun cout (valeurs par defaut 0), le resultat est 0 -- jamais invente.
double coutMainOeuvre = 0;
double coutMatiere = 0;

for (PosteGenericAgent p : postes) {
    KPIBundle k = board.kpiParMicroActivite.get(p.idPoste);
    if (k == null) continue;

    double heuresCumulees = k.sumCycleTime / 3600.0;
    coutMainOeuvre += p.coutHoraireMainOeuvre * heuresCumulees;
    coutMatiere    += p.coutMatierePremiereParUnite * k.count;
}

double total = coutMainOeuvre + coutMatiere;
return new double[] { coutMainOeuvre, coutMatiere, total };]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000303</Id>
					<Name><![CDATA[calculerValeurActifsFixes]]></Name>
					<X>20</X><Y>-410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Somme simple des valeurs d'actif fixe declarees poste par poste.
// Reste a 0 si l'utilisateur n'a renseigne aucune valeur (comportement par defaut).
double total = 0;
for (PosteGenericAgent p : postes) total += p.valeurActifFixe;
return total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000304</Id>
					<Name><![CDATA[calculerDisponibiliteMachinesMoyenne]]></Name>
					<X>20</X><Y>-380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Moyenne de la disponibilite theorique (MTBF / (MTBF+MTTR)) de toutes les
// machines logiques actives. disponibiliteTheorique() est deja une formule
// existante sur MachineSim -- on ne fait qu'agreger ce qui est deja calcule.
if (machinesSim == null || machinesSim.isEmpty()) return 1.0; // aucune machine declaree : pas de penalite
double somme = 0; int n = 0;
for (MachineSim m : machinesSim) {
    if (!m.active) continue;
    somme += m.disponibiliteTheorique();
    n++;
}
if (n == 0) return 1.0;
return somme / n;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000305</Id>
					<Name><![CDATA[calculerInventoryDaysOfSupply]]></Name>
					<X>20</X><Y>-350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Jours de stock = stock fini pertinent (stockProduitFiniDisponibleTotal(),
// Bloc M -- deja mono/multi-produit-safe, jamais un double comptage) divise
// par le debit de sortie journalier observe.
// Bloc B.2-FIX -- BUG CONFIRME PAR RUN REEL (ZENER mono et fixture A/B) :
// AM.2.2 retournait 0 malgre un Finished Stock et un debit non nuls dans les
// deux runs. Cause racine identifiee par lecture directe des scenarios JSON :
// le poste produit fini (ex. sM1.5.1 "Transfert vers magasin produits finis")
// est type DELAI dans TOUS les scenarios fournis (ZENER, velo urbain,
// automobile GX5), jamais STOCKAGE -- le filtre `p.typePoste == TypePoste.STOCKAGE`
// ci-dessous ne matchait donc JAMAIS aucun poste, `aDesStocks` restait faux,
// et la fonction retournait 0 avant meme de lire un stock ou un debit. Ce
// n'etait ni une sentinelle "aucune donnee" ni une vraie rupture de stock :
// une mauvaise source de lecture. Corrige en reutilisant
// estPosteStockFini(p) -- le meme predicat que le Bloc M (TypePoste.STOCKAGE
// EN PLUS d'un repli codeSCOR/nom pour les postes DELAI comme M1.5) -- pour
// detecter la presence d'un poste produit fini, et
// stockProduitFiniDisponibleTotal() (Bloc M, deja mono/multi-safe) pour la
// valeur elle-meme, au lieu de resommer manuellement p.niveauStock ici (qui
// aurait pu reintroduire un risque de double comptage multi-produit deja
// corrige ailleurs). Le debit (nbTermines/board.totalTerminees, ci-dessous)
// n'est PAS modifie : la cause demontree du bug est uniquement le filtre de
// stock, pas le debit.
double stockTotal = stockProduitFiniDisponibleTotal();
boolean aDesStocks = false;
for (PosteGenericAgent p : postes) {
    if (estPosteStockFini(p)) { aDesStocks = true; break; }
}
if (!aDesStocks) return 0;

double terminees = nbTermines;
try {
    if (board != null && board.totalTerminees > terminees) terminees = board.totalTerminees;
    if (board != null && board.kpiGlobal != null && board.kpiGlobal.count > terminees) terminees = board.kpiGlobal.count;
} catch (Throwable ignored) {}

double debitJournalier = (time() > 0) ? (terminees * 86400.0 / time()) : 0;
if (debitJournalier <= 0) return 0;

return stockTotal / debitJournalier;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1790000000510</Id>
					<Name><![CDATA[appliquerPoidsAttributsSCOR]]></Name>
					<X>20</X><Y>-320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// C13 — poids de performance configures selon le cadre Theeranuphattana/Chan-Qi.
// L'AHP classique reste disponible pour les decisions/goulots mais ne pilote plus le PI.
double somme = champPoidsRL + champPoidsRS + champPoidsAG + champPoidsCO + champPoidsAM;
if (champPoidsRL < 0 || champPoidsRS < 0 || champPoidsAG < 0 || champPoidsCO < 0 || champPoidsAM < 0 || somme <= 0) {
    messageStatut = "ERREUR poids PI : poids negatifs ou somme nulle.";
    getExperimentHost().showMessageDialog("Poids de performance invalides\n\nLes poids doivent etre >=0 et leur somme >0.");
    return false;
}
// Normalisation automatique a somme 1, conforme au principe de poids normalises.
champPoidsRL/=somme; champPoidsRS/=somme; champPoidsAG/=somme; champPoidsCO/=somme; champPoidsAM/=somme;
strategic.w_RL=champPoidsRL; strategic.w_RS=champPoidsRS; strategic.w_AG=champPoidsAG; strategic.w_CO=champPoidsCO; strategic.w_AM=champPoidsAM;
board.logEvent(String.format(java.util.Locale.US,
    "[THEERANUPHATTANA-WEIGHTS] RL=%.4f RS=%.4f AG=%.4f CO=%.4f AM=%.4f | source=CONFIGURED_EXPERT_INPUT",
    champPoidsRL,champPoidsRS,champPoidsAG,champPoidsCO,champPoidsAM));
messageStatut="Poids PI configures et normalises (Theeranuphattana/Chan-Qi adapte).";
getExperimentHost().showMessageDialog(String.format(java.util.Locale.US,
    "Poids de performance appliques\n\nRL=%.3f  RS=%.3f  AG=%.3f  CO=%.3f  AM=%.3f\nSomme=1.000\n\nAHP strategique non utilise pour le PI.",
    champPoidsRL,champPoidsRS,champPoidsAG,champPoidsCO,champPoidsAM));
return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1790000000630</Id>
					<Name><![CDATA[listeMetriquesN3Disponibles]]></Name>
					<X>20</X><Y>-290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Force un calcul si detailN3 n'a jamais ete rempli (avant le premier
// appel reel a calculerPIGlobal(), par exemple avant le demarrage de la
// simulation). Cette fonction est uniquement de lecture : elle ne modifie
// aucun etat de simulation, seulement le contenu informatif de detailN3.
if (strategic.detailN3.isEmpty()) {
    strategic.calculerPIGlobal();
}

java.util.ArrayList<String> noms = new java.util.ArrayList<String>();
String[] attrs = {"RL", "RS", "AG", "CO", "AM"};
for (String attr : attrs) {
    java.util.ArrayList<MetriqueN3> lst = strategic.detailN3.get(attr);
    if (lst == null) continue;
    for (MetriqueN3 m : lst) {
        if (m.poids > 0) { // seules les metriques scorees (poids > 0) sont pilotables
            noms.add(attr + " | " + m.nom);
        }
    }
}

if (noms.isEmpty()) {
    return new String[] { "(aucune metrique disponible - demarrez la simulation au moins une fois)" };
}
return noms.toArray(new String[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000631</Id>
					<Name><![CDATA[definirPoidsMetriqueN3UI]]></Name>
					<X>20</X><Y>-260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (champMetriqueN3Selectionnee == null || champMetriqueN3Selectionnee.trim().isEmpty()
    || champMetriqueN3Selectionnee.startsWith("(aucune")) {
    messageStatut = "ERREUR : selectionnez une metrique N3 dans la liste.";
    return;
}

if (champPoidsMetriqueN3 < 0) {
    messageStatut = "ERREUR : le poids d'une metrique N3 ne peut pas etre negatif.";
    getExperimentHost().showMessageDialog("⚠️ Poids invalide\n\nLe poids saisi est negatif.");
    return;
}

// champMetriqueN3Selectionnee est au format "ATTR | Nom exact de la metrique"
String[] parts = champMetriqueN3Selectionnee.split(" \\| ", 2);
if (parts.length < 2) {
    messageStatut = "ERREUR : selection de metrique invalide.";
    return;
}
String attr = parts[0].trim();
String nomMetrique = parts[1].trim();

strategic.poidsN3Personnalises.put(nomMetrique, champPoidsMetriqueN3);

// Recalcule immediatement pour que l'effet soit visible, et pour mettre a jour
// la somme des poids affichee a l'utilisateur pour cet attribut.
strategic.calculerPIGlobal();

double sommeAttr = 0;
java.util.ArrayList<MetriqueN3> lst = strategic.detailN3.get(attr);
if (lst != null) {
    for (MetriqueN3 m : lst) sommeAttr += m.poids;
}

board.logEvent(String.format(
    "[CONFIG] Poids N3 personnalise : [%s] %s -> %.3f (somme %s = %.3f)",
    attr, nomMetrique, champPoidsMetriqueN3, attr, sommeAttr));

messageStatut = String.format(
    "Poids applique : [%s] %s = %.3f (somme des poids de %s = %.3f)",
    attr, nomMetrique, champPoidsMetriqueN3, attr, sommeAttr);

String avertissement = "";
if (Math.abs(sommeAttr - 1.0) > 0.01) {
    avertissement = "\n\n⚠️ Note : la somme des poids de l'attribut " + attr
        + " vaut maintenant " + String.format("%.3f", sommeAttr)
        + " (au lieu de 1.000). Le calcul reste mathematiquement valide\n"
        + "(moyenne ponderee normalisee), mais les poids relatifs entre\n"
        + "metriques de cet attribut ne sont plus equilibres autour de 1/N.";
}

getExperimentHost().showMessageDialog(
    "✅ Poids de metrique N3 applique\n\n"
    + "Attribut          : " + attr + "\n"
    + "Metrique          : " + nomMetrique + "\n"
    + "Nouveau poids     : " + String.format("%.3f", champPoidsMetriqueN3) + "\n"
    + "Somme attribut " + attr + " : " + String.format("%.3f", sommeAttr)
    + avertissement
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000632</Id>
					<Name><![CDATA[reinitialiserPoidsN3UI]]></Name>
					<X>20</X><Y>-230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[strategic.poidsN3Personnalises.clear();
strategic.calculerPIGlobal();
board.logEvent("[CONFIG] Poids N3 personnalises reinitialises (retour a 1/N par defaut).");
messageStatut = "Tous les poids N3 ont ete reinitialises a 1/N (egalitaire par attribut).";
getExperimentHost().showMessageDialog("✅ Reinitialisation effectuee\n\nTous les poids de metriques N3 sont revenus a leur valeur par defaut (1/N par attribut).");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1790000000633</Id>
					<Name><![CDATA[rapportPoidsN3Text]]></Name>
					<X>20</X><Y>-200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (strategic.detailN3.isEmpty()) {
    strategic.calculerPIGlobal();
}

StringBuilder sb = new StringBuilder();
sb.append("═══ PONDERATION DETAILLEE DES METRIQUES N3 (par attribut) ═══\n\n");

String[] attrs = {"RL", "RS", "AG", "CO", "AM"};
for (String attr : attrs) {
    java.util.ArrayList<MetriqueN3> lst = strategic.detailN3.get(attr);
    sb.append("── ").append(attr).append(" ──\n");
    if (lst == null || lst.isEmpty()) {
        sb.append("  (aucune metrique)\n\n");
        continue;
    }
    double somme = 0;
    for (MetriqueN3 m : lst) {
        boolean personnalise = strategic.poidsN3Personnalises.containsKey(m.nom);
        sb.append(String.format("  %-55s poids=%.3f%s%s\n",
            m.nom, m.poids,
            m.poids == 0 ? " (informatif, hors score)" : "",
            personnalise ? " [PERSONNALISE]" : ""));
        somme += m.poids;
    }
    sb.append(String.format("  -> Somme des poids scores de cet attribut : %.3f%s\n\n",
        somme, Math.abs(somme - 1.0) > 0.01 && somme > 0 ? "  ⚠️ different de 1.000" : ""));
}

return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000010</Id>
					<Name><![CDATA[rebuter]]></Name>
					<X>-300</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idPosteRebut]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCORPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Ejection definitive d'une entite (rebut)
board.notifierRebut(idPosteRebut, codeSCORPoste);

// C14.60 -- BUG RACINE : la cloture d'un lot (commande normale OU ordre de
// production autonome) attend que "termines" atteigne cmd.qte. Or une unite
// rebutee etait simplement retiree du flux SANS jamais incrementer ce
// compteur : des qu'un seul rebut survenait dans un lot, "termines" restait
// a jamais inferieur a cmd.qte, le lot ne se refermait JAMAIS, et pour un
// ordre autonome REAPPRO_x cela laissait productionAutonomeEnCours bloque a
// vrai pour le reste du run -- plus aucune production suivante, la matiere
// se vidait ensuite normalement sans jamais provoquer de nouvelle production
// pour la consommer davantage, mais plus aucun nouvel ordre ne partait non
// plus puisque la politique produit fini restait bloquee par cette garde.
// On compte desormais l'unite rebutee comme "traitee" pour la cloture du lot
// (elle a bien fini son parcours, meme rejetee) : le rebut continue par
// ailleurs d'etre compte separement via totalRebuts pour les indicateurs
// qualite (Scrap Rate, etc.), qui ne sont pas affectes par ce correctif.
if (e != null && e.idFlux != null) {
    for (CommandeAgent cmdRebut : commandes) {
        if (cmdRebut == null || cmdRebut.idCommande == null) continue;
        if (fluxAppartientACommande(e.idFlux, cmdRebut.idCommande)) {
            Integer ancienR = produitsTerminesParCommandeRuntime.get(cmdRebut.idCommande);
            produitsTerminesParCommandeRuntime.put(cmdRebut.idCommande, (ancienR == null ? 0 : ancienR.intValue()) + 1);
            break;
        }
    }
}

ajouterSuivi("Controle qualite", "Produit rejete", "Flux=" + e.idFlux + " | Poste=" + idPosteRebut, idPosteRebut, "Rebut / sortie", codeSCORPoste);

addTrace(
    "BRUT",
    "Poste/Aiguillage",
    e.idFlux,
    "",
    codeSCORPoste,
    "REBUT",
    "REBUT",
    1,
    "unité",
    "",
    Double.NaN,
    "",
    "Entité éjectée définitivement"
);
masquerEntite(e);
remove_fluxEntites(e);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000011</Id>
					<Name><![CDATA[rerouterRework]]></Name>
					<X>-300</X><Y>840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idCible]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idPosteCourant]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Reprise (rework) : renvoi vers le poste cible, ou repasse le poste courant
board.notifierRework(idPosteCourant);
PosteGenericAgent cible = null;
if (idCible != null && !idCible.isEmpty()) cible = trouverPosteParNomOuId(idCible);
if (cible == null) cible = trouverPosteParNomOuId(idPosteCourant);
if (cible == null) { routerEntite(e); return; }
deplacerEntiteVersPoste(e, cible);
cible.enter.take(e);

//AJOUT 19-06
PosteGenericAgent p = trouverPoste(idPosteCourant);
String code = p != null ? p.codeSCOR : "";

addTrace(
    "BRUT",
    "Poste/Aiguillage:" + idPosteCourant,
    e.idFlux,
    idPosteCourant,
    code,
    "REWORK",
    "REWORK",
    1,
    "unité",
    "",
    Double.NaN,
    "",
    "Reprise vers " + (idCible == null || idCible.isEmpty() ? idPosteCourant : idCible)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1789100001001</Id>
					<Name><![CDATA[routerVersCibleEchec]]></Name>
					<X>-300</X><Y>870</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[FluxEntity]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idCible]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idPosteCourant]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Ejection "fuite" avec transit reel vers le poste cible (ex. SINK de rejet securite),
// au lieu d'une destruction immediate sur place. Le poste cible comptabilise le passage,
// puis se charge lui-meme de detruire l'entite comme un rebut (voir exit.onExit generique).
PosteGenericAgent cible = trouverPosteParNomOuId(idCible);
if (cible == null) {
    // Cible introuvable : repli sur l'ancien comportement (destruction immediate)
    PosteGenericAgent origineFallback = trouverPosteParNomOuId(idPosteCourant);
    rebuter(e, idPosteCourant, origineFallback != null ? cleKPI(origineFallback) : "");
    return;
}
PosteGenericAgent origine = trouverPosteParNomOuId(idPosteCourant);
e.destineeAuRebut = true;
e.codeSCOROrigineRebut = origine != null ? cleKPI(origine) : "";

addTrace(
    "BRUT",
    "Poste/Aiguillage:" + idPosteCourant,
    e.idFlux,
    idPosteCourant,
    e.codeSCOROrigineRebut,
    "EJECTION",
    "EJECTION",
    1,
    "unité",
    "",
    Double.NaN,
    "",
    "Ejection vers " + idCible + " (rejet securite)"
);

// C14.3 — après l'identification du rejet, poursuivre vers le SINK validé
// correspondant à la matière (bouteille, accessoire ou GPL).
java.util.ArrayList<String> routeApresEjection = routeApresEjectionQualite(idPosteCourant, cible.idPoste);
if (routeApresEjection != null && !routeApresEjection.isEmpty()) {
    e.feuilleDeRoute = routeApresEjection;
    e.etapeCourante = 0;
}

deplacerEntiteVersPoste(e, cible);
cible.enter.take(e);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000012</Id>
					<Name><![CDATA[ajouterScenario]]></Name>
					<X>-300</X><Y>550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[typeProduit]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[sequenceCsv]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[debit]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Ajoute un scenario de flux (sequenceCsv = "P1,P2,P4")
ScenarioFlux sc = new ScenarioFlux(typeProduit, debit);
sc.debitParHeureBase = debit;
for (String id : sequenceCsv.split(",")) {
    String t = id.trim();
    if (!t.isEmpty()) sc.sequence.add(t);
}
scenarios.add(sc);
synchroniserListeProduits();
rafraichirComboScenarios();
recalculerTousLesGroupesOperationnels();
board.logEvent("Scenario '" + typeProduit + "' ajoute (" + sc.sequence.size() + " etapes, " + debit + "/h)");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000013</Id>
					<Name><![CDATA[ajouterScenarioUI]]></Name>
					<X>-300</X><Y>600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Validation nom
if (champScenarioNom == null || champScenarioNom.trim().isEmpty()) {
    messageStatut = "ERREUR : nom de scénario obligatoire.";
    getExperimentHost().showMessageDialog(
        "⚠️ Nom de scénario manquant\n\nVeuillez saisir un nom de produit/scénario\navant de valider.");
    return;
}
// Validation séquence
if (champScenarioSeq == null || champScenarioSeq.trim().isEmpty()) {
    messageStatut = "ERREUR : séquence obligatoire.";
    getExperimentHost().showMessageDialog(
        "⚠️ Séquence manquante\n\nSaisissez la séquence de micro-activités séparées par des virgules.\nExemple : sM1.3.1, sM1.4.1, sD1.5.1");
    return;
}
// Validation débit
double d;
try { d = Double.parseDouble(champScenarioDebit.trim()); }
catch (Exception ex) {
    messageStatut = "ERREUR : débit invalide.";
    getExperimentHost().showMessageDialog(
        "⚠️ Débit invalide\n\nLe débit doit être un nombre décimal positif.\nExemple : 60.0 (produits/heure)");
    return;
}
if (d <= 0) {
    messageStatut = "ERREUR : débit doit être > 0.";
    getExperimentHost().showMessageDialog("⚠️ Débit invalide\n\nLe débit doit être strictement positif (> 0).");
    return;
}
// Ajout
ajouterScenario(champScenarioNom.trim(), champScenarioSeq, d);
messageStatut = "Scénario '" + champScenarioNom.trim() + "' ajouté. Total : " + scenarios.size();
getExperimentHost().showMessageDialog(
    "✅ Scénario de flux ajouté\n\n" +
    "Nom/Produit  : " + champScenarioNom.trim() + "\n" +
    "Séquence     : " + champScenarioSeq.trim() + "\n" +
    "Débit        : " + String.format("%.1f", d) + " produits/h\n\n" +
    "Total scénarios configurés : " + scenarios.size() + "\n\n" +
    "💡 Vérifiez que les IDs de micro-activités correspondent\naux postes déjà configurés.");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781500000014</Id>
					<Name><![CDATA[debitTotal]]></Name>
					<X>-300</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Debit total d'entree (somme des scenarios, sinon champDebit global)
if (scenarios.isEmpty()) return champDebit;
double t = 0;
for (ScenarioFlux sc : scenarios) t += sc.debitParHeure;
return t > 0 ? t : champDebit;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000015</Id>
					<Name><![CDATA[sauverConfig]]></Name>
					<X>-300</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
        java.io.PrintWriter pw = new java.io.PrintWriter(
            new java.io.FileWriter("config_" + nomEntreprise + ".csv")
        );

        // 1. Acteurs d'abord
        pw.println("# ACTEUR;idActeur;nom;categorie;typeAnnexe;description;actif;microActivites;delaiPaiementJours");

        for (ActeurSC a : acteursSC) {
            pw.println(
                "ACTEUR;"
                + a.idActeur + ";"
                + a.nom + ";"
                + a.categorie + ";"
                + a.typeAnnexe + ";"
                + a.description + ";"
                + a.actif + ";"
                + a.microActivitesText() + ";"
                + a.delaiPaiementJours + ";"
                + a.modeApproMRP
            );
        }

        // 2. Micro-activités ensuite
        pw.println("# POSTE;id;nom;codeSCOR;type;dist;p1;p2;capacite;idActeurResponsable;nomActeurResponsable;categorieActeurResponsable;typeAnnexeActeurResponsable;ctrlType;tauxTrue;cibleEchec;tauxVA;coutHoraireMainOeuvre;coutMatierePremiereParUnite;valeurActifFixe");

        for (PosteGenericAgent p : postes) {
            String ra = (p.regleAiguillage != null)
                ? p.regleAiguillage.typeControle
                    + ";"
                    + p.regleAiguillage.tauxTrue
                    + ";"
                    + (p.regleAiguillage.idCibleEchec == null ? "" : p.regleAiguillage.idCibleEchec)
                : ";;";

            pw.println(
                "POSTE;"
                + p.idPoste + ";"
                + p.nom + ";"
                + p.codeSCOR + ";"
                + p.typePoste + ";"
                + p.loiTemps.distribution + ";"
                + p.loiTemps.p1 + ";"
                + p.loiTemps.p2 + ";"
                + p.capaciteSimultanee + ";"
                + p.idActeurResponsable + ";"
                + p.nomActeurResponsable + ";"
                + p.categorieActeurResponsable + ";"
                + p.typeAnnexeActeurResponsable + ";"
                + ra + ";"
				+ p.tauxVA + ";"
				+ p.coutHoraireMainOeuvre + ";"
				+ p.coutMatierePremiereParUnite + ";"
				+ p.valeurActifFixe + ";"
				+ p.consommeMatiere
            );
        }

        // 3. Responsabilités hiérarchiques
        pw.println("# RESPONSABILITE;idResponsabilite;idMicroActivite;idActeur;niveau;typeAgent;isTactic;quantite;idsAgents;idsMachines");

        for (MicroResponsabilite r : responsabilitesMicro) {
            pw.println(
                "RESPONSABILITE;"
                + r.idResponsabilite + ";"
                + r.idMicroActivite + ";"
                + r.idActeur + ";"
                + r.niveauHierarchique + ";"
                + r.typeAgent + ";"
                + r.isTactic + ";"
                + r.quantite + ";"
                + r.idsAgentsText() + ";"
                + r.idsMachinesText()
            );
        }

        // 4. Machines logiques
        pw.println("# MACHINE;idMachine;nom;idMicroActivite;idOperationalAgent;type;capacite;cycleTime;mtbf;mttr;active");

        for (MachineSim m : machinesSim) {
            pw.println(
                "MACHINE;"
                + m.idMachine + ";"
                + m.nom + ";"
                + m.idMicroActivite + ";"
                + m.idOperationalAgent + ";"
                + m.type + ";"
                + m.capacite + ";"
                + m.cycleTime + ";"
                + m.mtbf + ";"
                + m.mttr + ";"
                + m.active
            );
        }

        // 5. Scénarios
        for (ScenarioFlux sc : scenarios) {
            pw.println(
                "SCENARIO;"
                + sc.typeProduit + ";"
                + String.join(",", sc.sequence) + ";"
                + sc.debitParHeure
            );
        }

        // 6. Fiches matière (MRP)
        pw.println("# MATIERE;idMatiere;stockDisponible;stockSecurite;delaiObtentionHeures;idFournisseur");
        for (FicheMatiere f : fichesMatiere) {
            pw.println(
                "MATIERE;"
                + f.idMatiere + ";"
                + f.stockDisponible + ";"
                + f.stockSecurite + ";"
                + f.delaiObtentionHeures + ";"
                + f.idFournisseur
            );
        }

        // 7. Nomenclatures (MRP)
        pw.println("# NOMENCLATURE;typeProduit;idMatiere;quantiteParUnite");
        for (ScenarioFlux sc : scenarios) {
            for (LigneNomenclature l : sc.nomenclature) {
                pw.println(
                    "NOMENCLATURE;"
                    + sc.typeProduit + ";"
                    + l.idMatiere + ";"
                    + l.quantiteParUnite
                );
            }
        }

        pw.close();

        messageStatut = "Config sauvée : config_" + nomEntreprise + ".csv";

        getExperimentHost().showMessageDialog(
            "✅ Configuration sauvegardée\n\n"
            + "Fichier : config_" + nomEntreprise + ".csv\n"
            + "Acteurs : " + acteursSC.size() + "\n"
            + "Micro-activités : " + postes.size() + "\n"
            + "Responsabilités : " + responsabilitesMicro.size() + "\n"
            + "Machines : " + machinesSim.size() + "\n"
            + "Scénarios : " + scenarios.size()
        );

    } catch (Exception ex) {
        messageStatut = "Erreur sauvegarde : " + ex.getMessage();

        getExperimentHost().showMessageDialog(
            "❌ Erreur de sauvegarde\n\n" + ex.getMessage()
        );
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000016</Id>
					<Name><![CDATA[chargerConfig]]></Name>
					<X>-300</X><Y>750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Recharge la configuration depuis le fichier CSV de l'entreprise
try {
    java.io.BufferedReader br = new java.io.BufferedReader(
        new java.io.FileReader("config_" + nomEntreprise + ".csv")
    );

	while (opAgents.size() > 0) remove_opAgents(opAgents.get(opAgents.size() - 1));
    // Nettoyage des structures existantes
    while (postes.size() > 0) remove_postes(postes.get(postes.size() - 1));
    scenarios.clear();
	acteursSC.clear();
	responsabilitesMicro.clear();
	machinesSim.clear();
	fichesMatiere.clear();
	isa95Hierarchy.clear();
	isa95Assignments.clear();
    String ligne;
    while ((ligne = br.readLine()) != null) {
        ligne = ligne.trim();
        if (ligne.isEmpty() || ligne.startsWith("#")) continue;

        String[] c = ligne.split(";", -1);
        if (c[0].equals("ACTEUR") && c.length >= 7) {
    ActeurSC a = new ActeurSC();

    a.idActeur = c[1];
    a.nom = c[2];
    a.categorie = c[3];
    a.typeAnnexe = c[4];
    a.description = c[5];
    a.actif = Boolean.parseBoolean(c[6]);
    a.idsMicroActivites = new java.util.ArrayList<String>();

    // delaiPaiementJours : colonne ajoutee ulterieurement, absente des anciens fichiers CSV.
    // Fallback a 30.0 (valeur par defaut neutre de la classe ActeurSC).
    if (c.length >= 9 && !c[8].trim().isEmpty()) {
        try { a.delaiPaiementJours = Math.max(0.0, Double.parseDouble(c[8].trim())); }
        catch (Exception ex) { a.delaiPaiementJours = 30.0; }
    } else {
        a.delaiPaiementJours = 30.0;
    }

    // modeApproMRP : colonne ajoutee ulterieurement (MRP), absente des anciens
    // fichiers CSV. Fallback a false (comportement autonome inchange par defaut).
    if (c.length >= 10 && !c[9].trim().isEmpty()) {
        a.modeApproMRP = Boolean.parseBoolean(c[9].trim());
    } else {
        a.modeApproMRP = false;
    }

    if (c.length >= 8 && c[7] != null && !c[7].equals("-") && !c[7].trim().isEmpty()) {
        String[] ids = c[7].split(",");

        for (String id : ids) {
            if (!id.trim().isEmpty()) {
                a.idsMicroActivites.add(id.trim());
            }
        }
    }

    acteursSC.add(a);
    continue;
}
        if (c[0].equals("POSTE") && c.length >= 9) {
            PosteGenericAgent p = add_postes();
            p.idPoste = c[1];
            p.nom = c[2];
            p.codeSCOR = c[3];
            p.typePoste = TypePoste.valueOf(c[4]);
            p.loiTemps = new LoiTemps(c[5], Double.parseDouble(c[6]), Double.parseDouble(c[7]));
            p.capaciteSimultanee = (int) Double.parseDouble(c[8]);
			if (c.length >= 13) {
    p.idActeurResponsable = c[9];
    p.nomActeurResponsable = c[10];
    p.categorieActeurResponsable = c[11];
    p.typeAnnexeActeurResponsable = c[12];

    ActeurSC a = trouverActeurParId(p.idActeurResponsable);
    if (a != null) {
        a.ajouterMicroActivite(p.idPoste);
    }
}
           if (c.length >= 15 && !c[13].isEmpty()) {
    String cible = (c.length >= 16 && !c[15].isEmpty()) ? c[15] : null;

    p.regleAiguillage = new RegleAiguillage(
        c[13],
        Double.parseDouble(c[14]),
        cible
    );
}

			// tauxVA : colonne ajoutee ulterieurement, absente des anciens fichiers CSV.
			// Fallback a 1.0 (comportement historique : tout le CT est compte comme valeur ajoutee).
			if (c.length >= 17 && !c[16].trim().isEmpty()) {
			    try { p.tauxVA = Math.max(0.0, Math.min(1.0, Double.parseDouble(c[16].trim()))); }
			    catch (Exception ex) { p.tauxVA = 1.0; }
			} else {
			    p.tauxVA = 1.0;
			}

			// coutHoraireMainOeuvre / coutMatierePremiereParUnite / valeurActifFixe :
			// colonnes ajoutees ulterieurement, absentes des anciens fichiers CSV.
			// Fallback a 0.0 (aucune donnee financiere = aucun cout calcule, jamais invente).
			if (c.length >= 18 && !c[17].trim().isEmpty()) {
			    try { p.coutHoraireMainOeuvre = Math.max(0.0, Double.parseDouble(c[17].trim())); }
			    catch (Exception ex) { p.coutHoraireMainOeuvre = 0.0; }
			} else {
			    p.coutHoraireMainOeuvre = 0.0;
			}

			if (c.length >= 19 && !c[18].trim().isEmpty()) {
			    try { p.coutMatierePremiereParUnite = Math.max(0.0, Double.parseDouble(c[18].trim())); }
			    catch (Exception ex) { p.coutMatierePremiereParUnite = 0.0; }
			} else {
			    p.coutMatierePremiereParUnite = 0.0;
			}

			if (c.length >= 20 && !c[19].trim().isEmpty()) {
			    try { p.valeurActifFixe = Math.max(0.0, Double.parseDouble(c[19].trim())); }
			    catch (Exception ex) { p.valeurActifFixe = 0.0; }
			} else {
			    p.valeurActifFixe = 0.0;
			}

			// consommeMatiere : colonne ajoutee ulterieurement (MRP), absente des
			// anciens fichiers CSV. Fallback a false (aucun impact si non renseigne).
			if (c.length >= 21 && !c[20].trim().isEmpty()) {
			    p.consommeMatiere = Boolean.parseBoolean(c[20].trim());
			} else {
			    p.consommeMatiere = false;
			}

            positionnerPoste(p);

            // ── Création du OperationalAgent jumelé (holarchie ADACOR) ──────
            OperationalAgent op = add_opAgents();
            op.initialiser(p, p.codeSCOR);
            board.logEvent("[HOLON] OperationalAgent créé pour " + p.idPoste);
            continue;
        } // <-- fermeture du if POSTE

        if (c[0].equals("RESPONSABILITE") && c.length >= 10) {
            MicroResponsabilite r = new MicroResponsabilite();

            r.idResponsabilite = c[1];
            r.idMicroActivite = c[2];
            r.idActeur = c[3];
            r.niveauHierarchique = c[4];
            r.typeAgent = c[5];
            r.isTactic = Boolean.parseBoolean(c[6]);
            r.quantite = Integer.parseInt(c[7]);

            r.idsAgentsCrees = new java.util.ArrayList<String>();
            if (c[8] != null && !c[8].equals("-") && !c[8].trim().isEmpty()) {
                for (String id : c[8].split(",")) {
                    if (!id.trim().isEmpty()) r.idsAgentsCrees.add(id.trim());
                }
            }

            r.idsMachinesAffectees = new java.util.ArrayList<String>();
            if (c[9] != null && !c[9].equals("-") && !c[9].trim().isEmpty()) {
                for (String id : c[9].split(",")) {
                    if (!id.trim().isEmpty()) r.idsMachinesAffectees.add(id.trim());
                }
            }

            PosteGenericAgent p = trouverPoste(r.idMicroActivite);
            if (p != null && !p.idsResponsabilites.contains(r.idResponsabilite)) {
                p.idsResponsabilites.add(r.idResponsabilite);
                r.nomMicroActivite = p.nom;
            }

            ActeurSC a = trouverActeurParId(r.idActeur);
            if (a != null) {
                r.nomActeur = a.nom;
                r.categorieActeur = a.categorie;
                r.typeAnnexeActeur = a.typeAnnexe;
                a.ajouterMicroActivite(r.idMicroActivite);
            }

            responsabilitesMicro.add(r);
            continue;
        }

        if (c[0].equals("MACHINE") && c.length >= 11) {
            MachineSim m = new MachineSim();

            m.idMachine = c[1];
            m.nom = c[2];
            m.idMicroActivite = c[3];
            m.idOperationalAgent = c[4];
            m.type = c[5];
            m.capacite = Integer.parseInt(c[6]);
            m.cycleTime = Double.parseDouble(c[7]);
            m.mtbf = Double.parseDouble(c[8]);
            m.mttr = Double.parseDouble(c[9]);
            m.active = Boolean.parseBoolean(c[10]);

            PosteGenericAgent p = trouverPoste(m.idMicroActivite);
            if (p != null) {
                m.nomMicroActivite = p.nom;
                if (!p.idsMachines.contains(m.idMachine)) {
                    p.idsMachines.add(m.idMachine);
                }
            }

            machinesSim.add(m);
            continue;
        }

        if (c[0].equals("SCENARIO") && c.length >= 4) {
            ScenarioFlux sc = new ScenarioFlux(c[1], Double.parseDouble(c[3]));

            if (c[2] != null && !c[2].trim().isEmpty()) {
                for (String id : c[2].split(",")) {
                    if (!id.trim().isEmpty()) {
                        sc.sequence.add(id.trim());
                    }
                }
            }

            scenarios.add(sc);
            continue;
        }

        // MATIERE;idMatiere;stockDisponible;stockSecurite;delaiObtentionHeures;idFournisseur
        if (c[0].equals("MATIERE") && c.length >= 5) {
            FicheMatiere f = new FicheMatiere();
            f.idMatiere = c[1];
            try { f.stockDisponible = Double.parseDouble(c[2]); } catch (Exception ex) { f.stockDisponible = 0; }
            f.stockInitialConfigure = Math.max(0.0, f.stockDisponible);
            f.stockInitialConfigureDefini = true;
            try { f.stockSecurite = Double.parseDouble(c[3]); } catch (Exception ex) { f.stockSecurite = 0; }
            try { f.delaiObtentionHeures = Double.parseDouble(c[4]); } catch (Exception ex) { f.delaiObtentionHeures = 0; }
            f.idFournisseur = (c.length >= 6) ? c[5] : "";
            fichesMatiere.add(f);
            continue;
        }

        // NOMENCLATURE;typeProduit;idMatiere;quantiteParUnite
        if (c[0].equals("NOMENCLATURE") && c.length >= 4) {
            for (ScenarioFlux sc : scenarios) {
                if (sc.typeProduit.equalsIgnoreCase(c[1])) {
                    try {
                        sc.nomenclature.add(new LigneNomenclature(c[2], Double.parseDouble(c[3])));
                    } catch (Exception ex) { /* ligne ignoree si quantite invalide */ }
                    break;
                }
            }
            continue;
        }
    }

    br.close();
    refreshActeursMicroComboBox();
    refreshMicroActiviteComboBox();
    updateRespMachineFieldsVisibility();
	rafraichirComboPostes();
	rafraichirComboScenarios();
	updateRespMachineFieldsVisibility();
	updateActeurAnnexeVisibility();
    messageStatut = "Config chargée : " + postes.size() + " micro-activités, " + scenarios.size() + " scénarios.";
getExperimentHost().showMessageDialog(
    "✅ Configuration chargée avec succès\n\n" +
    "Fichier : config_" + nomEntreprise + ".csv\n" +
    "Micro-activités chargées : " + postes.size() + "\n" +
    "Responsabilités chargées : " + responsabilitesMicro.size() + "\n" +
    "Machines chargées        : " + machinesSim.size() + "\n" +
    "Scénarios chargés        : " + scenarios.size() + "\n\n" +
    "Vous pouvez maintenant démarrer la simulation.");
} catch (Exception ex) {
    messageStatut = "Erreur chargement : " + ex.getMessage();
	getExperimentHost().showMessageDialog("❌ Erreur de chargement\n\nFichier attendu : config_" + nomEntreprise + ".csv\n\n" + ex.getMessage());
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782600000001</Id>
					<Name><![CDATA[scenarioJsonFileName]]></Name>
					<X>-300</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Retourne un nom de fichier JSON propre basé sur nomEntreprise
String base = (nomEntreprise == null || nomEntreprise.trim().isEmpty()) ? "scenario" : nomEntreprise.trim();
// Remplacer espaces et caractères dangereux
base = base.replaceAll("[\\s]+", "_")
           .replaceAll("[^a-zA-Z0-9_\\-]", "")
           .replaceAll("_+", "_");
if (base.isEmpty()) base = "scenario";
return "scenario_" + base + ".json";]]></Body>
				</Function>
