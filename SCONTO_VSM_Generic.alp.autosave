					<Body><![CDATA[showJTableDialog(
    "KPI par micro-activité (temps réel)",
    kpiParPosteColumns(),
    kpiParPosteRows(),
    new int[] {90, 180, 70, 60, 90, 90, 60, 80}
);]]></Body>
