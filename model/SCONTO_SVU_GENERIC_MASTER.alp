					<Body><![CDATA[if (messagesAnimes.size() > 0) return;
for (int i = 0; i < TAILLE_POOL_MESSAGES; i++) {
    Movable m = add_messagesAnimes();
    m.libre = true;
    m.type = "";
    m.typeAffiche = "";
    m.nomAffiche = "";
    m.kindMessage = "";
    m.sujetMessageAnime = "";
    m.animationMessageManuelle = false;
    m.animationDebut = 0.0;
    m.animationFin = 0.0;
    m.arriveeAt = -1;
    m.MovableInfo = "";
    m.setXY(-1000, -1000);
}
board.logEvent("[ANIM] Pool de " + TAILLE_POOL_MESSAGES + " messages/véhicules initialisé.");]]></Body>
