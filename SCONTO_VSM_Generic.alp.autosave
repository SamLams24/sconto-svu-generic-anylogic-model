					<Body><![CDATA[return new String[] {
    "Identifiant acteur",
    "Nom de l'acteur",
    "Categorie (Fournisseur/Entreprise focale/Client/Annexe)",
    "Type annexe (si categorie = Acteur annexe)",
    "Description libre",
    "Micro-activites rattachees (IDs)",
    "Actif dans la simulation (Oui/Non)",
