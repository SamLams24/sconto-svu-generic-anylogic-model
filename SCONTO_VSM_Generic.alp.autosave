			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791000009002</Id>
					<Name><![CDATA[stockDisponible]]></Name>
					<X>50</X><Y>320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Stock REELLEMENT engageable : le stock physique moins ce qui est deja
// promis a des commandes acceptees mais pas encore servies.
//
// Sans cette distinction, deux commandes MTS arrivant coup sur coup pouvaient
// toutes deux "voir" le meme stock et etre acceptees, alors qu'une seule
// pouvait reellement etre honoree -- le stock passait alors negatif.
return Math.max(0.0, niveauStock - stockReserve);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000007103</Id>
					<Name><![CDATA[gererPanne]]></Name>
					<X>50</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ============================================================
// SIMULATION DE PANNES (MTBF/MTTR) sur les micro-activites D'EXECUTION.
//
// Seules les activites d'EXECUTION (action physique sur le flux) peuvent
// tomber en panne : planifier/ordonnancer/autoriser (PILOTAGE) ne "tombe pas
// en panne" au sens machine. On reutilise la classification deja en place
// (categoriserActiviteSCOR) pour filtrer automatiquement.
//
// Modele : temps de fonctionnement entre pannes ~ Exponentielle(moyenne=MTBF),
// duree de reparation ~ Exponentielle(moyenne=MTTR). Pendant la panne, la
// capacite du bloc "delay" tombe a 0 (voir CapacityCode du delay) : plus
// aucune nouvelle entite n'entre en traitement, la file s'accumule en amont
// -- consequence directe et realiste, detectee par l'agent operationnel
// comme n'importe quel goulot.
// ============================================================
Main main = (Main) getOwner();
if (main == null) return;
if (mtbfHeures <= 0) return; // pannes non configurees pour ce poste
if (!"EXECUTION".equals(main.categoriserActiviteSCOR(main.codeGroupeL3(codeSCOR), nom))) return;

double t = time();

if (enPanne) {
    if (t >= tFinPanne) {
        double duree = t - tDebutPanneCourante;
        enPanne = false;
        nbPannes++;
        tempsArretCumule += duree;
        main.board.logEvent("[PANNE] " + nom + " (" + idPoste + ") reparee apres "
            + String.format("%.0f", duree / 60.0) + " min. Arret total cumule="
            + String.format("%.1f", tempsArretCumule / 3600.0) + "h.");
        // Prochaine panne
        double moyenneMTBF = mtbfHeures * 3600.0;
        tProchainePanne = t - Math.log(1.0 - main.getDefaultRandomGenerator().nextDouble()) * moyenneMTBF;
    }
    return;
}

if (tProchainePanne < 0) {
    // Amorçage : premiere echeance de panne, tiree des la mise en service du poste.
    double moyenneMTBF = mtbfHeures * 3600.0;
    tProchainePanne = t - Math.log(1.0 - main.getDefaultRandomGenerator().nextDouble()) * moyenneMTBF;
    return;
}

if (t >= tProchainePanne) {
    enPanne = true;
    tDebutPanneCourante = t;
    double moyenneMTTR = Math.max(60.0, mttrHeures * 3600.0);
    double duree = -Math.log(1.0 - main.getDefaultRandomGenerator().nextDouble()) * moyenneMTTR;
    tFinPanne = t + duree;

    main.board.logEvent("[PANNE] " + nom + " (" + idPoste + ") tombe en panne. Reparation estimee dans "
        + String.format("%.0f", duree / 60.0) + " min.");

    // Escalade immediate : l'agent operationnel de ce poste publie une alerte
    // de type panne, au meme titre qu'un goulot, vers le Coordinateur du bon
    // macro-processus (meme canal AER que les goulots).
    OperationalAgent op = main.trouverOperationalParPosteLie(this);
    if (op != null) {
        op.signalerPanne(this, duree);
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781001060375</Id>
					<Name><![CDATA[dureeTraitement]]></Name>
					<X>50</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[switch (typePoste) {
    case DELAI:
    case STOCKAGE:
        if (loiTemps == null) return 0;
        return loiTemps.echantillon(getDefaultRandomGenerator());
    case AIGUILLAGE:
        if (loiTemps == null) return 0;
        return loiTemps.echantillon(getDefaultRandomGenerator());
    case SINK:
        return 0;
    default:
        return 0;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1781648804146</Id>
					<Name><![CDATA[couleurSCOR]]></Name>
					<X>210</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Couleur selon le macro-processus SCOR N3 du code lié
if (codeSCOR == null || codeSCOR.isEmpty()) return new java.awt.Color(0x95A5A6); // Gris
String c = codeSCOR.toUpperCase();
if (c.startsWith("SR"))                    return new java.awt.Color(0xC0392B); // RETURN  — Rouge
if(c.startsWith("DR")) return new java.awt.Color(0xC0392B); 
if (c.startsWith("P"))                     return new java.awt.Color(0x7B5EA7); // PLAN    — Violet
if (c.startsWith("S"))                     return new java.awt.Color(0x2980B9); // SOURCE  — Bleu
if (c.startsWith("M"))                     return new java.awt.Color(0x27AE60); // MAKE    — Vert
if (c.startsWith("D"))  return new java.awt.Color(0xE67E22); // DELIVER — Orange
return new java.awt.Color(0x95A5A6);    ]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781649185736</Id>
					<Name><![CDATA[badgeSCORF]]></Name>
					<X>-90</X><Y>-50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String c = codeSCOR != null ? codeSCOR.toUpperCase() : "";
				if (c.startsWith("SR"))   return "RETURN";
				if (c.startsWith("DR"))   return "RETURN";
				if (c.startsWith("P"))    return "PLAN";
				if (c.startsWith("S"))    return "SOURCE";
				if (c.startsWith("M"))    return "MAKE";
				if (c.startsWith("D"))    return "DELIVER";
				return "?";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791000001001</Id>
					<Name><![CDATA[badgeModeF]]></Name>
					<X>-90</X><Y>-20</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Badge compact resumant le mode d'execution du poste, affiche sur le
// schema : genere ses propres entites / attend une jonction / traite en lot.
StringBuilder b = new StringBuilder();
if (genereAutonome) b.append("G");
if (attendTousLesPredecesseurs) b.append("J").append(tailleLot);
else if (tailleLot > 1) b.append("B").append(tailleLot);
if (positionManuelle) b.append("*");
return b.toString();]]></Body>
				</Function>
			</Functions>
