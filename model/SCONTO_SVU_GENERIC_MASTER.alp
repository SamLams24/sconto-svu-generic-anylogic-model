// Bloc A.4 -- lignes de la feuille "Historique Dashboard". Repli explicite a une
// seule cellule si aucun point n'a encore ete capture (run non demarre, ou pas
// encore de cycle d'export ecoule) : ecrireFeuilleExcel() n'ecrit que
// min(ligne.length, colonnes.length) cellules par ligne, donc aucun crash meme
// avec une ligne plus courte que l'entete.
Object[][] historiqueDashboardRows() {
    if (historiqueDashboard.isEmpty()) {
        return new Object[][] { new Object[] { "Aucun point capte pour ce run (simulation non demarree ou aucun cycle d'export ecoule)" } };
    }
    return historiqueDashboard.toArray(new Object[historiqueDashboard.size()][]);
}

// 6. Delai fournisseur NOMINAL moyen configure dans les fiches matiere.
// Le scenario de perturbation fournisseur conserve cette valeur comme reference
// et decale uniquement la date d'arrivee effective : on peut donc comparer
// nominal, effectif configure et retard effectivement applique.
double delaiFournisseurMoyenHeures() {
    if (fichesMatiere == null || fichesMatiere.isEmpty()) return Double.NaN;
    double somme = 0; int n = 0;
    for (FicheMatiere f : fichesMatiere) {
        if (f == null) continue;
        somme += f.delaiObtentionHeures; n++;
    }
    return n == 0 ? Double.NaN : somme / n;
}

double tempsAttenteGlobalCoherent() {
    if (board == null || board.kpiGlobal == null || board.kpiGlobal.count <= 0) return Double.NaN;
    // VSM-FIX-05 -- wrapper de compatibilite. Aucune reconstruction par PCE.
    double wt = orderWaitingTimeGlobal();
    return (Double.isNaN(wt) || Double.isInfinite(wt)) ? 0.0 : Math.max(0.0, wt);
}

Object[] performanceProduitRow(ScenarioFlux sc) {
    String nom = sc != null ? sc.typeProduit : "";
    String cle = cleProduit(nom);
    int nbCmd = 0, qte = 0, livrees = 0, retard = 0;
    for (CommandeAgent c : commandes) {
        if (!estCommandeClient(c) || !cleProduit(c.idScenario).equals(cle)) continue;
        nbCmd++; qte += Math.max(0, c.qte);
        if ("SERVIE".equals(c.statut) || "EN_RETARD".equals(c.statut)) livrees += Math.max(0, c.qte);
        if ("EN_RETARD".equals(c.statut)) retard++;
    }
    double stock = stockFiniParProduit.containsKey(cle) ? stockFiniParProduit.get(cle) : 0.0;
    return new Object[] {
        nom,
        nbCmd,
        qte,
        livrees,
        retard,
        stock,
        sc != null ? bilanMatierePourScenario(sc, 1) : "Nomenclature absente",
        sc != null && sc.nomenclature != null && !sc.nomenclature.isEmpty()
            ? "Référence enregistrée avec nomenclature"
            : "Référence enregistrée — nomenclature à compléter",
        nbCmd > 0 ? "Observé sur ce run" : "Disponible, non exécuté sur ce run"
    };
}

String[] performanceProduitColumns() {
    return new String[] {
        "Produit enregistré", "Nombre de commandes", "Quantité commandée",
        "Quantité livrée", "Commandes en retard", "Stock fini restant",
        "Nomenclature par unité", "Configuration", "Statut du run"
    };
}

Object[][] performanceProduitRows() {
    synchroniserListeProduits();
    java.util.ArrayList<Object[]> rows = new java.util.ArrayList<Object[]>();
    for (ScenarioFlux sc : listeProduits) rows.add(performanceProduitRow(sc));
    if (rows.isEmpty()) {
        rows.add(new Object[] {"Aucun produit enregistré",0,0,0,0,0,
            "Créer un scénario puis renseigner sa nomenclature",
            "Catalogue vide", "Non exécuté"});
    }
    return rows.toArray(new Object[0][]);
}

Object[][] multiProduitConfigurationRows() {
    synchroniserListeProduits();
    java.util.ArrayList<Object[]> rows = new java.util.ArrayList<Object[]>();
    for (ScenarioFlux sc : listeProduits) {
        String cle = cleProduit(sc.typeProduit);
        Double stock = stockFiniParProduit.get(cle);
        rows.add(new Object[] {
            sc.typeProduit,
            "Défini par l'utilisateur",
            sc.nomenclature == null || sc.nomenclature.isEmpty()
                ? "Aucune matière configurée"
                : bilanMatierePourScenario(sc, 1),
            "ScenarioFlux.nomenclature",
            "MRP, stock, production, livraison et métriques séparés par référence",
            "Enregistré dans Main.listeProduits",
            "Compléter ou modifier la nomenclature depuis la vue dédiée ; aucune modification du code n'est nécessaire."
        });
    }
    if (rows.isEmpty()) {
        rows.add(new Object[] {
            "Aucun produit", "—", "—", "—",
            "Le mode multi-produit attend les références créées par l'utilisateur.",
            "À configurer", "Créer un scénario produit et sa nomenclature."
        });
    }
    return rows.toArray(new Object[0][]);
}

String resumeCatalogueProduits() {
    synchroniserListeProduits();
    int avecNom = 0;
    for (ScenarioFlux sc : listeProduits) {
        if (sc.nomenclature != null && !sc.nomenclature.isEmpty()) avecNom++;
    }
    return listeProduits.size() + " produit(s) enregistré(s), dont " + avecNom + " avec nomenclature";
}

// ============================================================
// REALIGNEMENT DE L'ARCHITECTURE DES AGENTS — GENERATION 1/2
// ============================================================
public static final String ROLE_STRATEGIQUE = "AGENT_STRATEGIQUE";
public static final String ROLE_TACTIQUE = "AGENT_TACTIQUE";
public static final String ROLE_COORDINATEUR = "AGENT_COORDINATEUR";
public static final String ROLE_SUPERVISEUR = "AGENT_OPERATIONNEL_PILOTAGE";
public static final String ROLE_EXECUTION = "AGENT_OPERATIONNEL_EXECUTION";
public static final String ROLE_AUTRE = "AUTRE";

public java.util.ArrayList<OperationalAgent> agentsSuperviseurs = new java.util.ArrayList<OperationalAgent>();
public java.util.ArrayList<OperationalAgent> agentsExecution = new java.util.ArrayList<OperationalAgent>();
public java.util.LinkedHashMap<String, CoordinatorAgent> coordinateursParId =
    new java.util.LinkedHashMap<String, CoordinatorAgent>();

String codeN3Architecture(String code) {
    if (code == null) return "";
    String c = code;
    int sep = c.indexOf('|');
    if (sep >= 0) c = c.substring(sep + 1);
    c = codeGroupeL3(c).trim();
    if (c.startsWith("s") && c.length() > 1) c = c.substring(1);
    return c.toUpperCase(java.util.Locale.ROOT);
}

String macroArchitecture(String code) {
    String c = codeN3Architecture(code);
    if (c.startsWith("SR") || c.startsWith("DR") || c.startsWith("R")) return "sR";
    if (c.startsWith("S")) return "sS";
    if (c.startsWith("M")) return "sM";
    if (c.startsWith("D")) return "sD";
    if (c.startsWith("P2")) return "sS";
    if (c.startsWith("P3")) return "sM";
    if (c.startsWith("P4")) return "sD";
    if (c.startsWith("P5")) return "sR";
    return "";
}

String strategieDepuisCodeSCOR(String code) {
    String c = codeN3Architecture(code);
    if (c.matches("[SMD]1\\..*")) return "MTS";
    if (c.matches("[SMD]2\\..*")) return "MTO";
    if (c.matches("[SMD]3\\..*")) return "ETO";
    if (c.startsWith("SR") || c.startsWith("DR") || c.startsWith("R")) return "TRANSVERSAL";
    return "NON_APPLICABLE";
}

boolean estCodeStrategique(String code) {
    return codeN3Architecture(code).startsWith("P1");
}

boolean estCodeTactique(String code) {
    String c = codeN3Architecture(code);
    return c.startsWith("P2") || c.startsWith("P3") || c.startsWith("P4") || c.startsWith("P5");
}

boolean estCodeSuperviseurSelonArchitecture(String code) {
    String c = codeN3Architecture(code);
    if (c.matches("S[123]\\.1")) return true;
    if (c.matches("M[123]\\.1")) return true;
    if (c.matches("D[123]\\.(1|3|4|5|6|7)")) return true;
    if (c.matches("SR[123]\\.(2|4)")) return true;
    if (c.matches("DR[123]\\.(1|2)")) return true;
    return false;
}

String rolePourCodeSCOR(String code) {
    if (estCodeStrategique(code)) return ROLE_STRATEGIQUE;
    if (estCodeTactique(code)) return ROLE_TACTIQUE;
    if (estCodeSuperviseurSelonArchitecture(code)) return ROLE_SUPERVISEUR;
    String macro = macroArchitecture(code);
    return macro.isEmpty() ? ROLE_AUTRE : ROLE_EXECUTION;
}

String idTactiquePourCodeSCOR(String code) {
    String macro = macroArchitecture(code);
    if ("sS".equals(macro)) return "AT-sP2";
    if ("sM".equals(macro)) return "AT-sP3";
    if ("sD".equals(macro)) return "AT-sP4";
    if ("sR".equals(macro)) return "AT-sP5";
    return "";
}

String idCoordinateurPourCodeSCOR(String code) {
    String macro = macroArchitecture(code);
    if ("sR".equals(macro)) return "CA-sR";
    String strategie = strategieDepuisCodeSCOR(code);
    String suffixe = "MTO".equals(strategie) ? "2" : ("ETO".equals(strategie) ? "3" : "1");
    return macro.isEmpty() ? "" : "CA-" + macro + suffixe;
}

int numeroActiviteArchitecture(String c) {
    int p = c.lastIndexOf('.');
    if (p < 0) return -1;
    try { return Integer.parseInt(c.substring(p + 1)); } catch (Exception ex) { return -1; }
}

String idSuperviseurPourCodeSCOR(String code) {
    String c = codeN3Architecture(code);
    if (c.isEmpty()) return "";
    if (estCodeSuperviseurSelonArchitecture(c)) return "AOp-s" + c;

    if (c.matches("S[123]\\..*")) return "AOp-s" + c.substring(0, 2) + ".1";
    if (c.matches("M[123]\\..*")) return "AOp-s" + c.substring(0, 2) + ".1";

    if (c.matches("D[123]\\..*")) {
        String famille = c.substring(0, 2);
        int a = numeroActiviteArchitecture(c);
        int superviseur = a <= 2 ? 1 : (a == 8 ? 3 : (a == 9 ? 4 : (a == 10 ? 5 : (a == 11 ? 6 : 7))));
        return "AOp-s" + famille + "." + superviseur;
    }

    if (c.matches("SR[123]\\..*")) {
        String famille = c.substring(0, 3);
        int a = numeroActiviteArchitecture(c);
        return "AOp-s" + famille + "." + (a >= 4 ? 4 : 2);
    }
    if (c.matches("DR[123]\\..*")) {
        String famille = c.substring(0, 3);
        int a = numeroActiviteArchitecture(c);
        return "AOp-s" + famille + "." + (a <= 1 ? 1 : 2);
    }
    return "";
}

CoordinatorAgent trouverCoordinateurParId(String id) {
    if (id == null || id.isEmpty()) return null;
    CoordinatorAgent c = coordinateursParId.get(id);
    if (c != null) return c;
    for (CoordinatorAgent x : supervisorsMacro) {
        if (id.equals(x.idAgentCoordinateur)) return x;
    }
    return null;
}

void realignerArchitectureAgents() {
    agentsSuperviseurs.clear();
    agentsExecution.clear();
    coordinateursParId.clear();

    for (CoordinatorAgent c : supervisorsMacro) {
        if (c == null || c.idAgentCoordinateur == null || c.idAgentCoordinateur.isEmpty()) continue;
        coordinateursParId.put(c.idAgentCoordinateur, c);
    }

    for (OperationalAgent op : opAgents) {
        if (op == null) continue;
        PosteGenericAgent p = (op.postesLies != null && !op.postesLies.isEmpty()) ? op.postesLies.get(0) : null;
        String code = p != null ? p.codeSCOR : op.codeSCOR;
        String role = rolePourCodeSCOR(code);
        op.roleHolonique = role;
        op.strategieRealisation = strategieDepuisCodeSCOR(code);
        op.idTactiqueRattache = idTactiquePourCodeSCOR(code);
        op.idCoordinateurRattache = idCoordinateurPourCodeSCOR(code);
        op.idSuperviseurRattache = idSuperviseurPourCodeSCOR(code);
        op.idRoleHierarchique = ROLE_SUPERVISEUR.equals(role)
            ? op.idSuperviseurRattache
            : (ROLE_EXECUTION.equals(role) ? "AOe-s" + codeN3Architecture(code) : role);
        op.categorieOP = ROLE_SUPERVISEUR.equals(role) ? "PILOTAGE"
            : (ROLE_EXECUTION.equals(role) ? "EXECUTION"
            : (ROLE_TACTIQUE.equals(role) ? "TACTIQUE"
            : (ROLE_STRATEGIQUE.equals(role) ? "STRATEGIQUE" : "AUTRE")));

        if (ROLE_SUPERVISEUR.equals(role)) agentsSuperviseurs.add(op);
        else if (ROLE_EXECUTION.equals(role)) agentsExecution.add(op);
    }

    if (board != null) {
        board.logEvent("[ARCHITECTURE] Réalignement terminé : "
            + coordinateursParId.size() + " coordinateur(s), "
            + agentsSuperviseurs.size() + " superviseur(s), "
            + agentsExecution.size() + " agent(s) d'exécution.");
    }
}

String[] architectureAgentsColumns() {
    return new String[] {
        "Niveau", "Identifiant logique", "Processus / poste", "Stratégie",
        "Agent parent", "Agent enfant / responsabilité", "Statut d'alignement"
    };
}

Object[][] architectureAgentsRows() {
    realignerArchitectureAgents();
    java.util.ArrayList<Object[]> rows = new java.util.ArrayList<Object[]>();
    rows.add(new Object[] {"STRATÉGIQUE", "AS-sP1", "sP1 et composantes P1.x",
        "Toutes", "—", "AT-sP2 / AT-sP3 / AT-sP4 / AT-sP5", "Aligné"});

    for (TacticalAgent t : tacticals) {
        rows.add(new Object[] {"TACTIQUE", "AT-" + t.monCodeSCOR,
            t.monCodeSCOR + " — " + libelleMacroProcessusSCOR(t.idMacroProcessus),
            "Toutes", "AS-sP1", "Coordinateurs " + t.idMacroProcessus, "Aligné"});
    }
    for (CoordinatorAgent c : supervisorsMacro) {
        rows.add(new Object[] {"COORDINATION", c.idAgentCoordinateur,
            c.monCodeSCOR, c.strategieRealisation,
            idTactiquePourCodeSCOR(c.monCodeSCOR), "Superviseurs du processus " + c.monCodeSCOR,
            "Instance CoordinatorAgent"});
    }
    for (OperationalAgent op : agentsSuperviseurs) {
        rows.add(new Object[] {"PILOTAGE OPÉRATIONNEL", op.idRoleHierarchique,
            op.libelleAffichage, op.strategieRealisation,
            op.idCoordinateurRattache, "Organiser, déclencher, surveiller et coordonner",
            "Classé selon la liste validée"});
    }
    for (OperationalAgent op : agentsExecution) {
        rows.add(new Object[] {"EXÉCUTION OPÉRATIONNELLE", op.idRoleHierarchique,
            op.libelleAffichage, op.strategieRealisation,
            op.idSuperviseurRattache, "Réaliser l'activité SCOR concrète",
            "Tout processus non superviseur"});
    }
    rows.add(new Object[] {"AUTRES", "MachineAgent / ProductAgent / OrderAgent",
        "Ressource, produit et commande", "Transversal", "Selon le flux",
        "Porter capacité, trajectoire produit et objectif commande", "Conservé"});
    return rows.toArray(new Object[0][]);
}

// ============================================================
// REALIGNEMENT DES COMMUNICATIONS ET FLUX — GENERATION 2/2
// Hiérarchie stricte : stratégique <-> tactique <-> coordinateur
// <-> agent opérationnel de pilotage/superviseur <-> exécution.
// Les échanges inter-processus restent exclusivement tactiques.
// ============================================================
public boolean realignementFluxHierarchiqueActif = true;
public int sequenceFluxHierarchique = 0;

String suffixeStrategieCommande(CommandeAgent cmd) {
    String mode = cmd != null && cmd.typeCommande != null && !cmd.typeCommande.trim().isEmpty()
        ? cmd.typeCommande.trim().toUpperCase(java.util.Locale.ROOT)
        : modeSCORActif();
    if ("ETO".equals(mode)) return "3";
    if ("MTO".equals(mode)) return "2";
    return "1";
}

String idCoordinateurCommande(String macro, CommandeAgent cmd) {
    String m = macro == null ? "" : macro.trim().toUpperCase(java.util.Locale.ROOT);
    if ("R".equals(m)) return "CA-sR";
    return "CA-s" + m + suffixeStrategieCommande(cmd);
}

String idSuperviseurCommande(String macro, int activite, CommandeAgent cmd) {
    String m = macro == null ? "" : macro.trim().toUpperCase(java.util.Locale.ROOT);
    return "AOp-s" + m + suffixeStrategieCommande(cmd) + "." + Math.max(1, activite);
}

String idExecutionCommande(String macro, int activite, CommandeAgent cmd) {
    String m = macro == null ? "" : macro.trim().toUpperCase(java.util.Locale.ROOT);
    return "AOe-s" + m + suffixeStrategieCommande(cmd) + "." + Math.max(1, activite);
}

TacticalAgent trouverTactiqueParRole(String id) {
    if (id == null) return null;
    for (TacticalAgent t : tacticals) {
        if (t != null && id.equals("AT-" + t.monCodeSCOR)) return t;
    }
    return null;
}

OperationalAgent trouverOperationalParIdentifiant(String id) {
    if (id == null || id.trim().isEmpty()) return null;
    OperationalAgent secours = null;
    for (OperationalAgent op : opAgents) {
        if (op == null) continue;
        if (id.equals(op.idPoste)) return op;
        if (id.equals(op.idRoleHierarchique)) {
            if (op.libelleAffichage != null && op.libelleAffichage.contains("[ZEN]")) return op;
            if (secours == null) secours = op;
        }
    }
    return secours;
}

String valeurChampMessage(String contenu, String cle) {
    if (contenu == null || cle == null) return "";
    for (String part : contenu.split(";")) {
        if (part == null) continue;
        String p = part.trim();
        String prefixe = cle + "=";
        if (p.startsWith(prefixe)) return p.substring(prefixe.length()).trim();
    }
    return "";
}

double doubleChampMessage(String contenu, String cle, double defaut) {
    try { String v = valeurChampMessage(contenu, cle); return v.isEmpty() ? defaut : Double.parseDouble(v); }
    catch (Throwable ex) { return defaut; }
}

int intChampMessage(String contenu, String cle, int defaut) {
    try { String v = valeurChampMessage(contenu, cle); return v.isEmpty() ? defaut : Integer.parseInt(v); }
    catch (Throwable ex) { return defaut; }
}

void distribuerMessageHierarchique(AERMessage msg) {
    if (msg == null || msg.destinataire == null) return;
    String d = msg.destinataire;
    try {
        if ("AS-sP1".equals(d) || "STRATEGIC".equals(d)) {
            strategic.recevoirMessageHierarchique(msg);
            return;
        }
        if (d.startsWith("AT-")) {
            TacticalAgent t = trouverTactiqueParRole(d);
            if (t != null) t.recevoirMessageHierarchique(msg);
            return;
        }
        if (d.startsWith("CA-")) {
            CoordinatorAgent c = trouverCoordinateurParId(d);
            if (c != null) c.recevoirMessageHierarchique(msg);
            return;
        }
        if (d.startsWith("AOp-") || d.startsWith("AOe-") || d.startsWith("ACT_")) {
            OperationalAgent op = trouverOperationalParIdentifiant(d);
            if (op != null) op.recevoirMessageHierarchique(msg);
        }
    } catch (Throwable ex) {
        if (board != null) board.logEvent("[FLUX-HIER WARN] Distribution impossible vers " + d + " : " + ex.getMessage());
    }
}

void tracerFluxHierarchique(String phase, String emetteur, String destinataire,
                            String sujet, String contenu, CommandeAgent cmd,
                            String processus, String statut) {
    if (!realignementFluxHierarchiqueActif || board == null) return;
    String p = phase == null ? AERMessage.REPORT : phase.toUpperCase(java.util.Locale.ROOT);
    String type = p.startsWith("AMEND") ? AERMessage.AMENDMENT
        : (p.startsWith("EXEC") ? AERMessage.EXECUTION : AERMessage.REPORT);
    String idCmd = cmd != null && cmd.idCommande != null ? cmd.idCommande : "";
    String c = (contenu == null ? "" : contenu)
        + (idCmd.isEmpty() ? "" : ";commande=" + idCmd)
        + ";sequence=" + (++sequenceFluxHierarchique);
    AERMessage msg = new AERMessage(type, emetteur, destinataire, sujet, c, time());
    board.journaliserFluxHierarchique(msg, idCmd, processus, statut);
    board.journaliserAER("FLUX_HIERARCHIQUE_" + type, msg,
        "Communication runtime distribuée à une instance réelle ; processus=" + processus + "; statut=" + statut);
    distribuerMessageHierarchique(msg);
    board.logEvent("[FLUX-HIER] " + msg.toString());
    emettreFluxInformationnelAnime(emetteur, destinataire, sujet,
        "[" + type + "] " + (statut == null ? "" : statut)
        + (contenu == null || contenu.trim().isEmpty() ? "" : " | " + contenu));
}

void propagerAlertesAERHierarchiques() {
    if (!realignementFluxHierarchiqueActif || board == null || board.alertesPubliees == null || board.alertesPubliees.isEmpty()) return;
    java.util.ArrayList<AERMessage> snapshot = new java.util.ArrayList<AERMessage>(board.alertesPubliees);
    java.util.ArrayList<AERMessage> traitees = new java.util.ArrayList<AERMessage>();
    java.util.ArrayList<AERMessage> suivantes = new java.util.ArrayList<AERMessage>();

    for (AERMessage msg : snapshot) {
        if (msg == null || msg.destinataire == null) continue;
        String d = msg.destinataire;
        boolean traite = false;

        if (d.startsWith("AOp-")) {
            OperationalAgent sup = trouverOperationalParIdentifiant(d);
            if (sup != null) sup.recevoirMessageHierarchique(msg);
            if (AERMessage.AMENDMENT.equals(msg.type)) {
                board.journaliserAER("SUPERVISION_AMENDMENT", msg,
                    "Instruction tactique relayée au superviseur " + d);
                String poste = valeurChampMessage(msg.contenu, "poste");
                if (!poste.isEmpty()) {
                    suivantes.add(new AERMessage(AERMessage.AMENDMENT, d, poste,
                        "OperationalInstruction", msg.contenu, time()));
                }
            } else if (AERMessage.EXECUTION.equals(msg.type)) {
                board.journaliserAER("SUPERVISION_ACK", msg,
                    "Accusé opérationnel reçu par le superviseur " + d);
                String ca = sup != null ? sup.idCoordinateurRattache : valeurChampMessage(msg.contenu, "coordinateur");
                if (!ca.isEmpty()) suivantes.add(new AERMessage(AERMessage.EXECUTION, d, ca,
                    "OperationalAcknowledgement", msg.contenu, time()));
            } else {
                board.journaliserAER("SUPERVISION_RECEPTION", msg,
                    "Rapport opérationnel reçu par le superviseur " + d);
                String ca = sup != null ? sup.idCoordinateurRattache : valeurChampMessage(msg.contenu, "coordinateur");
                if (!ca.isEmpty()) suivantes.add(new AERMessage(AERMessage.REPORT, d, ca,
                    "OperationalException", msg.contenu + ";superviseur=" + d, time()));
            }
            traite = true;
        } else if (d.startsWith("CA-")) {
            CoordinatorAgent ca = trouverCoordinateurParId(d);
            if (ca != null) ca.recevoirMessageHierarchique(msg);
            if (AERMessage.AMENDMENT.equals(msg.type)) {
                board.journaliserAER("COORDINATEUR_AMENDMENT", msg,
                    "Décision tactique reçue et contextualisée par " + d);
                String sup = valeurChampMessage(msg.contenu, "superviseur");
                String poste = valeurChampMessage(msg.contenu, "poste");
                if (sup.isEmpty() && !poste.isEmpty()) {
                    OperationalAgent cible = trouverOperationalParIdentifiant(poste);
                    if (cible != null) sup = cible.idSuperviseurRattache;
                }
                if (!sup.isEmpty()) suivantes.add(new AERMessage(AERMessage.AMENDMENT, d, sup,
                    "SupervisorInstruction", msg.contenu + ";coordinateur=" + d, time()));
            } else if (AERMessage.EXECUTION.equals(msg.type)) {
                board.journaliserAER("COORDINATEUR_ACK", msg,
                    "Accusé consolidé par le coordinateur " + d);
                String at = idTactiquePourCodeSCOR(ca != null ? ca.monCodeSCOR : d);
                if (!at.isEmpty()) suivantes.add(new AERMessage(AERMessage.EXECUTION, d, at,
                    "ProcessAcknowledgement", msg.contenu, time()));
            } else {
                board.journaliserAER("COORDINATEUR_RECEPTION", msg,
                    "Rapport du superviseur consolidé par le coordinateur " + d);
                String at = idTactiquePourCodeSCOR(ca != null ? ca.monCodeSCOR : d);
                if (!at.isEmpty()) suivantes.add(new AERMessage(AERMessage.REPORT, d, at,
                    "ProcessDeviationReport", msg.contenu + ";coordinateur=" + d, time()));
            }
            traite = true;
        } else if (d.startsWith("AT-")) {
            TacticalAgent tac = trouverTactiqueParRole(d);
            if (tac != null) tac.recevoirMessageHierarchique(msg);
            if (AERMessage.EXECUTION.equals(msg.type)) {
                board.journaliserAER("TACTIQUE_ACK", msg,
                    "Accusé final reçu par le niveau tactique " + d);
            } else {
                board.journaliserAER("TACTIQUE_RECEPTION", msg,
                    "Rapport macro-processus reçu par le niveau tactique " + d);
                String poste = valeurChampMessage(msg.contenu, "poste");
                String sup = valeurChampMessage(msg.contenu, "superviseur");
                String caId = msg.emetteur != null && msg.emetteur.startsWith("CA-") ? msg.emetteur
                    : valeurChampMessage(msg.contenu, "coordinateur");
                double wt = doubleChampMessage(msg.contenu, "WT", 0.0);
                int file = intChampMessage(msg.contenu, "file", 0);
                PosteGenericAgent p = trouverPoste(poste);
                String code = p != null ? p.codeSCOR : "";
                CoordinatorAgent ca = trouverCoordinateurParId(caId);
                double score = ca != null ? ca.scorerGoulotAHP(poste, wt, file, code) : Math.min(1.0, wt / 60.0);
                AERMessage decision = new AERMessage(AERMessage.AMENDMENT, d, caId,
                    "PriorityDecision",
                    msg.contenu + ";poste=" + poste + ";superviseur=" + sup
                    + ";action=REBALANCE;scoreAHP=" + String.format(java.util.Locale.US, "%.3f", score), time());
                board.journaliserAER("TACTIQUE_DECISION_AHP", decision,
                    "Arbitrage AHP réalisé au niveau tactique sans saut hiérarchique ; score="
                    + String.format(java.util.Locale.US, "%.3f", score));
                board.journaliserAER("TACTIQUE_ESCALADE", decision,
                    "Décision tactique renvoyée au coordinateur " + caId);
                if (!caId.isEmpty()) suivantes.add(decision);
            }
            traite = true;
        } else {
            OperationalAgent op = trouverOperationalParIdentifiant(d);
            if (op != null && AERMessage.AMENDMENT.equals(msg.type)) {
                op.recevoirMessageHierarchique(msg);
                op.seuilGoulotWT = Math.max(8.0, op.seuilGoulotWT * 0.80);
                board.journaliserAER("OPERATIONNEL_APPLICATION", msg,
                    "Décision appliquée par l'agent d'exécution " + d
                    + " ; nouveau seuil=" + String.format(java.util.Locale.US, "%.1f", op.seuilGoulotWT));
                String sup = op.idSuperviseurRattache;
                AERMessage ack = new AERMessage(AERMessage.EXECUTION, d, sup,
                    "ACK_REBALANCE", msg.contenu + ";application=OK", time());
                board.journaliserAER("OPERATIONNEL_ACK_EXECUTION", ack,
                    "Accusé émis par l'agent d'exécution après application");
                if (sup != null && !sup.isEmpty()) suivantes.add(ack);
                traite = true;
            }
        }

        if (traite) traitees.add(msg);
    }

    board.alertesPubliees.removeAll(traitees);
    for (AERMessage n : suivantes) board.publierAlerte(n);
}

String[] fluxHierarchiqueColumns() {
    return new String[] {
        "Horodatage simulé", "Commande", "Phase AER", "Émetteur réel",
        "Destinataire réel", "Message", "Contenu", "Processus SCOR",
        "Statut / preuve de réception", "Contrôle hiérarchique"
    };
}

Object[][] fluxHierarchiqueRows() {
    java.util.ArrayList<Object[]> rows = new java.util.ArrayList<Object[]>();
    if (board == null || board.journalFluxHierarchique == null || board.journalFluxHierarchique.isEmpty()) {
        rows.add(new Object[] {"-", "-", "-", "-", "-", "Aucun flux normal observé",
            "Lancer un Cas 1, 2 ou 3", "-", "Non exécuté", "Aucun mock exporté"});
        return rows.toArray(new Object[0][]);
    }
    for (String raw : board.journalFluxHierarchique) {
        if (raw == null) continue;
        String[] p = raw.split("\\t", -1);
        if (p.length < 9) continue;
        String controle = controleLienHierarchique(p[3], p[4]);
        rows.add(new Object[] {"T=" + p[0] + "s", p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8], controle});
    }
    return rows.toArray(new Object[0][]);
}

String controleLienHierarchique(String src, String dst) {
    if (src == null || dst == null) return "À vérifier";
    if (src.startsWith("AT-") && dst.startsWith("AT-")) return "Conforme — coordination inter-processus au niveau tactique";
    int a = niveauHierarchiqueAgent(src);
    int b = niveauHierarchiqueAgent(dst);
    if (a < 0 || b < 0) return "Flux externe / transversal";
    return Math.abs(a - b) == 1 ? "Conforme — niveaux adjacents" : "ANOMALIE — saut hiérarchique";
}

int niveauHierarchiqueAgent(String id) {
    if (id == null) return -1;
    if (id.startsWith("AS-sP1") || id.equals("STRATEGIC")) return 1;
    if (id.startsWith("AT-")) return 2;
    if (id.startsWith("CA-")) return 3;
    if (id.startsWith("AOp-")) return 4;
    if (id.startsWith("AOe-") || id.startsWith("ACT_")) return 5;
    return -1;
}


// ============================================================
// MODE SCOR DE LA SIMULATION ET IDENTITE VISUELLE DES AGENTS
// Le choix est effectué au lancement, avant le bouton Demarrer.
// Un seul mode peut être actif à la fois.
// ============================================================
public boolean isMTS = true;
public boolean isMTO = false;
public boolean isETO = false;
public String modeSimulationSCOR = "MTS";

int indiceModeSCOR() {
    if (isETO) return 3;
    if (isMTO) return 2;
    return 1;
}

String modeSCORActif() {
    return isETO ? "ETO" : (isMTO ? "MTO" : "MTS");
}

double delaiPromessePourMode(String mode) {
    if ("ETO".equalsIgnoreCase(mode)) return 3600.0;
    if ("MTO".equalsIgnoreCase(mode)) return 1800.0;
    return 300.0;
}

void appliquerModeSimulationSCOR(String mode) {
    String m = mode == null ? "MTS" : mode.trim().toUpperCase(java.util.Locale.ROOT);
    if (!"MTO".equals(m) && !"ETO".equals(m)) m = "MTS";
    isMTS = "MTS".equals(m);
    isMTO = "MTO".equals(m);
    isETO = "ETO".equals(m);
    modeSimulationSCOR = m;
    mettreAJourIdentitesMovablesSelonMode();
    if (board != null) board.logEvent("[MODE SCOR] Mode sélectionné=" + modeSimulationSCOR
        + " | isMTS=" + isMTS + " | isMTO=" + isMTO + " | isETO=" + isETO);
}

void choisirModeSimulationAuLancement() {
    final String[] modes = {"MTS — Make/Source/Deliver Stocked Product (occurrence 1)",
                            "MTO — Make/Source/Deliver to Order (occurrence 2)",
                            "ETO — Engineer to Order (occurrence 3)"};
    try {
        javax.swing.JComboBox<String> combo = new javax.swing.JComboBox<String>(modes);
        combo.setSelectedIndex(0);
        javax.swing.JPanel panel = new javax.swing.JPanel(new java.awt.BorderLayout(0, 8));
        panel.add(new javax.swing.JLabel(
            "Choisissez le mode SCOR à simuler. Ce choix détermine les familles S/M/D 1, 2 ou 3 et les noms des agents animés."),
            java.awt.BorderLayout.NORTH);
        panel.add(combo, java.awt.BorderLayout.CENTER);

        javax.swing.JOptionPane pane = new javax.swing.JOptionPane(
            panel,
            javax.swing.JOptionPane.QUESTION_MESSAGE,
            javax.swing.JOptionPane.OK_CANCEL_OPTION
        );
        java.awt.Window owner = java.awt.KeyboardFocusManager.getCurrentKeyboardFocusManager().getActiveWindow();
        javax.swing.JDialog dialog = owner != null
            ? pane.createDialog(owner, "Mode de simulation SCOR")
            : pane.createDialog("Mode de simulation SCOR");
        dialog.setModal(true);
        dialog.setAlwaysOnTop(true);
        dialog.setLocationRelativeTo(owner);
        dialog.setVisible(true);
        Object valeur = pane.getValue();
        boolean ok = valeur instanceof Integer
            && ((Integer) valeur).intValue() == javax.swing.JOptionPane.OK_OPTION;
        int choix = ok ? combo.getSelectedIndex() : 0;
        appliquerModeSimulationSCOR(choix == 2 ? "ETO" : (choix == 1 ? "MTO" : "MTS"));
    } catch (Throwable ex) {
        appliquerModeSimulationSCOR("MTS");
        if (board != null) board.logEvent("[MODE SCOR] Dialogue indisponible, MTS appliqué par défaut : " + ex.getMessage());
    }
}

boolean estCodePilotageAnimation(String codeAvecPrefixeS) {
    if (codeAvecPrefixeS == null) return false;
    String c = codeAvecPrefixeS.trim().toUpperCase(java.util.Locale.ROOT);
    return c.matches("SS[123]\\.1")
        || c.matches("SM[123]\\.1")
        || c.matches("SD[123]\\.(1|3|4|5|6|7)")
        || c.matches("SSR[123]\\.(2|4)")
        || c.matches("SDR[123]\\.(1|2)");
}

String remplacerOccurrenceModeAnimation(String codeAvecPrefixeS) {
    if (codeAvecPrefixeS == null) return "";
    String c = codeAvecPrefixeS.toUpperCase(java.util.Locale.ROOT);
    String n = String.valueOf(indiceModeSCOR());
    c = c.replaceFirst("^(SS|SM|SD)([123])(?=\\.|$)", "$1" + n);
    c = c.replaceFirst("^(SSR|SDR)([123])(?=\\.|$)", "$1" + n);
    return c;
}

String normaliserIdentifiantAgentAnimation(String identifiant) {
    if (identifiant == null) return "";
    String id = identifiant.trim().toUpperCase(java.util.Locale.ROOT);
    String domaine = "";
    int p = id.lastIndexOf(':');
    if (p >= 0) {
        domaine = id.substring(0, p + 1);
        id = id.substring(p + 1);
    }
    String suffixeSpecial = "";
    int u = id.indexOf('_');
    if (u >= 0) {
        suffixeSpecial = id.substring(u);
        id = id.substring(0, u);
    }

    String n = String.valueOf(indiceModeSCOR());

    // Anciens macro-superviseurs Source/Make devenus coordinateurs.
    if (id.matches("ASUP-SS[123]")) id = "CA-SS" + n;
    else if (id.matches("ASUP-SM[123]")) id = "CA-SM" + n;
    else if (id.equals("ASUP-SR")) id = "CA-SR";

    // ASup-sDx est désormais le véritable superviseur Deliver unique.
    if (id.matches("ASUP-SD[123]")) id = "ASUP-SD" + n;

    // Les coordinateurs suivent le mode 1/2/3, Return reste transversal.
    if (id.matches("CA-SS[123]")) id = "CA-SS" + n;
    else if (id.matches("CA-SM[123]")) id = "CA-SM" + n;
    else if (id.matches("CA-SD[123]")) id = "CA-SD" + n;

    // Les anciens AO/ASup de niveau 3 sont convertis en AOp ou AOe.
    if ((id.startsWith("AOe-") || id.startsWith("AOP-") || id.startsWith("AOE-") || id.startsWith("ASUP-"))
        && !id.matches("ASUP-SD[123]")) {
        int tiret = id.indexOf('-');
        String code = tiret >= 0 ? id.substring(tiret + 1) : id;
        code = remplacerOccurrenceModeAnimation(code);
        id = (estCodePilotageAnimation(code) ? "AOP-" : "AOE-") + code;
    }
    return domaine + id + suffixeSpecial;
}

// Rattachement STRICT d'une entite de flux a sa commande.
// Les unites de production portent un idFlux du type "CMD_6_F_32" (identifiant de
// commande + "_F_" + numero d'unite). Un rattachement par simple contains(idCommande)
// est incorrect : "CMD_44_F_12".contains("CMD_4") est VRAI, ce qui credite les unites
// de CMD_44 a CMD_4 (parcourue en premier car creee avant) -- CMD_44 ne voit alors
// jamais arriver ses unites et reste bloquee en EN_COURS pour le reste du run, jamais
// livree, alors meme que le stock fini deborde. Le defaut n'apparait qu'avec assez de
// commandes pour que CMD_N et CMD_NM coexistent, la plus courte etant encore ouverte.
// Portage generique du correctif collegue (reference/colleague, fluxAppartientACommande).
boolean fluxAppartientACommande(String idFlux, String idCommande) {
    if (idFlux == null || idCommande == null || idCommande.isEmpty()) return false;
    if (idFlux.equals(idCommande)) return true;
    // seule forme acceptee au-dela de l'egalite : "<idCommande>_..." (ex. "_F_12"),
    // ce qui interdit qu'un identifiant plus court capture les unites d'un plus long.
    return idFlux.startsWith(idCommande + "_");
}

// DIAGNOSTIC des commandes qui ne se cloturent jamais. Une commande de production
// ne se referme que lorsque le compteur d'unites terminees
// (produitsTerminesParCommandeRuntime) atteint sa quantite commandee ; meme apres
// un rattachement flux/commande correct (fluxAppartientACommande), une commande peut
// rester figee en EN_COURS jusqu'a la fin du run sans cause evidente au dashboard.
// Cette trace journalise, pour chaque commande encore en production, l'ecart exact
// entre unites comptees et unites commandees : elle indique si le blocage vient d'un
// sous-comptage (et de combien d'unites) ou d'autre chose.
// Purement diagnostique : ne lit que des etats existants (commandes,
// produitsTerminesParCommandeRuntime) et se contente de journaliser via
// board.logEvent() -- aucune ecriture sur cmd.statut, aucun stock, aucune production,
// aucun impact PI, aucun routage. Portage generique du correctif collegue
// (reference/colleague, diagnostiquerCommandesBloquees) ; le champ cmd.retardConstate
// du collegue n'existe pas encore dans ce master (mecanisme de retard = Bloc C, non
// porte ici) et a donc ete omis de la ligne de log.
void diagnostiquerCommandesBloquees() {
    if (board == null) return;
    try {
        for (CommandeAgent cmd : commandes) {
            if (cmd == null || cmd.idCommande == null) continue;
            String s = cmd.statut == null ? "" : cmd.statut;
            if (!("EN_COURS".equals(s) || "EN_LIVRAISON".equals(s))) continue;
            Integer comptees = produitsTerminesParCommandeRuntime.get(cmd.idCommande);
            int n = (comptees == null ? 0 : comptees.intValue());
            int attendu = Math.max(1, cmd.qte);
            board.logEvent("[DIAG-BLOQUEE] " + cmd.idCommande
                + " | statut=" + s
                + " | mode=" + (cmd.typeCommande == null ? "?" : cmd.typeCommande)
                + " | unites comptees=" + n + "/" + attendu
                + " (manque " + Math.max(0, attendu - n) + ")"
                + " | age=" + String.format("%.0f", Math.max(0.0, time() - cmd.tCreation)) + "s");
        }
    } catch (Throwable ignored) {}
}

void definirIdentiteMovable(Movable m, String nom, String typeVisuel) {
    if (m == null) return;
    m.definirIdentiteVisuelle(nom, typeVisuel);
}

void mettreAJourIdentitesMovablesSelonMode() {
    int n = indiceModeSCOR();
    String k = String.valueOf(n);

    // Supplier
    definirIdentiteMovable(AT_sP4, "AT-sP4", "Tactique");
    definirIdentiteMovable(CA_sD1, "CA-sD" + k, "Coordinateur");
    definirIdentiteMovable(ASup_sD1_1, "ASup-sD" + k, "Superviseur");
    definirIdentiteMovable(AOe_sD1_2_2, "AOe-sD" + k + ".2", "Execution");
    definirIdentiteMovable(AOe_sS1_4_3, "AOe-sS" + k + ".4", "Warehouse");
    definirIdentiteMovable(AOe_sD1_11_supplier, "AOe-sD" + k + ".11", "Execution");
    definirIdentiteMovable(AOe_sD1_12, "AOe-sD" + k + ".12", "Vehicle");
    definirIdentiteMovable(AOe_sDR1_3_supplier, "AOe-sDR" + k + ".3", "Execution");

    // Manufacturer : coordinateurs
    definirIdentiteMovable(CA_sS1_2, "CA-sS" + k, "Coordinateur");
    definirIdentiteMovable(CA_sM1, "CA-sM" + k, "Coordinateur");
    definirIdentiteMovable(CA_sD1_3, "CA-sD" + k, "Coordinateur");
    definirIdentiteMovable(CA_sR, "CA-sR", "Coordinateur");

    // Manufacturer : Source
    definirIdentiteMovable(AOp_sS1_1, "AOp-sS" + k + ".1", "Pilotage");
    definirIdentiteMovable(AOe_sS1_2, "AOe-sS" + k + ".2", "Execution");
    definirIdentiteMovable(AOe_sS1_3, "AOe-sS" + k + ".3", "Execution");
    definirIdentiteMovable(AOe_sS1_4, "AOe-sS" + k + ".4", "Warehouse");

    // Manufacturer : Make
    definirIdentiteMovable(AOp_sM1_1, "AOp-sM" + k + ".1", "Pilotage");
    definirIdentiteMovable(AOe_sM1_2, "AOe-sM" + k + ".2", "Execution");
    definirIdentiteMovable(AOe_sM1_3, "AOe-sM" + k + ".3", "Execution");
    definirIdentiteMovable(AOe_sM1_4, "AOe-sM" + k + ".4", "Execution");
    definirIdentiteMovable(AOe_sM1_5, "AOe-sM" + k + ".5", "Warehouse");
    definirIdentiteMovable(AOe_sM1_6, "AOe-sM" + k + ".6", "Execution");
    definirIdentiteMovable(AOe_sM1_7, "AOe-sM" + k + ".7", "Execution");

    // Manufacturer : Deliver
    definirIdentiteMovable(AOp_sD1_1, "AOp-sD" + k + ".1", "Pilotage");
    definirIdentiteMovable(ASup_sD1, "ASup-sD" + k, "Superviseur");
    definirIdentiteMovable(AOe_sD1_2, "AOe-sD" + k + ".2", "Execution");
    definirIdentiteMovable(AOe_sD1_8_3, "AOe-sD" + k + ".8", "Execution");
    definirIdentiteMovable(AOe_sD1_9_manufacturer, "AOe-sD" + k + ".9", "Execution");
    definirIdentiteMovable(AOe_sD1_10_manufacturer, "AOe-sD" + k + ".10", "Execution");
    definirIdentiteMovable(AOe_sD1_11_manufacturer, "AOe-sD" + k + ".11", "Execution");
    definirIdentiteMovable(AOe_sD1_12_2, "AOe-sD" + k + ".12", "Vehicle");

    // Manufacturer : Return
    definirIdentiteMovable(ASup_sDR, "ASup-sDR", "Superviseur");
    definirIdentiteMovable(AOe_sDR1_3, "AOe-sDR" + k + ".3", "Execution");
    definirIdentiteMovable(AOe_sDR1_4_manufacturer, "AOe-sDR" + k + ".4", "Execution");
    definirIdentiteMovable(ASup_sSR_manufacturer, "ASup-sSR", "Superviseur");
    definirIdentiteMovable(AOe_sSR1_1_manufacturer, "AOe-sSR" + k + ".1", "Execution");
    definirIdentiteMovable(AOe_sSR1_5_manufacturer, "AOe-sSR" + k + ".5", "Execution");

    // Customer
    definirIdentiteMovable(AT_sP2_2, "AT-sP2", "Tactique");
    definirIdentiteMovable(AT_sP5_customer, "AT-sP5", "Tactique");
    definirIdentiteMovable(CA_sS1_3, "CA-sS" + k, "Coordinateur");
    definirIdentiteMovable(CA_sR_2, "CA-sR", "Coordinateur");
    definirIdentiteMovable(AOp_sS1_1_2, "AOp-sS" + k + ".1", "Pilotage");
    definirIdentiteMovable(AOe_sS1_2_2, "AOe-sS" + k + ".2", "Execution");
    definirIdentiteMovable(AOe_sS1_3_customer, "AOe-sS" + k + ".3", "Execution");
    definirIdentiteMovable(AOe_sS1_4_4, "AOe-sS" + k + ".4", "Warehouse");
    definirIdentiteMovable(AOe_sD1_8_2, "AOe-sD" + k + ".8", "Execution");
    definirIdentiteMovable(ASup_sSR, "ASup-sSR", "Superviseur");
    definirIdentiteMovable(AOe_sSR1_1, "AOe-sSR" + k + ".1", "Execution");
    definirIdentiteMovable(AOe_sSR1_5, "AOe-sSR" + k + ".5", "Execution");
}


// ============================================================
// S2.2 - FIDELITE VSM / NORMALISATION / AHP
// Corrections C01..C06. Aucun flux métier Cas 1/2/3 n'est modifié.
// ============================================================
public static class NormalizationProfile implements java.io.Serializable {
    // Nom historique conserve pour compatibilite JSON. C13 l'interprete comme une
    // MeasurementScale (bottom, perfect) de Theeranuphattana / Chan-Qi.
    public String code = "";
    public String direction = "BENEFIT"; // BENEFIT=higher is better ; COST=lower is better
    public double min = 0.0;             // BENEFIT: bottom ; COST: perfect
    public double max = 1.0;             // BENEFIT: perfect ; COST: bottom
    public String source = "";
    public String version = "2.0";
    // Bloc B.1 -- decroissance hyperbolique optionnelle pour les profils COST,
    // desactivee par defaut (false) : AUCUN profil existant n'est affecte, le
    // comportement de score10() ci-dessous reste identique pour tout profil qui
    // ne l'active pas explicitement. Remplace le plancher lineaire-puis-coupure-
    // dure (qui confond un ecart de 13x et un ecart de 56x au nominal, tous deux
    // a 0.000) par une decroissance 10*min/valeur : continue avec le plancher
    // lineaire en valeur=min (10/10 dans les deux cas), decroit ensuite beaucoup
    // plus lentement, jamais de plancher dur a 0. Non consomme dans ce bloc
    // (aucun appelant ne construit encore un profil avec decroissanceLente=true) --
    // fondation pour Bloc B.2 (RS.2.x, cf. MERGE_PROGRESS.md).
    public boolean decroissanceLente = false;

    public NormalizationProfile() {}
    public NormalizationProfile(String code, String direction, double min, double max, String source, String version) {
        this.code=code; this.direction=direction; this.min=min; this.max=max; this.source=source; this.version=version;
    }
    public NormalizationProfile(String code, String direction, double min, double max, String source, String version, boolean decroissanceLente) {
        this(code, direction, min, max, source, version);
        this.decroissanceLente = decroissanceLente;
    }
    public boolean higherIsBetter(){ return !("COST".equalsIgnoreCase(direction)||"MINIMIZE".equalsIgnoreCase(direction)); }
    public double bottom(){ return higherIsBetter()?min:max; }
    public double perfect(){ return higherIsBetter()?max:min; }
    public double score10(double valeur) {
        if(Double.isNaN(valeur)||Double.isInfinite(valeur)||Double.isNaN(min)||Double.isNaN(max)||max<=min) return Double.NaN;
        if (decroissanceLente && !higherIsBetter() && min > 0.0 && valeur > 0.0) {
            return Math.max(0.0, Math.min(10.0, 10.0 * min / valeur));
        }
        double s = higherIsBetter() ? 10.0*(valeur-min)/(max-min) : 10.0*(max-valeur)/(max-min);
        return Math.max(0.0,Math.min(10.0,s));
    }
    public double normaliser(double valeur) { // legacy [0..1]
        double s=score10(valeur); return Double.isNaN(s)?Double.NaN:s/10.0;
    }
}

public java.util.LinkedHashMap<String, NormalizationProfile> normalizationProfiles =
    new java.util.LinkedHashMap<String, NormalizationProfile>();

void ajouterProfilNormalisationDefaut(String code, String direction, double min, double max, String source) {
    String c = code == null ? "" : code.trim().toUpperCase(java.util.Locale.ROOT);
    if (c.isEmpty() || normalizationProfiles.containsKey(c)) return;
    normalizationProfiles.put(c, new NormalizationProfile(c, direction, min, max, source, "2.0"));
}

void initialiserProfilsNormalisationDefaut() {
    // Les valeurs sont fixes pour garantir la comparabilité inter-runs.
    // Elles sont explicitement configurables dans le JSON S2.2 et doivent être
    // recalibrées par expertise métier avant la campagne expérimentale finale.
    String src = "S2.2_DEFAULT_TO_VALIDATE";
    ajouterProfilNormalisationDefaut("RL.2.1", "BENEFIT", 0.0, 1.0, src);
    ajouterProfilNormalisationDefaut("RL.2.2", "BENEFIT", 0.0, 1.0, src);
    ajouterProfilNormalisationDefaut("RL.3.33", "BENEFIT", 0.0, 1.0, src);
    ajouterProfilNormalisationDefaut("RL.3.35", "BENEFIT", 0.0, 1.0, src);
    ajouterProfilNormalisationDefaut("RS.2.1", "COST", 0.0, 3600.0, src);
    ajouterProfilNormalisationDefaut("RS.2.2", "COST", 0.0, 3600.0, src);
    ajouterProfilNormalisationDefaut("RS.2.3", "COST", 0.0, 3600.0, src);
    ajouterProfilNormalisationDefaut("RS.2.5", "COST", 0.0, 3600.0, src);
    ajouterProfilNormalisationDefaut("RS.1.1", "COST", 0.0, 7200.0, src);
    ajouterProfilNormalisationDefaut("RS.3.94", "COST", 0.0, 7200.0, src);
    ajouterProfilNormalisationDefaut("AG.3.32", "BENEFIT", 0.0, Math.max(1.0, champDebit * 2.0), src);
    ajouterProfilNormalisationDefaut("PROXY.AG.SYSTEM_UTILIZATION", "COST", 0.0, 1.5, src);
    ajouterProfilNormalisationDefaut("AG.1.1", "BENEFIT", 0.0, 1.0, src);
    // Bloc B.2-FIX -- BUG CONFIRME PAR RUN REEL (ZENER mono et fixture A/B) :
    // calculerPIGlobal() (Bloc B.2) a renomme les codes AG.1.1 -> PROXY.AG.STABILITE_DEBIT
    // et AM.3.9 -> PROXY.AM.DISPONIBILITE_MACHINE pour etiqueter honnetement
    // ces 2 grandeurs comme des proxies plutot que des metriques SCOR
    // normatives -- un changement d'ETIQUETAGE voulu, PAS de calcul. Mais
    // aucun profil de normalisation n'existait sous ces NOUVEAUX codes :
    // scorePerformanceMetriqueSCOR() ne trouvait aucun profil pour
    // "PROXY.AG.STABILITE_DEBIT"/"PROXY.AM.DISPONIBILITE_MACHINE", et son
    // repli de secours (reserve aux prefixes RL./RS./AG./CO./AM., jamais a
    // "PROXY.") retombait sur Double.NaN -- traite ensuite comme un grade F
    // (score 0) par l'agregation floue, alors que les valeurs reelles
    // (~0.94-0.95 dans les 2 runs) auraient du scorer pres de 10/10.
    // Correctif : alias exact des profils historiques AG.1.1/AM.3.9
    // (memes direction/min/max/source, aucune nouvelle borne inventee) sous
    // les nouveaux codes, pour que valeur numerique ancienne = valeur
    // numerique nouvelle, seul le code/libelle devient honnetement PROXY.
    ajouterProfilNormalisationDefaut("PROXY.AG.STABILITE_DEBIT", "BENEFIT", 0.0, 1.0, src);
    ajouterProfilNormalisationDefaut("CO.1.1", "COST", 0.0, 1.0, src);
    ajouterProfilNormalisationDefaut("AM.3.9", "BENEFIT", 0.0, 1.0, src);
    ajouterProfilNormalisationDefaut("PROXY.AM.DISPONIBILITE_MACHINE", "BENEFIT", 0.0, 1.0, src);
    ajouterProfilNormalisationDefaut("AM.2.2", "COST", 0.0, 30.0, src);
}

public static class AHPResult implements java.io.Serializable {
    public double[] weights = new double[0];
    public double lambdaMax = Double.NaN;
    public double ci = Double.NaN;
    public double cr = Double.NaN;
    public boolean valid = false;
    public String message = "";
}

public double ahpConsistencyThreshold = 0.10;
public double dernierCR_AHPStrategique = Double.NaN;
public double dernierCR_AHPGoulot = Double.NaN;
public String sourceAHPStrategique = "S2.2_BOOTSTRAP_FROM_EXISTING_EXPERT_WEIGHTS";
public String sourceAHPGoulot = "S2.2_BOOTSTRAP_FROM_EXISTING_WEIGHTS";

public double[][] ahpStrategiquePairwise = matriceAHPDepuisPoids(new double[]{0.40, 0.20, 0.10, 0.15, 0.15});
public double[][] ahpGoulotPairwise = matriceAHPDepuisPoids(new double[]{0.40, 0.30, 0.20, 0.10});

public static double[][] matriceAHPDepuisPoids(double[] poids) {
    int n = poids == null ? 0 : poids.length;
    double[][] a = new double[n][n];
    for (int i=0;i<n;i++) for (int j=0;j<n;j++) {
        double wi = Math.max(1e-9, poids[i]);
        double wj = Math.max(1e-9, poids[j]);
        a[i][j] = wi / wj;
    }
    return a;
}

public AHPResult calculerAHP(double[][] a) {
    AHPResult r = new AHPResult();
    if (a == null || a.length < 2) { r.message = "Matrice AHP absente ou trop petite"; return r; }
    int n = a.length;
    for (int i=0;i<n;i++) if (a[i] == null || a[i].length != n) { r.message = "Matrice AHP non carree"; return r; }
    for (int i=0;i<n;i++) for (int j=0;j<n;j++) {
        if (!(a[i][j] > 0) || Double.isNaN(a[i][j]) || Double.isInfinite(a[i][j])) { r.message = "Valeur AHP invalide"; return r; }
        if (Math.abs(a[i][j] * a[j][i] - 1.0) > 0.05) { r.message = "Matrice AHP non reciproque"; return r; }
    }
    double[] g = new double[n]; double somme = 0.0;
    for (int i=0;i<n;i++) {
        double logSum = 0.0;
        for (int j=0;j<n;j++) logSum += Math.log(a[i][j]);
        g[i] = Math.exp(logSum / n); somme += g[i];
    }
    if (!(somme > 0)) { r.message = "Somme des priorites AHP nulle"; return r; }
    r.weights = new double[n];
    for (int i=0;i<n;i++) r.weights[i] = g[i] / somme;
    double lambda = 0.0;
    for (int i=0;i<n;i++) {
        double aw = 0.0;
        for (int j=0;j<n;j++) aw += a[i][j] * r.weights[j];
        lambda += aw / Math.max(1e-12, r.weights[i]);
    }
    r.lambdaMax = lambda / n;
    r.ci = n <= 1 ? 0.0 : Math.max(0.0, (r.lambdaMax - n) / (n - 1.0));
    double[] ri = {0.0,0.0,0.0,0.58,0.90,1.12,1.24,1.32,1.41,1.45,1.49};
    double RI = n < ri.length ? ri[n] : 1.49;
    r.cr = RI <= 0 ? 0.0 : r.ci / RI;
    r.valid = !Double.isNaN(r.cr) && !Double.isInfinite(r.cr);
    r.message = r.valid ? "OK" : "CR invalide";
    return r;
}

public java.util.List<Object> matriceAHPToJson(double[][] a) {
    java.util.List<Object> lignes = new java.util.ArrayList<Object>();
    if (a == null) return lignes;
    for (int i=0;i<a.length;i++) {
        java.util.List<Object> l = new java.util.ArrayList<Object>();
        for (int j=0;j<a[i].length;j++) l.add(a[i][j]);
        lignes.add(l);
    }
    return lignes;
}

public double[][] matriceAHPFromJson(Object obj, int n, double[][] fallback) {
    if (!(obj instanceof java.util.List)) return fallback;
    java.util.List rows = (java.util.List)obj;
    if (rows.size() != n) return fallback;
    double[][] a = new double[n][n];
    try {
        for (int i=0;i<n;i++) {
            Object rowObj = rows.get(i);
            if (!(rowObj instanceof java.util.List) || ((java.util.List)rowObj).size()!=n) return fallback;
            java.util.List row = (java.util.List)rowObj;
            for (int j=0;j<n;j++) {
                Object v = row.get(j);
                if (!(v instanceof Number)) return fallback;
                a[i][j] = ((Number)v).doubleValue();
            }
        }
        return a;
    } catch (Throwable ex) { return fallback; }
}

// C01 — Availability correcte pour l'OEE.
// On privilégie l'observation runtime si le poste lié simule les pannes ;
// sinon on utilise explicitement la disponibilité théorique de MachineSim.
public double calculerDisponibiliteMachinesOEE() {
    if (machinesSim == null || machinesSim.isEmpty()) return 1.0;
    double somme = 0.0; int n = 0;
    double horizon = tempsDebutSimulation >= 0 ? Math.max(0.0, time() - tempsDebutSimulation) : 0.0;
    for (MachineSim m : machinesSim) {
        if (m == null || !m.active) continue;
        double dispo = m.disponibiliteTheorique();
        PosteGenericAgent p = trouverPoste(m.idMicroActivite);
        if (p != null && p.mtbfHeures > 0 && horizon > 0) {
            double down = Math.max(0.0, p.tempsArretCumule);
            if (p.enPanne && p.tDebutPanneCourante >= 0) down += Math.max(0.0, time() - p.tDebutPanneCourante);
            dispo = Math.max(0.0, Math.min(1.0, 1.0 - down / horizon));
        }
        somme += Math.max(0.0, Math.min(1.0, dispo)); n++;
    }
    return n == 0 ? 1.0 : somme / n;
}

// C02 — Takt Time observé = temps disponible depuis START / demande client cumulée.
public double calculerTaktTimeSec() {
    if (tempsDebutSimulation < 0) return 0.0;
    double demande = 0.0;
    // C14.60 -- Le Takt Time (temps disponible / demande CLIENT) additionnait
    // aussi la quantite des ordres de fabrication autonomes (REAPPRO_x), qui
    // ne sont pas de la demande client mais des lots de reconstitution de
    // stock. Des l'apparition du premier de ces ordres (dimensionne par la
    // quantite economique, donc bien plus gros qu'une commande cliente), la
    // demande totale bondissait d'un coup et le Takt Time chutait
    // brutalement, sans rapport avec une evolution reelle de la demande.
    try {
        for (CommandeAgent c : commandes) {
            if (c != null && (c.idCommande == null || !c.idCommande.startsWith("REAPPRO_"))) {
                demande += Math.max(0, c.qte);
            }
        }
    } catch (Throwable ignored) {}
    if (demande <= 0) return 0.0;
    double disponible = Math.max(0.0, time() - tempsDebutSimulation);
    return disponible / demande;
}


// ============================================================
// S2.2 C08 — EXPORT ABOX RUNTIME RDF/TURTLE
// ------------------------------------------------------------
// Le Core officiel est utilise via le namespace core:.
// Tant que le TTL officiel Agent/AER n'est pas fourni, les assertions
// purement runtime d'agents/interactions restent dans run: afin de ne pas
// inventer une ontologie officielle. Elles pourront etre remappees en C08.
// ============================================================
public boolean aboxExportActif = true;
public boolean aboxExportSurClotureCommande = true;
public boolean aboxExportSurArret = false;
public int aboxMaxRawEvents = 5000;
public String aboxRunId = "";
public String dernierFichierABox = "";
public int nbExportsABox = 0;

// C14.2 — une fois le snapshot final ABox+Excel produit à la clôture,
// les exports Excel cycliques ne doivent plus écraser le fichier final.
public boolean c14SnapshotFinalEffectue = false;

String aboxSafeId(String s) {
    String x = s == null ? "" : s.trim();
    x = java.text.Normalizer.normalize(x, java.text.Normalizer.Form.NFD).replaceAll("\\p{M}+", "");
    x = x.replaceAll("[^A-Za-z0-9_\\-]", "_").replaceAll("_+", "_");
    if (x.isEmpty()) x = "NA";
    if (Character.isDigit(x.charAt(0))) x = "N_" + x;
    return x;
}
String aboxEsc(String s) {
    if (s == null) return "";
    return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\r", " ").replace("\n", "\\n").replace("\t", " ");
}
String aboxLit(String s) { return "\"" + aboxEsc(s) + "\""; }
String aboxDec(double v) {
    if (Double.isNaN(v) || Double.isInfinite(v)) return null;
    return "\"" + String.format(java.util.Locale.US,"%.8f",v).replaceAll("0+$","").replaceAll("\\.$","") + "\"^^xsd:decimal";
}
String aboxBool(boolean b) { return b ? "true" : "false"; }
String aboxEnsureRunId() {
    if (aboxRunId == null || aboxRunId.isEmpty()) {
        long configured = simStartRealMillis > 0 ? simStartRealMillis : 0L;
        long wallClock = System.currentTimeMillis();
        aboxRunId = "RUN_" + configured + "_" + wallClock;
    }
    return aboxRunId;
}
String aboxUri(String kind, String id) { return "run:" + aboxSafeId(kind) + "_" + aboxSafeId(id); }
String aboxActor(String id) { return aboxUri("actor", id); }
String aboxEq(String id) { return aboxUri("eq", id); }
String aboxMicro(String actor, String poste) { return aboxUri("micro", (actor==null?"":actor)+"_"+poste); }
String aboxOrder(String id) { return aboxUri("order", id); }
String aboxProduct(String id) { return aboxUri("product", id); }
String aboxScorN3(String code) { return aboxUri("scorN3", code); }

String aboxIsoAt(double tSim) {
    try {
        if (userStartDate == null) userStartDate = java.time.LocalDateTime.of(2026,3,10,8,0,0);
        double ref = tempsDebutSimulation >= 0 ? tempsDebutSimulation : 0.0;
        double dt = Math.max(0.0, tSim - ref) * Math.max(1.0, simToRealSeconds);
        java.time.LocalDateTime ldt = userStartDate.plusNanos((long)Math.round(dt*1_000_000_000.0));
        return ldt.format(java.time.format.DateTimeFormatter.ISO_LOCAL_DATE_TIME);
    } catch (Throwable ex) { return "2026-03-10T08:00:00"; }
}

String aboxCoreActorType(ActeurSC a) {
    if (a == null) return "core:SupplyChainActor";
    if (ActeurSC.FOURNISSEUR.equals(a.categorie)) return "core:Supplier";
    if (ActeurSC.ENTREPRISE_FOCALE.equals(a.categorie)) return "core:FocalCompany";
    if (ActeurSC.CLIENT.equals(a.categorie)) return "core:CustomerActor";
    if (ActeurSC.PRESTATAIRE_LOGISTIQUE.equals(a.typeAnnexe) || ActeurSC.TRANSPORTEUR.equals(a.typeAnnexe)) return "core:LogisticsProvider";
    return "core:SupplyChainActor";
}
String aboxCoreEquipmentType(String type) {
    String t=type==null?"":type.trim();
    for (String ok : new String[]{"EnterpriseUnit","Site","Area","Workshop","ProductionLine","WorkCenter","WorkCell","Workstation","Machine","Tooling","Sensor"})
        if (ok.equalsIgnoreCase(t)) return "core:"+ok;
    return "core:EquipmentElement";
}
String aboxFindEquipment(String actorId, String posteId) {
    for (ISA95ActivityAssignment a : isa95Assignments) {
        if (a==null) continue;
        if ((actorId==null?"":actorId).equals(a.idActeur) && (posteId==null?"":posteId).equals(a.idPoste)) return a.idEquipment;
    }
    return "";
}
String aboxFindActorForPoste(String posteId) {
    for (PosteGenericAgent p : postes) if (p!=null && posteId!=null && posteId.equals(p.idPoste)) return p.idActeurResponsable;
    return "";
}
String aboxPerfAttrFromCode(String code) {
    if (code==null) return ""; String c=code.toUpperCase(java.util.Locale.ROOT);
    if (c.startsWith("RL")) return "RL"; if (c.startsWith("RS")) return "RS"; if (c.startsWith("AG")) return "AG"; if (c.startsWith("CO")) return "CO"; if (c.startsWith("AM")) return "AM"; return "";
}
String aboxPerfClass(String attr) {
    if ("RL".equals(attr)) return "core:Reliability"; if ("RS".equals(attr)) return "core:Responsiveness";
    if ("AG".equals(attr)) return "core:Agility"; if ("CO".equals(attr)) return "core:Cost"; if ("AM".equals(attr)) return "core:AssetManagement";
    return "core:SCORPerformanceAttribute";
}
String aboxMetricTypeFromCode(String code) {
    if (code==null) return "core:SCORMetric";
    String c=code.toUpperCase(java.util.Locale.ROOT);
    if (c.matches("^[A-Z]+\\.1\\..*")) return "core:SCORMetricN1";
    if (c.matches("^[A-Z]+\\.2\\..*")) return "core:SCORMetricN2";
    if (c.matches("^[A-Z]+\\.3\\..*")) return "core:SCORMetricN3";
    return "core:SCORMetric";
}
void aboxTriple(java.io.PrintWriter pw, String s, String p, String o) { if (pw!=null && s!=null && p!=null && o!=null) pw.println(s+" "+p+" "+o+" ."); }

String aboxOperationalAgentRawId(OperationalAgent op) {
    if (op == null) return "";
    String id = (op.idRoleHierarchique == null || op.idRoleHierarchique.isEmpty()) ? op.idPoste : op.idRoleHierarchique;
    return id == null ? "" : id;
}
String aboxOperationalAgentId(OperationalAgent op) {
    if (op == null) return "";
    String raw = aboxOperationalAgentRawId(op);
    if (raw.isEmpty()) return "";
    String actor = (op.idActeurSC == null || op.idActeurSC.trim().isEmpty()) ? "GLOBAL" : op.idActeurSC.trim();
    // Ontology hasAgentID must be unique at system scope.
    return actor + "__" + raw;
}
String aboxOperationalAgentUriForActorRaw(String actorId, String rawId) {
    if (rawId == null || rawId.trim().isEmpty()) return "";
    String actor = (actorId == null || actorId.trim().isEmpty()) ? "GLOBAL" : actorId.trim();
    return aboxUri("agent", actor + "__" + rawId.trim());
}
int aboxCountLegacyOperationalIdCollisions() {
    java.util.LinkedHashMap<String,java.util.LinkedHashSet<String>> actorsByRaw =
        new java.util.LinkedHashMap<String,java.util.LinkedHashSet<String>>();
    for (OperationalAgent op : opAgents) {
        if (op == null) continue;
        String raw = aboxOperationalAgentRawId(op);
        if (raw.isEmpty()) continue;
        java.util.LinkedHashSet<String> set = actorsByRaw.get(raw);
        if (set == null) { set = new java.util.LinkedHashSet<String>(); actorsByRaw.put(raw,set); }
        set.add(op.idActeurSC == null ? "" : op.idActeurSC);
    }
    int n=0;
    for (java.util.LinkedHashSet<String> set : actorsByRaw.values()) if (set.size()>1) n++;
    return n;
}
int aboxCountPilotWithoutExecution() {
    int n=0;
    for (OperationalAgent pilot : opAgents) {
        if (pilot==null) continue;
        boolean isPilot=ROLE_SUPERVISEUR.equals(pilot.roleHolonique);
        if(!isPilot) continue;
        String pilotRaw=aboxOperationalAgentRawId(pilot);
        boolean child=false;
        for(OperationalAgent ex:opAgents){
            if(ex==null)continue;
            boolean isExec=ROLE_EXECUTION.equals(ex.roleHolonique);
            if(!isExec)continue;
            boolean sameActor=(pilot.idActeurSC==null?"":pilot.idActeurSC).equals(ex.idActeurSC==null?"":ex.idActeurSC);
            if(sameActor && pilotRaw.equals(ex.idSuperviseurRattache)){ child=true; break; }
        }
        if(!child)n++;
    }
    return n;
}
int aboxCountExecutionWithoutPilot() {
    int n=0;
    for(OperationalAgent ex:opAgents){
        if(ex==null)continue;
        boolean isExec=ROLE_EXECUTION.equals(ex.roleHolonique);
        if(!isExec)continue;
        boolean parent=false;
        for(OperationalAgent pilot:opAgents){
            if(pilot==null)continue;
            boolean isPilot=ROLE_SUPERVISEUR.equals(pilot.roleHolonique);
            if(!isPilot)continue;
            boolean sameActor=(pilot.idActeurSC==null?"":pilot.idActeurSC).equals(ex.idActeurSC==null?"":ex.idActeurSC);
            if(sameActor && aboxOperationalAgentRawId(pilot).equals(ex.idSuperviseurRattache)){ parent=true; break; }
        }
        if(!parent)n++;
    }
    return n;
}
OperationalAgent aboxFindOperationalForPoste(String actorId, String posteId) {
    for (OperationalAgent op : opAgents) {
        if (op == null) continue;
        boolean p = (posteId == null ? "" : posteId).equals(op.idPoste == null ? "" : op.idPoste);
        boolean a = (actorId == null ? "" : actorId).equals(op.idActeurSC == null ? "" : op.idActeurSC);
        if (p && a) return op;
    }
    return null;
}
String aboxActorForMachine(MachineSim m) {
    if (m == null) return "";
    for (ISA95EquipmentNode n : isa95Hierarchy) {
        if (n != null && m.idMachine != null && m.idMachine.equals(n.refMachineId))
            return n.idActeur == null ? "" : n.idActeur;
    }
    return "";
}
OperationalAgent aboxFindOperationalForMachine(MachineSim m) {
    if (m == null) return null;
    String actor=aboxActorForMachine(m);

    // 1) Source of truth after grouping: the OA whose postesLies contains the machine micro-activity.
    if (m.idMicroActivite != null && !m.idMicroActivite.isEmpty()) {
        for (OperationalAgent op : opAgents) {
            if (op == null || op.postesLies == null) continue;
            boolean actorOk=actor.isEmpty() || actor.equals(op.idActeurSC==null?"":op.idActeurSC);
            if (!actorOk) continue;
            for (PosteGenericAgent p : op.postesLies) {
                if (p != null && m.idMicroActivite.equals(p.idPoste)) return op;
            }
        }
    }

    // 2) Legacy direct logical identifier.
    for (OperationalAgent op : opAgents) {
        if (op == null) continue;
        boolean actorOk=actor.isEmpty() || actor.equals(op.idActeurSC==null?"":op.idActeurSC);
        if (actorOk && m.idOperationalAgent != null && !m.idOperationalAgent.isEmpty()
            && m.idOperationalAgent.equals(op.idAgentLogique)) return op;
    }

    // 3) Last fallback on direct poste field.
    for (OperationalAgent op : opAgents) {
        if (op == null) continue;
        boolean actorOk=actor.isEmpty() || actor.equals(op.idActeurSC==null?"":op.idActeurSC);
        if (actorOk && m.idMicroActivite != null && !m.idMicroActivite.isEmpty()
            && m.idMicroActivite.equals(op.idPoste)) return op;
    }
    return null;
}
String aboxFindEquipmentForMachine(String machineId) {
    if (machineId == null) return "";
    for (ISA95EquipmentNode n : isa95Hierarchy) {
        if (n != null && machineId.equals(n.refMachineId)) return n.id;
    }
    return "";
}
String aboxAgentStateIndividual(String state) {
    String s = state == null ? "" : state.trim().toUpperCase(java.util.Locale.ROOT);
    if ("IDLE".equals(s) || "INACTIF".equals(s)) return "agent:Idle";
    if ("ACTIVE".equals(s) || "WORKING".equals(s) || "EXECUTION".equals(s) || "GOULOT".equals(s)) return "agent:Active";
    if ("WAITING".equals(s) || "ATTENTE".equals(s)) return "agent:Waiting";
    if ("FAILURE".equals(s) || "PANNE".equals(s)) return "agent:Failure";
    if ("MAINTENANCE".equals(s)) return "agent:Maintenance";
    if ("DECISION".equals(s)) return "agent:Decision";
    if ("COORDINATION".equals(s)) return "agent:Coordination";
    return "";
}
String aboxOfficialRoleForRuntime(String role) {
    String r = role == null ? "" : role.trim().toUpperCase(java.util.Locale.ROOT);
    if ("SUPERVISEUR".equals(r) || "SUPERVISOR".equals(r)) return "agent:CoordinationRole_Default";
    if ("EXECUTION".equals(r) || "OPERATIONAL".equals(r)) return "agent:ExecutionRole_Default";
    if ("MACHINE".equals(r)) return "agent:ExecutionRole_Default";
    return "";
}


String aboxActorIdByCategory(String category) {
    if (category == null) return "";
    for (ActeurSC a : acteursSC) {
        if (a != null && category.equals(a.categorie)) return a.idActeur == null ? "" : a.idActeur;
    }
    return "";
}

String aboxHolonicScopeForActor(String actorId) {
    ActeurSC a = trouverActeurParId(actorId);
    if (a != null && ActeurSC.ENTREPRISE_FOCALE.equals(a.categorie)) return "INTERNAL_FULL";
    return "EXTERNAL_BOUNDARY";
}

String aboxScorFamily(String code) {
    String c = codeN3Architecture(code);
    if (c == null) return "";
    c = c.trim().toUpperCase(java.util.Locale.ROOT);
    int p = c.indexOf('.');
    return p > 0 ? c.substring(0,p) : c;
}

OperationalAgent aboxFindOperationalByActorRaw(String actorId, String rawId) {
    if (rawId == null || rawId.trim().isEmpty()) return null;
    for (OperationalAgent op : opAgents) {
        if (op == null) continue;
        boolean sameActor = (actorId == null ? "" : actorId).equals(op.idActeurSC == null ? "" : op.idActeurSC);
        if (sameActor && rawId.equals(aboxOperationalAgentRawId(op))) return op;
    }
    return null;
}

OperationalAgent aboxResolvePilotForExecution(OperationalAgent ex) {
    if (ex == null || !ROLE_EXECUTION.equals(ex.roleHolonique)) return null;
    String actor = ex.idActeurSC == null ? "" : ex.idActeurSC;

    // 1. Candidate architecture rule, but only if that pilot actually exists.
    OperationalAgent direct = aboxFindOperationalByActorRaw(actor, ex.idSuperviseurRattache);
    if (direct != null && ROLE_SUPERVISEUR.equals(direct.roleHolonique)) return direct;

    // 2. Safe semantic fallback: exactly one real Pilot in same actor and SCOR family.
    String fam = aboxScorFamily(ex.codeSCOR);
    OperationalAgent found = null;
    int n = 0;
    for (OperationalAgent op : opAgents) {
        if (op == null || !ROLE_SUPERVISEUR.equals(op.roleHolonique)) continue;
        boolean sameActor = actor.equals(op.idActeurSC == null ? "" : op.idActeurSC);
        if (!sameActor || !fam.equals(aboxScorFamily(op.codeSCOR))) continue;
        found = op; n++;
    }
    return n == 1 ? found : null;
}

int aboxCountApplicableExecutionWithoutPilot() {
    int n=0;
    for (OperationalAgent ex : opAgents) {
        if (ex==null || !ROLE_EXECUTION.equals(ex.roleHolonique)) continue;
        if (!"INTERNAL_FULL".equals(aboxHolonicScopeForActor(ex.idActeurSC))) continue;
        if (aboxResolvePilotForExecution(ex)==null) n++;
    }
    return n;
}

int aboxCountApplicablePilotWithoutExecution() {
    int n=0;
    for (OperationalAgent pilot : opAgents) {
        if (pilot==null || !ROLE_SUPERVISEUR.equals(pilot.roleHolonique)) continue;
        boolean child=false;
        for (OperationalAgent ex : opAgents) {
            if (ex==null || !ROLE_EXECUTION.equals(ex.roleHolonique)) continue;
            if (aboxResolvePilotForExecution(ex)==pilot) { child=true; break; }
        }
        if (!child) n++;
    }
    return n;
}


String aboxStaticReturnSourcePilotUri() {
    String actor = aboxActorIdByCategory(ActeurSC.ENTREPRISE_FOCALE);
    return actor.isEmpty() ? "" : aboxUri("agent", actor + "__ASup-sSR");
}

boolean aboxExecutionUsesStaticReturnSourcePilot(OperationalAgent ex) {
    if (ex == null || !ROLE_EXECUTION.equals(ex.roleHolonique)) return false;
    if (!"INTERNAL_FULL".equals(aboxHolonicScopeForActor(ex.idActeurSC))) return false;
    String c = codeN3Architecture(ex.codeSCOR);
    return c.startsWith("SR");
}

String aboxResolvePilotUriForExecution(OperationalAgent ex) {
    if (ex == null || !ROLE_EXECUTION.equals(ex.roleHolonique)) return "";
    OperationalAgent direct = aboxResolvePilotForExecution(ex);
    if (direct != null) return aboxUri("agent", aboxOperationalAgentId(direct));

    // Existing runtime architecture anchor, not a synthetic agent:
    // Main.ASup_sSR_manufacturer is explicitly identified as "ASup-sSR" / "Superviseur"
    // and connected CA_sR -> ASup_sSR_manufacturer -> SR execution nodes.
    if (aboxExecutionUsesStaticReturnSourcePilot(ex)) return aboxStaticReturnSourcePilotUri();
    return "";
}

int aboxCountInternalExecutionWithoutResolvedPilotC11() {
    int n=0;
    for (OperationalAgent ex : opAgents) {
        if (ex==null || !ROLE_EXECUTION.equals(ex.roleHolonique)) continue;
        if (!"INTERNAL_FULL".equals(aboxHolonicScopeForActor(ex.idActeurSC))) continue;
        if (aboxResolvePilotUriForExecution(ex).isEmpty()) n++;
    }
    return n;
}

int aboxCountStaticReturnSourceMappingsC11() {
    int n=0;
    for (OperationalAgent ex : opAgents)
        if (aboxExecutionUsesStaticReturnSourcePilot(ex) && aboxResolvePilotForExecution(ex)==null) n++;
    return n;
}

String aboxAERAgentUri(String rawEndpoint) {
    if (rawEndpoint == null || rawEndpoint.trim().isEmpty()) return "";
    String x = rawEndpoint.trim();
    String prefix = "";
    String id = x;
    int p = x.indexOf(':');
    if (p > 0) { prefix = x.substring(0,p).trim().toUpperCase(java.util.Locale.ROOT); id = x.substring(p+1).trim(); }

    if ("STRATEGIC".equalsIgnoreCase(id) || "AS-sP1".equalsIgnoreCase(id)) return aboxUri("agent","AS-sP1");
    if (id.startsWith("AT-sP") || id.startsWith("CA-")) return aboxUri("agent",id);

    String actor="";
    if ("MANUFACTURER".equals(prefix)) actor=aboxActorIdByCategory(ActeurSC.ENTREPRISE_FOCALE);
    else if ("CUSTOMER".equals(prefix)) actor=aboxActorIdByCategory(ActeurSC.CLIENT);

    if (id.startsWith("AOp-") || id.startsWith("AOe-")) {
        if (actor.isEmpty()) actor=aboxActorIdByCategory(ActeurSC.ENTREPRISE_FOCALE);
        if (!actor.isEmpty()) return aboxOperationalAgentUriForActorRaw(actor,id);
    }

    // Ambiguous collective supplier endpoint or other external runtime endpoint.
    return aboxUri("agentExternal", x);
}

boolean aboxAERAgentIsKnown(String uri) {
    if (uri == null || uri.isEmpty()) return false;
    if (uri.equals(aboxUri("agent","AS-sP1"))) return true;
    for (TacticalAgent t : tacticals) if (t!=null && uri.equals(aboxUri("agent","AT-" + t.monCodeSCOR))) return true;
    for (CoordinatorAgent c : supervisorsMacro) if (c!=null && uri.equals(aboxUri("agent",c.idAgentCoordinateur))) return true;
    for (OperationalAgent op : opAgents) if (op!=null && uri.equals(aboxUri("agent",aboxOperationalAgentId(op)))) return true;
    if (uri.equals(aboxStaticReturnSourcePilotUri())) return true;
    return uri.equals(aboxUri("agent","Blackboard"));
}

String aboxAERMessageClass(String type, String subject) {
    String t = type == null ? "" : type.trim().toUpperCase(java.util.Locale.ROOT);
    String s = subject == null ? "" : subject.trim();

    if ("ExecutionStart".equalsIgnoreCase(s)) return "aer:ExecutionStartMessage";
    if ("OperationalReport".equalsIgnoreCase(s)) return "aer:OperationalReport";

    if ("AMENDMENT".equals(t)) {
        if (s.endsWith("Task") || "DeliveryOrder".equalsIgnoreCase(s) || "ShipmentOrder".equalsIgnoreCase(s) || "ReserveInventory".equalsIgnoreCase(s))
            return "aer:OperationalOrderMessage";
        return "aer:AmendmentMessage";
    }
    if ("EXECUTION".equals(t)) return "aer:ExecutionMessage";
    if ("REPORT".equals(t)) return "aer:ReportingMessage";
    return "aer:AERMessage";
}

String aboxAERMessageTypeIndividual(String type) {
    String t = type == null ? "" : type.trim().toUpperCase(java.util.Locale.ROOT);
    if ("AMENDMENT".equals(t)) return "aer:MessageType_Amendment";
    if ("EXECUTION".equals(t)) return "aer:MessageType_Execution";
    if ("REPORT".equals(t)) return "aer:MessageType_Reporting";
    return "aer:MessageType_Response";
}

void aboxWriteFuzzyGradeSet(java.io.PrintWriter pw, String uri, FuzzyGradeSet g) {
    if (pw==null || uri==null || g==null) return;
    aboxTriple(pw,uri,"rdf:type","core:FuzzyPerformanceGradeSet");
    aboxTriple(pw,uri,"core:hasGradeA",aboxDec(g.A));
    aboxTriple(pw,uri,"core:hasGradeB",aboxDec(g.B));
    aboxTriple(pw,uri,"core:hasGradeC",aboxDec(g.C));
    aboxTriple(pw,uri,"core:hasGradeD",aboxDec(g.D));
    aboxTriple(pw,uri,"core:hasGradeE",aboxDec(g.E));
    aboxTriple(pw,uri,"core:hasGradeF",aboxDec(g.F));
}

String aboxDirectVSMIndicatorForMetric(String code) {
    String c=code==null?"":code.trim().toUpperCase(java.util.Locale.ROOT);
    if ("RS.2.1".equals(c)) return aboxUri("vsm","cycle_sS");
    if ("RS.2.2".equals(c)) return aboxUri("vsm","cycle_sM");
    if ("RS.2.3".equals(c)) return aboxUri("vsm","cycle_sD");
    if ("RS.2.5".equals(c)) return aboxUri("vsm","cycle_sR");
    if ("RS.1.1".equals(c)) return aboxUri("vsm","order_fulfillment_lead_time");
    if ("RS.3.94".equals(c)) return aboxUri("vsm","order_waiting_time");
    if ("AG.3.32".equals(c)) return aboxUri("vsm","throughput_global");
    if ("AM.3.9".equals(c)) return aboxUri("vsm","availability_global");
    return "";
}

public String exporterABoxRuntimeTTL(String raison) {
    if (!aboxExportActif) return "";
    java.io.PrintWriter pw=null;
    try {
        String runId=aboxEnsureRunId();
        String fichier="SCONTO_SVU_ABOX_"+aboxSafeId(nomEntreprise)+"_"+runId+".ttl";
        pw=new java.io.PrintWriter(new java.io.OutputStreamWriter(new java.io.FileOutputStream(fichier), java.nio.charset.StandardCharsets.UTF_8));
        pw.println("@prefix core: <http://www.sconto-vsm.org/core#> .");
        pw.println("@prefix agent: <http://www.sconto-vsm.org/agent-extension#> .");
        pw.println("@prefix aer: <http://www.sconto-vsm.org/aer-extension#> .");
        pw.println("@prefix run: <urn:sconto-svu:runtime:"+aboxSafeId(runId)+"#> .");
        pw.println("@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .");
        pw.println("@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .");
        pw.println("@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .");
        pw.println("@prefix owl: <http://www.w3.org/2002/07/owl#> .\n");
        pw.println("# SCONTO-SVU Global Runtime ABox — generated by AnyLogic S2.2 C14");
        pw.println("# reason="+aboxEsc(raison)+" ; simulationTime="+String.format(java.util.Locale.US,"%.3f",time()));
        pw.println("# Ontologies: Core 4.3.0 + Agent Extension 1.1.2 + AER Communication Extension 1.1.2.\n");

        String aboxOnt=aboxUri("ontology","runtime_abox");
        aboxTriple(pw,aboxOnt,"rdf:type","owl:Ontology");
        aboxTriple(pw,aboxOnt,"owl:imports","<http://www.sconto-vsm.org/core/4.3.0>");
        aboxTriple(pw,aboxOnt,"owl:imports","<http://www.sconto-vsm.org/agent-extension/1.1.2>");
        aboxTriple(pw,aboxOnt,"owl:imports","<http://www.sconto-vsm.org/aer-extension/1.1.2>");
        aboxTriple(pw,aboxOnt,"rdfs:comment",aboxLit("Global runtime ABox generated from SCONTO-SVU AnyLogic using Core 4.3.0, Agent 1.1.2 and AER 1.1.2."));

        String run=aboxUri("simulationRun",runId); String net=aboxUri("network",nomEntreprise);
        aboxTriple(pw,run,"rdf:type","run:SimulationRun");
        aboxTriple(pw,run,"rdfs:label",aboxLit("Simulation "+nomEntreprise+" / "+runId));
        aboxTriple(pw,run,"run:exportReason",aboxLit(raison));
        aboxTriple(pw,run,"run:simulationTimeSeconds",aboxDec(time()));
        aboxTriple(pw,run,"run:generatedAt",aboxLit(aboxIsoAt(time()))+"^^xsd:dateTime");
        aboxTriple(pw,run,"run:aboxScope",aboxLit("SCONTO_SVU_GLOBAL_RUNTIME"));
        aboxTriple(pw,run,"run:coreOntologyVersion",aboxLit("4.3.0"));
        aboxTriple(pw,run,"run:agentOntologyVersion",aboxLit("1.1.2"));
        aboxTriple(pw,run,"run:aerOntologyVersion",aboxLit("1.1.2"));
        aboxTriple(pw,run,"run:agentIdentityPolicy",aboxLit("ACTOR_SCOPED_OPERATIONAL_V1"));
        aboxTriple(pw,run,"run:legacyOperationalIdCollisionsResolved",aboxDec(aboxCountLegacyOperationalIdCollisions()));
        aboxTriple(pw,run,"run:legacyPilotWithoutExecutionCount",aboxDec(aboxCountPilotWithoutExecution()));
        aboxTriple(pw,run,"run:legacyExecutionWithoutPilotCount",aboxDec(aboxCountExecutionWithoutPilot()));
        aboxTriple(pw,run,"run:pilotWithoutExecutionApplicableCount",aboxDec(aboxCountApplicablePilotWithoutExecution()));
        aboxTriple(pw,run,"run:internalExecutionWithoutResolvedPilotCount",aboxDec(aboxCountInternalExecutionWithoutResolvedPilotC11()));
        aboxTriple(pw,run,"run:staticReturnSourcePilotMappings",aboxDec(aboxCountStaticReturnSourceMappingsC11()));
        aboxTriple(pw,run,"run:reasonerSchemaProfile",aboxLit("CORE_4_3_0_AGENT_1_1_2_AER_1_1_2_FULL_SCONTO_IMPORTS"));
        aboxTriple(pw,run,"run:performancePipeline",aboxLit("VSM_RAW_TO_SCOR_RAW_TO_SCORE_0_10_TO_FUZZY_TO_ATTRIBUTE_TO_PI"));
        aboxTriple(pw,run,"run:metricProcessScopePolicy",aboxLit("PROCESS_WHEN_OBSERVABLE_ELSE_GLOBAL_OR_CROSS_PROCESS"));
        aboxTriple(pw,run,"run:businessConfigurationSource",aboxLit("COLLEAGUE_JSON_VALIDATED_BY_PROJECT_LEAD_C14_3"));
        aboxTriple(pw,run,"run:performanceMethod",aboxLit("THEERANUPHATTANA_CHAN_QI_ADAPTED"));
        aboxTriple(pw,run,"run:performanceScoreScale",aboxLit("0..10"));
        aboxTriple(pw,run,"run:artifactSyncPolicy",aboxLit("ORDER_CLOSURE_ABOX_THEN_EXCEL_SAME_SIMULATION_TIME"));
        // VSM-FIX-06 -- manifeste minimal de reproductibilite du run.
        ScenarioFlux scenarioRun = scenarioSelectionneInterface();
        aboxTriple(pw,run,"run:runId",aboxLit(runId));
        aboxTriple(pw,run,"run:scenarioName",aboxLit(scenarioRun != null ? nomScenario(scenarioRun) : champScenarioSelectionne));
        aboxTriple(pw,run,"run:fixedOrderQuantity",aboxLit(quantiteCommandeFixeActive ? String.valueOf(Math.max(1,quantiteCommandeFixe)) : "NON_FIXEE"));
        aboxTriple(pw,run,"run:configuredOrderCount",aboxDec(Math.max(1,nombreCommandesATester)));
        aboxTriple(pw,run,"run:simToRealSeconds",aboxDec(simToRealSeconds));
        aboxTriple(pw,run,"run:supplierDelayActive",aboxLit(retardFournisseurTestActif ? "OUI" : "NON"));
        aboxTriple(pw,run,"run:supplierDelayTarget",aboxLit(retardFournisseurCible));
        aboxTriple(pw,run,"run:supplierDelayFactor",aboxDec(facteurRetardFournisseur));
        aboxTriple(pw,run,"run:firstReceiptOnly",aboxLit(retardFournisseurUneSeuleReception ? "OUI" : "NON"));
        aboxTriple(pw,run,"run:randomSeed",aboxLit("NON_ACCESSIBLE_DANS_MAIN"));
        aboxTriple(pw,run,"run:closureTimestamp",aboxLit(aboxIsoAt(time()))+"^^xsd:dateTime");
        aboxTriple(pw,run,"run:jsonPresetName",aboxLit(scenarioJsonFileName()));
        aboxTriple(pw,run,"run:modelArtifact",aboxLit("SCONTO_SVU_FINAL_VSM_FIX_CANDIDATE.alp"));
        aboxTriple(pw,net,"rdf:type","core:SupplyChainNetwork");
        aboxTriple(pw,net,"rdfs:label",aboxLit("Supply chain - "+nomEntreprise));
        aboxTriple(pw,run,"run:network",net);

        // Actors
        for (ActeurSC a : acteursSC) { if (a==null) continue; String u=aboxActor(a.idActeur);
            aboxTriple(pw,u,"rdf:type",aboxCoreActorType(a)); aboxTriple(pw,u,"rdfs:label",aboxLit(a.nom));
            aboxTriple(pw,u,"core:participatesInNetwork",net); aboxTriple(pw,net,"core:hasActor",u);
            aboxTriple(pw,u,"run:sourceId",aboxLit(a.idActeur)); aboxTriple(pw,u,"run:sourceKind",aboxLit("CONFIGURED"));
        }

        // Equipment hierarchy / ISA-95
        for (ISA95EquipmentNode n : isa95Hierarchy) { if (n==null) continue; String u=aboxEq(n.id);
            aboxTriple(pw,u,"rdf:type",aboxCoreEquipmentType(n.typeISA95)); aboxTriple(pw,u,"rdfs:label",aboxLit(n.nom));
            if (n.idActeur!=null && !n.idActeur.isEmpty()) { aboxTriple(pw,u,"core:belongsToActor",aboxActor(n.idActeur)); aboxTriple(pw,aboxActor(n.idActeur),"core:ownsEquipment",u); }
            if (n.parentId!=null && !n.parentId.isEmpty()) aboxTriple(pw,u,"core:isSubEquipmentOf",aboxEq(n.parentId));
            aboxTriple(pw,u,"run:sourceKind",aboxLit(n.source==null?"CONFIGURED":n.source));
            if (n.refMachineId!=null && !n.refMachineId.isEmpty()) aboxTriple(pw,u,"run:refMachineId",aboxLit(n.refMachineId));
        }

        // Products and orders
        java.util.LinkedHashSet<String> products=new java.util.LinkedHashSet<String>();
        for (ScenarioFlux sc:scenarios) if(sc!=null && sc.typeProduit!=null && !sc.typeProduit.isEmpty()) products.add(sc.typeProduit);
        for (CommandeAgent c:commandes) if(c!=null && c.idScenario!=null && !c.idScenario.isEmpty()) products.add(c.idScenario);
        for(String prod:products){ String u=aboxProduct(prod); aboxTriple(pw,u,"rdf:type","core:FinishedProduct"); aboxTriple(pw,u,"rdfs:label",aboxLit(prod)); aboxTriple(pw,u,"run:sourceKind",aboxLit("CONFIGURED")); }
        for(CommandeAgent c:commandes){ if(c==null)continue; String u=aboxOrder(c.idCommande); String prod=aboxProduct(c.idScenario);
            boolean clientOrder=estCommandeClient(c);
            aboxTriple(pw,u,"rdf:type",clientOrder?"core:CustomerOrder":"run:InternalStockReplenishmentOrder");
            aboxTriple(pw,u,"rdfs:label",aboxLit(c.idCommande));
            aboxTriple(pw,u,clientOrder?"core:concernsProduct":"run:concernsProduct",prod);
            aboxTriple(pw,u,"run:orderOrigin",aboxLit(clientOrder?"CUSTOMER":"STOCK_AUTONOMOUS"));
            aboxTriple(pw,u,clientOrder?"core:hasQuantity":"run:hasQuantity",aboxDec(c.qte)); aboxTriple(pw,u,"run:orderStatus",aboxLit(c.statut)); aboxTriple(pw,u,"run:orderStrategy",aboxLit(c.typeCommande));
            aboxTriple(pw,u,"run:createdAtSimulationSecond",aboxDec(c.tCreation)); aboxTriple(pw,u,"run:promisedAtSimulationSecond",aboxDec(c.tPromise));
            if(clientOrder){
                aboxTriple(pw,u,"run:orderProcessingTimeSeconds",aboxDec(c.dureeTraitementClientReelleSec));
                aboxTriple(pw,u,"run:orderWaitingTimeSeconds",aboxDec(c.dureeAttenteStockReelleSec));
                aboxTriple(pw,u,"run:orderFulfillmentLeadTimeSeconds",aboxDec(c.leadTimeClientReelSec));
                aboxTriple(pw,u,"run:replenishmentImputedTimeSeconds",aboxDec(c.dureeReapproImputeeReelleSec));
                if(c.tDebutAttenteStock>=0) aboxTriple(pw,u,"run:stockWaitStartedAtSimulationSecond",aboxDec(c.tDebutAttenteStock));
                if(c.tFinAttenteStock>=0) aboxTriple(pw,u,"run:stockWaitEndedAtSimulationSecond",aboxDec(c.tFinAttenteStock));
                for(String idReappro:c.ordresReapproLies) aboxTriple(pw,u,"run:dependsOnInternalReplenishmentOrder",aboxOrder(idReappro));
            } else {
                aboxTriple(pw,u,"run:replenishmentBusinessDurationSeconds",aboxDec(c.dureeReelleAccumulee));
                for(String idClient:c.commandesClientesCouvertes){
                    aboxTriple(pw,u,"run:contributesToCustomerOrderFulfillment",aboxOrder(idClient));
                    aboxTriple(pw,aboxOrder(idClient),"run:dependsOnInternalReplenishmentOrder",u);
                }
            }
        }

        // Materials
        for(FicheMatiere f:fichesMatiere){ if(f==null)continue; String u=aboxUri("material",f.idMatiere); aboxTriple(pw,u,"rdf:type","core:RawMaterial");
            aboxTriple(pw,u,"rdfs:label",aboxLit(f.idMatiere)); aboxTriple(pw,u,"core:hasQuantity",aboxDec(f.stockDisponible)); aboxTriple(pw,u,"run:sourceKind",aboxLit("OBSERVED_STATE")); }

        // SCOR N3 + microactivities
        java.util.LinkedHashSet<String> scorCodes=new java.util.LinkedHashSet<String>();
        for(PosteGenericAgent p:postes) if(p!=null && p.codeSCOR!=null && !p.codeSCOR.trim().isEmpty()) scorCodes.add(p.codeSCOR.trim());
        for(String c:scorCodes){ String u=aboxScorN3(c); aboxTriple(pw,u,"rdf:type","core:SCORLevel3Process"); aboxTriple(pw,u,"core:hasProcessCode",aboxLit(c)); aboxTriple(pw,u,"core:hasSCORLevel","\"3\"^^xsd:integer"); }
        for(PosteGenericAgent p:postes){ if(p==null)continue; String actor=p.idActeurResponsable==null?"":p.idActeurResponsable; String u=aboxMicro(actor,p.idPoste);
            aboxTriple(pw,u,"rdf:type","core:MicroActivity"); aboxTriple(pw,u,"rdfs:label",aboxLit(p.nom));
            if(actor.length()>0) aboxTriple(pw,u,"core:performedForActor",aboxActor(actor));
            if(p.codeSCOR!=null && !p.codeSCOR.isEmpty()) aboxTriple(pw,u,"core:mapsToSCORN3",aboxScorN3(p.codeSCOR));
            String eq=aboxFindEquipment(actor,p.idPoste); if(eq!=null && !eq.isEmpty()) aboxTriple(pw,u,"core:executedAt",aboxEq(eq));
            aboxTriple(pw,u,"run:sourcePosteId",aboxLit(p.idPoste)); aboxTriple(pw,u,"run:sourceKind",aboxLit("CONFIGURED"));
            aboxTriple(pw,u,"run:valueAddedRate",aboxDec(tauxValeurAjouteeTrace(p,p.codeSCOR)));
            aboxTriple(pw,u,"run:valueAddedSource",aboxLit(sourceValeurAjoutee(p)));
            aboxTriple(pw,u,"run:valueAddedNature",aboxLit("ESTIMATED"));
        }

        // VSM-FIX-07 -- contextes et indicateurs distincts pour la commande
        // cliente et pour la VSM de l'entreprise focale ACT_4.
        String ctx=aboxUri("ctx","global_"+runId); aboxTriple(pw,ctx,"rdf:type","core:ObservationContext");
        String ctxOrder=aboxUri("ctx","customer_order_"+runId); aboxTriple(pw,ctxOrder,"rdf:type","core:ObservationContext");
        String ctxZener=aboxUri("ctx","zener_vsm_"+runId); aboxTriple(pw,ctxZener,"rdf:type","core:ObservationContext");
        aboxTriple(pw,ctxOrder,"run:measurementScope",aboxLit("CUSTOMER_ORDER_CMD_ONLY"));
        aboxTriple(pw,ctxZener,"run:measurementScope",aboxLit("ZENER_ACT_4_ONLY"));
        for(ActeurSC a:acteursSC) if(a!=null && ActeurSC.ENTREPRISE_FOCALE.equals(a.categorie)) { aboxTriple(pw,ctx,"core:observedActor",aboxActor(a.idActeur)); aboxTriple(pw,ctxZener,"core:observedActor",aboxActor(a.idActeur)); break; }
        for(String cctx:new String[]{ctx,ctxOrder,ctxZener}){
            aboxTriple(pw,cctx,"core:observationStartTime",aboxLit(aboxIsoAt(tempsDebutSimulation>=0?tempsDebutSimulation:0))+"^^xsd:dateTime");
            aboxTriple(pw,cctx,"core:observationEndTime",aboxLit(aboxIsoAt(time()))+"^^xsd:dateTime");
        }
        if(board!=null){
            Object[][] orderInds = new Object[][]{
                {"order_processing_time","core:CycleTime","Order Processing Time",orderProcessingTimeGlobal(),"s"},
                {"order_waiting_time","core:WaitingTime","Order Waiting / Dwell Time",orderWaitingTimeGlobal(),"s"},
                {"order_fulfillment_lead_time","core:LeadTime","Order Fulfillment Lead Time",orderFulfillmentLeadTimeGlobal(),"s"}
            };
            for(Object[] x:orderInds){ String iu=aboxUri("vsm",String.valueOf(x[0])); aboxTriple(pw,iu,"rdf:type",String.valueOf(x[1])); aboxTriple(pw,iu,"rdfs:label",aboxLit(String.valueOf(x[2]))); aboxTriple(pw,iu,"core:hasValue",aboxDec(((Number)x[3]).doubleValue())); aboxTriple(pw,iu,"core:hasUnit",aboxLit(String.valueOf(x[4]))); aboxTriple(pw,iu,"core:hasTimestamp",aboxLit(aboxIsoAt(time()))+"^^xsd:dateTime"); aboxTriple(pw,iu,"core:hasObservationContext",ctxOrder); aboxTriple(pw,iu,"run:sourceKind",aboxLit("DERIVED_FROM_CUSTOMER_ORDER_LEDGER")); aboxTriple(pw,aboxUri("agent","Blackboard"),"agent:computesVSMIndicator",iu); }

            Object[][] zenerInds = new Object[][]{
                {"zener_process_time","core:CycleTime","ZENER Process Time",board.kpiZener.avgCycleTime(),"s"},
                {"zener_waiting_time","core:WaitingTime","ZENER Waiting Time",board.kpiZener.avgWaitTime(),"s"},
                {"zener_estimated_pce","run:EstimatedProcessCycleEfficiency","ZENER Estimated PCE",board.kpiZener.pce(),"ratio"}
            };
            for(Object[] x:zenerInds){ String iu=aboxUri("vsm",String.valueOf(x[0])); aboxTriple(pw,iu,"rdf:type",String.valueOf(x[1])); aboxTriple(pw,iu,"rdfs:label",aboxLit(String.valueOf(x[2]))); aboxTriple(pw,iu,"core:hasValue",aboxDec(((Number)x[3]).doubleValue())); aboxTriple(pw,iu,"core:hasUnit",aboxLit(String.valueOf(x[4]))); aboxTriple(pw,iu,"core:hasTimestamp",aboxLit(aboxIsoAt(time()))+"^^xsd:dateTime"); aboxTriple(pw,iu,"core:hasObservationContext",ctxZener); aboxTriple(pw,iu,"run:sourceKind",aboxLit("DERIVED_FROM_ACT_4_OBSERVATIONS")); aboxTriple(pw,iu,"run:valueAddedNature",aboxLit("ESTIMATED")); aboxTriple(pw,iu,"run:valueAddedSourcePolicy",aboxLit("CONFIGUREE_OR_FALLBACK_BY_POST")); aboxTriple(pw,aboxUri("agent","Blackboard"),"agent:computesVSMIndicator",iu); }

            Object[][] inds = new Object[][]{
                {"throughput_global","core:Throughput",(time() > 0 ? nbTermines * 3600.0 / time() : 0.0),"ent/h"},
                {"takt_global","core:TaktTime",calculerTaktTimeSec(),"s/unit"}, {"availability_global","core:Availability",calculerDisponibiliteMachinesOEE(),"ratio"},
                {"oee_global","core:OverallEquipmentEffectiveness",oeeGlobal(),"ratio"}, {"scrap_global","core:ScrapRate",board.kpiGlobal.scrapRate(),"ratio"},
                {"rework_global","core:ReworkRate",board.kpiGlobal.reworkRate(),"ratio"}
            };
            for(Object[] x:inds){ double v=((Number)x[2]).doubleValue(); String iu=aboxUri("vsm",String.valueOf(x[0])); aboxTriple(pw,iu,"rdf:type",String.valueOf(x[1])); aboxTriple(pw,iu,"core:hasValue",aboxDec(v)); aboxTriple(pw,iu,"core:hasUnit",aboxLit(String.valueOf(x[3]))); aboxTriple(pw,iu,"core:hasTimestamp",aboxLit(aboxIsoAt(time()))+"^^xsd:dateTime"); aboxTriple(pw,iu,"core:hasObservationContext",ctx); aboxTriple(pw,iu,"run:sourceKind",aboxLit("DERIVED")); aboxTriple(pw,aboxUri("agent","Blackboard"),"agent:computesVSMIndicator",iu); }
            for(String macro:new String[]{"sS","sM","sD","sR"}){
                KPIBundle km=board.kpiParMacro.get(macro); double cycle=km==null?0.0:km.avgCycleTime();
                String iu=aboxUri("vsm","cycle_"+macro);
                aboxTriple(pw,iu,"rdf:type","core:CycleTime"); aboxTriple(pw,iu,"core:hasValue",aboxDec(cycle)); aboxTriple(pw,iu,"core:hasUnit",aboxLit("s"));
                aboxTriple(pw,iu,"core:hasTimestamp",aboxLit(aboxIsoAt(time()))+"^^xsd:dateTime"); aboxTriple(pw,iu,"core:hasObservationContext",ctx);
                aboxTriple(pw,iu,"run:sourceKind",aboxLit("DERIVED_MACRO_VSM")); aboxTriple(pw,iu,"run:macroProcess",aboxLit(macro));
                aboxTriple(pw,aboxUri("agent","Blackboard"),"agent:computesVSMIndicator",iu);
            }
            for(java.util.Map.Entry<String,java.util.ArrayList<Double>> e:board.wipSnapshotsParBuffer.entrySet()){
                String key=e.getKey(); double avg=board.avgWIPBuffer(key); String w=aboxUri("wip",key); String cctx=aboxUri("ctx","wip_"+key);
                aboxTriple(pw,cctx,"rdf:type","core:ObservationContext"); String[] parts=key.split("\\|",2); if(parts.length>0) aboxTriple(pw,cctx,"core:observedActor",aboxActor(parts[0]));
                aboxTriple(pw,w,"rdf:type","core:WorkInProcess"); aboxTriple(pw,w,"core:hasValue",aboxDec(avg)); aboxTriple(pw,w,"core:hasUnit",aboxLit("units")); aboxTriple(pw,w,"core:hasObservationContext",cctx); aboxTriple(pw,w,"run:sourceKind",aboxLit("OBSERVED_SNAPSHOT_AVERAGE"));
            }
        }

        // Raw events + official AgentObservation / AgentExecutionTrace
        int start=Math.max(0,tracesBrutes.size()-Math.max(0,aboxMaxRawEvents));
        for(int i=start;i<tracesBrutes.size();i++){ TraceData t=tracesBrutes.get(i); if(t==null)continue; String ev=aboxUri("event",String.valueOf(t.id));
            aboxTriple(pw,ev,"rdf:type","core:RawEvent"); aboxTriple(pw,ev,"core:hasEventType",aboxLit(t.evenement)); aboxTriple(pw,ev,"core:hasEventTimestamp",aboxLit(aboxIsoAt(t.t))+"^^xsd:dateTime");
            if(!Double.isNaN(t.valeurBrute)&&!Double.isInfinite(t.valeurBrute)) aboxTriple(pw,ev,"core:hasEventValue",aboxDec(t.valeurBrute));
            if(t.idEntite!=null && t.idEntite.startsWith("CMD_")) aboxTriple(pw,ev,"core:relatedToWorkOrder",aboxOrder(t.idEntite));
            if(t.idPoste!=null && !t.idPoste.isEmpty() && !"GLOBAL".equals(t.idPoste)){
                String a=aboxFindActorForPoste(t.idPoste);
                if(!a.isEmpty()) aboxTriple(pw,ev,"core:relatedToActor",aboxActor(a));
                String eq=aboxFindEquipment(a,t.idPoste); if(!eq.isEmpty()) aboxTriple(pw,ev,"core:relatedToEquipment",aboxEq(eq));
                OperationalAgent op = aboxFindOperationalForPoste(a,t.idPoste);
                String opUri = op == null ? "" : aboxUri("agent",aboxOperationalAgentId(op));
                if(!opUri.isEmpty()){
                    String obs=aboxUri("agentObservation",String.valueOf(t.id));
                    aboxTriple(pw,obs,"rdf:type","agent:AgentObservation");
                    aboxTriple(pw,obs,"agent:performedByAgent",opUri);
                    aboxTriple(pw,obs,"agent:observationOfEvent",ev);
                    aboxTriple(pw,obs,"agent:hasObservationTimestamp",aboxLit(aboxIsoAt(t.t))+"^^xsd:dateTime");
                    aboxTriple(pw,opUri,"agent:observesEvent",ev);
                    if(!eq.isEmpty()) aboxTriple(pw,opUri,"agent:observesEquipment",aboxEq(eq));
                    aboxTriple(pw,aboxUri("agent","Blackboard"),"agent:storesObservation",obs);

                    String tr=aboxUri("agentTrace",String.valueOf(t.id));
                    aboxTriple(pw,tr,"rdf:type","agent:AgentExecutionTrace");
                    aboxTriple(pw,tr,"agent:performedByAgent",opUri);
                    aboxTriple(pw,tr,"agent:traceOfMicroActivity",aboxMicro(a,t.idPoste));
                }
            }
            aboxTriple(pw,ev,"run:measurement",aboxLit(t.mesure)); aboxTriple(pw,ev,"run:sourceKind",aboxLit("OBSERVED"));
        }

        // C14 — Performance pipeline: VSM raw -> actual SCOR value -> score 0..10 -> fuzzy -> attribute -> PI.
        double pi=Double.NaN; try{ pi=strategic.calculerPIGlobal(); strategic.piGlobalCourant=pi; }catch(Throwable ignored){}
        java.util.LinkedHashMap<String,String> attrUris=new java.util.LinkedHashMap<String,String>();
        java.util.ArrayList<String> metricUrisContributifs=new java.util.ArrayList<String>();
        String[] attrs={"RL","RS","AG","CO","AM"};
        double[] attrScores={strategic.scoreRL,strategic.scoreRS,strategic.scoreAG,strategic.scoreCO,strategic.scoreAM};
        double[] attrWeights={strategic.w_RL,strategic.w_RS,strategic.w_AG,strategic.w_CO,strategic.w_AM};
        FuzzyGradeSet[] attrGrades=new FuzzyGradeSet[5];
        for(int ai=0;ai<attrs.length;ai++) attrGrades[ai]=FuzzyGradeSet.agregerMetriques(strategic.detailN3.get(attrs[ai]));
        FuzzyGradeSet globalGrades=FuzzyGradeSet.agregerGrades(attrGrades,attrWeights);
        String eval=aboxUri("evaluation","PI_"+runId);
        aboxTriple(pw,eval,"rdf:type","core:SCORPerformanceEvaluation");
        if(aboxDec(pi)!=null) aboxTriple(pw,eval,"core:hasPerformanceScore",aboxDec(pi));
        aboxTriple(pw,eval,"core:hasAggregationMethod",aboxLit("THEERANUPHATTANA_CHAN_QI_ADAPTED"));
        String evalFuzzy=aboxUri("fuzzy","PI_"+runId); aboxWriteFuzzyGradeSet(pw,evalFuzzy,globalGrades); aboxTriple(pw,eval,"core:hasFuzzyGradeSet",evalFuzzy);
        aboxTriple(pw,eval,"run:sourceKind",aboxLit("DERIVED_PERFORMANCE_EVALUATION"));

        for(int ai=0;ai<attrs.length;ai++){
            String a=attrs[ai]; String au=aboxUri("attr",a); attrUris.put(a,au);
            aboxTriple(pw,au,"rdf:type",aboxPerfClass(a)); aboxTriple(pw,au,"rdfs:label",aboxLit(a+" performance attribute"));
            aboxTriple(pw,au,"core:hasPerformanceScore",aboxDec(attrScores[ai])); aboxTriple(pw,au,"core:hasAttributeWeight",aboxDec(attrWeights[ai]));
            aboxTriple(pw,au,"core:hasAggregationMethod",aboxLit("FUZZY_WEIGHTED_GRADE_AGGREGATION"));
            String fu=aboxUri("fuzzy","ATTR_"+a); aboxWriteFuzzyGradeSet(pw,fu,attrGrades[ai]); aboxTriple(pw,au,"core:hasFuzzyGradeSet",fu);
            aboxTriple(pw,au,"core:contributesToEvaluation",eval);
        }

        if(strategic!=null && strategic.detailN3!=null){
            initialiserProfilsNormalisationDefaut();
            for(java.util.Map.Entry<String,java.util.ArrayList<MetriqueN3>> en:strategic.detailN3.entrySet()){
                for(MetriqueN3 m:en.getValue()){ if(m==null)continue;
                    String code=(m.codeOfficielSCOR==null||m.codeOfficielSCOR.isEmpty())?m.nom:m.codeOfficielSCOR;
                    String mu=aboxUri("metric",code+"_"+en.getKey()); String attr=aboxPerfAttrFromCode(code); if(attr.isEmpty()) attr=en.getKey();
                    aboxTriple(pw,mu,"rdf:type",aboxMetricTypeFromCode(code)); aboxTriple(pw,mu,"rdfs:label",aboxLit(m.nom));
                    if(m.codeOfficielSCOR!=null&&!m.codeOfficielSCOR.isEmpty()) aboxTriple(pw,mu,"core:hasMetricCode",aboxLit(m.codeOfficielSCOR));
                    aboxTriple(pw,mu,"core:hasMetricValue",aboxDec(m.valeurBrute)); aboxTriple(pw,mu,"core:hasMetricUnit",aboxLit(m.unite));
                    aboxTriple(pw,mu,"core:hasPerformanceScore",aboxDec(m.score10)); aboxTriple(pw,mu,"core:hasMetricWeight",aboxDec(m.poids));
                    if(attrUris.containsKey(attr)) aboxTriple(pw,mu,"core:belongsToPerformanceAttribute",attrUris.get(attr));
                    String fg=aboxUri("fuzzy","METRIC_"+code+"_"+en.getKey()); aboxWriteFuzzyGradeSet(pw,fg,m.fuzzyGrades); aboxTriple(pw,mu,"core:hasFuzzyGradeSet",fg);

                    NormalizationProfile np=normalizationProfiles.get(code.trim().toUpperCase(java.util.Locale.ROOT));
                    if(np!=null){
                        String sr=aboxUri("scoringRule",code+"_"+en.getKey()); aboxTriple(pw,sr,"rdf:type","core:NormalizationRule");
                        aboxTriple(pw,sr,"core:usesNormalizationMethod","core:BottomPerfectProportionalMethod");
                        aboxTriple(pw,sr,"core:hasBottomValue",aboxDec(np.bottom())); aboxTriple(pw,sr,"core:hasPerfectValue",aboxDec(np.perfect()));
                        aboxTriple(pw,sr,"core:higherIsBetter",aboxBool(np.higherIsBetter()));
                        aboxTriple(pw,sr,"core:hasRuleExpression",aboxLit(np.higherIsBetter()?"10*(value-bottom)/(perfect-bottom)":"10*(bottom-value)/(bottom-perfect)"));
                        aboxTriple(pw,mu,"core:scoredByRule",sr); aboxTriple(pw,mu,"core:isBenefitMetric",aboxBool(np.higherIsBetter()));
                        aboxTriple(pw,sr,"run:profileSource",aboxLit(np.source)); aboxTriple(pw,sr,"run:profileVersion",aboxLit(np.version));
                    }

                    String ar=aboxUri("aggregationRule","VSM_TO_SCOR_"+code+"_"+en.getKey());
                    aboxTriple(pw,ar,"rdf:type","core:AggregationRule"); aboxTriple(pw,ar,"core:producesMetric",mu);
                    aboxTriple(pw,ar,"core:hasFormula",aboxLit(sourceFormuleMetriqueSCOR(code))); aboxTriple(pw,ar,"run:pipelineStage",aboxLit("VSM_TO_SCOR_ACTUAL_VALUE"));
                    String viu=aboxDirectVSMIndicatorForMetric(code); if(!viu.isEmpty()) aboxTriple(pw,ar,"core:aggregatesIndicator",viu);

                    if(attrUris.containsKey(attr) && m.poids>0){ aboxTriple(pw,mu,"core:contributesToPerformanceAttribute",attrUris.get(attr)); metricUrisContributifs.add(mu); }
                    aboxTriple(pw,mu,"run:validationStatus",aboxLit(m.poids>0?"CONTRIBUTIVE_TO_PI":"INFORMATIVE_OUTSIDE_PI"));
                    aboxTriple(pw,mu,"run:sourceKind",aboxLit("DERIVED_SCOR_ACTUAL_VALUE_THEN_SCORED"));

                    // C14.2 — R11 révisé : rattacher la métrique à un processus lorsque
                    // la formule runtime permet un scope non ambigu ; sinon déclarer
                    // explicitement un scope global/cross-process au lieu d'inventer un lien.
                    String processScopes = codesProcessusPourMetriqueSCOR(code);
                    boolean processLinked = false;
                    if (processScopes != null && !processScopes.trim().isEmpty()) {
                        for (String token : processScopes.split(",")) {
                            String pc = token == null ? "" : token.trim().toUpperCase(java.util.Locale.ROOT);
                            if (pc.isEmpty()) continue;
                            if (pc.endsWith(".")) {
                                pc = pc.substring(0, pc.length()-1);
                                if (!pc.isEmpty()) {
                                    aboxTriple(pw,mu,"core:isMetricOfProcess",aboxUri("scorProcess",pc));
                                    processLinked = true;
                                }
                            } else {
                                aboxTriple(pw,mu,"core:isMetricOfProcess",aboxScorN3(pc));
                                processLinked = true;
                            }
                        }
                    }
                    if (!processLinked) {
                        aboxTriple(pw,mu,"run:metricScope",aboxLit("GLOBAL_OR_CROSS_PROCESS"));
                    }

                    String strategicUri=aboxUri("agent","AS-sP1"); aboxTriple(pw,strategicUri,"agent:computesSCORMetric",mu);
                    if(attrUris.containsKey(attr)) aboxTriple(pw,strategicUri,"agent:contributesToPerformanceAttribute",attrUris.get(attr));
                    String rec=aboxUri("agentPerformanceRecord",code+"_"+en.getKey()); aboxTriple(pw,rec,"rdf:type","agent:AgentPerformanceRecord");
                    aboxTriple(pw,rec,"agent:performedByAgent",strategicUri); aboxTriple(pw,rec,"agent:performanceRecordForMetric",mu);
                    aboxTriple(pw,rec,"agent:hasPerformanceValue",aboxDec(m.valeurBrute)); aboxTriple(pw,rec,"agent:hasPerformanceUnit",aboxLit(m.unite));
                    aboxTriple(pw,aboxUri("agent","Blackboard"),"agent:storesPerformanceRecord",rec);
                }
            }
        }

        // Official SCONTO-VSM Agent Extension v1.1 assertions — current executable architecture
        String as=aboxUri("agent","AS-sP1");
        aboxTriple(pw,as,"rdf:type","agent:StrategicAgent");
        aboxTriple(pw,as,"agent:hasAgentID",aboxLit("AS-sP1"));
        aboxTriple(pw,as,"agent:hasAgentName",aboxLit("Strategic Agent"));
        aboxTriple(pw,as,"agent:hasAgentLevel","\"4\"^^xsd:integer");
        aboxTriple(pw,as,"agent:hasISA95Level","\"4\"^^xsd:integer");
        aboxTriple(pw,as,"agent:hasAgentRole","agent:DecisionRole_Default");
        aboxTriple(pw,as,"agent:hasAgentRole","agent:ReportingRole_Default");
        for(ActeurSC a:acteursSC) if(a!=null && ActeurSC.ENTREPRISE_FOCALE.equals(a.categorie)){ aboxTriple(pw,as,"agent:representsActor",aboxActor(a.idActeur)); break; }

        // Tactical agents: strategic supervision + Decision/Coordination roles.
        for(TacticalAgent t:tacticals){ if(t==null)continue; String id="AT-"+t.monCodeSCOR; String u=aboxUri("agent",id);
            aboxTriple(pw,u,"rdf:type","agent:TacticalAgent"); aboxTriple(pw,u,"agent:hasAgentID",aboxLit(id)); aboxTriple(pw,u,"agent:hasAgentName",aboxLit("Tactical "+t.monCodeSCOR));
            aboxTriple(pw,u,"agent:hasAgentLevel","\"3\"^^xsd:integer"); aboxTriple(pw,u,"agent:hasISA95Level","\"3\"^^xsd:integer");
            aboxTriple(pw,u,"agent:hasAgentRole","agent:DecisionRole_Default"); aboxTriple(pw,u,"agent:hasAgentRole","agent:CoordinationRole_Default");
            aboxTriple(pw,u,"agent:reportsToAgent",as); aboxTriple(pw,as,"agent:supervisesAgent",u);
            aboxTriple(pw,u,"agent:publishesToBlackboard",aboxUri("agent","Blackboard")); aboxTriple(pw,u,"agent:readsFromBlackboard",aboxUri("agent","Blackboard"));
        }

        // CoordinatorAgent v1.1: explicit class, realization strategy, SCOR process and strict parent/children links.
        for(CoordinatorAgent c:supervisorsMacro){ if(c==null)continue; String id=c.idAgentCoordinateur; String u=aboxUri("agent",id);
            aboxTriple(pw,u,"rdf:type","agent:CoordinatorAgent"); aboxTriple(pw,u,"agent:hasAgentID",aboxLit(id)); aboxTriple(pw,u,"agent:hasAgentName",aboxLit("Coordinator "+id));
            aboxTriple(pw,u,"agent:hasAgentRole","agent:CoordinationRole_Default"); aboxTriple(pw,u,"agent:hasAgentRole","agent:DecisionRole_Default");
            if(c.strategieRealisation!=null&&!c.strategieRealisation.isEmpty()) aboxTriple(pw,u,"agent:hasRealizationStrategy",aboxLit(c.strategieRealisation));
            String tacticalId=idTactiquePourCodeSCOR(c.monCodeSCOR);
            if(tacticalId!=null&&!tacticalId.isEmpty()){ String tu=aboxUri("agent",tacticalId); aboxTriple(pw,u,"agent:reportsToAgent",tu); aboxTriple(pw,tu,"agent:supervisesAgent",u); }
            String rawProc=c.monCodeSCOR==null?"":c.monCodeSCOR.trim(); String procCode=rawProc.startsWith("s")?rawProc.substring(1):rawProc;
            if(!procCode.isEmpty()){ String pu=aboxUri("scorProcess",procCode);
                boolean n2=procCode.matches("[SMD][123]");
                aboxTriple(pw,pu,"rdf:type",n2?"core:SCORLevel2Process":"core:SCORProcess");
                aboxTriple(pw,pu,"core:hasProcessCode",aboxLit(procCode));
                if(n2) aboxTriple(pw,pu,"core:hasSCORLevel","\"2\"^^xsd:integer");
                aboxTriple(pw,u,"agent:coordinatesProcess",pu);
            }
            aboxTriple(pw,u,"agent:publishesToBlackboard",aboxUri("agent","Blackboard")); aboxTriple(pw,u,"agent:readsFromBlackboard",aboxUri("agent","Blackboard"));
            String coordAct=aboxUri("agentCoordination",id); aboxTriple(pw,coordAct,"rdf:type","agent:AgentCoordination"); aboxTriple(pw,coordAct,"agent:performedByAgent",u);
            for(OperationalAgent op:opAgents){ if(op==null)continue; boolean pilot=ROLE_SUPERVISEUR.equals(op.roleHolonique)||"PILOTAGE".equalsIgnoreCase(op.categorieOP);
                if(id.equals(op.idCoordinateurRattache) && pilot){ String sub=aboxUri("agent",aboxOperationalAgentId(op)); aboxTriple(pw,u,"agent:supervisesAgent",sub); aboxTriple(pw,u,"agent:coordinatesAgent",sub); aboxTriple(pw,coordAct,"agent:coordinationBetweenAgents",sub); }}
        }


        // C11 — Existing Return Source supervisor anchor formalized as OperationalPilotAgent.
        // This is not synthetic: ASup_sSR_manufacturer already exists in the executable architecture.
        String staticSRPilot=aboxStaticReturnSourcePilotUri();
        if(!staticSRPilot.isEmpty()){
            String focalActor=aboxActorIdByCategory(ActeurSC.ENTREPRISE_FOCALE);
            String caR=aboxUri("agent","CA-sR");
            aboxTriple(pw,staticSRPilot,"rdf:type","agent:OperationalPilotAgent");
            aboxTriple(pw,staticSRPilot,"agent:hasAgentID",aboxLit(focalActor+"__ASup-sSR"));
            aboxTriple(pw,staticSRPilot,"run:sourceAgentId",aboxLit("ASup-sSR"));
            aboxTriple(pw,staticSRPilot,"run:sourceRuntimeObject",aboxLit("ASup_sSR_manufacturer"));
            aboxTriple(pw,staticSRPilot,"run:mappingBasis",aboxLit("EXISTING_STATIC_SUPERVISOR_ANCHOR"));
            aboxTriple(pw,staticSRPilot,"run:actorScopeId",aboxLit(focalActor));
            aboxTriple(pw,staticSRPilot,"run:holonicScope",aboxLit("INTERNAL_FULL"));
            aboxTriple(pw,staticSRPilot,"agent:hasAgentName",aboxLit("[ZEN] Return Source Supervisor"));
            aboxTriple(pw,staticSRPilot,"agent:hasAgentRole","agent:CoordinationRole_Default");
            aboxTriple(pw,staticSRPilot,"agent:hasAgentRole","agent:MonitoringRole_Default");
            aboxTriple(pw,staticSRPilot,"agent:representsActor",aboxActor(focalActor));
            aboxTriple(pw,staticSRPilot,"agent:reportsToAgent",caR);
            aboxTriple(pw,staticSRPilot,"agent:isSupervisedByAgent",caR);
            aboxTriple(pw,caR,"agent:supervisesAgent",staticSRPilot);
            aboxTriple(pw,caR,"agent:coordinatesAgent",staticSRPilot);
            aboxTriple(pw,staticSRPilot,"agent:publishesToBlackboard",aboxUri("agent","Blackboard"));
            aboxTriple(pw,staticSRPilot,"agent:readsFromBlackboard",aboxUri("agent","Blackboard"));
        }

        // Operational level v1.1: explicit Pilot vs Execution distinction.
        for(OperationalAgent op:opAgents){ if(op==null)continue;
            boolean pilot=ROLE_SUPERVISEUR.equals(op.roleHolonique)||"PILOTAGE".equalsIgnoreCase(op.categorieOP);
            boolean execution=ROLE_EXECUTION.equals(op.roleHolonique)||"EXECUTION".equalsIgnoreCase(op.categorieOP);
            // P2/P3/P4/P5 placeholders are represented by TacticalAgent and must not be retyped as execution agents.
            if(!pilot && !execution) continue;
            String id=aboxOperationalAgentId(op); if(id.isEmpty())continue; String u=aboxUri("agent",id);
            aboxTriple(pw,u,"rdf:type",pilot?"agent:OperationalPilotAgent":"agent:OperationalExecutionAgent");
            aboxTriple(pw,u,"agent:hasAgentID",aboxLit(id));
            aboxTriple(pw,u,"run:sourceAgentId",aboxLit(aboxOperationalAgentRawId(op)));
            aboxTriple(pw,u,"run:actorScopeId",aboxLit(op.idActeurSC==null?"":op.idActeurSC));
            aboxTriple(pw,u,"run:holonicScope",aboxLit(aboxHolonicScopeForActor(op.idActeurSC)));
            aboxTriple(pw,u,"agent:hasAgentName",aboxLit(op.libelleAffichage==null||op.libelleAffichage.isEmpty()?id:op.libelleAffichage));
            if(pilot){
                aboxTriple(pw,u,"agent:hasAgentRole","agent:CoordinationRole_Default"); aboxTriple(pw,u,"agent:hasAgentRole","agent:MonitoringRole_Default");
            } else {
                aboxTriple(pw,u,"agent:hasAgentRole","agent:ExecutionRole_Default"); aboxTriple(pw,u,"agent:hasAgentRole","agent:ObservationRole_Default");
            }
            String st=aboxAgentStateIndividual(op.etatHolon); if(!st.isEmpty()) aboxTriple(pw,u,"agent:hasAgentState",st);
            if(op.idActeurSC!=null&&!op.idActeurSC.isEmpty()) aboxTriple(pw,u,"agent:representsActor",aboxActor(op.idActeurSC));
            String eq=aboxFindEquipment(op.idActeurSC,op.idPoste);
            if(!eq.isEmpty()) {
                if(!pilot) aboxTriple(pw,u,"agent:representsEquipment",aboxEq(eq));
                aboxTriple(pw,u,"agent:observesEquipment",aboxEq(eq));
            }
            // Only execution agents assert executesMicroActivity in v1.1.
            if(!pilot && op.idPoste!=null&&!op.idPoste.isEmpty()) aboxTriple(pw,u,"agent:executesMicroActivity",aboxMicro(op.idActeurSC,op.idPoste));
            if(!pilot){
                String su=aboxResolvePilotUriForExecution(op);
                if(!su.isEmpty()){
                    aboxTriple(pw,su,"agent:supervisesAgent",u);
                    aboxTriple(pw,u,"agent:isSupervisedByAgent",su);
                    aboxTriple(pw,u,"agent:reportsToAgent",su);
                    aboxTriple(pw,u,"run:pilotMappingStatus",
                        aboxLit(aboxExecutionUsesStaticReturnSourcePilot(op) && aboxResolvePilotForExecution(op)==null
                            ? "RESOLVED_STATIC_SUPERVISOR" : "RESOLVED_EXPLICIT"));
                } else if("EXTERNAL_BOUNDARY".equals(aboxHolonicScopeForActor(op.idActeurSC))){
                    aboxTriple(pw,u,"run:pilotMappingStatus",aboxLit("NOT_APPLICABLE_EXTERNAL_BOUNDARY"));
                } else {
                    aboxTriple(pw,u,"run:pilotMappingStatus",aboxLit("MISSING_INTERNAL_PILOT"));
                }
            }
            if(op.idCoordinateurRattache!=null&&!op.idCoordinateurRattache.isEmpty() && pilot){
                String cu=aboxUri("agent",op.idCoordinateurRattache); aboxTriple(pw,u,"agent:reportsToAgent",cu); aboxTriple(pw,u,"agent:isSupervisedByAgent",cu);
            }
            aboxTriple(pw,u,"agent:publishesToBlackboard",aboxUri("agent","Blackboard")); aboxTriple(pw,u,"agent:readsFromBlackboard",aboxUri("agent","Blackboard"));
        }

        // MachineAgent v1.1 is a specialization of OperationalExecutionAgent and must represent at least one core:Machine.
        int machineAgentCount=0;
        for(MachineSim m:machinesSim){ if(m==null)continue; OperationalAgent mop=aboxFindOperationalForMachine(m); if(mop==null)continue;
            boolean pilot=ROLE_SUPERVISEUR.equals(mop.roleHolonique)||"PILOTAGE".equalsIgnoreCase(mop.categorieOP); if(pilot) continue;
            String u=aboxUri("agent",aboxOperationalAgentId(mop)); String eqId=aboxFindEquipmentForMachine(m.idMachine);
            if(eqId==null||eqId.isEmpty()){ eqId="MACHINE_"+m.idMachine; String meq=aboxEq(eqId); aboxTriple(pw,meq,"rdf:type","core:Machine"); aboxTriple(pw,meq,"rdfs:label",aboxLit(m.nom)); }
            aboxTriple(pw,u,"rdf:type","agent:MachineAgent"); aboxTriple(pw,u,"agent:hasAgentRole","agent:ExecutionRole_Default"); aboxTriple(pw,u,"agent:hasAgentRole","agent:MonitoringRole_Default");
            aboxTriple(pw,u,"agent:representsMachine",aboxEq(eqId)); aboxTriple(pw,u,"agent:observesEquipment",aboxEq(eqId)); machineAgentCount++;
        }

        String bb=aboxUri("agent","Blackboard"); aboxTriple(pw,bb,"rdf:type","agent:BlackboardAgent"); aboxTriple(pw,bb,"agent:hasAgentID",aboxLit("Blackboard")); aboxTriple(pw,bb,"agent:hasAgentName",aboxLit("SCONTO-SVU Blackboard"));
        aboxTriple(pw,bb,"agent:hasAgentRole","agent:AggregationRole_Default"); aboxTriple(pw,bb,"agent:hasAgentRole","agent:MonitoringRole_Default");

        // Actual strategic decision snapshot when the model has produced one.
        if(strategic!=null && strategic.journalDecisions!=null && !strategic.journalDecisions.isEmpty()){
            String d=aboxUri("agentDecision","strategic_latest"); String latest=strategic.journalDecisions.get(strategic.journalDecisions.size()-1);
            aboxTriple(pw,d,"rdf:type","agent:AgentDecision"); aboxTriple(pw,d,"agent:performedByAgent",as); aboxTriple(pw,d,"agent:hasDecisionTimestamp",aboxLit(aboxIsoAt(time()))+"^^xsd:dateTime");
            if(!Double.isNaN(pi)&&!Double.isInfinite(pi)) aboxTriple(pw,d,"agent:hasDecisionScore",aboxDec(pi)); aboxTriple(pw,d,"rdfs:label",aboxLit(latest)); aboxTriple(pw,bb,"agent:storesDecision",d);
            for(String muDecision:metricUrisContributifs) aboxTriple(pw,d,"agent:decisionBasedOnMetric",muDecision);
        }

        // AER v1.1 — official ontology export from structured hierarchical journal.
        if(board!=null && board.journalFluxHierarchique!=null){
            java.util.LinkedHashMap<String,String> conversations=new java.util.LinkedHashMap<String,String>();
            int seq=0;
            for(String line:board.journalFluxHierarchique){
                if(line==null)continue;
                String[] z=line.split("\\t",-1);
                if(z.length<6)continue;
                seq++;
                String orderId=(z.length>1?z[1]:"");
                String convKey=(orderId==null||orderId.isEmpty())?"GLOBAL":orderId;
                String conv=conversations.get(convKey);
                if(conv==null){
                    conv=aboxUri("aerConversation",convKey);
                    conversations.put(convKey,conv);
                    aboxTriple(pw,conv,"rdf:type","aer:AERConversation");
                    aboxTriple(pw,conv,"aer:hasConversationID",aboxLit(aboxEnsureRunId()+"_"+convKey));
                    aboxTriple(pw,conv,"aer:usesCommunicationProtocol","aer:AERProtocol_Default");
                }

                String u=aboxUri("aerMessage",String.valueOf(seq));
                String msgClass=aboxAERMessageClass(z[2],z[5]);
                aboxTriple(pw,u,"rdf:type","aer:AERMessage");
                if(!"aer:AERMessage".equals(msgClass)) aboxTriple(pw,u,"rdf:type",msgClass);
                aboxTriple(pw,u,"aer:hasMessageID",aboxLit(aboxEnsureRunId()+"_AER_"+seq));
                aboxTriple(pw,u,"aer:hasMessageSubject",aboxLit(z[5]));
                if(z.length>6&&!z[6].isEmpty()) aboxTriple(pw,u,"aer:hasMessagePayload",aboxLit(z[6]));
                double tmsg=0.0; try{tmsg=Double.parseDouble(z[0]);}catch(Throwable ignored){}
                aboxTriple(pw,u,"aer:hasMessageTimestamp",aboxLit(aboxIsoAt(tmsg))+"^^xsd:dateTime");
                aboxTriple(pw,u,"aer:hasSentTimestamp",aboxLit(aboxIsoAt(tmsg))+"^^xsd:dateTime");
                aboxTriple(pw,u,"aer:hasMessageStatus","aer:MessageStatus_Sent");
                aboxTriple(pw,u,"aer:hasMessagePriority","aer:Priority_Normal");
                aboxTriple(pw,u,"aer:hasMessageType",aboxAERMessageTypeIndividual(z[2]));
                aboxTriple(pw,u,"aer:belongsToConversation",conv);
                aboxTriple(pw,conv,"aer:hasMessage",u);

                String sender=aboxAERAgentUri(z[3]);
                String receiver=aboxAERAgentUri(z[4]);
                if(!sender.isEmpty()){
                    if(!aboxAERAgentIsKnown(sender)){
                        aboxTriple(pw,sender,"rdf:type","agent:HolonAgent");
                        aboxTriple(pw,sender,"agent:hasAgentID",aboxLit(z[3]));
                        aboxTriple(pw,sender,"agent:hasAgentName",aboxLit(z[3]));
                        aboxTriple(pw,sender,"run:holonicScope",aboxLit("EXTERNAL_BOUNDARY"));
                    }
                    aboxTriple(pw,u,"aer:sentByAgent",sender);
                }
                if(!receiver.isEmpty()){
                    if(!aboxAERAgentIsKnown(receiver)){
                        aboxTriple(pw,receiver,"rdf:type","agent:HolonAgent");
                        aboxTriple(pw,receiver,"agent:hasAgentID",aboxLit(z[4]));
                        aboxTriple(pw,receiver,"agent:hasAgentName",aboxLit(z[4]));
                        aboxTriple(pw,receiver,"run:holonicScope",aboxLit("EXTERNAL_BOUNDARY"));
                    }
                    aboxTriple(pw,u,"aer:sentToAgent",receiver);
                }

                if(orderId!=null&&!orderId.isEmpty()) aboxTriple(pw,u,"aer:concernsWorkOrder",aboxOrder(orderId));
                if(z.length>7&&!z[7].isEmpty()) aboxTriple(pw,u,"run:processContext",aboxLit(z[7]));
                if(z.length>8&&!z[8].isEmpty()) aboxTriple(pw,u,"run:businessStatus",aboxLit(z[8]));

                // Runtime mirrors kept only for trace/debug compatibility.
                aboxTriple(pw,u,"run:interactionType",aboxLit(z[2]));
                aboxTriple(pw,u,"run:senderId",aboxLit(z[3]));
                aboxTriple(pw,u,"run:receiverId",aboxLit(z[4]));
            }
        }

        pw.flush(); pw.close(); pw=null; dernierFichierABox=fichier; nbExportsABox++;
        if(board!=null) board.logEvent("[S2.2-ABOX] C14.3.2 Export TTL reussi : "+fichier+" | Scope=SCONTO_SVU_GLOBAL | Core=4.3.0 | AgentOntology=v1.1.2 | AEROntology=v1.1.2 | Performance=THEERANUPHATTANA_SCORE0_10_FUZZY | MetricScope=PROCESS_OR_GLOBAL | Identity=ACTOR_SCOPED | legacyCollisionsResolved="+aboxCountLegacyOperationalIdCollisions()+" | pilotSansExecutionApplicable="+aboxCountApplicablePilotWithoutExecution()+" | internalExecutionSansPilot="+aboxCountInternalExecutionWithoutResolvedPilotC11()+" | staticSRMappings="+aboxCountStaticReturnSourceMappingsC11()+" | C="+supervisorsMacro.size()+" | P="+agentsSuperviseurs.size()+" | E="+agentsExecution.size()+" | M="+machineAgentCount+" | traces="+Math.min(tracesBrutes.size(),aboxMaxRawEvents)+" | commandesClient="+nombreCommandesClientes()+" | ordresStock="+nombreOrdresStockAutonomes()+" | ISA95="+isa95Hierarchy.size()+" | raison="+raison);
        return fichier;
    } catch(Throwable ex){ try{if(pw!=null)pw.close();}catch(Throwable ignored){} if(board!=null)board.logEvent("[S2.2-ABOX ERROR] "+ex.getClass().getSimpleName()+" : "+ex.getMessage()); return ""; }
}


// ============================================================
// C14.3.2 — VUE GLOBALE : distinction visuelle des liens.
// - PILOTAGE / information : trait pointillé (connectionsInfo)
// - EXECUTION / flux physique-opérationnel : trait plein (connections)
// Cette distinction est visuelle et ne modifie ni les événements métier,
// ni les KPI, ni l'ABox, ni le calcul du PI.
// ============================================================
public int nbTerminesProduction = 0; // unités ayant effectivement achevé Make ; Dashboard uniquement
public boolean fluxInfoDisponible = true;
public boolean diffusionAutomatiqueSuccesseursActive = false; // desactivee par defaut : evite les flux visuels branches dupliques
public boolean fluxInfoDiagnostiqueFait = false;
public int nbLiensPointilles = 0;
public int nbLiensPleins = 0;

public void connecterPostes(PosteGenericAgent cible, PosteGenericAgent source, boolean informationnel) {
    if (cible == null || source == null) return;
    if (informationnel && fluxInfoDisponible) {
        try {
            java.lang.reflect.Field champ = null;
            try {
                champ = cible.getClass().getField("connectionsInfo");
            } catch (NoSuchFieldException e1) {
                Class<?> c = cible.getClass();
                while (c != null && champ == null) {
                    try { champ = c.getDeclaredField("connectionsInfo"); }
                    catch (NoSuchFieldException e2) { c = c.getSuperclass(); }
                }
                if (champ != null) champ.setAccessible(true);
            }
            if (champ != null) {
                Object lien = champ.get(cible);
                if (lien != null) {
                    java.lang.reflect.Method meth = null;
                    for (java.lang.reflect.Method m : lien.getClass().getMethods()) {
                        if (m.getName().equals("connectTo") && m.getParameterTypes().length == 1
                                && m.getParameterTypes()[0].isInstance(source)) { meth = m; break; }
                    }
                    if (meth != null) {
                        meth.invoke(lien, source);
                        nbLiensPointilles++;
                        return;
                    }
                }
            }
        } catch (Throwable ex) {
            if (!fluxInfoDiagnostiqueFait) {
                fluxInfoDiagnostiqueFait = true;
                try { board.logEvent("[VUE-GLOBALE] canal pointille indisponible, repli trait plein : " + ex.getMessage()); }
                catch (Throwable ignored) {}
            }
            fluxInfoDisponible = false;
        }
    }
    cible.connectTo(source);
    nbLiensPleins++;
}

// ============================================================
// C14.65 / ETAPE 3.1 — SEPARATION COMMANDES CLIENT / ORDRES INTERNES
// Les ordres REAPPRO_* reutilisent volontairement CommandeAgent pour passer
// dans le pipeline Make, mais ne sont jamais des commandes clientes. Toutes
// les statistiques de service client doivent passer par ces helpers.
// ============================================================
public boolean estCommandeClient(CommandeAgent cmd) {
    return cmd != null && cmd.idCommande != null && !cmd.idCommande.startsWith("REAPPRO_");
}

public boolean estOrdreStockAutonome(CommandeAgent cmd) {
    return cmd != null && cmd.idCommande != null && cmd.idCommande.startsWith("REAPPRO_");
}

// Bloc B.1 -- Meme comptage que tauxCommandesLivreesCloses() ci-dessous, expose
// separement pour permettre un seuil de taille d'echantillon minimal avant de
// ponderer RL dans le PI (Bloc B.2, calculerPIGlobal() -- non modifiee dans ce
// bloc). Un etat TERMINAL couvre ici SERVIE/EN_RETARD/REFUSEE/BLOQUE_* : les
// commandes jamais servies sont le pire cas de fiabilite au sens SCOR et ne
// doivent pas etre invisibles pour ce comptage. Adaptation par rapport a la
// reference technique collegue : son cmd.retardConstate (mecanisme de retard
// continu, Bloc C) n'existe pas dans ce master et n'est pas introduit ici --
// seuls les statuts deja presents dans ce master sont testes.
public int nombreCommandesClosesFiabilite() {
    int closes = 0;
    try {
        for (CommandeAgent cmd : commandes) {
            if (cmd == null || estOrdreStockAutonome(cmd)) continue;
            String s = cmd.statut == null ? "" : cmd.statut;
            if ("SERVIE".equals(s) || "EN_RETARD".equals(s)
                    || "REFUSEE".equals(s) || s.startsWith("BLOQUE")) closes++;
        }
    } catch (Throwable ignored) {}
    return closes;
}

// Bloc B.1 -- Nombre d'UNITES reellement livrees a des clients (somme des qte
// des commandes clientes closes, hors REAPPRO_). Fondation pour Bloc B.2
// (CO.1.1 : le cout cumule est accumule par unite passee sur chaque poste,
// alors que le chiffre d'affaire estime aujourd'hui avec nbTermines -- un
// compteur hybride, incremente par unite en production mais une seule fois
// par commande en livraison directe MTS -- sous-estime le CA en MTS pur).
// Non consommee dans ce bloc : CO.1.1 lui-meme n'est pas modifie ici.
public int unitesLivreesClients() {
    int unites = 0;
    try {
        for (CommandeAgent cmd : commandes) {
            if (cmd == null || estOrdreStockAutonome(cmd)) continue;
            if ("SERVIE".equals(cmd.statut) || "EN_RETARD".equals(cmd.statut)) unites += Math.max(0, cmd.qte);
        }
    } catch (Throwable ignored) {}
    return unites;
}

public int nombreCommandesClientes() {
    int n = 0;
    for (CommandeAgent c : commandes) if (estCommandeClient(c)) n++;
    return n;
}

public int nombreOrdresStockAutonomes() {
    int n = 0;
    for (CommandeAgent c : commandes) if (estOrdreStockAutonome(c)) n++;
    return n;
}

public long prochainNumeroCommandeClient() {
    long max = 0;
    for (CommandeAgent c : commandes) {
        if (!estCommandeClient(c)) continue;
        try {
            String s = c.idCommande.substring("CMD_".length());
            max = Math.max(max, Long.parseLong(s));
        } catch (Throwable ignored) {}
    }
    return max + 1;
}

public boolean scenarioCompatibleRetardFournisseur(ScenarioFlux sc) {
    if (!retardFournisseurTestActif) return true;
    if (sc == null || sc.nomenclature == null || sc.nomenclature.isEmpty()) return false;
    String cible = retardFournisseurCible == null ? "" : retardFournisseurCible.trim();
    if (cible.isEmpty()) return false;
    return sc.quantitePour(cible) > 0.0;
}

public boolean estFluxInformationnel(PosteGenericAgent source) {
    return estFluxInformationnel(source, null);
}

public boolean estFluxInformationnel(PosteGenericAgent source, PosteGenericAgent cible) {
    if (source == null) return false;
    // C14.5/C14.7 -- surcharges ciblees : ces liens sont informationnels
    // (demandes/confirmations) meme si leur code SCOR N3 les classerait en
    // EXECUTION par l'architecture ISA-95. Portee volontairement etroite (par
    // paire idPoste exacte quand la cible est connue, sinon par idPoste source
    // seul) pour ne pas perturber la hierarchie ISA-95 (roles superviseur/
    // execution) qui s'appuie sur la meme classification.
    if (source.idPoste != null) {
        if (source.idPoste.startsWith("sD1.2")) return true; // reception/validation commande (D1.2.x) : administratif
        if (source.idPoste.equals("sSR1.3.1")) return true;  // demande d'autorisation de retour
        if (source.idPoste.equals("sS1.4.5")) {
            // sS1.4.5 -> sSR1.3.1 (demande de retour) : informationnel.
            // sS1.4.5 -> sSR1.5.3 (transfert physique reel) : reste EXECUTION.
            if (cible != null && "sSR1.5.3".equals(cible.idPoste)) return false;
            return true;
        }
    }
    return "PILOTAGE".equals(categoriserActiviteSCOR(codeGroupeL3(source.codeSCOR), source.nom));
}

]]></AdditionalClassCode>
			<StartupCode><![CDATA[
// Demarrage a vide : l'utilisateur cree ses postes et scenarios
// via le formulaire de la vue Edition.
board.logEvent("SCONTO-VSM pret. Configurez vos postes puis vos scenarios.");
messageStatut = "Bienvenue. Ajoutez vos postes, puis vos scenarios, puis Demarrer.";
initialiserHorlogeSimulation();
viewEdition.navigateTo();

// Choix obligatoire du mode avant toute animation et avant le bouton Demarrer.
choisirModeSimulationAuLancement();

comboActeurCategorie.setItems(new String[] {
        ActeurSC.FOURNISSEUR,
        ActeurSC.ENTREPRISE_FOCALE,
        ActeurSC.CLIENT,
        ActeurSC.ACTEUR_ANNEXE
    });
comboActeurTypeAnnexe.setItems(new String[] {
        "",
        ActeurSC.TRANSPORTEUR,
        ActeurSC.DISTRIBUTEUR,
        ActeurSC.PRESTATAIRE_LOGISTIQUE,
        ActeurSC.PRESTATAIRE_MAINTENANCE,
        ActeurSC.SYSTEME_INFORMATION,
        ActeurSC.RESSOURCE_HUMAINE,
        ActeurSC.RESSOURCE_PHYSIQUE,
        ActeurSC.AUTRE
});

comboRespNiveau.setItems(new String[] {
    NIVEAU_STRATEGIC,
    NIVEAU_TACTICAL,
    NIVEAU_OPERATIONAL,
    NIVEAU_MACHINE
});

refreshActeursMicroComboBox();
refreshMicroActiviteComboBox();
updateRespMachineFieldsVisibility();
rafraichirComboPostes();
rafraichirComboScenarios();
initialiserPoolMessages();
// Animation : construit le registre visuel dès T=0 et déclenche les flux
// informationnels initiaux si les acteurs/postes sont déjà disponibles.
creerStationsAnimation();
declencherFluxInformationInitiale();
ConnectAgents();
ConnectPhysicalFlows();]]></StartupCode>
