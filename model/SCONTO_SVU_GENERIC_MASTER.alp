					<Body><![CDATA[int[] w = {8, 24, 20, 24, 34, 28, 8};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "VUE LOGISTIQUE — ACTEURS DE LA CHAINE CONFIGURES",
        w
    ));

    sb.append(tableRow(new String[]{
        "ID",
        "Nom",
        "Categorie",
        "Type annexe",
        "Description",
        "Micro-activites",
        "Actif"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (acteursSC == null || acteursSC.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", "Aucun acteur configure", "-", "-", "-", "-", "-"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    for (ActeurSC a : acteursSC) {
        sb.append(tableRow(new String[]{
            a.idActeur,
            a.nom,
            a.categorie,
            a.typeAnnexe == null || a.typeAnnexe.isEmpty() ? "-" : a.typeAnnexe,
            a.description,
            a.microActivitesText(),
            a.actif ? "Oui" : "Non"
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

return sb.toString();]]></Body>
