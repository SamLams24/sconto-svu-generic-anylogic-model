					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return String.format("PI Global  : %.3f / %.2f (cible)\n" +
"PCE Global : %.1f%%\n" +
"Throughput : %.1f ent/h\n" +
"WIP actuel : %d entites\n" +
"Rebuts: %d  Rework: %d\n" +
"RL:%.2f RS:%.2f AG:%.2f CO:%.2f AM:%.2f",
    strategic.piGlobalCourant, strategic.ciblePIGlobal,
    board.kpiGlobal.pce() * 100,
    time() > 0 ? nbTermines * 3600.0 / time() : 0,
    fluxEntites.size(), board.totalRebuts, board.totalRework,
    strategic.scoreRL, strategic.scoreRS, strategic.scoreAG,
    strategic.scoreCO, strategic.scoreAM);]]></Body>
