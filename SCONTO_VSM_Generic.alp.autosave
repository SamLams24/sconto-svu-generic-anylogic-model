				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781897809063</Id>
					<Name><![CDATA[tableDashboardMicroActivitesText]]></Name>
					<X>-300</X><Y>1120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {16, 22, 16, 8, 12, 12, 12, 10, 8, 8, 8};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "DASHBOARD — KPI AGREGEES PAR MICRO-ACTIVITE",
        w
    ));

    sb.append(tableRow(new String[]{
        "ID poste",
        "Nom micro-activite",
        "Code SCOR N3",
        "N echant.",
        "CT moy (s)",
        "WT moy (s)",
        "LT moy (s)",
        "PCE % (avec taux VA)",
        "File actu.",
        "Rebuts",
        "Rework"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (postes.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", "Aucune micro-activite", "-", "-", "-", "-", "-", "-", "-", "-", "-"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    for (PosteGenericAgent p : postes) {
        KPIBundle k = null;

        if (board.kpiParMicroActivite != null) {
            k = board.kpiParMicroActivite.get(p.idPoste);
        }

        if (k == null) {
            k = board.kpiParPoste.get(cleKPI(p));
        }

        long n = k != null ? k.count : 0;
        double ct = k != null ? k.avgCycleTime() : 0;
        double wt = k != null ? k.avgWaitTime() : 0;
        double lt = k != null ? k.avgLeadTime() : 0;
        double pce = k != null ? k.pce() * 100 : 0;
        long reb = k != null ? k.nbRebut : 0;
        long rew = k != null ? k.nbRework : 0;

        int file = 0;
        try {
            file = p.queue.size();
        } catch (Exception ex) {
            file = 0;
        }

        sb.append(tableRow(new String[]{
            p.idPoste,
            p.nom,
            p.codeSCOR,
            String.valueOf(n),
            fmt2(ct),
            fmt2(wt),
            fmt2(lt),
            fmt1(pce),
            String.valueOf(file),
            String.valueOf(reb),
            String.valueOf(rew)
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

    return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
