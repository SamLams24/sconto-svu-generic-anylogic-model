				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1799700000319</Id>
					<Name><![CDATA[btnVoirNomenclatureProduit]]></Name>
					<X>2100</X><Y>300</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="230" Height="28">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[StringBuilder sb = new StringBuilder();
ScenarioFlux trouve = null;
for (ScenarioFlux s : scenarios) {
    if (s.typeProduit.equalsIgnoreCase(champNomProduitNomenclature == null ? "" : champNomProduitNomenclature.trim())) { trouve = s; break; }
}
if (trouve == null) {
    sb.append("Produit introuvable : \"").append(champNomProduitNomenclature).append("\"");
} else {
    sb.append("═══ NOMENCLATURE DE \"").append(trouve.typeProduit).append("\" ═══\n\n");
    if (trouve.nomenclature.isEmpty()) {
        sb.append("(aucune matière déclarée pour ce produit)");
    } else {
        for (LigneNomenclature l : trouve.nomenclature) {
            sb.append("▸ ").append(l.idMatiere).append(" : ").append(l.quantiteParUnite).append(" par unité\n");
        }
    }
}
getExperimentHost().showMessageDialog(sb.toString());]]></ActionCode>
