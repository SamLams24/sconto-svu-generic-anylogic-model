				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1801000000003</Id>
					<Name><![CDATA[avgCycleTimeCodes]]></Name>
					<X>-440</X><Y>4660</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codesCsv]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (codesCsv == null || codesCsv.trim().isEmpty()) return Double.NaN;
String[] codes = codesCsv.split(",");
double sum = 0; long n = 0;
for (PosteGenericAgent p : postes) {
    if (p == null || p.codeSCOR == null) continue;
    boolean match = false;
    for (String c0 : codes) {
        String c = c0.trim();
        if (c.isEmpty()) continue;
        if (p.codeSCOR.equals(c) || p.codeSCOR.startsWith(c)) { match = true; break; }
    }
    if (!match) continue;
    KPIBundle k = null;
    try {
        if (board != null && board.kpiParMicroActivite != null) k = board.kpiParMicroActivite.get(p.idPoste);
        if (k == null && board != null && board.kpiParPoste != null) k = board.kpiParPoste.get(cleKPI(p));
    } catch (Throwable ignored) {}
    if (k == null || k.count <= 0) continue;
    sum += k.sumCycleTime;
    n += k.count;
}
return n <= 0 ? Double.NaN : sum / n;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[long]]></ReturnType>
					<Id>1801000000004</Id>
					<Name><![CDATA[countCycleTimeCodes]]></Name>
					<X>-440</X><Y>4690</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codesCsv]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (codesCsv == null || codesCsv.trim().isEmpty()) return 0;
String[] codes = codesCsv.split(",");
long n = 0;
for (PosteGenericAgent p : postes) {
    if (p == null || p.codeSCOR == null) continue;
    boolean match = false;
    for (String c0 : codes) {
        String c = c0.trim();
        if (c.isEmpty()) continue;
        if (p.codeSCOR.equals(c) || p.codeSCOR.startsWith(c)) { match = true; break; }
    }
    if (!match) continue;
    KPIBundle k = null;
    try {
        if (board != null && board.kpiParMicroActivite != null) k = board.kpiParMicroActivite.get(p.idPoste);
        if (k == null && board != null && board.kpiParPoste != null) k = board.kpiParPoste.get(cleKPI(p));
    } catch (Throwable ignored) {}
    if (k != null && k.count > 0) n += k.count;
}
return n;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1801000000005</Id>
					<Name><![CDATA[pceCodes]]></Name>
					<X>-440</X><Y>4720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codesCsv]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (codesCsv == null || codesCsv.trim().isEmpty()) return Double.NaN;
String[] codes = codesCsv.split(",");
double sumVAT = 0; double sumLead = 0; long n = 0;
for (PosteGenericAgent p : postes) {
    if (p == null || p.codeSCOR == null) continue;
    boolean match = false;
    for (String c0 : codes) {
        String c = c0.trim();
        if (c.isEmpty()) continue;
        if (p.codeSCOR.equals(c) || p.codeSCOR.startsWith(c)) { match = true; break; }
    }
    if (!match) continue;
    KPIBundle k = null;
    try {
        if (board != null && board.kpiParMicroActivite != null) k = board.kpiParMicroActivite.get(p.idPoste);
        if (k == null && board != null && board.kpiParPoste != null) k = board.kpiParPoste.get(cleKPI(p));
    } catch (Throwable ignored) {}
    if (k == null || k.count <= 0) continue;
    sumVAT += k.sumVAT;
    sumLead += k.sumCycleTime + k.sumWaitTime;
    n += k.count;
}
if (n <= 0 || sumLead <= 0) return Double.NaN;
return sumVAT / sumLead;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1801000000006</Id>
					<Name><![CDATA[stockMatiereDisponibleTotal]]></Name>
					<X>-440</X><Y>4750</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double total = 0;
try {
    for (FicheMatiere f : fichesMatiere) {
        if (f != null) total += Math.max(0, f.stockDisponible);
    }
} catch (Throwable ignored) {}
return total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1801000000007</Id>
					<Name><![CDATA[stockProduitFiniDisponibleTotal]]></Name>
					<X>-440</X><Y>4780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Bloc M.2 -- en mode multi-produit, la somme des postes physiques n'est PLUS la
// source de verite (voir audit M.1-FIX : synchroniserStockFiniAgrege() ecrit le
// meme total dans chaque poste matchant estPosteStockFini(), ce que cette
// fonction additionnerait alors N fois si plus d'un poste existait). On lit
// directement stockFiniParProduit (deja tenu a jour par consommerStockFiniProduit()/
// crediterStockFiniProduit()), qui reste correct quel que soit le nombre de
// postes physiques. Aucun scenario fourni n'a aujourd'hui plus d'un poste
// stock-fini (verifie), donc aucune regression sur le calcul legacy mono-produit,
// conserve ci-dessous a l'identique.
if (modeMultiProduitActif) return sommeStockFiniParProduit();
double total = 0;
try {
    for (PosteGenericAgent p : postes) {
        if (p != null && estPosteStockFini(p)) total += Math.max(0, p.niveauStock);
    }
} catch (Throwable ignored) {}
return total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1801000000008</Id>
					<Name><![CDATA[avgCycleTimeMacro]]></Name>
					<X>-440</X><Y>4810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[macroKey]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (macroKey == null || board == null || board.kpiParMacro == null) return Double.NaN;
KPIBundle k = board.kpiParMacro.get(macroKey);
if (k == null || k.count <= 0) return Double.NaN;
return k.avgCycleTime();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1801000000009</Id>
					<Name><![CDATA[codesProcessusPourMetriqueSCOR]]></Name>
					<X>-440</X><Y>4840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[code]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (code == null) return "";
String c = code.trim().toUpperCase(java.util.Locale.ROOT);
if (c.equals("RS.2.1")) return "S1.";
if (c.equals("RS.2.2")) return "M1.";
if (c.equals("RS.2.3")) return "D1.";

// C14.2 — rattachements de processus sûrs pour les métriques runtime.
// Les métriques N1/globales restent volontairement GLOBAL_OR_CROSS_PROCESS.
if (c.equals("RL.2.1") || c.equals("RL.2.2") || c.equals("RL.3.33") || c.equals("RL.3.35")) return "D1.";
if (c.equals("AG.3.32")) return "D1.12";
if (c.equals("AM.3.9")) return "M1.3";

if (c.equals("RS.2.5") || c.equals("RS.3.127") || c.equals("RS.3.5") || c.equals("AM.3.12")) return "DR1.,SR1.";
if (c.equals("RS.3.107")) return "S1.2";
if (c.equals("RS.3.122")) return "S1.1";
if (c.equals("RS.3.139")) return "S1.4";
if (c.equals("RS.3.140")) return "S1.3";
if (c.equals("RS.3.49")) return "M1.2";
if (c.equals("RS.3.101")) return "M1.3";
if (c.equals("RS.3.142")) return "M1.4";
if (c.equals("RS.3.128")) return "M1.5";
if (c.equals("RS.3.114")) return "M1.6";
if (c.equals("RS.3.123")) return "P3.4,M1.1";
if (c.equals("RS.3.116")) return "D1.3";
if (c.equals("RS.3.18")) return "D1.4";
if (c.equals("RS.3.16")) return "D1.5";
if (c.equals("RS.3.117")) return "D1.6";
if (c.equals("RS.3.124")) return "D1.7";
if (c.equals("RS.3.110")) return "D1.8";
if (c.equals("RS.3.96")) return "D1.9";
if (c.equals("RS.3.95")) return "D1.10";
if (c.equals("RS.3.51")) return "D1.11";
if (c.equals("RS.3.126")) return "D1.12";
if (c.equals("RS.3.102")) return "S1.2,S1.3";
if (c.equals("RS.3.111")) return "D1.1,D1.2";
return "";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1801000000010</Id>
					<Name><![CDATA[tauxCommandesLivreesCloses]]></Name>
					<X>-440</X><Y>4870</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int closes = 0, livrees = 0;
try {
    for (CommandeAgent cmd : commandes) {
        if (cmd == null) continue;
        // C14.60 -- exclut les ordres de reapprovisionnement autonomes : ce ne
        // sont pas des commandes clientes, ils ne doivent pas gonfler le taux
        // de commandes livrees (SCOR RL.2.1) ni les indicateurs derives.
        if (cmd.idCommande != null && cmd.idCommande.startsWith("REAPPRO_")) continue;
        if ("SERVIE".equals(cmd.statut) || "EN_RETARD".equals(cmd.statut)) {
            closes++;
            livrees++;
        }
    }
} catch (Throwable ignored) {}
if (closes == 0) return Double.NaN;
return (double) livrees / closes;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1801000000011</Id>
					<Name><![CDATA[valeurRuntimeMetriqueSCOR]]></Name>
					<X>-440</X><Y>4900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[code]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (code == null) return Double.NaN;
String c = code.trim().toUpperCase(java.util.Locale.ROOT);
try {
    // Fiabilite : on separe clairement les mesures réellement observées des données absentes.
    // La livraison complète et la livraison à temps sont observables via les statuts commande.
    if (c.equals("RL.2.1")) return tauxCommandesLivreesCloses();
    if (c.equals("RL.2.2")) return verifierFillRate();
    if (c.equals("RL.1.1")) return Math.min(tauxCommandesLivreesCloses(), verifierFillRate());

    // Proxies prudents : article/quantité/lieu sont assimilés au cas nominal mono-produit / mono-client.
    if (c.equals("RL.3.33") || c.equals("RL.3.35") || c.equals("RL.3.34")) return tauxCommandesLivreesCloses();
    if (c.equals("RL.3.32")) return verifierFillRate();
    if (c.equals("RL.3.55")) return retoursProduitsActifs ? (1.0 - champProbabiliteRetourProduits) : Double.NaN;

    // Données non observées actuellement : documentation, paiement, installation, dommages réels.
    if (c.equals("RL.2.3") || c.equals("RL.3.31") || c.equals("RL.3.43") || c.equals("RL.3.45") || c.equals("RL.3.50") || c.equals("RL.3.12")) return Double.NaN;
    if (c.equals("RL.2.4") || c.equals("RL.3.24") || c.equals("RL.3.41") || c.equals("RL.3.42")) return Double.NaN;

    if (c.equals("AG.3.38")) return (double) countCycleTimeCodes("M1.2,M1.3,M1.4,M1.5,M1.6");
    if (c.equals("AG.3.32")) {
        double done = nbTermines;
        try { if(board!=null && board.totalTerminees>done) done=board.totalTerminees; } catch(Throwable ignored){}
        return time()>0 ? done*3600.0/time() : 0.0;
    }
    if (c.equals("AG.3.1")) return 100.0 - (pceCodes("D1.") * 100.0);
    if (c.equals("AG.3.2")) return 100.0 - (pceCodes("M1.") * 100.0);
    if (c.equals("RS.1.1")) return (board != null && board.kpiGlobal != null && board.kpiGlobal.count > 0) ? orderFulfillmentLeadTimeGlobal() : Double.NaN;
    if (c.equals("RS.3.94")) return orderWaitingTimeGlobal();
    if (c.equals("RS.2.1")) return avgCycleTimeMacro("sS");
    if (c.equals("RS.2.2")) return avgCycleTimeMacro("sM");
    if (c.equals("RS.2.3")) return avgCycleTimeMacro("sD");
    if (c.equals("RS.2.5")) return avgCycleTimeMacro("sR");
    String codes = codesProcessusPourMetriqueSCOR(c);
    if (!codes.isEmpty()) return avgCycleTimeCodes(codes);

    double[] couts = calculerCoutsCumules();
    if (c.equals("CO.3.13") || c.equals("CO.2.7")) return couts[0];
    if (c.equals("CO.3.11") || c.equals("CO.2.8")) return couts[1];
    if (c.equals("CO.3.12") || c.equals("CO.2.9")) return 0.0; // coût indirect non renseigné : valeur explicite nulle, pas inventée
    if (c.equals("CO.1.1")) {
        if(chiffreAffaireParUnite<=0 || nbTermines<=0) return Double.NaN;
        double ca=chiffreAffaireParUnite*nbTermines;
        return ca>0 ? Math.min(1.0,couts[2]/ca) : Double.NaN;
    }
    if (c.equals("CO.2.1") || c.equals("CO.2.2") || c.equals("CO.2.3") || c.equals("CO.2.4") || c.equals("CO.2.5")) return couts[2];
    if (c.equals("CO.3.1") || c.equals("CO.3.2") || c.equals("CO.3.3") || c.equals("CO.3.4") || c.equals("CO.3.5") || c.equals("CO.3.7") || c.equals("CO.3.8") || c.equals("CO.3.9") || c.equals("CO.3.10") || c.equals("CO.3.14") || c.equals("CO.3.15")) return couts[2];
    if (c.startsWith("CO.")) return Double.NaN;

    if (c.equals("AG.1.1")) return strategic!=null ? strategic.coefficientAdaptabilite() : Double.NaN;
    if (c.equals("PROXY.AG.SYSTEM_UTILIZATION")) {
        double cap=0.0; for(PosteGenericAgent p:postes) cap+=p.capaciteSimultanee;
        return cap>0 && board!=null ? board.avgWIP()/cap : Double.NaN;
    }
    if (c.equals("AM.3.9")) return calculerDisponibiliteMachinesMoyenne();
    if (c.equals("AM.3.16")) return stockMatiereDisponibleTotal();
    if (c.equals("AM.3.17")) return 0.0; // WIP : non stocké en valeur de jours, WIP courant approximé nul après clôture
    if (c.equals("AM.3.45")) return stockProduitFiniDisponibleTotal();
    if (c.equals("AM.2.2")) return calculerInventoryDaysOfSupply();
    if (c.equals("AM.2.8")) return stockMatiereDisponibleTotal() + stockProduitFiniDisponibleTotal();
    if (c.equals("AM.3.11") || c.equals("AM.3.18") || c.equals("AM.3.20") || c.equals("AM.3.24") || c.equals("AM.3.27") || c.equals("AM.2.5")) return calculerValeurActifsFixes();
    if (c.startsWith("AM.")) return Double.NaN;
} catch (Throwable ex) {
    return Double.NaN;
}
return Double.NaN;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1801000000012</Id>
					<Name><![CDATA[uniteMetriqueSCOR]]></Name>
					<X>-440</X><Y>4930</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[code]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (code == null) return "-";
String c = code.trim().toUpperCase(java.util.Locale.ROOT);
if (c.startsWith("RS.")) return "s";
if (c.startsWith("RL.")) return "ratio 0-1";
if (c.equals("AG.3.38")) return "entités";
if (c.equals("AG.3.32")) return "entités/h";
if (c.startsWith("AG.")) return "ratio / estimation";
if (c.equals("CO.1.1")) return "ratio cout/CA";
if (c.startsWith("CO.")) return "FCFA";
if (c.contains("INVENTORY DAYS") || c.equals("AM.2.2") || c.equals("AM.3.16") || c.equals("AM.3.17") || c.equals("AM.3.45")) return c.equals("AM.3.16") || c.equals("AM.3.45") ? "unités stock" : "jours";
if (c.equals("AM.3.9")) return "ratio 0-1";
if (c.startsWith("AM.")) return "FCFA / unités";
return "-";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1801000000013</Id>
					<Name><![CDATA[statutMetriqueSCOR]]></Name>
					<X>-440</X><Y>4960</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[code]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String c = code == null ? "" : code.trim().toUpperCase(java.util.Locale.ROOT);
double v = valeurRuntimeMetriqueSCOR(code);
if (!Double.isNaN(v) && !Double.isInfinite(v)) {
    if (c.equals("RL.2.1") || c.equals("RL.2.2") || c.equals("RL.1.1")) return "Calculée pendant la simulation";
    if (c.startsWith("RS.")) return "Calculée pendant la simulation";
    if (c.equals("AG.3.32") || c.equals("AG.3.38")) return "Calculée pendant la simulation";
    if (c.startsWith("CO.") || c.startsWith("AM.")) return "Calculée pendant la simulation / donnée configurée";
    return "Approximation calculée pendant la simulation";
}
if (c.equals("RL.2.3") || c.equals("RL.3.31") || c.equals("RL.3.43") || c.equals("RL.3.45") || c.equals("RL.3.50")) return "Non calculable actuellement : données documentaires absentes";
if (c.equals("RL.3.12")) return "Non applicable au modèle actuel : installation non modélisée";
if (c.equals("RL.2.4") || c.equals("RL.3.24") || c.equals("RL.3.41") || c.equals("RL.3.42")) return "Non calculable actuellement : dommage/défaut réel non mesuré";
if (c.equals("RL.3.55")) return "Calculable si retours/garantie activés";
if (c.startsWith("RS.3") || c.startsWith("RS.2") || c.equals("RS.1.1")) return "Calculable si le poste/processus est exécuté";
if (c.startsWith("CO.")) return "Non calculable actuellement : coût source absent ou paiement/risque non modélisé";
if (c.startsWith("AM.")) return "Partiel / non calculable : données financières ou stocks avancés absents";
if (c.startsWith("AG.")) return "Partiel : nécessite scénarios capacité/risque";
return "Non calculable actuellement";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1801000000014</Id>
					<Name><![CDATA[sourceFormuleMetriqueSCOR]]></Name>
					<X>-440</X><Y>4990</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[code]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String c = code == null ? "" : code.trim().toUpperCase(java.util.Locale.ROOT);

// C14.2.1 — Les formules spécifiques doivent être résolues AVANT le fallback
// générique par processus. Sinon l'Excel et l'ABox décrivent à tort certaines
// métriques RL/AG/AM comme des moyennes de temps de traitement.
if (c.equals("RL.2.1")) return "Commandes closes livrées en totalité / commandes closes (statuts commande)";
if (c.equals("RL.2.2") || c.equals("RL.3.32")) return "verifierFillRate() : commandes CLIENTES livrées à temps / commandes CLIENTES closes";
if (c.equals("RL.3.33")) return "Approximation nominale mono-produit : exactitude article = taux de commandes closes livrées en totalité";
if (c.equals("RL.3.35")) return "Approximation nominale : exactitude quantité = taux de commandes closes livrées en totalité";
if (c.equals("RL.1.1")) return "Minimum entre livraison complète et livraison à temps ; approximation de la commande parfaite";
if (c.equals("RL.2.3") || c.equals("RL.3.31") || c.equals("RL.3.43") || c.equals("RL.3.45") || c.equals("RL.3.50")) return "Donnée documentaire non collectée : documents conformité/paiement/expédition à ajouter";
if (c.equals("RL.3.12")) return "Installation produit hors périmètre ZENER actuel";
if (c.equals("RL.2.4") || c.equals("RL.3.24") || c.equals("RL.3.41") || c.equals("RL.3.42")) return "Dommage/défaut réel non mesuré ; nécessite contrôle qualité livraison/retour";

if (c.equals("RS.1.1")) return "Order Fulfillment Lead Time issu du registre metier CMD, reconstitution liee incluse.";
if (c.equals("RS.3.94")) return "Order Waiting / Dwell Time issu de l'attente de stock explicite imputee depuis REAPPRO.";

if (c.equals("AG.3.38")) return "Nombre de passages Make : codes M1.2 à M1.6";
if (c.equals("AG.3.32")) return "Débit de sortie observé = entités terminées × 3600 / temps de simulation";
if (c.equals("AG.1.1")) return "Coefficient d'adaptabilité = stabilité du débit observé (1 - coefficient de variation)";
if (c.equals("PROXY.AG.SYSTEM_UTILIZATION")) return "Proxy explicite = WIP courant moyen / capacité simultanée totale déclarée";

if (c.equals("CO.1.1")) return "Ratio coût total cumulé / chiffre d'affaire estimé ; nécessite chiffreAffaireParUnite > 0";

if (c.equals("AM.3.9")) return "Disponibilité machine = MTBF/(MTBF+MTTR) dans le profil actuel ; états panne tracés séparément";
if (c.equals("AM.2.2")) return "Inventory Days of Supply = stock observé / débit journalier observé";

String codes = codesProcessusPourMetriqueSCOR(c);
if (!codes.isEmpty()) return "Moyenne des temps de traitement des postes SCOR " + codes + " à partir des KPI de simulation et des traces brutes";

if (c.startsWith("RL.")) return "Estimation depuis les statuts de commande, la conformité client et les retours";
if (c.startsWith("AG.")) return "Données capacité, risque et scénarios d'adaptabilité non encore modélisées";
if (c.startsWith("CO.")) return "Coûts horaires/postes + coûts matière configurés ; les coûts paiement/risque restent non modélisés";
if (c.startsWith("AM.")) return "Stocks observés en simulation, fiches matière, actifs fixes configurés ; données financières à enrichir";
return "Donnée source absente dans la version actuelle";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1801000000015</Id>
					<Name><![CDATA[catalogueMetriquesAHPRows]]></Name>
					<X>-440</X><Y>5020</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String[] lignes = catalogueMetriquesAHPRaw().split("\n");
java.util.ArrayList<Object[]> rows = new java.util.ArrayList<Object[]>();
for (String ligne : lignes) {
    if (ligne == null || ligne.trim().isEmpty()) continue;
    String[] p = ligne.split("\\|", -1);
    if (p.length < 7) continue;
    String rang = p[0];
    String code = p[1];
    String nomEn = p[2];
    String nomFr = p[3];
    String niveau = p[4];
    String cat = p[5];
    String poids = p[6];
    double val = valeurRuntimeMetriqueSCOR(code);
    String valeur = (Double.isNaN(val) || Double.isInfinite(val)) ? "Non calculée" : fmt3(val);
    rows.add(new Object[] {
        rang,
        code,
        nomEn,
        nomFr,
        niveau,
        cat,
        poids,
        statutMetriqueSCOR(code),
        valeur,
        uniteMetriqueSCOR(code),
        sourceFormuleMetriqueSCOR(code)
    });
}
if (rows.isEmpty()) return emptyRows("Catalogue de métriques vide", catalogueMetriquesAHPColumns().length);
return rows.toArray(new Object[0][]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1801000000016</Id>
					<Name><![CDATA[showCatalogueMetriquesAHPTable]]></Name>
					<X>-440</X><Y>5050</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[showJTableDialog(
    "Catalogue SCOR — 139 métriques ; poids historiques documentaires — non utilisés par le PI C14",
    catalogueMetriquesAHPColumns(),
    catalogueMetriquesAHPRows(),
    new int[] {80, 100, 360, 360, 90, 170, 120, 260, 160, 120, 480}
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1801000000021</Id>
					<Name><![CDATA[attributCourtSCOR]]></Name>
					<X>-440</X><Y>5080</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[categorie]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String cat = categorie == null ? "" : categorie.trim().toUpperCase(java.util.Locale.ROOT);
if (cat.startsWith("RELIABILITY")) return "RL";
if (cat.startsWith("RESPONSIVENESS")) return "RS";
if (cat.startsWith("AGILITY")) return "AG";
if (cat.startsWith("COST")) return "CO";
if (cat.startsWith("ASSET")) return "AM";
return cat.length() >= 2 ? cat.substring(0, 2) : cat;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1801000000022</Id>
					<Name><![CDATA[poidsAHPPourCodeSCOR]]></Name>
					<X>-440</X><Y>5110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[code]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String c = code == null ? "" : code.trim().toUpperCase(java.util.Locale.ROOT);
String[] lignes = catalogueMetriquesAHPRaw().split("\n");
for (String ligne : lignes) {
    if (ligne == null || ligne.trim().isEmpty()) continue;
    String[] p = ligne.split("\\|", -1);
    if (p.length < 7) continue;
    if (c.equals(p[1].trim().toUpperCase(java.util.Locale.ROOT))) {
        try { return Double.parseDouble(p[6].trim()) / 100.0; } catch (Throwable ignored) { return 0.0; }
    }
}
return 0.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>2026081300101</Id>
					<Name><![CDATA[scorePerformanceMetriqueSCOR]]></Name>
					<X>-440</X><Y>5520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[code]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[valeur]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (Double.isNaN(valeur) || Double.isInfinite(valeur)) return Double.NaN;
String c = code == null ? "" : code.trim().toUpperCase(java.util.Locale.ROOT);
initialiserProfilsNormalisationDefaut();
NormalizationProfile profil = normalizationProfiles.get(c);
if (profil != null) {
    double score = profil.score10(valeur);
    if (!Double.isNaN(score) && !Double.isInfinite(score)) return score;
}
// Fallbacks non calibres : autorises uniquement pour affichage/diagnostic.
// Ils sont marques comme tels dans les tableaux et ne doivent pas etre presentes comme references terrain.
if (c.startsWith("RL.")) return 10.0*Math.max(0.0,Math.min(1.0,valeur));
if (c.startsWith("RS.")) {
    double borne=3600.0;
    if(c.equals("RS.1.1")||c.equals("RS.3.94")) borne=7200.0;
    return 10.0*Math.max(0.0,Math.min(1.0,1.0-valeur/Math.max(1.0,borne)));
}
if (c.equals("AG.3.1") || c.equals("AG.3.2")) return 10.0*Math.max(0.0,Math.min(1.0,1.0-valeur/100.0));
if (c.startsWith("AG.")) return valeur>0?10.0:0.0;
if (c.startsWith("CO.")) return 10.0*Math.max(0.0,Math.min(1.0,1.0/(1.0+Math.max(0.0,valeur)/100000.0)));
if (c.startsWith("AM.")) return 10.0*Math.max(0.0,Math.min(1.0,1.0/(1.0+Math.max(0.0,valeur)/30.0)));
return Double.NaN;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>2026081300102</Id>
					<Name><![CDATA[testerReferenceTheeranuphattana]]></Name>
					<X>-440</X><Y>5550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[NormalizationProfile pof=new NormalizationProfile("POF_REFERENCE","BENEFIT",70.0,100.0,"THEERANUPHATTANA_TABLE_VI","REF");
double score=pof.score10(90.1);
FuzzyGradeSet g=FuzzyGradeSet.depuisScore(score);
FuzzyGradeSet global=new FuzzyGradeSet(0.004,0.147,0.138,0.353,0.297,0.061);
double pi=global.defuzzifier();
boolean okScore=Math.abs(score-6.700)<0.002;
boolean okGrade=Math.abs(g.B-0.350)<0.002 && Math.abs(g.C-0.650)<0.002;
boolean okPI=Math.abs(pi-4.050)<0.002;
boolean ok=okScore&&okGrade&&okPI;
if(board!=null) board.logEvent(String.format(java.util.Locale.US,"[THEERANUPHATTANA-SELFTEST] POFscore=%.3f B=%.3f C=%.3f | PIref=%.3f | %s",score,g.B,g.C,pi,ok?"PASS":"FAIL"));
return ok;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1801000000023</Id>
					<Name><![CDATA[normaliserValeurMetriqueSCOR]]></Name>
					<X>-440</X><Y>5140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[code]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[valeur]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Compatibilite historique : retourne score10 / 10. Le moteur C13 utilise
// scorePerformanceMetriqueSCOR() pour conserver explicitement l'echelle 0..10.
double s = scorePerformanceMetriqueSCOR(code,valeur);
return Double.isNaN(s) ? Double.NaN : s/10.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1801000000024</Id>
					<Name><![CDATA[estMetriqueSCORDisponiblePourTableaux]]></Name>
					<X>-440</X><Y>5170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[code]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[double v = valeurRuntimeMetriqueSCOR(code);
if (Double.isNaN(v) || Double.isInfinite(v)) return false;
String statut = statutMetriqueSCOR(code);
if (statut == null) return false;
String s = statut.toUpperCase(java.util.Locale.ROOT);
return !s.contains("NON CALCULABLE") && !s.contains("NON APPLICABLE");]]></Body>
