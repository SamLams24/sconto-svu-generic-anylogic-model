			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000830</Id>
					<Name><![CDATA[decider]]></Name>
					<X>210</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();
if (main == null || main.board == null) return;
double wt = 0;
boolean trouve = false;
for (PosteGenericAgent p : postesLies) {
    KPIBundle k = main.board.kpiParPoste.get(main.cleKPI(p));
    if (k != null) { wt = Math.max(wt, k.avgWaitTime()); trouve = true; }
}
if (!trouve) return;
if (wt > seuilSurcharge) {
    etatHolon = "SURCHARGE";
    main.board.logEvent("[OPERATIONAL] " + idPoste + " surcharge WT=" + String.format("%.1f", wt) + "s");
} else if (wt < seuilSurcharge * 0.5) {
    etatHolon = "NORMAL";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000831</Id>
					<Name><![CDATA[executerTache]]></Name>
					<X>210</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[instruction]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[Main main = (Main) getOwner();
if ("ACTIVER".equals(instruction)) {
    etatHolon = "ACTIF";
    if (main != null && main.board != null) main.board.logEvent("[OPERATIONAL] " + idPoste + " active");
} else if ("PAUSE".equals(instruction)) {
    etatHolon = "EN_PAUSE";
} else if ("PRIORITE_HAUTE".equals(instruction)) {
    etatHolon = "PRIORITAIRE";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781622427964</Id>
					<Name><![CDATA[initialiser]]></Name>
					<X>210</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// codeSCOR ici est la CLEF DE GROUPE complete (ex "ACT_4|M1.3"), pas le
// code SCOR individuel du poste. Le libelle lisible ([XXX] N3) est calcule
// separement pour l'affichage (badges/pastilles), sans jamais servir de clef.
Main main = (Main) getOwner();
this.idPoste   = p.idPoste;
this.nomPoste  = p.nom;
this.codeSCOR  = codeSCOR;
this.libelleAffichage = main.libelleGroupeF(p);
this.categorieOP = main.categoriserActiviteSCOR(main.codeGroupeL3(p.codeSCOR), p.nom);
this.idActeurSC = p.idActeurResponsable;
this.nomActeurSC = p.nomActeurResponsable;
this.postesLies.add(p);
this.etatHolon = "IDLE";
this.tEntreeEtatCourant = time();

main.board.logEvent(
    "[HOLON-OP] " + idPoste + " (" + nomPoste + ") initialisé"
    + " | groupe=" + libelleAffichage
    + " | ISA-95 N" + p.niveauISA95
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1799300000020</Id>
					<Name><![CDATA[ajouterPosteLie]]></Name>
					<X>210</X><Y>140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Body><![CDATA[// Rattache un poste supplementaire a un operationnel DEJA existant
// (regroupement global par (acteur, SCOR N3) : voir Main.recalculerTousLesGroupesOperationnels()).
// Le nom du poste "chef de file" (nomPoste) et le libelle d'affichage NE
// changent PAS a chaque ajout : concatener tous les noms rendait le badge
// illisible des le 2e poste rattache. Le detail des postes du groupe reste
// consultable via postesLies (ex. dans un rapport ou une infobulle).
this.postesLies.add(p);
((Main) getOwner()).board.logEvent(
    "[HOLON-OP] " + p.nom + " rattache au groupe " + libelleAffichage + " (operationnel " + idPoste + ")"
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000007201</Id>
					<Name><![CDATA[signalerPanne]]></Name>
					<X>210</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[posteEnPanne]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[dureeEstimeeSec]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Escalade IMMEDIATE au moment ou une panne survient, sans attendre le
// prochain cycle regulier de analyserEtat() (jusqu'a 10s de latence).
// Reutilise le meme canal AER que les goulots, avec le sujet "PANNE".
Main main = (Main) getOwner();
BlackboardAgent board = main.board;
if (board == null) return;

etatHolon = "PANNE";
tEntreeEtatCourant = time();
nbGoulotsDetectes++;
nbAlertesEmises++;

AERMessage msg = new AERMessage(
    AERMessage.REPORT,
    posteEnPanne.idPoste,
    "SUPERVISOR",
    "PANNE",
    "duree_estimee=" + String.format("%.0f", dureeEstimeeSec) + "s"
    + ";poste=" + posteEnPanne.nom,
    time()
);
board.logEvent("[HOLON-OP] " + idPoste + " -> PANNE (poste " + posteEnPanne.nom
    + ", duree estimee " + String.format("%.0f", dureeEstimeeSec / 60.0) + " min)");

String macroCible = main.macroPrefixe(codeSCOR);
CoordinatorAgent svCible = null;
for (CoordinatorAgent sv : main.supervisorsMacro) {
    if (macroCible.equals(sv.idMacroProcessus)) { svCible = sv; break; }
}
if (svCible != null) {
    svCible.recevoirAlerteGoulot(idPoste, nomPoste, codeSCOR, 0, 0, msg);
} else {
    main.supervisor.recevoirAlerteGoulot(idPoste, nomPoste, codeSCOR, 0, 0, msg);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781622490774</Id>
					<Name><![CDATA[analyserEtat]]></Name>
					<X>210</X><Y>160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (postesLies == null || postesLies.isEmpty()) return;

Main main = (Main) getOwner();
BlackboardAgent board = main.board;

// ── Lecture de l'état physique agrégé sur tous les postes du groupe ──
int tailleFile = 0;
int enTraitement = 0;
double wtMoyen = 0;
double ctMoyen = 0;
for (PosteGenericAgent p : postesLies) {
    tailleFile   += p.queue.size();
    enTraitement += p.delay.size();
    KPIBundle kpi = board.kpiParPoste.get(main.cleKPI(p));
    if (kpi != null) {
        wtMoyen = Math.max(wtMoyen, kpi.avgWaitTime());
        ctMoyen = Math.max(ctMoyen, kpi.avgCycleTime());
    }
}
boolean positionOccupee = (tailleFile > 0 || enTraitement > 0);

// ── Panne en cours ? Prioritaire sur la determination normale ────
boolean panneActive = false;
for (PosteGenericAgent p : postesLies) {
    if (p.enPanne) { panneActive = true; break; }
}

// ── Détermination de l'état holonique ────────────────────────────
String nouvelEtat;
if (panneActive) {
    nouvelEtat = "PANNE";
} else if (!positionOccupee) {
    nouvelEtat = "IDLE";
} else if (tailleFile > seuilAlertFile || wtMoyen > seuilGoulotWT) {
    nouvelEtat = "GOULOT";
} else {
    nouvelEtat = "WORKING";
}

// ── Transition d'état : log uniquement si changement ─────────────
if (!nouvelEtat.equals(etatHolon)) {
    etatHolon = nouvelEtat;
    tEntreeEtatCourant = time();
    board.logEvent(
        "[HOLON-OP] " + idPoste + " → " + etatHolon
        + " (file=" + tailleFile
        + " WT=" + String.format("%.1f", wtMoyen) + "s)"
    );
}

// ── Mise à jour du flag goulot sur TOUS les postes du groupe ──────
for (PosteGenericAgent p : postesLies) {
    p.goulot = etatHolon.equals("GOULOT") || etatHolon.equals("PANNE");
}

// ── Émission alerte AER vers CoordinatorAgent si GOULOT ou PANNE ──
if (etatHolon.equals("GOULOT") || etatHolon.equals("PANNE")) {
    nbGoulotsDetectes++;
    nbAlertesEmises++;

    // Construire le message AER (Amendment → décision remontée)
    AERMessage msg = new AERMessage(
        AERMessage.REPORT,
        idPoste,
        "SUPERVISOR",
        etatHolon,
        "WT=" + String.format("%.2f", wtMoyen)
        + ";file=" + tailleFile
        + ";CT=" + String.format("%.2f", ctMoyen),
        time()
    );

    // Notifier le CoordinatorAgent DEDIE a ce macro-processus (pas le singleton
    // global "supervisor", qui n'est pas celui affiche/anime dans la vue
    // hierarchique -- c'etait le 2e bug empechant toute reaction visible).
    String macroCible = main.macroPrefixe(codeSCOR);
    CoordinatorAgent svCible = null;
    for (CoordinatorAgent sv : main.supervisorsMacro) {
        if (macroCible.equals(sv.idMacroProcessus)) { svCible = sv; break; }
    }
    if (svCible != null) {
        svCible.recevoirAlerteGoulot(idPoste, nomPoste, codeSCOR, wtMoyen, tailleFile, msg);
    } else {
        // repli : coordinateur global, au cas ou le macro ne correspond a aucun des 4
        main.supervisor.recevoirAlerteGoulot(idPoste, nomPoste, codeSCOR, wtMoyen, tailleFile, msg);
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781622520217</Id>
					<Name><![CDATA[getRapportHolon]]></Name>
					<X>250</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (postesLies == null || postesLies.isEmpty()) return idPoste + " : non initialisé";

BlackboardAgent board = ((Main) getOwner()).board;
double ct = 0, wt = 0; long n = 0; int tailleFile = 0;
for (PosteGenericAgent p : postesLies) {
    KPIBundle kpi = board.kpiParPoste.get(((Main) getOwner()).cleKPI(p));
    if (kpi != null) {
        ct = Math.max(ct, kpi.avgCycleTime());
        wt = Math.max(wt, kpi.avgWaitTime());
        n += kpi.count;
    }
    tailleFile += p.queue.size();
}

double dureeDansEtat = time() - tEntreeEtatCourant;

return String.format(
    "[%s] %-18s %-6s | Etat:%-8s (%5.0fs) | file:%2d | CT:%5.1fs | WT:%5.1fs | N:%d | G:%d",
    idPoste, nomPoste, codeSCOR, etatHolon, dureeDansEtat,
    tailleFile, ct, wt, n, nbGoulotsDetectes
);]]></Body>
				</Function>
			</Functions>
