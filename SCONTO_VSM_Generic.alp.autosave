					<X>-440</X><Y>3940</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "N° sequentiel de la trace",
    "Temps de simulation (secondes)",
    "Niveau d'agregation (MICRO_ACTIVITE/SCOR_N3/GLOBAL)",
    "Source de l'agregation (agent/poste)",
    "Identifiant du poste",
    "Code SCOR (niveau 3)",
    "Nom de la mesure agregee",
    "Derniere valeur brute ayant contribue",
    "Valeur agregee resultante (cumul/moyenne)",
    "Formule de calcul exacte"
};]]></Body>
