				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1781939929800</Id>
					<Name><![CDATA[acteurMicroComboItems]]></Name>
					<X>-530</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (acteursSC == null || acteursSC.isEmpty()) {
        return new String[] { "(aucun acteur configuré)" };
    }

    java.util.ArrayList<String> items = new java.util.ArrayList<String>();

    for (ActeurSC a : acteursSC) {
        if (!a.actif) continue;

        items.add(
            a.idActeur
            + " — "
            + a.nom
            + " ["
            + a.typeAffiche()
            + "]"
        );
    }

    if (items.isEmpty()) {
        return new String[] { "(aucun acteur actif)" };
    }

    return items.toArray(new String[0]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781939983064</Id>
					<Name><![CDATA[refreshActeursMicroComboBox]]></Name>
					<X>-300</X><Y>390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
        String[] items = acteurMicroComboItems();

        comboActeurMicro.setItems(items);

        if (items.length > 0
            && !items[0].startsWith("(aucun")
            && (champActeurLieMicro == null || champActeurLieMicro.trim().isEmpty())) {
            champActeurLieMicro = items[0];
        }

    } catch (Exception ex) {
        traceln("Erreur refreshActeursMicroComboBox : " + ex.getMessage());
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781940054070</Id>
					<Name><![CDATA[extraireIdActeurDepuisCombo]]></Name>
					<X>-570</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[selection]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (selection == null) return "";

String s = selection.trim();

if (s.isEmpty()) return "";
if (s.startsWith("(aucun")) return "";

if (s.contains(" — ")) {
        return s.split(" — ")[0].trim();
}

return s;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ActeurSC]]></ReturnType>
					<Id>1781940122124</Id>
					<Name><![CDATA[trouverActeurParId]]></Name>
					<X>-570</X><Y>330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idActeur]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (idActeur == null) return null;

String id = idActeur.trim();

for (ActeurSC a : acteursSC) {
        if (a.idActeur.equals(id)) {
            return a;
        }
}

return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781941641585</Id>
					<Name><![CDATA[tableActeursChaineText]]></Name>
					<X>-300</X><Y>1910</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {8, 24, 20, 24, 34, 28, 8};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "VUE LOGISTIQUE — ACTEURS DE LA CHAINE CONFIGURES",
        w
    ));

    sb.append(tableRow(new String[]{
        "ID",
        "Nom",
        "Categorie",
        "Type annexe",
        "Description",
        "Micro-activites",
        "Actif"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (acteursSC == null || acteursSC.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", "Aucun acteur configure", "-", "-", "-", "-", "-"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    for (ActeurSC a : acteursSC) {
        sb.append(tableRow(new String[]{
            a.idActeur,
            a.nom,
            a.categorie,
            a.typeAnnexe == null || a.typeAnnexe.isEmpty() ? "-" : a.typeAnnexe,
            a.description,
            a.microActivitesText(),
            a.actif ? "Oui" : "Non"
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781941749823</Id>
					<Name><![CDATA[acteursParCategorieText]]></Name>
					<X>-300</X><Y>1930</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[categorie]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[StringBuilder sb = new StringBuilder();

    int n = 0;

    for (ActeurSC a : acteursSC) {
        if (!categorie.equals(a.categorie)) continue;

        n++;

        sb.append("[")
          .append(a.idActeur)
          .append("] ")
          .append(a.nom);

        if (a.typeAnnexe != null && !a.typeAnnexe.isEmpty()) {
            sb.append(" (").append(a.typeAnnexe).append(")");
        }

        sb.append(" | Micro-activites : ")
          .append(a.microActivitesText())
          .append("\n");
    }

    if (n == 0) {
        return "(aucun acteur dans la categorie " + categorie + ")";
    }

return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
