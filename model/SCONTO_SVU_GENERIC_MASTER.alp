					<X>-300</X><Y>1960</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return acteursParCategorieText(ActeurSC.ACTEUR_ANNEXE);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781951345912</Id>
					<Name><![CDATA[typeAgentPourNiveau]]></Name>
					<X>-300</X><Y>1990</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[niveau]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (niveau == null) return "OperationalAgent";

    String n = niveau.trim().toUpperCase();

    if (NIVEAU_STRATEGIC.equals(n)) {
        return "StrategicAgent";
    }

    if (NIVEAU_TACTICAL.equals(n)) {
        return "TacticalAgent";
    }

    if (NIVEAU_OPERATIONAL.equals(n)) {
        return "OperationalAgent";
    }

    if (NIVEAU_MACHINE.equals(n)) {
        return "MachineSim";
    }

    return "OperationalAgent";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1781951426256</Id>
					<Name><![CDATA[isTacticPourNiveau]]></Name>
					<X>-300</X><Y>2020</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[niveau]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[return NIVEAU_TACTICAL.equals(
        niveau == null ? "" : niveau.trim().toUpperCase()
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1781951553639</Id>
					<Name><![CDATA[microActiviteComboItems]]></Name>
					<X>-300</X><Y>2050</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (postes == null || postes.isEmpty()) {
        return new String[] { "(aucune micro-activité configurée)" };
    }

    String[] items = new String[postes.size()];

    for (int i = 0; i < postes.size(); i++) {
        PosteGenericAgent p = postes.get(i);

        items[i] =
            p.idPoste
            + " — "
            + p.nom
            + " ["
            + p.codeSCOR
            + "]";
    }

    return items;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781951644576</Id>
					<Name><![CDATA[refreshMicroActiviteComboBox]]></Name>
					<X>-300</X><Y>2080</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
        String[] items = microActiviteComboItems();
        comboRespMicro.setItems(items);

        if (items.length > 0 && !items[0].startsWith("(aucune")) {
            if (champRespMicro == null || champRespMicro.trim().isEmpty()) {
                champRespMicro = items[0];
            }
        }

} catch (Exception ex) {
        traceln("Erreur refreshMicroActiviteComboBox : " + ex.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781951779685</Id>
					<Name><![CDATA[extraireIdMicroDepuisCombo]]></Name>
					<X>-300</X><Y>2110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[selection]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (selection == null) return "";

    String s = selection.trim();

    if (s.isEmpty()) return "";
    if (s.startsWith("(aucune")) return "";

    if (s.contains(" — ")) {
        return s.split(" — ")[0].trim();
    }

return s;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[OperationalAgent]]></ReturnType>
					<Id>1781951984499</Id>
					<Name><![CDATA[trouverOperationalAgentParPoste]]></Name>
					<X>2520</X><Y>-1050</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (idPoste == null) return null;

    for (OperationalAgent op : opAgents) {
        if (op.idPoste != null && op.idPoste.equals(idPoste)) {
            return op;
        }
    }

return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781952066308</Id>
					<Name><![CDATA[ajouterResponsabiliteMicroUI]]></Name>
					<X>-300</X><Y>2140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String idMicro = extraireIdMicroDepuisCombo(champRespMicro);
    PosteGenericAgent p = trouverPoste(idMicro);

    if (p == null) {
        getExperimentHost().showMessageDialog(
            "❌ Micro-activité introuvable\n\nVeuillez sélectionner une micro-activité valide."
        );
        return;
    }

    String idActeur = extraireIdActeurDepuisCombo(champRespActeur);
    ActeurSC acteur = trouverActeurParId(idActeur);

    if (acteur == null) {
        getExperimentHost().showMessageDialog(
            "❌ Acteur introuvable\n\nVeuillez sélectionner un acteur valide."
        );
        return;
    }

    String niveau = champRespNiveau != null
        ? champRespNiveau.trim().toUpperCase()
        : NIVEAU_OPERATIONAL;

    if (!NIVEAU_STRATEGIC.equals(niveau)
        && !NIVEAU_TACTICAL.equals(niveau)
        && !NIVEAU_OPERATIONAL.equals(niveau)
        && !NIVEAU_MACHINE.equals(niveau)) {

        getExperimentHost().showMessageDialog(
            "❌ Niveau invalide\n\n"
            + "Valeurs acceptées : STRATEGIC, TACTICAL, OPERATIONAL, MACHINE."
        );
        return;
    }

    int qte = Math.max(1, champRespQuantite);

    MicroResponsabilite r = new MicroResponsabilite();

    r.idResponsabilite = "RESP_" + (++seqResponsabilite);
    r.idMicroActivite = p.idPoste;
    r.nomMicroActivite = p.nom;

    r.idActeur = acteur.idActeur;
    r.nomActeur = acteur.nom;
    r.categorieActeur = acteur.categorie;
    r.typeAnnexeActeur = acteur.typeAnnexe;

    r.niveauHierarchique = niveau;
    r.typeAgent = typeAgentPourNiveau(niveau);
    r.isTactic = isTacticPourNiveau(niveau);
    r.quantite = qte;
    r.actif = true;

    responsabilitesMicro.add(r);

    if (!p.idsResponsabilites.contains(r.idResponsabilite)) {
        p.idsResponsabilites.add(r.idResponsabilite);
    }

    acteur.ajouterMicroActivite(p.idPoste);

    if (NIVEAU_OPERATIONAL.equals(niveau)) {
        creerOperationalAgentsPourResponsabilite(r, p, qte);
    }

    if (NIVEAU_MACHINE.equals(niveau)) {
        creerMachinesPourResponsabilite(r, p, qte);
    }

    board.logEvent(
        "[RESP] "
        + r.idResponsabilite
        + " | "
        + p.idPoste
        + " -> "
        + acteur.nom
        + " | niveau="
        + niveau
        + " | qte="
        + qte
    );

    getExperimentHost().showMessageDialog(
        "✅ Responsabilité ajoutée\n\n"
        + "Micro-activité : " + p.idPoste + " — " + p.nom + "\n"
        + "Acteur         : " + acteur.nom + " [" + acteur.typeAffiche() + "]\n"
        + "Niveau         : " + niveau + "\n"
        + "Type agent     : " + r.typeAgent + "\n"
        + "Quantité       : " + qte + "\n"
        + "Agents créés   : " + r.idsAgentsText() + "\n"
        + "Machines       : " + r.idsMachinesText()
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781952122823</Id>
					<Name><![CDATA[creerOperationalAgentsPourResponsabilite]]></Name>
					<X>-300</X><Y>2170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[r]]></Name>
						<Type><![CDATA[MicroResponsabilite]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[qte]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int dejaAffectes = 0;

    // 1. Réutiliser l'OperationalAgent automatique déjà créé avec le poste
    OperationalAgent opAuto = trouverOperationalAgentParPoste(p.idPoste);

    if (opAuto != null && !p.idsOperationalAgents.contains(opAuto.getName())) {
        opAuto.idResponsabilite = r.idResponsabilite;
        opAuto.idActeurSC = r.idActeur;
        opAuto.nomActeurSC = r.nomActeur;
        opAuto.niveauHierarchique = r.niveauHierarchique;

        p.idsOperationalAgents.add(opAuto.getName());
        r.idsAgentsCrees.add(opAuto.getName());

        dejaAffectes++;
    }

    // 2. Créer les agents opérationnels supplémentaires si quantité > 1
    for (int i = dejaAffectes; i < qte; i++) {
        OperationalAgent op = add_opAgents();

        op.initialiser(p, p.codeSCOR);

        op.idResponsabilite = r.idResponsabilite;
        op.idActeurSC = r.idActeur;
        op.nomActeurSC = r.nomActeur;
        op.niveauHierarchique = r.niveauHierarchique;
        op.numeroInstance = i + 1;

        String idOp = "OP_" + p.idPoste + "_" + r.idActeur + "_" + (i + 1);

        op.idAgentLogique = idOp;

        p.idsOperationalAgents.add(idOp);
        r.idsAgentsCrees.add(idOp);

        board.logEvent(
            "[HOLON] OperationalAgent créé : "
            + idOp
            + " pour "
            + p.idPoste
            + " / "
            + r.nomActeur
        );
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781952267048</Id>
					<Name><![CDATA[creerMachinesPourResponsabilite]]></Name>
					<X>-300</X><Y>2200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[r]]></Name>
						<Type><![CDATA[MicroResponsabilite]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[qte]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < qte; i++) {
        String idMachine = "MACH_" + (++seqMachineSim);

        String idOp = "-";

        if (p.idsOperationalAgents != null && !p.idsOperationalAgents.isEmpty()) {
            idOp = p.idsOperationalAgents.get(i % p.idsOperationalAgents.size());
        }

        MachineSim m = new MachineSim(
            idMachine,
            "Machine " + idMachine,
            p.idPoste,
            p.nom,
            idOp,
            champMachineType,
            Math.max(1, champMachineCapacite),
            champMachineCycleTime,
            champMachineMTBF,
            champMachineMTTR
        );

        machinesSim.add(m);

        if (!p.idsMachines.contains(idMachine)) {
            p.idsMachines.add(idMachine);
        }

        r.idsMachinesAffectees.add(idMachine);

        board.logEvent(
            "[MACHINE] "
            + idMachine
            + " affectée à "
            + p.idPoste
            + " / OP="
            + idOp
        );
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781955920001</Id>
					<Name><![CDATA[updateRespMachineFieldsVisibility]]></Name>
					<X>-300</X><Y>2230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[boolean show = NIVEAU_MACHINE.equals(champRespNiveau);

    // Labels existants
    text77.setVisible(show); // Capacité
    text78.setVisible(show); // Cycle time
    text82.setVisible(show); // MTBF
    text83.setVisible(show); // MTTR
    lblMachineType.setVisible(show);

    // Champs existants
    capacite.setVisible(show);
    cycle_time.setVisible(show);
    mtbf_value.setVisible(show);
    mttr_value.setVisible(show);
    editMachineType.setVisible(show);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781954266400</Id>
					<Name><![CDATA[tableResponsabilitesMicroText]]></Name>
					<X>-440</X><Y>3160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {9, 12, 20, 22, 14, 16, 6, 26, 26};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "RESPONSABILITES HIERARCHIQUES DES MICRO-ACTIVITES",
        w
    ));

    sb.append(tableRow(new String[]{
        "ID Resp",
        "Micro",
        "Nom micro",
        "Acteur",
        "Niveau",
        "Type agent",
        "Qte",
        "Agents",
        "Machines"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (responsabilitesMicro == null || responsabilitesMicro.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", "-", "Aucune responsabilite", "-", "-", "-", "0", "-", "-"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    for (MicroResponsabilite r : responsabilitesMicro) {
        sb.append(tableRow(new String[]{
            r.idResponsabilite,
            r.idMicroActivite,
            r.nomMicroActivite,
            r.nomActeur,
            r.niveauHierarchique,
            r.typeAgent,
            String.valueOf(r.quantite),
            r.idsAgentsText(),
            r.idsMachinesText()
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

    return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781954352009</Id>
					<Name><![CDATA[tableMachinesSimText]]></Name>
					<X>-440</X><Y>3180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {10, 18, 12, 18, 18, 10, 8, 10, 8, 8};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "MACHINES LOGIQUES AFFECTEES AUX MICRO-ACTIVITES",
        w
    ));

    sb.append(tableRow(new String[]{
        "ID",
        "Nom",
        "Micro",
        "Nom micro",
        "OP lie",
        "Type",
        "Cap.",
        "Temps de traitement",
        "MTBF",
        "MTTR"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (machinesSim == null || machinesSim.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", "Aucune machine", "-", "-", "-", "-", "0", "0", "0", "0"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    for (MachineSim m : machinesSim) {
        sb.append(tableRow(new String[]{
            m.idMachine,
            m.nom,
            m.idMicroActivite,
            m.nomMicroActivite,
            m.idOperationalAgent,
            m.type,
            String.valueOf(m.capacite),
            fmt2(m.cycleTime),
            fmt2(m.mtbf),
            fmt2(m.mttr)
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

    return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781959000001</Id>
					<Name><![CDATA[exportTableToCSV]]></Name>
					<X>-440</X><Y>3210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[filename]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[columns]]></Name>
						<Type><![CDATA[String[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[rows]]></Name>
						<Type><![CDATA[Object[][]]]></Type>
					</Parameter>
					<Body><![CDATA[try {
    java.io.PrintWriter pw = new java.io.PrintWriter(
        new java.io.OutputStreamWriter(
            new java.io.FileOutputStream(filename),
            java.nio.charset.StandardCharsets.UTF_8
        )
    );

    StringBuilder header = new StringBuilder();
    for (int c = 0; c < columns.length; c++) {
        if (c > 0) header.append(";");
        header.append(columns[c] == null ? "" : columns[c]);
    }
    pw.println(header.toString());

    for (Object[] row : rows) {
        StringBuilder line = new StringBuilder();
        for (int c = 0; c < row.length; c++) {
            if (c > 0) line.append(";");
            line.append(row[c] == null ? "" : row[c].toString());
        }
        pw.println(line.toString());
    }

    pw.close();

    getExperimentHost().showMessageDialog(
        "✅ Export CSV réussi\n\nFichier : " + filename
    );

} catch (Exception ex) {
    getExperimentHost().showMessageDialog(
        "❌ Erreur export CSV\n\n" + ex.getMessage()
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781960000001</Id>
					<Name><![CDATA[showJTableDialog]]></Name>
					<X>-440</X><Y>3220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[title]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[columns]]></Name>
						<Type><![CDATA[String[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[rows]]></Name>
						<Type><![CDATA[Object[][]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[widths]]></Name>
						<Type><![CDATA[int[]]]></Type>
					</Parameter>
					<Body><![CDATA[final String fTitle = title;
final String[] fColumns = columns;
final Object[][] fRows = rows;
final int[] fWidths = widths;

traceln("[JTABLE] Demande ouverture : " + fTitle
    + " | colonnes=" + (fColumns == null ? 0 : fColumns.length)
    + " | lignes=" + (fRows == null ? 0 : fRows.length)
);

javax.swing.SwingUtilities.invokeLater(new Runnable() {
    public void run() {
        try {
            java.awt.Window owner =
                java.awt.KeyboardFocusManager
                    .getCurrentKeyboardFocusManager()
                    .getActiveWindow();

            final javax.swing.JDialog dialog;

            if (owner != null) {
                dialog = new javax.swing.JDialog(
                    owner,
                    fTitle,
                    java.awt.Dialog.ModalityType.MODELESS
                );
            } else {
                dialog = new javax.swing.JDialog(
                    (java.awt.Frame) null,
                    fTitle,
                    false
                );
            }

            dialog.setDefaultCloseOperation(javax.swing.WindowConstants.DISPOSE_ON_CLOSE);
            dialog.setLayout(new java.awt.BorderLayout());

            javax.swing.table.DefaultTableModel model =
                new javax.swing.table.DefaultTableModel(fRows, fColumns) {
                    @Override
                    public boolean isCellEditable(int row, int column) {
                        return false;
                    }
                };

            javax.swing.JTable table = new javax.swing.JTable(model);

            table.setAutoCreateRowSorter(true);
            table.setFillsViewportHeight(true);
            table.setRowHeight(26);
            table.setAutoResizeMode(javax.swing.JTable.AUTO_RESIZE_OFF);
            table.setFont(new java.awt.Font("Dialog", java.awt.Font.PLAIN, 12));

            javax.swing.table.JTableHeader header = table.getTableHeader();
            header.setReorderingAllowed(false);
            header.setFont(new java.awt.Font("Dialog", java.awt.Font.BOLD, 12));

            javax.swing.table.DefaultTableCellRenderer centerRenderer =
                new javax.swing.table.DefaultTableCellRenderer();

            centerRenderer.setHorizontalAlignment(javax.swing.SwingConstants.CENTER);

            for (int i = 0; i < table.getColumnCount(); i++) {
                if (fWidths != null && i < fWidths.length) {
                    table.getColumnModel().getColumn(i).setPreferredWidth(fWidths[i]);
                } else {
                    table.getColumnModel().getColumn(i).setPreferredWidth(120);
                }

                if (i == 0) {
                    table.getColumnModel().getColumn(i).setCellRenderer(centerRenderer);
                }
            }

            javax.swing.JScrollPane scrollPane = new javax.swing.JScrollPane(table);
            dialog.add(scrollPane, java.awt.BorderLayout.CENTER);

            javax.swing.JPanel bottomPanel =
                new javax.swing.JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.RIGHT));

            javax.swing.JButton exportButton = new javax.swing.JButton("Exporter CSV");
            exportButton.addActionListener(new java.awt.event.ActionListener() {
                public void actionPerformed(java.awt.event.ActionEvent e) {
                    String safeName = fTitle.replaceAll("[^a-zA-Z0-9]+", "_");
                    exportTableToCSV("export_" + safeName + ".csv", fColumns, fRows);
                }
            });

            javax.swing.JButton closeButton = new javax.swing.JButton("Fermer");
            closeButton.addActionListener(new java.awt.event.ActionListener() {
                public void actionPerformed(java.awt.event.ActionEvent e) {
                    dialog.dispose();
                }
            });

            bottomPanel.add(exportButton);
            bottomPanel.add(closeButton);
            dialog.add(bottomPanel, java.awt.BorderLayout.SOUTH);

            dialog.setSize(1200, 650);
            dialog.setMinimumSize(new java.awt.Dimension(900, 500));
            dialog.setLocationRelativeTo(owner);

            dialog.setAlwaysOnTop(true);
            dialog.setVisible(true);
            dialog.toFront();
            dialog.requestFocus();

            traceln("[JTABLE] Fenêtre affichée : " + fTitle);

        } catch (Throwable ex) {
            ex.printStackTrace();

            try {
                getExperimentHost().showMessageDialog(
                    "❌ Erreur ouverture JTable\n\n"
                    + "Titre : " + fTitle + "\n"
                    + "Erreur : " + ex.getClass().getName() + "\n"
                    + "Message : " + ex.getMessage()
                );
            } catch (Throwable ignored) {
                traceln("[JTABLE] Erreur critique : " + ex.getMessage());
            }
        }
    }
});]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781960000002</Id>
					<Name><![CDATA[showTabbedJTableDialog]]></Name>
					<X>-440</X><Y>3260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[title]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[tabTitles]]></Name>
						<Type><![CDATA[String[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[columnsList]]></Name>
						<Type><![CDATA[String[][]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[rowsList]]></Name>
						<Type><![CDATA[Object[][][]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[widthsList]]></Name>
						<Type><![CDATA[int[][]]]></Type>
					</Parameter>
					<Body><![CDATA[final String fTitle = title;
final String[] fTabTitles = tabTitles;
final String[][] fColumnsList = columnsList;
final Object[][][] fRowsList = rowsList;
final int[][] fWidthsList = widthsList;

traceln("[JTABBED] Demande ouverture : " + fTitle);

javax.swing.SwingUtilities.invokeLater(new Runnable() {
    public void run() {
        try {
            java.awt.Window owner =
                java.awt.KeyboardFocusManager
                    .getCurrentKeyboardFocusManager()
                    .getActiveWindow();

            final javax.swing.JDialog dialog;

            if (owner != null) {
                dialog = new javax.swing.JDialog(
                    owner,
                    fTitle,
                    java.awt.Dialog.ModalityType.MODELESS
                );
            } else {
                dialog = new javax.swing.JDialog(
                    (java.awt.Frame) null,
                    fTitle,
                    false
                );
            }

            dialog.setDefaultCloseOperation(javax.swing.WindowConstants.DISPOSE_ON_CLOSE);
            dialog.setLayout(new java.awt.BorderLayout());

            javax.swing.JTabbedPane tabs = new javax.swing.JTabbedPane();

            for (int t = 0; t < fTabTitles.length; t++) {
                String[] columns = fColumnsList[t];
                Object[][] rows = fRowsList[t];
                int[] widths =
                    fWidthsList != null && t < fWidthsList.length
                    ? fWidthsList[t]
                    : null;

                javax.swing.table.DefaultTableModel model =
                    new javax.swing.table.DefaultTableModel(rows, columns) {
                        @Override
                        public boolean isCellEditable(int row, int column) {
                            return false;
                        }
                    };

                javax.swing.JTable table = new javax.swing.JTable(model);
                table.setAutoCreateRowSorter(true);
                table.setFillsViewportHeight(true);
                table.setRowHeight(26);
                table.setAutoResizeMode(javax.swing.JTable.AUTO_RESIZE_OFF);
                table.setFont(new java.awt.Font("Dialog", java.awt.Font.PLAIN, 12));

                javax.swing.table.JTableHeader header = table.getTableHeader();
                header.setReorderingAllowed(false);
                header.setFont(new java.awt.Font("Dialog", java.awt.Font.BOLD, 12));

                for (int i = 0; i < table.getColumnCount(); i++) {
                    if (widths != null && i < widths.length) {
                        table.getColumnModel().getColumn(i).setPreferredWidth(widths[i]);
                    } else {
                        table.getColumnModel().getColumn(i).setPreferredWidth(120);
                    }
                }

                javax.swing.JScrollPane scrollPane = new javax.swing.JScrollPane(table);
                tabs.addTab(fTabTitles[t], scrollPane);
            }

            dialog.add(tabs, java.awt.BorderLayout.CENTER);

            javax.swing.JPanel bottomPanel =
                new javax.swing.JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.RIGHT));

            javax.swing.JButton closeButton = new javax.swing.JButton("Fermer");
            closeButton.addActionListener(new java.awt.event.ActionListener() {
                public void actionPerformed(java.awt.event.ActionEvent e) {
                    dialog.dispose();
                }
            });

            bottomPanel.add(closeButton);
            dialog.add(bottomPanel, java.awt.BorderLayout.SOUTH);

            dialog.setSize(1250, 700);
            dialog.setMinimumSize(new java.awt.Dimension(950, 520));
            dialog.setLocationRelativeTo(owner);

            dialog.setAlwaysOnTop(true);
            dialog.setVisible(true);
            dialog.toFront();
            dialog.requestFocus();

            traceln("[JTABBED] Fenêtre affichée : " + fTitle);

        } catch (Throwable ex) {
            ex.printStackTrace();

            try {
                getExperimentHost().showMessageDialog(
                    "❌ Erreur ouverture JTable à onglets\n\n"
                    + "Titre : " + fTitle + "\n"
                    + "Erreur : " + ex.getClass().getName() + "\n"
                    + "Message : " + ex.getMessage()
                );
            } catch (Throwable ignored) {
                traceln("[JTABBED] Erreur critique : " + ex.getMessage());
            }
        }
    }
});]]></Body>
				</Function>
