				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781967000002</Id>
					<Name><![CDATA[tracesAgregeesRows]]></Name>
					<X>-440</X><Y>3970</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (tracesAgregees == null || tracesAgregees.isEmpty()) {
    return emptyRows("Aucune agrégation disponible", tracesAgregeesColumns().length);
}

int debut = 0;
int nbLignes = tracesAgregees.size();

Object[][] rows = new Object[nbLignes][tracesAgregeesColumns().length];

for (int i = debut; i < tracesAgregees.size(); i++) {
    TraceData r = tracesAgregees.get(i);
    int idx = i - debut;

    rows[idx][0] = String.valueOf(r.id);
    rows[idx][1] = fmt1(r.t);
    rows[idx][2] = r.niveauAggregation;
    rows[idx][3] = r.emetteur;
    rows[idx][4] = nettoyerIdPosteTrace(r.idPoste, r.evenement, r.emetteur);
    rows[idx][5] = nettoyerCodeSCORTraceAvecContexte(r.codeSCOR, r.evenement, r.emetteur);
    String mesureLisible = r.mesure == null ? "" : r.mesure;
    if ("Temps de traitement".equalsIgnoreCase(mesureLisible)) mesureLisible = "Temps de traitement";
    else if ("Temps d’attente".equalsIgnoreCase(mesureLisible)) mesureLisible = "Temps d'attente";
    else if ("Temps utile".equalsIgnoreCase(mesureLisible)) mesureLisible = "Temps utile";
    else if ("EFFICACITE_CYCLE".equalsIgnoreCase(mesureLisible) || "PCE".equalsIgnoreCase(mesureLisible)) mesureLisible = "Efficacité du cycle";
    rows[idx][6] = mesureLisible;
    rows[idx][7] = fmt2(r.valeurBrute);
    rows[idx][8] = fmt2(r.valeurAgregee);
    rows[idx][9] = r.formule;
}

return rows;]]></Body>
				</Function>
