				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781619647903</Id>
					<Name><![CDATA[n1ValF]]></Name>
					<X>-190</X><Y>4340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[  if (postes.isEmpty()) return "  (aucun poste - configurez dans Vue Edition)";
  StringBuilder sb = new StringBuilder();
  String[] prefs = {"sP","sS","sM","sD","sR"};
  for (String pref : prefs) {
    boolean any = false;
    for (PosteGenericAgent p : postes) {
      if (!p.codeSCOR.startsWith(pref)) continue;
      if (!any) { sb.append("[" + pref + "] "); any = true; }
      KPIBundle k = board.kpiParPoste.get(cleKPI(p));
      int wip = p.queue.size()+p.delay.size();
      sb.append(String.format("%s(%d) ", p.idPoste, wip));
    }
    if (any) sb.append("  ");
  }
  return sb.toString();]]></Body>
				</Function>
