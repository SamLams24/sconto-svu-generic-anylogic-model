		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1780999645731</Id>
			<Name><![CDATA[ScenarioFlux]]></Name>
			<Text><![CDATA[import java.util.ArrayList;
import java.util.List;

public class ScenarioFlux implements java.io.Serializable {
    public String typeProduit = "Produit";
    public List<String> sequence = new ArrayList<String>();
    public double debitParHeure = 60;
    public double debitParHeureBase = 60;

    // Nomenclature (BOM simplifiee) : matieres necessaires pour fabriquer
    // UNE unite de ce produit. Saisie libre, ajoutee via la vue
    // "Configurer nomenclature". Vide par defaut : aucun impact si non utilisee.
    public List<LigneNomenclature> nomenclature = new ArrayList<LigneNomenclature>();

    public ScenarioFlux() {}
    public ScenarioFlux(String typeProduit, double debitParHeure) {
        this.typeProduit = typeProduit;
        this.debitParHeure = debitParHeure;
        this.debitParHeureBase = debitParHeure;
    }

    public double interArriveeSecondes() { return 3600.0 / debitParHeure; }

    public double quantitePour(String idMatiere) {
        if (idMatiere == null) return 0;
        for (LigneNomenclature l : nomenclature) {
            if (l.idMatiere.equalsIgnoreCase(idMatiere.trim())) return l.quantiteParUnite;
        }
        return 0;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1799700000001</Id>
			<Name><![CDATA[LigneNomenclature]]></Name>
			<Text><![CDATA[// Une ligne de nomenclature : une matiere/composant necessaire pour fabriquer
// UNE unite du produit auquel cette ligne est rattachee (voir ScenarioFlux.nomenclature).
// Saisie libre par l'utilisateur, aucun format ni niveau impose.
public class LigneNomenclature implements java.io.Serializable {
    public String idMatiere = "";
    public double quantiteParUnite = 1.0;

    public LigneNomenclature() {}
    public LigneNomenclature(String idMatiere, double quantiteParUnite) {
        this.idMatiere = idMatiere != null ? idMatiere.trim() : "";
        this.quantiteParUnite = quantiteParUnite;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1799700000002</Id>
			<Name><![CDATA[ReceptionAttendue]]></Name>
			<Text><![CDATA[// Une quantite de matiere deja commandee (ordre passe suite a un besoin net
// positif) mais pas encore arrivee. Devient du "stock disponible" a l'echeance
// (voir Main.calculerBesoinsNets).
public class ReceptionAttendue implements java.io.Serializable {
    public double quantite = 0;
    public double dateArriveePrevue = 0; // instant de simulation (secondes)
    public double dateCommande = 0;
    public String idMatiere = "";
    public String idFournisseur = "";
    public double delaiNominalHeures = 0;
    public double delaiEffectifHeures = 0;
    public double retardForceHeures = 0;

    public ReceptionAttendue() {}
    public ReceptionAttendue(double quantite, double dateArriveePrevue) {
        this.quantite = quantite;
        this.dateArriveePrevue = dateArriveePrevue;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1799700000003</Id>
			<Name><![CDATA[FicheMatiere]]></Name>
			<Text><![CDATA[import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;

// Fiche de parametres d'une matiere/composant, saisie librement dans la
// vue "Configurer nomenclature". Porte le stock disponible, le stock de
// securite souhaite, le delai d'obtention aupres du fournisseur, et
// l'historique des receptions attendues (commandees mais pas encore
// arrivees). Alimente le calcul du besoin net (Main.calculerBesoinsNets).
public class FicheMatiere implements java.io.Serializable {
    public String idMatiere = "";
    // Valeur de référence utilisée pour réinitialiser un nouveau run sans
    // perdre les stocks détaillés chargés depuis le JSON.
    public double stockInitialConfigure = 0;
    public boolean stockInitialConfigureDefini = false;
    public double stockDisponible = 0;
    public double stockSecurite = 0;
    public double delaiObtentionHeures = 0;
    public String idFournisseur = "";

    // C14.55 -- Gestion de stock (s, Q) : point de commande et quantite
    // economique. Recalcules periodiquement (point de commande, car il
    // depend de la prevision de demande courante) ou une seule fois
    // (quantite economique, cf. formule de Wilson, moins sensible aux
    // variations court terme).
    public double pointCommande = 0;
    public double quantiteEconomique = 0;

    public List<ReceptionAttendue> receptionsAttendues = new ArrayList<ReceptionAttendue>();

    // Tracabilite du dernier calcul de besoin net (pour le tableau/rapport)
    public double dernierBesoinBrut = 0;
    public double dernierStockDispo = 0;
    public double dernieresReceptionsAttendues = 0;
    public double dernierBesoinNet = 0;
    public double dernierOrdrePasse = 0;
    public double dernierCalcul = -1;

    public FicheMatiere() {}

    public double totalReceptionsAttendues() {
        double total = 0;
        for (ReceptionAttendue r : receptionsAttendues) total += r.quantite;
        return total;
    }

    // Fait "arriver" les receptions dont l'echeance est atteinte : bascule
    // leur quantite dans le stock disponible et les retire de la liste
    // d'attente. Retourne la quantite totale arrivee (pour le journal).
    public double traiterEcheances(double maintenant) {
        double arrivee = 0;
        Iterator<ReceptionAttendue> it = receptionsAttendues.iterator();
        while (it.hasNext()) {
            ReceptionAttendue r = it.next();
            if (maintenant >= r.dateArriveePrevue) {
                stockDisponible += r.quantite;
                arrivee += r.quantite;
                it.remove();
            }
        }
        return arrivee;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1780999664300</Id>
			<Name><![CDATA[KPIBundle]]></Name>
			<Text><![CDATA[public class KPIBundle implements java.io.Serializable {
    public long count = 0;
    // Sommes historiques non pondérées : conservées pour compatibilité et audit.
    public double sumCycleTime = 0;
    public double sumWaitTime = 0;
    public double sumVAT = 0;

    // S2.2 C04 — agrégation pondérée par quantité/volume.
    public double sumCycleTimeWeighted = 0;
    public double sumWaitTimeWeighted = 0;
    public double sumVATWeighted = 0;
    public double weightTotal = 0;

    public long nbRebut = 0;
    public long nbRework = 0;

    public KPIBundle() {}

    public void addObservation(double cycleTime, double waitTime, double vat, double quantityWeight) {
        double w = (Double.isNaN(quantityWeight) || Double.isInfinite(quantityWeight) || quantityWeight <= 0) ? 1.0 : quantityWeight;
        count++;
        sumCycleTime += cycleTime;
        sumWaitTime += waitTime;
        sumVAT += vat;
        sumCycleTimeWeighted += cycleTime * w;
        sumWaitTimeWeighted += waitTime * w;
        sumVATWeighted += vat * w;
        weightTotal += w;
    }

    public void agreger(KPIBundle autre) {
        if (autre == null) return;
        this.count        += autre.count;
        this.sumCycleTime += autre.sumCycleTime;
        this.sumWaitTime  += autre.sumWaitTime;
        this.sumVAT       += autre.sumVAT;
        this.sumCycleTimeWeighted += autre.sumCycleTimeWeighted;
        this.sumWaitTimeWeighted  += autre.sumWaitTimeWeighted;
        this.sumVATWeighted       += autre.sumVATWeighted;
        this.weightTotal          += autre.weightTotal;
        this.nbRebut      += autre.nbRebut;
        this.nbRework     += autre.nbRework;
    }

    public double avgCycleTime() {
        if (weightTotal > 0) return sumCycleTimeWeighted / weightTotal;
        return count == 0 ? 0 : sumCycleTime / count;
    }
    public double avgWaitTime() {
        if (weightTotal > 0) return sumWaitTimeWeighted / weightTotal;
        return count == 0 ? 0 : sumWaitTime / count;
    }
    public double scrapRate() { long base = count + nbRebut; return base == 0 ? 0 : (double) nbRebut / base; }
    public double reworkRate() { return count == 0 ? 0 : (double) nbRework / count; }
    public double avgLeadTime() { return avgCycleTime() + avgWaitTime(); }
    public double pce() {
        double proc = weightTotal > 0 ? sumCycleTimeWeighted : sumCycleTime;
        double wait = weightTotal > 0 ? sumWaitTimeWeighted : sumWaitTime;
        double va   = weightTotal > 0 ? sumVATWeighted : sumVAT;
        double lead = proc + wait;
        return lead == 0 ? 0 : va / lead;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>2026081300001</Id>
			<Name><![CDATA[FuzzyGradeSet]]></Name>
			<Text><![CDATA[public class FuzzyGradeSet implements java.io.Serializable {
    public double A=0, B=0, C=0, D=0, E=0, F=0;

    public FuzzyGradeSet() {}
    public FuzzyGradeSet(double A,double B,double C,double D,double E,double F) {
        this.A=A; this.B=B; this.C=C; this.D=D; this.E=E; this.F=F;
    }

    // Profil triangulaire compatible avec les exemples numeriques de Chan & Qi /
    // Theeranuphattana : A~10, B~8, C~6, D~4, E~2, F~0.
    // Entre deux centres, l'appartenance est interpolee lineairement et la somme vaut 1.
    public static FuzzyGradeSet depuisScore(double score) {
        double s = Double.isNaN(score) || Double.isInfinite(score) ? 0.0 : Math.max(0.0, Math.min(10.0, score));
        FuzzyGradeSet g = new FuzzyGradeSet();
        if (s <= 0.0) { g.F=1.0; return g; }
        if (s >= 10.0) { g.A=1.0; return g; }
        if (s < 2.0) { g.E=s/2.0; g.F=1.0-g.E; return g; }
        if (s < 4.0) { g.D=(s-2.0)/2.0; g.E=1.0-g.D; return g; }
        if (s < 6.0) { g.C=(s-4.0)/2.0; g.D=1.0-g.C; return g; }
        if (s < 8.0) { g.B=(s-6.0)/2.0; g.C=1.0-g.B; return g; }
        g.A=(s-8.0)/2.0; g.B=1.0-g.A; return g;
    }

    public double somme() { return A+B+C+D+E+F; }
    public double defuzzifier() {
        double den=somme();
        if (!(den>0) || Double.isNaN(den) || Double.isInfinite(den)) return 0.0;
        return (10.0*A + 8.0*B + 6.0*C + 4.0*D + 2.0*E) / den;
    }
    public FuzzyGradeSet ponderer(double w) {
        double p=Math.max(0.0,w);
        return new FuzzyGradeSet(A*p,B*p,C*p,D*p,E*p,F*p);
    }
    public void ajouter(FuzzyGradeSet g,double w) {
        if(g==null || !(w>0)) return;
        A+=g.A*w; B+=g.B*w; C+=g.C*w; D+=g.D*w; E+=g.E*w; F+=g.F*w;
    }
    public void normaliser(double den) {
        if(!(den>0)) return;
        A/=den; B/=den; C/=den; D/=den; E/=den; F/=den;
    }
    public String compact() {
        return String.format(java.util.Locale.US,"A=%.3f B=%.3f C=%.3f D=%.3f E=%.3f F=%.3f",A,B,C,D,E,F);
    }
    public static FuzzyGradeSet agregerMetriques(java.util.List<MetriqueN3> ms) {
        FuzzyGradeSet out=new FuzzyGradeSet(); double den=0.0;
        if(ms!=null) for(MetriqueN3 m:ms){
            if(m==null || !(m.poids>0) || m.fuzzyGrades==null) continue;
            out.ajouter(m.fuzzyGrades,m.poids); den+=m.poids;
        }
        out.normaliser(den); return out;
    }
    public static FuzzyGradeSet agregerGrades(FuzzyGradeSet[] gs,double[] ws) {
        FuzzyGradeSet out=new FuzzyGradeSet(); double den=0.0;
        if(gs==null || ws==null) return out;
        int n=Math.min(gs.length,ws.length);
        for(int i=0;i<n;i++) if(gs[i]!=null && ws[i]>0){ out.ajouter(gs[i],ws[i]); den+=ws[i]; }
        out.normaliser(den); return out;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1781700000001</Id>
			<Name><![CDATA[MetriqueN3]]></Name>
			<Text><![CDATA[public class MetriqueN3 implements java.io.Serializable {
    // Nom historique conserve pour compatibilite du modele. Depuis C13 cette classe
    // represente une metrique SCOR runtime de niveau 1, 2 ou 3.
    public String nom;
    public String codeOfficielSCOR = "";
    public String unite = "";
    public int niveauSCOR = 0;
    public double valeurBrute;
    public double valeurNorm;       // LEGACY = score10 / 10, conserve pour anciennes vues
    public double score10;          // score de performance Theeranuphattana/Chan-Qi [0..10]
    public FuzzyGradeSet fuzzyGrades = new FuzzyGradeSet();
    public double poids;
    public String methodeScore = "BOTTOM_PERFECT_PROPORTIONAL";
    public String profilFuzzy = "SCONTO_SVU_FUZZY_PROFILE_V1_CENTERS_0_2_4_6_8_10";

    public MetriqueN3() {}
    public MetriqueN3(String nom, double valeurBrute, double valeurNorm, double poids) {
        this(nom,"","",valeurBrute,valeurNorm,poids);
    }
    public MetriqueN3(String nom, String codeOfficielSCOR, String unite, double valeurBrute, double valeurNorm, double poids) {
        this.nom=nom; this.codeOfficielSCOR=codeOfficielSCOR==null?"":codeOfficielSCOR; this.unite=unite==null?"":unite;
        this.valeurBrute=valeurBrute;
        this.valeurNorm=Double.isNaN(valeurNorm)||Double.isInfinite(valeurNorm)?0.0:Math.max(0.0,Math.min(1.0,valeurNorm));
        this.score10=this.valeurNorm*10.0;
        this.fuzzyGrades=FuzzyGradeSet.depuisScore(this.score10);
        this.poids=Math.max(0.0,poids);
        this.niveauSCOR=extraireNiveau(this.codeOfficielSCOR);
    }
    static int extraireNiveau(String code){
        if(code==null) return 0;
        String c=code.trim().toUpperCase(java.util.Locale.ROOT);
        if(c.startsWith("PROXY.")) return 0;
        String[] p=c.split("\\.");
        if(p.length<2) return 0;
        try { return Integer.parseInt(p[1]); } catch(Throwable ignored){ return 0; }
    }
    public String attribut(){
        String c=codeOfficielSCOR==null?"":codeOfficielSCOR.toUpperCase(java.util.Locale.ROOT);
        if(c.startsWith("RL."))return "RL"; if(c.startsWith("RS."))return "RS"; if(c.startsWith("AG.")||c.startsWith("PROXY.AG."))return "AG";
        if(c.startsWith("CO."))return "CO"; if(c.startsWith("AM."))return "AM"; return "";
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1782200001001</Id>
			<Name><![CDATA[AERMessage]]></Name>
			<Text><![CDATA[public class AERMessage implements java.io.Serializable {
    public static final String AMENDMENT = "AMENDMENT";
    public static final String EXECUTION = "EXECUTION";
    public static final String REPORT    = "REPORT";
    public String type; public String emetteur; public String destinataire;
    public String sujet; public String contenu; public double timestamp;
    public AERMessage() {}
    public AERMessage(String type, String emetteur, String destinataire,
                      String sujet, String contenu, double ts) {
        this.type=type; this.emetteur=emetteur; this.destinataire=destinataire;
        this.sujet=sujet; this.contenu=contenu; this.timestamp=ts;
    }
    @Override public String toString() {
        return String.format("[AER-%s] %s->%s | %s @T=%.1f",type,emetteur,destinataire,sujet,timestamp);
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1782200001002</Id>
			<Name><![CDATA[ActeurSC]]></Name>
			<Text><![CDATA[public class ActeurSC implements java.io.Serializable {

    // Acteurs principaux de la chaîne
    public static final String FOURNISSEUR        = "FOURNISSEUR";
    public static final String ENTREPRISE_FOCALE  = "ENTREPRISE_FOCALE";
    public static final String CLIENT             = "CLIENT";
    public static final String ACTEUR_ANNEXE      = "ACTEUR_ANNEXE";

    // Types annexes
    public static final String TRANSPORTEUR             = "TRANSPORTEUR";
    public static final String DISTRIBUTEUR             = "DISTRIBUTEUR";
    public static final String PRESTATAIRE_LOGISTIQUE   = "PRESTATAIRE_LOGISTIQUE";
    public static final String PRESTATAIRE_MAINTENANCE  = "PRESTATAIRE_MAINTENANCE";
    public static final String SYSTEME_INFORMATION      = "SYSTEME_INFORMATION";
    public static final String RESSOURCE_HUMAINE        = "RESSOURCE_HUMAINE";
    public static final String RESSOURCE_PHYSIQUE       = "RESSOURCE_PHYSIQUE";
    public static final String AUTRE                    = "AUTRE";

    public String idActeur = "";
    public String nom = "Acteur";

    // Catégorie principale : FOURNISSEUR / ENTREPRISE_FOCALE / CLIENT / ACTEUR_ANNEXE
    public String categorie = ENTREPRISE_FOCALE;

    // Utilisé seulement si categorie = ACTEUR_ANNEXE
    public String typeAnnexe = "";

    public String description = "";
    public boolean actif = true;

    // ----------------------------------------------------------------
    // Donnee financiere simplifiee : delai de paiement contractuel
    // (utilise pour AM.2.3 Days Payable Outstanding si FOURNISSEUR,
    // AM.2.1 Days Sales Outstanding si CLIENT). Valeur par defaut
    // neutre, n'affecte rien si l'utilisateur ne la modifie pas.
    // ----------------------------------------------------------------
    public double delaiPaiementJours = 30.0;

    // ----------------------------------------------------------------
    // Politique d'approvisionnement autonome (pertinent surtout pour
    // categorie = FOURNISSEUR : permet a chaque fournisseur d'avoir ses
    // propres arrivees, independantes du generateur de commandes client).
    // politiqueAppro : "" (aucune) / "PERIODIQUE" / "POISSON"
    // ----------------------------------------------------------------
    public String politiqueAppro = "";
    public double intervalleAppro = 0;       // secondes, utilise si PERIODIQUE
    public double tauxArriveePoisson = 0;    // par seconde, utilise si POISSON
    public double quantiteParAppro = 1;      // nb d'unites generees a chaque declenchement
    public double dernierAppro = -1;         // instant de la derniere arrivee (usage interne)

    // ----------------------------------------------------------------
    // Mode d'approvisionnement pilote par le besoin net (MRP). Quand
    // vrai pour un acteur FOURNISSEUR, les matieres dont ce fournisseur
    // est responsable (FicheMatiere.idFournisseur) ne sont plus livrees
    // par politiqueAppro (autonome) mais par les ordres calcules a partir
    // du besoin net (voir Main.calculerBesoinsNets). Par defaut a false :
    // aucun impact sur les configurations existantes tant que l'utilisateur
    // ne l'active pas explicitement.
    // ----------------------------------------------------------------
    public boolean modeApproMRP = false;

    // Micro-activités rattachées après configuration
    public java.util.ArrayList<String> idsMicroActivites =
        new java.util.ArrayList<String>();

    public ActeurSC() {}

    public ActeurSC(String idActeur, String nom, String categorie, String typeAnnexe, String description) {
        this.idActeur = idActeur != null ? idActeur.trim() : "";
        this.nom = nom != null ? nom.trim() : "Acteur";
        this.categorie = categorie != null ? categorie.trim().toUpperCase() : ENTREPRISE_FOCALE;
        this.typeAnnexe = typeAnnexe != null ? typeAnnexe.trim().toUpperCase() : "";
        this.description = description != null ? description.trim() : "";
        this.actif = true;
    }

    public void ajouterMicroActivite(String idPoste) {
        if (idPoste == null) return;

        String id = idPoste.trim();
        if (id.isEmpty()) return;

        if (!idsMicroActivites.contains(id)) {
            idsMicroActivites.add(id);
        }
    }

    public void retirerMicroActivite(String idPoste) {
        if (idPoste == null) return;
        idsMicroActivites.remove(idPoste.trim());
    }

    public String microActivitesText() {
        if (idsMicroActivites == null || idsMicroActivites.isEmpty()) return "-";
        return String.join(",", idsMicroActivites);
    }

    public String typeAffiche() {
        if (ACTEUR_ANNEXE.equals(categorie)) {
            return typeAnnexe == null || typeAnnexe.isEmpty()
                ? ACTEUR_ANNEXE
                : ACTEUR_ANNEXE + ":" + typeAnnexe;
        }
        return categorie;
    }

    @Override
    public String toString() {
        return idActeur + " — " + nom + " [" + typeAffiche() + "]";
    }
}]]></Text>
		</JavaClass>
