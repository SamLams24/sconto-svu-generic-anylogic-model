					<Body><![CDATA[if (responsabilitesMicro == null || responsabilitesMicro.isEmpty()) {
    return emptyRows("Aucune responsabilité configurée", responsabilitesColumns().length);
}

Object[][] rows = new Object[responsabilitesMicro.size()][responsabilitesColumns().length];

for (int i = 0; i < responsabilitesMicro.size(); i++) {
    MicroResponsabilite r = responsabilitesMicro.get(i);

    rows[i][0] = r.idResponsabilite;
    rows[i][1] = r.idMicroActivite;
    rows[i][2] = r.nomMicroActivite;
    rows[i][3] = r.nomActeur;
    rows[i][4] = r.niveauHierarchique;
    rows[i][5] = r.typeAgent;
    rows[i][6] = String.valueOf(r.quantite);
    rows[i][7] = r.idsAgentsText();
    rows[i][8] = r.idsMachinesText();
}

return rows;]]></Body>
