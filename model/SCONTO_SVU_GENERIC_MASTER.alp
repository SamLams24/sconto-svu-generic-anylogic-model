					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Temps de simulation (secondes)",
    "Type de flux métier",
    "Acteur / poste source",
    "Acteur / poste cible",
    "Quantité",
    "Nature du flux"
};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781970000002</Id>
					<Name><![CDATA[fluxSupplyChainRows]]></Name>
					<X>-440</X><Y>4390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (fluxLogs == null || fluxLogs.isEmpty()) {
    return emptyRows("Aucun flux émis", fluxSupplyChainColumns().length);
}

java.util.ArrayList<FluxLog> propres = new java.util.ArrayList<FluxLog>();
java.util.HashSet<String> dejaVus = new java.util.HashSet<String>();

for (FluxLog f : fluxLogs) {
    if (f == null) continue;
    String tf = typeFluxLisible(f.typeFlux);
    String src = f.idSource == null ? "" : f.idSource;
    String dst = f.idCible == null ? "" : f.idCible;
    String cle = tf + "|" + src + "|" + dst + "|" + f.qte + "|" + Math.round(f.tEmission);
    if (dejaVus.add(cle)) propres.add(f);
}

Object[][] rows = new Object[propres.size()][fluxSupplyChainColumns().length];

for (int i = 0; i < propres.size(); i++) {
    FluxLog f = propres.get(i);
    String tf = typeFluxLisible(f.typeFlux);
    String sens = "Flux informationnel";
    if (tf.contains("APPROVISIONNEMENT") || tf.contains("LIVRAISON_PHYSIQUE")) sens = "Flux physique";
    if (tf.contains("RETOUR")) sens = "Flux physique de retour";
    if (tf.contains("RECEPTION_CLIENT")) sens = "Étape métier client";
    if (tf.contains("INFO_COMMANDE")) sens = "Flux informationnel de commande";

    rows[i][0] = fmt1(f.tEmission);
    rows[i][1] = tf;
    rows[i][2] = f.idSource;
    rows[i][3] = f.idCible;
    rows[i][4] = String.valueOf(f.qte);
    rows[i][5] = sens;
}

return rows;]]></Body>
				</Function>
