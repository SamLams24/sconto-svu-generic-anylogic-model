				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1799700000364</Id>
					<Name><![CDATA[btnAppliquerConsommeMatiere]]></Name>
					<X>1700</X><Y>870</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
