                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[champModeApproMRP = chkModeApproMRP.isSelected();]]></ActionCode>
					</BasicProperties>
					<ExtendedProperties>
						<Font Name="Dialog" Size="11" Style="0"/>
						<LabelText><![CDATA[Piloté par le besoin net (MRP)]]></LabelText>
						<DefaultValueCode><![CDATA[false]]></DefaultValueCode>
						<LinkTo>false</LinkTo>
	 				</ExtendedProperties>
				</Control>
				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1799700000354</Id>
					<Name><![CDATA[btnAppliquerModeAppro]]></Name>
					<X>1700</X><Y>750</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="230" Height="28">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[ActeurSC a = trouverActeurParId(extraireIdFournisseurDepuisCombo(champActeurIdModeAppro));
if (a == null) {
    getExperimentHost().showMessageDialog("❌ Acteur introuvable : \"" + champActeurIdModeAppro + "\"");
} else if (!ActeurSC.FOURNISSEUR.equals(a.categorie)) {
    getExperimentHost().showMessageDialog("⚠️ Cet acteur n'est pas de catégorie FOURNISSEUR.");
} else {
    a.modeApproMRP = champModeApproMRP;
    getExperimentHost().showMessageDialog("✅ Mode d'approvisionnement de \"" + a.nom + "\" : "
        + (a.modeApproMRP ? "piloté par le besoin net (MRP)" : "autonome (comportement historique)"));
}]]></ActionCode>
					</BasicProperties>
					<ExtendedProperties>
						<Font Name="Dialog" Size="11" Style="0"/>
						<LabelText><![CDATA[Appliquer]]></LabelText>
					</ExtendedProperties>
