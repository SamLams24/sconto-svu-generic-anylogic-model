				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782072354301</Id>
					<Name><![CDATA[idPosteDepuisSelection]]></Name>
					<X>2702</X><Y>-969</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (champPosteSelectionne == null || champPosteSelectionne.isEmpty()) return "";
if (champPosteSelectionne.contains(" — ")) {
    return champPosteSelectionne.split(" — ")[0].trim();
}
return champPosteSelectionne.trim();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000901</Id>
					<Name><![CDATA[fixerPositionPosteUI]]></Name>
					<X>2702</X><Y>-955</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Fige la position actuelle du poste selectionne : les prochains recalculs
// de layout (ajout d'un autre poste, rechargement de configuration...) ne
// le deplaceront plus tant que cette option reste active.
String id = idPosteDepuisSelection();
if (id.isEmpty()) {
    messageStatut = "ERREUR : selectionnez un poste dans la liste.";
    return;
}
PosteGenericAgent p = trouverPoste(id);
if (p == null) {
    messageStatut = "ERREUR : poste introuvable.";
    return;
}
p.xManuel = p.getX();
p.yManuel = p.getY();
p.positionManuelle = true;
messageStatut = "Position de '" + p.nom + "' figee a (" + fmt1(p.xManuel) + ", " + fmt1(p.yManuel) + ").";
board.logEvent("[LAYOUT] Position manuelle fixee pour " + p.idPoste);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000902</Id>
					<Name><![CDATA[libererPositionPosteUI]]></Name>
					<X>2702</X><Y>-940</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Rend au poste selectionne son positionnement automatique (bandes par
// acteur / lignes par chaine), en annulant tout positionnement manuel.
String id = idPosteDepuisSelection();
if (id.isEmpty()) {
    messageStatut = "ERREUR : selectionnez un poste dans la liste.";
    return;
}
PosteGenericAgent p = trouverPoste(id);
if (p == null) {
    messageStatut = "ERREUR : poste introuvable.";
    return;
}
p.positionManuelle = false;
positionnerPoste(p);
messageStatut = "Position de '" + p.nom + "' repassee en mode automatique.";
board.logEvent("[LAYOUT] Position automatique restauree pour " + p.idPoste);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
