					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[KPIBundle sM = board.kpiParMacro.get("sM");
if (sM == null) return 0;
return Math.max(0, 1.0 - sM.scrapRate());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
