					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[StringBuilder sb = new StringBuilder();
  for (PosteGenericAgent p : postes) {
    if (!p.codeSCOR.startsWith("P")) continue;
    KPIBundle k = board.kpiParPoste.get(cleKPI(p));
    double ct = k!=null?k.avgCycleTime():0;
    int wip = p.queue.size()+p.delay.size();
    sb.append(String.format("%s\n%s\nCT:%.0fs WIP:%d%s\n---\n",
      p.idPoste, p.nom.length()>10?p.nom.substring(0,10):p.nom,
      ct, wip, p.goulot?" [!]":""));
  }
  if (sb.length()==0) return "(vide)";
  return sb.toString();]]></Body>
