				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782200003001</Id>
					<Name><![CDATA[ajouterActeurSC]]></Name>
					<X>-300</X><Y>1100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nom]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[categorie]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[typeAnnexe]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[description]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String nomA = nom != null ? nom.trim() : "";
    String catA = normaliserCategorieActeur(categorie);
    String annA = typeAnnexe != null ? typeAnnexe.trim().toUpperCase() : "";
    String descA = description != null ? description.trim() : "";

    if (nomA.isEmpty()) {
        messageStatut = "ERREUR : nom de l'acteur obligatoire.";

        getExperimentHost().showMessageDialog(
            "⚠️ Nom de l'acteur manquant\n\n"
            + "Veuillez saisir le nom de l'acteur de la chaîne."
        );

        return;
    }

    if (!catA.equals(ActeurSC.FOURNISSEUR)
        && !catA.equals(ActeurSC.ENTREPRISE_FOCALE)
        && !catA.equals(ActeurSC.CLIENT)
        && !catA.equals(ActeurSC.ACTEUR_ANNEXE)) {

        messageStatut = "ERREUR : catégorie d'acteur invalide.";

        getExperimentHost().showMessageDialog(
            "⚠️ Catégorie invalide\n\n"
            + "Valeurs acceptées :\n"
            + "- FOURNISSEUR\n"
            + "- ENTREPRISE_FOCALE\n"
            + "- CLIENT\n"
            + "- ACTEUR_ANNEXE\n\n"
            + "Valeur saisie : " + catA
        );

        return;
    }

    if (catA.equals(ActeurSC.ACTEUR_ANNEXE) && annA.isEmpty()) {
        messageStatut = "ERREUR : type annexe obligatoire.";

        getExperimentHost().showMessageDialog(
            "⚠️ Type annexe manquant\n\n"
            + "Pour un ACTEUR_ANNEXE, veuillez préciser son type :\n"
            + "TRANSPORTEUR, DISTRIBUTEUR, PRESTATAIRE_LOGISTIQUE,\n"
            + "SYSTEME_INFORMATION, RESSOURCE_HUMAINE, etc."
        );

        return;
    }

    if (!catA.equals(ActeurSC.ACTEUR_ANNEXE)) {
        annA = "";
    }

    for (ActeurSC ex : acteursSC) {
        if (ex.nom.equalsIgnoreCase(nomA) && ex.categorie.equalsIgnoreCase(catA)) {
            messageStatut = "ERREUR : acteur déjà existant.";

            getExperimentHost().showMessageDialog(
                "⚠️ Doublon détecté\n\n"
                + "Un acteur nommé '" + nomA + "' existe déjà dans la catégorie " + catA + "."
            );

            return;
        }
    }

    ActeurSC a = new ActeurSC();
    a.idActeur = genererIdActeur();
    a.nom = nomA;
    a.categorie = catA;
    a.typeAnnexe = annA;
    a.description = descA;
    a.actif = true;
    a.idsMicroActivites = new java.util.ArrayList<String>();
    a.delaiPaiementJours = Math.max(0.0, champDelaiPaiementJours);

    // Politique d'appro par defaut : seuls les FOURNISSEUR en ont une,
    // pour leur donner une arrivee autonome dès leur creation, sans
    // depandre du generateur de commandes client. Ajustable ensuite
    // directement sur l'objet (a.intervalleAppro, a.quantiteParAppro, ...).
    if (catA.equals(ActeurSC.FOURNISSEUR)) {
        a.politiqueAppro = "PERIODIQUE";
        a.intervalleAppro = 600;   // toutes les 10 minutes de temps simule
        a.quantiteParAppro = 1;
    } else {
        a.politiqueAppro = "";
    }

    acteursSC.add(a);

    refreshActeursMicroComboBox();

    board.logEvent(
        "[SC] Acteur ajouté : "
        + a.idActeur
        + " — "
        + a.nom
        + " ["
        + a.typeAffiche()
        + "]"
    );

    messageStatut =
        "Acteur '" + a.nom + "' ajouté dans la catégorie " + a.typeAffiche() + ".";

    getExperimentHost().showMessageDialog(
        "✅ Acteur de chaîne ajouté\n\n"
        + "ID          : " + a.idActeur + "\n"
        + "Nom         : " + a.nom + "\n"
        + "Catégorie   : " + a.categorie + "\n"
        + "Type annexe : " + (a.typeAnnexe.isEmpty() ? "—" : a.typeAnnexe) + "\n"
        + "Description : " + (a.description.isEmpty() ? "—" : a.description) + "\n"
        + (a.politiqueAppro.isEmpty() ? "" :
            "Politique appro : " + a.politiqueAppro + " (toutes les " + (int)a.intervalleAppro + " s, qte=" + (int)a.quantiteParAppro + ")\n")
        + "\nLes micro-activités seront liées ensuite depuis la vue de configuration."
    );

    // Maintient viewAnimation synchronisée avec la configuration manuelle.
    creerStationsAnimation();
    fluxInfoInitialDejaDeclenche = false;
    declencherFluxInformationInitiale();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
