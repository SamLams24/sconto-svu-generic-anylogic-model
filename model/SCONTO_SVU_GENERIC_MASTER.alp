				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1920000000109</Id>
					<Name><![CDATA[ConnectPhysicalFlows]]></Name>
					<X>-450</X><Y>6550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ============================================================
// FLUX PHYSIQUES — TRAITS PLEINS ET UNIDIRECTIONNELS
// Chaque connexion utilise le second réseau du Movable :
// physicalConnections.
// ============================================================

// --- 1. SUPPLIER -> MANUFACTURER : approvisionnement entrant ---
AOe_sS1_4_3.physicalConnections.connectTo(AOe_sD1_11_supplier);
AOe_sD1_11_supplier.physicalConnections.connectTo(AOe_sD1_12);
AOe_sD1_12.physicalConnections.connectTo(AOe_sS1_2);

// --- 2. MANUFACTURER : Source -> Make ---
AOe_sS1_2.physicalConnections.connectTo(AOe_sS1_3);
AOe_sS1_3.physicalConnections.connectTo(AOe_sS1_4);
AOe_sS1_4.physicalConnections.connectTo(AOe_sM1_2); // AOe-sM1.2
AOe_sM1_2.physicalConnections.connectTo(AOe_sM1_3);

// --- 3. MANUFACTURER : Make, branche conforme ---
AOe_sM1_3.physicalConnections.connectTo(AOe_sM1_4);
AOe_sM1_4.physicalConnections.connectTo(AOe_sM1_5);
AOe_sM1_5.physicalConnections.connectTo(AOe_sM1_6);
AOe_sM1_6.physicalConnections.connectTo(AOe_sD1_8_3);

// Branche rebut : elle s'arrête sur AOe-sM1.7 et ne rejoint pas Deliver.
AOe_sM1_3.physicalConnections.connectTo(AOe_sM1_7);

// --- 4. MANUFACTURER : Deliver -> CUSTOMER ---
AOe_sD1_8_3.physicalConnections.connectTo(AOe_sD1_9_manufacturer);
AOe_sD1_9_manufacturer.physicalConnections.connectTo(AOe_sD1_10_manufacturer);
AOe_sD1_10_manufacturer.physicalConnections.connectTo(AOe_sD1_11_manufacturer);
AOe_sD1_11_manufacturer.physicalConnections.connectTo(AOe_sD1_12_2);
AOe_sD1_12_2.physicalConnections.connectTo(AOe_sS1_2_2);

// Réception et contrôle interne chez le Customer.
AOe_sS1_2_2.physicalConnections.connectTo(AOe_sS1_3_customer);
AOe_sS1_3_customer.physicalConnections.connectTo(AOe_sS1_4_4);
AOe_sS1_4_4.physicalConnections.connectTo(AOe_sD1_8_2);

// --- 5. Retour MANUFACTURER -> SUPPLIER ---
AOe_sS1_3.physicalConnections.connectTo(AOe_sSR1_1_manufacturer);
AOe_sSR1_1_manufacturer.physicalConnections.connectTo(AOe_sSR1_5_manufacturer);
AOe_sSR1_5_manufacturer.physicalConnections.connectTo(AOe_sDR1_3_supplier);

// --- 6. Retour CUSTOMER -> MANUFACTURER et réintégration Source ---
AOe_sS1_3_customer.physicalConnections.connectTo(AOe_sSR1_1); // AOe-sSR1.1 Customer
AOe_sSR1_1.physicalConnections.connectTo(AOe_sSR1_5);       // AOe-sSR1.5 Customer
AOe_sSR1_5.physicalConnections.connectTo(AOe_sDR1_3);       // AOe-sDR1.3 Manufacturer
AOe_sDR1_3.physicalConnections.connectTo(AOe_sDR1_4_manufacturer);
AOe_sDR1_4_manufacturer.physicalConnections.connectTo(AOe_sS1_2);
]]></Body>
				</Function>
			</Functions>
