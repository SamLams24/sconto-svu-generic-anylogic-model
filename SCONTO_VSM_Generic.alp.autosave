				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783533035316</Id>
					<Name><![CDATA[verifierCoherenceMRP]]></Name>
					<X>1660</X><Y>-150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Nom : verifierCoherenceMRP
StringBuilder avertissements = new StringBuilder();

// Matières utilisées dans une nomenclature mais sans fiche : jamais calculées
for (ScenarioFlux sc : scenarios) {
    for (LigneNomenclature l : sc.nomenclature) {
        if (trouverFicheMatiere(l.idMatiere) == null) {
            avertissements.append("- \"").append(l.idMatiere)
                .append("\" utilisée dans la nomenclature de \"").append(sc.typeProduit)
                .append("\" mais aucune fiche matière n'existe : le besoin net ne sera jamais calculé pour elle.\n");
        }
    }
}

// Fiches matière jamais utilisées dans aucune nomenclature : besoin net toujours nul
for (FicheMatiere f : fichesMatiere) {
    boolean utilisee = false;
    for (ScenarioFlux sc : scenarios) {
        if (sc.quantitePour(f.idMatiere) > 0) { utilisee = true; break; }
    }
    if (!utilisee) {
        avertissements.append("- La fiche matière \"").append(f.idMatiere)
            .append("\" n'est utilisée dans aucune nomenclature : son besoin net restera toujours à 0.\n");
    }
}

return avertissements.toString();]]></Body>
				</Function>
