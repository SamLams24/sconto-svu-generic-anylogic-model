					<Body><![CDATA[// Nom de la fonction : rafraichirComboNomenclatureProduit  (VOID)
String[] items = new String[scenarios.size()];
for (int i = 0; i < scenarios.size(); i++) {
    items[i] = scenarios.get(i).typeProduit;
}

if (items.length > 0 && (champNomProduitNomenclature == null || champNomProduitNomenclature.isEmpty())) {
    champNomProduitNomenclature = items[0];
}
comboNomenclatureProduit.setItems(items);]]></Body>
