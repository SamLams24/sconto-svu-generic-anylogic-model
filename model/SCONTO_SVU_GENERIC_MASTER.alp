					<X>-440</X><Y>5350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Attribut", "Code SCOR", "Nom anglais", "Nom français", "Niveau",
    "Valeur réelle", "Unité", "Bottom", "Perfect", "Score /10",
    "Grades flous A..F", "Statut", "Source / formule"
};]]></Body>
