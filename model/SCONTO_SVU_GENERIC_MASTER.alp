					</Properties>
					<Action><![CDATA[// Le calcul du besoin net en matieres (MRP) est porte par le holon de
// planification "sS" (Plan Source), conformement a la grille SCOR validee :
// P2/Plan Source = tactique. Les autres tactiques (sM/sD/sR) ne sont pas
// concernes par ce calcul et continuent uniquement l'arbitrage local.
Main main = (Main) getOwner();
// C14.55 -- MTS PUR : la politique de stock (point de commande / quantite
// economique) doit tourner en continu, independamment de modePilotageParCommande
// (dont le role se limitait au pilotage par commande, desormais remplace pour
// la production et l'approvisionnement matiere). Le garde precedent empechait
// en pratique tout declenchement autonome cote matiere.
if ("sS".equals(idMacroProcessus)) {
    main.calculerBesoinsNets();
}
if ("sM".equals(idMacroProcessus)) {
    main.verifierPolitiqueStockProduit();
}
arbitrerLocal();]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782073821758</Id>
					<Name><![CDATA[arbitrerLocal]]></Name>
					<X>-700</X><Y>0</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Arbitrage local : lit le tableau noir, publie une escalade.
// Chaîne AER réelle attendue : opérationnel -> Blackboard -> tactique -> Blackboard -> supervision.
Main main = (Main) getOwner();
if (main.realignementFluxHierarchiqueActif) return; // génération 2 : routage strict géré par Main
if (!main.modeExecution) return;
if (main.board == null) return;
BlackboardAgent board = main.board;

// 1. Lire les alertes publiées par les agents opérationnels de notre périmètre.
java.util.ArrayList<AERMessage> dansPerimetre = new java.util.ArrayList<AERMessage>();
for (AERMessage m : board.alertesPubliees) {
    if (m == null || m.emetteur == null) continue;
    if (m.emetteur.startsWith("TACTICAL_")) continue; // déjà arbitré par un niveau tactique

    PosteGenericAgent p = main.trouverPoste(m.emetteur);
    if (p != null && p.codeSCOR != null && main.macroPrefixe(p.codeSCOR).equals(idMacroProcessus)) {
        dansPerimetre.add(m);
    }
}
board.alertesPubliees.removeAll(dansPerimetre);

for (AERMessage m : dansPerimetre) {
    board.journaliserAER(
        "TACTIQUE_RECEPTION",
        m,
        "Alerte lue par TacticalAgent " + idMacroProcessus + " ; alerte retirée de la file opérationnelle"
    );
}

// 2. Recoupement avec les KPI macro (lecture Blackboard)
KPIBundle kMacro = board.kpiParMacro.get(idMacroProcessus);
double wtMacro = (kMacro != null) ? kMacro.avgWaitTime() : 0;

nbHolonsPerimetre = 0;
String goulotLocal = null;
double maxWT = 0;
for (OperationalAgent op : main.opAgents) {
    String n3Pur = (op.codeSCOR != null && op.codeSCOR.contains("|"))
        ? op.codeSCOR.substring(op.codeSCOR.indexOf('|') + 1)
        : op.codeSCOR;
    if (n3Pur != null && main.macroPrefixe(n3Pur).equals(idMacroProcessus)) {
        nbHolonsPerimetre++;
        KPIBundle kp = board.kpiParPoste.get(op.codeSCOR);
        if (kp != null && kp.avgWaitTime() > maxWT) {
            maxWT = kp.avgWaitTime();
            goulotLocal = op.idPoste;
        }
    }
}

// Si une alerte opérationnelle existe mais que le KPI macro n'identifie pas encore
// de poste plus critique, on conserve l'émetteur réel de l'alerte.
if ((goulotLocal == null || goulotLocal.trim().isEmpty()) && !dansPerimetre.isEmpty()) {
    goulotLocal = dansPerimetre.get(0).emetteur;
}

// Les alertes opérationnelles peuvent provenir d'un événement métier réel
// (ex. livraison clôturée en retard) avant que le KPI de file d'attente ne
// reflète un temps d'attente important. On conserve alors le WT transmis dans
// le message AER afin que l'escalade tactique repose sur une preuve runtime.
double wtAlerteOperationnelle = 0;
for (AERMessage ma : dansPerimetre) {
    if (ma == null || ma.contenu == null) continue;
    for (String part : ma.contenu.split(";")) {
        if (part == null) continue;
        part = part.trim();
        if (part.startsWith("WT=")) {
            try { wtAlerteOperationnelle = Math.max(wtAlerteOperationnelle, Double.parseDouble(part.substring(3))); } catch(Exception ex) {}
        }
        if (part.startsWith("retard=")) {
            try { wtAlerteOperationnelle = Math.max(wtAlerteOperationnelle, Double.parseDouble(part.substring(7))); } catch(Exception ex) {}
        }
    }
}
if (wtAlerteOperationnelle > maxWT) maxWT = wtAlerteOperationnelle;

// 3. Décision locale : publier une escalade uniquement apres reception
// d'au moins une alerte operationnelle. Un goulot detecte seulement par KPI
// est journalise en surveillance, mais ne doit pas court-circuiter la chaine
// AER operationnel -> tactique -> supervision.
if (!dansPerimetre.isEmpty()) {
    nbEscalades++;
    dernierGoulotLocal = (goulotLocal != null && !goulotLocal.trim().isEmpty()) ? goulotLocal : "?";

    board.logEvent("[HOLON-TAC] " + idMacroProcessus + " : goulot local " + dernierGoulotLocal
        + " WT=" + String.format("%.1f", maxWT) + "s (" + dansPerimetre.size()
        + " alerte(s) opérationnelle(s) reçue(s)) -> publication escalade");

    AERMessage escalade = new AERMessage(
        AERMessage.REPORT,
        "TACTICAL_" + idMacroProcessus,
        "SUPERVISOR",
        "GOULOT_ESCALADE",
        "poste=" + dernierGoulotLocal + ";WT=" + String.format("%.2f", maxWT)
            + ";macro=" + idMacroProcessus + ";holons=" + nbHolonsPerimetre
            + ";alertesOperationnelles=" + dansPerimetre.size(),
        time()
    );

    board.journaliserAER(
        "TACTIQUE_ESCALADE",
        escalade,
        "Arbitrage tactique publié vers supervision ; poste cible=" + dernierGoulotLocal
    );
    board.publierAlerte(escalade);

} else if (maxWT > seuilEscalade) {
    board.logEvent("[HOLON-TAC] " + idMacroProcessus
        + " : goulot potentiel detecte par KPI sur " + (goulotLocal == null ? "?" : goulotLocal)
        + " mais aucune alerte operationnelle n'a encore ete recue ; attente du rapport operationnel");
} else if (wtMacro > seuilEscalade * 0.5) {
    board.logEvent("[HOLON-TAC] " + idMacroProcessus + " : surveillance WT="
        + String.format("%.1f", wtMacro) + "s (seuil=" + seuilEscalade + "s)");
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782073821760</Id>
					<Name><![CDATA[getRapportTactical]]></Name>
					<X>-700</X><Y>0</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[StringBuilder sb = new StringBuilder();
sb.append("Tactical [" + idMacroProcessus + "]\n");
sb.append("  Holons perimetre : " + nbHolonsPerimetre + "\n");
sb.append("  Escalades : " + nbEscalades + "\n");
sb.append("  Dernier goulot : " + (dernierGoulotLocal.isEmpty() ? "(aucun)" : dernierGoulotLocal) + "\n");
return sb.toString();]]></Body>
