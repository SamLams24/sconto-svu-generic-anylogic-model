		<ActiveObjectClass>
			<Id>1782241822706</Id>
			<Name><![CDATA[Movable]]></Name>
			<AdditionalClassCode><![CDATA[String message = "";
String MovableInfo;
public String nomAffiche = "";
public String typeAffiche = "";

void definirIdentiteVisuelle(String nouveauNom, String nouveauType) {
    nomAffiche = nouveauNom == null ? "" : nouveauNom.trim();
    typeAffiche = nouveauType == null ? "" : nouveauType.trim();
    Main top = (Main) getOwner();
    if (top != null && !nomAffiche.isEmpty()) top.registerPuppet(nomAffiche, this);
}

// Animation manuelle des messages : indépendante de moveTo()/setSpeed().
// Elle garantit une progression visible, même si l'API de vitesse du moteur
// diffère selon la version d'AnyLogic.
public boolean animationMessageManuelle = false;
public double animationDepartX = 0.0;
public double animationDepartY = 0.0;
public double animationArriveeX = 0.0;
public double animationArriveeY = 0.0;
public double animationDebut = 0.0;
public double animationFin = 0.0;
public String sujetMessageAnime = "";

String processusSCORVisuel() {
    String id = nomAffiche == null ? "" : nomAffiche.trim().toUpperCase(java.util.Locale.ROOT);
    if (id.isEmpty()) return "";

    // RETURN doit être testé avant SOURCE/DELIVER à cause de sSR et sDR.
    if (id.contains("-SSR") || id.contains("-SDR") || id.equals("CA-SR")
        || id.contains("-SR") || id.contains("-DR")) return "RETURN";

    // Les agents stratégique et tactiques sP appartiennent au processus PLAN.
    if (id.equals("AS-SP1") || id.contains("-SP")) return "PLAN";
    if (id.contains("-SS")) return "SOURCE";
    if (id.contains("-SM")) return "MAKE";
    if (id.contains("-SD")) return "DELIVER";
    return "";
}

java.awt.Color couleurProcessusSCORVisuel() {
    String p = processusSCORVisuel();
    if ("PLAN".equals(p))    return new java.awt.Color(0x7B5EA7);
    if ("SOURCE".equals(p))  return new java.awt.Color(0x2980B9);
    if ("MAKE".equals(p))    return new java.awt.Color(0x27AE60);
    if ("DELIVER".equals(p)) return new java.awt.Color(0xE67E22);
    if ("RETURN".equals(p))  return new java.awt.Color(0xC0392B);
    return new java.awt.Color(0x95A5A6);
}

String badgeProcessusSCORVisuel() {
    return processusSCORVisuel();
}

boolean afficherBadgeProcessusSCORVisuel() {
    return nomAffiche != null && !nomAffiche.trim().isEmpty()
        && kindMessage != null && kindMessage.trim().isEmpty()
        && !processusSCORVisuel().isEmpty();
}
]]></AdditionalClassCode>
			<StartupCode><![CDATA[Main top = (Main) getOwner();
if (nomAffiche == null || nomAffiche.trim().isEmpty()) nomAffiche = name == null ? "" : name.trim();
if (typeAffiche == null || typeAffiche.trim().isEmpty()) typeAffiche = type == null ? "" : type.trim();
// Ne pas enregistrer les messages/vehicules de pool avec un nom vide.
if (!nomAffiche.isEmpty()) top.registerPuppet(nomAffiche, this);]]></StartupCode>
