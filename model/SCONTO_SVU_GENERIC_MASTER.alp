			<Events>
				<Event>
					<Id>1781048361744</Id>
					<Name><![CDATA[arrivee]]></Name>
					<X>-200</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1781048361742</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1781078400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[3600.0 / debitTotal() * (-Math.log(1.0 - getDefaultRandomGenerator().nextDouble()))]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[modeExecution && !modePilotageParCommande]]></Condition>
					</Properties>
					<Action><![CDATA[if (!modeExecution || modePilotageParCommande) return;

FluxEntity e = add_fluxEntites();
e.idFlux = "F_" + (++seqFlux);
e.tEntreeSysteme = time();
e.feuilleDeRoute = new java.util.ArrayList<String>();
if (scenarios.isEmpty()) {
    // Mode par defaut : tous les postes dans l'ordre d'ajout
    for (PosteGenericAgent p : postes) e.feuilleDeRoute.add(p.idPoste);
    e.typeProduit = "Produit";
} else {
    // Choix du scenario proportionnel a son debit (superposition de Poisson)
    double total = 0;
    for (ScenarioFlux sc : scenarios) total += sc.debitParHeure;
    double r = getDefaultRandomGenerator().nextDouble() * total;
    ScenarioFlux choisi = scenarios.get(scenarios.size() - 1);
    double acc = 0;
    for (ScenarioFlux sc : scenarios) {
        acc += sc.debitParHeure;
        if (r <= acc) { choisi = sc; break; }
    }
    e.feuilleDeRoute.addAll(choisi.sequence);
    e.typeProduit = choisi.typeProduit;
}
e.etapeCourante = 0;
if (!acteursSC.isEmpty()) {
    for (ActeurSC fa : acteursSC) {
        if (ActeurSC.FOURNISSEUR.equals(fa.categorie) && fa.actif) {
            ActeurSC focaleAnim1 = trouverPremierActeurParCategorie(ActeurSC.ENTREPRISE_FOCALE);
			String nomFocale1 = (focaleAnim1 != null) ? focaleAnim1.nom : "ENTREPRISE";
			emettreFluxLog(FluxLog.APPRO, fa.nom, nomFocale1, 1); break;
        }
    }
}
if (!e.feuilleDeRoute.isEmpty()) {
    PosteGenericAgent premier = trouverPoste(e.prochainPoste());
    if (premier != null) {
        positionnerEntiteSurPoste(e, premier);
        premier.enter.take(e);
    }
    else { traceln("ERREUR : premier poste introuvable"); remove_fluxEntites(e); }
} else {
    remove_fluxEntites(e);
}]]></Action>
				</Event>
				<Event>
