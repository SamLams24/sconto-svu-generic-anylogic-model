					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[  java.util.List<String> evts = board.logEvenements;
  StringBuilder sb = new StringBuilder("  Derniers evenements holoniques:\n");
  int start = Math.max(0, evts.size()-3);
  for (int i=start; i<evts.size(); i++) {
    String e = evts.get(i);
    if (e.contains("HOLON") || e.contains("AER") || e.contains("STRATEGIC") || e.contains("GOULOT"))
      sb.append("  " + e + "\n");
  }
  return sb.toString();]]></Body>
