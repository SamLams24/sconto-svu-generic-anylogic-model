		<JavaClass>
			<Id>1782200001003</Id>
			<Name><![CDATA[FluxLog]]></Name>
			<Text><![CDATA[public class FluxLog implements java.io.Serializable {
    public static final String APPRO     = "APPRO";
    public static final String LIVRAISON = "LIVRAISON";
    public static final String RETOUR    = "RETOUR";
    public static final String INFO      = "INFO";
    public String typeFlux="APPRO"; public String idSource=""; public String idCible="";
    public int qte=1; public double tEmission=0;
    public FluxLog() {}
    public FluxLog(String typeFlux, String idSource, String idCible, int qte, double t) {
        this.typeFlux=typeFlux; this.idSource=idSource; this.idCible=idCible;
        this.qte=qte; this.tEmission=t;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1781893386020</Id>
			<Name><![CDATA[TraceData]]></Name>
			<Text><![CDATA[/**
 * TraceData
 */	
public class TraceData implements Serializable {

	 public long id;
	    public double t;

	    public String niveau;       // BRUT, AGG_MICRO, AGG_SCOR, AGG_MACRO, GLOBAL, DECISION
	    public String emetteur;     // Agent/Poste/Blackboard/Supervisor
	    public String idEntite;     // F_1, CMD_1, etc.
	    public String idPoste;      // sM1.3.1
	    public String codeSCOR;     // M1.3, D1.4, etc.

	    public String evenement;    // QUEUE_ENTER, QUEUE_EXIT, PROCESS_EXIT, REBUT, FIN, KPI_UPDATE
	    public String mesure;       // WT, CT, VAT, EFFICACITE_CYCLE, WIP, REBUT, REWORK
	    public double valeurBrute;
	    public String unite;

	    public String niveauAggregation;
	    public double valeurAgregee;
	    public String formule;

	    public String commentaire;
    /**
     * Default constructor
     */
    public TraceData() {
    }
    
    public TraceData(
            long id,
            double t,
            String niveau,
            String emetteur,
            String idEntite,
            String idPoste,
            String codeSCOR,
            String evenement,
            String mesure,
            double valeurBrute,
            String unite,
            String niveauAggregation,
            double valeurAgregee,
            String formule,
            String commentaire
        ) {
            this.id = id;
            this.t = t;
            this.niveau = niveau;
            this.emetteur = emetteur;
            this.idEntite = idEntite;
            this.idPoste = idPoste;
            this.codeSCOR = codeSCOR;
            this.evenement = evenement;
            this.mesure = mesure;
            this.valeurBrute = valeurBrute;
            this.unite = unite;
            this.niveauAggregation = niveauAggregation;
            this.valeurAgregee = valeurAgregee;
            this.formule = formule;
            this.commentaire = commentaire;
        }

	@Override
	public String toString() {
		return super.toString();
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1781948088031</Id>
			<Name><![CDATA[MicroResponsabilite]]></Name>
			<Text><![CDATA[/**
 * MicroResponsabilite
 */	
public class MicroResponsabilite implements Serializable {

    /**
     * Default constructor
     */
	public String idResponsabilite = "";

    public String idMicroActivite = "";
    public String nomMicroActivite = "";

    public String idActeur = "";
    public String nomActeur = "";
    public String categorieActeur = "";
    public String typeAnnexeActeur = "";

    // STRATEGIC / TACTICAL / OPERATIONAL / MACHINE
    public String niveauHierarchique = "OPERATIONAL";

    // StrategicAgent / OperationalAgent / MachineSim
    public String typeAgent = "OperationalAgent";

    // true si niveau tactique représenté par StrategicAgent logique
    public boolean isTactic = false;

    public int quantite = 1;

    public java.util.ArrayList<String> idsAgentsCrees =
        new java.util.ArrayList<String>();

    public java.util.ArrayList<String> idsMachinesAffectees =
        new java.util.ArrayList<String>();

    public boolean actif = true;

    public MicroResponsabilite() {
    }
    
    public String idsAgentsText() {
        if (idsAgentsCrees == null || idsAgentsCrees.isEmpty()) return "-";
        return String.join(",", idsAgentsCrees);
    }

    public String idsMachinesText() {
        if (idsMachinesAffectees == null || idsMachinesAffectees.isEmpty()) return "-";
        return String.join(",", idsMachinesAffectees);
    }

	@Override
	public String toString() {
		return super.toString();
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1781948623945</Id>
			<Name><![CDATA[MachineSim]]></Name>
			<Text><![CDATA[/**
 * MachineSim
 */	
public class MachineSim implements Serializable {

	public String idMachine = "";
    public String nom = "";

    public String idMicroActivite = "";
    public String nomMicroActivite = "";

    public String idOperationalAgent = "";

    public String type = "GENERIC_MACHINE";

    public int capacite = 1;
    public double cycleTime = 0.0;

    public double mtbf = 0.0;
    public double mttr = 0.0;

    public boolean active = true;

    /**
     * Default constructor
     */
    public MachineSim() {
    }

    public MachineSim(
            String idMachine,
            String nom,
            String idMicroActivite,
            String nomMicroActivite,
            String idOperationalAgent,
            String type,
            int capacite,
            double cycleTime,
            double mtbf,
            double mttr
        ) {
            this.idMachine = idMachine;
            this.nom = nom;
            this.idMicroActivite = idMicroActivite;
            this.nomMicroActivite = nomMicroActivite;
            this.idOperationalAgent = idOperationalAgent;
            this.type = type;
            this.capacite = capacite;
            this.cycleTime = cycleTime;
            this.mtbf = mtbf;
            this.mttr = mttr;
            this.active = true;
        }

        public double disponibiliteTheorique() {
            if (mtbf + mttr <= 0) return 1.0;
            return mtbf / (mtbf + mttr);
        }
	@Override
	public String toString() {
		return super.toString();
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
	</JavaClasses>
