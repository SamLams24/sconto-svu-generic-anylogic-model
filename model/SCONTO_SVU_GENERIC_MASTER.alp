				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1801000000031</Id>
					<Name><![CDATA[metriquesSCORCalculablesRows]]></Name>
					<X>-440</X><Y>5380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.ArrayList<Object[]> rows=new java.util.ArrayList<Object[]>();
String[] lignes=catalogueMetriquesAHPRaw().split("\n");
initialiserProfilsNormalisationDefaut();
for(String ligne:lignes){
    if(ligne==null||ligne.trim().isEmpty())continue; String[] p=ligne.split("\\|",-1); if(p.length<7)continue;
    String code=p[1].trim(); if(!estMetriqueSCORDisponiblePourTableaux(code))continue;
    double v=valeurRuntimeMetriqueSCOR(code); double score=scorePerformanceMetriqueSCOR(code,v);
    NormalizationProfile np=normalizationProfiles.get(code.toUpperCase(java.util.Locale.ROOT));
    FuzzyGradeSet fg=Double.isNaN(score)?null:FuzzyGradeSet.depuisScore(score);
    rows.add(new Object[]{attributCourtSCOR(p[5]),code,p[2],p[3],"N"+p[4],fmt3(v),uniteMetriqueSCOR(code),
        np==null?"NON CALIBRE":fmt3(np.bottom()),np==null?"NON CALIBRE":fmt3(np.perfect()),
        Double.isNaN(score)?"NON SCORE":fmt3(score),fg==null?"-":fg.compact(),statutMetriqueSCOR(code),sourceFormuleMetriqueSCOR(code)});
}
if(rows.isEmpty())return emptyRows("Aucune metrique SCOR calculable",metriquesSCORCalculablesColumns().length);
return rows.toArray(new Object[0][]);]]></Body>
				</Function>
