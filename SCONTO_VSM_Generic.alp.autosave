				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782200003003</Id>
					<Name><![CDATA[viderActeursSC]]></Name>
					<X>-300</X><Y>1180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[acteursSC.clear(); fluxLogs.clear(); selectedActeurIdx = -1;
messageStatut = "Acteurs supprimes.";
board.logEvent("[LOG] Acteurs SC vides.");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782200003004</Id>
					<Name><![CDATA[emettreFluxLog]]></Name>
					<X>-300</X><Y>1220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[typeFlux]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idSrc]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idCib]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[qte]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (fluxLogs == null) fluxLogs = new java.util.ArrayList<FluxLog>();
String typeNormalise = typeFluxLisible(typeFlux);
String src = idSrc == null ? "" : idSrc;
String dst = idCib == null ? "" : idCib;
int quantite = Math.max(1, qte);

boolean doublonRecent = false;
for (FluxLog f : fluxLogs) {
    if (f == null) continue;
    String ft = typeFluxLisible(f.typeFlux);
    if (ft.equals(typeNormalise)
        && src.equals(f.idSource)
        && dst.equals(f.idCible)
        && f.qte == quantite
        && Math.abs(time() - f.tEmission) <= 1.0) {
        doublonRecent = true;
        break;
    }
}

if (!doublonRecent) {
    fluxLogs.add(new FluxLog(typeNormalise, src, dst, quantite, time()));
    while (fluxLogs.size() > 200) fluxLogs.remove(0);
}

// Les flux physiques sont maintenant documentés dans Flux Supply Chain et par des
// lignes métier dédiées. On évite donc la ligne générique "Flux métier" dans le suivi.
if (FluxLog.INFO.equals(typeFlux)) {
    ajouterSuivi("Flux metier", "Declenchement du flux " + typeFlux, "Quantite=" + quantite, src, dst, typeFlux);
}

// Portage ancienne version : APPRO/LIVRAISON ne sont plus seulement des emails,
// ils utilisent une icone Vehicle comme sourcingTruck/deliveryTruck.
if (FluxLog.APPRO.equals(typeFlux)) {
    animerApprovisionnementVehicule(src, dst, quantite);
} else if (FluxLog.LIVRAISON.equals(typeFlux)) {
    animerLivraisonVehicule(src, dst, quantite);
} else if (FluxLog.RETOUR.equals(typeFlux)) {
    ajouterSuiviDetaille(
        "Retour",
        "Flux retour declenche",
        "Un produit ou une commande fait l'objet d'un retour vers l'entreprise focale.",
        "Agent Return / Client",
        "Vehicule retour",
        "Flux retour",
        "Quantite=" + quantite,
        src,
        dst,
        src + " -> " + dst,
        "DR1 / SR1",
        "Retourner le produit pour traitement.",
        "Produit livre ou non conforme",
        "Retour en cours",
        "Taux de retour ; cout de non-qualite ; delai retour"
    );
    String srcAnim = puppet(src) != null ? src : "CUSTOMER:AO-sS1.4";
    String dstAnim = puppet(dst) != null ? dst : "MANUFACTURER:AO-sD1.8";
    animerVehiculePhysiqueAllerRetour(srcAnim, dstAnim, "returnTruck", "SCOR DR1 -> RETURN | Flux physique retour x" + quantite);
} else {
    animerMessage(src, dst, "message", typeNormalise + " x" + quantite);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
