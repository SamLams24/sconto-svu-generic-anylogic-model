								<Code><![CDATA[agent.dernierWait = time() - agent.tDebutAttente;  // attente du poste courant
agent.sommeWaitTime += agent.dernierWait;          // cumul global (Lead Time)

Main main = (Main) getOwner();

main.addTrace(
    "BRUT",
    "Queue:" + idPoste,
    agent.idFlux,
    idPoste,
    codeSCOR,
    "QUEUE_EXIT",
    "Temps d’attente",
    agent.dernierWait,
    "s",
    "",
    Double.NaN,
    "",
    "Temps passé dans la file d’attente"
);]]></Code>
