					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// --- Entite en transit vers un SINK de rejet (ejection "fuite" avec cible) : rebut terminal ---
if (agent.destineeAuRebut && typePoste == TypePoste.SINK) {
    ((Main) getOwner()).rebuter(agent, idPoste, agent.codeSCOROrigineRebut);
    return;
}

// --- Decision d'aiguillage (convention SCONTO : TRUE = flux normal) ---
if (regleAiguillage != null) {
    boolean portTrue = randomTrue(regleAiguillage.tauxTrue);
    if (!portTrue) {
        if ("fuite".equals(regleAiguillage.typeControle)) {
            // FALSE -> ejection vers le poste cible (transit reel, comptabilise), sinon rebut direct
            String cible = regleAiguillage.idCibleEchec;
            if (cible != null && !cible.trim().isEmpty()) {
                ((Main) getOwner()).routerVersCibleEchec(agent, cible.trim(), idPoste);
            } else {
                ((Main) getOwner()).rebuter(agent, idPoste, ((Main) getOwner()).cleKPI(this));
            }
            return;
        } else {
            // "conformite" : FALSE -> reprise (rework)
            agent.reworkRequis = true;
            ((Main) getOwner()).rerouterRework(agent, regleAiguillage.idCibleEchec, idPoste);
            return;
        }
    }
    agent.reworkRequis = false;
}
// Reapprovisionnement reel du stock : toute entite qui traverse normalement
// un poste STOCKAGE (production normale, ni rebut ni reprise) y ajoute une unite.
if (typePoste == TypePoste.STOCKAGE) {
    niveauStock += 1;
}

// Consommation reelle de matiere (MRP) : un poste marque consommeMatiere=true
// (typiquement un poste de fabrication) decremente, pour chaque matiere de la
// nomenclature du produit traite, la quantite necessaire a une unite. Sans
// impact si aucune nomenclature n'a ete declaree pour ce produit.
if (consommeMatiere) {
    ((Main) getOwner()).consommerMatieresPour(agent.typeProduit);
}

// --- ECLATEMENT DU LOT D'APPROVISIONNEMENT EN PRODUITS INDIVIDUELS ---
// A ce poste (marque estPointEclatement), une entite-lot venue des fournisseurs
// (estLotAppro=true) est remplacee par nbProduitsParLot entites-produits qui
// poursuivent SEULES le reste de la route (production detaillee cote entreprise).
// Le lot d'origine est detruit. Ainsi le flux fournisseur reste leger (1 entite
// par livraison) tandis que la production interne est detaillee produit par produit.
if (estPointEclatement && agent.estLotAppro) {
    Main mainRef = (Main) getOwner();
    int n = Math.max(1, nbProduitsParLot);
    // la suite de la route a partir de ce poste (on retire l'etape courante deja faite)
    java.util.ArrayList<String> routeSuite = new java.util.ArrayList<String>();
    if (agent.feuilleDeRoute != null) {
        for (int k = agent.etapeCourante + 1; k < agent.feuilleDeRoute.size(); k++) {
            routeSuite.add(agent.feuilleDeRoute.get(k));
        }
    }
    for (int i = 0; i < n; i++) {
        FluxEntity prod = mainRef.add_fluxEntites();
        prod.idFlux = "PROD_" + idPoste + "_" + (i + 1) + "_" + agent.idFlux;
        prod.tEntreeSysteme = agent.tEntreeSysteme; // conserve l'horodatage d'entree systeme
        prod.sommeWaitTime = agent.sommeWaitTime;   // herite de l'attente deja subie par le lot
        prod.sommeVAT = agent.sommeVAT;             // et de la valeur ajoutee deja accumulee
        prod.typeProduit = "Produit";
        prod.quantiteTransportee = 1;
        prod.estLotAppro = false;
        prod.feuilleDeRoute = new java.util.ArrayList<String>(routeSuite);
        prod.etapeCourante = -1; // routerEntite incrementera vers l'etape 0 de routeSuite
        // Placer le produit SUR le poste d'eclatement avant tout routage, sinon
        // il serait anime depuis sa position par defaut (0,0), donnant l'impression
        // qu'il "descend du haut" de la vue.
        prod.setXY(getX(), getY());
        prod.estVisible = true;
        if (!routeSuite.isEmpty()) {
            mainRef.routerEntite(prod);
        } else {
            mainRef.remove_fluxEntites(prod);
        }
    }
    mainRef.board.logEvent("[ECLATEMENT] " + nom + " : lot de " + agent.quantiteTransportee
        + " unite(s) eclate en " + n + " produit(s) individuel(s).");
    mainRef.remove_fluxEntites(agent); // le lot d'origine disparait
    return;
}

// --- BATCH DE TRAITEMENT / JONCTION MULTI-AMONT ---
// tailleLot == 1 (defaut) : comportement historique, routage immediat unite par unite.
// tailleLot > 1 : l'entite est mise en attente dans le lot de ce poste (lotEnCours).
// Tant que le lot n'est pas complet, elle est simplement masquee (elle a bien
// ete traitee par CE poste, mais n'est pas encore relachee vers la suite).
// Des que le lot atteint tailleLot, TOUTES les entites accumulees sont
// routees d'un seul coup. Ce meme mecanisme sert aussi de jonction multi-amont
// quand attendTousLesPredecesseurs=true (tailleLot est alors automatiquement
// aligne sur le nombre de chainesPrecedents a la creation/modification du poste) :
// le poste ne relache la suite du flux qu'une fois qu'il a recu une entite de
// chacune de ses branches amont declarees.
if (tailleLot <= 1) {
    ((Main) getOwner()).routerEntite(agent);
} else {
    lotEnCours.add(agent);
    if (lotEnCours.size() < tailleLot) {
        ((Main) getOwner()).masquerEntite(agent);
    } else {
        java.util.ArrayList<FluxEntity> lotComplet = new java.util.ArrayList<FluxEntity>(lotEnCours);
        lotEnCours.clear();
        ((Main) getOwner()).emettreFluxLog(FluxLog.APPRO, nomActeurResponsable, nom, lotComplet.size());
        ((Main) getOwner()).board.logEvent("[BATCH] " + nom + " relache un lot de " + lotComplet.size() + " entite(s).");
        for (FluxEntity entiteLot : lotComplet) {
            ((Main) getOwner()).routerEntite(entiteLot);
        }
    }
}]]></Code>
							</Value>
						</Parameter>
