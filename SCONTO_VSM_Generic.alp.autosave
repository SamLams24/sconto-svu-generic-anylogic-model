				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781619755987</Id>
					<Name><![CDATA[colRETURNContentF]]></Name>
					<X>-190</X><Y>2340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[  StringBuilder sb = new StringBuilder();
  for (PosteGenericAgent p : postes) {
    if (!p.codeSCOR.startsWith("R")) continue;
    KPIBundle k = board.kpiParPoste.get(cleKPI(p));
    double ct = k!=null?k.avgCycleTime():0;
    int wip = p.queue.size()+p.delay.size();
    sb.append(String.format("%s\n%s\nCT:%.0fs WIP:%d%s\n---\n",
      p.idPoste, p.nom.length()>10?p.nom.substring(0,10):p.nom,
      ct, wip, p.goulot?" [!]":""));
  }
  if (sb.length()==0) return "(vide)";
  return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781619810868</Id>
					<Name><![CDATA[n2ValF]]></Name>
					<X>-190</X><Y>4370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[  if (opAgents.isEmpty()) return "  (aucun OperationalAgent actif - configurez des postes et demarrez la simulation)";
  StringBuilder sb = new StringBuilder();
  for (OperationalAgent op : opAgents)
    sb.append(String.format("  [%s] %s  etat:%-10s WT:%.0fs\n", op.idPoste, op.libelleAffichage, op.etatHolon, 0.0));
  return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781619984913</Id>
					<Name><![CDATA[formActListF]]></Name>
					<X>-440</X><Y>3140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (acteursSC.isEmpty()) {
        return "Aucun acteur configuré. Utilisez le formulaire ci-dessus.";
    }

    StringBuilder sb = new StringBuilder();

for (int i = 0; i < acteursSC.size(); i++) {
        ActeurSC a = acteursSC.get(i);

        sb.append(String.format(
            "[%d] %-24s | %-18s | %-24s | micro:%s\n",
            i,
            a.nom,
            a.categorie,
            a.typeAnnexe == null || a.typeAnnexe.isEmpty() ? "-" : a.typeAnnexe,
            a.microActivitesText()
        ));
}

return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781622742219</Id>
					<Name><![CDATA[getRapportHolons]]></Name>
					<X>-300</X><Y>1640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (opAgents.isEmpty())
    return "Aucun OperationalAgent actif.\n(Configurez et démarrez la simulation)";

StringBuilder sb = new StringBuilder();
sb.append("=== HOLARCHIE ADACOR — OperationalAgents ===\n");
sb.append(String.format("%-6s %-18s %-6s  %-8s  %5s  %5s  %5s  %5s  %4s  %3s\n",
    "ID", "Nom", "SCOR", "Etat", "DurEt", "File", "CT", "WT", "N", "G"));
sb.append("-".repeat(90)).append("\n");

for (OperationalAgent op : opAgents) {
    sb.append(op.getRapportHolon()).append("\n");
}

sb.append("-".repeat(90)).append("\n");
sb.append(String.format("Total agents: %d | WIP global: %d entités\n",
    opAgents.size(), fluxEntites.size()));
return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781642422640</Id>
					<Name><![CDATA[chargerActivitesSCORN3]]></Name>
					<X>-300</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[combobox]]></Name>
						<Type><![CDATA[ShapeComboBox]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[processus]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String[] items;

switch (processus) {

  case "PLAN":
    items = new String[] {
      "P1.1 — Identifier et agréger les besoins SC",
      "P1.2 — Identifier et agréger les ressources SC",
      "P1.3 — Équilibrer ressources et besoins",
      "P1.4 — Établir les plans supply chain",
      "P1.5 — Gérer la performance supply chain",
      "P2.1 — Identifier les besoins d'approvisionn.",
      "P2.2 — Évaluer les capacités fournisseurs",
      "P2.3 — Équilibrer capacités et besoins sourcing",
      "P2.4 — Établir les plans d'approvisionn.",
      "P3.1 — Identifier les besoins de production",
      "P3.2 — Évaluer les capacités de fabrication",
      "P3.3 — Équilibrer capacité et charge prod.",
      "P3.4 — Établir le plan de fabrication",
      "P4.1 — Identifier les besoins de livraison",
      "P4.2 — Évaluer les capacités logistiques",
      "P4.3 — Équilibrer capacités et demandes livraison",
      "P4.4 — Établir le plan de distribution",
      "P5.1 — Identifier les besoins de retour",
      "P5.2 — Évaluer les capacités traitement retour",
      "P5.3 — Établir le plan de gestion des retours"
    };
    break;

  case "SOURCE":
    items = new String[] {
      "S1.1 — Planifier les livraisons fournisseur",
      "S1.2 — Recevoir les produits",
      "S1.3 — Vérifier les produits reçus",
      "S1.4 — Transférer les produits",
      "S1.5 — Autoriser le paiement fournisseur",
      "S2.1 — Identifier les fournisseurs",
      "S2.2 — Programmer les réceptions",
      "S2.3 — Recevoir les produits commandés",
      "S2.4 — Vérifier la conformité",
      "S2.5 — Stocker ou transférer les produits",
      "S3.1 — Identifier les fournisseurs spécifiques",
      "S3.2 — Négocier et contractualiser",
      "S3.3 — Recevoir les produits sur mesure",
      "S3.4 — Vérifier les spécifications techniques",
      "S3.5 — Valider les approvisionnements"
    };
    break;

  case "MAKE":
    items = new String[] {
      "M1.1 — Programmer les activités de production",
      "M1.2 — Préparer les ressources de production",
      "M1.3 — Produire et tester",
      "M1.4 — Emballer",
      "M1.5 — Stocker / mettre en buffer",
      "M1.6 — Libérer les produits finis",
      "M2.1 — Programmer les ordres de fabrication",
      "M2.2 — Émettre les matières premières",
      "M2.3 — Produire et contrôler",
      "M2.4 — Emballer (MTO)",
      "M2.5 — Préparer l'expédition",
      "M2.6 — Libérer les produits (MTO)",
      "M3.1 — Finaliser les spécifications",
      "M3.2 — Programmer les activités (ETO)",
      "M3.3 — Construire / assembler",
      "M3.4 — Tester et valider (ETO)",
      "M3.5 — Emballer (ETO)",
      "M3.6 — Libérer le produit (ETO)"
    };
    break;

  case "DELIVER":
  items = new String[] {
    // D1 — Deliver Stocked Product
    "D1.1 — Traiter la demande et le devis",
    "D1.2 — Recevoir, saisir et valider la commande",
    "D1.3 — Réserver l'inventaire et déterminer la date de livraison",
    "D1.4 — Consolider les commandes",
    "D1.5 — Construire les chargements",
    "D1.6 — Définir les routes d'expédition",
    "D1.7 — Sélectionner les transporteurs et tarifer les expéditions",
    "D1.8 — Recevoir le produit depuis Source ou Make",
    "D1.9 — Prélever le produit",
    "D1.10 — Emballer le produit",
    "D1.11 — Charger le véhicule et générer les documents d'expédition",
    "D1.12 — Expédier le produit",
    "D1.13 — Réceptionner et vérifier le produit par le client",
    "D1.14 — Installer le produit",
    "D1.15 — Facturer",

    // D2 — Deliver Make-to-Order Product
    "D2.1 — Traiter la demande et le devis",
    "D2.2 — Recevoir, configurer, saisir et valider la commande",
    "D2.3 — Réserver l'inventaire et déterminer la date de livraison",
    "D2.4 — Consolider les commandes",
    "D2.5 — Construire les chargements",
    "D2.6 — Définir les routes d'expédition",
    "D2.7 — Sélectionner les transporteurs et tarifer les expéditions",
    "D2.8 — Recevoir le produit depuis Source ou Make",
    "D2.9 — Prélever le produit",
    "D2.10 — Emballer le produit",
    "D2.11 — Charger le produit et générer les documents d'expédition",
    "D2.12 — Expédier le produit",
    "D2.13 — Réceptionner et vérifier le produit par le client",
    "D2.14 — Installer le produit",
    "D2.15 — Facturer",

    // D3 — Deliver Engineer-to-Order Product
    "D3.1 — Obtenir et répondre à la demande RFP/RFQ",
    "D3.2 — Négocier et recevoir le contrat",
    "D3.3 — Saisir la commande, engager les ressources et lancer le programme",
    "D3.4 — Planifier l'installation",
    "D3.5 — Construire les chargements",
    "D3.6 — Définir les routes d'expédition",
    "D3.7 — Sélectionner les transporteurs et tarifer les expéditions",
    "D3.8 — Recevoir le produit depuis Source ou Make",
    "D3.9 — Prélever le produit",
    "D3.10 — Emballer le produit",
    "D3.11 — Charger le produit et générer les documents d'expédition",
    "D3.12 — Expédier le produit",
    "D3.13 — Réceptionner et vérifier le produit par le client",
    "D3.14 — Installer le produit",
    "D3.15 — Facturer",

    // D4 — Deliver Retail Product
    "D4.1 — Générer le planning de réassort",
    "D4.2 — Recevoir le produit en magasin",
    "D4.3 — Prélever le produit depuis l'arrière-boutique",
    "D4.4 — Mettre le produit en rayon",
    "D4.5 — Remplir le panier d'achat",
    "D4.6 — Procéder au paiement / checkout",
    "D4.7 — Livrer et/ou installer"
  };
  break;

  case "RETURN":
    items = new String[] {
      "SR1.1 — Identifier le retour défectueux",
      "SR1.2 — Autoriser le retour",
      "SR1.3 — Recevoir le produit retourné",
      "SR1.4 — Vérifier le produit",
      "SR1.5 — Disposer ou réparer",
      "SR2.1 — Planifier le retour MRO",
      "SR2.2 — Recevoir les équipements",
      "SR2.3 — Inspecter",
      "SR2.4 — Réparer ou reconditionner",
      "SR2.5 — Réexpédier",
      "SR3.1 — Identifier l'excédent",
      "SR3.2 — Autoriser le retour excédent",
      "SR3.3 — Recevoir les produits excédentaires",
      "SR3.4 — Réintégrer ou éliminer"
    };
    break;

  default:
    items = new String[] {};
    break;
}

combobox.setItems(items);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781893614780</Id>
					<Name><![CDATA[addTrace]]></Name>
					<X>-300</X><Y>330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[niveau]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[emetteur]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idEntite]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[evenement]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[mesure]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[valeurBrute]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[unite]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[niveauAggregation]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[valeurAgregee]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[formule]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[commentaire]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String niv = niveau == null ? "" : niveau.trim();
String evt = evenement == null ? "" : evenement.trim();
String em = emetteur == null ? "" : emetteur.trim();
String idP = nettoyerIdPosteTrace(idPoste, evt, em);
String code = nettoyerCodeSCORTraceAvecContexte(codeSCOR, evt, em);
String idEnt = idEntite == null ? "" : idEntite.trim();

// Passe nettoyage : les flux visuels proxy servent uniquement à faire réagir
// la vue globale. Ils ne doivent pas polluer Execution Brute ni les exports métier.
if ("BRUT".equals(niv)) {
    String idEntU = idEnt.toUpperCase(java.util.Locale.ROOT);
    String emU = em.toUpperCase(java.util.Locale.ROOT);
    if (idEntU.startsWith("VISUEL_") || idEntU.contains("TRACE_VISUEL") || emU.contains("VISUEL-FLOW")) {
        return;
    }
}

long idLocal;

if ("BRUT".equals(niv)) {
    idLocal = ++seqTraceBrute;
} else {
    idLocal = ++seqTraceAgregee;
}
seqTrace++;

TraceData r = new TraceData(
        idLocal,
        time(),
        niv,
        em,
        idEnt,
        idP,
        code,
        evt,
        mesure,
        valeurBrute,
        unite,
        niveauAggregation,
        valeurAgregee,
        formule,
        commentaire
    );

    if ("BRUT".equals(niv)) {
        tracesBrutes.add(r);
        if (tracesBrutes.size() > maxTraceRows) tracesBrutes.remove(0);
    } else {
        tracesAgregees.add(r);
        if (tracesAgregees.size() > maxTraceRows) tracesAgregees.remove(0);
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781893875465</Id>
					<Name><![CDATA[cut]]></Name>
					<X>-170</X><Y>290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[s]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[n]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (s == null) return "";
if (s.length() <= n) return s;
return s.substring(0, Math.max(0, n - 1)) + ".";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781893925471</Id>
					<Name><![CDATA[fmt]]></Name>
					<X>-170</X><Y>320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[v]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (Double.isNaN(v)) return "";
return String.format("%.2f", v);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781894931934</Id>
					<Name><![CDATA[tableConfigMicroActivitesText]]></Name>
					<X>-300</X><Y>1040</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {12, 20, 8, 24, 20, 12, 16, 6, 18};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "CONFIGURATION — MICRO-ACTIVITES ET ACTEURS RESPONSABLES",
        w
    ));

    sb.append(tableRow(new String[]{
        "ID Poste",
        "Micro-activite",
        "SCOR",
        "Acteur resp.",
        "Categorie",
        "Type poste",
        "Loi temps",
        "Cap.",
        "Precedents"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (postes.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", "Aucune micro-activite", "-", "-", "-", "-", "-", "-", "-"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    for (PosteGenericAgent p : postes) {
        String loi = "-";
        if (p.loiTemps != null) {
            loi =
                p.loiTemps.distribution
                + "("
                + fmt2(p.loiTemps.p1)
                + ","
                + fmt2(p.loiTemps.p2)
                + ")";
        }

        String precedents =
            p.chainesPrecedents != null && !p.chainesPrecedents.trim().isEmpty()
            ? p.chainesPrecedents
            : "-";

        sb.append(tableRow(new String[]{
            p.idPoste,
            p.nom,
            p.codeSCOR,
            p.nomActeurResponsable,
            p.categorieActeurResponsable,
            String.valueOf(p.typePoste),
            loi,
            String.valueOf(p.capaciteSimultanee),
            precedents
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781895292561</Id>
					<Name><![CDATA[tableExecutionBruteText]]></Name>
					<X>-300</X><Y>1060</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {5, 8, 16, 20, 14, 8, 16, 10, 10, 7, 30};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "TABLEAU D'EXECUTION — DONNEES BRUTES EMISES PENDANT LA SIMULATION",
        w
    ));

    sb.append(tableRow(new String[]{
        "#",
        "T(s)",
        "Entite",
        "Emetteur",
        "Poste",
        "SCOR",
        "Evenement",
        "Mesure",
        "Brut",
        "Unite",
        "Commentaire"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (tracesBrutes == null || tracesBrutes.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", fmt1(time()), "-", "System", "-", "-", "ATTENTE", "-",
            "-", "-", modeExecution ? "Simulation en cours, aucune trace" : "Simulation non demarree"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    int debut = Math.max(0, tracesBrutes.size() - 25);

    for (int i = debut; i < tracesBrutes.size(); i++) {
        TraceData r = tracesBrutes.get(i);

        sb.append(tableRow(new String[]{
            String.valueOf(r.id),
            fmt1(r.t),
            r.idEntite,
            r.emetteur,
            r.idPoste,
            r.codeSCOR,
            r.evenement,
            r.mesure,
            fmt2(r.valeurBrute),
            r.unite,
            r.commentaire
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

    sb.append("Lignes affichees : dernieres ")
      .append(Math.min(25, tracesBrutes.size()))
      .append(" / ")
      .append(tracesBrutes.size())
      .append(" traces brutes conservees en memoire.");

    return sb.toString();]]></Body>
				</Function>
