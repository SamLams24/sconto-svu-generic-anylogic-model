                if (ok) {
                    champStockInitialProduitFini =
                        Math.max(0, Double.parseDouble(pfField.getText().trim()));

                    champStockInitialMatiereGlobal =
                        Math.max(0, Double.parseDouble(matField.getText().trim()));

                    // Une modification manuelle constitue une demande explicite d'écrasement
                    // des stocks JSON par des valeurs globales personnalisées.
                    profilTestActif = "PERSONNALISE";
                    appliquerStocksInitiauxConfig();

                    afficherMessageTopMost(
                        "Parametres appliques :\n" + stockInitialResume(),
                        "Stocks initiaux"
                    );
                }

            } catch (Throwable ex) {
