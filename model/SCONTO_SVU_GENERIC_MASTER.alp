						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1781078400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[30]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[30]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[((Main) getOwner()).modeExecution]]></Condition>
					</Properties>
					<Action><![CDATA[gererPanne();]]></Action>
