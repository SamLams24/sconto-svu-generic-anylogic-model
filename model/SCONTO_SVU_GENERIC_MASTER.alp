			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781200000050</Id>
					<Name><![CDATA[normaliser]]></Name>
					<X>50</X><Y>390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[val]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[min]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[max]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Garde-fou global : aucune valeur NaN/Infinity ne doit atteindre les graphiques ou le PI.
if (Double.isNaN(val) || Double.isInfinite(val)) return 0.0;
if (Double.isNaN(min) || Double.isInfinite(min)) min = 0.0;
if (Double.isNaN(max) || Double.isInfinite(max)) max = 1.0;
if (max == min) return 0.0;
double n = (val - min) / (max - min);
if (Double.isNaN(n) || Double.isInfinite(n)) return 0.0;
return Math.min(1.0, Math.max(0.0, n));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781700000020</Id>
					<Name><![CDATA[agregerN3]]></Name>
					<X>-500</X><Y>250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metriques]]></Name>
						<Type><![CDATA[java.util.ArrayList<MetriqueN3>]]></Type>
					</Parameter>
					<Body><![CDATA[// C13 : agregation des grades flous, pas des valeurs physiques heterogenes.
FuzzyGradeSet g=FuzzyGradeSet.agregerMetriques(metriques);
return g.defuzzifier();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000610</Id>
					<Name><![CDATA[poidsEffectifN3]]></Name>
					<X>-500</X><Y>290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nomMetrique]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[poidsParDefaut]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Consulte le poids personnalise par l'utilisateur (tableau de pilotage N3)
// pour cette metrique, identifiee par son nom exact. Si l'utilisateur n'a
// jamais touche cette metrique, on retombe sur le poids egal par defaut (1/N) --
// jamais d'erreur, jamais de valeur arbitraire non documentee.
if (poidsN3Personnalises.containsKey(nomMetrique)) {
    return Math.max(0.0, poidsN3Personnalises.get(nomMetrique));
}
return poidsParDefaut;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781200000051</Id>
					<Name><![CDATA[calculerPIGlobal]]></Name>
					<X>50</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();
BlackboardAgent board = main.board;
if (board == null) return 0;
detailN3.clear(); // legacy name; contient des metriques SCOR N1/N2/N3 runtime

// Bloc B.2 -- PERIMETRE DU PI = ENTREPRISE FOCALE. board.kpiParMacro agrege
// TOUS les postes d'un macro-processus quel que soit l'acteur responsable :
// les postes de categorie CLIENT ou FOURNISSEUR y entrent au meme titre que
// ceux de l'entreprise focale (audit B.1 : confirme sur les 3 scenarios
// groupes actuels). On reconstruit ici des bundles macro LOCAUX en
// n'agregeant que les micro-activites dont l'acteur responsable est
// l'entreprise focale (ActeurSC.ENTREPRISE_FOCALE, deja utilise ailleurs
// dans ce master pour l'export ABox) -- jamais un test sur un nom
// d'entreprise (aucun "ZENER"/nomEntreprise.contains(...) ici). board.kpiParMacro
// n'est PAS mute : il continue d'alimenter les vues et la detection de
// goulots sur la chaine etendue.
KPIBundle sP = new KPIBundle(), sS = new KPIBundle(), sM = new KPIBundle(),
          sD = new KPIBundle(), sR = new KPIBundle();
java.util.HashMap<String,Long> unitesParMacro = new java.util.HashMap<String,Long>();
java.util.HashMap<String,Double> nominalPondereParMacro = new java.util.HashMap<String,Double>();
for (PosteGenericAgent p : main.postes) {
    if (p == null) continue;
    if (!ActeurSC.ENTREPRISE_FOCALE.equals(main.normaliserCategorieActeur(p.categorieActeurResponsable))) continue;
    KPIBundle b = board.kpiParMicroActivite.get(p.idPoste);
    if (b == null) continue;
    String macroP = main.macroPrefixe(p.codeSCOR);
    // Nombre d'unites entrees dans le macro = plus grand nombre de passages
    // observe sur un de ses postes. Sert de denominateur au temps de cycle
    // du macro-processus (voir plus bas).
    Long mx = unitesParMacro.get(macroP);
    if (mx == null || b.count > mx.longValue()) unitesParMacro.put(macroP, b.count);
    // Nominal du macro, pondere par le nombre de passages reels de ce poste :
    // un poste traverse par 18% des unites (rework) ne pese que 0,18 fois sa
    // duree nominale, exactement comme dans la valeur observee.
    double nominalPoste = main.dureeTraitementNominale(p);
    if (nominalPoste > 0 && b.count > 0) {
        Double accNom = nominalPondereParMacro.get(macroP);
        nominalPondereParMacro.put(macroP, (accNom == null ? 0.0 : accNom.doubleValue()) + nominalPoste * b.count);
    }
    if ("sS".equals(macroP)) sS.agreger(b);
    else if ("sM".equals(macroP)) sM.agreger(b);
    else if ("sD".equals(macroP)) sD.agreger(b);
    else if ("sR".equals(macroP)) sR.agreger(b);
    else if ("sP".equals(macroP)) sP.agreger(b);
}
double wip = board.avgWIP();
double termineesDebit = board.totalTerminees;
try {
    if (main.nbTermines > termineesDebit) termineesDebit = main.nbTermines;
    if (board.kpiGlobal != null && board.kpiGlobal.count > termineesDebit) termineesDebit = board.kpiGlobal.count;
} catch (Throwable ignored) {}
double debit = time() > 0 ? termineesDebit * 3600.0 / time() : 0;

// Capacite de reference du systeme = somme des capacites simultanees declarees
// sur tous les postes. Utilisee comme borne haute realiste pour normaliser le WIP,
// au lieu d'une constante arbitraire (500) sans rapport avec le modele de l'utilisateur.
double capaciteTotale = 0;
for (PosteGenericAgent p : main.postes) capaciteTotale += p.capaciteSimultanee;
if (capaciteTotale <= 0) capaciteTotale = 1; // garde-fou division par zero

// ============================================================
// RL — Reliability : seules les mesures réellement observables sur le run
// contribuent au PI.
// Bloc B.2 -- Adaptation documentee par rapport au code donneur : le
// donneur consolide tout sur sa fonction tauxCommandesLivreesCloses()
// (ratio SERVIE/(SERVIE+EN_RETARD+REFUSEE+BLOQUE_*), REAPPRO_ exclus).
// Cette fonction existe deja dans CE master sous le meme nom mais avec une
// semantique DEGENERE (elle retourne toujours 1.0 des qu'une commande a
// clos -- confirme par audit B.1, MERGE_PROGRESS.md) : l'appeler ici
// afficherait RL a tort en permanence a 10/10. main.verifierFillRate() de
// CE master calcule deja exactement le ratio recherche (commandes clientes
// livrees a temps parmi les commandes clientes CLOSES), sous un nom
// different -- reutilise ici a la place, conformement au principe
// "composer/reutiliser, ne pas dupliquer" (Bloc B.1). tauxCommandesLivreesCloses()
// lui-meme N'EST PAS modifie (differe a B.3 avec le reste des mappings SCOR).
// La garde d'echantillon (nombreCommandesClosesFiabilite()/seuilMinEchantillonRL,
// Bloc B.1) est en revanche portee exactement comme le donneur.
// ============================================================
java.util.ArrayList<MetriqueN3> rl = new java.util.ArrayList<MetriqueN3>();
double tauxLivraisonComplete = main.verifierFillRate(); // NaN tant qu'aucune commande cliente n'est close
int nbCommandesClosesRL = main.nombreCommandesClosesFiabilite();
// En dessous du seuil, les metriques notees (qui partagent la meme source)
// sont affichees mais ne contribuent pas au PI : absence de donnee (ou
// echantillon trop petit) != performance nulle. Avec seuilMinEchantillonRL=1
// (valeur du donneur, non modifiee ici), cette garde protege uniquement le
// cas n=0 -- elle ne constitue PAS une garantie de robustesse statistique
// sur petits echantillons (n=1 n'est pas "statistiquement suffisant").
boolean commandesClosesPresentes = nbCommandesClosesRL >= seuilMinEchantillonRL;
double fillRate = tauxLivraisonComplete;
double exactitudeArticle = tauxLivraisonComplete;
double exactitudeQuantite = tauxLivraisonComplete;

// RL.3.33/RL.3.35 n'ont aucune source de donnee independante dans ce modele
// (pas de simulation d'erreur d'article ni de quantite) : ce sont des proxies
// qui recopiaient la meme valeur, donnant l'illusion de 4 mesures SCOR
// independantes alors qu'il n'y en a qu'une seule reelle. Poids 0
// (informatif, hors score), meme traitement que CO.3.13/CO.3.11/AM.3.18.
// RL.2.1 (% of Orders Delivered in Full) mesure la COMPLETUDE d'une
// livraison, pas sa ponctualite : ce modele ne livre jamais partiellement
// une commande close, donc la completude vaudrait 1.0 par construction --
// poids 0 egalement (affiche, hors score) plutot que de recopier
// silencieusement la ponctualite et de la compter deux fois dans RL.
// RL.2.2 (Delivery Performance to Customer Commit Date) porte donc seule
// l'attribut : c'est la seule mesure de fiabilite reellement observable ici.
int nRL = 1;
double poidsRL = 1.0 / nRL;
rl.add(new MetriqueN3("Commandes livrées complètes (informatif, hors score)", "RL.2.1", commandesClosesPresentes ? "ratio 0-1" : "ratio 0-1 (aucune commande close)", tauxLivraisonComplete, commandesClosesPresentes ? main.normaliserValeurMetriqueSCOR("RL.2.1", tauxLivraisonComplete) : 0.0, 0.0));
rl.add(new MetriqueN3("Commandes livrées à temps", "RL.2.2", commandesClosesPresentes ? "ratio 0-1" : "ratio 0-1 (aucune commande close)", fillRate, commandesClosesPresentes ? main.normaliserValeurMetriqueSCOR("RL.2.2", fillRate) : 0.0, commandesClosesPresentes ? poidsEffectifN3("Commandes livrées à temps", poidsRL) : 0.0));
rl.add(new MetriqueN3("Exactitude des articles livrés (informatif, hors score)", "RL.3.33", commandesClosesPresentes ? "ratio 0-1" : "ratio 0-1 (aucune commande close)", exactitudeArticle, commandesClosesPresentes ? main.normaliserValeurMetriqueSCOR("RL.3.33", exactitudeArticle) : 0.0, 0.0));
rl.add(new MetriqueN3("Exactitude des quantités livrées (informatif, hors score)", "RL.3.35", commandesClosesPresentes ? "ratio 0-1" : "ratio 0-1 (aucune commande close)", exactitudeQuantite, commandesClosesPresentes ? main.normaliserValeurMetriqueSCOR("RL.3.35", exactitudeQuantite) : 0.0, 0.0));
scoreRL = agregerN3(rl);
// Affichage honnete du score RL sous le seuil d'echantillon : les metriques
// notees ayant alors un poids 0, agregerN3() les ignore et scoreRL
// retombait a 0 -- un "0/10" qui se lit comme une performance nulle alors
// qu'il signifie seulement "pas encore assez de commandes closes". Le PI
// lui-meme n'est PAS fausse (wEffRL=0 : RL est exclu de l'agregation tant
// que sommePoidsRL vaut 0, voir plus bas) -- on ne corrige donc que la
// valeur affichee.
if (!commandesClosesPresentes && nbCommandesClosesRL > 0 && !Double.isNaN(tauxLivraisonComplete)) {
    java.util.ArrayList<MetriqueN3> rlAffichage = new java.util.ArrayList<MetriqueN3>();
    rlAffichage.add(new MetriqueN3("Commandes livrées à temps", "RL.2.2", "ratio 0-1 (provisoire, hors PI)", fillRate, main.normaliserValeurMetriqueSCOR("RL.2.2", fillRate), 1.0));
    scoreRL = agregerN3(rlAffichage);
}
detailN3.put("RL", rl);

// ============================================================
// RS — Responsiveness (temps de cycle par macro-processus SCOR, perimetre
// entreprise focale). avgCycleTime() renvoie la moyenne du temps de
// traitement PAR PASSAGE SUR UN POSTE, alors que SCOR RS.2.x designe le
// temps de cycle du MACRO-PROCESSUS, c'est-a-dire la duree qu'une unite met
// a le TRAVERSER (files d'attente internes comprises, pas seulement les
// temps operatoires). On calcule desormais le temps CUMULE (traitement +
// attente) du macro divise par le nombre d'unites qui y sont entrees.
// ============================================================
java.util.ArrayList<MetriqueN3> rs = new java.util.ArrayList<MetriqueN3>();
double ctS = 0, ctM = 0, ctD = 0, ctR = 0;
Long nUS = unitesParMacro.get("sS");
Long nUM = unitesParMacro.get("sM");
Long nUD = unitesParMacro.get("sD");
Long nUR = unitesParMacro.get("sR");
if (nUS != null && nUS.longValue() > 0) ctS = (sS.sumCycleTime + sS.sumWaitTime) / (double) nUS.longValue();
if (nUM != null && nUM.longValue() > 0) ctM = (sM.sumCycleTime + sM.sumWaitTime) / (double) nUM.longValue();
if (nUD != null && nUD.longValue() > 0) ctD = (sD.sumCycleTime + sD.sumWaitTime) / (double) nUD.longValue();
if (nUR != null && nUR.longValue() > 0) ctR = (sR.sumCycleTime + sR.sumWaitTime) / (double) nUR.longValue();

// Borne = nominal pondere ramene a une unite, meme construction que la
// valeur observee ci-dessus (division par le nombre d'unites entrees dans
// le macro). Active la decroissance lente (Bloc B.1) UNIQUEMENT pour ces
// profils RS -- jamais globalement.
String[] macrosRS = {"sS", "sM", "sD", "sR"};
String[] codesRS  = {"RS.2.1", "RS.2.2", "RS.2.3", "RS.2.5"};
for (int iRS = 0; iRS < macrosRS.length; iRS++) {
    Long nU = unitesParMacro.get(macrosRS[iRS]);
    Double nomPond = nominalPondereParMacro.get(macrosRS[iRS]);
    if (nU != null && nU.longValue() > 0 && nomPond != null && nomPond.doubleValue() > 0) {
        main.majBorneCycleMacro(codesRS[iRS], nomPond.doubleValue() / (double) nU.longValue());
    }
}
// Sources uniques, identiques au Dashboard Global et a l'ABox.
double ltG = main.orderFulfillmentLeadTimeGlobal();
double wtG = main.tempsAttenteGlobalCoherent(); // NaN tant qu'aucune commande n'est comptabilisee
boolean commandeGlobaleClose = board.kpiGlobal != null && board.kpiGlobal.count > 0;

int nRS = 0;
if (commandeGlobaleClose) nRS += 2;
if (main.macroExecutee(sS)) nRS++;
if (main.macroExecutee(sM)) nRS++;
if (main.macroExecutee(sD)) nRS++;
if (main.macroExecutee(sR)) nRS++;
if (nRS == 0) nRS = 1; // garde-fou division par zero : aucune metrique RS n'a de donnee
double poidsRS = 1.0 / nRS;
if (main.macroExecutee(sS)) rs.add(new MetriqueN3("Source Cycle Time — Temps de cycle Source", "RS.2.1", "s", ctS, main.normaliserValeurMetriqueSCOR("RS.2.1", ctS), poidsEffectifN3("Source Cycle Time — Temps de cycle Source", poidsRS)));
if (main.macroExecutee(sM)) rs.add(new MetriqueN3("Make Cycle Time — Temps de cycle Make", "RS.2.2", "s", ctM, main.normaliserValeurMetriqueSCOR("RS.2.2", ctM), poidsEffectifN3("Make Cycle Time — Temps de cycle Make", poidsRS)));
if (main.macroExecutee(sD)) rs.add(new MetriqueN3("Deliver Cycle Time — Temps de cycle Deliver", "RS.2.3", "s", ctD, main.normaliserValeurMetriqueSCOR("RS.2.3", ctD), poidsEffectifN3("Deliver Cycle Time — Temps de cycle Deliver", poidsRS)));
if (main.macroExecutee(sR)) rs.add(new MetriqueN3("Return Cycle Time — Temps de cycle Return", "RS.2.5", "s", ctR, main.normaliserValeurMetriqueSCOR("RS.2.5", ctR), poidsEffectifN3("Return Cycle Time — Temps de cycle Return", poidsRS)));
rs.add(new MetriqueN3("Order Fulfillment Cycle Time — Lead Time global de commande", "RS.1.1", commandeGlobaleClose ? "s" : "s (aucune commande close)", ltG, commandeGlobaleClose ? main.normaliserValeurMetriqueSCOR("RS.1.1", ltG) : 0.0, commandeGlobaleClose ? poidsEffectifN3("Order Fulfillment Cycle Time — Lead Time global de commande", poidsRS) : 0.0));
rs.add(new MetriqueN3("Order Fulfillment Dwell Time — Temps d’attente global", "RS.3.94", commandeGlobaleClose ? "s" : "s (aucune commande close)", wtG, commandeGlobaleClose ? main.normaliserValeurMetriqueSCOR("RS.3.94", wtG) : 0.0, commandeGlobaleClose ? poidsEffectifN3("Order Fulfillment Dwell Time — Temps d’attente global", poidsRS) : 0.0));
scoreRS = agregerN3(rs);
detailN3.put("RS", rs);

// ============================================================
// AG — Agility : seules les metriques reellement mesurables sont
// retenues. AG.3.32 est la seule grandeur SCOR normative reelle ; les 2
// autres sont des PROXIES explicitement nommes (PROXY.AG.*), jamais
// presentes comme des metriques SCOR normatives (Bloc B.2, point 6/7 de
// la consigne).
// ============================================================
java.util.ArrayList<MetriqueN3> ag = new java.util.ArrayList<MetriqueN3>();
double tauxOccupation = wip / capaciteTotale; // indicateur estimé de saturation, borne par la capacite reelle declaree
double adaptabilite = main.strategic != null ? main.strategic.coefficientAdaptabilite() : 0.5;

int nAG = 3;
double poidsAG = 1.0 / nAG;
ag.add(new MetriqueN3("Current Delivery Volume / Throughput — Volume livré et débit de sortie", "AG.3.32", "ent/h", debit, main.normaliserValeurMetriqueSCOR("AG.3.32", debit), poidsEffectifN3("Current Delivery Volume / Throughput — Volume livré et débit de sortie", poidsAG)));
ag.add(new MetriqueN3("System Utilization — Taux d’occupation du système (estimation WIP/capacité)", "PROXY.AG.SYSTEM_UTILIZATION", "ratio 0-1", tauxOccupation, main.normaliserValeurMetriqueSCOR("PROXY.AG.SYSTEM_UTILIZATION", tauxOccupation), poidsEffectifN3("System Utilization — Taux d’occupation du système (estimation WIP/capacité)", poidsAG)));
ag.add(new MetriqueN3("Stabilite du debit observe (proxy, hors referentiel SCOR)", "PROXY.AG.STABILITE_DEBIT", "ratio 0-1", adaptabilite, main.normaliserValeurMetriqueSCOR("PROXY.AG.STABILITE_DEBIT", adaptabilite), poidsEffectifN3("Stabilite du debit observe (proxy, hors referentiel SCOR)", poidsAG)));
scoreAG = agregerN3(ag);
detailN3.put("AG", ag);

// ============================================================
// CO — Cost : le seul score de performance defendable ici est le
// ratio cout total / chiffre d'affaire genere (TSCMC ratio) -- a
// condition que l'utilisateur ait renseigne un CA par unite.
// Bloc B.2 -- l'assiette de CA utilise desormais unitesLivreesClients()
// (Bloc B.1) au lieu de main.nbTermines : un compteur HYBRIDE (incremente
// par unite sur le flux de production, mais une seule fois par commande sur
// le chemin de livraison directe MTS -- le mode nominal de ce master), qui
// sous-estimait le CA d'un facteur proche de la taille moyenne de commande.
// REAPPRO_* deja exclus par unitesLivreesClients().
// ============================================================
java.util.ArrayList<MetriqueN3> co = new java.util.ArrayList<MetriqueN3>();
double[] couts = main.calculerCoutsCumules(); // [0]=coutMainOeuvre, [1]=coutMatiere, [2]=coutTotalDeclare
double coutMainOeuvre = couts[0];
double coutMatiere = couts[1];
double coutTotal = couts[2];

int unitesFacturables = main.unitesLivreesClients();
boolean donneesFinancieresPresentes = (main.chiffreAffaireParUnite > 0 && unitesFacturables > 0);
double ratioCoutCA = Double.NaN;
if (donneesFinancieresPresentes) {
    double ca = main.chiffreAffaireParUnite * unitesFacturables;
    ratioCoutCA = (ca > 0) ? Math.min(1.0, coutTotal / ca) : Double.NaN;
}

// Sans chiffre d'affaire, la métrique est affichée mais ne contribue pas au PI :
// absence de donnée != performance moyenne arbitraire.
double poidsCO = donneesFinancieresPresentes ? 1.0 : 0.0;
co.add(new MetriqueN3("Cout total / Chiffre d'affaire estime (TSCMC ratio)", "CO.1.1", donneesFinancieresPresentes ? "ratio cout/CA" : "ratio cout/CA (CA non renseigne)", ratioCoutCA, donneesFinancieresPresentes ? main.normaliserValeurMetriqueSCOR("CO.1.1", ratioCoutCA) : 0.0, poidsCO));
co.add(new MetriqueN3("Cout main d'oeuvre cumule (informatif, hors score)", "CO.3.13", donneesFinancieresPresentes || coutMainOeuvre > 0 ? "FCFA" : "EUR (non renseigne)", coutMainOeuvre, 0.0, 0.0));
co.add(new MetriqueN3("Cout matiere cumule (informatif, hors score)", "CO.3.11", donneesFinancieresPresentes || coutMatiere > 0 ? "FCFA" : "FCFA (non renseigne)", coutMatiere, 0.0, 0.0));
scoreCO = agregerN3(co);
detailN3.put("CO", co);

// ============================================================
// AM — Asset Management : actifs fixes declares + disponibilite machine
// (proxy, hors referentiel SCOR normatif -- meme grandeur qu'auparavant
// sous AM.3.9, renommee pour ne plus la presenter comme une metrique SCOR
// reelle) + jours de stock reel (AM.2.2, metrique SCOR reelle).
// ============================================================
java.util.ArrayList<MetriqueN3> am = new java.util.ArrayList<MetriqueN3>();
double valeurActifsTotale = main.calculerValeurActifsFixes();
double disponibiliteMachinesMoy = main.calculerDisponibiliteMachinesMoyenne();
double joursStock = main.calculerInventoryDaysOfSupply();
// calculerInventoryDaysOfSupply() renvoie 0 tant qu'aucun debit n'a ete
// observe (pas une vraie mesure de "0 jour de stock") : meme principe que
// CO.1.1, on exclut cette metrique du calcul plutot que de compter une
// fausse rupture de stock.
boolean debitObserve = main.nbTermines > 0;

int nAM = 2; // seules 2 metriques contribuent reellement au score pondere
double poidsAM = 1.0 / nAM;
am.add(new MetriqueN3("Disponibilite machine (proxy, hors referentiel SCOR)", "PROXY.AM.DISPONIBILITE_MACHINE", "ratio 0-1", disponibiliteMachinesMoy, main.normaliserValeurMetriqueSCOR("PROXY.AM.DISPONIBILITE_MACHINE", disponibiliteMachinesMoy), poidsEffectifN3("Disponibilite machine (proxy, hors referentiel SCOR)", poidsAM)));
am.add(new MetriqueN3("Inventory Days of Supply (stock reel observe)", "AM.2.2", debitObserve ? "jours" : "jours (aucun debit observe)", joursStock, debitObserve ? main.normaliserValeurMetriqueSCOR("AM.2.2", joursStock) : 0.0, debitObserve ? poidsEffectifN3("Inventory Days of Supply (stock reel observe)", poidsAM) : 0.0));
am.add(new MetriqueN3("Valeur des actifs fixes declares (informatif, hors score)", "AM.3.18", valeurActifsTotale > 0 ? "EUR" : "EUR (non renseigne)", valeurActifsTotale, 0.0, 0.0));
scoreAM = agregerN3(am);
detailN3.put("AM", am);

// Garde-fou final : les scores non finis sont neutralisés avant agrégation et affichage.
if (Double.isNaN(scoreRL) || Double.isInfinite(scoreRL)) scoreRL = 0.0;
if (Double.isNaN(scoreRS) || Double.isInfinite(scoreRS)) scoreRS = 0.0;
if (Double.isNaN(scoreAG) || Double.isInfinite(scoreAG)) scoreAG = 0.0;
if (Double.isNaN(scoreCO) || Double.isInfinite(scoreCO)) scoreCO = 0.0;
if (Double.isNaN(scoreAM) || Double.isInfinite(scoreAM)) scoreAM = 0.0;
// C13 — Theeranuphattana/Chan-Qi adapte : chaque attribut est d'abord un
// fuzzy grade set, puis les cinq attributs sont agreges avec les poids configures.
// Les poids sont des INPUTS normalises (expert/PMT) ; l'AHP classique n'est plus
// le moteur du PI. Le PI final est defuzzifie sur l'echelle [0..10].
FuzzyGradeSet gRL=FuzzyGradeSet.agregerMetriques(rl);
FuzzyGradeSet gRS=FuzzyGradeSet.agregerMetriques(rs);
FuzzyGradeSet gAG=FuzzyGradeSet.agregerMetriques(ag);
FuzzyGradeSet gCO=FuzzyGradeSet.agregerMetriques(co);
FuzzyGradeSet gAM=FuzzyGradeSet.agregerMetriques(am);

// Bloc B.2 -- POIDS EFFECTIFS. Une famille dont AUCUNE metrique n'a de
// donnee (toutes a poids 0, ex. RS avant toute commande terminee, ou CO
// sans chiffre d'affaire renseigne) produit un FuzzyGradeSet entierement a
// zero. Sans ce garde-fou, agregerGrades() traiterait ce "pas de donnee"
// comme une performance nulle (grade F=pire note) et l'incorporerait quand
// meme dans la moyenne ponderee -- l'absence de donnees n'est jamais un
// score de zero.
double sommePoidsRL=0, sommePoidsRS=0, sommePoidsAG=0, sommePoidsCO=0, sommePoidsAM=0;
for (MetriqueN3 m : rl) sommePoidsRL += Math.max(0.0, m.poids);
for (MetriqueN3 m : rs) sommePoidsRS += Math.max(0.0, m.poids);
for (MetriqueN3 m : ag) sommePoidsAG += Math.max(0.0, m.poids);
for (MetriqueN3 m : co) sommePoidsCO += Math.max(0.0, m.poids);
for (MetriqueN3 m : am) sommePoidsAM += Math.max(0.0, m.poids);
double wEffRL = sommePoidsRL > 0 ? w_RL : 0.0;
double wEffRS = sommePoidsRS > 0 ? w_RS : 0.0;
double wEffAG = sommePoidsAG > 0 ? w_AG : 0.0;
double wEffCO = sommePoidsCO > 0 ? w_CO : 0.0;
double wEffAM = sommePoidsAM > 0 ? w_AM : 0.0;
FuzzyGradeSet gPI=FuzzyGradeSet.agregerGrades(new FuzzyGradeSet[]{gRL,gRS,gAG,gCO,gAM},new double[]{wEffRL,wEffRS,wEffAG,wEffCO,wEffAM});
double pi=gPI.defuzzifier();

// Tracabilite du perimetre du PI. Un attribut peut etre AFFICHE avec un
// score reel tout en etant EXCLU de l'agregation (poids effectif 0, faute
// d'echantillon suffisant) : le PI est alors renormalise sur les seuls
// attributs restants. Sans cette information, le PI n'est pas recalculable
// a la main a partir des 5 scores affiches.
StringBuilder perimetre = new StringBuilder();
if (wEffRL > 0) perimetre.append(perimetre.length() > 0 ? "+" : "").append("RL");
if (wEffRS > 0) perimetre.append(perimetre.length() > 0 ? "+" : "").append("RS");
if (wEffAG > 0) perimetre.append(perimetre.length() > 0 ? "+" : "").append("AG");
if (wEffCO > 0) perimetre.append(perimetre.length() > 0 ? "+" : "").append("CO");
if (wEffAM > 0) perimetre.append(perimetre.length() > 0 ? "+" : "").append("AM");
attributsPonderesPI = perimetre.length() > 0 ? perimetre.toString() : "aucun (PI non calcule)";
sommePoidsEffectifsPI = wEffRL + wEffRS + wEffAG + wEffCO + wEffAM;

// Bloc B.1/B.2 -- WARM-UP. Tant que les 5 attributs ne sont pas TOUS
// ponderes, le PI ne porterait que sur un sous-ensemble renormalise : deux
// PI calcules sur des perimetres differents ne sont pas comparables. On
// maintient donc le PI a sa valeur d'initialisation (ciblePIGlobal) tant
// que le perimetre est incomplet, et on ne le laisse varier qu'a partir du
// moment ou les 5 attributs sont mesures -- une fois atteint, on ne revient
// plus artificiellement en amorcage sur une simple absence ponctuelle
// ulterieure (perimetrePIDejaComplet reste vrai a vie pour ce run).
boolean perimetreComplet = (wEffRL > 0 && wEffRS > 0 && wEffAG > 0 && wEffCO > 0 && wEffAM > 0);
if (perimetreComplet) perimetrePIDejaComplet = true;
// Garde-fou : si CO ne peut structurellement JAMAIS entrer (aucun chiffre
// d'affaire configure dans le scenario), attendre le perimetre complet
// gelerait le PI a la cible pendant tout le run. Dans ce cas on ne gele pas
// et le PI reste renormalise sur les attributs reellement disponibles.
boolean attenteImpossible = (wEffCO <= 0 && !(main.chiffreAffaireParUnite > 0));
boolean phaseAmorcagePI = !perimetrePIDejaComplet && !perimetreComplet && !attenteImpossible;
if (phaseAmorcagePI) {
    pi = ciblePIGlobal;
    attributsPonderesPI = "AMORCAGE (PI maintenu a la cible) | mesures: "
        + (perimetre.length() > 0 ? perimetre.toString() : "aucun");
}

// Log de transition (une seule fois, pas a chaque cycle) : signale quand
// une famille de metriques SCOR bascule de "pas encore de donnee" a
// "incluse dans le PI".
if (commandesClosesPresentes && !donneesRLPresentesPrecedent) {
    board.logEvent("[SCOR] RL passe en donnees reelles (premiere commande close) : score=" + String.format("%.2f", scoreRL));
}
donneesRLPresentesPrecedent = commandesClosesPresentes;
if (commandeGlobaleClose && !donneesRSPresentesPrecedent) {
    board.logEvent("[SCOR] RS passe en donnees reelles (premiere commande terminee) : score=" + String.format("%.2f", scoreRS));
}
donneesRSPresentesPrecedent = commandeGlobaleClose;
if (debitObserve && !donneesAMPresentesPrecedent) {
    board.logEvent("[SCOR] AM passe en donnees reelles (premier debit observe) : score=" + String.format("%.2f", scoreAM));
}
donneesAMPresentesPrecedent = debitObserve;

// Decomposition RL/RS/AG/CO/AM a chaque calcul, limitee a une fois toutes
// les 5s pour rester lisible sur un run complet (calculerPIGlobal() est
// sinon appelee a chaque unite terminee) -- throttling via
// dernierLogDetailSCOR (Bloc B.1), pas de nouveau flag verboseLogs.
if (board != null && (time() - dernierLogDetailSCOR >= 5.0)) {
    dernierLogDetailSCOR = time();
    board.logEvent(String.format(java.util.Locale.US,
        "[SCOR-DETAIL] RL=%.2f RS=%.2f AG=%.2f CO=%.2f AM=%.2f -> PI=%.3f | wEff=%.2f | perimetre=%s | phase=%s",
        scoreRL, scoreRS, scoreAG, scoreCO, scoreAM, pi, sommePoidsEffectifsPI,
        attributsPonderesPI, phaseAmorcagePI ? "AMORCAGE" : "ACTIVE"));
}

return (Double.isNaN(pi)||Double.isInfinite(pi))?0.0:Math.max(0.0,Math.min(10.0,pi));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000730</Id>
					<Name><![CDATA[detecterGoulot]]></Name>
					<X>190</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[BlackboardAgent board = ((Main) getOwner()).board;
String goulotId = null; double maxWT = 0;
for (PosteGenericAgent p : ((Main) getOwner()).postes) {
    KPIBundle k = board.kpiParPoste.get(((Main) getOwner()).cleKPI(p));
    if (k != null && k.avgWaitTime() > maxWT) { maxWT = k.avgWaitTime(); goulotId = p.idPoste; }
}
if (goulotId != null && maxWT > seuilWTGoulot) {
    dernierGoulot = goulotId;
    // C14.15 -- log [STRATEGIC] desactive : redondant avec l'etat GOULOT du
    // poste, et repete a chaque evaluation.
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000731</Id>
					<Name><![CDATA[piloterSource]]></Name>
					<X>190</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[BlackboardAgent board = ((Main) getOwner()).board;
KPIBundle sS = board.kpiParMacro.get("sS");
if (sS == null) return;
double ltSource = sS.avgLeadTime();
if (ltSource > seuilLTSource) {
    board.logEvent("[STRATEGIC] Source lente (LT=" + String.format("%.1f", ltSource) + "s) -> signal reappro");
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791000006101</Id>
					<Name><![CDATA[deciderTypeCommande]]></Name>
					<X>190</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[cmd]]></Name>
						<Type><![CDATA[CommandeAgent]]></Type>
					</Parameter>
					<Body><![CDATA[// DECISION STRATEGIQUE : servir cette commande depuis le stock (MTS) ou
// lancer une production dediee (MTO) ?
//
// Le flux physique tourne en permanence sur prevision et alimente le stock de
// produits finis. Une commande client (flux d'information) vient CONSOMMER ce
// stock. Si le stock disponible couvre la commande, on sert en MTS : c'est
// rapide (delai promis court) et cela valorise la production sur prevision.
// Sinon, le stock ne suffit pas : il faut produire specifiquement pour cette
// commande, c'est du MTO (delai promis plus long).
//
// Remplace l'ancien tirage aleatoire 70/30, qui ne correspondait a aucune
// decision d'agent et rendait le choix MTS/MTO arbitraire.
Main main = (Main) getOwner();
if (main == null || cmd == null) return "MTO";

ScenarioFlux sc = null;
for (ScenarioFlux s : main.scenarios) {
    if (s.typeProduit.equals(cmd.idScenario)) { sc = s; break; }
}
if (sc == null && !main.scenarios.isEmpty()) sc = main.scenarios.get(0);

PosteGenericAgent stockFini = (sc != null) ? main.trouverStockFiniPourScenario(sc) : null;
if (stockFini == null) {
    // Aucun poste de stockage declare dans la chaine : impossible de servir sur
    // stock, toute commande declenche donc une production dediee.
    if (main.board != null) {
        main.board.logEvent("[HOLON-STRAT] " + cmd.idCommande
            + " -> MTO (aucun poste STOCKAGE dans la chaine)");
    }
    return "MTO";
}

double dispo = stockFini.stockDisponible();
boolean servableSurStock = (dispo >= cmd.qte);

// --- REFUS PAR CAPACITE ---------------------------------------------------
// Si la commande ne peut PAS etre servie sur stock, elle devra etre produite.
// Le strategique verifie alors que le carnet du Coordinateur Make n'est pas
// deja structurellement sature : accepter une commande qu'on sait ne pas
// pouvoir honorer dans un delai raisonnable, c'est promettre dans le vide et
// degrader le taux de service. Un refus explicite est une DECISION -- et une
// information exploitable (nbCommandesRefusees = signal de sous-capacite).
if (!servableSurStock) {
    CoordinatorAgent coordMake = null;
    for (CoordinatorAgent sv : main.supervisorsMacro) {
        if ("CA-sM2".equals(sv.idAgentCoordinateur)) { coordMake = sv; break; }
    }
    if (coordMake != null && coordMake.carnetCommandesMTO.size() >= capaciteCarnetMax) {
        nbCommandesRefusees++;
        nbDecisionsCommandes++;
        cmd.statut = "REFUSEE";
        if (main.board != null) {
            main.board.logEvent(String.format(
                "[HOLON-STRAT] %s REFUSEE : carnet Make sature (%d/%d) et stock insuffisant (%.0f < %d). "
                + "Capacite structurellement depassee.",
                cmd.idCommande, coordMake.carnetCommandesMTO.size(), capaciteCarnetMax, dispo, cmd.qte));
        }
        return "REFUSEE";
    }
}

String type = servableSurStock ? "MTS" : "MTO";

if (main.board != null) {
    main.board.logEvent(String.format(
        "[HOLON-STRAT] %s qte=%d | stock %s : physique=%.0f, reserve=%.0f, disponible=%.0f -> decision %s (%s)",
        cmd.idCommande, cmd.qte, stockFini.nom,
        stockFini.niveauStock, stockFini.stockReserve, dispo, type,
        servableSurStock ? "servie depuis le stock" : "stock insuffisant, production dediee"));
}
nbDecisionsCommandes++;
if (servableSurStock) nbCommandesMTS++; else nbCommandesMTO++;
return type;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781625605126</Id>
					<Name><![CDATA[prevoirDemande]]></Name>
					<X>190</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();

// Bloc B.2 -- Debit de reference = demande CLIENT reelle (quantite des
// commandes clientes creees, hors REAPPRO_), pas la production totale.
// Utiliser main.nbTermines ici creait une boucle de retroaction positive
// sans rapport avec la demande reelle : plus la production autonome MTS
// tourne (Bloc M.3), plus nbTermines grimpe, plus previsionDemande grimpe,
// plus le stock cible grimpe (ajusterDebits() ci-dessous), plus on produit
// -- independamment du rythme reel des commandes clients (qui peut au
// contraire ralentir pendant que ce cycle s'auto-alimente). Confirme
// reproductible dans ce master par audit B.1 (MERGE_PROGRESS.md).
double qteClientCreeeTotale = 0;
double tPremiereCommandeClient = Double.NaN;
int nbCommandesClientCreees = 0;
java.util.Map<String, Double> qteClientCreeeParProduit = new java.util.HashMap<String, Double>();
java.util.Map<String, Double> tPremiereCommandeParProduit = new java.util.HashMap<String, Double>();
java.util.Map<String, Integer> nbCommandesParProduit = new java.util.HashMap<String, Integer>();
for (CommandeAgent cmd : main.commandes) {
    if (cmd == null || cmd.idCommande == null) continue;
    if (cmd.idCommande.startsWith("REAPPRO_")) continue;
    qteClientCreeeTotale += cmd.qte;
    nbCommandesClientCreees++;
    if (Double.isNaN(tPremiereCommandeClient) || cmd.tCreation < tPremiereCommandeClient) {
        tPremiereCommandeClient = cmd.tCreation;
    }
    if (cmd.idScenario != null) {
        Double cumul = qteClientCreeeParProduit.get(cmd.idScenario);
        qteClientCreeeParProduit.put(cmd.idScenario, (cumul == null ? 0.0 : cumul) + cmd.qte);
        Integer n = nbCommandesParProduit.get(cmd.idScenario);
        nbCommandesParProduit.put(cmd.idScenario, (n == null ? 0 : n) + 1);
        Double tPrem = tPremiereCommandeParProduit.get(cmd.idScenario);
        if (tPrem == null || cmd.tCreation < tPrem) tPremiereCommandeParProduit.put(cmd.idScenario, cmd.tCreation);
    }
}

// Les commandes clientes arrivent en rafales espacees, pas en flux continu :
// une simple moyenne "quantite cumulee / temps ecoule depuis T=0" est
// extremement instable tant que peu de commandes existent. On exige donc au
// moins 2 commandes clientes (pour disposer d'un vrai intervalle observe) et
// on mesure le debit depuis la 1ere commande, pas depuis T=0. Sous ce seuil,
// previsionDemande reste a 0, ce qui declenche deja le repli existant sur
// debitParHeureBase dans ajusterDebits().
double debitActuel = 0;
if (nbCommandesClientCreees >= 2 && !Double.isNaN(tPremiereCommandeClient)) {
    double dureeEcoulee = Math.max(60.0, time() - tPremiereCommandeClient);
    debitActuel = qteClientCreeeTotale * 3600.0 / dureeEcoulee;
}

historiqueDebit.add(debitActuel);
if (historiqueDebit.size() > 10) historiqueDebit.remove(0);

double alpha = 0.3;
if (previsionDemande == 0) {
    previsionDemande = debitActuel;
} else {
    previsionDemande = alpha * debitActuel + (1 - alpha) * previsionDemande;
}

// Meme lissage et meme garde-fou d'echantillon minimal, applique separement
// a chaque produit (scenario), pour alimenter le calcul du besoin net en
// matieres (Main.calculerBesoinsNets) -- base desormais sur la quantite de
// commandes clientes creees PAR PRODUIT (filtrees par cmd.idScenario exact),
// jamais sur les unites produites (main.nbTerminesParProduit) ni sur un stock
// agrege : chaque produit ne voit que sa propre demande cliente.
for (ScenarioFlux sc : main.scenarios) {
    Integer nProduit = nbCommandesParProduit.get(sc.typeProduit);
    Double tPremProduit = tPremiereCommandeParProduit.get(sc.typeProduit);
    double debitProduit = 0;
    if (nProduit != null && nProduit >= 2 && tPremProduit != null) {
        Double qte = qteClientCreeeParProduit.get(sc.typeProduit);
        double dureeEcouleeProduit = Math.max(60.0, time() - tPremProduit);
        debitProduit = (qte != null) ? qte * 3600.0 / dureeEcouleeProduit : 0;
    }
    Double prev = previsionParProduit.get(sc.typeProduit);
    double nouvellePrev = (prev == null || prev == 0) ? debitProduit : (alpha * debitProduit + (1 - alpha) * prev);
    previsionParProduit.put(sc.typeProduit, nouvellePrev);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781625629534</Id>
					<Name><![CDATA[ajusterDebits]]></Name>
					<X>200</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();
BlackboardAgent board = main.board;
CoordinatorAgent sup = main.supervisor;

double pi = piGlobalCourant;

// C13.1 — Le PI ne devient décisionnel qu'après au moins une commande terminée.
// Avant cela, PI=0 signifie "pas encore de données", pas "mauvaise performance".
boolean performanceDisponible = main.nbTermines > 0;

// Detection d'un goulot persistant sur MAKE (sM) via l'historique du Supervisor
boolean goulotMakePersistant = false;
for (java.util.Map.Entry<String, Integer> e : sup.historiqueGoulots.entrySet()) {
    PosteGenericAgent p = main.trouverPoste(e.getKey());
    if (p != null && main.macroPrefixe(p.codeSCOR).equals("sM") && e.getValue() >= 2) {
        goulotMakePersistant = true;
        break;
    }
}

double ancienFacteur = facteurAjustement;
String decision;

if (!performanceDisponible) {
    // Phase d'amorçage : aucune performance complète n'est encore disponible.
    // On conserve le facteur courant au lieu d'interpréter PI=0 comme un échec.
    decision = "AMORCAGE";
} else if (pi < seuilPI_bas || goulotMakePersistant) {
    facteurAjustement = Math.max(0.5, facteurAjustement * 0.90);
    decision = "RALENTIR";
} else if (pi > seuilPI_haut && !goulotMakePersistant) {
    facteurAjustement = Math.min(1.5, facteurAjustement * 1.05);
    decision = "ACCELERER";
} else {
    decision = "MAINTENIR";
}

// ============================================================
// PILOTAGE DE LA PRODUCTION SUR PREVISION (Make-To-Stock)
//
// Le flux physique (matiere -> produits) doit tourner MEME SANS COMMANDE :
// c'est de la production sur prevision, destinee a remplir le stock de
// produits finis. La commande client, elle, est un flux d'INFORMATION qui
// vient CONSOMMER ce stock (MTS) ou declencher une production dediee (MTO).
//
// Le debit de production n'est donc plus une constante corrigee apres coup
// par la performance : c'est une DECISION du strategique, fondee sur
//   1. la prevision de demande (lissage exponentiel, previsionParProduit) ;
//   2. l'ecart entre le stock de produits finis observe et le stock cible ;
//   3. un bridage par le facteur de performance (frein de securite si la
//      chaine sature ou si un goulot Make persiste).
//
//   debit_MTS = prevision + (stock_cible - stock_observe) / horizon_rattrapage
//   puis borne a [0, +inf[ et multiplie par facteurAjustement.
//
// stock_cible = prevision x couvertureStockCibleHeures (24h = 1 jour de
// couverture de la demande prevue).
// ============================================================
double totalStockObserve = 0;
double totalStockCible   = 0;
double totalDebitMTS     = 0;

for (ScenarioFlux sc : main.scenarios) {
    // Prevision propre a ce produit (entites/heure), repli sur la prevision globale
    Double pvProduit = previsionParProduit.get(sc.typeProduit);
    double prevision = (pvProduit != null && pvProduit > 0) ? pvProduit : previsionDemande;

    // Bloc B.2 -- Stock de produits finis reellement observe POUR CE PRODUIT.
    // stockFini.niveauStock est l'AGREGAT de compatibilite du Bloc M
    // (synchroniserStockFiniAgrege()) : en mode multi-produit, le relire ici
    // dans cette boucle par-scenario le sommerait N fois dans
    // totalStockObserve des que 2+ produits partagent le meme poste
    // physique -- confirme par audit B.1 (MERGE_PROGRESS.md), exactement le
    // cas de la fixture scenario_M2_multiproduit_AB.json (PRODUIT_A/PRODUIT_B
    // partagent sM1.5.1). stockFiniDisponiblePourScenario() est deja la
    // source de verite du Bloc M (figee) : mono -> stockFini.niveauStock
    // (comportement historique inchange) ; multi -> stockFiniParProduit[sc].
    // Ne recalcule ni ne modifie stockFiniParProduit.
    PosteGenericAgent stockFini = main.trouverStockFiniPourScenario(sc);
    double stockObserve = main.stockFiniDisponiblePourScenario(sc, stockFini);

    // Stock cible = couverture (en heures) de la demande prevue
    double stockCible = prevision * couvertureStockCibleHeures;

    // Debit de production sur prevision :
    //   - couvrir la demande prevue,
    //   - + rattraper (ou resorber) l'ecart au stock cible sur l'horizon defini.
    // Un stock EXCEDENTAIRE donne un terme negatif : la production ralentit
    // d'elle-meme, voire s'arrete, au lieu de continuer a produire pour rien.
    double rattrapage = (stockCible - stockObserve) / Math.max(0.5, horizonRattrapageHeures);
    double debitSouhaite = prevision + rattrapage;

    // Bridage par la performance : le facteur reste un FREIN de securite
    // (goulot persistant, PI degrade), il ne pilote plus la production a lui seul.
    double debitFinal = Math.max(0.0, debitSouhaite * facteurAjustement);

    // Au demarrage, tant qu'aucune demande n'a encore ete observee, on retombe
    // sur le debit de reference du scenario pour amorcer le flux physique.
    if (prevision <= 0 && stockObserve <= 0) {
        debitFinal = sc.debitParHeureBase * facteurAjustement;
    }

    // Bloc B.2 -- Plafond de securite physique : quelle que soit l'erreur de
    // prevision ou l'ecart de stock, le debit decide ne doit jamais depasser
    // un multiple raisonnable de la capacite nominale du scenario
    // (debitParHeureBase). Sans ce plafond, une prevision encore bruitee (peu
    // d'echantillons) amplifiee par couvertureStockCibleHeures/
    // horizonRattrapageHeures peut produire un debit decide de plusieurs
    // ordres de grandeur au-dessus de toute capacite reelle.
    double plafond = sc.debitParHeureBase * plafondMultipleDebitBase;
    if (plafond > 0) debitFinal = Math.min(debitFinal, plafond);

    sc.debitParHeure = debitFinal;

    totalStockObserve += stockObserve;
    totalStockCible   += stockCible;
    totalDebitMTS     += debitFinal;
}

stockFiniObserve  = totalStockObserve;
stockCibleCalcule = totalStockCible;
debitMTSDecide    = totalDebitMTS;

nbAjustements++;
dernierAjustement = time();

AERMessage msg = new AERMessage(
    AERMessage.AMENDMENT,
    "STRATEGIC",
    "COORDINATOR",
    "PLANIF",
    "Decision=" + decision
    + ";PI=" + String.format("%.3f", pi)
    + ";facteur=" + String.format("%.3f", facteurAjustement)
    + ";prevision=" + String.format("%.1f", previsionDemande)
    + ";stock=" + String.format("%.0f", stockFiniObserve)
    + ";cible=" + String.format("%.0f", stockCibleCalcule)
    + ";debitMTS=" + String.format("%.1f", debitMTSDecide),
    time()
);
board.journaliserAER(
    "STRATEGIQUE_PLANIFICATION",
    msg,
    "Décision stratégique de planification MTS calculée depuis le PI et l'état des stocks"
);
board.logEvent("[HOLON-STRAT] " + msg.toString());
board.logEvent(String.format(
    "[HOLON-STRAT] %s | PI=%.3f | facteur %.3f -> %.3f | prevision=%.1f ent/h | stock=%.0f/%.0f | debit MTS=%.1f ent/h | goulotMake=%s",
    decision, pi, ancienFacteur, facteurAjustement, previsionDemande,
    stockFiniObserve, stockCibleCalcule, debitMTSDecide, goulotMakePersistant));

journalDecisions.add(String.format("[T=%.0f] %s (PI=%.2f, stock=%.0f/%.0f, MTS=%.1f/h)",
    time(), decision, pi, stockFiniObserve, stockCibleCalcule, debitMTSDecide));
if (journalDecisions.size() > 10) journalDecisions.remove(0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000306</Id>
					<Name><![CDATA[coefficientAdaptabilite]]></Name>
					<X>200</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Mesure honnete de l'agilite (AG.1.1 estimation) : stabilite reelle du debit de sortie,
// calculee a partir des derniers debits observes (historiqueDebit, alimente par
// prevoirDemande() toutes les 60s pendant l'execution). Coefficient de variation
// faible = systeme stable = score proche de 1. Si l'historique est trop court
// pour etre significatif (moins de 3 points), on retourne un score neutre 0.5
// plutot que de calculer une variance non representative.
if (historiqueDebit == null || historiqueDebit.size() < 3) return 0.5;

double somme = 0;
for (double v : historiqueDebit) somme += v;
double moyenne = somme / historiqueDebit.size();

if (moyenne <= 0) return 0.5; // pas de production : la mesure de stabilite n'a pas de sens

double sommeCarresEcarts = 0;
for (double v : historiqueDebit) sommeCarresEcarts += (v - moyenne) * (v - moyenne);
double ecartType = Math.sqrt(sommeCarresEcarts / historiqueDebit.size());

double coeffVariation = ecartType / moyenne; // 0 = parfaitement stable, augmente avec la volatilite
return Math.max(0.0, 1.0 - Math.min(1.0, coeffVariation));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781625648638</Id>
					<Name><![CDATA[getRapportStrategique]]></Name>
					<X>210</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();
StringBuilder sb = new StringBuilder();
sb.append("=== STRATEGIC AGENT (N4) - Planification ===\n");
sb.append(String.format("Prevision demande : %.1f entites/h\n", previsionDemande));
sb.append(String.format("Facteur ajustement: %.2f (debit applique = base x facteur)\n", facteurAjustement));
sb.append(String.format("Nb ajustements    : %d | Dernier : T=%.0fs\n", nbAjustements, dernierAjustement));
sb.append("\nDebits scenarios actuels :\n");
for (ScenarioFlux sc : main.scenarios) {
    sb.append(String.format("  %-12s base=%.1f/h -> actuel=%.1f/h\n",
        sc.typeProduit, sc.debitParHeureBase, sc.debitParHeure));
}
sb.append("\nHistorique decisions (10 dernieres) :\n");
if (journalDecisions.isEmpty()) {
    sb.append("  (aucune decision encore)\n");
} else {
    for (String d : journalDecisions) sb.append("  " + d + "\n");
}
return sb.toString();]]></Body>
				</Function>
