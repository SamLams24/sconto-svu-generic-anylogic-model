					<Body><![CDATA[int[] w = {24, 18, 14, 14, 14, 18, 12, 12};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "DASHBOARD — SYNTHESE GLOBALE DE LA SIMULATION",
        w
    ));

    sb.append(tableRow(new String[]{
        "Perimetre",
        "Nb entites finies",
        "Temps traitement moy. (s)",
        "Temps attente moy. (s)",
        "Délai total moy. (s)",
        "PCE estime (%)",
        "Rebuts",
        "Rework"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    KPIBundle g = board.kpiGlobal;

    sb.append(tableRow(new String[]{
