				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[PosteGenericAgent]]></ReturnType>
					<Id>1910000000000</Id>
					<Name><![CDATA[choisirPosteAERCible]]></Name>
					<X>2350</X><Y>4780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[macro]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codePrefere]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (postes == null || postes.isEmpty()) return null;
String macroVise = macro == null ? "" : macro.trim();
String codeVise = codePrefere == null ? "" : codePrefere.trim();

if (!codeVise.isEmpty()) {
    for (PosteGenericAgent p : postes) {
        if (p == null || p.codeSCOR == null) continue;
        if (p.codeSCOR.contains(codeVise)) return p;
    }
}

if (!macroVise.isEmpty()) {
    for (PosteGenericAgent p : postes) {
        if (p == null || p.codeSCOR == null) continue;
        if (macroPrefixe(p.codeSCOR).equals(macroVise)) return p;
    }
}

return postes.get(0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1910000000001</Id>
					<Name><![CDATA[traiterPropagationAERImmediat]]></Name>
					<X>2350</X><Y>4810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[macro]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (!realignementFluxHierarchiqueActif) return;
// Avance plusieurs sauts dans le même instant uniquement pour les exports de démonstration.
for (int i = 0; i < 12; i++) {
    int avant = (board != null && board.alertesPubliees != null) ? board.alertesPubliees.size() : 0;
    propagerAlertesAERHierarchiques();
    int apres = (board != null && board.alertesPubliees != null) ? board.alertesPubliees.size() : 0;
    if (avant == 0 && apres == 0) break;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1910000000002</Id>
					<Name><![CDATA[publierAERRetardCommande]]></Name>
					<X>2350</X><Y>4840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[cmd]]></Name>
						<Type><![CDATA[CommandeAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[leadTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (cmd == null || board == null) return;
if (!"EN_RETARD".equals(cmd.statut)) return;
if (cmd.idCommande == null) return;
if (aerCommandesRetardTracees.contains(cmd.idCommande)) return;
aerCommandesRetardTracees.add(cmd.idCommande);

double delaiPromis = Math.max(0.001, cmd.tPromise - cmd.tCreation);
double retard = Math.max(0.0, leadTime - delaiPromis);

// Cible opérationnelle réelle : priorité au poste Deliver d'expédition finale.
PosteGenericAgent cible = choisirPosteAERCible("sD", "D1.12");
if (cible == null) cible = choisirPosteAERCible("sD", "D1.11");
if (cible == null) cible = choisirPosteAERCible("sD", "D1.3");
String idCible = cible != null ? cible.idPoste : "sD_DELIVER";
String codeCible = cible != null ? cible.codeSCOR : "sD";

AERMessage msg = new AERMessage(
    AERMessage.REPORT,
    idCible,
    idSuperviseurPourCodeSCOR(codeCible),
    "RETARD_LIVRAISON",
    "commande=" + cmd.idCommande
        + ";poste=" + idCible
        + ";codeSCOR=" + codeCible
        + ";WT=" + String.format(java.util.Locale.US, "%.2f", retard)
        + ";retard=" + String.format(java.util.Locale.US, "%.2f", retard)
        + ";delaiTotal=" + String.format(java.util.Locale.US, "%.2f", leadTime)
        + ";delaiPromis=" + String.format(java.util.Locale.US, "%.2f", delaiPromis)
        + ";quantite=" + cmd.qte
        + ";statut=" + cmd.statut,
    time()
);

board.journaliserAER(
    "OPERATIONNEL_RAPPORTE",
    msg,
    "Alerte AER réelle déclenchée par la clôture en retard de " + cmd.idCommande
        + " ; poste cible=" + idCible + " ; retard=" + String.format(java.util.Locale.US, "%.1f", retard) + "s"
);
board.publierAlerte(msg);

// Le run de démonstration S1 doit pouvoir prouver la chaîne complète dans le
// même export automatique : on déclenche uniquement la propagation des agents
// existants, sans injecter de faux événement.
traiterPropagationAERImmediat("sD");]]></Body>
				</Function>
