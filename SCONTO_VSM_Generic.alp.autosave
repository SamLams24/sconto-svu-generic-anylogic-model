					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {5, 8, 12, 18, 12, 8, 12, 12, 14, 28};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "TABLEAU DE TRAÇABILITE — DONNEES BRUTES VERS DONNEES AGREGEES",
        w
    ));

    sb.append(tableRow(new String[]{
        "#",
        "T(s)",
        "Niveau",
        "Emetteur",
        "Poste",
        "SCOR",
        "Mesure",
        "Val. brute",
        "Val. agregee",
        "Formule"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (tracesAgregees == null || tracesAgregees.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", fmt1(time()), "-", "Blackboard", "-", "-", "-", "-", "-", "Aucune agregation"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    int debut = Math.max(0, tracesAgregees.size() - 25);

    for (int i = debut; i < tracesAgregees.size(); i++) {
        TraceData r = tracesAgregees.get(i);

        sb.append(tableRow(new String[]{
            String.valueOf(r.id),
            fmt1(r.t),
            r.niveauAggregation,
            r.emetteur,
            r.idPoste,
            r.codeSCOR,
            r.mesure,
            fmt2(r.valeurBrute),
            fmt2(r.valeurAgregee),
            r.formule
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

return sb.toString();]]></Body>
