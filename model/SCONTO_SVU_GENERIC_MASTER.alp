				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783700000046</Id>
					<Name><![CDATA[onMessageArrived]]></Name>
					<X>-300</X><Y>1360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[m]]></Name>
						<Type><![CDATA[Movable]]></Type>
					</Parameter>
					<Body><![CDATA[m.kindMessage = "";
m.type = "";
m.typeAffiche = "";
m.nomAffiche = "";
m.name = "";
m.sujetMessageAnime = "";
m.MovableInfo = "";
m.animationMessageManuelle = false;
m.animationDebut = 0.0;
m.animationFin = 0.0;
m.arriveeAt = -1;
m.libre = true;
m.setXY(-1000, -1000);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783700000047</Id>
					<Name><![CDATA[animerMessage]]></Name>
					<X>-300</X><Y>1380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idSrc]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[idCib]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[kind]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[info]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Point d'entrée unique pour l'animation des communications informationnelles.
// Le déplacement est interpolé manuellement par AnimationMessagesManager afin
// de rester visible et indépendant de la variante d'API moveTo/setSpeed.
if (messagesAnimes.size() == 0) initialiserPoolMessages();
if (puppets == null || puppets.isEmpty()) creerStationsAnimation();

Movable src = puppet(idSrc);
Movable dst = puppet(idCib);
double[] xySrc = xyPuppet(idSrc);
double[] xyDst = xyPuppet(idCib);
if (src == null || dst == null || xySrc == null || xyDst == null) {
    String details = "Agent SCOR introuvable pour " + kind + " : " + idSrc + " -> " + idCib;
    board.logEvent("[ANIM] " + details + " - animation ignorée. Clés disponibles=" + puppets.keySet());
    return;
}

Movable msg = getMovableLibre();
if (msg == null) {
    board.logEvent("[ANIM] pool de messages saturé (" + TAILLE_POOL_MESSAGES
        + "), animation ignorée pour " + idSrc + " -> " + idCib + ".");
    return;
}

String sujet = kind == null ? "" : kind.trim();
String sujetUpper = sujet.toUpperCase(java.util.Locale.ROOT);
String typeVisuel = "message";
if (sujetUpper.contains("CUSTOMERORDER") || sujetUpper.equals("ORDERCONFIRMED")
    || sujetUpper.contains("ORDERCONFIRMATION")) {
    typeVisuel = "commande";
} else if (sujetUpper.contains("WORKORDER") || sujetUpper.contains("PRODUCTIONORDER")
    || sujetUpper.contains("PROCUREMENTORDER") || sujetUpper.contains("DELIVERYORDER")
    || sujetUpper.contains("PURCHASEORDER") || sujetUpper.contains("TASKASSIGNMENT")) {
    typeVisuel = "workOrder";
}

msg.libre = false;
msg.type = "";
msg.typeAffiche = "";
msg.nomAffiche = "";
msg.kindMessage = typeVisuel;
msg.sujetMessageAnime = sujet.isEmpty() ? "Message" : sujet;
msg.name = "";
msg.MovableInfo = msg.sujetMessageAnime;
msg.setXY(xySrc[0], xySrc[1]);

double dx = xyDst[0] - xySrc[0];
double dy = xyDst[1] - xySrc[1];
double distance = Math.sqrt(dx * dx + dy * dy);
double duree = dureeAnimationDepuisDistance(distance, false);

msg.animationDepartX = xySrc[0];
msg.animationDepartY = xySrc[1];
msg.animationArriveeX = xyDst[0];
msg.animationArriveeY = xyDst[1];
msg.animationDebut = time();
msg.animationFin = time() + Math.max(1.0, duree);
msg.animationMessageManuelle = true;
msg.arriveeAt = msg.animationFin + Math.max(0.0, pauseApresArriveeAnimationSec);

String scor = extraireSCORDepuisInfo(info);
board.logEvent("[ANIM MOVE] " + msg.sujetMessageAnime + " " + idSrc + " -> " + idCib
    + " src=(" + String.format("%.1f", xySrc[0]) + "," + String.format("%.1f", xySrc[1]) + ")"
    + " dst=(" + String.format("%.1f", xyDst[0]) + "," + String.format("%.1f", xyDst[1]) + ")"
    + " durée=" + String.format("%.1f", duree) + "s; visuel=" + typeVisuel);
ajouterSuivi("Communication", "Message envoyé entre agents", info, idSrc, idCib, scor);
afficherFluxAnimation(msg.sujetMessageAnime, scor, idSrc, idCib, info);]]></Body>
				</Function>
