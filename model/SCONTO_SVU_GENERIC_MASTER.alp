		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1782000000800</Id>
			<Name><![CDATA[OperationalAgent]]></Name>
			<AdditionalClassCode><![CDATA[String idAgentLogique = "";
String idResponsabilite = "";
String idActeurSC = "";
String nomActeurSC = "";
String niveauHierarchique = "OPERATIONAL";
String roleHolonique = "AGENT_OPERATIONNEL_EXECUTION";
String idRoleHierarchique = "";
String idSuperviseurRattache = "";
String idCoordinateurRattache = "";
String idTactiqueRattache = "";
String strategieRealisation = "NON_APPLICABLE";
int numeroInstance = 1;

// ============================================================
// BOITE HIERARCHIQUE GENERATION 2
// Chaque instruction ou rapport distribue par Main atteint une vraie instance.
// ============================================================
java.util.ArrayList<AERMessage> boiteMessagesHierarchiques = new java.util.ArrayList<AERMessage>();
int nbMessagesHierarchiquesRecus = 0;
String dernierMessageHierarchique = "";

void recevoirMessageHierarchique(AERMessage msg) {
    if (msg == null) return;
    boiteMessagesHierarchiques.add(msg);
    if (boiteMessagesHierarchiques.size() > 100) boiteMessagesHierarchiques.remove(0);
    nbMessagesHierarchiquesRecus++;
    dernierMessageHierarchique = msg.toString();
    // C14.50 -- n'ecrase plus etatHolon : la reception d'un message AER est un
    // evenement de COMMUNICATION, pas un etat physique du poste. "INSTRUCTION_RECUE"
    // ne figurant dans aucun case de couleurOperational(), l'agent basculait sur
    // la couleur par defaut (gris) a chaque message recu, puis revenait a son
    // etat reel au tick suivant d'analyserEtat() -- provoquant des changements
    // de couleur sans rapport avec l'activite du poste. Le compteur de messages
    // et le dernier message restent traces ci-dessus.
    if (AERMessage.AMENDMENT.equals(msg.type)) {
        tDernierMessageAER = time();
    }
}
]]></AdditionalClassCode>
