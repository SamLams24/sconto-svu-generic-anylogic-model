						</Rate>
						<Id>1783700000031</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1783584000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[true]]></Condition>
					</Properties>
					<Action><![CDATA[// Met à jour le timer simulé puis traite les actions métier différées.
actualiserTempsSimulation();
if (modeExecution) {
    traiterActionsMetierDifferees();
    propagerAlertesAERHierarchiques();
    traiterFileFluxInformationnelsAnimes();
}

// Interpolation explicite des messages informationnels. Le pas d'une seconde
// reste suffisamment lisible avec les durées d'animation ralenties (8 à 18 s).
for (Movable m : messagesAnimes) {
    if (m == null || m.libre) continue;

    if (m.animationMessageManuelle) {
        double den = Math.max(0.001, m.animationFin - m.animationDebut);
        double progression = (time() - m.animationDebut) / den;
        if (progression < 0.0) progression = 0.0;
        if (progression > 1.0) progression = 1.0;
        double nx = m.animationDepartX + progression * (m.animationArriveeX - m.animationDepartX);
        double ny = m.animationDepartY + progression * (m.animationArriveeY - m.animationDepartY);
        m.setXY(nx, ny);
        if (progression >= 1.0) m.animationMessageManuelle = false;
    }

    if (m.arriveeAt >= 0 && time() >= m.arriveeAt) onMessageArrived(m);
}]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000050</Id>
					<Name><![CDATA[ajouterPoste]]></Name>
					<X>2520</X><Y>-1000</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// 1. CONTRÔLE : Nom de la micro-activité obligatoire
if (champNom == null || champNom.trim().isEmpty()) {
    messageStatut = "ERREUR : Nom de la micro-activité obligatoire.";
    getExperimentHost().showMessageDialog(
        "⚠️ Champ manquant\n\nLe nom de la micro-activité is obligatoire.\nVeuillez saisir un nom avant de valider.");
    return;
}
String nomNettoye = champNom.trim();

// 2. CONTRÔLE unicité du nom
for (PosteGenericAgent posteExistant : postes) {
    if (posteExistant.nom.equalsIgnoreCase(nomNettoye)) {
        messageStatut = "ERREUR : Une micro-activité '" + nomNettoye + "' existe déjà.";
        getExperimentHost().showMessageDialog(
            "⚠️ Doublon détecté\n\nUne micro-activité nommée '" + nomNettoye + "' existe déjà.\nChoisissez un nom différent.");
        return;
    }
}

// 3. EXTRACTION du code SCOR depuis le ComboBox
String selectionSCOR = champCodeSCOR != null ? champCodeSCOR.trim() : "";
String codeSCORExtrait = selectionSCOR;
if (selectionSCOR.contains(" — ")) {
    codeSCORExtrait = selectionSCOR.split(" — ")[0].trim();
}
if (codeSCORExtrait.isEmpty()) {
    messageStatut = "ERREUR : Activité SCOR N3 non sélectionnée.";
    getExperimentHost().showMessageDialog(
        "⚠️ Activité SCOR manquante\n\nVeuillez sélectionner une activité SCOR Niveau 3\ndans la liste déroulante avant d'ajouter la micro-activité.");
    return;
}

// Contrôle : acteur responsable obligatoire
String idActeurSelectionne = extraireIdActeurDepuisCombo(champActeurLieMicro);
ActeurSC acteurResp = trouverActeurParId(idActeurSelectionne);

if (acteurResp == null) {
    messageStatut = "ERREUR : aucun acteur responsable sélectionné.";

    getExperimentHost().showMessageDialog(
        "⚠️ Acteur responsable manquant\n\n"
        + "Avant d'ajouter une micro-activité, vous devez choisir\n"
        + "l'acteur de la chaîne auquel cette micro-activité est rattachée.\n\n"
        + "Ordre recommandé :\n"
        + "1. Configurer les acteurs de la chaîne\n"
        + "2. Configurer les micro-activités\n"
        + "3. Assigner chaque micro-activité à un acteur"
    );

    return;
}

// 4. CONTRÔLE ET RECHERCHE DES POSTES PRÉCÉDENTS
String chaineSaisie = editbox7.getText() != null ? editbox7.getText().trim() : "";

// Si l'utilisateur a saisi des parents, on valide qu'ils existent bien tous avant de créer le poste
if (!chaineSaisie.isEmpty()) {
    String[] elements = chaineSaisie.split(",");
    for (String nomParent : elements) {
        String nomParentNettoye = nomParent.trim();
        if (nomParentNettoye.isEmpty()) continue;
        
        // Vérification de l'existence dans la collection
        boolean existe = false;
        for (PosteGenericAgent ex : postes) {
            if (ex.nom.equalsIgnoreCase(nomParentNettoye)) {
                existe = true;
                break;
            }
        }
        if (!existe) {
            messageStatut = "ERREUR : Le poste précédent '" + nomParentNettoye + "' n'existe pas.";
            getExperimentHost().showMessageDialog(
                "⚠️ Poste précédent introuvable\n\nLe poste '" + nomParentNettoye + "' n'existe pas dans le système.");
            return; 
        }
    }
}

// 5. GÉNÉRATION DE L'ID AUTOMATIQUE
int indexSousActivite = 1;
String prefixId = "s" + codeSCORExtrait + ".";
for (PosteGenericAgent ex : postes) {
    if (ex.idPoste.startsWith(prefixId)) indexSousActivite++;
}
String idGenere = prefixId + indexSousActivite;

// 6. CRÉATION ET CONFIGURATION DE L'AGENT
PosteGenericAgent p = add_postes();
p.idPoste            = idGenere;
p.nom                = nomNettoye;
p.codeSCOR           = codeSCORExtrait;
p.typePoste          = TypePoste.valueOf(champTypePoste);
p.loiTemps           = new LoiTemps(champLoiDist, champP1, champP2);
p.capaciteSimultanee = champCapacite;
p.tauxVA = Math.max(0.0, Math.min(1.0, champTauxVA));
p.coutHoraireMainOeuvre = Math.max(0.0, champCoutHoraireMainOeuvre);
p.coutMatierePremiereParUnite = Math.max(0.0, champCoutMatierePremiereParUnite);
p.valeurActifFixe = Math.max(0.0, champValeurActifFixe);

// Mode du poste : genere ses propres entites (autonome) ou attend uniquement
// de recevoir d'un poste amont (comportement historique par defaut).
p.genereAutonome = champGenereAutonome;
p.politiqueApproPoste = (champPolitiqueApproPoste != null) ? champPolitiqueApproPoste.trim() : "";
p.intervalleApproPoste = Math.max(0.0, champIntervalleApproPoste);
p.tauxArriveePoissonPoste = Math.max(0.0, champTauxArriveePoissonPoste);
p.quantiteParApproPoste = Math.max(1.0, champQuantiteParApproPoste);

// Taille de lot de traitement (batch) : 1 = comportement historique (unite par unite).
p.tailleLot = Math.max(1, (int) Math.round(champTailleLot));

// Jonction multi-amont : si coche, le poste attend une entite de CHACUNE de
// ses branches amont declarees (chainesPrecedents) avant de relacher la suite.
// On reutilise le meme mecanisme de lot (tailleLot/lotEnCours) : la taille de
// lot est alors automatiquement alignee sur le nombre de predecesseurs.
p.attendTousLesPredecesseurs = champAttendTousLesPredecesseurs;
if (p.attendTousLesPredecesseurs) {
    int nbParents = 1;
    if (p.chainesPrecedents != null && !p.chainesPrecedents.trim().isEmpty()) {
        nbParents = Math.max(1, p.chainesPrecedents.split(",").length);
    }
    p.tailleLot = nbParents;
}

// Controle qualite / aiguillage (Phase 2) — disponible sur tout type de poste
if (champControleQualiteActif) {
    String cible = (champCibleEchec != null) ? champCibleEchec.trim() : "";
    p.regleAiguillage = new RegleAiguillage(champTypeControleQualite, champTauxConforme, cible);
} else {
    p.regleAiguillage = null;
}

// Liaison micro-activité -> acteur de chaîne
p.idActeurResponsable = acteurResp.idActeur;
p.nomActeurResponsable = acteurResp.nom;
p.categorieActeurResponsable = acteurResp.categorie;
p.typeAnnexeActeurResponsable = acteurResp.typeAnnexe;

// Liaison acteur -> micro-activité
acteurResp.ajouterMicroActivite(p.idPoste);

// ON STOCKE LE STRING DIRECTEMENT DANS L'AGENT
p.chainesPrecedents  = chaineSaisie; 
p.estUnPosteAlternatif = checkbox.isSelected();

// Connexion logique AnyLogic à la volée (split)
if (!p.chainesPrecedents.isEmpty()) {
    String[] elements = p.chainesPrecedents.split(",");
    for (String nomParent : elements) {
        String nomParentNettoye = nomParent.trim();
        for (PosteGenericAgent ex : postes) {
            if (ex.nom.equalsIgnoreCase(nomParentNettoye)) {
                connecterPostes(p, ex, estFluxInformationnel(ex, p)); // C14.3.2/C14.7 : pointillé si pilotage, plein sinon
                break;
            }
        }
    }
}

// 7. POSITIONNEMENT + AGENT OPÉRATIONNEL
positionnerPoste(p);
OperationalAgent op = add_opAgents();
op.initialiser(p, p.codeSCOR);
board.logEvent("[HOLON] OperationalAgent créé pour " + p.idPoste);

// OperationalAgent automatique de base
op.idAgentLogique = "OP_AUTO_" + p.idPoste;
op.idActeurSC = acteurResp.idActeur;
op.nomActeurSC = acteurResp.nom;
op.niveauHierarchique = "OPERATIONAL";
op.numeroInstance = 1;

if (!p.idsOperationalAgents.contains(op.idAgentLogique)) {
    p.idsOperationalAgents.add(op.idAgentLogique);
}

refreshMicroActiviteComboBox();
rafraichirComboPostes();
MicroResponsabilite r = new MicroResponsabilite();

r.idResponsabilite = "RESP_" + (++seqResponsabilite);
r.idMicroActivite = p.idPoste;
r.nomMicroActivite = p.nom;

r.idActeur = acteurResp.idActeur;
r.nomActeur = acteurResp.nom;
r.categorieActeur = acteurResp.categorie;
r.typeAnnexeActeur = acteurResp.typeAnnexe;

r.niveauHierarchique = "OPERATIONAL";
r.typeAgent = "OperationalAgent";
r.isTactic = false;
r.quantite = 1;
r.actif = true;

r.idsAgentsCrees.add(op.idAgentLogique);

responsabilitesMicro.add(r);
p.idsResponsabilites.add(r.idResponsabilite);
messageStatut = "Micro-activité '" + p.nom + "' (" + p.idPoste + ") ajoutée.";
board.logEvent("Micro-activité ajoutée : " + p.idPoste);
refreshActeursMicroComboBox();
refreshMicroActiviteComboBox();

// Fusionne automatiquement ce nouveau poste avec un OperationalAgent existant
// s'il partage le meme (acteur, SCOR N3) qu'un poste deja configure.
recalculerTousLesGroupesOperationnels();

// Replace proprement l'ensemble des postes (le nouveau poste peut creer une
// nouvelle colonne / decaler ses successeurs).
relayoutTousLesPostes();
// Maintient viewAnimation synchronisée avec les postes créés manuellement.
creerStationsAnimation();
fluxInfoInitialDejaDeclenche = false;
declencherFluxInformationInitiale();

// 8. CONFIRMATION VISUELLE
getExperimentHost().showMessageDialog(
     "✅ Micro-activité ajoutée avec succès\n\n"
    + "Nom                : " + p.nom + "\n"
    + "ID généré          : " + p.idPoste + "\n"
    + "SCOR N3            : " + p.codeSCOR + "\n"
    + "Acteur responsable : " + acteurResp.nom + " [" + acteurResp.typeAffiche() + "]\n"
    + "Précédents         : " + (p.chainesPrecedents.isEmpty() ? "—" : p.chainesPrecedents) + "\n"
    + "Total micro-activités : " + postes.size()
    );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000051</Id>
					<Name><![CDATA[positionnerPoste]]></Name>
					<X>2520</X><Y>-940</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Body><![CDATA[if (p.positionManuelle) {
    p.setXY(p.xManuel, p.yManuel);
    return;
}
// Placement initial simple (bande du bon acteur). Le placement fin topologique
// est fait globalement par relayoutTousLesPostes() apres chargement/ajout.
int indexActeur = indexActeurDe(p.idActeurResponsable);
Integer nbRacines = nbRacinesParActeur.get(p.idActeurResponsable);
int rangLigne = (nbRacines == null) ? 0 : nbRacines;
nbRacinesParActeur.put(p.idActeurResponsable, rangLigne + 1);
double y = LAYOUT_Y_BASE + indexActeur * LAYOUT_BAND_HEIGHT + rangLigne * LAYOUT_LANE_HEIGHT;
p.setXY(LAYOUT_X_START, y);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1791000001201</Id>
					<Name><![CDATA[indexActeurDe]]></Name>
					<X>2520</X><Y>-910</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idActeur]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = 0; i < acteursSC.size(); i++) {
    if (acteursSC.get(i).idActeur.equals(idActeur)) return i;
}
return 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000001203</Id>
					<Name><![CDATA[relayoutTousLesPostes]]></Name>
					<X>2520</X><Y>-850</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (postes.isEmpty()) return;

java.util.HashMap<String,PosteGenericAgent> parNom = new java.util.HashMap<String,PosteGenericAgent>();
for (PosteGenericAgent p : postes) {
    if (p.nom != null) parNom.put(p.nom.trim().toLowerCase(), p);
    if (p.idPoste != null) parNom.put(p.idPoste.trim().toLowerCase(), p);
}

java.util.HashMap<PosteGenericAgent, java.util.ArrayList<PosteGenericAgent>> parents =
    new java.util.HashMap<PosteGenericAgent, java.util.ArrayList<PosteGenericAgent>>();
for (PosteGenericAgent p : postes) {
    java.util.ArrayList<PosteGenericAgent> lst = new java.util.ArrayList<PosteGenericAgent>();
    if (p.chainesPrecedents != null && !p.chainesPrecedents.trim().isEmpty()) {
        for (String np : p.chainesPrecedents.split(",")) {
            PosteGenericAgent par = parNom.get(np.trim().toLowerCase());
            if (par != null && par != p) lst.add(par);
        }
    }
    parents.put(p, lst);
}

java.util.HashMap<PosteGenericAgent,Integer> profondeur = new java.util.HashMap<PosteGenericAgent,Integer>();
for (PosteGenericAgent p : postes) {
    calculerProfondeur(p, parents, profondeur, new java.util.HashSet<PosteGenericAgent>());
}

nbRacinesParActeur.clear();
final java.util.HashMap<PosteGenericAgent,Integer> profF = profondeur;
java.util.HashMap<String,Integer> occupationColonne = new java.util.HashMap<String,Integer>();

java.util.ArrayList<PosteGenericAgent> ordre = new java.util.ArrayList<PosteGenericAgent>();
for (PosteGenericAgent pp : postes) ordre.add(pp);
java.util.Collections.sort(ordre, new java.util.Comparator<PosteGenericAgent>() {
    public int compare(PosteGenericAgent a, PosteGenericAgent b) {
        int ia = indexActeurDe(a.idActeurResponsable);
        int ib = indexActeurDe(b.idActeurResponsable);
        if (ia != ib) return Integer.compare(ia, ib);
        int pa = profF.get(a), pb = profF.get(b);
        if (pa != pb) return Integer.compare(pa, pb);
        return a.idPoste.compareTo(b.idPoste);
    }
});

for (PosteGenericAgent p : ordre) {
    if (p.positionManuelle) continue;
    int prof = profF.get(p);
    int idxActeur = indexActeurDe(p.idActeurResponsable);
    String cle = p.idActeurResponsable + "#" + prof;
    int rang = occupationColonne.containsKey(cle) ? occupationColonne.get(cle) : 0;
    occupationColonne.put(cle, rang + 1);

    double x = LAYOUT_X_START + prof * LAYOUT_X_STEP;
    double yLigne = rang * LAYOUT_LANE_HEIGHT;
    if (p.estUnPosteAlternatif) yLigne += LAYOUT_ALT_OFFSET;
    double y = LAYOUT_Y_BASE + idxActeur * LAYOUT_BAND_HEIGHT + yLigne;
    p.setXY(x, y);
}

board.logEvent("[LAYOUT] Relayout global effectue sur " + postes.size() + " poste(s).");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1791000001204</Id>
					<Name><![CDATA[calculerProfondeur]]></Name>
					<X>2520</X><Y>-820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[parents]]></Name>
						<Type><![CDATA[java.util.HashMap<PosteGenericAgent, java.util.ArrayList<PosteGenericAgent>>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[memo]]></Name>
						<Type><![CDATA[java.util.HashMap<PosteGenericAgent,Integer>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[enCours]]></Name>
						<Type><![CDATA[java.util.HashSet<PosteGenericAgent>]]></Type>
					</Parameter>
					<Body><![CDATA[if (memo.containsKey(p)) return memo.get(p);
if (enCours.contains(p)) return 0;
enCours.add(p);
java.util.ArrayList<PosteGenericAgent> pars = parents.get(p);
int prof = 0;
if (pars != null) {
    for (PosteGenericAgent par : pars) {
        prof = Math.max(prof, 1 + calculerProfondeur(par, parents, memo, enCours));
    }
}
enCours.remove(p);
memo.put(p, prof);
return prof;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1781300000052</Id>
					<Name><![CDATA[validerConfig]]></Name>
					<X>2520</X><Y>-880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (acteursSC.size() == 0) {
    messageStatut = "ERREUR : aucun acteur de la chaîne défini.";
    return false;
}

if (postes.size() == 0) {
    messageStatut = "ERREUR : Aucun poste defini.";
    return false;
}

for (PosteGenericAgent p : postes) {
    if (macroPrefixe(p.codeSCOR).equals("??")) {
        messageStatut =
            "ERREUR : Code SCOR invalide sur poste "
            + p.idPoste
            + " ("
            + p.codeSCOR
            + ")";
        return false;
    }

    if (p.idActeurResponsable == null || p.idActeurResponsable.trim().isEmpty()) {
        messageStatut =
            "ERREUR : la micro-activité "
            + p.idPoste
            + " n'est liée à aucun acteur responsable.";
        return false;
    }

    if (trouverActeurParId(p.idActeurResponsable) == null) {
        messageStatut =
            "ERREUR : la micro-activité "
            + p.idPoste
            + " référence un acteur inexistant : "
            + p.idActeurResponsable;
        return false;
    }
}

if (scenarios.isEmpty()) {
    messageStatut = "ERREUR : Aucun scenario defini. Ajoutez au moins un scenario.";
    return false;
}

for (ScenarioFlux sc : scenarios) {
    for (String id : sc.sequence) {
        if (trouverPoste(id) == null) {
            StringBuilder idsValides = new StringBuilder();

            for (PosteGenericAgent p : postes) {
                idsValides.append(p.idPoste).append(" ");
            }

            messageStatut =
                "ERREUR : scenario '"
                + sc.typeProduit
                + "' reference un poste inconnu : "
                + id
                + ". IDs valides : "
                + idsValides.toString().trim();

            return false;
        }
    }
}

messageStatut =
    "Configuration valide. "
    + postes.size()
    + " postes, "
    + scenarios.size()
    + " scenarios, "
    + acteursSC.size()
    + " acteurs prêts.";

return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000053</Id>
					<Name><![CDATA[demarrerSimulation]]></Name>
					<X>2520</X><Y>-820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[synchroniserListeProduits();
if (!validerConfig()) return;

// Panneau de depart : date simulee, echelle temps et budgets.
// Le demarrage est annule si l'utilisateur ferme/annule ce panneau.
if (afficherPopupTempsBudgetAuDemarrage || !paramsTempsBudgetValides) {
    if (!ouvrirParametresTempsBudgetDebut()) {
        messageStatut = "Demarrage annule : parametres temps/budget non valides.";
        board.logEvent("[TEMPS/BUDGET] demarrage annule avant execution");
        return;
    }
} else {
    initialiserHorlogeSimulation();
}

// Phase de preparation : on garde modeExecution=false pour garantir
// qu'aucun evenement metier cyclique ne se declenche avant la fin du demarrage.
modeExecution = false;
tempsDebutSimulation = -1;
c14SnapshotFinalEffectue = false;
commandesGenereesDepuisDemarrage = 0;
messageLimiteCommandesDejaAffiche = false;
// Etat runtime des perturbations : la configuration utilisateur est conservee,
// mais chaque run recommence avec un compteur propre et une perturbation non consommee.
retardFournisseurConsomme = false;
nbApprovisionnementsRetardes = 0;
cumulRetardFournisseurHeures = 0.0;
dernierRetardFournisseurHeures = 0.0;
derniereMatiereRetardee = "";
dernierFournisseurRetarde = "";
dernierNbCommandesImpacteesRetardFournisseur = 0;
actionsMetierDifferees.clear();
dernierPopupMetierA = -999999.0;
try { arrivee.reset(); } catch (Throwable ignored) {}
try { generateurCommandes.reset(); } catch (Throwable ignored) {}
try { tickAppro.reset(); } catch (Throwable ignored) {}

board.reset();
// Bloc B.1 -- remise a zero des fondations PI/SCOR par run (memes champs
// qu'introduits sur StrategicAgent ; voir son AdditionalClassCode). Cablees
// dans calculerPIGlobal() depuis le Bloc B.2.
if (strategic != null) {
    // Bloc B.2-FIX -- BUG CONFIRME PAR RUN REEL : les premiers snapshots
    // Historique Dashboard affichaient PI=0 (pas PI=cible=7.5) pendant
    // l'amorcage. Cause racine : capturerPointHistoriqueDashboard() lit
    // strategic.piGlobalCourant DIRECTEMENT (jamais calculerPIGlobal()),
    // et ce champ demarre a 0 (valeur d'initialisation de la Variable) tant
    // qu'aucun appel reel a calculerPIGlobal() n'a encore eu lieu -- la
    // logique de warm-up de calculerPIGlobal() elle-meme (qui force
    // pi=ciblePIGlobal tant que le perimetre est incomplet, Bloc B.2) n'a
    // aucun effet sur ce premier instant puisqu'elle n'a pas encore ete
    // executee. Corrige en alignant le champ affiche sur la cible des le
    // demarrage du run, comme le fait le reste de ce bloc pour les autres
    // etats PI/SCOR.
    strategic.piGlobalCourant = strategic.ciblePIGlobal;
    strategic.donneesRLPresentesPrecedent = false;
    strategic.donneesRSPresentesPrecedent = false;
    strategic.donneesAMPresentesPrecedent = false;
    strategic.dernierLogDetailSCOR = -999.0;
    strategic.perimetrePIDejaComplet = false;
    strategic.attributsPonderesPI = "";
    strategic.sommePoidsEffectifsPI = 0;
}
resetSuiviSimulation();
if (fluxLogs != null) fluxLogs.clear();
if (tracesBrutes != null) tracesBrutes.clear();
if (tracesAgregees != null) tracesAgregees.clear();
seqTrace = 0;
seqTraceBrute = 0;
seqTraceAgregee = 0;
commandesClotureesTracees.clear();
aerCommandesRetardTracees.clear();
seqFlux = 0;
seqProduitRuntime = 0;
nbTerminesProduction = 0;
nbLiensPointilles = 0;
nbLiensPleins = 0;
fluxInfoDisponible = true;
fluxInfoDiagnostiqueFait = false;

ajouterSuivi("Simulation", "Demarrage de la simulation", "Validation terminee : postes=" + postes.size() + ", scenarios=" + scenarios.size() + ", acteurs=" + acteursSC.size(), "Utilisateur", "Modele", "START");

orderRegistry.clear();
produitRegistry.clear();
produitsTerminesParCommandeRuntime.clear();

sommeWaitProductionParCommandeRuntime.clear();

// Si l'utilisateur a sélectionné directement « ZENER CAS 1/2/3 » dans la liste,
// le profil correspondant est appliqué avant toute initialisation de stock.
ScenarioFlux scenarioProfilSelectionne = scenarioSelectionneInterface();
if (scenarioProfilSelectionne != null && estScenarioCasTest(scenarioProfilSelectionne)) {
    synchroniserProfilAvecScenarioSelectionne(scenarioProfilSelectionne);
}

reinitialiserPolitiquesStockPourRun();
initialiserStocksProduits();
appliquerStocksInitiauxConfig();
creerStationsAnimation();
fluxInfoInitialDejaDeclenche = false;
reinitialiserHistoriqueFluxInformationnels();
// Bloc A.4 -- l'historique Dashboard appartient au run courant : reparti a vide a
// chaque demarrerSimulation() pour que l'export Excel ne melange jamais deux runs.
historiqueDashboard.clear();
dernierTempsCaptureHistoriqueDashboard = -1.0;
runFinalise = false;

// Initialiser les agents tactiques
while (tacticals.size() > 0) {
    remove_tacticals(tacticals.get(tacticals.size() - 1));
}

// Initialiser les coordinateurs dedies (1 par macro-processus)
while (supervisorsMacro.size() > 0) {
    remove_supervisorsMacro(supervisorsMacro.get(supervisorsMacro.size() - 1));
}

initTacticals();
initSupervisorsMacro();
realignerArchitectureAgents();

// Activation metier officielle : a partir de cette ligne seulement,
// les commandes, productions, livraisons et retours sont autorises.
modeExecution = true;
aboxRunId = "";
dernierFichierABox = "";
tempsDebutSimulation = time();
simStartRealMillis = 0L;
initialiserHorlogeSimulation();
actualiserTempsSimulation();
// Bloc A.4 -- capture initiale a t=0, pour que la premiere ligne de l'historique
// corresponde au vrai debut du run plutot qu'au premier cycle d'ExcelExportManager.
try { capturerPointHistoriqueDashboard(); } catch (Throwable ignoredHistoriqueDashboard) {}

ajouterSuiviDetaille(
    "Parametrage temps/budget",
    "Parametres temporels et budgetaires appliques",
    "Le modele fixe la date simulee de depart, l'echelle de conversion temps simulation vers temps reel, puis les budgets de reference.",
    "Utilisateur",
    "Modele SCONTO-VSM",
    "Horloge simulee et budgets SCOR",
    resumeTempsBudgetSimulation(),
    "Panneau de demarrage",
    "Modele de simulation",
    "Parametres utilisateur -> horloge et budgets",
    "PLAN / SCOR",
    "Initialiser l'horloge et les budgets avant les flux metier.",
    "Parametres non appliques",
    "Parametres appliques",
    "Date simulee ; echelle temps ; budget global ; budgets Plan/Source/Make/Deliver/Return"
);

// Communications initiales : elles restent informationnelles et ne declenchent
// ni approvisionnement, ni production, ni livraison.
declencherFluxInformationInitiale();

messageStatut = "Simulation demarree. " + postes.size() + " postes actifs.";
board.logEvent("=== SIMULATION DEMARREE ===");
ajouterSuivi("Simulation", "Simulation demarree", messageStatut, "Modele", "Utilisateur", "START");

// Mode de génération contrôlée des commandes.
// Les commandes restent le stimulus de demande ; la reconstitution des stocks
// Source/Make est désormais pilotée indépendamment par les politiques (s,Q).
if (modePilotageParCommande) {
    try { arrivee.reset(); } catch (Throwable ignored) {}
    try { tickAppro.reset(); } catch (Throwable ignored) {}

    // En mode cas d'etude, la generation est orchestree par notre file d'actions
    // pour maitriser les delais et le nombre de commandes. L'ancien event cyclique
    // reste desactive afin de ne pas polluer les tests.
    try { generateurCommandes.reset(); } catch (Throwable ignored) {}

    ajouterSuiviDetaille(
        "Mode de pilotage",
        "Generation de demandes clients active",
        "Le modele genere les commandes clients ; la livraison repond a la demande tandis que la production et l'approvisionnement peuvent etre declenches par les politiques de stock autonomes.",
        "Utilisateur",
        "Modele SCONTO-VSM",
        "Scenario de simulation",
        "Stocks par defaut : produit fini=" + String.format("%.0f", champStockInitialProduitFini) + " ; matiere=" + String.format("%.0f", champStockInitialMatiereGlobal) + " ; " + resumeNombreCommandes(),
        "Vue Configuration",
        "Generateur de commandes",
        "Commande client -> Analyse stock ; politiques (s,Q) -> Source/Make ; stock disponible -> Deliver",
        "P2 / P3 / S1 / M1 / D1",
        "Distinguer la demande client des decisions autonomes de reconstitution du stock.",
        "Mode preparation",
        "Mode execution par commande",
        "Temps de traitement commande ; taux de service ; stock fini ; besoin matiere"
    );

    // Premiere commande demonstrative planifiee avec un petit delai : elle apparait
    // apres le lancement et devient le vrai declencheur du cas.
    planifierPremiereCommandeDemonstrative();
} else {
    try { arrivee.restart(); } catch (Throwable ignored) {}
    try { tickAppro.restart(); } catch (Throwable ignored) {}
    try { generateurCommandes.reset(); } catch (Throwable ignored) {}
}

viewExecution.navigateTo();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781300000054</Id>
					<Name><![CDATA[arreterSimulation]]></Name>
					<X>2520</X><Y>-760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[modeExecution = false;
arrivee.reset();
strategic.piGlobalCourant = strategic.calculerPIGlobal();
board.logEvent("=== SIMULATION ARRETEE - PI=" + String.format("%.3f", strategic.piGlobalCourant) + " ===");
// A.4-FIX-4 -- la capture finale + l'export ABox/Excel de cloture sont
// centralises dans finaliserRunEtExporter() (idempotent), reutilisable depuis
// n'importe quel chemin d'arret futur. Voir son commentaire pour le detail et
// la limite connue (n'est PAS appelee par le bouton natif Stop/Terminate
// d'AnyLogic, qui ne declenche aucun code du modele).
finaliserRunEtExporter();
// A.4-FIX-5B -- termine reellement le moteur AnyLogic APRES les exports finaux
// ci-dessus (ordre obligatoire : les exports doivent voir l'etat du modele avant
// le passage du moteur a FINISHED). Observation ayant motive cet ajout : sur le
// run precedent, modeExecution=false + arrivee.reset() n'arretaient que la
// logique metier du modele -- le moteur AnyLogic continuait reellement de
// tourner ([HOLON-STRAT]/[DIAG-BLOQUEE] observes ~9s apres "SIMULATION ARRETEE",
// interface active jusqu'a ~t+86s). API Agent.finishSimulation() (heritee par
// Main) : termine la simulation apres l'evenement courant sans detruire
// immediatement le modele, laissant les resultats consultables -- c'est le
// comportement recherche (a la difference d'un arret moteur brutal). Cette API
// n'a aucun usage prealable dans ce fichier ni dans reference/colleague/ : sa
// disponibilite pour AnyLogic 8.9.x est basee sur la documentation Agent de
// l'API AnyLogic (methode heritee, stable depuis plusieurs versions majeures),
// non verifiee par compilation locale -- le Build AnyLogic de l'utilisateur reste
// la validation de reference, comme pour tout le reste de cette fusion.
boolean finishOk = finishSimulation();
board.logEvent("[FINALIZE] finishSimulation demande = " + finishOk);
//viewDashboard.navigateTo();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
