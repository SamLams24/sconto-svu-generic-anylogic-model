					<X>-300</X><Y>880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[poste]]></Name>
						<Type><![CDATA[PosteGenericAgent]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.Map<String,Object> mp = new java.util.LinkedHashMap<String,Object>();
mp.put("idPoste", poste.idPoste);
mp.put("nom", poste.nom);
mp.put("codeSCOR", poste.codeSCOR);
mp.put("typePoste", poste.typePoste != null ? poste.typePoste.name() : "");
java.util.Map<String,Object> lt = new java.util.LinkedHashMap<String,Object>();
lt.put("distribution", poste.loiTemps != null ? poste.loiTemps.distribution : "uniform");
lt.put("p1", poste.loiTemps != null ? poste.loiTemps.p1 : 1.0);
lt.put("p2", poste.loiTemps != null ? poste.loiTemps.p2 : 1.0);
lt.put("p3", poste.loiTemps != null ? poste.loiTemps.p3 : 1.0);
mp.put("loiTemps", lt);
mp.put("capaciteSimultanee", poste.capaciteSimultanee);
mp.put("niveauStock", poste.niveauStock);
mp.put("chainesPrecedents", poste.chainesPrecedents != null ? poste.chainesPrecedents : "");
mp.put("estUnPosteAlternatif", poste.estUnPosteAlternatif);
mp.put("idActeurResponsable", poste.idActeurResponsable != null ? poste.idActeurResponsable : "");
mp.put("nomActeurResponsable", poste.nomActeurResponsable != null ? poste.nomActeurResponsable : "");
mp.put("categorieActeurResponsable", poste.categorieActeurResponsable != null ? poste.categorieActeurResponsable : "");
mp.put("typeAnnexeActeurResponsable", poste.typeAnnexeActeurResponsable != null ? poste.typeAnnexeActeurResponsable : "");
if (poste.regleAiguillage != null) {
    java.util.Map<String,Object> ra = new java.util.LinkedHashMap<String,Object>();
    ra.put("typeControle", poste.regleAiguillage.typeControle);
    ra.put("tauxTrue", poste.regleAiguillage.tauxTrue);
    ra.put("idCibleEchec", poste.regleAiguillage.idCibleEchec != null ? poste.regleAiguillage.idCibleEchec : "");
    mp.put("regleAiguillage", ra);
} else {
    mp.put("regleAiguillage", null);
}
mp.put("niveauISA95", poste.niveauISA95 != null ? poste.niveauISA95 : "");
mp.put("politiqueStock", poste.politiqueStock != null ? poste.politiqueStock : "");
mp.put("tauxVA", poste.tauxVA);
mp.put("coutHoraireMainOeuvre", poste.coutHoraireMainOeuvre);
mp.put("coutMatierePremiereParUnite", poste.coutMatierePremiereParUnite);
mp.put("valeurActifFixe", poste.valeurActifFixe);
mp.put("idsResponsabilites", poste.idsResponsabilites != null ? new java.util.ArrayList<String>(poste.idsResponsabilites) : new java.util.ArrayList<String>());
mp.put("idsOperationalAgents", poste.idsOperationalAgents != null ? new java.util.ArrayList<String>(poste.idsOperationalAgents) : new java.util.ArrayList<String>());
mp.put("idsMachines", poste.idsMachines != null ? new java.util.ArrayList<String>(poste.idsMachines) : new java.util.ArrayList<String>());
mp.put("genereAutonome", poste.genereAutonome);
mp.put("politiqueApproPoste", poste.politiqueApproPoste != null ? poste.politiqueApproPoste : "");
mp.put("intervalleApproPoste", poste.intervalleApproPoste);
mp.put("tauxArriveePoissonPoste", poste.tauxArriveePoissonPoste);
mp.put("quantiteParApproPoste", poste.quantiteParApproPoste);
mp.put("tailleLot", poste.tailleLot);
mp.put("attendTousLesPredecesseurs", poste.attendTousLesPredecesseurs);
mp.put("positionManuelle", poste.positionManuelle);
mp.put("xManuel", poste.xManuel);
mp.put("yManuel", poste.yManuel);
mp.put("estPointEclatement", poste.estPointEclatement);
mp.put("nbProduitsParLot", poste.nbProduitsParLot);
mp.put("mtbfHeures", poste.mtbfHeures);
mp.put("mttrHeures", poste.mttrHeures);
mp.put("consommeMatiere", poste.consommeMatiere);
return mp;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.util.Map<String,Object>]]></ReturnType>
					<Id>1782600000013</Id>
					<Name><![CDATA[scenarioToJson]]></Name>
					<X>-300</X><Y>890</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[scenario]]></Name>
						<Type><![CDATA[ScenarioFlux]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.Map<String,Object> mp = new java.util.LinkedHashMap<String,Object>();
mp.put("typeProduit", scenario.typeProduit);
mp.put("sequence", scenario.sequence != null ? new java.util.ArrayList<String>(scenario.sequence) : new java.util.ArrayList<String>());
mp.put("debitParHeure", scenario.debitParHeure);
mp.put("debitParHeureBase", scenario.debitParHeureBase);
java.util.List<Object> lstNomenc = new java.util.ArrayList<Object>();
for (LigneNomenclature l : scenario.nomenclature) {
    java.util.Map<String,Object> ln = new java.util.LinkedHashMap<String,Object>();
    ln.put("idMatiere", l.idMatiere);
    ln.put("quantiteParUnite", l.quantiteParUnite);
    lstNomenc.add(ln);
}
mp.put("nomenclature", lstNomenc);
return mp;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ScenarioFlux]]></ReturnType>
					<Id>1782600000014</Id>
					<Name><![CDATA[scenarioFromJson]]></Name>
					<X>-300</X><Y>900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[jmap]]></Name>
						<Type><![CDATA[java.util.Map]]></Type>
					</Parameter>
					<Body><![CDATA[String produit  = jsonString(jmap, "typeProduit", "");
double debit    = jsonDouble(jmap, "debitParHeure", 0.0);
ScenarioFlux sc = new ScenarioFlux(produit, debit);
sc.debitParHeureBase = jsonDouble(jmap, "debitParHeureBase", debit);
sc.sequence = jsonStringList(jmap, "sequence");

Object nomObj = jmap.get("nomenclature");
if (nomObj instanceof java.util.List) {
    for (Object no : (java.util.List) nomObj) {
        if (no instanceof java.util.Map) {
            java.util.Map nm = (java.util.Map) no;
            sc.nomenclature.add(new LigneNomenclature(
                jsonString(nm, "idMatiere", ""),
                jsonDouble(nm, "quantiteParUnite", 1.0)
            ));
        }
    }
}
return sc;]]></Body>
				</Function>
