				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.util.ArrayList<PosteGenericAgent>]]></ReturnType>
					<Id>1782342260500</Id>
					<Name><![CDATA[getPostesParCodeSCOR]]></Name>
					<X>-440</X><Y>4550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.ArrayList<PosteGenericAgent> resultat = new java.util.ArrayList<PosteGenericAgent>();
if (codeSCOR == null || codeSCOR.isEmpty()) return resultat;
for (PosteGenericAgent p : postes) {
   if (codeSCOR.equalsIgnoreCase(p.codeSCOR)) {
            resultat.add(p);
        }
    }
return resultat;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782342260503</Id>
					<Name><![CDATA[extraireCodeSCORDepuisNomMovable]]></Name>
					<X>-440</X><Y>4580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nomMovable]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (nomMovable == null || nomMovable.isEmpty()) return "";
    int idxTiret = nomMovable.indexOf('-');
    if (idxTiret < 0 || idxTiret + 1 >= nomMovable.length()) return "";
    String suffixe = nomMovable.substring(idxTiret + 1); // ex: "sS1.3" ou "sP4"
    if (suffixe.startsWith("s") || suffixe.startsWith("S")) {
        suffixe = suffixe.substring(1); // retire le prefixe "s" -> "S1.3" ou "P4"
    }
return suffixe;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782342260505</Id>
					<Name><![CDATA[rapportPostesParCodeSCOR]]></Name>
					<X>-440</X><Y>4610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.ArrayList<PosteGenericAgent> liste = getPostesParCodeSCOR(codeSCOR);

    StringBuilder sb = new StringBuilder();
    sb.append("Activité SCOR N3 : ").append(codeSCOR.isEmpty() ? "?" : codeSCOR).append("\n");
    sb.append("Postes configurés à ce niveau : ").append(liste.size()).append("\n");

    if (liste.isEmpty()) {
        sb.append("\n(aucune micro-activité configurée pour ce code)");
        return sb.toString();
    }

    sb.append("\nDétail :\n");
    for (PosteGenericAgent p : liste) {
        sb.append("- ").append(p.idPoste)
          .append(" — ").append(p.nom)
          .append(" | Type: ").append(p.typePoste)
          .append(" | Acteur: ").append(p.nomActeurResponsable.isEmpty() ? "—" : p.nomActeurResponsable)
          .append("\n");
    }

return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782410895744</Id>
					<Name><![CDATA[function]]></Name>
					<X>-340</X><Y>6060</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1782925056092</Id>
					<Name><![CDATA[listerScenariosJsonDisponibles]]></Name>
					<X>-300</X><Y>2450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Scanne le repertoire courant (le meme repertoire ou sauverScenarioJSON()
// ecrit ses fichiers, via FileOutputStream avec chemin relatif) et retourne
// la liste des fichiers "scenario_*.json" trouves, tries par ordre alphabetique.
// N'affecte aucun etat de simulation : lecture seule du systeme de fichiers.
try {
    java.io.File dossier = new java.io.File(".");
    java.io.File[] fichiers = dossier.listFiles(new java.io.FilenameFilter() {
        public boolean accept(java.io.File dir, String name) {
            return name.startsWith("scenario_") && name.toLowerCase().endsWith(".json");
        }
    });

    if (fichiers == null || fichiers.length == 0) {
        return new String[] { "(aucun scenario JSON trouve dans le repertoire courant)" };
    }

    java.util.Arrays.sort(fichiers, new java.util.Comparator<java.io.File>() {
        public int compare(java.io.File a, java.io.File b) {
            return a.getName().compareToIgnoreCase(b.getName());
        }
    });

    String[] noms = new String[fichiers.length];
    for (int i = 0; i < fichiers.length; i++) noms[i] = fichiers[i].getName();
    return noms;

} catch (Exception ex) {
    return new String[] { "(erreur de lecture du repertoire : " + ex.getMessage() + ")" };
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782925141251</Id>
					<Name><![CDATA[chargerScenarioJSONDepuisSelection]]></Name>
					<X>-299</X><Y>2474</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Charge le fichier JSON explicitement choisi dans la liste deroulante,
// au lieu du fichier recalcule depuis nomEntreprise courant. Permet de
// charger un scenario SANS avoir a deviner ou retaper son nom exact au
// prealable -- c'est tout le sens de ce selecteur.
if (champScenarioJsonSelectionne == null || champScenarioJsonSelectionne.trim().isEmpty()
    || champScenarioJsonSelectionne.startsWith("(aucun")
    || champScenarioJsonSelectionne.startsWith("(erreur")) {
    getExperimentHost().showMessageDialog(
        "⚠️ Aucun scénario sélectionné\n\n" +
        "Cliquez sur \"Rafraîchir la liste\" puis choisissez un fichier dans la liste.");
    return;
}

if (modeExecution) {
    getExperimentHost().showMessageDialog(
        "⚠️ Impossible de charger : la simulation est en cours.\n" +
        "Arrêtez la simulation d'abord (bouton Arrêter).");
    return;
}

// Le nom de fichier selectionne contient deja "scenario_XXX.json".
// On en deduit nomEntreprise pour rester coherent avec scenarioJsonFileName(),
// puis on delegue a chargerScenarioJSON() qui fait tout le travail reel
// (nettoyage, parsing, reconstruction) -- pas de logique dupliquee.
String fichierChoisi = champScenarioJsonSelectionne.trim();
String base = fichierChoisi;
if (base.startsWith("scenario_")) base = base.substring("scenario_".length());
if (base.toLowerCase().endsWith(".json")) base = base.substring(0, base.length() - 5);

nomEntreprise = base;
chargerScenarioJSON();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1783531546879</Id>
					<Name><![CDATA[listeMatieresConnues]]></Name>
					<X>1660</X><Y>-60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Nom : listeMatieresConnues   (retourne String[])
java.util.LinkedHashSet<String> noms = new java.util.LinkedHashSet<String>();
for (FicheMatiere f : fichesMatiere) noms.add(f.idMatiere);
for (ScenarioFlux sc : scenarios) {
    for (LigneNomenclature l : sc.nomenclature) noms.add(l.idMatiere);
}
if (noms.isEmpty()) return new String[] { "" };
return noms.toArray(new String[0]);]]></Body>
