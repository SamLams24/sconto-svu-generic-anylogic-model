					<Id>1901000000000</Id>
					<Name><![CDATA[piTraceabilityColumns]]></Name>
					<X>2250</X><Y>-150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Niveau", "Attribut", "Étape", "Code", "Libellé", "Valeur réelle", "Unité",
    "Bottom -> Perfect", "Score /10", "Grades flous A..F", "Poids",
    "Contribution fuzzy", "Score agrégé /10", "Source / preuve", "Validation"
};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1901000000001</Id>
					<Name><![CDATA[piTraceabilityRows]]></Name>
					<X>2250</X><Y>-120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.ArrayList<Object[]> rows=new java.util.ArrayList<Object[]>();
if(strategic==null)return emptyRows("StrategicAgent indisponible",piTraceabilityColumns().length);
double pi=strategic.calculerPIGlobal(); strategic.piGlobalCourant=pi;
String[] attrs={"RL","RS","AG","CO","AM"};
String[] noms={"Reliability","Responsiveness","Agility","Cost","Asset Management"};
double[] poids={strategic.w_RL,strategic.w_RS,strategic.w_AG,strategic.w_CO,strategic.w_AM};
FuzzyGradeSet[] attrGrades=new FuzzyGradeSet[5];
for(int i=0;i<5;i++) attrGrades[i]=FuzzyGradeSet.agregerMetriques(strategic.detailN3.get(attrs[i]));
FuzzyGradeSet global=FuzzyGradeSet.agregerGrades(attrGrades,poids);
rows.add(new Object[]{"GLOBAL","Tous","Défuzzification finale","PI_GLOBAL","Performance Index",fmt3(pi),"score 0..10","-",fmt3(pi),global.compact(),"1.000",global.compact(),fmt3(pi),"Theeranuphattana/Chan-Qi adapté","SELFTEST référence 4.050 disponible"});
initialiserProfilsNormalisationDefaut();
for(int i=0;i<5;i++){
    double sAttr=attrGrades[i].defuzzifier();
    rows.add(new Object[]{"ATTRIBUT",attrs[i],"Agrégation fuzzy pondérée",attrs[i],noms[i],fmt3(sAttr),"score 0..10","-",fmt3(sAttr),attrGrades[i].compact(),fmt3(poids[i]),attrGrades[i].ponderer(poids[i]).compact(),fmt3(sAttr),"Métriques contributives runtime","Poids configuré; AHP stratégique non utilisé pour PI"});
    java.util.ArrayList<MetriqueN3> lst=strategic.detailN3.get(attrs[i]); if(lst==null)continue;
    for(MetriqueN3 m:lst){ if(m==null)continue; String code=m.codeOfficielSCOR==null?"":m.codeOfficielSCOR.trim();
        NormalizationProfile np=normalizationProfiles.get(code.toUpperCase(java.util.Locale.ROOT));
        String scale=np==null?"NON CALIBRE":fmt3(np.bottom())+" -> "+fmt3(np.perfect());
        String source=code.isEmpty()?"Indicateur interne VSM":sourceFormuleMetriqueSCOR(code);
        String validation=m.poids>0?(np==null?"CONTRIBUTIF MAIS ECHELLE A CALIBRER":"CONTRIBUTIF"):"INFORMATIF HORS PI";
        rows.add(new Object[]{"METRIQUE",attrs[i],"Raw -> score -> fuzzy",code.isEmpty()?"INTERNE":code,m.nom,fmt3(m.valeurBrute),m.unite,scale,fmt3(m.score10),m.fuzzyGrades.compact(),fmt3(m.poids),m.fuzzyGrades.ponderer(m.poids).compact(),fmt3(sAttr),source,validation});
    }
}
return rows.toArray(new Object[0][]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
