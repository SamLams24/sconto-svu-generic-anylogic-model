				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781971000002</Id>
					<Name><![CDATA[decisionsHoloniquesRows]]></Name>
					<X>-440</X><Y>4490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Table volontairement filtree : elle garde les decisions significatives
// et masque les etats IDLE repetitifs qui relèvent du debug technique.
java.util.ArrayList<Object[]> lignes = new java.util.ArrayList<Object[]>();
java.util.HashSet<String> dejaVus = new java.util.HashSet<String>();

if (board.logEvenements != null) {
    for (String evt : board.logEvenements) {
        if (evt.contains("[AER-AUDIT]")) continue;
        if (!(evt.contains("HOLON") || evt.contains("AER") || evt.contains("CONFIG")
            || evt.contains("STRATEGIC") || evt.contains("GOULOT"))) continue;

        // Filtrage lisibilite : les etats operationnels IDLE cycliques ne sont
        // pas des decisions. Ils restent dans le journal technique mais pas ici.
        if (evt.contains("HOLON-OP") && (evt.contains("-> IDLE") || evt.contains("→ IDLE") || evt.contains("etat=IDLE"))) continue;

        String cle = evt;
        int idxApresTemps = cle.indexOf("] ");
        if (idxApresTemps >= 0) cle = cle.substring(idxApresTemps + 2);
        // On evite d'afficher 40 fois la meme decision MAINTENIR identique.
        if (cle.contains("MAINTENIR")) {
            int idxPi = cle.indexOf("PI=");
            if (idxPi >= 0) cle = "MAINTENIR|" + cle.substring(idxPi, Math.min(cle.length(), idxPi + 20));
        }
        // Les escalades de goulot peuvent apparaître à chaque tick. On conserve
        // une seule ligne par processus/goulot et on laisse le journal technique
        // garder le détail de persistance.
        if (cle.contains("GOULOT_ESCALADE") || cle.contains("persistance=")) {
            String tmp = cle;
            int idxPersist = tmp.indexOf("persistance=");
            if (idxPersist >= 0) tmp = tmp.substring(0, idxPersist);
            int idxCycle = tmp.indexOf("Cycle AHP");
            if (idxCycle >= 0) tmp = tmp.substring(0, idxCycle);
            cle = "GOULOT_SYNTHETIQUE|" + tmp.replaceAll("\\s+", " ").trim();
        }
        if (dejaVus.contains(cle)) continue;
        dejaVus.add(cle);

        String tempsExtrait = "-";
        String niveau = "AUTRE";
        int idxT = evt.indexOf("[T=");
        if (idxT >= 0) {
            int idxFin = evt.indexOf("]", idxT);
            if (idxFin > idxT) tempsExtrait = evt.substring(idxT + 3, idxFin);
        }

        if (evt.contains("HOLON-OP"))     niveau = "Operationnel";
        else if (evt.contains("HOLON-TAC"))  niveau = "Tactique";
        else if (evt.contains("HOLON-SUP"))  niveau = "Supervision";
        else if (evt.contains("HOLON-STRAT")) niveau = "Strategique";
        else if (evt.contains("STRATEGIC"))  niveau = "Strategique";
        else if (evt.contains("GOULOT"))     niveau = "Alerte goulot";
        else if (evt.contains("CONFIG"))     niveau = "Configuration";
        else if (evt.contains("AER"))        niveau = "Message AER";

        lignes.add(new Object[] { tempsExtrait, niveau, evt });
    }
}

if (lignes.size() > 60) {
    lignes = new java.util.ArrayList<Object[]>(lignes.subList(lignes.size() - 60, lignes.size()));
}

if (lignes.isEmpty()) {
    return emptyRows("Aucune décision holonique significative enregistrée", decisionsHoloniquesColumns().length);
}

return lignes.toArray(new Object[0][]);]]></Body>
				</Function>
