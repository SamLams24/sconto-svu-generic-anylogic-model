		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1781200000001</Id>
			<Name><![CDATA[CoordinatorAgent]]></Name>
			<AdditionalClassCode><![CDATA[String idAgentCoordinateur = "";
String strategieRealisation = "";
String roleHolonique = "AGENT_COORDINATEUR";

// ============================================================
// BOITE HIERARCHIQUE GENERATION 2
// ============================================================
java.util.ArrayList<AERMessage> boiteMessagesHierarchiques = new java.util.ArrayList<AERMessage>();
int nbMessagesHierarchiquesRecus = 0;
String dernierMessageHierarchique = "";

void recevoirMessageHierarchique(AERMessage msg) {
    if (msg == null) return;
    boiteMessagesHierarchiques.add(msg);
    if (boiteMessagesHierarchiques.size() > 100) boiteMessagesHierarchiques.remove(0);
    nbMessagesHierarchiquesRecus++;
    dernierMessageHierarchique = msg.toString();
}
]]></AdditionalClassCode>
