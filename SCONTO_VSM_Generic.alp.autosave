				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1801000000002</Id>
					<Name><![CDATA[catalogueMetriquesAHPRaw]]></Name>
					<X>-440</X><Y>4630</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return "1|AG.3.2|% of labor used in manufacturing, not used in direct activity|% de main-d’œuvre Make non utilisée en activité directe|3|AGILITY|1.93\n"
    + "2|AG.3.38|Current Make Volume (Amount of each item which are manufactured)|Volume Make courant (quantité fabriquée par article)|3|AGILITY|1.93\n"
    + "3|AG.3.1|% of labor used in logistics, not used in direct activity|% de main-d’œuvre logistique non utilisée en activité directe|3|AGILITY|1.93\n"
    + "4|AG.3.32|Current Delivery Volume (Number of orders shipped)|Volume de livraison courant (nombre de commandes expédiées)|3|AGILITY|1.93\n"
    + "5|RL.3.33|Delivery Item Accuracy|Exactitude des articles livrés|3|RELIABILITY|0.93\n"
    + "6|RL.3.35|Delivery Quantity Accuracy|Exactitude des quantités livrées|3|RELIABILITY|0.93\n"
    + "7|RL.3.32|Customer Commit Date Achievement Time|Respect de la date promise au client|3|RELIABILITY|0.93\n"
    + "8|RL.3.34|Delivery Location Accuracy|Exactitude du lieu de livraison|3|RELIABILITY|0.93\n"
    + "9|RL.3.31|Compliance Documentation Accuracy|Exactitude de la documentation de conformité|3|RELIABILITY|0.93\n"
    + "10|RL.3.43|Other Required Documentation Accuracy|Exactitude des autres documents requis|3|RELIABILITY|0.93\n"
    + "11|RL.3.45|Payment Documentation Accuracy|Exactitude des documents de paiement|3|RELIABILITY|0.93\n"
    + "12|RL.3.50|Shipping Documentation Accuracy|Exactitude des documents d’expédition|3|RELIABILITY|0.93\n"
    + "13|RL.3.12|% of Faultless Installations|% d’installations sans défaut|3|RELIABILITY|0.93\n"
    + "14|RL.3.24|% Orders/lines received damage free|% de commandes/lignes reçues sans dommage|3|RELIABILITY|0.93\n"
    + "15|RL.3.41|Orders Delivered Damage Free Conformance|Conformité des commandes livrées sans dommage|3|RELIABILITY|0.93\n"
    + "16|RL.3.42|Orders Delivered Defect Free Conformance|Conformité des commandes livrées sans défaut|3|RELIABILITY|0.93\n"
    + "17|RL.3.55|Warranty and Returns|Garantie et retours|3|RELIABILITY|0.93\n"
    + "18|RL.2.1|% of Orders Delivered in Full|% de commandes livrées complètes|2|RELIABILITY|0.87\n"
    + "19|RL.2.2|Delivery Performance to Customer Commit Date|Performance de livraison à la date promise client|2|RELIABILITY|0.87\n"
    + "20|RL.2.3|Documentation Accuracy|Exactitude documentaire|2|RELIABILITY|0.87\n"
    + "21|RL.2.4|Perfect Condition|Condition parfaite|2|RELIABILITY|0.87\n"
    + "22|RS.2.1|Source Cycle Time|Temps de cycle Source|2|RESPONSIVENESS|0.85\n"
