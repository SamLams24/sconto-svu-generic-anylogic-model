					<X>-440</X><Y>4190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[KPIBundle g = board.kpiGlobal;

Object[][] rows = new Object[1][dashboardGlobalColumns().length];

rows[0][0] = "Ensemble du systeme";
rows[0][1] = String.valueOf(g.count);
rows[0][2] = fmt2(g.avgCycleTime());
rows[0][3] = fmt2(g.avgWaitTime());
rows[0][4] = fmt2(g.avgLeadTime());
rows[0][5] = fmt1(g.pce() * 100);
rows[0][6] = String.valueOf(board.totalRebuts);
rows[0][7] = String.valueOf(board.totalRework);

return rows;]]></Body>
