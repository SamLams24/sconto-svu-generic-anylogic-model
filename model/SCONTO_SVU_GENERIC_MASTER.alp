					<Parameters>
						<Parameter>
							<Name><![CDATA[type]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[delayTime]]></Name>
							<Value Class="CodeUnitValue">
								<Code><![CDATA[((Main) getOwner()).estFluxVisuelSeulement(agent)
    ? (codeSCOR != null && codeSCOR.startsWith("M1")
        ? dureeTraitement()
        : ((Main) getOwner()).dureeEchelle(dureeTraitement()))
    : dureeTraitement()]]></Code>
								<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[capacity]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[enPanne ? 0 : capaciteSimultanee]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[maximumCapacity]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[entityLocation]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[pushProtocol]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[restoreEntityLocationOnExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[agent.tDebutAttente = time();]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[double ct = time() - agent.tDebutAttente;
// VAT reel = part du temps de cycle declaree comme valeur ajoutee pour ce poste
// (tauxVA est un parametre explicite, par defaut 1.0 = comportement historique)
double vatReel = ct * Math.max(0.0, Math.min(1.0, tauxVA));
agent.sommeVAT += vatReel;

Main main = (Main) getOwner();

if (main.estFluxVisuelSeulement(agent)) {
    // Flux visuel de synchronisation : il traverse le poste pour activer les compteurs natifs de la vue globale,
    // mais les KPI/exports sont déjà alimentés par enregistrerTraceExecutionCommande().
    try { main.board.logEvent("[VISUEL-FLOW] " + agent.idFlux + " passe par " + idPoste); } catch (Throwable ignored) {}
} else {
main.addTrace(
    "BRUT",
    "OperationalAgent:" + idPoste,
    agent.idFlux,
    idPoste,
    codeSCOR,
    "PROCESS_EXIT",
    "Temps de traitement",
    ct,
    "s",
    "",
    Double.NaN,
    "",
    "Duree de traitement brute du poste courant (temps total passe dans le Delay)"
);

main.addTrace(
    "BRUT",
    "OperationalAgent:" + idPoste,
    agent.idFlux,
    idPoste,
    codeSCOR,
    "PROCESS_EXIT",
    "Temps d’attente",
    agent.dernierWait,
    "s",
    "",
    Double.NaN,
    "",
    "Temps d'attente brut avant traitement (file precedente)"
);

main.addTrace(
    "BRUT",
    "OperationalAgent:" + idPoste,
    agent.idFlux,
    idPoste,
    codeSCOR,
    "PROCESS_EXIT",
    "Temps utile",
    vatReel,
    "s",
    "",
    tauxVA,
    "Temps de traitement x taux de valeur ajoutée",
    "Temps a valeur ajoutee estime, selon le taux declare pour ce poste (" + String.format("%.0f", tauxVA * 100) + "% du temps de traitement)"
);

main.board.notifierPassage(idPoste, main.cleKPI(this), ct, agent.dernierWait, vatReel, Math.max(1.0, agent.quantiteTransportee));
}]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onRemove]]></Name>
						</Parameter>
