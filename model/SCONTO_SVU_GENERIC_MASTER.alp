				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1901000000005</Id>
					<Name><![CDATA[nonRegressionRows]]></Name>
					<X>2250</X><Y>0</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.ArrayList<Object[]> rows=new java.util.ArrayList<Object[]>();
long nSource=0,nMake=0,nDeliver=0;
try{KPIBundle k=board.kpiParMacro.get("sS");if(k!=null)nSource=k.count;}catch(Throwable ignored){}
try{KPIBundle k=board.kpiParMacro.get("sM");if(k!=null)nMake=k.count;}catch(Throwable ignored){}
try{KPIBundle k=board.kpiParMacro.get("sD");if(k!=null)nDeliver=k.count;}catch(Throwable ignored){}
int nbClients = nombreCommandesClientes();
int nbOrdresStock = nombreOrdresStockAutonomes();
String natureRun = nbClients <= 0
    ? (nbOrdresStock > 0 ? "ORDRES STOCK AUTONOMES" : "AUCUNE COMMANDE CLIENT")
    : (nbOrdresStock > 0 ? "CLIENT + REAPPRO AUTONOME" : "COMMANDES CLIENTES SEULES");
double pi=strategic!=null?strategic.calculerPIGlobal():0.0;
rows.add(new Object[]{"Campagne fonctionnelle","A REVALIDER SUR BASE CONSOLIDEE","Les anciens Cas 1/2/3 ne sont plus déduits des seuls flux macro.","La politique (s,Q) peut lancer Make/Source en arrière-plan indépendamment d'une commande cliente.","Utiliser les runs dédiés et leurs preuves pour chaque scénario."});
rows.add(new Object[]{"Run courant",natureRun,"Clients="+nbClients+" ; ordres stock="+nbOrdresStock+" ; Source="+nSource+" ; Make="+nMake+" ; Deliver="+nDeliver,"Sépare demande client et activité autonome de reconstitution du stock.","Conserver log + Excel + ABox du run final."});
rows.add(new Object[]{"Pipeline performance",pi>=0&&pi<=10?"VALIDÉ":"ANOMALIE","PI="+fmt3(pi)+"/10 ; self-test référence 4.050","Valeur réelle, score, fuzzy, attribut et PI sont séparés.","Calibrer bottom/perfect terrain ultérieurement."});
rows.add(new Object[]{"ABox C14",aboxExportActif?"ACTIVE":"DESACTIVEE","exports="+nbExportsABox+" ; fichier="+dernierFichierABox,"Doit refléter le pipeline final Core 4.3.0.","Soumettre l'ABox générée au validateur C14 puis reasoner."});
rows.add(new Object[]{"ISA-95",isa95Hierarchy.size()==190&&isa95Assignments.size()==71?"VALIDÉ":"A VERIFIER","nœuds="+isa95Hierarchy.size()+" ; affectations="+isa95Assignments.size(),"Structure industrielle C14.3.2 chargée.","Aucune si 190/71."});
rows.add(new Object[]{"Architecture agents","VALIDÉ","C="+supervisorsMacro.size()+" ; P="+agentsSuperviseurs.size()+" ; E="+agentsExecution.size(),"Architecture C11 conservée.","Contrôler le MachineAgent et le Return Source Pilot dans l'ABox."});
rows.add(new Object[]{"Export final synchronisé",nbExportsExcelRealises>0?"ACTIF":"A CONFIRMER","Excel="+excelFileName()+" ; ABox="+dernierFichierABox,"ABox puis Excel au même instant de clôture.","Vérifier la ligne [C14-FINAL] dans le log."});
return rows.toArray(new Object[0][]);]]></Body>
				</Function>
