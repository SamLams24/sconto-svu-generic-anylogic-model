			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781100000040</Id>
					<Name><![CDATA[notifierPassage]]></Name>
					<X>50</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cycleTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[waitTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[vat]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[quantityWeight]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[ if (codeSCOR == null || codeSCOR.isEmpty()) return;

    String microKey = (idPoste != null && !idPoste.isEmpty()) ? idPoste : codeSCOR;

    // 1. Agrégation par micro-activité réelle
    KPIBundle bMicro = kpiParMicroActivite.get(microKey);
    if (bMicro == null) {
        bMicro = new KPIBundle();
        kpiParMicroActivite.put(microKey, bMicro);
    }
    bMicro.addObservation(cycleTime, waitTime, vat, quantityWeight);

    // C14.22 -- kpiZener : agregation REELLE (mesure poste par poste, pas
    // estimee sur la duree totale de commande) restreinte aux micro-activites
    // dont l'acteur responsable est ZENER SA Togo (ACT_4). Sert de base aux
    // cartes Process Time / Waiting Time / PCE du tableau de bord, qui
    // lisaient auparavant kpiGlobal -- alimente uniquement a la cloture de
    // chaque commande, sur la duree totale de bout en bout (fournisseur +
    // ZENER + client confondus), avec un taux de valeur ajoutee force a 65%
    // sur le trajet livraison directe. kpiZener mesure exclusivement le temps
    // reellement passe dans les micro-activites de ZENER, conforme a la
    // pratique VSM standard (perimetre = entreprise focale).
    if (codeSCOR.startsWith("ACT_4|")) {
        kpiZener.addObservation(cycleTime, waitTime, vat, quantityWeight);
    }

    // 2. Agrégation existante par code SCOR N3
    KPIBundle bPoste = kpiParPoste.get(codeSCOR);
    if (bPoste == null) {
        bPoste = new KPIBundle();
        kpiParPoste.put(codeSCOR, bPoste);
    }
    bPoste.addObservation(cycleTime, waitTime, vat, quantityWeight);

    // 3. Agrégation macro SCOR
    // codeSCOR peut etre une clef composite "IDACTEUR|N3" (ex "ACT_4|M1.3"). On
    // extrait le N3 pur, puis on utilise la MEME convention de prefixe macro que
    // celle lue par les TacticalAgent/Coordinateurs (sS/sM/sD/sR via macroPrefixe),
    // sinon la cle serait "M1"/"S1"... et kpiParMacro.get("sM") renverrait toujours
    // null -> couleurs tactiques/coordinateurs figees en vert.
    String n3Pur = codeSCOR.contains("|") ? codeSCOR.substring(codeSCOR.indexOf('|') + 1) : codeSCOR;
    String macro = ((Main) getOwner()).macroPrefixe(n3Pur);
    KPIBundle bMacro = kpiParMacro.get(macro);
    if (bMacro == null) {
        bMacro = new KPIBundle();
        kpiParMacro.put(macro, bMacro);
    }
    bMacro.addObservation(cycleTime, waitTime, vat, quantityWeight);

    // 4. Trace d’agrégation
    Main main = (Main) getOwner();

    main.addTrace(
        "AGG_MICRO",
        "BlackboardAgent",
        "",
        microKey,
        codeSCOR,
        "KPI_UPDATE",
        "Temps de traitement moyen",
        cycleTime,
        "s",
        "MICRO_ACTIVITE",
        bMicro.avgCycleTime(),
        "sum(cycleTime * quantite) / sum(quantite)",
        "Agrégation dynamique par micro-activité"
    );

    main.addTrace(
        "AGG_SCOR",
        "BlackboardAgent",
        "",
        microKey,
        codeSCOR,
        "KPI_UPDATE",
        "Efficacité du cycle",
        vat,
        "ratio",
        "SCOR_N3",
        bPoste.pce() * 100,
        "temps utile / (temps de traitement + temps d’attente)",
        "Agrégation dynamique au niveau SCOR N3"
    );

    // S2.2 C03 : capture contextuelle au moment du passage.
    snapshotWIPContextuel();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781100000041</Id>
					<Name><![CDATA[notifierFin]]></Name>
					<X>50</X><Y>430</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[leadTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[waitTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[vat]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[typeProduit]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[totalTerminees++;
// C14.16 -- le lead time complet d'une commande etait ajoute a sumCycleTime,
// alors que ce champ represente le temps de traitement (valeur ajoutee +
// operations). Comme avgLeadTime() = avgCycleTime() + avgWaitTime(), le lead
// time se retrouvait compte deux fois et les cartes "Process Time" et
// "Lead time moyen" affichaient la meme valeur, faussant aussi le PCE.
// On decompose desormais : la part d'attente va dans sumWaitTime, le reste
// (temps reellement passe en traitement) dans sumCycleTime.
kpiGlobal.count++;
kpiGlobal.sumCycleTime += Math.max(0.0, leadTime - waitTime);
kpiGlobal.sumWaitTime += waitTime;
kpiGlobal.sumVAT += vat;
if (typeProduit != null && typeProduit.toUpperCase().contains("MTO")) {
    nbMTO++;
    sumLeadTimeMTO += leadTime;
} else {
    nbMTS++;
    sumLeadTimeMTS += leadTime;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000022</Id>
					<Name><![CDATA[notifierRebut]]></Name>
					<X>50</X><Y>470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[totalRebuts++;
String n3PurR = (codeSCOR != null && codeSCOR.contains("|")) ? codeSCOR.substring(codeSCOR.indexOf('|') + 1) : codeSCOR;
String macro = ((Main) getOwner()).macroPrefixe(n3PurR);

KPIBundle bp = kpiParPoste.get(codeSCOR);
if (bp == null) { bp = new KPIBundle(); kpiParPoste.put(codeSCOR, bp); }
bp.nbRebut++;

KPIBundle bm = kpiParMacro.get(macro);
if (bm == null) { bm = new KPIBundle(); kpiParMacro.put(macro, bm); }
bm.nbRebut++;

// Correction : faire remonter le rebut aussi sur la cle micro-activite,
// sinon les tableaux "Dashboard Micro-activites" affichent toujours 0 rebuts.
if (idPoste != null && !idPoste.isEmpty()) {
    KPIBundle bMicro = kpiParMicroActivite.get(idPoste);
    if (bMicro == null) { bMicro = new KPIBundle(); kpiParMicroActivite.put(idPoste, bMicro); }
    bMicro.nbRebut++;
}

logEvent("REBUT detecte @ " + (idPoste != null && !idPoste.isEmpty() ? idPoste + " " : "") + "[" + codeSCOR + "]");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781500000023</Id>
					<Name><![CDATA[notifierRework]]></Name>
					<X>50</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[totalRework++;
// idPoste est l'idPoste ; on retrouve la clef composite (acteur,N3) via Main
Main mainRef = (Main) getOwner();
PosteGenericAgent p = mainRef.trouverPoste(idPoste);
if (p != null) {
    String code = mainRef.cleKPI(p);
    String macro = mainRef.macroPrefixe(p.codeSCOR);

    KPIBundle bp = kpiParPoste.get(code);
    if (bp == null) { bp = new KPIBundle(); kpiParPoste.put(code, bp); }
    bp.nbRework++;

    KPIBundle bm = kpiParMacro.get(macro);
    if (bm == null) { bm = new KPIBundle(); kpiParMacro.put(macro, bm); }
    bm.nbRework++;
}

// Correction : faire remonter le rework aussi sur la cle micro-activite
KPIBundle bMicro = kpiParMicroActivite.get(idPoste);
if (bMicro == null) { bMicro = new KPIBundle(); kpiParMicroActivite.put(idPoste, bMicro); }
bMicro.nbRework++;

logEvent("REWORK @ " + idPoste);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781100000042</Id>
					<Name><![CDATA[avgWIP]]></Name>
					<X>50</X><Y>490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (wipSnapshots.isEmpty()) return 0;
double sum = 0;
for (double v : wipSnapshots) sum += v;
return sum / wipSnapshots.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781100000043</Id>
					<Name><![CDATA[logEvent]]></Name>
					<X>50</X><Y>550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[message]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String entry = String.format("[T=%.1f] %s", time(), message);
logEvenements.add(entry);
if (logEvenements.size() > 200) logEvenements.remove(0);
traceln(entry);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1781100000044</Id>
					<Name><![CDATA[reset]]></Name>
					<X>250</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[kpiParPoste.clear(); kpiParMacro.clear();
kpiGlobal = new KPIBundle(); kpiZener = new KPIBundle(); wipSnapshots.clear(); wipSnapshotsParBuffer.clear(); logEvenements.clear();
totalTerminees = 0; totalRebuts = 0; totalRework = 0;
nbMTS = 0; nbMTO = 0; sumLeadTimeMTS = 0; sumLeadTimeMTO = 0;

kpiParMicroActivite.clear();

alertesPubliees.clear();
journalAER.clear();
alertesParPoste.clear();
historiqueGoulots.clear();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782074126999</Id>
					<Name><![CDATA[publierAlerte]]></Name>
					<X>250</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[msg]]></Name>
						<Type><![CDATA[AERMessage]]></Type>
					</Parameter>
					<Body><![CDATA[if (msg == null) return;

alertesPubliees.add(msg);

if (alertesPubliees.size() > 200) {
  alertesPubliees.remove(0);
}

journaliserAER(
    "BLACKBOARD_PUBLICATION",
    msg,
    "Message stocké dans le tableau noir ; alertes en attente=" + alertesPubliees.size()
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1801000000200</Id>
					<Name><![CDATA[journaliserAER]]></Name>
					<X>250</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[etape]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[msg]]></Name>
						<Type><![CDATA[AERMessage]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[details]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (msg == null) return;

String e = (etape == null || etape.trim().isEmpty()) ? "AER" : etape.trim();
String d = (details == null) ? "" : details;
d = d.replace("\t", " ").replace("\n", " ");

String ligne =
    String.format("%.1f", time()) + "\t"
    + e + "\t"
    + (msg.type == null ? "" : msg.type) + "\t"
    + (msg.emetteur == null ? "" : msg.emetteur) + "\t"
    + (msg.destinataire == null ? "" : msg.destinataire) + "\t"
    + (msg.sujet == null ? "" : msg.sujet) + "\t"
    + (msg.contenu == null ? "" : msg.contenu.replace("\t", " ").replace("\n", " ")) + "\t"
    + d;

journalAER.add(ligne);
if (journalAER.size() > 500) {
    journalAER.remove(0);
}

// Log technique bref : la feuille Excel lit journalAER, pas ce texte.
// C14.13 -- log [AER-AUDIT] desactive : il produisait plusieurs lignes par
// message AER, saturant la console. Les donnees restent integralement
// disponibles dans journalAER (lu par l'export Excel), donc rien n'est perdu.]]></Body>
				</Function>
			</Functions>
