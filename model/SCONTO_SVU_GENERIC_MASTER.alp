        "N/A",
        "N/A",
        "N/A",
        "N/A",
        String.valueOf(board.totalRebuts),
        String.valueOf(board.totalRework)
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    return sb.toString();]]></Body>
