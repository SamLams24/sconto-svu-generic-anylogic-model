						<Link>champQuantiteNomenclature</Link>
					</ExtendedProperties>
				</Control>
				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1799700000317</Id>
					<Name><![CDATA[btnAjouterLigneNomenclature]]></Name>
					<X>1700</X><Y>300</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="230" Height="28">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[if (champNomProduitNomenclature == null || champNomProduitNomenclature.trim().isEmpty()
    || champNomMatiereNomenclature == null || champNomMatiereNomenclature.trim().isEmpty()) {
    getExperimentHost().showMessageDialog("⚠️ Veuillez renseigner le produit et la matière.");
} else {
    boolean ok = ajouterLigneNomenclature(champNomProduitNomenclature, champNomMatiereNomenclature, champQuantiteNomenclature);
    if (ok) {
        getExperimentHost().showMessageDialog("✅ Ligne de nomenclature enregistrée :\n"
            + champNomMatiereNomenclature + " x " + champQuantiteNomenclature + " pour 1 unité de " + champNomProduitNomenclature);
    } else {
        getExperimentHost().showMessageDialog("❌ Produit introuvable : \"" + champNomProduitNomenclature
            + "\"\n\nCréez d'abord ce scénario/produit dans la vue Configuration.");
    }
}]]></ActionCode>
