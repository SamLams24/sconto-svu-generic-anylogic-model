					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Perimetre",
    "Nombre de commandes clientes closes",
    "Order Processing Time (secondes)",
    "Order Waiting / Dwell Time (secondes)",
    "Order Fulfillment Lead Time (secondes)",
    "ZENER Process Time (secondes)",
    "ZENER Waiting Time (secondes)",
    "ZENER Estimated PCE (%)",
    "Source de la valeur ajoutee ZENER",
    "Total des rebuts (toute la simulation)",
    "Total des reprises/rework (toute la simulation)",
    "Métriques SCOR / performance intégrées",
    "Synthèse des valeurs mesurées",
    "PI global courant",
    "Traçabilité PI",
    "Retard fournisseur force actif",
    "Délai fournisseur nominal moyen (h)",
    "Délai fournisseur effectif configure moyen (h)",
    "Approvisionnements retardes / retard cumule (h)",
    "Derniere perturbation fournisseur"
};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781968000006</Id>
					<Name><![CDATA[dashboardGlobalRows]]></Name>
					<X>-440</X><Y>4190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[KPIBundle g = board.kpiGlobal;

Object[][] rows = new Object[1][dashboardGlobalColumns().length];

rows[0][0] = "Commande cliente et VSM ZENER, perimetres distincts";
rows[0][1] = String.valueOf(g.count);
rows[0][2] = fmt2(orderProcessingTimeGlobal());
rows[0][3] = fmt2(orderWaitingTimeGlobal());
rows[0][4] = fmt2(orderFulfillmentLeadTimeGlobal());
rows[0][5] = fmt2(board.kpiZener.avgCycleTime());
rows[0][6] = fmt2(board.kpiZener.avgWaitTime());
rows[0][7] = fmt1(board.kpiZener.pce() * 100);
rows[0][8] = resumeSourceVAZener();
rows[0][9] = String.valueOf(board.totalRebuts);
rows[0][10] = String.valueOf(board.totalRework);
rows[0][11] = resumeMetriquesSCORGlobales(false);
rows[0][12] = resumeMetriquesSCORGlobales(true);
rows[0][13] = fmt3(strategic != null ? strategic.calculerPIGlobal() : 0.0);
rows[0][14] = "Voir feuille Traçabilité performance : VSM -> valeur SCOR réelle -> bottom/perfect -> score /10 -> fuzzy -> attribut -> PI";
rows[0][15] = retardFournisseurTestActif ? "OUI" : "NON";
rows[0][16] = fmt2(delaiFournisseurMoyenHeures());
rows[0][17] = fmt2(delaiFournisseurEffectifMoyenHeures());
rows[0][18] = nbApprovisionnementsRetardes + " / " + fmt2(cumulRetardFournisseurHeures);
rows[0][19] = derniereMatiereRetardee.isEmpty() ? "Aucune" : (derniereMatiereRetardee + " | " + dernierFournisseurRetarde + " | retard=" + fmt2(dernierRetardFournisseurHeures) + " h | commandes ouvertes=" + dernierNbCommandesImpacteesRetardFournisseur);

return rows;]]></Body>
				</Function>
