					<Name><![CDATA[kpiParPosteColumns]]></Name>
					<X>-440</X><Y>3740</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Identifiant du poste",
    "Nom de la micro-activite",
    "Code SCOR (niveau 3)",
    "Nombre d'entites traitees (echantillon)",
    "Temps de cycle moyen (secondes)",
    "Temps d'attente moyen avant traitement (secondes)",
    "Entites actuellement en file d'attente",
    "PCE estime (%) : temps VA estime / delai observe",
    "Taux VA",
    "VA_SOURCE",
    "Métriques SCOR / performance calculables liées",
    "Valeurs mesurées des métriques liées"
};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781965000002</Id>
					<Name><![CDATA[kpiParPosteRows]]></Name>
					<X>-440</X><Y>3770</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (postes == null || postes.isEmpty()) {
    return emptyRows("Aucun poste configuré", kpiParPosteColumns().length);
}

Object[][] rows = new Object[postes.size()][kpiParPosteColumns().length];

for (int i = 0; i < postes.size(); i++) {
    PosteGenericAgent p = postes.get(i);

    // Lecture systematique par idPoste (granularite la plus fine, alimentee
    // a chaque passage par notifierPassage()). Le fallback sur kpiParPoste
    // (code SCOR, qui agrege TOUS les postes partageant ce code) ne sert
    // que si aucune entite n'est encore jamais passee par ce poste precis.
    KPIBundle k = null;
    if (board.kpiParMicroActivite != null) {
        k = board.kpiParMicroActivite.get(p.idPoste);
    }
    if (k == null) {
        k = board.kpiParPoste.get(cleKPI(p));
    }

    long n = k != null ? k.count : 0;
    double ct = k != null ? k.avgCycleTime() : 0;
    double wt = k != null ? k.avgWaitTime() : 0;
    double pce = k != null ? k.pce() * 100 : 0;

    int file = 0;
    try {
        file = p.queue.size();
    } catch (Exception ex) {
        file = 0;
    }

    rows[i][0] = p.idPoste;
    rows[i][1] = p.nom;
    rows[i][2] = p.codeSCOR;
    rows[i][3] = String.valueOf(n);
    rows[i][4] = fmt2(ct);
    rows[i][5] = fmt2(wt);
    rows[i][6] = String.valueOf(file);
    rows[i][7] = fmt1(pce);
    rows[i][8] = fmt3(tauxValeurAjouteeTrace(p, p.codeSCOR));
    rows[i][9] = sourceValeurAjoutee(p);
    rows[i][10] = metriquesSCORLieesAuPoste(p.codeSCOR, false);
    rows[i][11] = metriquesSCORLieesAuPoste(p.codeSCOR, true);
}

return rows;]]></Body>
				</Function>
