void enregistrerTraceDeliverApresProduction(CommandeAgent cmd) {
    if (cmd == null) return;

    // Après production, Deliver ne doit pas être sauté. On enregistre la chaîne Deliver
    // complète du lot avant la réception client. Cela rend visibles D1.5 à D1.12,
    // notamment le chargement et l’expédition physique.
    enregistrerTraceExecutionCommande(cmd, "sD1.3.4",  "D1.3",  "PREPARATION_EXPEDITION_APRES_PRODUCTION", 3.0, 0.0, cmd.qte, "Préparation de l'expédition du lot complet après production");
    enregistrerTraceExecutionCommande(cmd, "sD1.4.4",  "D1.4",  "REGROUPEMENT_COMMANDE_APRES_PRODUCTION", 2.0, 0.0, cmd.qte, "Regroupement de la commande produite avant constitution du chargement");
    enregistrerTraceExecutionCommande(cmd, "sD1.5.4",  "D1.5",  "CONSTITUTION_CHARGEMENT_CLIENT", 2.0, 0.0, cmd.qte, "Constitution du chargement client pour le lot complet");
    enregistrerTraceExecutionCommande(cmd, "sD1.6.1",  "D1.6",  "PLANIFICATION_ITINERAIRE_LIVRAISON", 2.0, 0.0, cmd.qte, "Planification de l’itinéraire de livraison client");
    enregistrerTraceExecutionCommande(cmd, "sD1.7.1",  "D1.7",  "SELECTION_TRANSPORTEUR", 1.5, 0.0, cmd.qte, "Sélection du transporteur et tarification de la livraison");
