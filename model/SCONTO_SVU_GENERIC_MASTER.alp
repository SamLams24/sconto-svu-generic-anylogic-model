				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1801000000100</Id>
					<Name><![CDATA[aerPropagationColumns]]></Name>
					<X>-440</X><Y>4535</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Étape AER réelle",
    "Statut",
    "Horodatage simulé",
    "Message/preuve issu du run",
    "Objet concerné",
    "Lecture métier"
};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1801000000101</Id>
					<Name><![CDATA[aerPropagationRows]]></Name>
					<X>-440</X><Y>4545</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.ArrayList<Object[]> rows = new java.util.ArrayList<Object[]>();

if (board == null || board.journalAER == null || board.journalAER.isEmpty()) {
    rows.add(new Object[] {
        "Aucun événement AER réel", "Non observé sur ce run", "-",
        "journalAER vide : aucun message AER n'a été émis, relayé ou appliqué.", "-",
        "Ce résultat n'est pas un mock : lancer un run dédié avec goulot, panne ou retard."
    });
    return rows.toArray(new Object[0][]);
}

String[] ordre = new String[] {
    "OPERATIONNEL_RAPPORTE", "BLACKBOARD_PUBLICATION", "SUPERVISION_RECEPTION",
    "COORDINATEUR_RECEPTION", "TACTIQUE_RECEPTION", "TACTIQUE_DECISION_AHP",
    "COORDINATEUR_AMENDMENT", "SUPERVISION_AMENDMENT", "OPERATIONNEL_APPLICATION",
    "OPERATIONNEL_ACK_EXECUTION", "SUPERVISION_ACK", "COORDINATEUR_ACK", "TACTIQUE_ACK",
    "STRATEGIQUE_PLANIFICATION"
};
String[] libelles = new String[] {
    "1. Agent opérationnel d'exécution : rapport émis",
    "2. Blackboard : rapport partagé",
    "3. Agent opérationnel de pilotage ou superviseur : rapport reçu",
    "4. Agent coordinateur : rapport consolidé",
    "5. Agent tactique : rapport macro reçu",
    "6. Agent tactique : arbitrage AHP",
    "7. Agent coordinateur : décision contextualisée",
    "8. Agent opérationnel de pilotage ou superviseur : instruction relayée",
    "9. Agent opérationnel d'exécution : décision appliquée",
    "10. Agent opérationnel d'exécution : accusé émis",
    "11. Agent opérationnel de pilotage ou superviseur : accusé reçu",
    "12. Agent coordinateur : accusé consolidé",
    "13. Agent tactique : accusé final reçu",
    "14. Agent stratégique : planification globale ajustée"
};
String[] lectures = new String[] {
    "L'exécution signale réellement une panne, un goulot ou un retard.",
    "Le Blackboard conserve le message runtime et sa preuve.",
    "Le superviseur reçoit le rapport sans saut de niveau.",
    "Le coordinateur consolide l'écart de son macro-processus.",
    "Le tactique reçoit le rapport consolidé de son domaine.",
    "Le tactique arbitre la priorité avec un score AHP justifiable.",
    "Le coordinateur traduit la décision en instruction contextualisée.",
    "Le superviseur transforme la décision en instruction opérationnelle.",
    "Le poste ciblé applique réellement la décision.",
    "Le poste ciblé produit un accusé d'exécution.",
    "Le superviseur reçoit l'accusé du poste.",
    "Le coordinateur consolide l'accusé du processus.",
    "Le tactique clôt la boucle locale AER.",
    "Le stratégique ajuste éventuellement la politique globale, sans intervenir dans chaque commande."
};

java.util.LinkedHashMap<String,String[]> premier = new java.util.LinkedHashMap<String,String[]>();
java.util.LinkedHashMap<String,Integer> compte = new java.util.LinkedHashMap<String,Integer>();
for (String raw : board.journalAER) {
    if (raw == null || raw.trim().isEmpty()) continue;
    String[] p = raw.split("\\t", -1);
    if (p.length < 8) continue;
    compte.put(p[1], compte.getOrDefault(p[1], 0) + 1);
    if (!premier.containsKey(p[1])) premier.put(p[1], p);
}
int observees = 0;
for (int i=0; i<ordre.length; i++) {
    String[] p = premier.get(ordre[i]);
    int n = compte.getOrDefault(ordre[i], 0);
    if (p != null) {
        observees++;
        rows.add(new Object[] {libelles[i], "Observé", "T=" + p[0] + "s",
            "[" + p[2] + "] " + p[3] + " -> " + p[4] + " | sujet=" + p[5] + " | contenu=" + p[6],
            p[7] + (n > 1 ? " | occurrences=" + n : ""), lectures[i]});
    } else {
        rows.add(new Object[] {libelles[i], "Non observé sur ce run", "-",
            "Aucune ligne journalAER pour l'étape " + ordre[i], "-", lectures[i]});
    }
}
int coeur = 0;
for (int i=0; i<13; i++) if (premier.containsKey(ordre[i])) coeur++;
rows.add(new Object[] {"Conclusion — propagation AER réalignée",
    coeur == 13 ? "Chaîne locale complète" : (coeur >= 8 ? "Chaîne largement observable" : "Chaîne partielle"),
    "Événements AER réels=" + board.journalAER.size(), "Étapes locales observées=" + coeur + "/13",
    "Alertes en Blackboard=" + (board.alertesPubliees == null ? 0 : board.alertesPubliees.size()),
    "Ordre vérifié : exécution -> superviseur -> coordinateur -> tactique -> coordinateur -> superviseur -> exécution."});
return rows.toArray(new Object[0][]);]]></Body>
				</Function>
