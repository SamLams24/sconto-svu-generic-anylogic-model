		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1782000000700</Id>
			<Name><![CDATA[StrategicAgent]]></Name>
			<AdditionalClassCode><![CDATA[

// ============================================================
// BOITE HIERARCHIQUE GENERATION 2
// ============================================================
java.util.ArrayList<AERMessage> boiteMessagesHierarchiques = new java.util.ArrayList<AERMessage>();
int nbMessagesHierarchiquesRecus = 0;
String dernierMessageHierarchique = "";

void recevoirMessageHierarchique(AERMessage msg) {
    if (msg == null) return;
    boiteMessagesHierarchiques.add(msg);
    if (boiteMessagesHierarchiques.size() > 100) boiteMessagesHierarchiques.remove(0);
    nbMessagesHierarchiquesRecus++;
    dernierMessageHierarchique = msg.toString();
}

// ============================================================
// Bloc B.1 -- FONDATIONS PI/SCOR (warm-up, poids effectifs, seuil RL petits
// echantillons, tracabilite du perimetre). Reinitialisees a chaque run par
// demarrerSimulation(), a l'identique de scoreRL/scoreRS/etc. ci-dessous
// (deja presents dans ce master). Cablees dans calculerPIGlobal() depuis le
// Bloc B.2.
// ============================================================
String attributsPonderesPI = "";
double sommePoidsEffectifsPI = 0;
int seuilMinEchantillonRL = 1;
boolean perimetrePIDejaComplet = false;
boolean donneesRLPresentesPrecedent = false;
boolean donneesRSPresentesPrecedent = false;
boolean donneesAMPresentesPrecedent = false;
double dernierLogDetailSCOR = -999.0;

// ============================================================
// Bloc B.2 -- configuration statique RS (tolerance de depassement du cycle
// nominal, cf. majBorneCycleMacro() dans Main) et pilotage MTS (plafond de
// securite du debit decide par ajusterDebits()). Valeurs par defaut EXACTES
// du modele collegue -- jamais mutees a l'execution, donc PAS reinitialisees
// par demarrerSimulation() (contrairement aux 8 champs B.1 ci-dessus, qui
// sont un etat de run).
// ============================================================
double facteurToleranceCycleMacro = 10.0;
double plafondMultipleDebitBase = 3.0;
]]></AdditionalClassCode>
