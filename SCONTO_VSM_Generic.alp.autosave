				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1781964000001</Id>
					<Name><![CDATA[machinesColumns]]></Name>
					<X>-440</X><Y>3640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Identifiant machine",
    "Nom de la machine",
    "Identifiant du poste affecte",
    "Nom de la micro-activite affectee",
    "Agent operationnel lie",
    "Type de machine",
    "Capacite (unites simultanees)",
    "Temps de cycle (secondes)",
    "MTBF - temps moyen entre pannes (secondes)",
    "MTTR - temps moyen de reparation (secondes)",
    "Disponibilite theorique = MTBF/(MTBF+MTTR)"
};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781964000002</Id>
					<Name><![CDATA[machinesRows]]></Name>
					<X>-440</X><Y>3670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (machinesSim == null || machinesSim.isEmpty()) {
    return emptyRows("Aucune machine configurée", machinesColumns().length);
}

Object[][] rows = new Object[machinesSim.size()][machinesColumns().length];

for (int i = 0; i < machinesSim.size(); i++) {
    MachineSim m = machinesSim.get(i);

    rows[i][0] = m.idMachine;
    rows[i][1] = m.nom;
    rows[i][2] = m.idMicroActivite;
    rows[i][3] = m.nomMicroActivite;
    rows[i][4] = m.idOperationalAgent;
    rows[i][5] = m.type;
    rows[i][6] = String.valueOf(m.capacite);
    rows[i][7] = fmt2(m.cycleTime);
    rows[i][8] = fmt2(m.mtbf);
    rows[i][9] = fmt2(m.mttr);
    rows[i][10] = fmt2(m.disponibiliteTheorique() * 100) + "%";
}

return rows;]]></Body>
				</Function>
