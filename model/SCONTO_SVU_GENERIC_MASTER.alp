					<OnClickCode><![CDATA[// Fiche complète de la micro-activité — clic sur l'icône
String proc = "?";
String c = codeSCOR != null ? codeSCOR.toUpperCase() : "";
if (c.startsWith("SR"))      proc = "RETURN (SR)";
else if (c.startsWith("P"))  proc = "PLAN (P)";
else if (c.startsWith("S"))  proc = "SOURCE (S)";
else if (c.startsWith("M"))  proc = "MAKE (M)";
else if (c.startsWith("D"))  proc = "DELIVER (D)";

// Récupération des KPI depuis le BlackBoard (même API que le reste du code)
Main main = (Main) getOwner();
// C14.14 -- KPI par MICRO-ACTIVITE. cleKPI() regroupe par acteur + code SCOR
// N3 : pour sM1.3.3 la cle "ACT_4|M1.3" agrege sM1.3.1 a sM1.3.6, d'ou un
// nombre de passages et un temps de traitement sans rapport avec la loi de
// temps du poste affiche. On lit desormais kpiParMicroActivite (indexe par
// idPoste), avec repli sur l'agregat uniquement si aucune entite n'est encore
// passee par ce poste precis.
KPIBundle kpi = null;
if (main.board.kpiParMicroActivite != null) {
    kpi = main.board.kpiParMicroActivite.get(idPoste);
}
if (kpi == null) {
    kpi = main.board.kpiParPoste.get(main.cleKPI(this));
}
double ct  = (kpi != null) ? kpi.avgCycleTime() : 0.0;
double wt  = (kpi != null) ? kpi.avgWaitTime()  : 0.0;
double lt  = (kpi != null) ? kpi.avgLeadTime()  : 0.0;
long   n   = (kpi != null) ? kpi.count          : 0;
double pce = (lt > 0) ? (ct / lt) * 100.0 : 0.0;

// État physique en temps réel
int wip      = queue.size() + delay.size();
int enFile   = queue.size();
int enCours  = delay.size();

StringBuilder sb = new StringBuilder();
sb.append("════════════════════════════════════\n");
sb.append("  MICRO-ACTIVITÉ : ").append(nom).append("\n");
sb.append("════════════════════════════════════\n\n");
sb.append("▸ Identifiant        : ").append(idPoste).append("\n");
sb.append("▸ Acteur responsable : ").append(nomActeurResponsable != null && !nomActeurResponsable.isEmpty() ? nomActeurResponsable : "—").append("\n");
sb.append("▸ Macro-processus    : ").append(proc).append("\n");
sb.append("▸ Activité SCOR N3   : ").append(codeSCOR).append("\n");
sb.append("▸ Type               : ").append(typePoste).append("\n");
sb.append("▸ Loi de traitement  : ");
if (loiTemps != null)
    sb.append(loiTemps.distribution)
      .append("  (p1=").append(String.format("%.2f", loiTemps.p1))
      .append(", p2=").append(String.format("%.2f", loiTemps.p2)).append(")");
else sb.append("—");
sb.append("\n");
sb.append("▸ Capacité           : ").append(capaciteSimultanee).append(" entité(s) simultanée(s)\n");
sb.append("▸ Précédent          : ").append(postePrecedent != null ? postePrecedent.nom : "—").append("\n");
sb.append("▸ Alternatif         : ").append(estUnPosteAlternatif ? "Oui" : "Non").append("\n");
sb.append("▸ Goulot détecté     : ").append(goulot ? "⚠️  OUI" : "Non").append("\n\n");
sb.append("── KPI (depuis Blackboard) ─────────\n");
sb.append("  Passages traités   : ").append(n).append("\n");
sb.append("  Temps traitement moy.en           : ").append(String.format("%.2f", ct)).append(" s\n");
sb.append("  Temps d’attente moyen  : ").append(String.format("%.2f", wt)).append(" s\n");
sb.append("  Délai total moyenen    : ").append(String.format("%.2f", lt)).append(" s\n");
sb.append("  Efficacité du cycle     : ").append(String.format("%.1f", pce)).append(" %\n\n");
sb.append("── État physique actuel ────────────\n");
sb.append("  WIP total          : ").append(wip).append("\n");
sb.append("  En file d'attente  : ").append(enFile).append("\n");
sb.append("  En traitement      : ").append(enCours).append("\n");
sb.append("  Entrées (total)    : ").append(enter.count()).append("\n");
sb.append("  Sorties (total)    : ").append(exit.count()).append("\n");

main.getExperimentHost().showMessageDialog(sb.toString());]]></OnClickCode>
