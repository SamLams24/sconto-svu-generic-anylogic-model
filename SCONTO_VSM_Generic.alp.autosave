			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781200000050</Id>
					<Name><![CDATA[normaliser]]></Name>
					<X>50</X><Y>390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[val]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[min]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[max]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (max == min) return 0;
double n = (val - min) / (max - min);
return Math.min(1.0, Math.max(0.0, n));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781700000020</Id>
					<Name><![CDATA[agregerN3]]></Name>
					<X>-500</X><Y>250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[metriques]]></Name>
						<Type><![CDATA[java.util.ArrayList<MetriqueN3>]]></Type>
					</Parameter>
					<Body><![CDATA[// Moyenne ponderee des metriques N3 normalisees
if (metriques == null || metriques.isEmpty()) return 0;
double sommeP = 0, sommeVP = 0;
for (MetriqueN3 m : metriques) { sommeP += m.poids; sommeVP += m.valeurNorm * m.poids; }
return sommeP == 0 ? 0 : sommeVP / sommeP;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000610</Id>
					<Name><![CDATA[poidsEffectifN3]]></Name>
					<X>-500</X><Y>290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nomMetrique]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[poidsParDefaut]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Consulte le poids personnalise par l'utilisateur (tableau de pilotage N3)
// pour cette metrique, identifiee par son nom exact. Si l'utilisateur n'a
// jamais touche cette metrique, on retombe sur le poids egal par defaut (1/N) --
// jamais d'erreur, jamais de valeur arbitraire non documentee.
if (poidsN3Personnalises.containsKey(nomMetrique)) {
    return Math.max(0.0, poidsN3Personnalises.get(nomMetrique));
}
return poidsParDefaut;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781200000051</Id>
					<Name><![CDATA[calculerPIGlobal]]></Name>
					<X>50</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();
BlackboardAgent board = main.board;
if (board == null) return 0;
detailN3.clear();

KPIBundle sP = board.kpiParMacro.get("sP");
KPIBundle sS = board.kpiParMacro.get("sS");
KPIBundle sM = board.kpiParMacro.get("sM");
KPIBundle sD = board.kpiParMacro.get("sD");
KPIBundle sR = board.kpiParMacro.get("sR");
double wip = board.avgWIP();
double termineesDebit = board.totalTerminees;
try {
    if (main.nbTermines > termineesDebit) termineesDebit = main.nbTermines;
    if (board.kpiGlobal != null && board.kpiGlobal.count > termineesDebit) termineesDebit = board.kpiGlobal.count;
} catch (Throwable ignored) {}
double debit = time() > 0 ? termineesDebit * 3600.0 / time() : 0;

// Capacite de reference du systeme = somme des capacites simultanees declarees
// sur tous les postes. Utilisee comme borne haute realiste pour normaliser le WIP,
// au lieu d'une constante arbitraire (500) sans rapport avec le modele de l'utilisateur.
double capaciteTotale = 0;
for (PosteGenericAgent p : main.postes) capaciteTotale += p.capaciteSimultanee;
if (capaciteTotale <= 0) capaciteTotale = 1; // garde-fou division par zero

// ============================================================
// RL — Reliability (poids egaux 1/N, N = nb de metriques retenues)
// ============================================================
java.util.ArrayList<MetriqueN3> rl = new java.util.ArrayList<MetriqueN3>();
double scrapM = (sM != null) ? sM.scrapRate() : 0;
double conformite = 1.0 - scrapM;
double reworkM = (sM != null) ? sM.reworkRate() : 0;
double fpy = 1.0 - reworkM;
double pceD = (sD != null) ? sD.pce() : (sM != null ? sM.pce() : 0);
double fillRate = main.verifierFillRate();
double scrapR = (sR != null) ? sR.scrapRate() : 0;
double traitementRetour = 1.0 - scrapR;
// Documentation/commande conforme : proxy = part des commandes livrees (SERVIE), hors EN_RETARD/EN_ATTENTE
double docAccuracy = main.tauxCommandesConformes();

int nRL = 6;
double poidsRL = 1.0 / nRL;
rl.add(new MetriqueN3("Conformite production (1-Scrap Make)", "RL.3.58", "%", conformite, normaliser(conformite, 0, 1), poidsEffectifN3("Conformite production (1-Scrap Make)", poidsRL)));
rl.add(new MetriqueN3("First Pass Yield (1-Rework Make)", "RL.3.18", "%", fpy, normaliser(fpy, 0, 1), poidsEffectifN3("First Pass Yield (1-Rework Make)", poidsRL)));
rl.add(new MetriqueN3("Deliver Process Cycle Efficiency — Efficacité du cycle Deliver (proxy VSM)", "proxy VSM", "%", pceD, normaliser(pceD, 0, 1), poidsEffectifN3("Deliver Process Cycle Efficiency — Efficacité du cycle Deliver (proxy VSM)", poidsRL)));
rl.add(new MetriqueN3("Delivery Performance to Customer Commit Date — Taux de commandes livrées à temps", "RL.2.2", "%", fillRate, normaliser(fillRate, 0, 1), poidsEffectifN3("Delivery Performance to Customer Commit Date — Taux de commandes livrées à temps", poidsRL)));
rl.add(new MetriqueN3("Traitement Return (1-Scrap Return)", "RL.3.41", "%", traitementRetour, normaliser(traitementRetour, 0, 1), poidsEffectifN3("Traitement Return (1-Scrap Return)", poidsRL)));
rl.add(new MetriqueN3("Delivery Completion / Documentation Accuracy — Taux de commandes livrées conformes", "RL.2.1 / RL.3.31", "%", docAccuracy, normaliser(docAccuracy, 0, 1), poidsEffectifN3("Delivery Completion / Documentation Accuracy — Taux de commandes livrées conformes", poidsRL)));
scoreRL = agregerN3(rl);
detailN3.put("RL", rl);

// ============================================================
// RS — Responsiveness (temps de cycle par macro-processus SCOR)
// Bornes de normalisation = 2x le temps de cycle MOYEN actuel,
// recalculees a chaque appel : pas de constante figee dans le code.
// ============================================================
java.util.ArrayList<MetriqueN3> rs = new java.util.ArrayList<MetriqueN3>();
double ctS = (sS != null) ? sS.avgCycleTime() : 0;
double ctM = (sM != null) ? sM.avgCycleTime() : 0;
double ctD = (sD != null) ? sD.avgCycleTime() : 0;
double ctR = (sR != null) ? sR.avgCycleTime() : 0;
double ltG = board.kpiGlobal.avgLeadTime();
double wtG = board.kpiGlobal.avgWaitTime();

// borne dynamique : 2x la moyenne des CT macro observes non nuls (jamais < 1s pour eviter une division degeneree)
double sommeCT = 0; int nCT = 0;
if (ctS > 0) { sommeCT += ctS; nCT++; }
if (ctM > 0) { sommeCT += ctM; nCT++; }
if (ctD > 0) { sommeCT += ctD; nCT++; }
if (ctR > 0) { sommeCT += ctR; nCT++; }
double borneCT = (nCT > 0) ? Math.max(1.0, (sommeCT / nCT) * 2.0) : 3600;
double borneLT = borneCT * 2.0;

int nRS = 2;
if (main.macroExecutee(sS)) nRS++;
if (main.macroExecutee(sM)) nRS++;
if (main.macroExecutee(sD)) nRS++;
if (main.macroExecutee(sR)) nRS++;
double poidsRS = 1.0 / nRS;
if (main.macroExecutee(sS)) rs.add(new MetriqueN3("Source Cycle Time — Temps de cycle Source", "RS.2.1", "s", ctS, normaliser(ctS, borneCT, 0), poidsEffectifN3("Source Cycle Time — Temps de cycle Source", poidsRS)));
if (main.macroExecutee(sM)) rs.add(new MetriqueN3("Make Cycle Time — Temps de cycle Make", "RS.2.2", "s", ctM, normaliser(ctM, borneCT, 0), poidsEffectifN3("Make Cycle Time — Temps de cycle Make", poidsRS)));
if (main.macroExecutee(sD)) rs.add(new MetriqueN3("Deliver Cycle Time — Temps de cycle Deliver", "RS.2.3", "s", ctD, normaliser(ctD, borneCT, 0), poidsEffectifN3("Deliver Cycle Time — Temps de cycle Deliver", poidsRS)));
if (main.macroExecutee(sR)) rs.add(new MetriqueN3("Return Cycle Time — Temps de cycle Return", "RS.2.5", "s", ctR, normaliser(ctR, borneCT, 0), poidsEffectifN3("Return Cycle Time — Temps de cycle Return", poidsRS)));
rs.add(new MetriqueN3("Order Fulfillment Cycle Time — Lead Time global de commande", "RS.1.1", "s", ltG, normaliser(ltG, borneLT, 0), poidsEffectifN3("Order Fulfillment Cycle Time — Lead Time global de commande", poidsRS)));
rs.add(new MetriqueN3("Order Fulfillment Dwell Time — Temps d’attente global", "RS.3.94", "s", wtG, normaliser(wtG, borneLT, 0), poidsEffectifN3("Order Fulfillment Dwell Time — Temps d’attente global", poidsRS)));
scoreRS = agregerN3(rs);
detailN3.put("RS", rs);

// ============================================================
// AG — Agility : seules les metriques reellement mesurables sont
// retenues (pas de Time to Recovery ni de VaR : aucune donnee de
// risque/incident n'existe dans ce modele -- on ne fabrique pas
// un chiffre qui ne reposerait sur rien).
// ============================================================
java.util.ArrayList<MetriqueN3> ag = new java.util.ArrayList<MetriqueN3>();
double tauxOccupation = wip / capaciteTotale; // proxy de saturation, borne par la capacite reelle declaree
double adaptabilite = main.strategic != null ? main.strategic.coefficientAdaptabilite() : 0.5;

int nAG = 3;
double poidsAG = 1.0 / nAG;
ag.add(new MetriqueN3("Current Delivery Volume / Throughput — Volume livré et débit de sortie", "AG.3.32", "ent/h", debit, normaliser(debit, 0, capaciteTotale * 2.0), poidsEffectifN3("Current Delivery Volume / Throughput — Volume livré et débit de sortie", poidsAG)));
ag.add(new MetriqueN3("System Utilization — Taux d’occupation du système (proxy WIP/capacité)", "proxy AG", "%", tauxOccupation, normaliser(tauxOccupation, 1.5, 0), poidsEffectifN3("System Utilization — Taux d’occupation du système (proxy WIP/capacité)", poidsAG)));
ag.add(new MetriqueN3("Stabilite du debit (1 - coeff. de variation observe)", "AG.1.1", "%", adaptabilite, normaliser(adaptabilite, 0, 1), poidsEffectifN3("Stabilite du debit (1 - coeff. de variation observe)", poidsAG)));
scoreAG = agregerN3(ag);
detailN3.put("AG", ag);

// ============================================================
// CO — Cost : le seul score de performance defendable ici est le
// ratio cout total / chiffre d'affaire genere (TSCMC ratio) -- a
// condition que l'utilisateur ait renseigne un CA par unite.
// coutMainOeuvre et coutMatiere sont affiches a titre informatif
// (poids 0) : leur repartition relative n'est PAS une mesure de
// performance en soi (depenser plus en main d'oeuvre qu'en matiere
// n'est ni bon ni mauvais dans l'absolu).
// ============================================================
java.util.ArrayList<MetriqueN3> co = new java.util.ArrayList<MetriqueN3>();
double[] couts = main.calculerCoutsCumules(); // [0]=coutMainOeuvre, [1]=coutMatiere, [2]=coutTotalDeclare
double coutMainOeuvre = couts[0];
double coutMatiere = couts[1];
double coutTotal = couts[2];

boolean donneesFinancieresPresentes = (main.chiffreAffaireParUnite > 0 && main.nbTermines > 0);
double ratioCoutCA = 0.5; // score neutre si aucune donnee financiere n'est saisie -- jamais de penalite arbitraire
if (donneesFinancieresPresentes) {
    double ca = main.chiffreAffaireParUnite * main.nbTermines;
    ratioCoutCA = (ca > 0) ? Math.min(1.0, coutTotal / ca) : 0.5;
}

int nCO = 1; // une seule metrique contribue reellement au score pondere
double poidsCO = 1.0 / nCO;
co.add(new MetriqueN3("Cout total / Chiffre d'affaire estime (TSCMC ratio)", "CO.1.1", donneesFinancieresPresentes ? "%" : "% (CA non renseigne, score neutre)", ratioCoutCA, 1.0 - ratioCoutCA, poidsCO));
co.add(new MetriqueN3("Cout main d'oeuvre cumule (informatif, hors score)", "CO.3.13", donneesFinancieresPresentes || coutMainOeuvre > 0 ? "FCFA" : "EUR (non renseigne)", coutMainOeuvre, 0.0, 0.0));
co.add(new MetriqueN3("Cout matiere cumule (informatif, hors score)", "CO.3.11", donneesFinancieresPresentes || coutMatiere > 0 ? "FCFA" : "FCFA (non renseigne)", coutMatiere, 0.0, 0.0));
scoreCO = agregerN3(co);
detailN3.put("CO", co);

// ============================================================
// AM — Asset Management : actifs fixes declares + disponibilite
// machine (deja calculee dans MachineSim) + jours de stock reel.
// La valeur d'actif fixe est affichee a titre informatif (poids 0) :
// aucune reference comparative n'existe pour juger si un montant est
// "bon" ou "mauvais", contrairement aux taux/durees normalisables.
// ============================================================
java.util.ArrayList<MetriqueN3> am = new java.util.ArrayList<MetriqueN3>();
double valeurActifsTotale = main.calculerValeurActifsFixes();
double disponibiliteMachinesMoy = main.calculerDisponibiliteMachinesMoyenne();
double joursStock = main.calculerInventoryDaysOfSupply();

int nAM = 2; // seules 2 metriques contribuent reellement au score pondere
double poidsAM = 1.0 / nAM;
am.add(new MetriqueN3("Disponibilite moyenne des machines (MTBF/(MTBF+MTTR))", "AM.3.9", "%", disponibiliteMachinesMoy, normaliser(disponibiliteMachinesMoy, 0, 1), poidsEffectifN3("Disponibilite moyenne des machines (MTBF/(MTBF+MTTR))", poidsAM)));
am.add(new MetriqueN3("Inventory Days of Supply (stock reel observe)", "AM.2.2", "jours", joursStock, 1.0 - normaliser(joursStock, 30, 0), poidsEffectifN3("Inventory Days of Supply (stock reel observe)", poidsAM)));
am.add(new MetriqueN3("Valeur des actifs fixes declares (informatif, hors score)", "AM.3.18", valeurActifsTotale > 0 ? "EUR" : "EUR (non renseigne)", valeurActifsTotale, 0.0, 0.0));
scoreAM = agregerN3(am);
detailN3.put("AM", am);

return w_RL * scoreRL + w_RS * scoreRS + w_AG * scoreAG + w_CO * scoreCO + w_AM * scoreAM;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000730</Id>
					<Name><![CDATA[detecterGoulot]]></Name>
					<X>190</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[BlackboardAgent board = ((Main) getOwner()).board;
String goulotId = null; double maxWT = 0;
for (PosteGenericAgent p : ((Main) getOwner()).postes) {
    KPIBundle k = board.kpiParPoste.get(((Main) getOwner()).cleKPI(p));
    if (k != null && k.avgWaitTime() > maxWT) { maxWT = k.avgWaitTime(); goulotId = p.idPoste; }
}
if (goulotId != null && maxWT > seuilWTGoulot) {
    dernierGoulot = goulotId;
    board.logEvent("[STRATEGIC] Goulot detecte : " + goulotId + " WT=" + String.format("%.1f", maxWT) + "s");
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782000000731</Id>
					<Name><![CDATA[piloterSource]]></Name>
					<X>190</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[BlackboardAgent board = ((Main) getOwner()).board;
KPIBundle sS = board.kpiParMacro.get("sS");
if (sS == null) return;
double ltSource = sS.avgLeadTime();
if (ltSource > seuilLTSource) {
    board.logEvent("[STRATEGIC] Source lente (LT=" + String.format("%.1f", ltSource) + "s) -> signal reappro");
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791000006101</Id>
					<Name><![CDATA[deciderTypeCommande]]></Name>
					<X>190</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[cmd]]></Name>
						<Type><![CDATA[CommandeAgent]]></Type>
					</Parameter>
					<Body><![CDATA[// DECISION STRATEGIQUE : servir cette commande depuis le stock (MTS) ou
// lancer une production dediee (MTO) ?
//
// Le flux physique tourne en permanence sur prevision et alimente le stock de
// produits finis. Une commande client (flux d'information) vient CONSOMMER ce
// stock. Si le stock disponible couvre la commande, on sert en MTS : c'est
// rapide (delai promis court) et cela valorise la production sur prevision.
// Sinon, le stock ne suffit pas : il faut produire specifiquement pour cette
// commande, c'est du MTO (delai promis plus long).
//
// Remplace l'ancien tirage aleatoire 70/30, qui ne correspondait a aucune
// decision d'agent et rendait le choix MTS/MTO arbitraire.
Main main = (Main) getOwner();
if (main == null || cmd == null) return "MTO";

ScenarioFlux sc = null;
for (ScenarioFlux s : main.scenarios) {
    if (s.typeProduit.equals(cmd.idScenario)) { sc = s; break; }
}
if (sc == null && !main.scenarios.isEmpty()) sc = main.scenarios.get(0);

PosteGenericAgent stockFini = (sc != null) ? main.trouverStockFiniPourScenario(sc) : null;
if (stockFini == null) {
    // Aucun poste de stockage declare dans la chaine : impossible de servir sur
    // stock, toute commande declenche donc une production dediee.
    if (main.board != null) {
        main.board.logEvent("[HOLON-STRAT] " + cmd.idCommande
            + " -> MTO (aucun poste STOCKAGE dans la chaine)");
    }
    return "MTO";
}

double dispo = stockFini.stockDisponible();
boolean servableSurStock = (dispo >= cmd.qte);

// --- REFUS PAR CAPACITE ---------------------------------------------------
// Si la commande ne peut PAS etre servie sur stock, elle devra etre produite.
// Le strategique verifie alors que le carnet du Coordinateur Make n'est pas
// deja structurellement sature : accepter une commande qu'on sait ne pas
// pouvoir honorer dans un delai raisonnable, c'est promettre dans le vide et
// degrader le taux de service. Un refus explicite est une DECISION -- et une
// information exploitable (nbCommandesRefusees = signal de sous-capacite).
if (!servableSurStock) {
    CoordinatorAgent coordMake = null;
    for (CoordinatorAgent sv : main.supervisorsMacro) {
        if ("sM".equals(sv.idMacroProcessus)) { coordMake = sv; break; }
    }
    if (coordMake != null && coordMake.carnetCommandesMTO.size() >= capaciteCarnetMax) {
        nbCommandesRefusees++;
        nbDecisionsCommandes++;
        cmd.statut = "REFUSEE";
        if (main.board != null) {
            main.board.logEvent(String.format(
                "[HOLON-STRAT] %s REFUSEE : carnet Make sature (%d/%d) et stock insuffisant (%.0f < %d). "
                + "Capacite structurellement depassee.",
                cmd.idCommande, coordMake.carnetCommandesMTO.size(), capaciteCarnetMax, dispo, cmd.qte));
        }
        return "REFUSEE";
    }
}

String type = servableSurStock ? "MTS" : "MTO";

if (main.board != null) {
    main.board.logEvent(String.format(
        "[HOLON-STRAT] %s qte=%d | stock %s : physique=%.0f, reserve=%.0f, disponible=%.0f -> decision %s (%s)",
        cmd.idCommande, cmd.qte, stockFini.nom,
        stockFini.niveauStock, stockFini.stockReserve, dispo, type,
        servableSurStock ? "servie depuis le stock" : "stock insuffisant, production dediee"));
}
nbDecisionsCommandes++;
if (servableSurStock) nbCommandesMTS++; else nbCommandesMTO++;
return type;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781625605126</Id>
					<Name><![CDATA[prevoirDemande]]></Name>
					<X>190</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();
double debitActuel = (time() > 0) ? main.nbTermines * 3600.0 / time() : 0;

historiqueDebit.add(debitActuel);
if (historiqueDebit.size() > 10) historiqueDebit.remove(0);

double alpha = 0.3;
if (previsionDemande == 0) {
    previsionDemande = debitActuel;
} else {
    previsionDemande = alpha * debitActuel + (1 - alpha) * previsionDemande;
}

// Meme lissage, applique separement a chaque produit (scenario), pour
// alimenter le calcul du besoin net en matieres (Main.calculerBesoinsNets).
if (time() > 0) {
    for (ScenarioFlux sc : main.scenarios) {
        Long nb = main.nbTerminesParProduit.get(sc.typeProduit);
        double debitProduit = (nb != null) ? nb * 3600.0 / time() : 0;
        Double prev = previsionParProduit.get(sc.typeProduit);
        double nouvellePrev = (prev == null || prev == 0) ? debitProduit : (alpha * debitProduit + (1 - alpha) * prev);
        previsionParProduit.put(sc.typeProduit, nouvellePrev);
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781625629534</Id>
					<Name><![CDATA[ajusterDebits]]></Name>
					<X>200</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();
BlackboardAgent board = main.board;
CoordinatorAgent sup = main.supervisor;

double pi = piGlobalCourant;

// Detection d'un goulot persistant sur MAKE (sM) via l'historique du Supervisor
boolean goulotMakePersistant = false;
for (java.util.Map.Entry<String, Integer> e : sup.historiqueGoulots.entrySet()) {
    PosteGenericAgent p = main.trouverPoste(e.getKey());
    if (p != null && main.macroPrefixe(p.codeSCOR).equals("sM") && e.getValue() >= 2) {
        goulotMakePersistant = true;
        break;
    }
}

double ancienFacteur = facteurAjustement;
String decision;

if (pi < seuilPI_bas || goulotMakePersistant) {
    facteurAjustement = Math.max(0.5, facteurAjustement * 0.90);
    decision = "RALENTIR";
} else if (pi > seuilPI_haut && !goulotMakePersistant) {
    facteurAjustement = Math.min(1.5, facteurAjustement * 1.05);
    decision = "ACCELERER";
} else {
    decision = "MAINTENIR";
}

// ============================================================
// PILOTAGE DE LA PRODUCTION SUR PREVISION (Make-To-Stock)
//
// Le flux physique (matiere -> produits) doit tourner MEME SANS COMMANDE :
// c'est de la production sur prevision, destinee a remplir le stock de
// produits finis. La commande client, elle, est un flux d'INFORMATION qui
// vient CONSOMMER ce stock (MTS) ou declencher une production dediee (MTO).
//
// Le debit de production n'est donc plus une constante corrigee apres coup
// par la performance : c'est une DECISION du strategique, fondee sur
//   1. la prevision de demande (lissage exponentiel, previsionParProduit) ;
//   2. l'ecart entre le stock de produits finis observe et le stock cible ;
//   3. un bridage par le facteur de performance (frein de securite si la
//      chaine sature ou si un goulot Make persiste).
//
//   debit_MTS = prevision + (stock_cible - stock_observe) / horizon_rattrapage
//   puis borne a [0, +inf[ et multiplie par facteurAjustement.
//
// stock_cible = prevision x couvertureStockCibleHeures (24h = 1 jour de
// couverture de la demande prevue).
// ============================================================
double totalStockObserve = 0;
double totalStockCible   = 0;
double totalDebitMTS     = 0;

for (ScenarioFlux sc : main.scenarios) {
    // Prevision propre a ce produit (entites/heure), repli sur la prevision globale
    Double pvProduit = previsionParProduit.get(sc.typeProduit);
    double prevision = (pvProduit != null && pvProduit > 0) ? pvProduit : previsionDemande;

    // Stock de produits finis reellement observe pour ce scenario
    PosteGenericAgent stockFini = main.trouverStockFiniPourScenario(sc);
    double stockObserve = (stockFini != null) ? stockFini.niveauStock : 0;

    // Stock cible = couverture (en heures) de la demande prevue
    double stockCible = prevision * couvertureStockCibleHeures;

    // Debit de production sur prevision :
    //   - couvrir la demande prevue,
    //   - + rattraper (ou resorber) l'ecart au stock cible sur l'horizon defini.
    // Un stock EXCEDENTAIRE donne un terme negatif : la production ralentit
    // d'elle-meme, voire s'arrete, au lieu de continuer a produire pour rien.
    double rattrapage = (stockCible - stockObserve) / Math.max(0.5, horizonRattrapageHeures);
    double debitSouhaite = prevision + rattrapage;

    // Bridage par la performance : le facteur reste un FREIN de securite
    // (goulot persistant, PI degrade), il ne pilote plus la production a lui seul.
    double debitFinal = Math.max(0.0, debitSouhaite * facteurAjustement);

    // Au demarrage, tant qu'aucune demande n'a encore ete observee, on retombe
    // sur le debit de reference du scenario pour amorcer le flux physique.
    if (prevision <= 0 && stockObserve <= 0) {
        debitFinal = sc.debitParHeureBase * facteurAjustement;
    }

    sc.debitParHeure = debitFinal;

    totalStockObserve += stockObserve;
    totalStockCible   += stockCible;
    totalDebitMTS     += debitFinal;
}

stockFiniObserve  = totalStockObserve;
stockCibleCalcule = totalStockCible;
debitMTSDecide    = totalDebitMTS;

nbAjustements++;
dernierAjustement = time();

AERMessage msg = new AERMessage(
    AERMessage.AMENDMENT,
    "STRATEGIC",
    "COORDINATOR",
    "PLANIF",
    "Decision=" + decision
    + ";PI=" + String.format("%.3f", pi)
    + ";facteur=" + String.format("%.3f", facteurAjustement)
    + ";prevision=" + String.format("%.1f", previsionDemande)
    + ";stock=" + String.format("%.0f", stockFiniObserve)
    + ";cible=" + String.format("%.0f", stockCibleCalcule)
    + ";debitMTS=" + String.format("%.1f", debitMTSDecide),
    time()
);
board.logEvent("[HOLON-STRAT] " + msg.toString());
board.logEvent(String.format(
    "[HOLON-STRAT] %s | PI=%.3f | facteur %.3f -> %.3f | prevision=%.1f ent/h | stock=%.0f/%.0f | debit MTS=%.1f ent/h | goulotMake=%s",
    decision, pi, ancienFacteur, facteurAjustement, previsionDemande,
    stockFiniObserve, stockCibleCalcule, debitMTSDecide, goulotMakePersistant));

journalDecisions.add(String.format("[T=%.0f] %s (PI=%.2f, stock=%.0f/%.0f, MTS=%.1f/h)",
    time(), decision, pi, stockFiniObserve, stockCibleCalcule, debitMTSDecide));
if (journalDecisions.size() > 10) journalDecisions.remove(0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000306</Id>
					<Name><![CDATA[coefficientAdaptabilite]]></Name>
					<X>200</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Mesure honnete de l'agilite (AG.1.1 proxy) : stabilite reelle du debit de sortie,
// calculee a partir des derniers debits observes (historiqueDebit, alimente par
// prevoirDemande() toutes les 60s pendant l'execution). Coefficient de variation
// faible = systeme stable = score proche de 1. Si l'historique est trop court
// pour etre significatif (moins de 3 points), on retourne un score neutre 0.5
// plutot que de calculer une variance non representative.
if (historiqueDebit == null || historiqueDebit.size() < 3) return 0.5;

double somme = 0;
for (double v : historiqueDebit) somme += v;
double moyenne = somme / historiqueDebit.size();

if (moyenne <= 0) return 0.5; // pas de production : la mesure de stabilite n'a pas de sens

double sommeCarresEcarts = 0;
for (double v : historiqueDebit) sommeCarresEcarts += (v - moyenne) * (v - moyenne);
double ecartType = Math.sqrt(sommeCarresEcarts / historiqueDebit.size());

double coeffVariation = ecartType / moyenne; // 0 = parfaitement stable, augmente avec la volatilite
return Math.max(0.0, 1.0 - Math.min(1.0, coeffVariation));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781625648638</Id>
					<Name><![CDATA[getRapportStrategique]]></Name>
					<X>210</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main main = (Main) getOwner();
StringBuilder sb = new StringBuilder();
sb.append("=== STRATEGIC AGENT (N4) - Planification ===\n");
sb.append(String.format("Prevision demande : %.1f entites/h\n", previsionDemande));
sb.append(String.format("Facteur ajustement: %.2f (debit applique = base x facteur)\n", facteurAjustement));
sb.append(String.format("Nb ajustements    : %d | Dernier : T=%.0fs\n", nbAjustements, dernierAjustement));
sb.append("\nDebits scenarios actuels :\n");
for (ScenarioFlux sc : main.scenarios) {
    sb.append(String.format("  %-12s base=%.1f/h -> actuel=%.1f/h\n",
        sc.typeProduit, sc.debitParHeureBase, sc.debitParHeure));
}
sb.append("\nHistorique decisions (10 dernieres) :\n");
if (journalDecisions.isEmpty()) {
    sb.append("  (aucune decision encore)\n");
} else {
    for (String d : journalDecisions) sb.append("  " + d + "\n");
}
return sb.toString();]]></Body>
