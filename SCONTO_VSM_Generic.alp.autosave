                panel.add(new javax.swing.JLabel("Quantite min :")); panel.add(qteMinField);
                panel.add(new javax.swing.JLabel("Quantite max :")); panel.add(qteMaxField);
                panel.add(new javax.swing.JLabel("Popups metier :")); panel.add(popupBox);
                panel.add(new javax.swing.JLabel("Niveau popups :")); panel.add(niveauPopupBox);
                panel.add(new javax.swing.JLabel("Delai min entre popups (s) :")); panel.add(delaiPopupField);
                panel.add(new javax.swing.JLabel("Conseil de test :")); panel.add(new javax.swing.JLabel("1 commande pour suivre un cas de bout en bout"));

                javax.swing.JOptionPane pane = new javax.swing.JOptionPane(
                    panel,
                    javax.swing.JOptionPane.PLAIN_MESSAGE,
                    javax.swing.JOptionPane.OK_CANCEL_OPTION
                );

                java.awt.Window owner = java.awt.KeyboardFocusManager.getCurrentKeyboardFocusManager().getActiveWindow();
                javax.swing.JDialog dialog = owner != null
                    ? pane.createDialog(owner, "Controle des commandes et popups")
                    : pane.createDialog("Controle des commandes et popups");

                dialog.setModal(true);
                dialog.setAlwaysOnTop(true);
                dialog.setLocationRelativeTo(owner);
                dialog.addWindowListener(new java.awt.event.WindowAdapter() {
                    public void windowOpened(java.awt.event.WindowEvent e) {
                        dialog.toFront();
                        dialog.requestFocus();
                        nbField.requestFocusInWindow();
                    }
                });
                dialog.setVisible(true);

                Object selected = pane.getValue();
                boolean ok = selected != null && selected instanceof Integer
                    && ((Integer) selected).intValue() == javax.swing.JOptionPane.OK_OPTION;

                if (ok) {
                    limiterNombreCommandes = limiterBox.isSelected();
                    nombreCommandesATester = Math.max(1, Integer.parseInt(nbField.getText().trim()));
                    activerDelaisMetier = delaisBox.isSelected();
                    delaiPremiereCommandeSec = Math.max(0, Double.parseDouble(delaiFirstField.getText().trim()));
                    delaiCommandeMinSec = Math.max(0, Double.parseDouble(delaiMinField.getText().trim()));
                    delaiCommandeMaxSec = Math.max(delaiCommandeMinSec, Double.parseDouble(delaiMaxField.getText().trim()));
                    quantiteCommandeFixeActive = qteFixeBox.isSelected();
                    quantiteCommandeFixe = Math.max(1, Integer.parseInt(qteFixeField.getText().trim()));
                    quantiteCommandeMin = Math.max(1, Integer.parseInt(qteMinField.getText().trim()));
                    quantiteCommandeMax = Math.max(quantiteCommandeMin, Integer.parseInt(qteMaxField.getText().trim()));
                    popupsMetierActifs = popupBox.isSelected();
                    niveauPopupMetier = String.valueOf(niveauPopupBox.getSelectedItem());
                    delaiMinimumEntrePopupsSec = Math.max(0, Double.parseDouble(delaiPopupField.getText().trim()));
                    messageLimiteCommandesDejaAffiche = false;

                    afficherMessageTopMost(
                        "Parametres appliques :\n" + resumeNombreCommandes()
                        + "\nPopups=" + popupsMetierActifs + " / niveau=" + niveauPopupMetier,
                        "Controle commandes"
                    );
                    board.logEvent("[COMMANDE] " + resumeNombreCommandes());
                }
            } catch (Throwable ex) {
                afficherMessageTopMost(
                    "Erreur dans le parametrage des commandes : " + ex.getMessage(),
                    "Erreur"
                );
                try { traceln("[COMMANDE] erreur parametrage : " + ex.getMessage()); } catch (Throwable ignored) {}
            }
        }
    });
}


