// Parametres de test et d'orchestration : une commande par defaut, puis
// generation controlee par l'utilisateur pour observer clairement les cas.
public boolean limiterNombreCommandes = true;
public int nombreCommandesATester = 45; // C14.44 -- assez de volume pour voir Cas 1/2/3, reprises, rebuts et une saturation transitoire
public int commandesGenereesDepuisDemarrage = 0;
public boolean messageLimiteCommandesDejaAffiche = false;

// Quantites de commande. Si la quantite fixe est active, elle remplace la plage min/max.
public boolean quantiteCommandeFixeActive = false;
public int quantiteCommandeFixe = 2;
public int quantiteCommandeMin = 20; // C14.41 -- calibre sur 140 t/j (16h/j, 700 bouteilles/h)
public int quantiteCommandeMax = 40; // C14.41

// Delais metier courts en secondes de simulation. Ils evitent que toutes les
// decisions apparaissent au meme instant et rendent le fil conducteur lisible.
public boolean activerDelaisMetier = true;
public double delaiPremiereCommandeSec = 2.0;
public double delaiCommandeMinSec = 150.0; // C14.43 -- sM1.5.1/sM1.6.1 corriges (etapes de liberation/manutention, pas des contraintes physiques : capacite portee a 100, temps reduit). Le goulot redevient sM1.3.2 (carrousel de remplissage, 6,5s), industriellement defendable. Nouvelle capacite max 554 bouteilles/h ; cible 83% = 460 bouteilles/h.
public double delaiCommandeMaxSec = 320.0; // C14.43
public double delaiReceptionCommandeMinSec = 2.0;
public double delaiReceptionCommandeMaxSec = 5.0;
public double delaiDecisionStockMinSec = 2.0;
public double delaiDecisionStockMaxSec = 4.0;
public double delaiDecisionMatiereMinSec = 2.0;
public double delaiDecisionMatiereMaxSec = 4.0;
public double delaiLancementProductionMinSec = 3.0;
public double delaiLancementProductionMaxSec = 6.0;
public double delaiLivraisonDirecteMinSec = 4.0;
public double delaiLivraisonDirecteMaxSec = 8.0;
public double delaiApprovisionnementCommandeMinSec = 12.0;
public double delaiApprovisionnementCommandeMaxSec = 20.0;

// Popups metier : utiles pour comprendre, mais filtrees pour eviter la pollution.
public boolean popupsMetierActifs = true;
public String niveauPopupMetier = "ESSENTIEL"; // ESSENTIEL / DETAILLE / DEBUG
public double delaiMinimumEntrePopupsSec = 2.0;
public double dernierPopupMetierA = -999999.0;

// File d'orchestration temporelle. Les actions sont executees par
// AnimationMessagesManager, deja cadence a 1 seconde.
public java.util.ArrayList<ActionMetierDifferee> actionsMetierDifferees = new java.util.ArrayList<ActionMetierDifferee>();

public class ActionMetierDifferee implements java.io.Serializable {
    public double tExecution = 0;
    public String type = "";
    public String idCommande = "";
    public ActionMetierDifferee(double tExecution, String type, String idCommande) {
        this.tExecution = tExecution;
        this.type = type == null ? "" : type;
        this.idCommande = idCommande == null ? "" : idCommande;
    }
}

String resumeNombreCommandes() {
    String qte = quantiteCommandeFixeActive
        ? ("quantite fixe=" + Math.max(1, quantiteCommandeFixe))
        : ("quantite=" + Math.max(1, quantiteCommandeMin) + ".." + Math.max(Math.max(1, quantiteCommandeMin), quantiteCommandeMax));
    String delai = "1ere commande=" + String.format("%.1f", delaiPremiereCommandeSec)
        + "s ; intervalle=" + String.format("%.1f", delaiCommandeMinSec)
        + ".." + String.format("%.1f", delaiCommandeMaxSec) + "s";
    if (!limiterNombreCommandes) return "Generation continue des commandes ; " + qte + " ; " + delai;
    return "Nombre de commandes a generer=" + Math.max(1, nombreCommandesATester) + " ; " + qte + " ; " + delai;
}

boolean peutGenererNouvelleCommande() {
    if (!modeExecution) return false;
    if (!modePilotageParCommande) return true;
    if (!limiterNombreCommandes) return true;

    int max = Math.max(1, nombreCommandesATester);
    if (commandesGenereesDepuisDemarrage < max) return true;

    if (!messageLimiteCommandesDejaAffiche) {
        messageLimiteCommandesDejaAffiche = true;
        board.logEvent("[COMMANDE] Limite atteinte : " + commandesGenereesDepuisDemarrage + "/" + max + " commande(s).");
        ajouterSuiviDetaille(
            "Mode de pilotage",
            "Nombre de commandes atteint",
            "Le modele a genere le nombre de commandes demande pour ce test. Aucune nouvelle commande automatique ne sera creee.",
            "Utilisateur",
            "Generateur de commandes",
            "Parametre nombre de commandes",
            commandesGenereesDepuisDemarrage + "/" + max,
            "Generateur de commandes",
            "Modele",
            "Limite de test",
            "TEST",
            "Arreter la generation automatique de nouvelles commandes.",
            "Generation active",
            "Generation arretee",
            "Nombre de commandes generees"
        );
    }
    return false;
}


int quantitePourNouvelleCommande() {
    if (quantiteCommandeFixeActive) return Math.max(1, quantiteCommandeFixe);
    int min = Math.max(1, quantiteCommandeMin);
    int max = Math.max(min, quantiteCommandeMax);
    if (max == min) return min;
    return min + (int) Math.floor(getDefaultRandomGenerator().nextDouble() * (max - min + 1));
}

double delaiAleatoireCourt(double min, double max) {
    if (!activerDelaisMetier) return 0.0;
    double a = Math.max(0.0, min);
    double b = Math.max(a, max);
    if (b <= a + 1e-9) return a;
    return a + getDefaultRandomGenerator().nextDouble() * (b - a);
}

CommandeAgent trouverCommandeParId(String idCommande) {
    if (idCommande == null) return null;
    for (CommandeAgent c : commandes) {
        if (c != null && idCommande.equals(c.idCommande)) return c;
    }
    return null;
}

// VSM-FIX-01 -- Registre temporel explicite des commandes clientes.
// Les instants tDebut/tFin servent uniquement a tracer l'etat runtime. Les
// durees publiees restent des durees metier enregistrees segment par segment.
boolean estOrdreReappro(CommandeAgent cmd) {
    return cmd != null && cmd.idCommande != null && cmd.idCommande.startsWith("REAPPRO_");
}

// Bloc M.3 -- anti-doublon REAPPRO PAR PRODUIT. Remplace, pour la decision de
// declenchement en mode multi-produit, le simple flag global
// productionAutonomeEnCours (voir verifierPolitiqueStockPourUnProduit() et
// declencherProductionAutonome() plus bas) : un REAPPRO actif sur un produit
// ne doit plus bloquer le declenchement d'un REAPPRO sur un AUTRE produit.
// "Actif" = statut reellement encore ouvert (ni SERVIE, ni EN_RETARD -- meme
// predicat de cloture que lierCommandeAuReapproActif()/finaliserDependanceReappro()
// ci-dessus, jamais EXPIRED/CLOSE/TERMINEE qui n'existent pas comme statuts
// dans ce master). En mono, cette fonction n'est jamais appelee : la garde
// legacy productionAutonomeEnCours reste seule utilisee, comportement
// strictement inchange.
boolean reapproActifPourProduit(String typeProduit) {
    if (typeProduit == null || commandes == null) return false;
    for (CommandeAgent c : commandes) {
        if (c == null || !estOrdreReappro(c)) continue;
        if (!typeProduit.equals(c.idScenario)) continue;
        if ("SERVIE".equals(c.statut) || "EN_RETARD".equals(c.statut)) continue;
        return true;
    }
    return false;
}

// Bloc M.3 -- vrai tant qu'AU MOINS UN ordre REAPPRO_x (tous produits
// confondus) reste ouvert. Utilisee UNIQUEMENT pour recalculer
// productionAutonomeEnCours a la cloture d'un REAPPRO (voir le traitement de
// fin de Make plus bas) : en multi-produit, clore le REAPPRO du produit A ne
// doit plus lever a tort la garde globale si le REAPPRO du produit B est
// toujours en cours. calculerBesoinsNets() (politique matiere autonome, hors
// perimetre de ce bloc) continue de s'appuyer sur productionAutonomeEnCours
// pour eviter un approvisionnement matiere concurrent pendant qu'un REAPPRO
// gere deja sa propre analyse matiere -- ce comportement est preserve a
// l'identique par cette fonction, qui ne fait que rendre le calcul exact en
// presence de plusieurs REAPPRO simultanes au lieu de le figer a false.
boolean existeReapproOuvert() {
    if (commandes == null) return false;
    for (CommandeAgent c : commandes) {
        if (c == null || !estOrdreReappro(c)) continue;
        if ("SERVIE".equals(c.statut) || "EN_RETARD".equals(c.statut)) continue;
        return true;
    }
    return false;
}

void ouvrirAttenteStockCommande(CommandeAgent client) {
    if (client == null || estOrdreReappro(client) || client.attenteStockOuverte || client.tDebutAttenteStock >= 0) return;
    client.attenteStockOuverte = true;
    client.tDebutAttenteStock = time();
    addTrace("BRUT", "MoteurCommande", client.idCommande, "COMMANDE", "GLOBAL",
        "ATTENTE_STOCK_DEBUT", "ORDER_WAITING_STATE", 0.0, "s", "COMMANDE_CLIENTE",
        Double.NaN, "", "Debut explicite de l'attente de disponibilite du stock fini");
}

int quantiteClientsCouverts(CommandeAgent reappro) {
    if (!estOrdreReappro(reappro)) return 0;
    int total = 0;
    for (String idClient : reappro.commandesClientesCouvertes) {
        CommandeAgent client = trouverCommandeParId(idClient);
        if (client != null) total += Math.max(0, client.qte);
    }
    return total;
}

void lierCommandeEtReappro(CommandeAgent client, CommandeAgent reappro) {
    if (client == null || reappro == null || estOrdreReappro(client) || !estOrdreReappro(reappro)) return;
    if (client.idCommande == null || reappro.idCommande == null) return;
    if (client.idScenario != null && reappro.idScenario != null && !client.idScenario.equals(reappro.idScenario)) return;
    if (!reappro.commandesClientesCouvertes.contains(client.idCommande)
            && quantiteClientsCouverts(reappro) >= Math.max(1, reappro.qte)) return;
    boolean nouveau = reappro.commandesClientesCouvertes.add(client.idCommande);
    client.ordresReapproLies.add(reappro.idCommande);
    if (nouveau && board != null) board.logEvent("[VSM-LINK] " + reappro.idCommande
        + " contribue a la satisfaction de " + client.idCommande);
}

void lierCommandeAuReapproActif(CommandeAgent client) {
    if (client == null || estOrdreReappro(client)) return;
    for (CommandeAgent reappro : commandes) {
        if (!estOrdreReappro(reappro)) continue;
        if ("SERVIE".equals(reappro.statut) || "EN_RETARD".equals(reappro.statut)) continue;
        lierCommandeEtReappro(client, reappro);
    }
}

void lierReapproAuxCommandesClientesEnAttente(CommandeAgent reappro) {
    if (!estOrdreReappro(reappro)) return;
    for (CommandeAgent client : commandes) {
        if (client == null || estOrdreReappro(client) || !client.attenteStockOuverte) continue;
        lierCommandeEtReappro(client, reappro);
    }
}

void finaliserDependanceReappro(CommandeAgent reappro) {
    if (!estOrdreReappro(reappro)) return;
    double dureeReappro = Math.max(0.0, reappro.dureeReelleAccumulee);
    for (String idClient : reappro.commandesClientesCouvertes) {
        CommandeAgent client = trouverCommandeParId(idClient);
        if (client == null || estOrdreReappro(client)) continue;
        if (!client.ordresReapproImputes.add(reappro.idCommande)) continue;
        client.dureeReapproImputeeReelleSec += dureeReappro;
        client.dureeAttenteStockReelleSec += dureeReappro;
        client.attenteStockOuverte = false;
        if (client.tFinAttenteStock < 0) {
            client.tFinAttenteStock = time();
            addTrace("BRUT", "MoteurCommande", client.idCommande, "COMMANDE", "GLOBAL",
                "ATTENTE_STOCK_FIN", "ORDER_WAITING_DWELL", dureeReappro, "s", "COMMANDE_CLIENTE",
                Double.NaN, "", "Attente imputee depuis l'ordre interne lie " + reappro.idCommande);
        }
    }
}

void actualiserRegistreTempsCommande(CommandeAgent cmd, double leadTimeRepli, double waitTimeRepli) {
    if (cmd == null || estOrdreReappro(cmd)) return;
    double traitement = cmd.dureeTraitementClientReelleSec;
    if (traitement <= 0.001) traitement = cmd.dureeReelleAccumulee > 0.001
        ? cmd.dureeReelleAccumulee : Math.max(0.001, leadTimeRepli);
    boolean attenteExplicite = cmd.tDebutAttenteStock >= 0 || cmd.dureeAttenteStockReelleSec > 0;
    double attente = attenteExplicite ? Math.max(0.0, cmd.dureeAttenteStockReelleSec) : Math.max(0.0, waitTimeRepli);
    cmd.dureeTraitementClientReelleSec = traitement;
    cmd.leadTimeClientReelSec = traitement + attente;
}

double orderProcessingTimeGlobal() {
    return board == null || board.kpiGlobal == null ? 0.0 : board.kpiGlobal.avgCycleTime();
}

double orderWaitingTimeGlobal() {
    return board == null || board.kpiGlobal == null ? 0.0 : board.kpiGlobal.avgWaitTime();
}

double orderFulfillmentLeadTimeGlobal() {
    return board == null || board.kpiGlobal == null ? 0.0 : board.kpiGlobal.avgLeadTime();
}

String sourceValeurAjoutee(PosteGenericAgent p) {
    return p != null && p.tauxVA > 0 ? "CONFIGUREE" : "FALLBACK";
}

String resumeSourceVAZener() {
    return "VA ESTIMEE, TAUX CONFIGURES OU FALLBACK SELON LE POSTE";
}

String[] manifesteRunColumns() {
    return new String[] { "Champ", "Valeur", "Source runtime" };
}

Object[][] manifesteRunRows() {
    ScenarioFlux sc = scenarioSelectionneInterface();
    String scenario = sc != null ? nomScenario(sc) : (champScenarioSelectionne == null ? "" : champScenarioSelectionne);
    return new Object[][] {
        {"runId", aboxEnsureRunId(), "Identifiant commun Excel et ABox"},
        {"nomScenario", scenario, "Scenario selectionne au lancement"},
        {"quantiteFixeCommande", quantiteCommandeFixeActive ? String.valueOf(Math.max(1, quantiteCommandeFixe)) : "NON_FIXEE", "Parametres d'orchestration"},
        {"nombreCommandes", String.valueOf(Math.max(1, nombreCommandesATester)), "Parametres d'orchestration"},
        {"simToRealSeconds", String.valueOf(simToRealSeconds), "Echelle configuree"},
        {"retardFournisseurActif", retardFournisseurTestActif ? "OUI" : "NON", "Perturbation runtime"},
        {"matiereCiblee", retardFournisseurCible == null ? "" : retardFournisseurCible, "Perturbation runtime"},
        {"facteurRetard", String.valueOf(facteurRetardFournisseur), "Perturbation runtime"},
        {"premiereReceptionSeulement", retardFournisseurUneSeuleReception ? "OUI" : "NON", "Perturbation runtime"},
        {"graineAleatoire", "NON_ACCESSIBLE_DANS_MAIN", "A renseigner depuis l'experience AnyLogic si disponible"},
        {"timestampCloture", aboxIsoAt(time()), "Horloge runtime"},
        {"presetJson", scenarioJsonFileName(), "Nom du preset accessible au modele"},
        {"modeleCandidate", "SCONTO_SVU_FINAL_VSM_FIX_CANDIDATE.alp", "Artefact a valider"}
    };
}

// C14.30 -- OPTION A, seconde partie. Le premier passage (C14.29) n'avait
// corrige que l'enregistrement des KPI (enregistrerTraceExecutionCommande),
// pas le temps REELLEMENT simule : le rythme de la commande est en verite
// pilote par planifierActionCommande(), qui utilisait des fenetres globales
// fixes (delaiXxxMinSec/MaxSec, 2 a 8s) sans aucun rapport avec les loiTemps
// des postes. Cette fonction calcule desormais un delai reel, echantillonne
// depuis les vraies loiTemps des postes concernes, pour que le temps qui
// s'ecoule VRAIMENT corresponde a ce qui est configure dans le scenario.
double dureeReelleChaine(String[] idsPostes) {
    double total = 0.0;
    for (String id : idsPostes) {
        try {
            PosteGenericAgent p = trouverPoste(id);
            if (p != null) total += p.dureeTraitement();
        } catch (Throwable ignored) {}
    }
    return total;
}

// C14.31 -- application de l'echelle simulation/temps reel a Source, Deliver,
// Return et Plan (tout sauf Make, sur decision explicite). Le deroule reste
// rapide et observable (division par simToRealSeconds au moment de planifier
// l'evenement), tandis que les durees REELLES (non divisees) continuent
// d'alimenter les traces et donc les indicateurs du tableau de bord via
// enregistrerTraceExecutionCommande, qui n'est pas touchee par cette fonction.
// Make (M1.x) n'utilise jamais cette fonction : ses lois de temps s'appliquent
// directement, sans conversion, au deroule comme aux indicateurs.
// C14.38 -- RETOUR A UNE ECHELLE FIXE. La tentative d'echelle dynamique
// (C14.33 : 1:1 pendant que Make tourne, 1:simToRealSeconds sinon) provoquait
// une regression plus grave que le probleme qu'elle visait a resoudre : des
// postes comme sS1.2.4 (loiTemps jusqu'a 21600s = 6h) ou sD1.3.4 (jusqu'a
// 1800s = 30min) se mettaient a retenir leurs jetons visuels pendant des
// HEURES de temps simule des qu'une production demarrait, creant des
// embouteillages massifs et invisibles sur Source/Deliver -- d'ou des
// changements d'etat GOULOT en cascade sur la vue hierarchique, sans rien de
// visible sur la vue des micro-activites au meme instant. Retour a une
// echelle fixe et previsible : Source/Deliver/Plan/Return restent toujours
// au rythme rapide (1:simToRealSeconds), Make reste toujours au rythme reel,
// sans bascule. Le decalage de rythme entre les deux domaines est assume
// comme une limite connue plutot que "corrige" par un mecanisme qui cree pire.
double dureeEchelle(double dureeReelle) {
    return dureeReelle / Math.max(1.0, simToRealSeconds);
}

// C14.34 -- planifie une action ET accumule, independamment de time(), la
// vraie duree (non mise a l'echelle) sur la commande concernee. Cet
// accumulateur sert de base fiable pour tout affichage en "temps reel"
// (popup, cartes de delai), quelle que soit l'echelle appliquee au moment
// precis ou chaque etape a ete programmee (l'echelle etant desormais
// dynamique, voir C14.33).
void planifierAvecEchelle(String type, CommandeAgent cmd, double dureeReelle) {
    if (cmd != null) {
        cmd.dureeReelleAccumulee += dureeReelle;
        if (!estOrdreReappro(cmd)) cmd.dureeTraitementClientReelleSec += Math.max(0.0, dureeReelle);
    }
    planifierActionCommande(type, cmd, dureeEchelle(dureeReelle));
}

// C14.39 -- LIAISON STABLE cercle <-> agent pour la vue hierarchique. Les
// fonctions couleurOperational/bordureOperational/visibleOperational/
// texteOperational/popupOperationalAgent lisaient opAgents.get(idx) : un
// index de POSITION dans une liste dont l'ordre interne change au fil des
// fusions et des reconstructions ("[ARCHITECTURE] Realignement termine",
// declenche a chaque cloture de commande). Le cercle N ne designait donc
// aucun agent en particulier -- juste "le Nieme element de la liste a cet
// instant" -- ce qui provoquait des changements d'etat en masse, sans rapport
// avec la vue des micro-activites, des que l'ordre interne changeait. Cette
// fonction retourne desormais une liste TRIEE (code SCOR + acteur), stable
// d'un appel a l'autre : le cercle N designe toujours le meme agent logique.
java.util.ArrayList<OperationalAgent> opAgentsTries() {
    // C14.40 -- opAgents est une Population AnyLogic, pas un java.util.List :
    // son constructeur ArrayList(Collection) n'est pas defini pour ce type.
    // Population reste iterable (for-each), donc on construit la liste par
    // une boucle explicite plutot que par le constructeur de copie.
    java.util.ArrayList<OperationalAgent> liste = new java.util.ArrayList<OperationalAgent>();
    for (OperationalAgent op : opAgents) liste.add(op);
    java.util.Collections.sort(liste, new java.util.Comparator<OperationalAgent>() {
        public int compare(OperationalAgent a, OperationalAgent b) {
            String ka = (a.codeSCOR == null ? "" : a.codeSCOR) + "|" + (a.idActeurSC == null ? "" : a.idActeurSC);
            String kb = (b.codeSCOR == null ? "" : b.codeSCOR) + "|" + (b.idActeurSC == null ? "" : b.idActeurSC);
            return ka.compareTo(kb);
        }
    });
    return liste;
}

void planifierActionCommande(String type, CommandeAgent cmd, double delaiSec) {
    if (cmd == null) return;
    planifierActionMetier(type, cmd.idCommande, delaiSec);
}

void planifierActionMetier(String type, String idCommande, double delaiSec) {
    double d = activerDelaisMetier ? Math.max(0.0, delaiSec) : 0.0;
    actionsMetierDifferees.add(new ActionMetierDifferee(time() + d, type, idCommande));
    board.logEvent("[ORCH] action " + type + " planifiee pour " + (idCommande == null ? "" : idCommande)
        + " a T+" + String.format("%.1f", d) + "s");
}

void planifierPremiereCommandeDemonstrative() {
    actionsMetierDifferees.clear();
    planifierActionMetier("GENERER_COMMANDE", "", delaiAleatoireCourt(delaiPremiereCommandeSec, delaiPremiereCommandeSec + 2.0));
}

void planifierProchaineCommandeSiBesoin() {
    if (!modeExecution || !modePilotageParCommande) return;
    if (limiterNombreCommandes && commandesGenereesDepuisDemarrage >= Math.max(1, nombreCommandesATester)) return;
    planifierActionMetier("GENERER_COMMANDE", "", delaiAleatoireCourt(delaiCommandeMinSec, delaiCommandeMaxSec));
}

void traiterActionsMetierDifferees() {
    if (!modeExecution || actionsMetierDifferees == null || actionsMetierDifferees.isEmpty()) return;
    java.util.ArrayList<ActionMetierDifferee> aExecuter = new java.util.ArrayList<ActionMetierDifferee>();
    java.util.Iterator<ActionMetierDifferee> it = actionsMetierDifferees.iterator();
    while (it.hasNext()) {
        ActionMetierDifferee a = it.next();
        if (a != null && time() + 1e-9 >= a.tExecution) {
            aExecuter.add(a);
            it.remove();
        }
    }
    for (ActionMetierDifferee a : aExecuter) {
        executerActionMetierDifferee(a);
    }
}

void executerActionMetierDifferee(ActionMetierDifferee a) {
    if (a == null) return;
    String type = a.type == null ? "" : a.type;
    if ("GENERER_COMMANDE".equals(type)) {
        genererCommande();
        return;
    }
    if ("ANIM_RETOUR_VEHICULE".equals(type)) {
        executerRetourVehiculeAnime(a.idCommande);
        return;
    }

    CommandeAgent cmd = trouverCommandeParId(a.idCommande);
    if (cmd == null) {
        board.logEvent("[ORCH] commande introuvable pour action " + type + " id=" + a.idCommande);
        return;
    }

    if ("RECEPTION_COMMANDE".equals(type)) {
        traiterCommande(cmd);
    } else if ("ANALYSE_STOCK".equals(type)) {
        analyserStockCommandeOrchestree(cmd);
    } else if ("ANALYSE_MATIERE".equals(type)) {
        analyserMatiereCommandeOrchestree(cmd);
    } else if ("FINALISER_APPROVISIONNEMENT".equals(type)) {
        finaliserApprovisionnementCommande(cmd);
    } else if ("LANCER_PRODUCTION".equals(type)) {
        lancerProductionCommande(cmd);
    } else if ("LIVRAISON_DIRECTE".equals(type)) {
        ScenarioFlux sc = scenarioPourCommande(cmd);
        PosteGenericAgent stock = trouverStockFiniPourScenario(sc);
        livrerCommandeDirectementDepuisStock(cmd, stock);
    } else if ("RECEPTION_CLIENT_DIRECTE".equals(type)) {
        finaliserReceptionClientDirecte(cmd);
    } else {
        board.logEvent("[ORCH] action inconnue : " + type + " pour " + a.idCommande);
    }
}

ScenarioFlux scenarioPourCommande(CommandeAgent cmd) {
    ScenarioFlux sc = null;
    if (cmd != null && cmd.idScenario != null) {
        for (ScenarioFlux s : scenarios) {
            if (s != null && s.typeProduit != null && s.typeProduit.equals(cmd.idScenario)) {
                sc = s;
                break;
            }
        }
    }
    // Une ancienne sélection Cas 1/2/3 ne doit jamais imposer une gamme.
    if (sc != null && estScenarioCasTest(sc)) {
        int idxNominal = indexScenarioNominal();
        if (idxNominal >= 0 && idxNominal < scenarios.size()) sc = scenarios.get(idxNominal);
    }
    if (sc == null) {
        int idxNominal = indexScenarioNominal();
        if (idxNominal >= 0 && idxNominal < scenarios.size()) sc = scenarios.get(idxNominal);
        else if (!scenarios.isEmpty()) sc = scenarios.get(0);
    }
    if (cmd != null && sc != null) cmd.idScenario = sc.typeProduit;
    return sc;
}

// C14.55 -- MTS PUR, PRODUIT FINI. Politique (s, Q) autonome, independante de
// toute commande client : verifie periodiquement si le stock produit fini
// (projete = stock + production deja en cours) est descendu au niveau ou en
// dessous du point de commande, et lance dans ce cas un ordre de fabrication
// interne de quantiteEconomiqueProduit unites. C'est cette politique -- et
// elle seule desormais -- qui decide quand produire ; les commandes clientes
// ne declenchent plus jamais leur propre production (voir la modification de
// analyserStockCommandeOrchestree ci-dessous).
// C14.61 -- Demande client reelle pour un scenario/produit donne, en unites/heure.
// Fonction commune, reutilisee par la politique produit fini ET par la
// politique matiere : les deux dependaient auparavant de previsionDemandeProduit(),
// alimentee uniquement par le debit de production deja realise
// (nbTerminesParProduit). Tant qu'aucune production n'a eu lieu, cette
// prevision reste nulle -- un probleme deja corrige cote produit fini
// (C14.57), mais pas cote matiere, qui utilisait encore l'ancienne prevision.
// Consequence observee : le premier reapprovisionnement matiere ne se
// declenchait jamais, ou seulement par hasard une fois la prevision de
// production devenue non nulle -- et la correction C14.59 (qui a par ailleurs
// arrete de compter a tort les unites REAPPRO_x comme des commandes) a aussi,
// par effet de bord, arrete de les compter dans nbTerminesParProduit,
// bloquant alors totalement cette prevision meme apres le demarrage de la
// production. Utiliser la demande CLIENT reelle (quantite totale commandee
// pour ce produit, quel que soit son mode de satisfaction) evite cette
// dependance fragile : elle existe des la premiere commande et ne depend
// d'aucune production prealable, reussie ou non.
double demandeHoraireReelleProduit(String typeProduitScenario) {
    if (typeProduitScenario == null || time() <= 0) return 0.0;
    double demandeCumulee = 0;
    for (CommandeAgent c : commandes) {
        // C14.63 -- BOUCLE DE RETROACTION CORRIGEE. Un ordre REAPPRO_x partage
        // le meme idScenario qu'une vraie commande cliente (affecte ainsi dans
        // declencherProductionAutonome). Sans cette exclusion, chaque
        // production autonome gonflait la demande CLIENT calculee ici, qui
        // gonflait a son tour le point de commande et la quantite economique
        // du cycle suivant (produit ET matiere, cette fonction etant partagee
        // depuis C14.61) -- provoquant des reapprovisionnements de plus en
        // plus gros et de plus en plus frequents, sans jamais se stabiliser :
        // exactement la croissance a vue d'oeil du stock matiere observee
        // (GPL a plusieurs dizaines de milliers d'unites).
        if (c != null && typeProduitScenario.equals(c.idScenario)
            && (c.idCommande == null || !c.idCommande.startsWith("REAPPRO_"))) {
            demandeCumulee += c.qte;
        }
    }
    return demandeCumulee * 3600.0 / time();
}

void verifierPolitiqueStockProduit() {
    if (!modeExecution) return;

    // Bloc M.3 -- en mode multi-produit, la politique doit etre evaluee
    // INDEPENDAMMENT pour chaque produit catalogue (jamais sur le stock
    // agrege) : voir verifierPolitiqueStockPourUnProduit() ci-dessous. La
    // branche MONO qui suit reste, elle, STRICTEMENT inchangee -- aucune
    // ligne modifiee par rapport au comportement legacy ZENER.
    if (modeMultiProduitActif) {
        // Snapshot stable AVANT la boucle (cf. bug ConcurrentModificationException
        // deja rencontre sur la lignee DataCo) : on ne parcourt jamais
        // listeProduits directement, au cas ou une fonction appelee depuis la
        // boucle resynchroniserait/reconstruirait le catalogue.
        synchroniserListeProduits();
        java.util.ArrayList<ScenarioFlux> produitsSnapshot =
            new java.util.ArrayList<ScenarioFlux>(listeProduits);
        for (ScenarioFlux scProduit : produitsSnapshot) {
            verifierPolitiqueStockPourUnProduit(scProduit);
        }
        return;
    }

    if (productionAutonomeEnCours) return;

    ScenarioFlux scRef = null;
    int idxNominal = indexScenarioNominal();
    if (idxNominal >= 0 && idxNominal < scenarios.size()) scRef = scenarios.get(idxNominal);
    else if (!scenarios.isEmpty()) scRef = scenarios.get(0);
    if (scRef == null) return;

    PosteGenericAgent stockFini = trouverStockFiniPourScenario(scRef);
    if (stockFini == null) return;
    double niveauActuel = stockFini.niveauStock;

    // C14.57 -- CORRECTIF D'UNE DEPENDANCE CIRCULAIRE. previsionDemandeProduit()
    // s'appuie sur previsionParProduit, lui-meme alimente uniquement par
    // nbTerminesParProduit -- un compteur de PRODUCTION reellement realisee.
    // Tant qu'aucune production n'a encore eu lieu (ce qui est precisement le
    // cas au demarrage d'un run MTS pur, ou les premieres commandes sont
    // servies sur stock), cette prevision reste bloquee a zero, la quantite
    // economique aussi, et la politique ne peut alors jamais se declencher :
    // la production ne demarre jamais car la prevision est nulle, et la
    // prevision reste nulle car la production n'a jamais demarre. On utilise
    // ici la demande CLIENT reelle (quantite totale commandee pour ce
    // scenario, quel que soit son mode de satisfaction), qui existe des la
    // toute premiere commande et ne depend d'aucune production prealable.
    double previsionHoraireProduit = demandeHoraireReelleProduit(scRef.typeProduit);
    // Delai de reconstitution estime : temps pour produire un lot Q* a la
    // cadence de production courante (554 bouteilles/h au goulot carrousel ;
    // valeur de repli si aucune estimation dynamique n'est disponible).
    double capaciteHoraireEstimee = 554.0;
    double delaiReconstitutionHeures = (quantiteEconomiqueProduit > 0 && capaciteHoraireEstimee > 0)
        ? quantiteEconomiqueProduit / capaciteHoraireEstimee : 1.0;

    pointCommandeProduit = champStockSecuriteProduit + previsionHoraireProduit * delaiReconstitutionHeures;

    if (quantiteEconomiqueProduit <= 0.0001) {
        double demandeAnnuelle = previsionHoraireProduit * 8760.0;
        double qBrut = calculerQuantiteEconomique(
            demandeAnnuelle, champCoutLancementProduction, champCoutPossessionProduitAnnuel);
        // C14.58 -- bornage indispensable (voir bornerQuantiteLot).
        double tailleCmdMoyenne = 0; int nbCmd = 0;
        for (CommandeAgent c : commandes) {
            if (c != null && c.idCommande != null && !c.idCommande.startsWith("REAPPRO_")) {
                tailleCmdMoyenne += c.qte; nbCmd++;
            }
        }
        tailleCmdMoyenne = (nbCmd > 0) ? tailleCmdMoyenne / nbCmd : 30.0;

        // C14.66 -- STABILISATION DES RUNS DE VALIDATION.
        // Wilson reste la reference de la politique (s,Q), mais lorsqu'un
        // backlog client reel existe deja, le lot autonome ne doit pas etre
        // surdimensionne a 5 commandes moyennes. On borne alors Q au besoin
        // client encore non couvert par le stock fini courant. Exemple du run
        // controle : CMD_1=20 et stock PF=0 => REAPPRO_1=20, jamais 100.
        double besoinClientOuvert = 0.0;
        for (CommandeAgent c : commandes) {
            if (c == null || c.idCommande == null || c.idCommande.startsWith("REAPPRO_")) continue;
            if (scRef.typeProduit != null && !scRef.typeProduit.equals(c.idScenario)) continue;
            boolean cloturee = "SERVIE".equals(c.statut) || "EN_RETARD".equals(c.statut);
            if (!cloturee) besoinClientOuvert += Math.max(0, c.qte);
        }
        double besoinNetClientOuvert = Math.max(0.0, besoinClientOuvert - Math.max(0.0, niveauActuel));
        double plafondProduit = Math.max(1.0, tailleCmdMoyenne * 5.0);
        double qRetenue = bornerQuantiteLot(qBrut, plafondProduit);
        if (besoinNetClientOuvert > 0.0001) {
            qRetenue = Math.min(qRetenue, besoinNetClientOuvert);
            qRetenue = Math.max(1.0, qRetenue);
        }
        quantiteEconomiqueProduit = qRetenue;
        board.logEvent("[STOCK] Q* produit fini : brut=" + String.format("%.0f", qBrut)
            + " -> retenu=" + String.format("%.0f", quantiteEconomiqueProduit)
            + " ; backlog=" + String.format("%.0f", besoinClientOuvert)
            + " ; besoinNet=" + String.format("%.0f", besoinNetClientOuvert)
            + " (point de commande=" + String.format("%.0f", pointCommandeProduit) + ")");
    }

    // C14.68 -- anti-REAPPRO_2 parasite : si le stock present suffit deja
    // a couvrir les commandes clientes encore ouvertes, on laisse d'abord
    // Deliver les reserver. Le cycle tactique sM (15 s) est plus rapide que
    // la reanalyse de stock des commandes (30 s) ; sans ce garde, un nouveau
    // REAPPRO pouvait partir dans cette fenetre alors que le lot precedent
    // venait juste de reconstituer exactement le besoin client.
    double demandeClienteOuverte = 0.0;
    for (CommandeAgent c : commandes) {
        if (c == null || c.idCommande == null || c.idCommande.startsWith("REAPPRO_")) continue;
        if (scRef.typeProduit != null && !scRef.typeProduit.equals(c.idScenario)) continue;
        boolean cloturee = "SERVIE".equals(c.statut) || "EN_RETARD".equals(c.statut);
        if (!cloturee && !"EN_LIVRAISON".equals(c.statut)) demandeClienteOuverte += Math.max(0, c.qte);
    }
    if (demandeClienteOuverte > 0.0001 && niveauActuel + 1e-9 >= demandeClienteOuverte) {
        return;
    }

    // Une campagne finie (nombre de commandes borne) ne relance pas une
    // reconstitution de securite apres livraison : le snapshot de validation
    // doit s'arreter sur le resultat du besoin teste, pas sur un cycle stock
    // suivant sans nouvelle demande client.
    if (modePilotageParCommande && limiterNombreCommandes
            && commandesGenereesDepuisDemarrage >= Math.max(1, nombreCommandesATester)) {
        int clients = 0;
        boolean tousClotures = true;
        boolean livraisonEnCours = false;
        for (CommandeAgent c : commandes) {
            if (c == null || c.idCommande == null || c.idCommande.startsWith("REAPPRO_")) continue;
            clients++;
            if ("EN_LIVRAISON".equals(c.statut)) livraisonEnCours = true;
            if (!("SERVIE".equals(c.statut) || "EN_RETARD".equals(c.statut))) tousClotures = false;
        }
        if (livraisonEnCours || (clients >= Math.max(1, nombreCommandesATester) && tousClotures)) return;
    }

    if (niveauActuel <= pointCommandeProduit && quantiteEconomiqueProduit > 0.0001) {
        declencherProductionAutonome(scRef, (int) Math.ceil(quantiteEconomiqueProduit));
    }
}

// Bloc M.3 -- politique (s, Q) autonome MTS evaluee pour UN SEUL produit
// catalogue, en mode multi-produit. Meme logique que la branche MONO
// ci-dessus (delai de reconstitution, formule de Wilson bornee, garde
// anti-REAPPRO_2 parasite, garde de fin de campagne), adaptee sur 3 points
// seulement :
//   1. stock lu via stockFiniDisponiblePourScenario() -- source de verite en
//      mode multi -- JAMAIS stockFini.niveauStock, qui n'est plus que
//      l'agregat de compatibilite (cf. bug M.2-TEST-FIX) ;
//   2. Q* cache PAR PRODUIT (quantiteEconomiqueParProduit) au lieu du champ
//      global quantiteEconomiqueProduit -- gele au premier calcul comme en
//      mono (C14.58/C14.66), mais independamment pour chaque reference ;
//   3. anti-doublon via reapproActifPourProduit(sc.typeProduit), PAS le
//      flag global productionAutonomeEnCours -- qui bloquerait a tort le
//      declenchement de B pendant que A est encore en cours (cas explicite
//      M.3 : A sous seuil et deja en reappro, B sous seuil => B doit quand
//      meme pouvoir demarrer).
// Le point de commande n'est PAS mis en cache : comme en mono, il est
// recalcule a chaque appel (jamais fige d'un cycle a l'autre).
// Seuil (champStockSecuriteProduit) et couts (champCoutLancementProduction/
// champCoutPossessionProduitAnnuel) restent les parametres GENERIQUES
// existants, appliques ici identiquement a chaque produit catalogue --
// aucun champ JSON par produit n'est introduit dans ce bloc (cf. audit M.3 :
// aucune configuration par produit n'existe deja pour ces 3 parametres).
void verifierPolitiqueStockPourUnProduit(ScenarioFlux scRef) {
    if (scRef == null || scRef.typeProduit == null) return;
    if (reapproActifPourProduit(scRef.typeProduit)) return;

    PosteGenericAgent stockFini = trouverStockFiniPourScenario(scRef);
    if (stockFini == null) return;
    double niveauActuel = stockFiniDisponiblePourScenario(scRef, stockFini);

    String cle = cleProduit(scRef.typeProduit);
    double previsionHoraireProduit = demandeHoraireReelleProduit(scRef.typeProduit);
    double capaciteHoraireEstimee = 554.0;

    Double qEcoCache = quantiteEconomiqueParProduit.get(cle);
    double qEco = (qEcoCache != null) ? qEcoCache.doubleValue() : 0.0;

    double delaiReconstitutionHeures = (qEco > 0 && capaciteHoraireEstimee > 0)
        ? qEco / capaciteHoraireEstimee : 1.0;

    double ptCommande = champStockSecuriteProduit + previsionHoraireProduit * delaiReconstitutionHeures;

    if (qEco <= 0.0001) {
        double demandeAnnuelle = previsionHoraireProduit * 8760.0;
        double qBrut = calculerQuantiteEconomique(
            demandeAnnuelle, champCoutLancementProduction, champCoutPossessionProduitAnnuel);
        double tailleCmdMoyenne = 0; int nbCmd = 0;
        for (CommandeAgent c : commandes) {
            if (c != null && c.idCommande != null && !c.idCommande.startsWith("REAPPRO_")
                    && scRef.typeProduit.equals(c.idScenario)) {
                tailleCmdMoyenne += c.qte; nbCmd++;
            }
        }
        tailleCmdMoyenne = (nbCmd > 0) ? tailleCmdMoyenne / nbCmd : 30.0;

        double besoinClientOuvert = 0.0;
        for (CommandeAgent c : commandes) {
            if (c == null || c.idCommande == null || c.idCommande.startsWith("REAPPRO_")) continue;
            if (!scRef.typeProduit.equals(c.idScenario)) continue;
            boolean cloturee = "SERVIE".equals(c.statut) || "EN_RETARD".equals(c.statut);
            if (!cloturee) besoinClientOuvert += Math.max(0, c.qte);
        }
        double besoinNetClientOuvert = Math.max(0.0, besoinClientOuvert - Math.max(0.0, niveauActuel));
        double plafondProduit = Math.max(1.0, tailleCmdMoyenne * 5.0);
        double qRetenue = bornerQuantiteLot(qBrut, plafondProduit);
        if (besoinNetClientOuvert > 0.0001) {
            qRetenue = Math.min(qRetenue, besoinNetClientOuvert);
            qRetenue = Math.max(1.0, qRetenue);
        }
        qEco = qRetenue;
        quantiteEconomiqueParProduit.put(cle, qEco);
        if (board != null) board.logEvent("[STOCK][" + scRef.typeProduit + "] Q* produit fini : brut=" + String.format("%.0f", qBrut)
            + " -> retenu=" + String.format("%.0f", qEco)
            + " ; backlog=" + String.format("%.0f", besoinClientOuvert)
            + " ; besoinNet=" + String.format("%.0f", besoinNetClientOuvert)
            + " (point de commande=" + String.format("%.0f", ptCommande) + ")");
    }

    // C14.68 (adapte par produit) -- anti-REAPPRO parasite : si le stock
    // present suffit deja a couvrir les commandes clientes de CE produit
    // encore ouvertes, on laisse d'abord Deliver les reserver.
    double demandeClienteOuverte = 0.0;
    for (CommandeAgent c : commandes) {
        if (c == null || c.idCommande == null || c.idCommande.startsWith("REAPPRO_")) continue;
        if (!scRef.typeProduit.equals(c.idScenario)) continue;
        boolean cloturee = "SERVIE".equals(c.statut) || "EN_RETARD".equals(c.statut);
        if (!cloturee && !"EN_LIVRAISON".equals(c.statut)) demandeClienteOuverte += Math.max(0, c.qte);
    }
    if (demandeClienteOuverte > 0.0001 && niveauActuel + 1e-9 >= demandeClienteOuverte) {
        return;
    }

    // Garde de fin de campagne -- IDENTIQUE a la branche mono, volontairement
    // NON filtree par produit : nombreCommandesATester est un parametre de
    // run GLOBAL (aucune configuration par produit n'existe), donc la fin de
    // campagne reste une notion globale, tous produits confondus.
    if (modePilotageParCommande && limiterNombreCommandes
            && commandesGenereesDepuisDemarrage >= Math.max(1, nombreCommandesATester)) {
        int clients = 0;
        boolean tousClotures = true;
        boolean livraisonEnCours = false;
        for (CommandeAgent c : commandes) {
            if (c == null || c.idCommande == null || c.idCommande.startsWith("REAPPRO_")) continue;
            clients++;
            if ("EN_LIVRAISON".equals(c.statut)) livraisonEnCours = true;
            if (!("SERVIE".equals(c.statut) || "EN_RETARD".equals(c.statut))) tousClotures = false;
        }
        if (livraisonEnCours || (clients >= Math.max(1, nombreCommandesATester) && tousClotures)) return;
    }

    if (niveauActuel <= ptCommande && qEco > 0.0001) {
        if (board != null) board.logEvent("[STOCK][" + scRef.typeProduit + "] sous seuil : stock="
            + String.format("%.0f", niveauActuel) + " seuil=" + String.format("%.0f", ptCommande));
        declencherProductionAutonome(scRef, (int) Math.ceil(qEco));
    }
}

// Lance un ordre de fabrication interne, non rattache a un client : la
// commande synthetique creee ici ne sert qu'a reutiliser le pipeline Make
// existant (routage, KPI, cloture). Sa cloture est interceptee plus loin
// (cf. C14.55 dans finDeParcours) pour ne jamais tenter de "livrer" ce lot a
// un client -- le credit de stock a lieu deja naturellement au poste de
// stockage (sM1.5.1), comme pour toute production.
void declencherProductionAutonome(ScenarioFlux sc, int quantite) {
    if (sc == null || quantite <= 0) return;
    // Bloc M.3 -- en mono, garde legacy inchangee (flag global : un seul
    // produit ne peut jamais avoir 2 REAPPRO actifs en meme temps). En
    // multi, la garde devient PAR PRODUIT (reapproActifPourProduit()) : un
    // REAPPRO actif sur A ne bloque plus un declenchement sur B.
    if (!modeMultiProduitActif && productionAutonomeEnCours) return;
    if (modeMultiProduitActif && reapproActifPourProduit(sc.typeProduit)) return;
    productionAutonomeEnCours = true;

    CommandeAgent cmd = add_commandes();
    cmd.idCommande   = "REAPPRO_" + (++seqCommandeAutonome);
    cmd.typeCommande = "MTS";
    cmd.qte          = quantite;
    cmd.tCreation    = time();
    cmd.tPromise     = time() + delaiPromessePourMode("MTS");
    cmd.statut       = "EN_COURS";
    cmd.idScenario   = sc.typeProduit;

    // VSM-FIX-02 -- le lien runtime est cree a partir des objets, jamais du
    // nom, d'un timestamp ou d'une deduction apres le run.
    lierReapproAuxCommandesClientesEnAttente(cmd);

    board.logEvent("[STOCK] Production autonome declenchee : " + cmd.idCommande
        + " qte=" + quantite + " (point de commande atteint, Q*=" + String.format("%.1f", quantiteEconomiqueProduit) + ")");

    // ETAPE 3.3 -- CORRECTIF BLOQUANT RUN A/B.
    // Un ordre autonome ne doit jamais entrer directement dans Make lorsque
    // les matieres sont absentes. Il passe d'abord par la meme analyse de
    // disponibilite matiere que toute production : si la nomenclature n'est
    // pas couverte, Source est declenche, la reception est differee selon le
    // delai fournisseur (force ou non), puis Make demarre seulement apres
    // MaterialAvailable. C'est aussi ce chemin qui rend le retard fournisseur
    // effectivement mesurable dans le Run B.
    analyserMatiereCommandeOrchestree(cmd);
}

void analyserStockCommandeOrchestree(CommandeAgent cmd) {
    if (cmd == null || !modeExecution) return;
    // Un retry programme avant le reveil peut arriver pendant Deliver ou
    // apres la cloture. Il ne doit ni rouvrir l'attente, ni relancer la
    // politique de stock, ni programmer une nouvelle analyse.
    if ("EN_LIVRAISON".equals(cmd.statut) || "SERVIE".equals(cmd.statut) || "EN_RETARD".equals(cmd.statut)) return;

    ScenarioFlux sc = scenarioPourCommande(cmd);
    PosteGenericAgent stockFini = (sc != null) ? trouverStockFiniPourScenario(sc) : null;
    double stockProduitDisponible = stockFiniDisponiblePourScenario(sc, stockFini);
    boolean pullDepuisStock = "MTS".equals(cmd.typeCommande)
        && stockFini != null
        && stockProduitDisponible >= cmd.qte;

    if (pullDepuisStock) {
        String caD = idCoordinateurCommande("D", cmd);
        String supD = idSuperviseurCommande("D", 3, cmd);
        String aoD = idExecutionCommande("D", 8, cmd);
        tracerFluxHierarchique("AMENDMENT", "AT-sP4", caD, "DeliveryPlan",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";mode=livraison_directe",
            cmd, "Deliver", "Plan de livraison validé");
        tracerFluxHierarchique("AMENDMENT", caD, supD, "DeliveryOrder",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Deliver", "Ordre transmis au superviseur Deliver");
        tracerFluxHierarchique("AMENDMENT", supD, aoD, "ReserveInventory",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Deliver", "Instruction d'exécution transmise");
        tracerFluxHierarchique("EXECUTION", aoD, supD, "InventoryReserved",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Deliver", "Stock réservé pour la commande");
        double avant = stockProduitDisponible;
        consommerStockFiniProduit(sc, cmd.qte, stockFini);
        // C14.68 -- etat transitoire explicite : le stock est deja reserve et
        // preleve, mais la reception client n'est pas encore cloturee. Ce
        // statut empeche la politique autonome de confondre ce stock preleve
        // avec un nouveau manque a produire pendant les quelques secondes de
        // la chaine Deliver.
        cmd.statut = "EN_LIVRAISON";
        board.logEvent("[MTS] " + cmd.idCommande + " servie depuis le stock (" + stockFini.nom
            + "), produit=" + codeProduitCommande(cmd) + ", stock restant=" + (int) stockFiniDisponiblePourScenario(sc, stockFini));
        ajouterSuiviDetaille(
            "Decision MTS",
            "Stock produit fini suffisant",
            "ZENER verifie le magasin produit fini et constate que la commande peut etre livree directement.",
            "Agent operationnel de pilotage Deliver",
            "Agent Order " + cmd.idCommande,
            "Commande " + cmd.idCommande,
            "Produit=" + codeProduitCommande(cmd) + " ; Demande=" + cmd.qte + " ; disponible avant=" + (int) avant + " ; restant=" + (int) stockFiniDisponiblePourScenario(sc, stockFini),
            stockFini.nom,
            "Preparation livraison",
            "Stock fini -> Deliver",
            "D1.3 / D1.8",
            "Servir la commande depuis le stock fini.",
            "Commande validee",
            "Livraison directe autorisee",
            "Taux de satisfaction stock ; quantite consommee du stock fini ; delai de reponse commande"
        );
        afficherPopupMetier("Decision stock", "Stock produit fini suffisant", "La commande " + cmd.idCommande
            + " peut etre livree directement depuis le stock fini. Quantite=" + cmd.qte
            + " ; stock restant=" + (int) stockFini.niveauStock, "ESSENTIEL");
        planifierAvecEchelle("LIVRAISON_DIRECTE", cmd, dureeReelleChaine(new String[]{"sD1.5.4","sD1.6.1","sD1.7.1","sD1.8.1","sD1.9.1","sD1.10.1","sD1.11.4","sD1.12.4"}));
        return;
    }

    if ("MTS".equals(cmd.typeCommande)) {
        // C14.55 -- MTS PUR. La commande ne declenche plus sa propre
        // production (suppression de la requalification MTO et de
        // l'enchainement ANALYSE_MATIERE/LANCER_PRODUCTION introduits en
        // C14.17). Seule la politique de stock autonome
        // (verifierPolitiqueStockProduit()) decide de produire, independamment
        // des commandes. Une commande qui trouve le stock insuffisant patiente
        // simplement : elle reessaie l'analyse de stock un peu plus tard,
        // le temps que la politique de reapprovisionnement autonome
        // reconstitue le niveau necessaire.
        String detailStock = stockFini != null ? (stockFini.nom + "=" + (int) stockFini.niveauStock) : "aucun poste stock fini detecte";
        board.logEvent("[MTS] " + cmd.idCommande + " : stock insuffisant (" + detailStock + "), en attente de reconstitution autonome du stock.");
        ajouterSuiviDetaille(
            "Decision MTS",
            "Stock produit fini insuffisant, attente de reconstitution",
            "ZENER ne dispose pas d'assez de produits finis pour livrer directement la commande. La commande attend que la politique de stock autonome reconstitue le niveau necessaire.",
            "Agent operationnel de pilotage Deliver",
            "Agent Order " + cmd.idCommande,
            "Commande " + cmd.idCommande,
            "Demande=" + cmd.qte + " ; " + detailStock,
            "Magasin produits finis",
            "Attente de reapprovisionnement",
            "Deliver (en attente)",
            "D1.3",
            "Patienter jusqu'a reconstitution du stock par la politique autonome.",
            "Commande validee",
            "Stock insuffisant, en attente",
            "Taux de satisfaction stock ; delai d'attente avant livraison"
        );
        afficherPopupMetier("Decision stock", "Stock produit fini insuffisant", "La commande " + cmd.idCommande
            + " attend la reconstitution du stock par la politique de reapprovisionnement autonome.", "DETAILLE");

        ouvrirAttenteStockCommande(cmd);
        lierCommandeAuReapproActif(cmd);

        // ETAPE 3.3 -- ne plus attendre le prochain cycle tactique sM (15 s)
        // pour lancer la reconstitution. La demande cliente vient d'etre
        // observee : on reevalue immediatement la politique produit. Le cycle
        // tactique periodique reste actif comme filet de securite.
        verifierPolitiqueStockProduit();
        planifierActionCommande("ANALYSE_STOCK", cmd, 30.0);
        return;
    }

    // C14.55 -- garde de securite : si le mode configure n'est pas MTS (cas
    // non couvert par cette refonte, jamais rencontre dans les tests de
    // cette session), on reessaie quand meme plutot que de laisser la
    // commande sans suite programmee.
    board.logEvent("[STOCK] " + cmd.idCommande + " : mode " + cmd.typeCommande
        + " non couvert par la politique MTS pure, nouvelle tentative programmee par securite.");
    planifierActionCommande("ANALYSE_STOCK", cmd, 30.0);
}
void analyserMatiereCommandeOrchestree(CommandeAgent cmd) {
    if (cmd == null || !modeExecution) return;

    ScenarioFlux sc = scenarioPourCommande(cmd);
    if (sc == null) {
        cmd.statut = "BLOQUE_CONFIG";
        board.logEvent("[ERREUR CAS] Aucun scenario produit resolu pour " + cmd.idCommande + ". Production bloquee.");
        afficherPopupMetier("Configuration invalide", "Scenario produit introuvable",
            "La commande " + cmd.idCommande + " ne peut pas poursuivre sans scenario nominal.", "ESSENTIEL");
        return;
    }
    if (sc.nomenclature == null || sc.nomenclature.isEmpty()) {
        cmd.statut = "BLOQUE_NOMENCLATURE";
        board.logEvent("[ERREUR MATIERE] Scenario \"" + nomScenario(sc)
            + "\" sans nomenclature pour " + cmd.idCommande + ". Cas 2/3 interdit en mode fail-closed.");
        afficherPopupMetier("Configuration invalide", "Nomenclature absente",
            "Le scenario nominal \"" + nomScenario(sc)
            + "\" ne possede aucune nomenclature. Configurez les matieres avant de relancer le Cas 2 ou le Cas 3.",
            "ESSENTIEL");
        return;
    }

    boolean matOK = matieresSuffisantesPourScenario(sc, cmd.qte);
    boolean profilCas2 = profilTestActif != null
        && profilTestActif.toUpperCase(java.util.Locale.ROOT).contains("CAS 2");
    boolean profilCas3 = profilTestActif != null
        && profilTestActif.toUpperCase(java.util.Locale.ROOT).contains("CAS 3");
    String bilan = bilanMatierePourScenario(sc, cmd.qte);

    // Les profils pilotent les stocks initiaux ; ils ne doivent plus ecraser la decision calculee.
    // Un ecart est journalise pour rendre visible un profil mal applique ou une nomenclature incoherente.
    if (profilCas2 && !matOK) {
        board.logEvent("[ALERTE PROFIL CAS 2] Matieres attendues disponibles mais bilan insuffisant : " + bilan);
    }
    if (profilCas3 && matOK) {
        board.logEvent("[ALERTE PROFIL CAS 3] Matieres attendues insuffisantes mais bilan disponible : " + bilan);
    }
    board.logEvent("[DEBUG CAS] commande=" + cmd.idCommande
        + " | profil=" + profilTestActif
        + " | scenario=" + nomScenario(sc)
        + " | nomenclature=" + sc.nomenclature.size()
        + " | stockInitialMatiere=" + champStockInitialMatiereGlobal
        + " | bilan=" + bilan
        + " | matOK=" + matOK);

    String caMCheck = idCoordinateurCommande("M", cmd);
    String supMCheck = idSuperviseurCommande("M", 1, cmd);
    String aoMCheck = idExecutionCommande("M", 2, cmd);

    // S2.2/S3.2 a S2.9/S3.7 : faisabilite Make.
    tracerFluxHierarchique("AMENDMENT", "AT-sP3", caMCheck, "MakeFeasibilityCheck",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Make", "Evaluation de la capacite et des matieres demandee");
    tracerFluxHierarchique("AMENDMENT", caMCheck, supMCheck, "CapacityAndMaterialCheckOrder",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Make", "Ordre de verification capacite/matiere transmis");
    tracerFluxHierarchique("AMENDMENT", supMCheck, aoMCheck, "CapacityCheckRequest",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Make", "Verification de capacite demandee");
    tracerFluxHierarchique("AMENDMENT", supMCheck, aoMCheck, "MaterialCheckRequest",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Make", "Verification de disponibilite matiere demandee");
    tracerFluxHierarchique("REPORT", aoMCheck, supMCheck, "CapacityAvailabilityResponse",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";capacite=disponible",
        cmd, "Make", "Capacite disponible et creneau estime");
    tracerFluxHierarchique("REPORT", aoMCheck, supMCheck,
        matOK ? "MaterialAvailabilityResponse" : "MaterialShortageDetected",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";" + bilan,
        cmd, "Make", matOK ? "Matieres disponibles" : "Matieres insuffisantes");
    tracerFluxHierarchique("REPORT", supMCheck, caMCheck,
        matOK ? "MakeOperationalFeasibility" : "MakeConstraintReport",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";" + bilan,
        cmd, "Make", matOK ? "Faisabilite operationnelle confirmee" : "Reapprovisionnement necessaire");
    tracerFluxHierarchique("REPORT", caMCheck, "AT-sP3", "MakeFeasibilityResponse",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte
        + ";matiere=" + (matOK ? "OK" : "MANQUANTE"),
        cmd, "Plan Make", "Resultat de faisabilite Make transmis");

    ajouterSuiviDetaille(
        "Decision matiere",
        matOK ? "Matieres suffisantes pour produire" : "Matieres insuffisantes pour produire",
        matOK
            ? "La nomenclature du produit est verifiee : les matieres disponibles permettent de lancer la production."
            : "La nomenclature du produit est verifiee : au moins une matiere manque. Le modele declenche Source avant Make.",
        "Agent operationnel de pilotage Source/Make",
        "Agent Order " + cmd.idCommande,
        "Commande " + cmd.idCommande,
        "Quantite=" + cmd.qte,
        "Nomenclature / stock matiere",
        matOK ? "Production Make" : "Approvisionnement Source",
        matOK ? "Stock matiere -> Make" : "MRP -> fournisseurs",
        matOK ? "M1.1" : "P2.3 / S1.1",
        matOK ? "Lancer la production." : "Commander et recevoir les matieres manquantes avant le lancement Make.",
        "Commande a produire",
        matOK ? "Production autorisee" : "Approvisionnement requis",
        bilan + " ; metriques : besoin brut, stock disponible, besoin net"
    );
    afficherPopupMetier("Decision matiere",
        matOK ? "Matieres suffisantes" : "Matieres insuffisantes",
        bilan, matOK ? "DETAILLE" : "ESSENTIEL");

    String caS = "";
    String supS = "";
    String aoS = "";
    String aoReceiving = "";

    if (!matOK) {
        caS = idCoordinateurCommande("S", cmd);
        supS = idSuperviseurCommande("S", 1, cmd);
        aoS = idExecutionCommande("S", 2, cmd);
        aoReceiving = idExecutionCommande("S", 3, cmd);

        // S3.8 a S3.17 : analyse de faisabilite Source.
        tracerFluxHierarchique("AMENDMENT", "AT-sP3", "AT-sP2", "MaterialAvailabilityRequest",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";" + bilan,
            cmd, "Plan Make -> Plan Source", "Demande tactique de disponibilite matiere");
        tracerFluxHierarchique("AMENDMENT", "AT-sP2", caS, "SourceFeasibilityRequest",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Source", "Evaluation fournisseur et delai demandee");
        tracerFluxHierarchique("AMENDMENT", caS, supS, "SupplierCheckOrder",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Source", "Ordre de consultation fournisseur transmis");
        tracerFluxHierarchique("AMENDMENT", supS, aoS, "SupplierAvailabilityCheck",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Source", "Disponibilite, prix et delai a verifier");
        tracerFluxHierarchique("AMENDMENT", aoS, "SupplierActor", "RequestForAvailability",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";" + bilan,
            cmd, "Source", "Demande de disponibilite envoyee au fournisseur");
        tracerFluxHierarchique("REPORT", "SupplierActor", aoS, "SupplierCommitment",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Source", "Engagement fournisseur recu");
        tracerFluxHierarchique("REPORT", aoS, supS, "SupplierAvailabilityResponse",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Source", "Reponse fournisseur synthetisee");
        tracerFluxHierarchique("REPORT", supS, caS, "SourceOperationalFeasibility",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Source", "Faisabilite operationnelle Source confirmee");
        tracerFluxHierarchique("REPORT", caS, "AT-sP2", "SourceFeasibilityResponse",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Plan Source", "Date de reception matiere proposee");
        tracerFluxHierarchique("REPORT", "AT-sP2", "AT-sP3", "MaterialAvailabilityResponse",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Plan Source -> Plan Make", "Date previsionnelle de disponibilite matiere transmise");
    }

    // S2.10 / S3.18, puis confirmation client.
    tracerFluxHierarchique("REPORT", "AT-sP3", "AT-sP4", "MakeFeasibilityResponse",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte
        + ";matiereDisponible=" + matOK,
        cmd, "Plan Make -> Plan Deliver",
        "Date previsionnelle de fin de production transmise");

    String caDConfirm = idCoordinateurCommande("D", cmd);
    String supDConfirm = idSuperviseurCommande("D", 3, cmd);
    String aoDConfirm = idExecutionCommande("D", 2, cmd);
    tracerFluxHierarchique("AMENDMENT", "AT-sP4", caDConfirm, "PromisedDeliveryDate",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte
        + ";strategie=" + cmd.typeCommande,
        cmd, "Deliver", "Date promise calculee et transmise");
    tracerFluxHierarchique("AMENDMENT", caDConfirm, supDConfirm, "OrderConfirmationOrder",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Deliver", "Instruction de confirmer la commande au client");
    tracerFluxHierarchique("AMENDMENT", supDConfirm, aoDConfirm, "CustomerConfirmationTask",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Deliver", "Tache de confirmation client affectee");
    tracerFluxHierarchique("REPORT", aoDConfirm, "CustomerActor", "OrderConfirmed",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Deliver", "Commande confirmee au client");

    if (!matOK) {
        // S3.22 a S3.26 : lancement Source. La reception est volontairement differee.
        tracerFluxHierarchique("AMENDMENT", "AT-sP2", caS, "ProcurementPlan",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";" + bilan,
            cmd, "Source", "Plan d'approvisionnement valide");
        tracerFluxHierarchique("AMENDMENT", caS, supS, "ProcurementOrder",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Source", "Ordre transmis au superviseur Source");
        tracerFluxHierarchique("AMENDMENT", supS, aoS, "PurchaseOrderTask",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Source", "Instruction d'approvisionnement transmise");
        tracerFluxHierarchique("AMENDMENT", aoS, "SupplierActor", "PurchaseOrder",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";" + bilan,
            cmd, "Source", "Commande d'achat officielle envoyee");
        tracerFluxHierarchique("EXECUTION", "SupplierActor", aoReceiving, "InboundDelivery",
            "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
            cmd, "Source", "Livraison physique fournisseur en cours");

        cmd.statut = "EN_APPROVISIONNEMENT";
        // Le delai est calcule AVANT de marquer la perturbation comme consommee :
        // le premier approvisionnement cible doit conserver son delai effectif force.
        double delaiApproReel = delaiApprovisionnementReelMax(sc, cmd.qte);
        declencherApprovisionnementCommande(cmd, sc, cmd.qte);
        consommerRetardFournisseurPourScenario(sc, cmd.qte, cmd);
        planifierAvecEchelle("FINALISER_APPROVISIONNEMENT", cmd, delaiApproReel);
        board.logEvent("[SOURCE] " + cmd.idCommande
            + " en attente de reception matiere ; production suspendue pendant "
            + String.format("%.1f", dureeEchelle(delaiApproReel)) + "s (deroule) / "
            + String.format("%.1f", delaiApproReel / 3600.0) + "h (reel).");
        return;
    }

    tracerEtPlanifierProductionCommande(cmd);
}

void tracerEtPlanifierProductionCommande(CommandeAgent cmd) {
    if (cmd == null || !modeExecution) return;
    ScenarioFlux sc = scenarioPourCommande(cmd);
    if (sc == null || sc.nomenclature == null || sc.nomenclature.isEmpty()) {
        cmd.statut = "BLOQUE_NOMENCLATURE";
        board.logEvent("[MAKE] Production refusee pour " + cmd.idCommande + " : scenario/nomenclature invalide.");
        return;
    }
    if (!matieresSuffisantesPourScenario(sc, cmd.qte)) {
        cmd.statut = "BLOQUE_MATIERE";
        board.logEvent("[MAKE] Production refusee pour " + cmd.idCommande
            + " : matieres encore insuffisantes apres verification.");
        return;
    }

    String caM = idCoordinateurCommande("M", cmd);
    String supM = idSuperviseurCommande("M", 1, cmd);
    String aoM = idExecutionCommande("M", 2, cmd);
    tracerFluxHierarchique("AMENDMENT", "AT-sP3", caM, "ProductionPlan",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Make", "Plan de production valide");
    tracerFluxHierarchique("AMENDMENT", caM, supM, "ProductionOrder",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Make", "Ordre transmis au superviseur Make");
    tracerFluxHierarchique("AMENDMENT", supM, aoM, "ProductionTaskAssignment",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Make", "Tache affectee a l'execution Make");

    // C14.3 — visualiser les deux entrées validées qui préparent Make,
    // sans modifier le moteur de production ni les KPI métier.
    lancerFluxVisuelLancementProduction(cmd);
    lancerFluxVisuelApproMatiereProduction(cmd);

    cmd.statut = "PRODUCTION_PLANIFIEE";
    planifierAvecEchelle("LANCER_PRODUCTION", cmd, dureeReelleChaine(new String[]{"sP3.4.1"}));
}

void finaliserApprovisionnementCommande(CommandeAgent cmd) {
    if (cmd == null || !modeExecution) return;
    ScenarioFlux sc = scenarioPourCommande(cmd);
    if (sc == null || sc.nomenclature == null || sc.nomenclature.isEmpty()) {
        cmd.statut = "BLOQUE_NOMENCLATURE";
        board.logEvent("[SOURCE] Reception impossible pour " + cmd.idCommande + " : nomenclature absente.");
        return;
    }

    boolean configurationOK = true;
    StringBuilder reception = new StringBuilder();
    for (LigneNomenclature l : sc.nomenclature) {
        if (l == null || l.idMatiere == null || l.idMatiere.trim().isEmpty() || l.quantiteParUnite <= 0) {
            configurationOK = false;
            board.logEvent("[SOURCE] Ligne de nomenclature invalide pour " + cmd.idCommande + ".");
            continue;
        }
        FicheMatiere f = trouverFicheMatiere(l.idMatiere);
        if (f == null) {
            configurationOK = false;
            board.logEvent("[SOURCE] Fiche matiere absente : " + l.idMatiere + " / " + cmd.idCommande);
            continue;
        }
        double besoin = l.quantiteParUnite * Math.max(1, cmd.qte);
        double manque = Math.max(0.0, besoin - f.stockDisponible);
        if (manque > 0.0001) f.stockDisponible += manque;
        if (reception.length() > 0) reception.append(" ; ");
        reception.append(l.idMatiere)
            .append(" recu=").append(String.format("%.1f", manque))
            .append(" stock=").append(String.format("%.1f", f.stockDisponible));

        ajouterSuiviDetaille(
            "Reception matiere",
            "Matiere recue et disponible pour production",
            "La matiere commandee est ajoutee au stock uniquement apres la fin differee du flux Source.",
            "Agent operationnel de pilotage Source",
            "Agent d'execution S1.2 / S1.3",
            "Matiere " + l.idMatiere + " pour " + cmd.idCommande,
            "Besoin=" + String.format("%.1f", besoin) + " ; recu=" + String.format("%.1f", manque)
                + " ; stock apres=" + String.format("%.1f", f.stockDisponible),
            fournisseurPourMatiere(l.idMatiere),
            "ZENER SA Togo",
            "Supplier D1.12 -> Manufacturer S1.2 -> S1.3",
            "S1.2 / S1.3",
            "Controler puis liberer la matiere pour Make.",
            "Approvisionnement en cours",
            "Matiere disponible",
            "Stock matiere ; quantite recue ; temps d'attente approvisionnement"
        );
    }

    if (!configurationOK || !matieresSuffisantesPourScenario(sc, cmd.qte)) {
        cmd.statut = "BLOQUE_MATIERE";
        board.logEvent("[SOURCE] " + cmd.idCommande
            + " reste bloquee apres reception : " + bilanMatierePourScenario(sc, cmd.qte));
        afficherPopupMetier("Approvisionnement", "Reception incomplete",
            "Les matieres de " + cmd.idCommande + " restent insuffisantes ou mal configurees.", "ESSENTIEL");
        return;
    }

    String caS = idCoordinateurCommande("S", cmd);
    String supS = idSuperviseurCommande("S", 1, cmd);
    String aoReceiving = idExecutionCommande("S", 3, cmd);
    tracerFluxHierarchique("EXECUTION", aoReceiving, supS, "MaterialReceived",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte
        + ";resultat=conforme;" + reception.toString(),
        cmd, "Source", "Matieres recues, controlees et mises en stock");
    tracerFluxHierarchique("REPORT", supS, caS, "OperationalReport",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte
        + ";approvisionnement=termine",
        cmd, "Source", "Rapport operationnel Source consolide");
    tracerFluxHierarchique("REPORT", caS, "AT-sP2", "ProcurementCompleted",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte,
        cmd, "Source", "Approvisionnement termine");
    tracerFluxHierarchique("REPORT", "AT-sP2", "AT-sP3", "MaterialAvailable",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte
        + ";" + bilanMatierePourScenario(sc, cmd.qte),
        cmd, "Plan Source -> Plan Make", "Matiere liberee pour production");

    cmd.statut = "MATIERES_DISPONIBLES";
    board.logEvent("[SOURCE] " + cmd.idCommande + " : reception terminee, lancement Make autorise.");
    afficherPopupMetier("Approvisionnement", "Matieres recues pour " + cmd.idCommande,
        reception.toString(), "ESSENTIEL");
    tracerEtPlanifierProductionCommande(cmd);
}

void afficherPopupMetier(String titre, String evenement, String details, String niveau) {
    if (!popupsMetierActifs) return;
    String n = niveau == null ? "ESSENTIEL" : niveau.toUpperCase(java.util.Locale.ROOT);
    String cfg = niveauPopupMetier == null ? "ESSENTIEL" : niveauPopupMetier.toUpperCase(java.util.Locale.ROOT);
    if ("ESSENTIEL".equals(cfg) && !("ESSENTIEL".equals(n))) return;
    if (time() - dernierPopupMetierA < Math.max(0, delaiMinimumEntrePopupsSec)) {
        board.logEvent("[POPUP-SKIP] " + titre + " | " + evenement + " | " + details);
        return;
    }
    dernierPopupMetierA = time();

    // C14.1 : les popups métier ne doivent jamais bloquer le moteur de simulation.
    // Les dialogues de configuration restent, eux, modaux via afficherMessageTopMost().
    final String popupTitre = titre == null ? "Information métier" : titre;
    final String popupMessage = popupTitre + "\n\n"
        + (evenement == null ? "" : evenement) + "\n"
        + (details == null ? "" : details);

    javax.swing.SwingUtilities.invokeLater(new Runnable() {
        public void run() {
            try {
                javax.swing.JOptionPane pane = new javax.swing.JOptionPane(
                    popupMessage,
                    javax.swing.JOptionPane.INFORMATION_MESSAGE,
                    javax.swing.JOptionPane.DEFAULT_OPTION
                );

                java.awt.Window owner =
                    java.awt.KeyboardFocusManager
                        .getCurrentKeyboardFocusManager()
                        .getActiveWindow();

                javax.swing.JDialog dialog = owner != null
                    ? pane.createDialog(owner, popupTitre)
                    : pane.createDialog(popupTitre);

                dialog.setModal(false);
                dialog.setAlwaysOnTop(true);
                dialog.setLocationRelativeTo(owner);
                dialog.setDefaultCloseOperation(javax.swing.WindowConstants.DISPOSE_ON_CLOSE);
                dialog.setVisible(true);

            } catch (Throwable ex) {
                try {
                    traceln("[POPUP-NONBLOCKING] " + popupTitre + " | " + popupMessage);
                } catch (Throwable ignored) {}
            }
        }
    });

    if (board != null) {
        board.logEvent("[POPUP-NONBLOCKING] " + popupTitre + " | " + evenement);
    }
}

String idCommandeDepuisTextes(String a, String b, String c) {
    String ref = (a == null ? "" : a) + " " + (b == null ? "" : b) + " " + (c == null ? "" : c);
    java.util.regex.Matcher m = java.util.regex.Pattern.compile("CMD_\\d+").matcher(ref);
    return m.find() ? m.group() : "";
}

String cleSuiviMetier(String type, String evenement, String description, String objet) {
    String id = idCommandeDepuisTextes(description, objet, evenement);
    if (id == null || id.isEmpty()) return "";
    return id + "|" + keyAnim(evenement);
}

public java.util.LinkedHashSet<String> clesSuiviMetierDejaVues = new java.util.LinkedHashSet<String>();

// Mode cas d etude : la commande client est le declencheur principal.
// Les flux autonomes historiques (arrivee generique, appro fournisseur periodique)
// sont bloques pour eviter des activites metier avant ou sans commande.
public boolean modePilotageParCommande = true;
public double tempsDebutSimulation = -1;

String stockInitialResume() {
    return "Stock initial produit fini=" + String.format("%.1f", champStockInitialProduitFini)
        + " | Stock initial matiere=" + String.format("%.1f", champStockInitialMatiereGlobal);
}

PosteGenericAgent trouverPremierPosteParCodeEtCategorie(String codeSCORRecherche, String categorieRecherche) {
    String code = codeSCORRecherche == null ? "" : codeSCORRecherche.trim();
    String cat = normaliserCategorieActeur(categorieRecherche);
    for (PosteGenericAgent p : postes) {
        if (p == null) continue;
        if (p.codeSCOR == null || !p.codeSCOR.equalsIgnoreCase(code)) continue;
        if (cat.equals(normaliserCategorieActeur(p.categorieActeurResponsable))) return p;
    }
    return null;
}

java.util.ArrayList<String> construireRouteLivraisonDirecteClient() {
    java.util.ArrayList<String> route = new java.util.ArrayList<String>();
    PosteGenericAgent prep = trouverPremierPosteParCodeEtCategorie("D1.3", ActeurSC.ENTREPRISE_FOCALE);
    PosteGenericAgent charg = trouverPremierPosteParCodeEtCategorie("D1.4", ActeurSC.ENTREPRISE_FOCALE);
    PosteGenericAgent exp = trouverPremierPosteParCodeEtCategorie("D1.12", ActeurSC.ENTREPRISE_FOCALE);
    PosteGenericAgent recClient = trouverPremierPosteParCodeEtCategorie("S1.2", ActeurSC.CLIENT);
    PosteGenericAgent verifClient = trouverPremierPosteParCodeEtCategorie("S1.3", ActeurSC.CLIENT);
    if (prep != null) route.add(prep.idPoste);
    if (charg != null) route.add(charg.idPoste);
    if (exp != null) route.add(exp.idPoste);
    if (recClient != null) route.add(recClient.idPoste);
    if (verifClient != null) route.add(verifClient.idPoste);
    return route;
}


String formatDateHeureSimulation(java.time.LocalDateTime dt) {
    if (dt == null) dt = java.time.LocalDateTime.of(2026, 3, 10, 8, 0, 0);
    return dt.format(java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"));
}

String budgetSimulationResume() {
    budgetResume = "Budget global=" + String.format("%.0f", budgetGlobal)
        + " | Plan=" + String.format("%.0f", budgetPlan)
        + " | Source=" + String.format("%.0f", budgetSource)
        + " | Make=" + String.format("%.0f", budgetMake)
        + " | Deliver=" + String.format("%.0f", budgetDeliver)
        + " | Return=" + String.format("%.0f", budgetReturn)
        + " | Enable=" + String.format("%.0f", budgetEnable);
    return budgetResume;
}

// ============================================================
// CONFIGURATION ET TRAÇABILITE DU RETARD FOURNISSEUR
// ============================================================
boolean retardFournisseurCibleCorrespond(FicheMatiere f) {
    if (f == null || !retardFournisseurTestActif) return false;
    String cible = retardFournisseurCible == null ? "" : retardFournisseurCible.trim().toUpperCase(java.util.Locale.ROOT);
    if (cible.isEmpty() || "TOUS".equals(cible) || "ALL".equals(cible)) return true;
    String mat = f.idMatiere == null ? "" : f.idMatiere.trim().toUpperCase(java.util.Locale.ROOT);
    String four = f.idFournisseur == null ? "" : f.idFournisseur.trim().toUpperCase(java.util.Locale.ROOT);
    return mat.equals(cible) || mat.contains(cible) || four.equals(cible) || four.contains(cible);
}

boolean retardFournisseurApplicableMaintenant(FicheMatiere f) {
    if (!retardFournisseurCibleCorrespond(f)) return false;
    return !(retardFournisseurUneSeuleReception && retardFournisseurConsomme);
}

double delaiFournisseurConfigureEffectifHeures(FicheMatiere f) {
    double nominal = f == null ? 0.0 : Math.max(0.0, f.delaiObtentionHeures);
    if (!retardFournisseurCibleCorrespond(f)) return nominal;
    double facteur = Math.max(1.0, facteurRetardFournisseur);
    double addition = Math.max(0.0, retardFournisseurAdditionnelHeures);
    return Math.max(nominal, nominal * facteur + addition);
}

double delaiFournisseurEffectifHeures(FicheMatiere f) {
    double nominal = f == null ? 0.0 : Math.max(0.0, f.delaiObtentionHeures);
    if (!retardFournisseurApplicableMaintenant(f)) return nominal;
    return delaiFournisseurConfigureEffectifHeures(f);
}

int nombreCommandesOuvertesPourPerturbation() {
    int n = 0;
    for (CommandeAgent c : commandes) {
        if (!estCommandeClient(c)) continue;
        String st = c.statut == null ? "" : c.statut.toUpperCase(java.util.Locale.ROOT);
        if ("SERVIE".equals(st) || "EN_RETARD".equals(st) || "ANNULEE".equals(st) || "CLOTUREE".equals(st)) continue;
        n++;
    }
    return n;
}

void enregistrerRetardFournisseurForce(FicheMatiere f, CommandeAgent cmd) {
    if (f == null || !retardFournisseurApplicableMaintenant(f)) return;
    double nominal = Math.max(0.0, f.delaiObtentionHeures);
    double effectif = delaiFournisseurConfigureEffectifHeures(f);
    double retard = Math.max(0.0, effectif - nominal);
    if (retard <= 0.0001) return;

    nbApprovisionnementsRetardes++;
    cumulRetardFournisseurHeures += retard;
    dernierRetardFournisseurHeures = retard;
    derniereMatiereRetardee = f.idMatiere == null ? "" : f.idMatiere;
    dernierFournisseurRetarde = f.idFournisseur == null ? "" : f.idFournisseur;
    dernierNbCommandesImpacteesRetardFournisseur = nombreCommandesOuvertesPourPerturbation();
    if (retardFournisseurUneSeuleReception) retardFournisseurConsomme = true;

    String detail = "matiere=" + derniereMatiereRetardee
        + ";fournisseur=" + dernierFournisseurRetarde
        + ";delaiNominalH=" + String.format(java.util.Locale.US, "%.2f", nominal)
        + ";delaiEffectifH=" + String.format(java.util.Locale.US, "%.2f", effectif)
        + ";retardH=" + String.format(java.util.Locale.US, "%.2f", retard)
        + ";commandesOuvertes=" + dernierNbCommandesImpacteesRetardFournisseur;

    if (board != null) board.logEvent("[PERTURBATION FOURNISSEUR] " + detail);
    ajouterSuiviDetailleHorodate(
        time(),
        "Perturbation fournisseur",
        "Retard fournisseur force et detecte",
        "La reception attendue conserve son delai nominal pour la planification de stock, mais sa date d'arrivee effective est decalee afin de mesurer la propagation du retard.",
        "SupplierActor / Agent Source",
        "AOp-sS1.1 -> CA-sS1 -> AT-sP2 -> AT-sP3 -> AT-sP4",
        "Matiere " + derniereMatiereRetardee,
        detail,
        dernierFournisseurRetarde,
        "ZENER SA Togo",
        "Supplier -> Source -> Make -> Deliver",
        "S1 / P2 / P3 / P4",
        "Propager le retard sans modifier la date promise initiale, afin de mesurer son impact reel.",
        "Reception attendue au delai nominal",
        "Reception decalee de " + String.format("%.2f", retard) + " h",
        "Supplier Lead Time ; retard production ; retard livraison ; taux de service ; commandes impactees"
    );

    tracerFluxHierarchique("REPORT", "SupplierActor", "AOp-sS1.1", "SupplierDelayAlert",
        detail, cmd, "Source", "Retard fournisseur detecte");
    tracerFluxHierarchique("REPORT", "AOp-sS1.1", "CA-sS1", "OperationalException",
        detail, cmd, "Source", "Incident Source consolide");
    tracerFluxHierarchique("REPORT", "CA-sS1", "AT-sP2", "ProcessDeviationReport",
        detail, cmd, "Source", "Impact sur le plan Source");
    tracerFluxHierarchique("REPORT", "AT-sP2", "AT-sP3", "RevisedMaterialAvailability",
        detail, cmd, "Make", "Nouvelle disponibilite matiere");
    tracerFluxHierarchique("REPORT", "AT-sP3", "AT-sP4", "RevisedProductionCompletionDate",
        detail, cmd, "Deliver", "Impact potentiel sur la fin de production");
    tracerFluxHierarchique("AMENDMENT", "AT-sP4", "CA-sD1", "RevisedDeliveryPlan",
        detail, cmd, "Deliver", "Plan de livraison a reevaluer");
}

void consommerRetardFournisseurPourScenario(ScenarioFlux sc, int qteCommande, CommandeAgent cmd) {
    if (sc == null || sc.nomenclature == null || !retardFournisseurTestActif) return;
    for (LigneNomenclature l : sc.nomenclature) {
        if (l == null) continue;
        FicheMatiere f = trouverFicheMatiere(l.idMatiere);
        if (f == null || !retardFournisseurApplicableMaintenant(f)) continue;
        double besoin = l.quantiteParUnite * Math.max(1, qteCommande);
        if (besoin - f.stockDisponible <= 0.0001) continue;
        enregistrerRetardFournisseurForce(f, cmd);
        if (retardFournisseurUneSeuleReception && retardFournisseurConsomme) return;
    }
}

String[] ciblesRetardFournisseurItems() {
    java.util.ArrayList<String> items = new java.util.ArrayList<String>();
    items.add("TOUS");
    for (FicheMatiere f : fichesMatiere) {
        if (f == null || f.idMatiere == null || f.idMatiere.trim().isEmpty()) continue;
        String label = f.idMatiere;
        if (f.idFournisseur != null && !f.idFournisseur.trim().isEmpty()) label += " | " + f.idFournisseur;
        items.add(label);
    }
    return items.toArray(new String[0]);
}

String extraireCibleRetardFournisseur(String item) {
    if (item == null) return "TOUS";
    int p = item.indexOf("|");
    return (p >= 0 ? item.substring(0, p) : item).trim();
}

void ouvrirParametresPerturbations() {
    try {
        javax.swing.JCheckBox actif = new javax.swing.JCheckBox("Activer un retard fournisseur force", retardFournisseurTestActif);
        javax.swing.JComboBox<String> cible = new javax.swing.JComboBox<String>(ciblesRetardFournisseurItems());
        for (int i=0; i<cible.getItemCount(); i++) {
            String v = extraireCibleRetardFournisseur((String)cible.getItemAt(i));
            if (v.equalsIgnoreCase(retardFournisseurCible)) { cible.setSelectedIndex(i); break; }
        }
        javax.swing.JTextField facteur = new javax.swing.JTextField(String.valueOf(facteurRetardFournisseur), 8);
        javax.swing.JTextField addition = new javax.swing.JTextField(String.valueOf(retardFournisseurAdditionnelHeures), 8);
        javax.swing.JCheckBox unique = new javax.swing.JCheckBox("N'appliquer le retard qu'a la premiere reception ciblee", retardFournisseurUneSeuleReception);

        javax.swing.JPanel panel = new javax.swing.JPanel(new java.awt.GridLayout(0,2,8,8));
        panel.add(new javax.swing.JLabel("Retard fournisseur :")); panel.add(actif);
        panel.add(new javax.swing.JLabel("Matiere/fournisseur cible :")); panel.add(cible);
        panel.add(new javax.swing.JLabel("Facteur de delai (>= 1) :")); panel.add(facteur);
        panel.add(new javax.swing.JLabel("Retard additionnel (heures) :")); panel.add(addition);
        panel.add(new javax.swing.JLabel("Mode de test :")); panel.add(unique);

        Object[] message = new Object[] {
            new javax.swing.JLabel("<html><b>Perturbations reproductibles</b><br>Le retard modifie la date d'arrivee effective, pas le delai nominal utilise par le point de commande.</html>"),
            panel
        };
        int res = javax.swing.JOptionPane.showConfirmDialog(null, message, "Perturbations", javax.swing.JOptionPane.OK_CANCEL_OPTION, javax.swing.JOptionPane.QUESTION_MESSAGE);
        if (res != javax.swing.JOptionPane.OK_OPTION) return;

        retardFournisseurTestActif = actif.isSelected();
        retardFournisseurCible = extraireCibleRetardFournisseur((String)cible.getSelectedItem());
        facteurRetardFournisseur = Math.max(1.0, Double.parseDouble(facteur.getText().trim()));
        retardFournisseurAdditionnelHeures = Math.max(0.0, Double.parseDouble(addition.getText().trim()));
        retardFournisseurUneSeuleReception = unique.isSelected();
        retardFournisseurConsomme = false;
        nbApprovisionnementsRetardes = 0;
        cumulRetardFournisseurHeures = 0.0;
        dernierRetardFournisseurHeures = 0.0;
        derniereMatiereRetardee = "";
        dernierFournisseurRetarde = "";
        dernierNbCommandesImpacteesRetardFournisseur = 0;

        if (board != null) board.logEvent("[PERTURBATIONS] retard fournisseur actif=" + retardFournisseurTestActif
            + " ; cible=" + retardFournisseurCible
            + " ; facteur=" + facteurRetardFournisseur
            + " ; additionH=" + retardFournisseurAdditionnelHeures
            + " ; uneSeuleReception=" + retardFournisseurUneSeuleReception);
    } catch (Throwable ex) {
        afficherMessageTopMost("Parametrage perturbation invalide : " + ex.getMessage(), "Perturbations");
    }
}

double delaiFournisseurEffectifMoyenHeures() {
    if (fichesMatiere == null || fichesMatiere.isEmpty()) return Double.NaN;
    double somme = 0; int n = 0;
    for (FicheMatiere f : fichesMatiere) {
        if (f == null) continue;
        somme += delaiFournisseurConfigureEffectifHeures(f); n++;
    }
    return n == 0 ? Double.NaN : somme / n;
}

double retardFournisseurMoyenObserveHeures() {
    return nbApprovisionnementsRetardes <= 0 ? 0.0 : cumulRetardFournisseurHeures / nbApprovisionnementsRetardes;
}

String resumeRetardFournisseur() {
    return "actif=" + retardFournisseurTestActif
        + ";cible=" + retardFournisseurCible
        + ";facteur=" + String.format(java.util.Locale.US, "%.2f", facteurRetardFournisseur)
        + ";nbRetards=" + nbApprovisionnementsRetardes
        + ";retardMoyenH=" + String.format(java.util.Locale.US, "%.2f", retardFournisseurMoyenObserveHeures());
}

String resumeTempsBudgetSimulation() {
    return "Date depart=" + formatDateHeureSimulation(userStartDate)
        + " | Echelle=" + String.format("%.0f", simToRealSeconds) + " s reelles / 1 s simulation"
        + " | " + budgetSimulationResume();
}

void initialiserHorlogeSimulation() {
    try {
        if (userStartDate == null) {
            userStartDate = java.time.LocalDateTime.of(2026, 3, 10, 8, 0, 0);
        }
        java.time.ZoneId zone = java.time.ZoneId.systemDefault();
        simStartRealMillis = userStartDate.atZone(zone).toInstant().toEpochMilli();
        actualiserTempsSimulation();
    } catch (Throwable ex) {
        realTimer = "Erreur timer : " + ex.getMessage();
        try { traceln("[TIMER] erreur init : " + ex.getMessage()); } catch (Throwable ignored) {}
    }
}

void actualiserTempsSimulation() {
    try {
        if (userStartDate == null) {
            userStartDate = java.time.LocalDateTime.of(2026, 3, 10, 8, 0, 0);
        }
        if (simStartRealMillis == 0L) {
            java.time.ZoneId zone0 = java.time.ZoneId.systemDefault();
            simStartRealMillis = userStartDate.atZone(zone0).toInstant().toEpochMilli();
        }

        double reference = tempsDebutSimulation >= 0 ? tempsDebutSimulation : time();
        double secondesSimulationEcoulees = Math.max(0.0, time() - reference);
        long addedMillis = (long) Math.round(secondesSimulationEcoulees * Math.max(1.0, simToRealSeconds) * 1000.0);
        long currentRealMillis = simStartRealMillis + addedMillis;

        java.time.Instant inst = java.time.Instant.ofEpochMilli(currentRealMillis);
        java.time.ZoneId zone = java.time.ZoneId.systemDefault();
        java.time.LocalDateTime ldt = java.time.LocalDateTime.ofInstant(inst, zone);

        realTimer = String.format(
            "Date simulee : %04d-%02d-%02d %02d:%02d:%02d | Ecoule : %.1f s sim | Echelle : %.0f s reels/s sim",
            ldt.getYear(),
            ldt.getMonthValue(),
            ldt.getDayOfMonth(),
            ldt.getHour(),
            ldt.getMinute(),
            ldt.getSecond(),
            secondesSimulationEcoulees,
            simToRealSeconds
        );
    } catch (Throwable ex) {
        realTimer = "Erreur timer : " + ex.getMessage();
        try { traceln("[TIMER] erreur update : " + ex.getMessage()); } catch (Throwable ignored) {}
    }
}

boolean ouvrirParametresTempsBudgetDebut() {
    try {
        javax.swing.JLabel lbl = new javax.swing.JLabel(
            "<html><b>Parametres temporels et budgetaires</b><br>"
            + "Definissez la date de depart, l'echelle temps simulation vers temps reel, "
            + "ainsi que les budgets de reference par macro-processus SCOR.</html>"
        );

        javax.swing.JTextField tfScale = new javax.swing.JTextField(String.valueOf(simToRealSeconds), 12);
        javax.swing.JTextField tfStartDate = new javax.swing.JTextField(formatDateHeureSimulation(userStartDate), 18);

        javax.swing.JTextField tfBudgetGlobal = new javax.swing.JTextField(String.valueOf(budgetGlobal), 10);
        javax.swing.JTextField tfBudgetPlan = new javax.swing.JTextField(String.valueOf(budgetPlan), 10);
        javax.swing.JTextField tfBudgetSource = new javax.swing.JTextField(String.valueOf(budgetSource), 10);
        javax.swing.JTextField tfBudgetMake = new javax.swing.JTextField(String.valueOf(budgetMake), 10);
        javax.swing.JTextField tfBudgetDeliver = new javax.swing.JTextField(String.valueOf(budgetDeliver), 10);
        javax.swing.JTextField tfBudgetReturn = new javax.swing.JTextField(String.valueOf(budgetReturn), 10);
        javax.swing.JTextField tfBudgetEnable = new javax.swing.JTextField(String.valueOf(budgetEnable), 10);

        javax.swing.JCheckBox showAtStartBox = new javax.swing.JCheckBox(
            "Afficher ce panneau au demarrage", afficherPopupTempsBudgetAuDemarrage
        );

        javax.swing.JPanel panel = new javax.swing.JPanel(new java.awt.GridLayout(0, 2, 8, 8));
        panel.add(new javax.swing.JLabel("Date de depart (AAAA-MM-JJ HH:mm:ss) :"));
        panel.add(tfStartDate);
        panel.add(new javax.swing.JLabel("Echelle (1 s simulation = X s reelles) :"));
        panel.add(tfScale);
        panel.add(new javax.swing.JLabel("Budget global :"));
        panel.add(tfBudgetGlobal);
        panel.add(new javax.swing.JLabel("Budget Plan :"));
        panel.add(tfBudgetPlan);
        panel.add(new javax.swing.JLabel("Budget Source :"));
        panel.add(tfBudgetSource);
        panel.add(new javax.swing.JLabel("Budget Make :"));
        panel.add(tfBudgetMake);
        panel.add(new javax.swing.JLabel("Budget Deliver :"));
        panel.add(tfBudgetDeliver);
        panel.add(new javax.swing.JLabel("Budget Return :"));
        panel.add(tfBudgetReturn);
        panel.add(new javax.swing.JLabel("Budget Enable :"));
        panel.add(tfBudgetEnable);
        panel.add(new javax.swing.JLabel("Option :"));
        panel.add(showAtStartBox);

        Object[] message = new Object[] { lbl, panel };
        javax.swing.JOptionPane pane = new javax.swing.JOptionPane(
            message,
            javax.swing.JOptionPane.QUESTION_MESSAGE,
            javax.swing.JOptionPane.OK_CANCEL_OPTION
        );

        java.awt.Window owner = java.awt.KeyboardFocusManager.getCurrentKeyboardFocusManager().getActiveWindow();
        javax.swing.JDialog dialog = owner != null
            ? pane.createDialog(owner, "Parametres Simulation & Budgets")
            : pane.createDialog("Parametres Simulation & Budgets");

        dialog.setModal(true);
        dialog.setAlwaysOnTop(true);
        dialog.setLocationRelativeTo(owner);
        dialog.addWindowListener(new java.awt.event.WindowAdapter() {
            public void windowOpened(java.awt.event.WindowEvent e) {
                dialog.toFront();
                dialog.requestFocus();
                tfStartDate.requestFocusInWindow();
            }
        });
        dialog.setVisible(true);

        Object selected = pane.getValue();
        boolean ok = selected != null
            && selected instanceof Integer
            && ((Integer) selected).intValue() == javax.swing.JOptionPane.OK_OPTION;

        if (!ok) {
            board.logEvent("[TEMPS/BUDGET] parametrage annule par utilisateur");
            return false;
        }

        java.time.format.DateTimeFormatter fmt = java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        java.time.LocalDateTime nouvelleDate = java.time.LocalDateTime.parse(tfStartDate.getText().trim(), fmt);
        double nouvelleEchelle = Math.max(1.0, Double.parseDouble(tfScale.getText().trim()));

        double bGlobal = Math.max(0.0, Double.parseDouble(tfBudgetGlobal.getText().trim()));
        double bPlan = Math.max(0.0, Double.parseDouble(tfBudgetPlan.getText().trim()));
        double bSource = Math.max(0.0, Double.parseDouble(tfBudgetSource.getText().trim()));
        double bMake = Math.max(0.0, Double.parseDouble(tfBudgetMake.getText().trim()));
        double bDeliver = Math.max(0.0, Double.parseDouble(tfBudgetDeliver.getText().trim()));
        double bReturn = Math.max(0.0, Double.parseDouble(tfBudgetReturn.getText().trim()));
        double bEnable = Math.max(0.0, Double.parseDouble(tfBudgetEnable.getText().trim()));

        userStartDate = nouvelleDate;
        simToRealSeconds = nouvelleEchelle;
        budgetGlobal = bGlobal;
        budgetPlan = bPlan;
        budgetSource = bSource;
        budgetMake = bMake;
        budgetDeliver = bDeliver;
        budgetReturn = bReturn;
        budgetEnable = bEnable;
        afficherPopupTempsBudgetAuDemarrage = showAtStartBox.isSelected();
        paramsTempsBudgetValides = true;

        simStartRealMillis = 0L;
        initialiserHorlogeSimulation();
        board.logEvent("[TEMPS/BUDGET] " + resumeTempsBudgetSimulation());
        return true;

    } catch (Throwable ex) {
        afficherMessageTopMost(
            "Erreur dans les parametres temps/budget : " + ex.getMessage()
            + "\n\nFormat attendu pour la date : AAAA-MM-JJ HH:mm:ss\nExemple : 2026-03-10 08:00:00",
            "Erreur parametres simulation"
        );
        try { traceln("[TEMPS/BUDGET] erreur : " + ex.getMessage()); } catch (Throwable ignored) {}
        return false;
    }
}

void ouvrirParametresTempsBudget() {
    boolean ok = ouvrirParametresTempsBudgetDebut();
    if (ok) {
        afficherMessageTopMost("Parametres appliques :\n" + resumeTempsBudgetSimulation(), "Parametres simulation");
    }
}

void afficherMessageTopMost(String message, String titre) {
    try {
        javax.swing.JOptionPane pane = new javax.swing.JOptionPane(
            message,
            javax.swing.JOptionPane.INFORMATION_MESSAGE,
            javax.swing.JOptionPane.DEFAULT_OPTION
        );

        java.awt.Window owner =
            java.awt.KeyboardFocusManager
                .getCurrentKeyboardFocusManager()
                .getActiveWindow();

        javax.swing.JDialog dialog;

        if (owner != null) {
            dialog = pane.createDialog(owner, titre);
        } else {
            dialog = pane.createDialog(titre);
        }

        dialog.setModal(true);
        dialog.setAlwaysOnTop(true);
        dialog.setLocationRelativeTo(owner);

        dialog.addWindowListener(new java.awt.event.WindowAdapter() {
            public void windowOpened(java.awt.event.WindowEvent e) {
                dialog.toFront();
                dialog.requestFocus();
            }
        });

        dialog.setVisible(true);

    } catch (Throwable ex) {
        try {
            getExperimentHost().showMessageDialog(message);
        } catch (Throwable ignored) {
            traceln("[DIALOG] " + message);
        }
    }
}


void reinitialiserPolitiquesStockPourRun() {
    // ETAPE 2 -- les états internes des politiques (s,Q) appartiennent au run,
    // pas à la configuration. Ils doivent être remis à zéro avant chaque
    // nouvelle exécution pour garantir la reproductibilité.
    pointCommandeProduit = 0;
    quantiteEconomiqueProduit = 0;
    productionAutonomeEnCours = false;
    seqCommandeAutonome = 0;
    dernierCalculBesoinNet = -1;
    // Bloc M.3 -- cache par produit de la politique multi-produit, meme
    // remise a zero par run que son equivalent mono ci-dessus.
    quantiteEconomiqueParProduit.clear();

    for (FicheMatiere f : fichesMatiere) {
        if (f == null) continue;
        f.pointCommande = 0;
        f.quantiteEconomique = 0;
        if (f.receptionsAttendues != null) f.receptionsAttendues.clear();
        f.dernierBesoinBrut = 0;
        f.dernierStockDispo = 0;
        f.dernieresReceptionsAttendues = 0;
        f.dernierBesoinNet = 0;
        f.dernierOrdrePasse = 0;
        f.dernierCalcul = -1;
    }
}

void appliquerStocksInitiauxConfig() {
    // ETAPE 2 -- règle de réinitialisation reproductible.
    // Le stock produit fini possède une valeur globale explicite (chargée du
    // JSON ou saisie dans l'interface) et doit être réappliqué à chaque
    // nouveau run.
    //
    // Pour les matières, les fiches détaillées du JSON sont autoritatives en
    // fonctionnement normal. Une valeur globale n'est appliquée que lorsqu'un
    // profil de test ou le dialogue "Stocks initiaux" a explicitement demandé
    // un override. Cela évite l'ancien écrasement silencieux 600/250/300 ->
    // 500/100/100 et rend les runs répétables.
    boolean overrideMatiereGlobal = profilTestActif != null
        && !profilTestActif.trim().isEmpty();

    int nbStocksFinis = 0;
    int nbMatieres = 0;
    java.util.HashSet<String> stocksDejaAppliques = new java.util.HashSet<String>();

    // Produit fini : la valeur champStockInitialProduitFini provient soit du
    // JSON, soit d'un profil/override utilisateur.
    //
    // Bloc M.2-TEST-FIX -- BUG CONFIRME PAR RUN REEL (fixture A/B 60/40).
    // Cette section ecrasait INCONDITIONNELLEMENT stockFiniParProduit avec
    // champStockInitialProduitFini (la valeur GLOBALE) pour CHAQUE produit.
    // demarrerSimulation() appelle initialiserStocksProduits() (qui construit
    // correctement 60/40 a partir de stockInitialParProduit) PUIS
    // appliquerStocksInitiauxConfig(), qui reinjectait alors 100/100 (le
    // stock global duplique sur chaque produit) -- agregat observe = 200 au
    // lieu de 100. stockFiniParProduit est la SOURCE DE VERITE en mode multi
    // (voir initialiserStocksProduits()) : elle ne doit plus jamais etre
    // reconstruite ici. Seul le mode MONO conserve la logique legacy a
    // l'identique (ecrasement direct de niveauStock ET peuplement "dormant"
    // de la map, jamais lue tant que modeMultiProduitActif=false).
    if (champStockInitialProduitFini >= 0) {
        if (!modeMultiProduitActif) {
            for (PosteGenericAgent p : postes) {
                if (p == null || !estPosteStockFini(p)) continue;
                if (stocksDejaAppliques.contains(p.idPoste)) continue;
                p.niveauStock = Math.max(0, champStockInitialProduitFini);
                stocksDejaAppliques.add(p.idPoste);
                nbStocksFinis++;
            }

            synchroniserListeProduits();
            if (stockFiniParProduit != null) {
                for (ScenarioFlux produit : listeProduits) {
                    if (produit == null) continue;
                    stockFiniParProduit.put(
                        cleProduit(produit.typeProduit),
                        Math.max(0.0, champStockInitialProduitFini)
                    );
                }
            }
        } else {
            // MULTI -- stockFiniParProduit a deja ete construite par
            // initialiserStocksProduits() (appelee juste avant, avec
            // repartition explicite/reliquat via stockInitialParProduit).
            // Direction UNIQUEMENT map -> agregat, jamais l'inverse : on ne
            // fait plus stockFiniParProduit.put(produit, champStockInitialProduitFini).
            // On se contente de resynchroniser niveauStock (agregat de
            // compatibilite) a partir de la map reelle.
            synchroniserStockFiniAgrege(null);
            for (PosteGenericAgent p : postes) {
                if (p == null || !estPosteStockFini(p)) continue;
                if (stocksDejaAppliques.contains(p.idPoste)) continue;
                stocksDejaAppliques.add(p.idPoste);
                nbStocksFinis++;
            }
        }
    }

    // Matières : soit override global volontaire, soit restauration de la
    // valeur détaillée capturée lors du chargement/configuration.
    for (FicheMatiere f : fichesMatiere) {
        if (f == null) continue;
        if (overrideMatiereGlobal) {
            f.stockDisponible = Math.max(0, champStockInitialMatiereGlobal);
        } else {
            // Compatibilité avec des fiches créées avant l'ajout du champ :
            // si aucune référence n'est encore mémorisée, la valeur courante
            // devient la référence du prochain run.
            if (!f.stockInitialConfigureDefini) {
                f.stockInitialConfigure = Math.max(0.0, f.stockDisponible);
                f.stockInitialConfigureDefini = true;
            }
            f.stockDisponible = Math.max(0, f.stockInitialConfigure);
        }
        nbMatieres++;
    }

    String modeStock = overrideMatiereGlobal
        ? "override global explicite (" + profilTestActif + ")"
        : "stocks matières détaillés du JSON/configuration restaurés";

    ajouterSuiviDetaille(
        "Initialisation stock",
        "Stocks initiaux appliques",
        "Le modele restaure un etat initial reproductible avant le demarrage des commandes.",
        "Utilisateur",
        "Modele SCONTO-VSM",
        "Stocks produit fini et matieres",
        stockInitialResume() + " | mode=" + modeStock,
        "Vue Configuration",
        "Modele de simulation",
        "Parametres utilisateur/JSON -> stocks internes",
        "MTS / politique de stock",
        "Initialiser les stocks sans écrasement implicite des fiches matière.",
        "Etat precedent du run",
        "Etat initial restaure",
        "Stock PF ; stock par matière ; provenance de l'initialisation"
    );

    board.logEvent("[STOCK INIT] PF=" + String.format("%.1f", champStockInitialProduitFini)
        + " | matieres=" + nbMatieres + " | " + modeStock);
}

ScenarioFlux scenarioPourTypeProduit(String idProduit) {
    if (idProduit == null) return null;
    String id = idProduit.trim();
    for (ScenarioFlux sc : scenarios) {
        if (sc != null && sc.typeProduit != null && sc.typeProduit.equalsIgnoreCase(id)) return sc;
    }
    return null;
}

