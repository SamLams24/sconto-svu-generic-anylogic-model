    enregistrerTraceExecutionCommande(cmd, "sD1.9.1",  "D1.9",  "PRELEVEMENT_BONBONNES_STOCK", 2.0, 0.0, cmd.qte, "Prélèvement des bonbonnes produites pour la commande client");
    enregistrerTraceExecutionCommande(cmd, "sD1.10.1", "D1.10", "CONDITIONNEMENT_EXPEDITION", 2.0, 0.0, cmd.qte, "Conditionnement du produit pour expédition client");
