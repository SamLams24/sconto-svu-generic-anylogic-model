		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1780965785915</Id>
			<Name><![CDATA[LoiTemps]]></Name>
			<Text><![CDATA[import com.anylogic.engine.Utilities;
import java.util.Random;

public class LoiTemps implements java.io.Serializable {
    public String distribution = "uniform";
    public double p1 = 1, p2 = 1, p3 = 1;

    public LoiTemps() {}
    public LoiTemps(String distribution, double p1, double p2) {
        this.distribution = distribution; this.p1 = p1; this.p2 = p2;
    }

    // Bloc B.1 -- Esperance theorique de la loi, utilisee comme reference NOMINALE
    // pour normaliser les temps de cycle SCOR (dureeTraitementNominale()) : elle
    // donne la duree que le poste est cense prendre d'apres le scenario,
    // independamment du tirage aleatoire (echantillon() ci-dessous).
    public double esperance() {
        switch (distribution) {
            case "uniform":     return (p1 + p2) / 2.0;
            case "triangular":  return (p1 + p2 + p3) / 3.0; // min p1, max p2, mode p3
            case "exponential": return p1;
            case "constant":    return p1;
            default:            return p1;
        }
    }

    public double echantillon(Random rng) {
        switch (distribution) {
            case "uniform":     return Utilities.uniform(p1, p2, rng);
            case "triangular":  return Utilities.triangular(p1, p3, p2, rng);
            case "exponential": return -p1 * Math.log(1.0 - rng.nextDouble());
            case "constant":    return p1;
            default:            return p1;
        }
    }

    @Override
    public String toString() {
        return distribution + "(" + p1 + (p2 != p1 ? "," + p2 : "") + ")";
    }
}]]></Text>
		</JavaClass>
