					<X>-300</X><Y>390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
        String[] items = acteurMicroComboItems();

        comboActeurMicro.setItems(items);

        if (items.length > 0
            && !items[0].startsWith("(aucun")
            && (champActeurLieMicro == null || champActeurLieMicro.trim().isEmpty())) {
            champActeurLieMicro = items[0];
        }

    } catch (Exception ex) {
        traceln("Erreur refreshActeursMicroComboBox : " + ex.getMessage());
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781940054070</Id>
					<Name><![CDATA[extraireIdActeurDepuisCombo]]></Name>
					<X>-570</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[selection]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (selection == null) return "";

String s = selection.trim();

if (s.isEmpty()) return "";
if (s.startsWith("(aucun")) return "";

if (s.contains(" — ")) {
        return s.split(" — ")[0].trim();
}

return s;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ActeurSC]]></ReturnType>
					<Id>1781940122124</Id>
					<Name><![CDATA[trouverActeurParId]]></Name>
					<X>-570</X><Y>330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idActeur]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (idActeur == null) return null;

String id = idActeur.trim();

for (ActeurSC a : acteursSC) {
        if (a.idActeur.equals(id)) {
            return a;
        }
}

return null;]]></Body>
