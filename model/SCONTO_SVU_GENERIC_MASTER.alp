        "Lot complet prêt à livrer",
        "Livraison client exécutée",
        "Temps Deliver ; quantité livrée ; taux de service ; réception client"
    );
}

void lancerProductionCommandeOrchestree(CommandeAgent cmd) {
    if (cmd == null || !modeExecution) return;

    // C14.36 -- Make tourne toujours en temps reel (jamais mis a l'echelle) :
    // l'instant de debut est capture ici pour pouvoir ajouter, a la cloture,
    // la duree REELLEMENT ecoulee pendant la production a
    // cmd.dureeReelleAccumulee (C14.34), qui ne couvrait jusqu'ici que les
    // etapes Source/Deliver/Plan instrumentees.
    if (cmd.tDebutProduction < 0) cmd.tDebutProduction = time();

    ScenarioFlux sc = scenarioPourCommande(cmd);
    Order order = creerOuSynchroniserOrder(cmd);

    String supM = idSuperviseurCommande("M", 1, cmd);
    String aoM = idExecutionCommande("M", 2, cmd);
    tracerFluxHierarchique("EXECUTION", aoM, supM, "ExecutionStart",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";operation=production",
        cmd, "Make", "Exécution Make démarrée");

    java.util.ArrayList<String> routeBase = routeProductionMakeDepuisScenario(sc);

    enregistrerPreparationProductionCommande(cmd);

    for (int i = 0; i < cmd.qte; i++) {
        FluxEntity e = add_fluxEntites();
        e.idFlux = cmd.idCommande + "_F_" + (++seqProduitRuntime);
        e.tEntreeSysteme = time();
        e.feuilleDeRoute = new java.util.ArrayList<String>(routeBase);
        e.typeProduit = libelleTypeProduitTrace(cmd, sc);
        e.etapeCourante = 0;
        Produit produitAgent = creerProduitAgentPourFlux(e, cmd, i + 1, routeBase);
        ajouterSuiviDetaille(
            "Produit",
            "Creation d'un produit a traiter",
            "Une unite liee a la commande est creee dans le modele et preparee pour son parcours.",
            "Agent Order " + cmd.idCommande,
            "Agent Produit",
            "Produit " + e.idFlux,
            "Unite " + (i + 1) + "/" + cmd.qte,
            "Commande " + cmd.idCommande,
            routeBase.isEmpty() ? "Aucune route" : "Premiere micro-activite",
            "Order -> Produit -> Route SCOR",
            cmd.typeCommande,
            "Creer le produit associe a la commande.",
            "Commande validee",
            "Produit cree",
            "Nombre de produits crees ; WIP initial ; debut temps de cycle produit"
        );
        if (!e.feuilleDeRoute.isEmpty()) {
            PosteGenericAgent premier = trouverPoste(e.prochainPoste());
            if (premier != null) {
                if (produitAgent != null) produitAgent.demarrer(premier.nom, premier.codeSCOR, time());
                ajouterSuiviDetaille(
                    "Routage",
                    "Envoi du produit vers la premiere micro-activite",
                    "Le produit entre dans la premiere activite de son parcours configure.",
                    "Agent operationnel de pilotage",
                    premier.nom,
                    "Produit " + e.idFlux,
                    "1 unite",
                    "Agent Produit",
                    premier.nom,
                    "Produit -> " + premier.nom,
                    premier.codeSCOR,
                    "Demarrer le traitement du produit.",
                    "Produit cree",
                    "Produit en cours de traitement",
                    "Temps d'attente initial ; temps de cycle ; WIP"
                );
                positionnerEntiteSurPoste(e, premier);
                premier.enter.take(e);
            } else {
                if (produitAgent != null) produitAgent.terminer("ANNULE_POSTE_INTROUVABLE", time());
                remove_fluxEntites(e);
            }
        } else {
            if (produitAgent != null) produitAgent.terminer("ANNULE_ROUTE_VIDE", time());
            remove_fluxEntites(e);
        }
    }
    cmd.statut = "EN_COURS";
    ajouterSuiviDetaille(
        "Commande",
        "Commande en cours de traitement",
        "La commande est maintenant suivie dans le modele jusqu'a la livraison finale ou le retard.",
        "Agent Order " + cmd.idCommande,
        "Modele SCONTO-VSM",
        "Commande " + cmd.idCommande,
        "Quantite=" + cmd.qte,
        "Plan / Make / Deliver",
        "Postes de traitement",
        "Commande -> Flux produits",
        cmd.typeCommande,
        "Suivre l'execution de bout en bout.",
        "Commande validee",
        "Commande en cours",
        "Lead time commande ; statut commande ; progression produit"
    );
    afficherPopupMetier("Production", "Production lancee pour " + cmd.idCommande,
        "Le flux Make est lance pour " + cmd.qte + " unite(s).", "ESSENTIEL");
    if (order != null) order.lancerExecution(time());
}

void livrerCommandeDirectementDepuisStock(CommandeAgent cmd, PosteGenericAgent stockFini) {
    if (cmd == null) return;

    cmd.statut = "EN_LIVRAISON";

    ajouterSuiviDetaille(
        "Livraison",
        "Preparation de la livraison depuis le stock fini",
        "ZENER utilise les produits finis deja disponibles et prepare directement l'expedition client.",
        "Agent operationnel de pilotage Deliver",
        "Agent d'execution D1.3 / D1.4",
        "Commande " + cmd.idCommande,
        "Produit=" + codeProduitCommande(cmd) + " ; Quantite=" + cmd.qte,
        stockFini != null ? stockFini.nom : "Magasin produits finis",
        "Zone d'expedition",
        "Stock fini -> preparation expedition",
        "D1.3 / D1.4",
        "Preparer la commande pour expedition sans lancer Make.",
        "Livraison directe autorisee",
        "Expedition en preparation",
        "Temps de preparation livraison ; consommation stock fini ; taux de service"
    );

    enregistrerTraceExecutionCommande(
        cmd,
        "sD1.3.4",
        "D1.3",
        "PREPARATION_EXPEDITION",
        3.0,
        0.0,
        cmd.qte,
        "Preparation de l'expedition client depuis le stock fini"
    );
    enregistrerTraceExecutionCommande(
        cmd,
        "sD1.4.4",
        "D1.4",
        "CHARGEMENT_CAMION_CLIENT",
        2.0,
        0.0,
        cmd.qte,
        "Chargement du camion client pour livraison directe"
    );
    // C14.29 -- OPTION A : idem, echantillons reels au lieu de constantes.
    enregistrerTraceExecutionCommande(cmd, "sD1.5.4",  "D1.5",  "CONSTITUTION_CHARGEMENT_CLIENT_DIRECT", (trouverPoste("sD1.5.4") != null ? trouverPoste("sD1.5.4").dureeTraitement() : 0.0), 0.0, cmd.qte, "Constitution du chargement client depuis stock fini");
    enregistrerTraceExecutionCommande(cmd, "sD1.6.1",  "D1.6",  "PLANIFICATION_ITINERAIRE_DIRECT", (trouverPoste("sD1.6.1") != null ? trouverPoste("sD1.6.1").dureeTraitement() : 0.0), 0.0, cmd.qte, "Planification de l'itinéraire de livraison directe");
    enregistrerTraceExecutionCommande(cmd, "sD1.7.1",  "D1.7",  "SELECTION_TRANSPORTEUR_DIRECT", (trouverPoste("sD1.7.1") != null ? trouverPoste("sD1.7.1").dureeTraitement() : 0.0), 0.0, cmd.qte, "Sélection transporteur livraison directe");
    enregistrerTraceExecutionCommande(cmd, "sD1.8.1",  "D1.8",  "RECEPTION_PRODUIT_STOCK_DIRECT", (trouverPoste("sD1.8.1") != null ? trouverPoste("sD1.8.1").dureeTraitement() : 0.0), 0.0, cmd.qte, "Réception du produit depuis le stock pour Deliver");
    enregistrerTraceExecutionCommande(cmd, "sD1.9.1",  "D1.9",  "PRELEVEMENT_STOCK_DIRECT", (trouverPoste("sD1.9.1") != null ? trouverPoste("sD1.9.1").dureeTraitement() : 0.0), 0.0, cmd.qte, "Prélèvement stock fini pour livraison directe");
    enregistrerTraceExecutionCommande(cmd, "sD1.10.1", "D1.10", "CONDITIONNEMENT_DIRECT", (trouverPoste("sD1.10.1") != null ? trouverPoste("sD1.10.1").dureeTraitement() : 0.0), 0.0, cmd.qte, "Conditionnement livraison directe");
    enregistrerTraceExecutionCommande(cmd, "sD1.11.4", "D1.11", "CHARGEMENT_CAMION_CLIENT_DIRECT", (trouverPoste("sD1.11.4") != null ? trouverPoste("sD1.11.4").dureeTraitement() : 0.0), 0.0, cmd.qte, "Chargement camion client livraison directe");
    enregistrerTraceExecutionCommande(cmd, "sD1.12.4", "D1.12", "EXPEDITION_CLIENT_DIRECT", (trouverPoste("sD1.12.4") != null ? trouverPoste("sD1.12.4").dureeTraitement() : 0.0), 0.0, cmd.qte, "Expédition physique vers client depuis stock fini");
    lancerFluxVisuelDeliverClient(cmd);

    enregistrerFluxSupplyChainMetier(
        "LIVRAISON_PHYSIQUE",
        "ZENER SA Togo / AO-sD1.12",
        "CLIENT GENERIQUE / AO-sS1.4",
        cmd.qte,
        "Flux physique de livraison client pour " + cmd.idCommande
    );

    afficherPopupMetier("Livraison", "Preparation livraison " + cmd.idCommande,
        "La commande est preparee depuis le stock fini. Aucun ordre de production n'est cree.", "ESSENTIEL");

    String supD = idSuperviseurCommande("D", 3, cmd);
    tracerSequencePreparationDeliver(cmd, "livraison_directe");
    String aoTransport = idExecutionCommande("D", 12, cmd);
    tracerFluxHierarchique("EXECUTION", aoTransport, supD, "ExecutionStart",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte
        + ";operation=transport_livraison_directe",
        cmd, "Deliver", "Transport/livraison démarré après ShipmentOrder");

    animerLivraisonVehicule("MANUFACTURER:AO-sD1.12", "CUSTOMER:AO-sS1.2", cmd.qte);

    afficherFluxAnimation(
        "deliveryTruck",
        "D1.12 -> S1.2 / D1.13",
        "Manufacturer AO-sD1.12",
        "Customer AO-sS1.2",
        "Livraison finale au client pour " + cmd.idCommande + " depuis le stock fini"
    );

    // La reception client est decalee pour ne pas apparaitre au meme instant que l'expedition.
    planifierAvecEchelle("RECEPTION_CLIENT_DIRECTE", cmd, dureeReelleChaine(new String[]{"sS1.2.4","sS1.3.3"}));
}

void finaliserReceptionClientDirecte(CommandeAgent cmd) {
    if (cmd == null) return;

    double leadTimeSimulation = Math.max(0, time() - cmd.tCreation);
    actualiserRegistreTempsCommande(cmd, leadTimeSimulation, 0.0);
    double leadTime = Math.max(0.001, cmd.leadTimeClientReelSec);
    cmd.statut = (time() <= cmd.tPromise) ? "SERVIE" : "EN_RETARD";

    // C14.9 -- DOUBLE COMPTAGE CORRIGE : nbMTS/nbMTO et sumLeadTimeMTS/MTO
    // etaient incrementes ici PUIS une seconde fois via
    // enregistrerFinCommandeGlobale() -> board.notifierFin(), appelee plus bas
    // dans cette meme fonction. Une commande livree comptait donc pour 2.
    // notifierFin() reste la source unique de verite (elle synchronise aussi
    // totalTerminees, kpiGlobal et le throughput).

    board.logEvent("[DELIVER] " + cmd.idCommande + " receptionnee par le client -> " + cmd.statut
        + " (LT=" + String.format("%.1f", leadTime) + "s)");

    cloturerOrderDepuisCommande(cmd);

    ajouterSuiviDetaille(
        "Livraison",
        "Reception finale de la commande par le client",
        "Le client receptionne la commande livree depuis le stock fini. La commande est cloturee selon le delai promis.",
        "Agent operationnel de pilotage Deliver",
        "Agent d'execution D1.12 puis agent client S1.2/S1.3",
        "Commande " + cmd.idCommande,
        "Quantite=" + cmd.qte,
        "ZENER SA Togo / AO-sD1.12",
        "CLIENT GENERIQUE / AO-sS1.2",
        "Manufacturer D1.12 -> Customer S1.2 -> S1.3 -> S1.4",
        "D1.12 -> D1.13 / S1.2 -> S1.3 -> S1.4",
        "Cloturer la livraison et mettre a jour le statut commande.",
        "Expedition en cours",
        cmd.statut,
        "Lead time=" + String.format("%.1f", leadTime) + "s ; taux de service ; conformite reception client"
    );

    enregistrerTraceExecutionCommande(
        cmd,
        "sS1.2.4",
        "S1.2",
        "RECEPTION_LIVRAISON_CLIENT",
        1.0,
        0.0,
        cmd.qte,
        "Reception physique de la livraison par le client"
    );
    enregistrerTraceExecutionCommande(
        cmd,
        "sS1.3.3",
        "S1.3",
        "VERIFICATION_CONFORMITE_CLIENT",
        1.0,
        0.0,
        cmd.qte,
        "Verification de conformite de la livraison recue"
    );
    enregistrerFluxSupplyChainMetier(
        "RECEPTION_CLIENT",
        "CLIENT GENERIQUE / AO-sS1.2",
        "CLIENT GENERIQUE / AO-sS1.4",
        cmd.qte,
        "Reception puis verification client pour " + cmd.idCommande
    );
    enregistrerFinCommandeGlobale(
        cmd,
        leadTime,
        0.0, // livraison directe depuis stock : aucune file d'attente Make traversee
        cmd.qte,
        "Commande livree et cloturee avec statut=" + cmd.statut
    );

    String aoD = idExecutionCommande("D", 12, cmd);
    String supD = idSuperviseurCommande("D", 7, cmd);
    String caD = idCoordinateurCommande("D", cmd);
    tracerFluxHierarchique("EXECUTION", aoD, supD, "DeliveryCompleted",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";statut=" + cmd.statut,
        cmd, "Deliver", "Livraison terminée et réception confirmée");
    tracerFluxHierarchique("REPORT", supD, caD, "OperationalReport",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";statut=" + cmd.statut,
        cmd, "Deliver", "Résultat opérationnel consolidé");
    tracerFluxHierarchique("REPORT", caD, "AT-sP4", "ProcessStatusReport",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";statut=" + cmd.statut,
        cmd, "Deliver", "Rapport macro Deliver transmis");
    tracerFluxHierarchique("REPORT", "AT-sP4", "AS-sP1", "MacroProcessReport",
        "produit=" + codeProduitCommande(cmd) + ";quantite=" + cmd.qte + ";statut=" + cmd.statut
        + ";delaiTotal=" + String.format(java.util.Locale.US, "%.1f", leadTime),
        cmd, "Plan Deliver -> Strategic", "Performance finale transmise");

    // C14.35 -- le popup affiche desormais le delai REEL (non mis a l'echelle),
    // en minutes, via cmd.dureeReelleAccumulee : la valeur que percevrait
    // reellement un operationnel ZENER, independamment de la vitesse a
    // laquelle le deroule de simulation defile a l'ecran.
    double leadTimeReelMin = cmd.dureeReelleAccumulee / 60.0;
    afficherPopupMetier("Reception client", "Commande " + cmd.idCommande + " receptionnee",
        "Statut final=" + cmd.statut + " ; lead time reel=" + String.format("%.1f", leadTimeReelMin) + " min", "ESSENTIEL");

    evaluerRetourClientApresLivraison(cmd);
    if (aboxExportActif && aboxExportSurClotureCommande) {
        String fichierABoxFinal = exporterABoxRuntimeTTL("ORDER_CLOSED_" + cmd.idCommande);
        exporterToutesLesTablesExcel();
        c14SnapshotFinalEffectue = true;
        if(board!=null) board.logEvent(String.format(java.util.Locale.US,
            "[C14-FINAL] Snapshot synchronise cloture commande | PI=%.3f/10 | ABox=%s | Excel=%s | t=%.1fs",
            strategic!=null?strategic.calculerPIGlobal():0.0, fichierABoxFinal, excelFileName(), time()));
    }
}

// ============================================================
// COUCHE CENTRALE DE TRAÇABILITE METIER — COMMANDES / KPI / EXPORTS
// ------------------------------------------------------------
// Cette couche reconnecte le moteur orchestre par commande avec les tableaux
// analytiques historiques : Execution Brute, KPI par poste, Dashboard Micro,
// Dashboard Macro, Dashboard Global, Flux Supply Chain et Traces Agregees.
// Une etape metier observee dans le tableau de suivi doit produire aussi une
// trace brute et alimenter les KPI du Blackboard.
// ============================================================
PosteGenericAgent trouverPosteParIdOuCode(String idPoste, String codeSCOR) {
    if (postes == null) return null;

    String id = idPoste == null ? "" : idPoste.trim();
    String code = codeSCOR == null ? "" : codeSCOR.trim();

    if (!id.isEmpty()) {
        for (PosteGenericAgent p : postes) {
            if (p != null && p.idPoste != null && p.idPoste.equalsIgnoreCase(id)) return p;
        }
    }

    if (!code.isEmpty()) {
        String codeU = codeGroupeL3(code).toUpperCase(java.util.Locale.ROOT);
        for (PosteGenericAgent p : postes) {
            if (p == null || p.codeSCOR == null) continue;
            if (codeGroupeL3(p.codeSCOR).toUpperCase(java.util.Locale.ROOT).equals(codeU)) return p;
        }
    }

    return null;
}

String idPosteTrace(PosteGenericAgent p, String idFallback) {
    if (p != null && p.idPoste != null && !p.idPoste.trim().isEmpty()) return p.idPoste;
    return idFallback == null ? "" : idFallback;
}

String codeSCORTrace(PosteGenericAgent p, String codeFallback) {
    if (p != null && p.codeSCOR != null && !p.codeSCOR.trim().isEmpty()) return codeGroupeL3(p.codeSCOR);
    return codeFallback == null ? "" : codeGroupeL3(codeFallback);
}

String cleKPITrace(PosteGenericAgent p, String codeFallback) {
    if (p != null) return cleKPI(p);
    return codeFallback == null ? "" : codeGroupeL3(codeFallback);
}

double tauxValeurAjouteeTrace(PosteGenericAgent p, String codeSCOR) {
    try {
        if (p != null && p.tauxVA > 0) return Math.max(0.0, Math.min(1.0, p.tauxVA));
    } catch (Throwable ignored) {}

    String c = codeSCOR == null ? "" : codeSCOR.toUpperCase(java.util.Locale.ROOT);
    if (c.startsWith("D1.1")) return 0.70; // traitement/validation commande
    if (c.startsWith("D1.3")) return 0.80; // preparation expedition
    if (c.startsWith("D1.4")) return 0.75; // chargement
    if (c.startsWith("S1.2")) return 0.60; // reception client ou matiere
    if (c.startsWith("S1.3")) return 0.65; // controle conformite
    if (c.startsWith("M")) return 0.80;
    return 0.60;
}

boolean estNumeriqueTrace(String s) {
    if (s == null) return false;
    return s.trim().matches("[0-9]+(\\.[0-9]+)?");
}

String nettoyerCodeSCORTrace(String code) {
    if (code == null) return "";
    String c = code.trim();
    if (c.isEmpty()) return "";
    if (c.contains("|")) c = c.substring(c.indexOf('|') + 1).trim();
    if (estNumeriqueTrace(c)) return "";
    return codeGroupeL3(c);
}

String nettoyerIdPosteTrace(String idPoste, String evenement, String emetteur) {
    String id = idPoste == null ? "" : idPoste.trim();
    String evt = evenement == null ? "" : evenement.trim().toUpperCase(java.util.Locale.ROOT);
    String em = emetteur == null ? "" : emetteur.trim().toUpperCase(java.util.Locale.ROOT);

    if (id.isEmpty() || estNumeriqueTrace(id)) {
        if (evt.contains("FLUX" ) || em.contains("FLUX")) return "FLUX";
        if (evt.contains("COMMANDE_CLOSE") || evt.contains("GLOBAL_UPDATE")) return "COMMANDE";
        return "NON_APPLICABLE";
    }
    return id;
}

String nettoyerCodeSCORTraceAvecContexte(String code, String evenement, String emetteur) {
    String c = nettoyerCodeSCORTrace(code);
    if (!c.isEmpty()) return c;

    String evt = evenement == null ? "" : evenement.trim().toUpperCase(java.util.Locale.ROOT);
    String em = emetteur == null ? "" : emetteur.trim().toUpperCase(java.util.Locale.ROOT);
    if (evt.contains("FLUX") || em.contains("FLUX")) return "FLUX";
    if (evt.contains("COMMANDE_CLOSE") || evt.contains("GLOBAL_UPDATE")) return "GLOBAL";
    return "N/A";
}

String typeFluxLisible(String typeFlux) {
    if (typeFlux == null || typeFlux.trim().isEmpty()) return "INFO";
    String t = typeFlux.trim().toUpperCase(java.util.Locale.ROOT);
    if (t.equals("INFO")) return "INFO_COMMANDE";
    if (t.equals("LIVRAISON")) return "LIVRAISON_PHYSIQUE";
    if (t.equals("APPRO")) return "APPROVISIONNEMENT_PHYSIQUE";
    if (t.equals("RETOUR")) return "RETOUR_PHYSIQUE";
    return t;
}

boolean macroExecutee(KPIBundle k) {
    return k != null && k.count > 0;
}

String sourcePreuveMetriqueN3(String nom, double valeur) {
    if (nom == null) return "Source non documentée";
    String n = nom.toUpperCase(java.util.Locale.ROOT);
    if (n.contains("ORDER FULFILLMENT") || n.contains("LEAD TIME")) {
        return "board.kpiGlobal.avgLeadTime(), alimenté par enregistrerFinCommandeGlobale()";
    }
    if (n.contains("DELIVER CYCLE")) return "board.kpiParMacro['sD'].avgCycleTime(), alimenté par notifierPassage()";
    if (n.contains("SOURCE CYCLE")) return "board.kpiParMacro['sS'].avgCycleTime(), alimenté par Source fournisseur + réception matière + réception client";
    if (n.contains("MAKE CYCLE")) return "Non affiché si Make non exécuté dans le run";
    if (n.contains("RETURN CYCLE")) return "Non affiché si Return non exécuté dans le run";
    if (n.contains("THROUGHPUT")) return "commandes terminées / durée simulée utile";
    if (n.contains("ON-TIME") || n.contains("LIVREES A TEMPS") || n.contains("LIVRÉES À TEMPS") || n.contains("FILL RATE")) return "commandes livrées à temps / commandes closes ; retard => 0 pour cette métrique même si la livraison est effectuée";
    if (n.contains("PCE") || n.contains("EFFICACITE") || n.contains("EFFICACITÉ")) return "temps utile / (temps de traitement + temps d'attente) depuis les KPI de simulation";
    if (n.contains("INVENTORY")) return "stock physique observé / débit journalier observé";
    if (n.contains("COUT")) return "calculerCoutsCumules(), données financières configurées";
    return "Calculé depuis le tableau noir partagé et les traces de simulation";
}

void enregistrerTraceExecutionCommande(
    CommandeAgent cmd,
    String idPoste,
    String codeSCOR,
    String evenement,
    double cycleTime,
    double waitTime,
    int quantite,
    String commentaire
) {
    if (cmd == null) return;

    PosteGenericAgent p = trouverPosteParIdOuCode(idPoste, codeSCOR);
    String idTrace = idPosteTrace(p, idPoste);
    String codeTrace = codeSCORTrace(p, codeSCOR);
    String cle = cleKPITrace(p, codeTrace);
    double ct = Math.max(0.001, cycleTime);
    double wt = Math.max(0.0, waitTime);
    double vat = ct * tauxValeurAjouteeTrace(p, codeTrace);
    int qte = Math.max(1, quantite);
    String evt = evenement == null ? "ETAPE_COMMANDE" : evenement;
    String comm = commentaire == null ? "" : commentaire;

    // Trace brute de cycle time : source principale de preuve.
    addTrace(
        "BRUT",
        "MoteurCommande",
        cmd.idCommande,
        idTrace,
        codeTrace,
        evt,
        "Temps de traitement",
        ct,
        "s",
        "",
        Double.NaN,
        "",
        comm
    );

    // Trace brute de quantite : utile pour verifier stock, flux et throughput.
    addTrace(
        "BRUT",
        "MoteurCommande",
        cmd.idCommande,
        idTrace,
        codeTrace,
        evt,
        "QTE",
        qte,
        "unite(s)",
        "",
        Double.NaN,
        "",
        "Quantite traitee pour " + cmd.idCommande
    );

    try {
        board.notifierPassage(idTrace, cle, ct, wt, vat, Math.max(1.0, qte));
    } catch (Throwable ex) {
        board.logEvent("[TRACE ERROR] impossible de notifier KPI pour " + idTrace + " / " + codeTrace + " : " + ex.getMessage());
    }

    // Trace d'agregation explicite par macro, visible dans Traces Agregees.
    String macro = macroPrefixe(codeTrace);
    KPIBundle km = null;
    try { km = board.kpiParMacro.get(macro); } catch (Throwable ignored) {}
    double agg = km != null ? km.avgCycleTime() : ct;

    addTrace(
        "AGG_MACRO",
        "BlackboardAgent",
        cmd.idCommande,
        idTrace,
        codeTrace,
        "AGREGATION_ETAPE_COMMANDE",
        "Temps de traitement moyen_" + macro,
        ct,
        "s",
        macro,
        agg,
        "moyenne(cycleTime) par macro-processus depuis les traces de commande",
        "Agrégation alimentée par le flux orchestre de " + cmd.idCommande
    );
}

void enregistrerFluxSupplyChainMetier(String typeFlux, String source, String cible, int qte, String commentaire) {
    String type = typeFluxLisible(typeFlux);
    String src = source == null ? "" : source;
    String dst = cible == null ? "" : cible;
    int quantite = Math.max(1, qte);

    if (fluxLogs == null) fluxLogs = new java.util.ArrayList<FluxLog>();

    boolean doublonRecent = false;
    for (FluxLog f : fluxLogs) {
        if (f == null) continue;
        String ft = typeFluxLisible(f.typeFlux);
        if (ft.equals(type)
            && src.equals(f.idSource)
            && dst.equals(f.idCible)
            && f.qte == quantite
            && Math.abs(time() - f.tEmission) <= 1.0) {
            doublonRecent = true;
            break;
        }
    }

    if (!doublonRecent) {
        fluxLogs.add(new FluxLog(type, src, dst, quantite, time()));
        while (fluxLogs.size() > 200) fluxLogs.remove(0);
    }

    // Important : un flux n'est pas une execution de poste.
    // Il reste dans Flux Supply Chain pour ne pas polluer Execution Brute.
    try {
        board.logEvent("[FLUX-METIER] " + type + " | " + src + " -> " + dst
            + " | qte=" + quantite + " | " + (commentaire == null ? "" : commentaire));
    } catch (Throwable ignored) {}
}

void enregistrerFinCommandeGlobale(CommandeAgent cmd, double leadTime, double waitTime, int quantite, String commentaire) {
    if (cmd == null) return;
    if (commandesClotureesTracees.contains(cmd.idCommande)) return;
    commandesClotureesTracees.add(cmd.idCommande);

    // C14.58 -- Un ordre de fabrication AUTONOME (REAPPRO_x) n'est pas une
    // commande cliente : le comptabiliser ici gonflait les compteurs
    // "Order Mode" (MTS/MTO), le debit de commandes et les Order Lead Time,
    // au point d'afficher plusieurs dizaines de commandes alors que le client
    // n'en avait passe que quelques-unes. La production elle-meme reste
    // comptee normalement par nbTerminesProduction (cote unites), ce qui
    // alimente le Fill Rate et les taux qualite.
    if (cmd.idCommande != null && cmd.idCommande.startsWith("REAPPRO_")) {
        return;
    }

    // VSM-FIX-04 -- kpiGlobal est strictement un registre de commandes
    // clientes. Le Lead Time metier additionne le traitement propre de CMD et
    // l'attente explicite imputee depuis le ou les REAPPRO lies. La valeur
    // ajoutee globale reste neutre : le PCE VSM provient exclusivement de
    // kpiZener et ne doit jamais reconstruire l'attente de commande.
    actualiserRegistreTempsCommande(cmd, leadTime, waitTime);
    double lt = Math.max(0.001, cmd.leadTimeClientReelSec);
    double wt = Math.max(0.0, Math.min(lt, cmd.dureeAttenteStockReelleSec));
    if (cmd.tDebutAttenteStock < 0 && wt <= 0.0) wt = Math.max(0.0, Math.min(lt, waitTime));
    double vat = 0.0;

    try {
        // Utilise la fonction officielle du Blackboard pour synchroniser :
        // totalTerminees, kpiGlobal, MTS/MTO et throughput.
        if (board != null) board.notifierFin(lt, wt, vat, cmd.typeCommande);
    } catch (Throwable ex) {
        board.logEvent("[TRACE ERROR] impossible de notifier fin commande pour " + cmd.idCommande + " : " + ex.getMessage());
    }

    try {
        nbTermines++;
        if (nbTerminesParProduit != null) nbTerminesParProduit.merge(cmd.typeCommande == null ? "MTS" : cmd.typeCommande, 1L, Long::sum);
    } catch (Throwable ignored) {}

    addTrace(
        "BRUT",
        "MoteurCommande",
        cmd.idCommande,
        "COMMANDE",
        "GLOBAL",
        "COMMANDE_CLOSE",
        "LEAD_TIME",
        lt,
        "s",
        "",
        Double.NaN,
        "",
        commentaire == null ? "Commande cloturee" : commentaire
    );

    addTrace(
        "BRUT", "MoteurCommande", cmd.idCommande, "COMMANDE", "GLOBAL",
        "COMMANDE_CLOSE", "ORDER_PROCESSING_TIME", Math.max(0.0, lt - wt), "s",
        "COMMANDE_CLIENTE", Double.NaN, "", "Temps de traitement propre a la commande"
    );

    addTrace(
        "BRUT", "MoteurCommande", cmd.idCommande, "COMMANDE", "GLOBAL",
        "COMMANDE_CLOSE", "ORDER_WAITING_DWELL_TIME", wt, "s",
        "COMMANDE_CLIENTE", Double.NaN, "", "Attente explicite de disponibilite du stock"
    );

    addTrace(
        "AGG_GLOBAL",
        "BlackboardAgent",
        cmd.idCommande,
        "COMMANDE",
        "GLOBAL",
        "GLOBAL_UPDATE",
        "LEAD_TIME_MOYEN",
        lt,
        "s",
        "GLOBAL",
        board != null && board.kpiGlobal != null ? board.kpiGlobal.avgLeadTime() : lt,
        "sumLeadTime / nombreCommandesCloses",
        "Mise a jour globale depuis commande cloturee " + cmd.idCommande
    );

    // Clôture sprint S1 : si la commande est réellement en retard, ce n'est
    // pas un mock AER. L'alerte part d'un événement métier runtime et permet
    // de prouver la propagation opérationnel -> Blackboard -> tactique -> supervision.
    publierAERRetardCommande(cmd, lt);
}

// ============================================================
// TABLEAU DE SUIVI TEMPS REEL — journal lisible par utilisateur
// ------------------------------------------------------------
// Objectif : fournir une lecture simple de ce qui se passe dans la
// simulation, sans obliger l'utilisateur a interpreter les logs techniques.
// Chaque entree est horodatee au temps de simulation.
// ============================================================

public java.util.ArrayList<SuiviSimulationEvent> journalSuiviSimulation =
    new java.util.ArrayList<SuiviSimulationEvent>();

public int maxJournalSuiviSimulation = 800;

private javax.swing.JDialog suiviTempsReelDialog = null;
private javax.swing.table.DefaultTableModel suiviTempsReelModel = null;
private javax.swing.JLabel suiviTempsReelLabel = null;
private javax.swing.Timer suiviTempsReelTimer = null;

public class SuiviSimulationEvent implements java.io.Serializable {
    public double t = 0;

    public String type = "";
    public String evenement = "";
    public String description = "";

    public String decideur = "";
    public String executant = "";
    public String objet = "";
    public String quantite = "";

    public String source = "";
    public String destination = "";
    public String flux = "";
    public String scor = "";

    public String decision = "";
    public String statutAvant = "";
    public String statutApres = "";
    public String metriques = "";

    public SuiviSimulationEvent(
        double t,
        String type,
        String evenement,
        String description,
        String decideur,
        String executant,
        String objet,
        String quantite,
        String source,
        String destination,
        String flux,
        String scor,
        String decision,
        String statutAvant,
        String statutApres,
        String metriques
    ) {
        this.t = t;
        this.type = texteSimple(type);
        this.evenement = texteSimple(evenement);
        this.description = texteSimple(description);

        this.decideur = texteSimple(decideur);
        this.executant = texteSimple(executant);
        this.objet = texteSimple(objet);
        this.quantite = texteSimple(quantite);

        this.source = texteSimple(source);
        this.destination = texteSimple(destination);
        this.flux = texteSimple(flux);
        this.scor = texteSimple(scor);

        this.decision = texteSimple(decision);
        this.statutAvant = texteSimple(statutAvant);
        this.statutApres = texteSimple(statutApres);
        this.metriques = texteSimple(metriques);
    }
}

String tempsLisible(double t) {
    if (Double.isNaN(t) || Double.isInfinite(t)) return "—";

    int total = (int) Math.max(0, Math.round(t));
    int h = total / 3600;
    int m = (total % 3600) / 60;
    int s = total % 60;

    return String.format("T=%d:%02d:%02d", h, m, s);
}

String texteSimple(String s) {
    if (s == null) return "";

    String r = s
        .replace('\n', ' ')
        .replace('\r', ' ')
        .replace('|', '/')
        .trim();

    return r.replaceAll("\\s+", " ");
}

String valeurOuTiret(String s) {
    String r = texteSimple(s);
    return r.isEmpty() || r.equals("—") || r.equals("- > -") || r.equals("— -> —") ? "Non applicable" : r;
}

String statutTransitionLisible(SuiviSimulationEvent ev) {
    String a = texteSimple(ev == null ? "" : ev.statutAvant);
    String b = texteSimple(ev == null ? "" : ev.statutApres);
    boolean va = a.isEmpty() || a.equals("—");
    boolean vb = b.isEmpty() || b.equals("—");
    if (va && vb) return "Non applicable";
    if (va) return b;
    if (vb) return a;
    return a + " -> " + b;
}

String extraireValeurDepuisDetail(String detail, String cle) {
    if (detail == null || cle == null) return "";

    try {
        String[] morceaux = detail.split("\\|");
        for (String m : morceaux) {
            String x = m.trim();
            if (x.toLowerCase().startsWith(cle.toLowerCase() + "=")) {
                return x.substring(x.indexOf("=") + 1).trim();
            }
        }
    } catch (Throwable ignored) {}

    return "";
}

String devinerObjetDepuisDetail(String detail) {
    String commande = extraireValeurDepuisDetail(detail, "Commande");
    if (!commande.isEmpty()) return "Commande " + commande;

    String flux = extraireValeurDepuisDetail(detail, "Flux");
    if (!flux.isEmpty()) return "Flux " + flux;

    String produit = extraireValeurDepuisDetail(detail, "Produit");
    if (!produit.isEmpty()) return "Produit " + produit;

    String matiere = extraireValeurDepuisDetail(detail, "Matiere");
    if (!matiere.isEmpty()) return "Matiere " + matiere;

    return "";
}

String devinerQuantiteDepuisDetail(String detail) {
    String qte = extraireValeurDepuisDetail(detail, "Quantite");
    if (!qte.isEmpty()) return qte;

    String q = extraireValeurDepuisDetail(detail, "Qte");
    if (!q.isEmpty()) return q;

    return "";
}

synchronized void ajouterSuivi(
    String type,
    String evenement,
    String detail,
    String source,
    String destination,
    String scor
) {
    String objetDetecte = devinerObjetDepuisDetail(detail);
    String qteDetectee = devinerQuantiteDepuisDetail(detail);

    ajouterSuiviDetaille(
        type,
        evenement,
        detail,
        "—",
        source,
        objetDetecte,
        qteDetectee,
        source,
        destination,
        source + " -> " + destination,
        scor,
        "—",
        "—",
        "—",
        "—"
    );
}


boolean estEvenementSuiviImportant(String type, String evenement) {
    String t = keyAnim(type);
    String e = keyAnim(evenement);

    // Le tableau de suivi doit rester pedagogique : on retire les lignes
    // techniques ou redondantes. Les animations et messages bas niveau restent
    // dans les logs AnyLogic, mais ne polluent plus le journal utilisateur.
    if (e.startsWith("FLUX ANIME")) return false;
    if (t.equals("MESSAGE") || t.equals("COMMANDE") || t.equals("ORDER")) {
        // Les lignes "Commande" riches sont conservees car leur type est "Commande"
        // et leur evenement n'est pas "Flux anime". Les types minuscules viennent
        // des animations et sont filtres par l'evenement ci-dessus.
        if (e.startsWith("FLUX ANIME")) return false;
    }

    if (t.equals("COMMUNICATION")) return false;
    if (t.equals("FLUX PHYSIQUE")) return false;
    if (t.equals("LIVRAISON") && e.equals("PREPARATION DE LA LIVRAISON CLIENT")) return false;
    if (t.equals("APPROVISIONNEMENT") && e.contains("PREPARATION") && e.contains("LIVRAISON") && e.contains("FOURNISSEUR")) return false;
    if (t.equals("SOURCINGTRUCK") || t.equals("DELIVERYTRUCK") || t.equals("VEHICULERETOUR")) return false;
    if (t.equals("ENTREE POSTE")) return false;
    if (t.equals("DEPLACEMENT")) return false;
    if (t.equals("MICRO-ACTIVITE")) return false;

    // Evite les lignes par unite qui saturent le tableau lorsque qte > 1.
    if (t.equals("PRODUIT") && e.contains("CREATION DUN PRODUIT")) return false;
    if (t.equals("ROUTAGE")) return false;

    return true;
}

synchronized void ajouterSuiviDetailleHorodate(
    double tAffiche,
    String type,
    String evenement,
    String description,
    String decideur,
    String executant,
    String objet,
    String quantite,
    String source,
    String destination,
    String flux,
    String scor,
    String decision,
    String statutAvant,
    String statutApres,
    String metriques
) {
    if (!estEvenementSuiviImportant(type, evenement)) {
        try {
            // C14.15 -- log [SUIVI-TECH] desactive : 2 lignes par deplacement
            // d'entite saturaient la console. Le tableau de suivi metier reste
            // alimente normalement (ajouterSuivi / suiviDetaille).
        } catch (Throwable ignored) {}
        return;
    }

    String cle = cleSuiviMetier(type, evenement, description, objet);
    if (cle != null && !cle.isEmpty()) {
        if (clesSuiviMetierDejaVues.contains(cle)) {
            try { board.logEvent("[SUIVI-DOUBLON] " + cle + " ignore"); } catch (Throwable ignored) {}
            return;
        }
        clesSuiviMetierDejaVues.add(cle);
    }

    double t = Double.isNaN(tAffiche) || Double.isInfinite(tAffiche) ? time() : Math.max(0.0, tAffiche);
    SuiviSimulationEvent ev = new SuiviSimulationEvent(
        t,
        type,
        evenement,
        description,
        decideur,
        executant,
        objet,
        quantite,
        source,
        destination,
        flux,
        scor,
        decision,
        statutAvant,
        statutApres,
        metriques
    );

    journalSuiviSimulation.add(ev);

    while (journalSuiviSimulation.size() > maxJournalSuiviSimulation) {
        journalSuiviSimulation.remove(0);
    }

    board.logEvent(
        "[SUIVI] "
        + tempsLisible(ev.t)
        + " | " + ev.evenement
        + " | " + ev.description
        + " | Decision=" + ev.decision
    );
}

synchronized void ajouterSuiviDetaille(
    String type,
    String evenement,
    String description,
    String decideur,
    String executant,
    String objet,
    String quantite,
    String source,
    String destination,
    String flux,
    String scor,
    String decision,
    String statutAvant,
    String statutApres,
    String metriques
) {
    if (!estEvenementSuiviImportant(type, evenement)) {
        try {
            // C14.15 -- log [SUIVI-TECH] desactive : 2 lignes par deplacement
            // d'entite saturaient la console. Le tableau de suivi metier reste
            // alimente normalement (ajouterSuivi / suiviDetaille).
        } catch (Throwable ignored) {}
        return;
    }

    String cle = cleSuiviMetier(type, evenement, description, objet);
    if (cle != null && !cle.isEmpty()) {
        if (clesSuiviMetierDejaVues.contains(cle)) {
            try { board.logEvent("[SUIVI-DOUBLON] " + cle + " ignore"); } catch (Throwable ignored) {}
            return;
        }
        clesSuiviMetierDejaVues.add(cle);
    }

SuiviSimulationEvent ev = new SuiviSimulationEvent(
        time(),
        type,
        evenement,
        description,
        decideur,
        executant,
        objet,
        quantite,
        source,
        destination,
        flux,
        scor,
        decision,
        statutAvant,
        statutApres,
        metriques
    );

    journalSuiviSimulation.add(ev);

    while (journalSuiviSimulation.size() > maxJournalSuiviSimulation) {
        journalSuiviSimulation.remove(0);
    }

    board.logEvent(
        "[SUIVI] "
        + tempsLisible(ev.t)
        + " | " + ev.evenement
        + " | " + ev.description
        + " | Decision=" + ev.decision
    );
}

synchronized void resetSuiviSimulation() {
    journalSuiviSimulation.clear();
    clesSuiviMetierDejaVues.clear();
}

Object[][] lignesSuiviSimulation() {
    synchronized (this) {
        Object[][] rows = new Object[journalSuiviSimulation.size()][16];

        for (int i = 0; i < journalSuiviSimulation.size(); i++) {
            SuiviSimulationEvent ev = journalSuiviSimulation.get(i);

            rows[i][0]  = i + 1;
            rows[i][1]  = tempsLisible(ev.t);
            rows[i][2]  = valeurOuTiret(ev.type);
            rows[i][3]  = valeurOuTiret(ev.evenement);
            rows[i][4]  = valeurOuTiret(ev.description);

            rows[i][5]  = valeurOuTiret(ev.decideur);
            rows[i][6]  = valeurOuTiret(ev.executant);
            rows[i][7]  = valeurOuTiret(ev.objet);
            rows[i][8]  = valeurOuTiret(ev.quantite);

            rows[i][9]  = valeurOuTiret(ev.source);
            rows[i][10] = valeurOuTiret(ev.destination);
            rows[i][11] = valeurOuTiret(ev.flux);
            rows[i][12] = valeurOuTiret(ev.scor);

            rows[i][13] = valeurOuTiret(ev.decision);
            rows[i][14] = statutTransitionLisible(ev);
            rows[i][15] = valeurOuTiret(ev.metriques);
        }

        return rows;
    }
}

void rafraichirSuiviTempsReelTable() {
    if (suiviTempsReelModel == null) return;

    Object[][] rows = lignesSuiviSimulation();

    suiviTempsReelModel.setRowCount(0);

    for (int i = 0; i < rows.length; i++) {
        suiviTempsReelModel.addRow(rows[i]);
    }

    if (suiviTempsReelLabel != null) {
        suiviTempsReelLabel.setText(
            "Evenements suivis : "
            + rows.length
            + " | Temps simulation : "
            + tempsLisible(time())
        );
    }
}

void ouvrirSuiviTempsReel() {
    javax.swing.SwingUtilities.invokeLater(new Runnable() {
        public void run() {
            try {
                if (suiviTempsReelDialog != null && suiviTempsReelDialog.isDisplayable()) {
                    rafraichirSuiviTempsReelTable();
                    suiviTempsReelDialog.setVisible(true);
                    suiviTempsReelDialog.toFront();
                    suiviTempsReelDialog.requestFocus();
                    return;
                }

                java.awt.Window owner =
                    java.awt.KeyboardFocusManager
                        .getCurrentKeyboardFocusManager()
                        .getActiveWindow();

                if (owner != null) {
                    suiviTempsReelDialog = new javax.swing.JDialog(
                        owner,
                        "Suivi temps reel de la simulation",
                        java.awt.Dialog.ModalityType.MODELESS
                    );
                } else {
                    suiviTempsReelDialog = new javax.swing.JDialog(
                        (java.awt.Frame) null,
                        "Suivi temps reel de la simulation",
                        false
                    );
                }

                suiviTempsReelDialog.setDefaultCloseOperation(
                    javax.swing.WindowConstants.DISPOSE_ON_CLOSE
                );
                suiviTempsReelDialog.setLayout(new java.awt.BorderLayout());

                String[] columns = new String[] {
                    "N° chronologique",
                    "Horodatage simule",
                    "Categorie d'evenement",
                    "Evenement principal",
                    "Explication metier",
                    "Agent decideur",
                    "Agent executant",
                    "Element suivi",
                    "Valeur ou quantite concernee",
                    "Origine du flux",
                    "Cible du flux",
                    "Chemin parcouru",
                    "Processus SCOR associe",
                    "Decision metier retenue",
                    "Evolution du statut",
                    "Indicateurs produits"
                };

                suiviTempsReelModel = new javax.swing.table.DefaultTableModel(columns, 0) {
                    public boolean isCellEditable(int row, int column) {
                        return false;
                    }
                };

                javax.swing.JTable table = new javax.swing.JTable(suiviTempsReelModel);
                table.setAutoCreateRowSorter(true);
                table.setFillsViewportHeight(true);
                table.setRowHeight(30);
                table.setAutoResizeMode(javax.swing.JTable.AUTO_RESIZE_OFF);
                table.setFont(new java.awt.Font("Dialog", java.awt.Font.PLAIN, 12));
                table.getTableHeader().setFont(new java.awt.Font("Dialog", java.awt.Font.BOLD, 12));

                int[] widths = new int[] {
                    45, 95, 130, 260, 420, 220, 220, 220,
                    150, 220, 220, 260, 180, 300, 260, 360
                };

                for (int i = 0; i < widths.length && i < table.getColumnCount(); i++) {
                    table.getColumnModel().getColumn(i).setPreferredWidth(widths[i]);
                }

                javax.swing.JScrollPane scroll = new javax.swing.JScrollPane(table);
                suiviTempsReelDialog.add(scroll, java.awt.BorderLayout.CENTER);

                javax.swing.JPanel top = new javax.swing.JPanel(new java.awt.BorderLayout());

                suiviTempsReelLabel = new javax.swing.JLabel(" ");
                suiviTempsReelLabel.setFont(new java.awt.Font("Dialog", java.awt.Font.BOLD, 12));
                top.add(suiviTempsReelLabel, java.awt.BorderLayout.WEST);

                javax.swing.JLabel note = new javax.swing.JLabel(
                    "Lecture simple : chaque ligne explique l'evenement, l'agent decideur, l'agent executant, l'element suivi et les indicateurs produits."
                );
                note.setFont(new java.awt.Font("Dialog", java.awt.Font.PLAIN, 12));
                top.add(note, java.awt.BorderLayout.EAST);

                suiviTempsReelDialog.add(top, java.awt.BorderLayout.NORTH);

                javax.swing.JPanel bottom =
                    new javax.swing.JPanel(new java.awt.FlowLayout(java.awt.FlowLayout.RIGHT));

                javax.swing.JButton refresh = new javax.swing.JButton("Rafraichir maintenant");
                refresh.addActionListener(new java.awt.event.ActionListener() {
                    public void actionPerformed(java.awt.event.ActionEvent e) {
                        rafraichirSuiviTempsReelTable();
                    }
                });

                javax.swing.JButton close = new javax.swing.JButton("Fermer");
                close.addActionListener(new java.awt.event.ActionListener() {
                    public void actionPerformed(java.awt.event.ActionEvent e) {
                        suiviTempsReelDialog.dispose();
                    }
                });

                bottom.add(refresh);
                bottom.add(close);

                suiviTempsReelDialog.add(bottom, java.awt.BorderLayout.SOUTH);

                suiviTempsReelDialog.addWindowListener(new java.awt.event.WindowAdapter() {
                    public void windowClosed(java.awt.event.WindowEvent e) {
                        if (suiviTempsReelTimer != null) suiviTempsReelTimer.stop();

                        suiviTempsReelTimer = null;
                        suiviTempsReelModel = null;
                        suiviTempsReelLabel = null;
                    }
                });

                suiviTempsReelTimer = new javax.swing.Timer(
                    1000,
                    new java.awt.event.ActionListener() {
                        public void actionPerformed(java.awt.event.ActionEvent e) {
                            rafraichirSuiviTempsReelTable();
                        }
                    }
                );

                suiviTempsReelTimer.start();

                rafraichirSuiviTempsReelTable();

                suiviTempsReelDialog.setSize(1700, 760);
                suiviTempsReelDialog.setMinimumSize(new java.awt.Dimension(1250, 560));
                suiviTempsReelDialog.setLocationRelativeTo(owner);
                suiviTempsReelDialog.setAlwaysOnTop(true);
                suiviTempsReelDialog.setVisible(true);
                suiviTempsReelDialog.toFront();

            } catch (Throwable ex) {
                ex.printStackTrace();

                try {
                    getExperimentHost().showMessageDialog(
                        "Erreur ouverture du suivi temps reel : " + ex.getMessage()
                    );
                } catch (Throwable ignored) {
                    traceln("[SUIVI] erreur ouverture : " + ex.getMessage());
                }
            }
        }
    });
}

public class Order implements java.io.Serializable {
    public String idOrder = "";
    public String idCommande = "";
    public String typeStrategie = "MTS";
    public String idScenario = "";
    public int quantite = 0;
    public double tCreation = 0;
    public double tPromise = 0;
    public String statut = "CREE";
    public java.util.ArrayList<String> produitIds = new java.util.ArrayList<String>();
    public java.util.ArrayList<String> journal = new java.util.ArrayList<String>();

    public Order() {}

    public Order(CommandeAgent cmd) {
        synchroniser(cmd);
    }

    public void synchroniser(CommandeAgent cmd) {
        if (cmd == null) return;
        idCommande = cmd.idCommande;
        idOrder = "ORD_" + cmd.idCommande;
        typeStrategie = cmd.typeCommande;
        idScenario = cmd.idScenario;
        quantite = cmd.qte;
        tCreation = cmd.tCreation;
        tPromise = cmd.tPromise;
        statut = normaliserStatutCommande(cmd.statut);
    }

    public String normaliserStatutCommande(String s) {
        if (s == null || s.trim().isEmpty()) return "CREE";
        if ("EN_ATTENTE".equals(s)) return "CREE";
        if ("EN_COURS".equals(s)) return "EN_EXECUTION";
        if ("SERVIE".equals(s)) return "LIVREE";
        if ("EN_RETARD".equals(s)) return "LIVREE_EN_RETARD";
        return s;
    }

    public boolean isMTS() { return "MTS".equalsIgnoreCase(typeStrategie); }
    public boolean isMTO() { return "MTO".equalsIgnoreCase(typeStrategie); }
    public boolean isETO() { return "ETO".equalsIgnoreCase(typeStrategie); }

    public void valider(double t) {
        statut = "VALIDEE";
        journal.add(String.format("T=%.1f | commande validee", t));
    }

    public void lancerExecution(double t) {
        statut = "EN_EXECUTION";
        journal.add(String.format("T=%.1f | execution lancee", t));
    }

    public void ajouterProduit(String idProduit) {
        if (idProduit != null && !idProduit.isEmpty() && !produitIds.contains(idProduit)) {
            produitIds.add(idProduit);
        }
    }

    public void cloturer(String statutFinal, double t) {
        statut = statutFinal;
        journal.add(String.format("T=%.1f | order cloture : %s", t, statutFinal));
    }

    public String resumeCourt() {
        return idOrder + " / " + typeStrategie + " / qte=" + quantite + " / statut=" + statut;
    }

    public String descriptionFlux() {
        return "Order Agent " + idOrder + "\n"
             + "Commande source : " + idCommande + "\n"
             + "Strategie : " + typeStrategie + "\n"
             + "Scenario/produit : " + idScenario + "\n"
             + "Quantite : " + quantite + "\n"
             + "Statut : " + statut;
    }
}

public class Produit implements java.io.Serializable {
    public String idProduitAgent = "";
    public String idOrder = "";
    public String idCommande = "";
    public String typeProduit = "";
    public String strategie = "";
    public String statut = "CREE";
    public double tCreation = 0;
    public double tFin = -1;
    public java.util.ArrayList<String> routeSCOR = new java.util.ArrayList<String>();
    public String posteCourant = "";
    public String dernierCodeSCOR = "";

    public Produit() {}

    public Produit(String idProduitAgent, Order order, String typeProduit, java.util.List<String> route) {
        this.idProduitAgent = idProduitAgent;
        if (order != null) {
            this.idOrder = order.idOrder;
            this.idCommande = order.idCommande;
            this.strategie = order.typeStrategie;
        }
        this.typeProduit = typeProduit;
        this.tCreation = time();
        definirRoute(route);
    }

    public void definirRoute(java.util.List<String> route) {
        routeSCOR.clear();
        if (route != null) routeSCOR.addAll(route);
    }

    public void demarrer(String poste, String codeSCOR, double t) {
        statut = "EN_COURS";
        posteCourant = poste != null ? poste : "";
        dernierCodeSCOR = codeSCOR != null ? codeSCOR : "";
    }

    public void passerPar(String poste, String codeSCOR) {
        posteCourant = poste != null ? poste : "";
        dernierCodeSCOR = codeSCOR != null ? codeSCOR : "";
    }

    public void terminer(String statutFinal, double t) {
        statut = statutFinal;
        tFin = t;
    }

    public String routeTexte() {
        if (routeSCOR == null || routeSCOR.isEmpty()) return "(route non definie)";
        return String.join(" -> ", routeSCOR);
    }

    public String descriptionFlux() {
        return "Produit Agent " + idProduitAgent + "\n"
             + "Order : " + idOrder + "\n"
             + "Commande : " + idCommande + "\n"
             + "Type/strategie : " + typeProduit + " / " + strategie + "\n"
             + "Statut : " + statut + "\n"
             + "Poste courant : " + posteCourant + "\n"
             + "Dernier code SCOR : " + dernierCodeSCOR + "\n"
             + "Route : " + routeTexte();
    }
}

Order creerOuSynchroniserOrder(CommandeAgent cmd) {
    if (cmd == null) return null;
    Order o = orderRegistry.get(cmd.idCommande);
    if (o == null) {
        o = new Order(cmd);
        orderRegistry.put(cmd.idCommande, o);
        board.logEvent("[ORDER] creation " + o.resumeCourt());
    } else {
        o.synchroniser(cmd);
    }
    return o;
}

Produit creerProduitAgentPourFlux(FluxEntity e, CommandeAgent cmd, int index, java.util.List<String> routeBase) {
    if (e == null || cmd == null) return null;
    Order o = creerOuSynchroniserOrder(cmd);
    String idProd = "PRD_" + e.idFlux;
    Produit p = new Produit(idProd, o, e.typeProduit, routeBase);
    if (o != null) o.ajouterProduit(idProd);
    produitRegistry.put(e.idFlux, p);
    produitRegistry.put(idProd, p);
    board.logEvent("[PRODUIT] creation " + idProd + " pour " + cmd.idCommande + " route=" + p.routeTexte());
    return p;
}

void mettreAJourProduitPassage(FluxEntity e, PosteGenericAgent poste) {
    if (e == null) return;
    Produit p = produitRegistry.get(e.idFlux);
    if (p == null) return;
    if (poste != null) p.passerPar(poste.nom, poste.codeSCOR);
}

void cloturerProduitAgent(FluxEntity e, String statutFinal) {
    if (e == null) return;
    Produit p = produitRegistry.get(e.idFlux);
    if (p == null) return;
    p.terminer(statutFinal, time());
    board.logEvent("[PRODUIT] " + p.idProduitAgent + " -> " + statutFinal + " LT=" + String.format("%.1f", time() - p.tCreation) + "s");
}

void cloturerOrderDepuisCommande(CommandeAgent cmd) {
    if (cmd == null) return;
    Order o = creerOuSynchroniserOrder(cmd);
    if (o == null) return;
    String statutOrder = "SERVIE".equals(cmd.statut) ? "LIVREE" : ("EN_RETARD".equals(cmd.statut) ? "LIVREE_EN_RETARD" : cmd.statut);
    o.cloturer(statutOrder, time());
    board.logEvent("[ORDER] " + o.idOrder + " -> " + statutOrder);
}

void afficherFluxAnimation(String nature, String scor, String src, String dst, String objet) {
    if (!fluxShowMessagesActifs) return;
    String n = nature != null ? nature : "";
    String s = (scor != null && !scor.trim().isEmpty()) ? scor : "non precise";
    String source = src != null ? src : "";
    String destination = dst != null ? dst : "";
    String obj = objet != null ? objet : "";

    // Les animations restent dans les logs techniques. Le tableau et les popups
    // ne gardent que les etapes metier majeures pour eviter la saturation.
    board.logEvent("[FLUX] " + n + " | " + source + " -> " + destination + " | " + obj);

    boolean popupEssentiel = n.equalsIgnoreCase("ORDER")
        || n.equalsIgnoreCase("deliveryTruck")
        || n.equalsIgnoreCase("vehiculeRetour")
        || obj.toUpperCase(java.util.Locale.ROOT).contains("LIVRAISON FINALE")
        || obj.toUpperCase(java.util.Locale.ROOT).contains("RETOUR CLIENT");

    boolean popupDetaille = popupEssentiel
        || n.equalsIgnoreCase("sourcingTruck")
        || obj.toUpperCase(java.util.Locale.ROOT).contains("APPROVISIONNEMENT")
        || obj.toUpperCase(java.util.Locale.ROOT).contains("MATIERE");

    if (!popupDetaille) return;

    String msg = "Flux " + n + "\n"
        + "SCOR : " + s + "\n"
        + "Source : " + source + "\n"
        + "Destination : " + destination + "\n"
        + "Objet : " + obj;

    afficherPopupMetier("Flux metier", "Flux " + n, msg, popupEssentiel ? "ESSENTIEL" : "DETAILLE");
}

String extraireSCORDepuisInfo(String info) {
    if (info == null) return "";
    String u = info.toUpperCase(java.util.Locale.ROOT);
    int i = u.indexOf("SCOR");
    if (i < 0) return "";
    String s = info.substring(i).trim();
    int sep = s.indexOf(":");
    if (sep >= 0) s = s.substring(0, sep).trim();
    if (s.length() > 80) s = s.substring(0, 80);
    return s;
}


// ============================================================
// CATALOGUE MULTI-PRODUIT DYNAMIQUE
// ============================================================
// Aucun produit n'est créé en dur. La vue « Configurer nomenclature » et la
// création des scénarios restent les seules sources de vérité. Chaque
// ScenarioFlux non associé à un profil de test devient une référence produit
// disponible dans Main. La nomenclature déjà portée par ScenarioFlux est donc
// réutilisée directement pour le MRP, les stocks et les exports.
// C14.12 -- MODE MULTI-PRODUIT DESACTIVE. Ce mecanisme (ajout de la fusion)
// attribue un stock produit fini distinct a chaque entree de "scenarios". Or
// les scenarios du cas ZENER sont des CAS DE TEST (SCENARIO DISTRIBUTION,
// ZENER CAS 1/2/3...), pas des produits : le modele creait donc un stock de
// champStockInitialProduitFini pour chacun, gonflant artificiellement le stock
// total. Surtout, la decision metier (analyserStockCommandeOrchestree) lisait
// stockFiniParProduit tandis que la carte du tableau de bord et
// stockProduitFiniDisponibleTotal() lisaient niveauStock : deux sources de
// verite divergentes, d'ou des commandes acceptees alors que le stock reel
// etait epuise, et Make/Source jamais declenches.
// Avec false, consommerStockFiniProduit() emprunte la branche mono-produit qui
// decremente directement niveauStock du poste de stock fini : une seule source
// de verite, comme dans la version stable d'avant fusion.
// A reactiver le jour ou les 4 formats de bouteilles (3 / 6 / 12,5 / 25 kg)
// seront reellement modelises comme produits distincts (fichesMatiere +
// nomenclatures par format + separation produits / cas de test).
public boolean modeMultiProduitActif = false;
public boolean rotationProduitsActive = false;
public String nomProduitParDefaut = "";

public class LigneCommandeProduit implements java.io.Serializable {
    public String codeProduit = "";
    public String libelleProduit = "";
    public int quantite = 0;
    public LigneCommandeProduit() {}
    public LigneCommandeProduit(String codeProduit, String libelleProduit, int quantite) {
        this.codeProduit = codeProduit != null ? codeProduit : "";
        this.libelleProduit = libelleProduit != null ? libelleProduit : "";
        this.quantite = quantite;
    }
}

// Liste dédiée demandée : elle est enregistrée au Main et reconstruite à
// partir des scénarios/nomenclatures effectivement configurés par l'utilisateur.
public java.util.ArrayList<ScenarioFlux> listeProduits = new java.util.ArrayList<ScenarioFlux>();
public java.util.LinkedHashMap<String, ScenarioFlux> catalogueProduits =
    new java.util.LinkedHashMap<String, ScenarioFlux>();
public java.util.LinkedHashMap<String, Double> stockFiniParProduit =
    new java.util.LinkedHashMap<String, Double>();
// Bloc M.1 -- configuration optionnelle chargee du JSON. En mode multi-produit,
// les valeurs sont des stocks initiaux PAR PRODUIT. Si la map est vide, le stock
// global (champStockInitialProduitFini) est reparti equitablement entre les
// references afin de ne jamais le multiplier (voir stockInitialConfigurePourProduit()).
public java.util.LinkedHashMap<String, Double> stockInitialParProduit =
    new java.util.LinkedHashMap<String, Double>();
public java.util.LinkedHashMap<String, java.util.ArrayList<LigneCommandeProduit>> lignesProduitParCommande =
    new java.util.LinkedHashMap<String, java.util.ArrayList<LigneCommandeProduit>>();

// Bloc M.3 -- cache PAR PRODUIT de la quantite economique (Q*) de la
// politique (s,Q) autonome produit fini, pour verifierPolitiqueStockPourUnProduit()
// ci-dessous. Meme principe que stockFiniParProduit : chaque produit
// catalogue a son propre etat, jamais partage/agrege. Reproduit pour chaque
// produit le comportement de gel du Q* une fois calcule (C14.58/C14.66,
// voir le champ historique quantiteEconomiqueProduit, qui reste la variable
// utilisee telle quelle par la branche MONO, strictement inchangee). Vide au
// demarrage, remis a zero par reinitialiserPolitiquesStockPourRun(). Il n'y
// a pas d'equivalent pour le point de commande : contrairement au Q*, il
// n'a jamais ete fige d'un cycle a l'autre (recalcule a chaque appel, en
// mono comme en multi), donc aucun cache n'est necessaire pour lui.
public java.util.LinkedHashMap<String, Double> quantiteEconomiqueParProduit =
    new java.util.LinkedHashMap<String, Double>();

String cleProduit(String nom) {
    return nom == null ? "" : nom.trim().toUpperCase(java.util.Locale.ROOT);
}

boolean estProduitEnregistrable(ScenarioFlux sc) {
    return sc != null
        && sc.typeProduit != null
        && !sc.typeProduit.trim().isEmpty()
        && !estScenarioCasTest(sc);
}

void synchroniserListeProduits() {
    String ancienDefaut = nomProduitParDefaut;
    listeProduits.clear();
    catalogueProduits.clear();

    if (scenarios != null) {
        for (ScenarioFlux sc : scenarios) {
            if (!estProduitEnregistrable(sc)) continue;
            String cle = cleProduit(sc.typeProduit);
            if (cle.isEmpty() || catalogueProduits.containsKey(cle)) continue;
            catalogueProduits.put(cle, sc);
            listeProduits.add(sc);
        }
    }

    if (!ancienDefaut.isEmpty() && catalogueProduits.containsKey(cleProduit(ancienDefaut))) {
        nomProduitParDefaut = catalogueProduits.get(cleProduit(ancienDefaut)).typeProduit;
    } else {
        // Priorité à une référence possédant déjà une nomenclature ; sinon
        // première référence créée par l'utilisateur.
        ScenarioFlux candidat = null;
        for (ScenarioFlux sc : listeProduits) {
            if (sc.nomenclature != null && !sc.nomenclature.isEmpty()) { candidat = sc; break; }
        }
        if (candidat == null && !listeProduits.isEmpty()) candidat = listeProduits.get(0);
        nomProduitParDefaut = candidat != null ? candidat.typeProduit : "";
    }
}

ScenarioFlux scenarioProduitParNom(String nom) {
    synchroniserListeProduits();
    return catalogueProduits.get(cleProduit(nom));
}

ScenarioFlux scenarioProduitParDefaut() {
    synchroniserListeProduits();
    ScenarioFlux sc = catalogueProduits.get(cleProduit(nomProduitParDefaut));
    if (sc != null) return sc;
    return listeProduits.isEmpty() ? null : listeProduits.get(0);
}

// Bloc M.1 -- somme des stocks par produit : c'est la SEULE base legitime pour
// reconstruire un agregat en mode multi-produit (jamais une duplication du
// stock global). Portage generique de la reference technique DataCo
// (reference/dataco-multiproduct), mecanisme sans aucun lien avec les
// donnees/produits DataCo eux-memes.
double sommeStockFiniParProduit() {
    double total = 0.0;
    if (stockFiniParProduit != null) {
        for (Double v : stockFiniParProduit.values()) {
            if (v != null && !Double.isNaN(v) && !Double.isInfinite(v)) total += Math.max(0.0, v);
        }
    }
    return total;
}

// Bloc M.1 -- synchronise niveauStock (agregat d'affichage/KPI compatibilite)
// a partir de stockFiniParProduit (source de verite en mode multi-produit).
// No-op tant que modeMultiProduitActif=false : le mono-produit garde niveauStock
// comme unique source de verite, exactement comme avant ce bloc.
void synchroniserStockFiniAgrege(PosteGenericAgent fallback) {
    if (!modeMultiProduitActif) return;
    double total = sommeStockFiniParProduit();
    boolean applique = false;
    if (postes != null) {
        for (PosteGenericAgent p : postes) {
            if (p == null || !estPosteStockFini(p)) continue;
            p.niveauStock = total;
            applique = true;
        }
    }
    if (!applique && fallback != null) fallback.niveauStock = total;
}

// Bloc M.1-FIX -- stock initial d'UN produit : valeur explicite du JSON
// (stockInitialParProduit) si configuree pour CE produit, sinon
// allocationParDefaut (deja calculee par l'appelant a partir du RELIQUAT reel,
// pas d'une simple division globale/N -- voir initialiserStocksProduits()).
// C'est cette fonction, combinee au calcul de reliquat de l'appelant, qui
// empeche le bug de duplication (stock global x N produits) ET le bug de
// creation de stock (configuration partielle mal repartie, voir M.1-FIX).
double stockInitialConfigurePourProduit(ScenarioFlux sc, double allocationParDefaut) {
    String cle = cleProduit(sc != null ? sc.typeProduit : "");
    Double configure = stockInitialParProduit != null ? stockInitialParProduit.get(cle) : null;
    if (configure != null && !Double.isNaN(configure) && !Double.isInfinite(configure)) {
        return Math.max(0.0, configure);
    }
    return Math.max(0.0, allocationParDefaut);
}

// Bloc M.1 -- CORRECTIF DE FOND. Version precedente : chaque produit recevait
// Math.max(0.0, champStockInitialProduitFini) SANS DIVISION -- un stock global de
// 18000 avec 3 produits donnait 18000+18000+18000=54000, une duplication pure et
// simple deja identifiee et documentee comme defaut connu (voir le commentaire
// C14.10/C14.12 historique de consommerStockFiniProduit() juste en dessous).
// en mono-produit, le comportement historique est conserve a l'identique (la map
// reste peuplee de champStockInitialProduitFini par entree, mais elle n'est lue
// nulle part tant que modeMultiProduitActif=false -- consommerStockFiniProduit()
// et stockFiniDisponiblePourScenario() empruntent alors la branche mono-produit,
// qui ne touche que PosteGenericAgent.niveauStock, seule source de verite mono).
//
// Bloc M.1-FIX -- CONFIGURATION PARTIELLE. La premiere version divisait
// systematiquement champStockInitialProduitFini par le nombre TOTAL de produits,
// y compris ceux deja configures explicitement dans stockInitialParProduit :
// global=18000, A configure a 10000, B/C non configures -> A=10000, B=6000,
// C=6000 (18000/3), total=22000 -- une creation artificielle de 4000 unites,
// alors que champStockInitialProduitFini est cense representer le TOTAL. Corrige
// en calculant d'abord le RELIQUAT reel (global - somme des valeurs explicites
// des produits reellement catalogues, les cles inconnues du catalogue etant
// ignorees pour ce calcul) puis en le repartissant uniquement entre les
// produits NON configures : global=18000, A=10000 configure -> reliquat=8000
// reparti sur B et C (non configures) -> B=4000, C=4000, total=18000 exact. Si
// la somme des valeurs explicites depasse le stock global, les valeurs
// explicites sont conservees telles quelles (jamais reduites silencieusement) et
// un WARN est journalise ; le reliquat est alors nul.
void initialiserStocksProduits() {
    synchroniserListeProduits();
    stockFiniParProduit.clear();
    int n = listeProduits.size();
    if (modeMultiProduitActif) {
        double stockGlobal = Math.max(0.0, champStockInitialProduitFini);
        double sommeExplicite = 0.0;
        int nbConfigures = 0;
        for (ScenarioFlux sc : listeProduits) {
            Double v = stockInitialParProduit != null ? stockInitialParProduit.get(cleProduit(sc.typeProduit)) : null;
            if (v != null && !Double.isNaN(v) && !Double.isInfinite(v)) {
                sommeExplicite += Math.max(0.0, v);
                nbConfigures++;
            }
        }
        int nbNonConfigures = n - nbConfigures;
        double reliquat = Math.max(0.0, stockGlobal - sommeExplicite);
        double allocationParDefaut = nbNonConfigures > 0 ? reliquat / (double) nbNonConfigures : 0.0;
        if (sommeExplicite > stockGlobal + 0.0001 && board != null) {
            board.logEvent(String.format(java.util.Locale.US,
                "[MULTI-PRODUIT][WARN] somme des stocks initiaux explicites (%.1f) depasse le stock global configure (%.1f) -- valeurs explicites conservees telles quelles, aucune reduction silencieuse ; produits non configures = 0 unite chacun.",
                sommeExplicite, stockGlobal));
        }
        for (ScenarioFlux sc : listeProduits) {
            stockFiniParProduit.put(cleProduit(sc.typeProduit), stockInitialConfigurePourProduit(sc, allocationParDefaut));
        }
    } else {
        for (ScenarioFlux sc : listeProduits) {
            stockFiniParProduit.put(cleProduit(sc.typeProduit), Math.max(0.0, champStockInitialProduitFini));
        }
    }
    lignesProduitParCommande.clear();
    synchroniserStockFiniAgrege(null);
}

ScenarioFlux choisirScenarioProduit(long numeroCommande) {
    synchroniserListeProduits();
    if (listeProduits.isEmpty()) return choisirScenarioPourCommande();

    // L'utilisateur garde la main : la sélection courante est prioritaire.
    ScenarioFlux selection = choisirScenarioPourCommande();
    if (selection != null && estProduitEnregistrable(selection)
            && catalogueProduits.containsKey(cleProduit(selection.typeProduit))) {
        if (!rotationProduitsActive || listeProduits.size() <= 1) return selection;
    }

    if (rotationProduitsActive && listeProduits.size() > 1) {
        int index = (int) Math.floorMod(numeroCommande - 1, listeProduits.size());
        return listeProduits.get(index);
    }
    return scenarioProduitParDefaut();
}

void enregistrerLigneProduitCommande(CommandeAgent cmd, ScenarioFlux sc, int qte) {
    if (cmd == null) return;
    String nom = sc != null && sc.typeProduit != null ? sc.typeProduit : cmd.idScenario;
    java.util.ArrayList<LigneCommandeProduit> lignes = new java.util.ArrayList<LigneCommandeProduit>();
    lignes.add(new LigneCommandeProduit(cleProduit(nom), nom, Math.max(1, qte)));
    lignesProduitParCommande.put(cmd.idCommande, lignes);
}

String codeProduitCommande(CommandeAgent cmd) {
    if (cmd == null) return nomProduitParDefaut;
    java.util.ArrayList<LigneCommandeProduit> lignes = lignesProduitParCommande.get(cmd.idCommande);
    if (lignes != null && !lignes.isEmpty()) return lignes.get(0).libelleProduit;
    return cmd.idScenario != null ? cmd.idScenario : nomProduitParDefaut;
}

// Bloc M.1 -- CORRECTIF D'ISOLATION. Version precedente : si la cle produit
// etait absente de stockFiniParProduit en mode multi-produit, la fonction
// retombait sur fallback.niveauStock -- le stock AGREGE de toutes les
// references confondues, permettant a un produit d'utiliser le stock d'un
// autre (violation directe de l'invariant "une reference ne consomme jamais le
// stock d'une autre"). Desormais : en multi-produit, une cle absente renvoie 0
// (rien de disponible pour cette reference), jamais l'agregat.
double stockFiniDisponiblePourScenario(ScenarioFlux sc, PosteGenericAgent fallback) {
    if (!modeMultiProduitActif) return fallback != null ? fallback.niveauStock : 0.0;
    synchroniserListeProduits();
    String cle = cleProduit(sc != null ? sc.typeProduit : nomProduitParDefaut);
    if (cle.isEmpty()) return 0.0;
    Double v = stockFiniParProduit.get(cle);
    return v != null ? Math.max(0.0, v.doubleValue()) : 0.0;
}

void consommerStockFiniProduit(ScenarioFlux sc, int qte, PosteGenericAgent fallback) {
    if (!modeMultiProduitActif) {
        if (fallback != null) fallback.niveauStock = Math.max(0, fallback.niveauStock - qte);
        return;
    }
    synchroniserListeProduits();
    String cle = cleProduit(sc != null ? sc.typeProduit : nomProduitParDefaut);
    double avant = stockFiniParProduit.containsKey(cle) ? stockFiniParProduit.get(cle) : 0.0;
    stockFiniParProduit.put(cle, Math.max(0.0, avant - Math.max(1, qte)));

    // Bloc M.2 -- resynchronise niveauStock (agregat de compatibilite) depuis
    // stockFiniParProduit (source de verite) juste apres la consommation. La
    // fonction elle-meme est un no-op tant que modeMultiProduitActif=false ; ici
    // on est deja dans la branche multi-produit, donc l'appel est actif.
    synchroniserStockFiniAgrege(fallback);
}

// Bloc M.2 -- credit de production par produit : le pendant de
// consommerStockFiniProduit() pour la reception au magasin produits finis.
// Portage de la reference technique DataCo (reference/dataco-multiproduct),
// avec UNE ADAPTATION explicite par rapport a cette reference : DataCo replie
// une identite vide/nulle sur nomProduitParDefaut ; ici, une identite vide,
// nulle ou non catalogee N'EST JAMAIS repliee sur un produit par defaut --
// seulement un WARN explicite, aucun transfert silencieux vers une autre
// reference (politique explicitement demandee pour ce bloc). Une cle
// correspondant a un produit reellement catalogue mais absente de
// stockFiniParProduit est initialisee proprement a 0 avant credit (via
// containsKey ci-dessous), jamais traitee comme une erreur.
void crediterStockFiniProduit(String typeProduit, double qte, PosteGenericAgent fallback) {
    double delta = Math.max(0.0, qte);
    if (delta <= 0.0) return;
    if (!modeMultiProduitActif) {
        if (fallback != null) fallback.niveauStock = Math.max(0.0, fallback.niveauStock) + delta;
        return;
    }
    synchroniserListeProduits();
    String cle = cleProduit(typeProduit);
    if (cle.isEmpty() || !catalogueProduits.containsKey(cle)) {
        if (board != null) board.logEvent("[MULTI-PRODUIT][WARN] credit stock ignore : produit inconnu='" + typeProduit + "'.");
        return;
    }
    double avant = stockFiniParProduit.containsKey(cle) ? Math.max(0.0, stockFiniParProduit.get(cle)) : 0.0;
    stockFiniParProduit.put(cle, avant + delta);
    synchroniserStockFiniAgrege(fallback);
}

int nombreProduitsRuntimeUniques() {
    java.util.HashSet<Produit> uniques = new java.util.HashSet<Produit>();
    if (produitRegistry != null) uniques.addAll(produitRegistry.values());
    return uniques.size();
}

// C14.24 -- taux de service reel : proportion des commandes closes livrees
// dans le delai promis (cmd.statut == "SERVIE"), au sens SCOR RL.1.1 Perfect
// Order Fulfillment simplifie (une seule dimension retenue : respect du delai
// promis ; les dimensions quantite/qualite ne sont pas trackees au niveau
// commande dans ce modele). A ne pas confondre avec le "Fill Rate" du tableau
// de bord, qui mesure le taux de conformite (non-rebut), une notion distincte.
double tauxServiceGlobal() {
    int servies = 0, enRetard = 0;
    for (CommandeAgent c : commandes) {
        if (!estCommandeClient(c)) continue;
        if ("SERVIE".equals(c.statut)) servies++;
        else if ("EN_RETARD".equals(c.statut)) enRetard++;
    }
    int closes = servies + enRetard;
    if (closes == 0) return Double.NaN;
    return 100.0 * servies / closes;
}

// C14.25 -- six indicateurs mentionnes dans le document de scenarios de
// validation, dont la donnee existait deja en interne mais n'etait exposee
// sur aucune carte du tableau de bord.

// 1. Nombre de commandes livrees en retard (parmi les commandes closes).
int commandesRetardeesCount() {
    int n = 0;
    for (CommandeAgent c : commandes) {
        if (estCommandeClient(c) && "EN_RETARD".equals(c.statut)) n++;
    }
    return n;
}

// 2. Nombre de commandes reellement satisfaites depuis le stock, sans
// production dediee. Fiable depuis la requalification MTS->MTO (C14.17) :
// nbMTS n'est plus incremente que pour les commandes veritablement servies
// par prelevement direct.
int commandesSansProductionCount() {
    return board != null ? board.nbMTS : 0;
}

// C14.26 -- Production Throughput ne doit pas continuer a varier une fois la
// production terminee : comme il s'agit d'un debit calcule depuis l'origine
// (nbTerminesProduction * 3600 / time()), il derivait mecaniquement vers 0 au
// fil du temps meme sans aucune activite, ce qui donnait l'impression trompeuse
// que "quelque chose" se passait encore. La carte affiche desormais 0 des lors
// qu'aucune unite n'est presente dans les postes Make de ZENER.
boolean makeActuellementActif() {
    if (postes == null) return false;
    for (PosteGenericAgent p : postes) {
        if (p == null || p.codeSCOR == null || p.idActeurResponsable == null) continue;
        if (!"ACT_4".equals(p.idActeurResponsable)) continue;
        if (!p.codeSCOR.startsWith("M1")) continue;
        try {
            if (p.queue.size() + p.delay.size() > 0) return true;
        } catch (Throwable ignored) {}
    }
    return false;
}

double throughputMakeAffiche() {
    if (!makeActuellementActif()) return 0.0;
    return time() > 0 ? nbTerminesProduction * 3600.0 / time() : 0.0;
}

// 3. Taux de rebut : symetrique du taux de conformite (Fill Rate) deja
// affiche, isole ici comme indicateur autonome.
double tauxRebutPct() {
    // C14.45 -- meme correction que Fill Rate : denominateur en unites, pas en commandes.
    if (board == null) return Double.NaN;
    long total = nbTerminesProduction + board.totalRebuts;
    if (total == 0) return Double.NaN;
    return 100.0 * board.totalRebuts / total;
}

// 4. Taux de reprise (rework) : part des unites ayant transite par un
// correcteur de type "reprise" (ex. sM1.3.5) parmi l'ensemble des unites
// traitees, rebutees ou reprises.
double tauxReprisePct() {
    // C14.45 -- meme correction. totalRework n'est PAS rajoute au denominateur :
    // une unite reprise qui aboutit est deja comptee une fois dans
    // nbTerminesProduction, l'ajouter en plus au denominateur sous-estimerait
    // le taux (double compte de la meme unite).
    if (board == null) return Double.NaN;
    long total = nbTerminesProduction + board.totalRebuts;
    if (total == 0) return Double.NaN;
    return 100.0 * board.totalRework / total;
}

// 5. Niveau de stock par matiere premiere, tel que suivi par le MRP
// (calculerBesoinsNets()). Absent du tableau de bord, qui n'affichait que
// le stock de produit fini.
String niveauStockMatiereText() {
    if (fichesMatiere == null || fichesMatiere.isEmpty()) return "Stock matière : —";
    StringBuilder sb = new StringBuilder();
    for (FicheMatiere f : fichesMatiere) {
        if (f == null) continue;
        if (sb.length() > 0) sb.append("\n");
        String abrege = f.idMatiere == null ? "?" : f.idMatiere.replace("_VRAC", "").replace("_KIT", "").replace("BOUTEILLE_VIDE_", "BOUT.");
        sb.append(abrege).append(" : ").append(String.format("%.0f", f.stockDisponible));
    }
    return sb.length() > 0 ? sb.toString() : "Stock matière : —";
}

// 5bis. Detail du stock matiere premiere, matiere par matiere, pour ne plus
// exposer que la somme brute heterogene (kg de GPL + unites de bouteilles +
// unites de kits additionnes sans conversion, cf. stockMatiereDisponibleTotal()).
// Format generique (nombre de matieres variable selon le scenario JSON) :
// "idMatiere=valeur|idMatiere=valeur|...". Separateur '|' choisi pour ne pas
// entrer en collision avec le ';' du format CSV francais utilise en aval.
// Portage generique du correctif collegue (reference/colleague,
// detailStockMatiereParMatiere). Consommee depuis le Bloc A.4 par
// capturerPointHistoriqueDashboard() ci-dessous (colonne "Raw Material Stock --
// detail par matiere" de la feuille Excel "Historique Dashboard").
String detailStockMatiereParMatiere() {
    if (fichesMatiere == null || fichesMatiere.isEmpty()) return "";
    StringBuilder sb = new StringBuilder();
    for (FicheMatiere f : fichesMatiere) {
        if (f == null || f.idMatiere == null) continue;
        if (sb.length() > 0) sb.append("|");
        sb.append(f.idMatiere).append("=").append(String.format(java.util.Locale.US, "%.2f", f.stockDisponible));
    }
    return sb.toString();
}

// Bloc M.2-TEST-FIX -- detail du stock produit fini, produit par produit, meme
// principe/format que detailStockMatiereParMatiere() ci-dessus
// ("idProduit=valeur|idProduit=valeur|..."), pour que la feuille "Historique
// Dashboard" cesse d'exposer uniquement l'agregat stockProduitFiniDisponibleTotal()
// en mode multi-produit (cf. bug M.2-TEST-FIX : un agregat correct pouvait
// masquer une repartition par produit incorrecte, ou inversement).
// Bloc M.2-TEST-FIX-2 -- STRICTEMENT READ-ONLY. La version precedente appelait
// synchroniserListeProduits(), qui RECONSTRUIT listeProduits/catalogueProduits
// -- donc pas une simple lecture, alors que cette fonction est appelee depuis
// une vue (carte live + export), potentiellement a chaque rafraichissement
// graphique. Desormais : lecture directe de stockFiniParProduit.keySet()
// (deja peuplee par initialiserStocksProduits()/consommerStockFiniProduit()/
// crediterStockFiniProduit() -- jamais ici), triee pour un ordre deterministe.
// Aucune ecriture, aucune reconstruction de structure runtime. Cle affichee =
// forme normalisee du catalogue (cleProduit(), deja la cle de la map -- voir
// son commentaire : trim + majuscules), identique au nom pour les identites
// deja en majuscules (ex. "PRODUIT_A"). Chaine vide en mono-produit, ou tant
// que modeMultiProduitActif=false, car stockFiniParProduit n'est alors pas la
// source de verite (voir initialiserStocksProduits()).
String detailStockFiniParProduit() {
    if (!modeMultiProduitActif || stockFiniParProduit == null || stockFiniParProduit.isEmpty()) return "";
    java.util.List<String> cles = new java.util.ArrayList<String>(stockFiniParProduit.keySet());
    java.util.Collections.sort(cles);
    StringBuilder sb = new StringBuilder();
    for (String cle : cles) {
        Double v = stockFiniParProduit.get(cle);
        if (sb.length() > 0) sb.append("|");
        sb.append(cle).append("=").append(String.format(java.util.Locale.US, "%.2f", v != null ? v.doubleValue() : 0.0));
    }
    return sb.toString();
}

// Bloc M.2-TEST-FIX -- texte d'affichage de la carte tableau de bord "Finished
// Stock" (vue live, pas l'export Excel -- voir detailStockFiniParProduit()
// ci-dessus pour l'equivalent Historique Dashboard). En mono-produit,
// comportement legacy strictement inchange (agregat seul, meme rendu qu'avant
// ce bloc). En multi-produit, ajoute la repartition par produit entre
// parentheses pour que la carte ne montre plus un agregat correct pouvant
// masquer une repartition par produit incorrecte (cf. bug M.2-TEST-FIX).
// Bloc M.2-TEST-FIX-2 -- lit directement stockFiniParProduit (meme cles
// triees que detailStockFiniParProduit()) plutot que de reformater sa sortie
// "cle=valeur|cle=valeur" puis de la re-splitter/re-parser : aucun aller-retour
// String inutile, aucun appel a synchroniserListeProduits() ni a aucune autre
// fonction d'ecriture. Strictement read-only.
String stockFiniAffichageText() {
    int total = (int) stockProduitFiniDisponibleTotal();
    if (!modeMultiProduitActif || stockFiniParProduit == null || stockFiniParProduit.isEmpty()) {
        return String.valueOf(total);
    }
    java.util.List<String> cles = new java.util.ArrayList<String>(stockFiniParProduit.keySet());
    java.util.Collections.sort(cles);
    StringBuilder sb = new StringBuilder();
    sb.append(total).append(" (");
    boolean first = true;
    for (String cle : cles) {
        Double v = stockFiniParProduit.get(cle);
        if (!first) sb.append(", ");
        sb.append(cle).append("=").append((int) Math.round(v != null ? v.doubleValue() : 0.0));
        first = false;
    }
    sb.append(")");
    return sb.toString();
}

// Bloc A.4 -- historique temporel du Dashboard (KPI + SCOR + PI), pour permettre
// de retracer dans Excel les courbes/diagrammes du tableau de bord au lieu d'un
// simple instantane final. Capture un point PAR APPEL (voir call sites : t=0 et
// arret dans demarrerSimulation()/arreterSimulation(), puis un point par cycle
// de l'evenement dedie DashboardHistoryManager -- DECOUPLE de l'ecriture Excel
// depuis A.4-FIX-2, cadence = champIntervalleExportExcel, explicite et
// inchangee). Purement observateur : ne lit que des champs/fonctions existants
// et n'ecrit que dans historiqueDashboard -- aucun impact sur commande/stock/
// routage/production/PI/strategie. Portage generique du correctif collegue
// (reference/colleague, capturerPointHistoriqueDashboard), avec 3 adaptations
// documentees :
//  - "Waiting Time (s)" utilise ici tempsAttenteGlobalCoherent() DU MASTER
//    (deja corrige, commentaire "VSM-FIX-05"), pas la version collegue qui
//    reconstruit differemment a partir de kpiZener/kpiGlobal.pce() ;
//  - "Delayed Orders (nb)" utilise ici commandesRetardeesCount() DU MASTER
//    (EN_RETARD + client uniquement) ; la version collegue compte aussi
//    cmd.retardConstate, champ du mecanisme de retard continu du Bloc C, absent
//    de ce master -- non introduit ici ;
//  - "Raw Material Stock (agrégat legacy, unités hétérogènes)" appelle
//    stockMatiereDisponibleTotal(), deja present dans le master (utilise par
//    valeurRuntimeMetriqueSCOR() pour AM.3.16/AM.2.8), plutot que de recalculer
//    une seconde boucle equivalente -- en-tete renomme (A.4-FIX-3) pour ne pas
//    presenter cette somme heterogene (kg + bouteilles + kits) comme une
//    quantite physique homogene ; formules SCOR AM inchangees (Bloc B).
// Les 2 colonnes de tracabilite du perimetre PI du collegue ("Attributs ponderes
// dans le PI", "Somme des poids effectifs") ne sont PAS portees : elles dependent
// de strategic.attributsPonderesPI/sommePoidsEffectifsPI, absents de ce master
// (Bloc B, non traite ici) -- RL/RS/AG/CO/AM/PI/PI cible utilisent les valeurs
// courantes de calculerPIGlobal() du master tel qu'il existe aujourd'hui, sans
// anticiper sa refonte.
// "Avg Lead Time (min)" et "Order Lead Time (min)" utilisent toutes deux
// board.kpiGlobal.avgLeadTime() / 60.0 (A.4-FIX-1 : avgLeadTime() est en
// SECONDES -- cf. KPIBundle.avgLeadTime() = avgCycleTime()+avgWaitTime(),
// alimentees via des champs *ReelSec -- la conversion /60 est deja correcte
// dans le code ; seul le tableau d'analyse de MERGE_PROGRESS.md manquait ce
// "/60.0" pour la 1re colonne, corrige sans impact sur le comportement).
void capturerPointHistoriqueDashboard() {
    // A.4-FIX-2 -- garde anti-doublon temporel : si ce temps de simulation a deja
    // ete capture (ex. DashboardHistoryManager et une cloture de commande au meme
    // instant, ou arreterSimulation() appele juste apres un cycle periodique),
    // ne pas ajouter une seconde ligne identique.
    if (Math.abs(time() - dernierTempsCaptureHistoriqueDashboard) < 0.0001) return;
    dernierTempsCaptureHistoriqueDashboard = time();

    double rl = 0, rs = 0, ag = 0, co = 0, am = 0, pi = 0, piCible = 0;
    if (strategic != null) {
        rl = (Double.isNaN(strategic.scoreRL) || Double.isInfinite(strategic.scoreRL)) ? 0.0 : strategic.scoreRL;
        rs = (Double.isNaN(strategic.scoreRS) || Double.isInfinite(strategic.scoreRS)) ? 0.0 : strategic.scoreRS;
        ag = (Double.isNaN(strategic.scoreAG) || Double.isInfinite(strategic.scoreAG)) ? 0.0 : strategic.scoreAG;
        co = (Double.isNaN(strategic.scoreCO) || Double.isInfinite(strategic.scoreCO)) ? 0.0 : strategic.scoreCO;
        am = (Double.isNaN(strategic.scoreAM) || Double.isInfinite(strategic.scoreAM)) ? 0.0 : strategic.scoreAM;
        pi = (Double.isNaN(strategic.piGlobalCourant) || Double.isInfinite(strategic.piGlobalCourant)) ? 0.0 : strategic.piGlobalCourant;
        piCible = (Double.isNaN(strategic.ciblePIGlobal) || Double.isInfinite(strategic.ciblePIGlobal)) ? 0.0 : strategic.ciblePIGlobal;
    }

    // Bloc M.2 -- deleguee a stockProduitFiniDisponibleTotal() (deja corrigee pour
    // ne jamais additionner N fois le meme total en mode multi-produit, voir
    // son commentaire) plutot que de dupliquer ici la meme boucle sur les postes.
    double stockFini = stockProduitFiniDisponibleTotal();

    historiqueDashboard.add(new Object[] {
        fmt1(time()),
        fmt1(time() > 0 ? nbTermines * 3600.0 / time() : 0.0),
        fmt1(board.kpiGlobal.avgLeadTime() / 60.0),
        wipReelSansJetonsVisuels(),
        (int) stockFini,
        detailStockFiniParProduit(),
        fmt1((board.kpiZener != null ? board.kpiZener : board.kpiGlobal).pce() * 100),
        fmt1(tempsAttenteGlobalCoherent()),
        board.nbMTS,
        board.nbMTO,
        commandesRetardeesCount(),
        fmt1(tauxRemplissagePct()),
        fmt1(tauxRebutPct()),
        fmt1(tauxReprisePct()),
        fmt1(calculerTaktTimeSec()),
        fmt1(throughputMakeAffiche()),
        fmt1(board.kpiGlobal.avgLeadTime() / 60.0),
        fmt1(stockMatiereDisponibleTotal()),
        detailStockMatiereParMatiere(),
        fmt1(delaiFournisseurMoyenHeures()),
        fmt3(rl), fmt3(rs), fmt3(ag), fmt3(co), fmt3(am),
        fmt3(pi), fmt3(piCible)
    });
}

// A.4-FIX-4 -- FINALISATION DE RUN, IDEMPOTENTE.
// Contexte : le run precedent a montre que arreterSimulation() ne suffisait pas a
// garantir un export final synchronise, car son seul point d'entree UI
// ("Arreter et voir resultats", ActionCode=arreterSimulation()) etait desactive
// (<Enabled>false</Enabled>), rendant la fonction inaccessible. Un run se
// terminait alors uniquement par le bouton natif Stop/Terminate du moteur
// AnyLogic -- qui ne declenche aucun code du modele (verifie : aucun bloc
// "on destroy"/"on finish" n'existe dans ce fichier, ni sur la classe Main, ni
// sur le SimulationExperiment -- seul StartupCode existe). Consequence
// observee : DashboardHistoryManager continuait de capturer en memoire (gate =
// modeExecution seul, cf. A.4-FIX-2), mais plus aucune ecriture Excel/ABox ne
// se declenchait apres la derniere cloture de commande (qui desactive
// definitivement ExcelExportManager via c14SnapshotFinalEffectue) : historique
// Dashboard/Excel/ABox figes a t=628 alors que la simulation avait continue
// jusqu'a t=1489 (CMD_4 a CMD_7 crees/traites, visibles uniquement dans un CSV
// exporte manuellement entretemps via un bouton totalement independant,
// CoordinatorAgent.exporterCSV()).
// Correctif retenu (le moins invasif des options evaluees) : regrouper ici la
// capture finale + les exports de cloture dans une fonction UNIQUE et
// IDEMPOTENTE, appelee par arreterSimulation() (dont le bouton UI est
// desormais reactive -- <Enabled>true</Enabled> -- ce qui est la correction
// principale : sans un point d'entree UI reellement accessible, aucune
// finalisation cote modele n'est possible). Elle ne modifie ni les
// snapshots de preuve sur cloture de commande (C14, inchanges, conserves) ni
// c14SnapshotFinalEffectue.
// LIMITE CONNUE ET ASSUMEE : cette fonction n'est PAS invoquee si l'utilisateur
// utilise le bouton natif Stop/Terminate d'AnyLogic au lieu du bouton
// "Arreter et voir resultats" du modele -- aucun hook de cycle de vie n'existe
// dans ce schema pour intercepter cet arret natif, et il serait risque
// d'improviser une solution de bas niveau (API moteur) sans validation reelle
// dans AnyLogic. Recommandation utilisateur : toujours cliquer
// "Arreter et voir resultats" pour obtenir un export final synchronise.
// A.4-FIX-5 -- LOGGING EXPLICITE (les catch silencieux ne suffisent pas pour une
// fonction de finalisation scientifique) : chaque etape journalise son resultat
// via board.logEvent(), y compris les cas de SKIP volontaire (configuration) et
// les erreurs (non destructives, mais visibles, prefixees [FINALIZE-ERROR]).
// A.4-FIX-5 -- IDEMPOTENCE : runFinalise est positionne a true AVANT les exports
// (pas apres), volontairement -- strategie simple retenue plutot que 3 drapeaux
// distincts (dashboard/abox/excel), pour ne pas complexifier au-dela du besoin.
// Consequence assumee : si un export echoue (exception), un second appel ne le
// retentera PAS (idempotence prioritaire sur la reprise automatique) -- l'echec
// reste neanmoins visible via [FINALIZE-ERROR] dans le journal des evenements.
// A.4-FIX-5A -- ABox finale : gardee derriere aboxExportActif && aboxExportSurArret,
// EXACTEMENT comme le code original d'arreterSimulation() avant tout portage --
// semantique NON modifiee (aboxExportSurArret est un reglage scenario existant,
// "exportOnStop" dans le JSON, defaut=false). Cause identifiee du "TTL RUN_FINALIZED
// absent" observe sur le run precedent : aboxExportSurArret valait false pour ce
// scenario, donc l'export etait deja correctement ignore -- pas un bug, mais un
// SKIP totalement silencieux jusqu'ici. Desormais journalise explicitement en
// [FINALIZE] ... SKIP, pour que ce ne soit plus une absence inexpliquee. Pour
// obtenir systematiquement un TTL final synchronise avec l'Excel final, activer
// "exportOnStop": true dans le scenario JSON (ou champ correspondant si expose en
// UI) -- decision laissee a l'utilisateur, cette semantique existante n'a pas ete
// modifiee ici.
void finaliserRunEtExporter() {
    if (runFinalise) return;   // idempotence : deja finalise pour ce run
    runFinalise = true;

    try {
        capturerPointHistoriqueDashboard();
        if (board != null) board.logEvent(String.format(java.util.Locale.US,
            "[FINALIZE] Dashboard final capture t=%.1f", time()));
    } catch (Throwable exDash) {
        if (board != null) board.logEvent("[FINALIZE-ERROR] Dashboard : " + exDash.getMessage());
    }

    if (aboxExportActif && aboxExportSurArret) {
        try {
            String fichierAbox = exporterABoxRuntimeTTL("RUN_FINALIZED");
            if (board != null) board.logEvent(String.format(java.util.Locale.US,
                "[FINALIZE] ABox finale exportee %s | t=%.1f", fichierAbox, time()));
        } catch (Throwable exAbox) {
            if (board != null) board.logEvent("[FINALIZE-ERROR] ABox : " + exAbox.getMessage());
        }
    } else if (board != null) {
        board.logEvent("[FINALIZE] ABox finale SKIP : aboxExportActif=" + aboxExportActif
            + " ; aboxExportSurArret=" + aboxExportSurArret
            + " (reglage scenario \"exportOnStop\", non modifie par ce correctif)");
    }

    if (exportExcelActif) {
        try {
            exporterToutesLesTablesExcel();
            if (board != null) board.logEvent(String.format(java.util.Locale.US,
                "[FINALIZE] Excel final exporte t=%.1f", time()));
        } catch (Throwable exExcel) {
            if (board != null) board.logEvent("[FINALIZE-ERROR] Excel : " + exExcel.getMessage());
        }
    } else if (board != null) {
        board.logEvent("[FINALIZE] Excel final SKIP : exportExcelActif=false");
    }
}

// Bloc A.4 -- en-tetes de la feuille Excel "Historique Dashboard", dans le meme
// ordre que capturerPointHistoriqueDashboard() ci-dessus (27 colonnes = 27 valeurs
// par ligne depuis l'ajout M.2-TEST-FIX de "Finished Stock -- detail par produit").
