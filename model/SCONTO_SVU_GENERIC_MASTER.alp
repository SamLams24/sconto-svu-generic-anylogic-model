				<Event>
					<Id>1791000009410</Id>
					<Name><![CDATA[DashboardHistoryManager]]></Name>
					<X>-200</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[champIntervalleExportExcel]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1791000009411</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1783584000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[champIntervalleExportExcel]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[modeExecution]]></Condition>
					</Properties>
					<Action><![CDATA[// A.4-FIX-2 -- capture de l'historique Dashboard DECOUPLEE de l'ecriture
// physique du classeur Excel (ExcelExportManager). Avant ce correctif, la
// capture etait declenchee depuis ExcelExportManager, dont la condition
// inclut !c14SnapshotFinalEffectue -- or ce drapeau passe a true des la
// PREMIERE cloture de commande (avec export ABox sur cloture actif), ce qui
// arretait aussi la capture pour le reste du run, bien avant sa fin reelle
// (observe : capture arretee a t=60s sur un run allant jusqu'a t=582s).
// Cet evenement dedie tourne pendant toute la duree de modeExecution, a la
// meme cadence generique que l'export Excel (champIntervalleExportExcel),
// mais independamment du fait que le classeur soit physiquement reecrit a ce
// cycle precis : c'est la prochaine ecriture reelle (cycle periodique tant
// qu'actif, cloture de commande, ou arret manuel -- voir arreterSimulation())
// qui exportera l'integralite de l'historique accumule en memoire.
// capturerPointHistoriqueDashboard() protege elle-meme contre les doublons de
// timestamp (voir son corps), donc aucun risque de double capture au meme
// instant si ce cycle et une cloture de commande coincident.
capturerPointHistoriqueDashboard();]]></Action>
				</Event>
