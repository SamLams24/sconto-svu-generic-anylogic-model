				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782072628164</Id>
					<Name><![CDATA[rafraichirComboScenarios]]></Name>
					<X>2700</X><Y>-860</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String[] items = new String[scenarios.size()];
for (int i = 0; i < scenarios.size(); i++) {
    ScenarioFlux sc = scenarios.get(i);
    items[i] = (i+1) + ": " + sc.typeProduit + " (" + sc.debitParHeure + "/h, "
        + sc.sequence.size() + " etapes)";
}
comboScenarios.setItems(items);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782072628165</Id>
					<Name><![CDATA[gammeScenarioText]]></Name>
					<X>2700</X><Y>-845</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Construit un rapport lisible de la gamme (sequence) d'un ou plusieurs
// scenarios : ordre des micro-activites, code SCOR, acteur responsable.
// Si un scenario est selectionne dans comboScenarios -> uniquement lui.
// Sinon -> toutes les gammes configurees, a la suite.
int[] w = {4, 14, 22, 10, 18, 14};
StringBuilder sb = new StringBuilder();

java.util.ArrayList<ScenarioFlux> aAfficher = new java.util.ArrayList<ScenarioFlux>();
if (champScenarioSelectionne != null && !champScenarioSelectionne.isEmpty()) {
    try {
        int idx = Integer.parseInt(champScenarioSelectionne.split(":")[0].trim()) - 1;
        if (idx >= 0 && idx < scenarios.size()) aAfficher.add(scenarios.get(idx));
    } catch (Exception ex) { /* selection invalide -> on retombe sur "toutes" */ }
}
if (aAfficher.isEmpty()) aAfficher.addAll(scenarios);

if (aAfficher.isEmpty()) {
    return "Aucun scenario configure. Ajoutez d'abord une gamme dans l'onglet Configuration.";
}

for (ScenarioFlux sc : aAfficher) {
    sb.append(tableTitle(
        "GAMME — " + sc.typeProduit + "  (" + fmt1(sc.debitParHeure) + " /h, "
            + sc.sequence.size() + " etape(s))",
        w
    ));
    sb.append(tableRow(new String[]{
        "#", "ID Poste", "Nom micro-activite", "SCOR", "Acteur responsable", "Categorie"
    }, w)).append("\n");
    sb.append(tableLine(w)).append("\n");

    if (sc.sequence.isEmpty()) {
        sb.append(tableRow(new String[]{"-", "-", "(sequence vide)", "-", "-", "-"}, w)).append("\n");
    } else {
        for (int i = 0; i < sc.sequence.size(); i++) {
            String idP = sc.sequence.get(i);
            PosteGenericAgent p = trouverPosteParNomOuId(idP);
            String nom       = (p != null) ? p.nom : "(introuvable)";
            String scor      = (p != null) ? p.codeSCOR : "-";
            String acteurNom = (p != null && p.nomActeurResponsable != null && !p.nomActeurResponsable.isEmpty())
                ? p.nomActeurResponsable : "-";
            String acteurCat = (p != null && p.categorieActeurResponsable != null)
                ? p.categorieActeurResponsable : "-";

            sb.append(tableRow(new String[]{
                String.valueOf(i + 1), idP, nom, scor, acteurNom, acteurCat
            }, w)).append("\n");
        }
    }

    sb.append(tableLine(w)).append("\n\n");
}

return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782072655498</Id>
					<Name><![CDATA[supprimerScenarioUI]]></Name>
					<X>2700</X><Y>-830</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (champScenarioSelectionne == null || champScenarioSelectionne.isEmpty()) {
    messageStatut = "ERREUR : selectionnez un scenario dans la liste.";
    return;
}
try {
    int idx = Integer.parseInt(champScenarioSelectionne.split(":")[0].trim()) - 1;
    if (idx >= 0 && idx < scenarios.size()) {
        String nom = scenarios.get(idx).typeProduit;
        scenarios.remove(idx);
        synchroniserListeProduits();
        messageStatut = "Scenario #" + (idx+1) + " ('" + nom + "') supprime. Restant : " + scenarios.size();
        rafraichirComboScenarios();
    } else {
        messageStatut = "ERREUR : index de scenario invalide.";
    }
} catch (Exception ex) {
    messageStatut = "ERREUR : selection de scenario invalide.";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782072911091</Id>
					<Name><![CDATA[supprimerPoste]]></Name>
					<X>-570</X><Y>350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[  if (modeExecution) {
        messageStatut = "ERREUR : impossible de supprimer un poste pendant la simulation.";
        return;
    }

    if (idPoste == null || idPoste.trim().isEmpty()) {
        messageStatut = "ERREUR : aucun poste selectionne.";
        return;
    }

    PosteGenericAgent cible = trouverPoste(idPoste);

    if (cible == null) {
        messageStatut = "ERREUR : poste '" + idPoste + "' introuvable.";
        return;
    }

    // Retirer le poste des scénarios
    for (ScenarioFlux sc : scenarios) {
        sc.sequence.remove(idPoste);
    }

    // Supprimer les OperationalAgent liés (ou les detacher proprement s'ils
    // portent aussi d'autres postes du meme groupe (acteur, SCOR N3))
    for (int i = opAgents.size() - 1; i >= 0; i--) {
        OperationalAgent op = opAgents.get(i);

        boolean lieParIdPoste = idPoste.equals(op.idPoste);
        boolean lieParAgentLogique =
            op.idAgentLogique != null
            && op.idAgentLogique.contains(idPoste);
        boolean lieParPostesLies = false;
        PosteGenericAgent postePourLien = null;
        for (PosteGenericAgent pp : op.postesLies) {
            if (pp != null && idPoste.equals(pp.idPoste)) { lieParPostesLies = true; postePourLien = pp; break; }
        }

        if (lieParPostesLies && op.postesLies.size() > 1) {
            // Le groupe survit (d'autres postes du meme (acteur,N3) restent actifs) :
            // on retire seulement le poste supprime de la liste, sans detruire l'OA.
            op.postesLies.remove(postePourLien);
            if (idPoste.equals(op.idPoste) && !op.postesLies.isEmpty()) {
                op.idPoste = op.postesLies.get(0).idPoste;
            }
        } else if (lieParIdPoste || lieParAgentLogique || lieParPostesLies) {
            remove_opAgents(op);
        }
    }

    // Supprimer les responsabilités liées
    for (int i = responsabilitesMicro.size() - 1; i >= 0; i--) {
        MicroResponsabilite r = responsabilitesMicro.get(i);

        if (idPoste.equals(r.idMicroActivite)) {
            responsabilitesMicro.remove(i);
        }
    }

    // Supprimer les machines liées
    for (int i = machinesSim.size() - 1; i >= 0; i--) {
        MachineSim m = machinesSim.get(i);

        if (idPoste.equals(m.idMicroActivite)) {
            machinesSim.remove(i);
        }
    }

    // Retirer le poste des acteurs
    for (ActeurSC a : acteursSC) {
        a.retirerMicroActivite(idPoste);
    }

    remove_postes(cible);

    board.logEvent("[CONFIG] Poste " + idPoste + " supprime.");

    messageStatut =
        "Poste '" + idPoste + "' supprime. Restant : " + postes.size();

    refreshActeursMicroComboBox();
    refreshMicroActiviteComboBox();
    rafraichirComboPostes();
    rafraichirComboScenarios();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782072964937</Id>
					<Name><![CDATA[modifierPoste]]></Name>
					<X>-570</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idPoste]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[ if (modeExecution) {
        messageStatut = "ERREUR : impossible de modifier un poste pendant la simulation.";
        return;
    }

    if (idPoste == null || idPoste.trim().isEmpty()) {
        messageStatut = "ERREUR : aucun poste selectionne.";
        return;
    }

    PosteGenericAgent p = trouverPoste(idPoste);

    if (p == null) {
        messageStatut = "ERREUR : poste '" + idPoste + "' introuvable.";
        return;
    }

    // Modifier les champs opérationnels
    p.nom = champNom;

    String selectionSCOR = champCodeSCOR != null ? champCodeSCOR.trim() : "";
    String codeSCORExtrait = selectionSCOR;

    if (selectionSCOR.contains(" —")) {
        codeSCORExtrait = selectionSCOR.split(" —")[0].trim();
    } else if (selectionSCOR.contains(" — ")) {
        codeSCORExtrait = selectionSCOR.split(" — ")[0].trim();
    }

    if (!codeSCORExtrait.isEmpty()) {
        p.codeSCOR = codeSCORExtrait;
    }

    try {
        p.typePoste = TypePoste.valueOf(champTypePoste.trim().toUpperCase());
    } catch (Exception ex) {
        messageStatut = "ERREUR : type de poste invalide.";
        return;
    }

    p.loiTemps = new LoiTemps(champLoiDist, champP1, champP2);
    p.capaciteSimultanee = champCapacite;
    p.tauxVA = Math.max(0.0, Math.min(1.0, champTauxVA));
    p.coutHoraireMainOeuvre = Math.max(0.0, champCoutHoraireMainOeuvre);
    p.coutMatierePremiereParUnite = Math.max(0.0, champCoutMatierePremiereParUnite);
    p.valeurActifFixe = Math.max(0.0, champValeurActifFixe);

    p.genereAutonome = champGenereAutonome;
    p.politiqueApproPoste = (champPolitiqueApproPoste != null) ? champPolitiqueApproPoste.trim() : "";
    p.intervalleApproPoste = Math.max(0.0, champIntervalleApproPoste);
    p.tauxArriveePoissonPoste = Math.max(0.0, champTauxArriveePoissonPoste);
    p.quantiteParApproPoste = Math.max(1.0, champQuantiteParApproPoste);
    p.tailleLot = Math.max(1, (int) Math.round(champTailleLot));

    p.attendTousLesPredecesseurs = champAttendTousLesPredecesseurs;
    if (p.attendTousLesPredecesseurs) {
        int nbParents = 1;
        if (p.chainesPrecedents != null && !p.chainesPrecedents.trim().isEmpty()) {
            nbParents = Math.max(1, p.chainesPrecedents.split(",").length);
        }
        p.tailleLot = nbParents;
    }

    // Modifier l’acteur responsable uniquement si un nouvel acteur est sélectionné
    String idActeurSelectionne = extraireIdActeurDepuisCombo(champActeurLieMicro);
    ActeurSC nouvelActeur = trouverActeurParId(idActeurSelectionne);

    if (nouvelActeur != null && !nouvelActeur.idActeur.equals(p.idActeurResponsable)) {
        ActeurSC ancienActeur = trouverActeurParId(p.idActeurResponsable);

        if (ancienActeur != null) {
            ancienActeur.retirerMicroActivite(p.idPoste);
        }

        p.idActeurResponsable = nouvelActeur.idActeur;
        p.nomActeurResponsable = nouvelActeur.nom;
        p.categorieActeurResponsable = nouvelActeur.categorie;
        p.typeAnnexeActeurResponsable = nouvelActeur.typeAnnexe;

        nouvelActeur.ajouterMicroActivite(p.idPoste);

        // Mettre à jour les responsabilités opérationnelles automatiques liées à ce poste
        for (MicroResponsabilite r : responsabilitesMicro) {
            if (p.idPoste.equals(r.idMicroActivite)
                && NIVEAU_OPERATIONAL.equals(r.niveauHierarchique)
                && r.idResponsabilite != null
                && r.idResponsabilite.startsWith("RESP_")) {

                r.idActeur = nouvelActeur.idActeur;
                r.nomActeur = nouvelActeur.nom;
                r.categorieActeur = nouvelActeur.categorie;
                r.typeAnnexeActeur = nouvelActeur.typeAnnexe;
            }
        }
    }

    board.logEvent(
        "[CONFIG] Poste " + idPoste
        + " modifie -> " + p.nom
        + " [" + p.codeSCOR + "]"
    );

    messageStatut = "Poste '" + idPoste + "' modifie.";

    refreshActeursMicroComboBox();
    refreshMicroActiviteComboBox();
    rafraichirComboPostes();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782073336223</Id>
					<Name><![CDATA[macroPrefixe]]></Name>
					<X>-571</X><Y>434</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[codeSCOR]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (codeSCOR == null || codeSCOR.isEmpty()) return "??";
String c = codeSCOR.trim();
// Tolere le prefixe officiel "s" optionnel (retro-compatibilite anciennes configs)
if (c.length() >= 2 && c.charAt(0) == 's' && Character.isUpperCase(c.charAt(1))) {
    c = c.substring(1);
}
String cu = c.toUpperCase();
if (cu.startsWith("SR")) return "sR";
if (!cu.isEmpty()) {
    switch (cu.charAt(0)) {
        case 'P': return "sP";
        case 'S': return "sS";
        case 'M': return "sM";
        case 'D': return "sD";
    }
}
return "??";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1790000000700</Id>
					<Name><![CDATA[libelleMacroProcessusSCOR]]></Name>
					<X>-571</X><Y>454</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[prefixe]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Traduit un prefixe macro SCOR (sortie de macroPrefixe()) en libelle complet
// lisible. Utilise pour affichage uniquement -- ne change aucune logique de calcul.
if (prefixe == null) return "**";
switch (prefixe) {
    case "sP": return "PLAN";
    case "sS": return "SOURCE — réception matière/fournisseur + réception client";
    case "sM": return "MAKE";
    case "sD": return "DELIVER";
    case "sR": return "RETURN";
    default:   return "Inconnu";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1782073336225</Id>
					<Name><![CDATA[couleurStrategic]]></Name>
					<X>-571</X><Y>414</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Vert = facteur proche de 1.0 (regime stable). Orange = ajustement actif. Rouge = plancher 0.5 atteint (sature).
if (strategic == null) return new java.awt.Color(0x95A5A6);
double f = strategic.facteurAjustement;
if (f <= 0.55) return new java.awt.Color(0xC0392B);
if (f < 0.95 || f > 1.05) return new java.awt.Color(0xE67E22);
return new java.awt.Color(0x27AE60);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1782073336227</Id>
					<Name><![CDATA[couleurTactical]]></Name>
					<X>-571</X><Y>394</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[macro]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Vert = WT macro sous surveillance. Orange = surveillance active. Rouge = escalade (attente > seuil).
if (board == null) return new java.awt.Color(0x95A5A6);
TacticalAgent ta = null;
for (TacticalAgent t : tacticals) {
    if (macro.equals(t.idMacroProcessus)) { ta = t; break; }
}
if (ta == null) return new java.awt.Color(0x95A5A6);
KPIBundle k = board.kpiParMacro.get(macro);
double wt = (k != null) ? k.avgWaitTime() : 0;
if (wt > ta.seuilEscalade) return new java.awt.Color(0xC0392B);
if (wt > ta.seuilEscalade * 0.5) return new java.awt.Color(0xE67E22);
return new java.awt.Color(0x27AE60);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1782073742875</Id>
					<Name><![CDATA[couleurSupervisor]]></Name>
					<X>-570</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Vert = PI >= cible. Orange = PI >= 85% de la cible. Rouge = PI sous 85% de la cible.
if (supervisor == null) return new java.awt.Color(0x95A5A6);
double pi = strategic.piGlobalCourant;
double cible = strategic.ciblePIGlobal;
if (pi >= cible) return new java.awt.Color(0x27AE60);
if (pi >= cible * 0.85) return new java.awt.Color(0xE67E22);
return new java.awt.Color(0xC0392B);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791000002198</Id>
					<Name><![CDATA[etatCoordinateurMacro]]></Name>
					<X>-571</X><Y>510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[macro]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Bloc A.5 -- SOURCE UNIQUE DE VERITE pour l'etat d'un CoordinatorAgent,
// partagee par la couleur du pave (couleurSupervisorMacro) ET le popup
// (popupSupervisor). Avant ce correctif, la couleur du pave etait deja
// calculee ici EN DIRECT (temps reel), mais le popup lisait un champ separe,
// sv.etatAgent, qui n'etait ecrit QUE par traiterAlertesTactiques() -- une
// fonction qui retourne immediatement des sa 1ere ligne des lors que
// realignementFluxHierarchiqueActif=true (le routage "generation 2", actif
// par defaut dans ce master). sv.etatAgent restait donc fige a vie sur sa
// valeur d'initialisation ("IDLE" -> "Inactif / en attente"), quel que soit
// l'etat reel affiche par la couleur du pave : un Coordinateur visible en
// ROUGE pouvait donc afficher un popup "Inactif / en attente". Desormais
// popupSupervisor() appelle cette meme fonction, garantissant que le texte
// affiche correspond TOUJOURS a la couleur du pave. Portage generique du
// correctif collegue (reference/colleague, etatCoordinateurMacro, C14.55) --
// logique de detection GOULOT/ESCALADE strictement identique a celle deja
// utilisee par couleurSupervisorMacro() du master (aucune nouvelle
// definition de goulot introduite).
CoordinatorAgent sv = null;
for (CoordinatorAgent s : supervisorsMacro) {
    if (macro.equals(s.idMacroProcessus)) { sv = s; break; }
}
if (sv == null) return null;

int goulots = 0;
int actifs = 0;
// C14.27 -- wtMacro mesure desormais l'attente REELLE la plus longue, a
// l'instant present, parmi les postes de ce macro-processus -- et non plus
// une moyenne cumulee depuis le debut du run (meme correction que pour
// l'etat GOULOT des OperationalAgent, dont ce calcul depend logiquement).
double wtMacro = 0;
for (OperationalAgent op : opAgents) {
    String n3 = (op.codeSCOR != null && op.codeSCOR.contains("|"))
        ? op.codeSCOR.substring(op.codeSCOR.indexOf('|') + 1) : op.codeSCOR;
    if (n3 == null || !macroPrefixe(n3).equals(macro)) continue;
    actifs++;
    if ("GOULOT".equals(op.etatHolon)) goulots++;
    if (op.postesLies != null) {
        for (PosteGenericAgent p : op.postesLies) {
            // C14.51 -- acces indexe, coherent avec analyserEtat().
            if (p == null) continue;
            int nq = p.queue.size();
            for (int qi = 0; qi < nq; qi++) {
                try {
                    FluxEntity e = p.queue.get(qi);
                    if (e != null && !estFluxVisuelSeulement(e)) {
                        wtMacro = Math.max(wtMacro, time() - e.tDebutAttente);
                        break;
                    }
                } catch (Throwable ignored) {}
            }
        }
    }
}

String etat;
if (actifs == 0) {
    etat = null; // aucun OP dans ce macro : pas d'etat pertinent (gris)
} else {
    // Cohérence avec le TacticalAgent du meme macro : escalade si un OP est en
    // GOULOT OU si le temps d'attente actuel du macro depasse le seuil
    // d'escalade tactique.
    boolean wtDepasse = false;
    double seuil = 10.0;
    for (TacticalAgent t : tacticals) {
        if (macro.equals(t.idMacroProcessus)) { seuil = t.seuilEscalade; break; }
    }
    wtDepasse = (wtMacro > seuil);

    if (goulots > 0 || wtDepasse) {
        etat = "ESCALADE";
    } else if (sv.dernierReeq > 0 && time() - sv.dernierReeq < 120) {
        etat = "AJUSTEMENT";
    } else {
        etat = "SURVEILLANCE";
    }
}

if (etat != null && !etat.equals(sv.etatAgent)) { sv.etatAgent = etat; sv.tEntreeEtat = time(); }
return etat;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1791000002201</Id>
					<Name><![CDATA[couleurSupervisorMacro]]></Name>
					<X>-571</X><Y>540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[macro]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Bloc A.5 -- couleur derivee de etatCoordinateurMacro() (source de verite
// unique, partagee avec popupSupervisor() -- voir C14.55 / etatCoordinateurMacro).
String etat = etatCoordinateurMacro(macro);
if (etat == null) return new java.awt.Color(0x95A5A6);              // gris : coordinateur absent ou aucun OP dans ce macro
if ("ESCALADE".equals(etat))   return new java.awt.Color(0xC0392B); // rouge
if ("AJUSTEMENT".equals(etat)) return new java.awt.Color(0xE67E22); // orange
return new java.awt.Color(0x27AE60);                                // vert : nominal]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1782073742877</Id>
					<Name><![CDATA[couleurOperational]]></Name>
					<X>-570</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idx]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// C14.39 -- liaison stable via opAgentsTries(), voir sa definition.
java.util.ArrayList<OperationalAgent> listeAffichage = opAgentsTries();
if (idx < 0 || idx >= listeAffichage.size()) return new java.awt.Color(0xD3D1C7);
String e = listeAffichage.get(idx).etatHolon;
if (e == null) return new java.awt.Color(0xD3D1C7);
switch (e) {
    case "PANNE":           return new java.awt.Color(0x6C3483); // violet fonce : panne machine
    case "GOULOT":
    case "SURCHARGE":      return new java.awt.Color(0xC0392B);
    case "PRIORITAIRE":    return new java.awt.Color(0xE67E22);
    case "WORKING":
    case "ACTIF":
    case "NORMAL":         return new java.awt.Color(0x27AE60);
    case "IDLE":
    case "EN_PAUSE":       return new java.awt.Color(0xB4B2A9);
    default:               return new java.awt.Color(0xB4B2A9);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1791000005101</Id>
					<Name><![CDATA[bordureOperational]]></Name>
					<X>-570</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idx]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// Bordure de la pastille = CATEGORIE (Pilotage/Execution), independante de la
// couleur de remplissage qui reste l'ETAT. Bleu = Pilotage, gris fonce = Execution.
// C14.39 -- liaison stable via opAgentsTries().
java.util.ArrayList<OperationalAgent> listeAffichage = opAgentsTries();
if (idx < 0 || idx >= listeAffichage.size()) return new java.awt.Color(0x000000);
String cat = listeAffichage.get(idx).categorieOP;
if ("PILOTAGE".equals(cat)) return new java.awt.Color(0x2980B9);
return new java.awt.Color(0x2C3E50);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1782073742879</Id>
					<Name><![CDATA[visibleOperational]]></Name>
					<X>-570</X><Y>480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idx]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[return idx >= 0 && idx < opAgentsTries().size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782073742881</Id>
					<Name><![CDATA[texteOperational]]></Name>
					<X>-570</X><Y>460</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idx]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// C14.39 -- liaison stable via opAgentsTries().
java.util.ArrayList<OperationalAgent> listeAffichage = opAgentsTries();
if (idx < 0 || idx >= listeAffichage.size()) return "";
OperationalAgent opRef = listeAffichage.get(idx);
String lib = opRef.libelleAffichage;
if (lib == null || lib.isEmpty()) return "?";
// Version compacte pour la pastille (espace tres reduit) : "[ZEN] M1.3" -> "ZEN:M1.3"
// Prefixe (P) ou (E) : categorie Pilotage / Execution de la micro-activite.
String lettre = "PILOTAGE".equals(opRef.categorieOP) ? "P" : "E";
return "(" + lettre + ") " + lib.replace("[", "").replace("] ", ":");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000002101</Id>
					<Name><![CDATA[popupOperationalAgent]]></Name>
					<X>-570</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idx]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// C14.39 -- liaison stable via opAgentsTries().
java.util.ArrayList<OperationalAgent> listeAffichage = opAgentsTries();
if (idx < 0 || idx >= listeAffichage.size()) return;
OperationalAgent op = listeAffichage.get(idx);
StringBuilder sb = new StringBuilder();
sb.append("════════════════════════════════════\n");
sb.append("  AGENT OPÉRATIONNEL : ").append(op.libelleAffichage).append("\n");
sb.append("════════════════════════════════════\n\n");
sb.append("▸ Acteur responsable : ").append(op.nomActeurSC != null && !op.nomActeurSC.isEmpty() ? op.nomActeurSC : "—").append("\n");
sb.append("▸ Catégorie          : ").append("PILOTAGE".equals(op.categorieOP) ? "Pilotage (planification/ordonnancement/autorisation)" : "Exécution (action physique sur le flux)").append("\n");
sb.append("▸ État courant       : ").append(etatLisible(op.etatHolon)).append("\n");
sb.append("▸ Depuis             : ").append(String.format("%.0f s", time() - op.tEntreeEtatCourant)).append("\n\n");
sb.append("── Micro-activités regroupées sous cet agent ──\n");
if (op.postesLies == null || op.postesLies.isEmpty()) {
    sb.append("  (aucune)\n");
} else {
    for (PosteGenericAgent p : op.postesLies) {
        // Bloc A.5 -- p.goulot est un flag DE GROUPE, ecrit par analyserEtat()
        // identiquement sur TOUS les postes du groupe des que l'un d'eux
        // (ou leur somme) declenche GOULOT : il ne reflete jamais l'etat reel
        // du poste INDIVIDUEL affiche ici, d'ou des micro-activites marquees
        // "GOULOT" alors qu'elles n'ont encore traite aucune unite. On
        // recalcule ici un etat PROPRE A CE POSTE, sur les memes bases que
        // analyserEtat() (entites metier reelles uniquement, jetons visuels
        // exclus) mais sans agreger avec les autres postes du groupe. Portage
        // generique du correctif collegue (reference/colleague, C14.53) --
        // aucune nouvelle definition de goulot introduite : memes seuils
        // (op.seuilAlertFile/seuilGoulotWT) que analyserEtat().
        int fileReellePoste = 0;
        int traitementReelPoste = 0;
        double wtPoste = 0;
        try {
            int nqp = p.queue.size();
            for (int qi = 0; qi < nqp; qi++) {
                FluxEntity e = p.queue.get(qi);
                if (e != null && !estFluxVisuelSeulement(e)) {
                    fileReellePoste++;
                    wtPoste = Math.max(wtPoste, time() - e.tDebutAttente);
                }
            }
            int ndp = p.delay.size();
            for (int di = 0; di < ndp; di++) {
                FluxEntity e = p.delay.get(di);
                if (e != null && !estFluxVisuelSeulement(e)) traitementReelPoste++;
            }
        } catch (Throwable ignored) {}

        String etatPoste;
        if (p.enPanne) {
            etatPoste = String.format("🟣 EN PANNE (reprise dans %.0f min)", Math.max(0, (p.tFinPanne - time()) / 60.0));
        } else if (fileReellePoste > op.seuilAlertFile || wtPoste > op.seuilGoulotWT) {
            etatPoste = String.format("⚠️ GOULOT (file=%d, attente=%.0fs)", fileReellePoste, wtPoste);
        } else if (fileReellePoste + traitementReelPoste > 0) {
            etatPoste = "actif (" + (fileReellePoste + traitementReelPoste) + " en cours)";
        } else {
            etatPoste = "en attente (aucune unité traitée)";
        }
        sb.append(String.format("  • [%s] %-32s %-8s  %s\n",
            p.idPoste,
            (p.nom != null ? (p.nom.length() > 32 ? p.nom.substring(0,32) : p.nom) : p.idPoste),
            p.codeSCOR,
            etatPoste));
        if (p.mtbfHeures > 0) {
            sb.append(String.format("      MTBF=%.0fh  MTTR=%.1fh  pannes cumulées=%d  arrêt total=%.1fh\n",
                p.mtbfHeures, p.mttrHeures, p.nbPannes, p.tempsArretCumule / 3600.0));
        }
    }
}
sb.append("\n── Rôle ────────────────────────────\n");
sb.append("Surveille ces micro-activités, détecte les goulots\n");
sb.append("(file/temps d'attente) et escalade au Tactical\n");
sb.append("du macro-processus concerné si un seuil est franchi.\n");
getExperimentHost().showMessageDialog(sb.toString());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791000002102</Id>
					<Name><![CDATA[etatLisible]]></Name>
					<X>-570</X><Y>540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[etat]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (etat == null) return "—";
if (etat.equals("IDLE"))         return "🟢 Inactif / en attente";
if (etat.equals("WORKING"))      return "🟢 Actif (normal)";
if (etat.equals("ACTIF"))        return "🟢 Actif (normal)";
if (etat.equals("NORMAL"))       return "🟢 Normal";
if (etat.equals("SURVEILLANCE")) return "🟢 Surveillance (nominal)";
if (etat.equals("PRIORITAIRE"))  return "🟠 Prioritaire";
if (etat.equals("AJUSTEMENT"))   return "🟠 Ajustement en cours";
if (etat.equals("SURCHARGE"))    return "🟠 Surcharge";
if (etat.equals("GOULOT"))       return "🔴 Goulot détecté";
if (etat.equals("PANNE"))        return "🟣 En panne (arrêt machine)";
if (etat.equals("ESCALADE"))     return "🔴 Escalade (traite un goulot)";
if (etat.equals("EN_PAUSE"))     return "⚪ En pause";
return etat;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000002103</Id>
					<Name><![CDATA[popupSupervisor]]></Name>
					<X>-570</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[macro]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[CoordinatorAgent sv = null;
for (CoordinatorAgent s : supervisorsMacro) {
    if (macro.equals(s.idMacroProcessus)) { sv = s; break; }
}
StringBuilder sb = new StringBuilder();
sb.append("════════════════════════════════════\n");
sb.append("  COORDINATEUR : ").append(macro).append(macro.equals("sR") ? "" : "1").append("  (").append(libelleMacroProcessusSCOR(macro)).append(")\n");
sb.append("════════════════════════════════════\n\n");
if (sv == null) { sb.append("(non initialisé)\n"); getExperimentHost().showMessageDialog(sb.toString()); return; }
// Bloc A.5 -- meme fonction que la couleur du pave (etatCoordinateurMacro),
// pour garantir que ce texte ne contredit jamais la couleur affichee.
String etatLive = etatCoordinateurMacro(macro);
sb.append("▸ État courant       : ").append(etatLisible(etatLive != null ? etatLive : sv.etatAgent)).append("\n");
sb.append("▸ Depuis             : ").append(String.format("%.0f s", time() - sv.tEntreeEtat)).append("\n\n");
KPIBundle k = board.kpiParMacro.get(macro);
sb.append("── Performance du macro-processus ──\n");
if (k != null) {
    sb.append(String.format("  Passages traités   : %d\n", k.count));
    sb.append(String.format("  Temps traitement moy.en           : %.1f s\n", k.avgCycleTime()));
    sb.append(String.format("  Temps d’attente moyen  : %.1f s\n", k.avgWaitTime()));
    sb.append(String.format("  Efficacité du cycle : %.0f %%\n", k.pce() * 100));
} else {
    sb.append("  (aucune donnée pour l'instant)\n");
}
// Bloc A.5 -- "Alertes traitées"/"Rééquilibrages"/"Dernier goulot" venaient d'un
// circuit de décision AHP (recevoirAlerteGoulot/prendreDecisionAHP) qui n'est
// alimenté QUE par traiterAlertesTactiques() -- fonction elle-même désactivée
// dès sa 1ère ligne quand realignementFluxHierarchiqueActif=true (le routage
// "génération 2", actif par défaut sur ce modèle). Ces 3 compteurs restaient
// donc figés à 0/0/"—" en permanence, quelle que soit l'activité réelle : un
// autre symptôme d'incohérence, indépendant de "État courant" mais de même
// cause racine. Remplacés par les compteurs réellement alimentés en
// génération 2 (recevoirMessageHierarchique(), déjà présent dans ce master,
// appelé à chaque message hiérarchique réellement distribué à ce coordinateur).
sb.append("\n── Activité de supervision ─────────\n");
sb.append(String.format("  Messages hiérarchiques reçus : %d\n", sv.nbMessagesHierarchiquesRecus));
sb.append("  Dernier message      : ").append(
    (sv.dernierMessageHierarchique != null && !sv.dernierMessageHierarchique.isEmpty())
        ? (sv.dernierMessageHierarchique.length() > 80 ? sv.dernierMessageHierarchique.substring(0, 80) + "…" : sv.dernierMessageHierarchique)
        : "—").append("\n");
if ("sM".equals(macro)) {
    sb.append("\n── Ordonnancement de la production ─\n");
    sb.append(String.format("  Commandes en carnet : %d\n", sv.carnetCommandesMTO.size()));
    sb.append(String.format("  Commandes libérées   : %d\n", sv.nbCommandesOrdonnancees));
    if (!sv.carnetCommandesMTO.isEmpty()) {
        CommandeAgent prochaine = sv.carnetCommandesMTO.get(0);
        double delaiRestant = (prochaine.tPromise - time()) / 60.0;
        sb.append(String.format("  Prochaine (EDD)      : %s (délai restant %.0f min)\n",
            prochaine.idCommande, delaiRestant));
    }
    sb.append("  Règle : Earliest Due Date (EDD), rythmée par la\n");
    sb.append("  charge du Make (goulot/panne retarde la libération).\n");
}
sb.append("\n── Rôle ────────────────────────────\n");
sb.append("Reçoit les escalades des Tactiques de son\n");
sb.append("macro-processus, décide (AHP) des priorités\n");
sb.append("et rééquilibre les ressources si nécessaire.\n");
if ("sM".equals(macro)) {
    sb.append("Ordonnance également la production : décide quand\n");
    sb.append("et dans quel ordre les commandes en attente sont\n");
    sb.append("lancées (rôle réel de sM1.1).\n");
}
getExperimentHost().showMessageDialog(sb.toString());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000002104</Id>
					<Name><![CDATA[popupTactical]]></Name>
					<X>-570</X><Y>620</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[macro]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[TacticalAgent ta = null;
for (TacticalAgent t : tacticals) {
    if (macro.equals(t.idMacroProcessus)) { ta = t; break; }
}
StringBuilder sb = new StringBuilder();
sb.append("════════════════════════════════════\n");
sb.append("  AGENT TACTIQUE : ").append(libelleMacroProcessusSCOR(macro)).append("\n");
sb.append("════════════════════════════════════\n\n");
if (ta == null) { sb.append("(non initialisé)\n"); getExperimentHost().showMessageDialog(sb.toString()); return; }
sb.append("▸ Code tactique      : ").append(ta.monCodeSCOR).append("\n");
sb.append("▸ Macro supervisé    : ").append(macro).append(" (").append(libelleMacroProcessusSCOR(macro)).append(")\n");
KPIBundle k = board.kpiParMacro.get(macro);
double wt = (k != null) ? k.avgWaitTime() : 0;
String etat = (wt > ta.seuilEscalade) ? "🔴 Escalade (attente > seuil)"
            : (wt > ta.seuilEscalade * 0.5) ? "🟠 Surveillance active"
            : "🟢 Nominal";
sb.append("▸ État courant       : ").append(etat).append("\n\n");
sb.append("── Surveillance ────────────────────\n");
sb.append(String.format("  Attente moyenneen macro     : %.1f s\n", wt));
sb.append(String.format("  Seuil d'escalade   : %.1f s\n", ta.seuilEscalade));
sb.append(String.format("  Escalades émises   : %d\n", ta.nbEscalades));
sb.append("\n── Rôle ────────────────────────────\n");
sb.append("Agrège l'état des opérationnels de son\n");
sb.append("macro-processus. Si le temps d'attente\n");
sb.append("dépasse le seuil, émet une alerte que le\n");
sb.append("Coordinateur traitera (escalade ascendante).\n");
getExperimentHost().showMessageDialog(sb.toString());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000002105</Id>
					<Name><![CDATA[popupStrategic]]></Name>
					<X>-570</X><Y>660</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[StringBuilder sb = new StringBuilder();
sb.append("════════════════════════════════════\n");
sb.append("  AGENT STRATÉGIQUE (niveau chaîne)\n");
sb.append("════════════════════════════════════\n\n");
if (strategic == null) { sb.append("(non initialisé)\n"); getExperimentHost().showMessageDialog(sb.toString()); return; }
double f = strategic.facteurAjustement;
String etat = (f <= 0.55) ? "🔴 Saturé (plancher 0.5 atteint)"
            : (f < 0.95 || f > 1.05) ? "🟠 Ajustement actif"
            : "🟢 Régime stable";
sb.append("▸ État courant       : ").append(etat).append("\n");
sb.append("▸ Facteur ajustement : ").append(String.format("%.2f", f)).append("\n\n");
sb.append("── Politique de production (flux physique) ──\n");
sb.append(String.format("  Prévision demande  : %.1f unités/h\n", strategic.previsionDemande));
sb.append(String.format("  Stock fini observé : %.0f unités\n", strategic.stockFiniObserve));
sb.append(String.format("  Stock cible (%.0fh) : %.0f unités\n", strategic.couvertureStockCibleHeures, strategic.stockCibleCalcule));
sb.append(String.format("  → Débit MTS décidé : %.1f unités/h\n", strategic.debitMTSDecide));
if (strategic.stockFiniObserve < strategic.stockCibleCalcule) {
    sb.append("  (stock sous la cible → production accélérée pour rattraper)\n");
} else if (strategic.stockCibleCalcule > 0) {
    sb.append("  (stock au-dessus de la cible → production ralentie)\n");
}
sb.append("\n── Décisions sur commandes (flux information) ──\n");
sb.append(String.format("  Commandes arbitrées : %d\n", strategic.nbDecisionsCommandes));
sb.append(String.format("  Servies sur stock (MTS) : %d\n", strategic.nbCommandesMTS));
sb.append(String.format("  Production dédiée (MTO) : %d\n", strategic.nbCommandesMTO));
sb.append(String.format("  REFUSÉES (capacité) : %d\n", strategic.nbCommandesRefusees));
if (strategic.nbCommandesRefusees > 0) {
    sb.append(String.format("  (carnet Make plafonné à %d commandes)\n", strategic.capaciteCarnetMax));
    sb.append("  → des refus récurrents signalent une sous-capacité\n");
    sb.append("    structurelle, pas un incident ponctuel.\n");
}
sb.append("\n");
sb.append("── Performance Indicator global (SCOR) ──\n");
sb.append(String.format("  PI global          : %.3f  (cible %.2f)\n", strategic.piGlobalCourant, strategic.ciblePIGlobal));
sb.append(String.format("  RL (Reliability)   : %.2f\n", strategic.scoreRL));
sb.append(String.format("  RS (Responsiveness): %.2f\n", strategic.scoreRS));
sb.append(String.format("  AG (Agility)       : %.2f\n", strategic.scoreAG));
sb.append(String.format("  CO (Cost)          : %.2f\n", strategic.scoreCO));
sb.append(String.format("  AM (Asset Mgmt)    : %.2f\n", strategic.scoreAM));
sb.append(String.format("\n  Ajustements émis   : %d\n", strategic.nbAjustements));
sb.append("\n── Rôle ────────────────────────────\n");
sb.append("Calcule le Performance Indicator global de\n");
sb.append("la chaîne (pipeline score/fuzzy vers attributs et PI) et ajuste\n");
sb.append("la sensibilité globale du système selon l'écart\n");
sb.append("à la cible (boucle de régulation descendante).\n");
getExperimentHost().showMessageDialog(sb.toString());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000002106</Id>
					<Name><![CDATA[popupBlackboard]]></Name>
					<X>-570</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[StringBuilder sb = new StringBuilder();
sb.append("════════════════════════════════════\n");
sb.append("  BLACKBOARD (bus de coordination)\n");
sb.append("════════════════════════════════════\n\n");
if (board == null) { sb.append("(non initialisé)\n"); getExperimentHost().showMessageDialog(sb.toString()); return; }
sb.append("▸ Alertes en attente : ").append(board.alertesPubliees != null ? board.alertesPubliees.size() : 0).append("\n");
sb.append("▸ Rebuts cumulés     : ").append(board.totalRebuts).append("\n");
sb.append("▸ Rework cumulés     : ").append(board.totalRework).append("\n\n");
sb.append("── Alertes actuellement publiées ───\n");
if (board.alertesPubliees == null || board.alertesPubliees.isEmpty()) {
    sb.append("  (aucune — système nominal)\n");
} else {
    int n = 0;
    for (AERMessage m : board.alertesPubliees) {
        if (n++ >= 12) { sb.append("  ... (+ autres)\n"); break; }
        sb.append("  • ").append(m.emetteur).append(" : ").append(m.contenu != null && m.contenu.length() > 40 ? m.contenu.substring(0,40) : m.contenu).append("\n");
    }
}
sb.append("\n── Rôle ────────────────────────────\n");
sb.append("Tableau partagé où les agents publient et lisent\n");
sb.append("les alertes (goulots) et messages de coordination.\n");
sb.append("C'est le canal d'escalade entre les niveaux.\n");
getExperimentHost().showMessageDialog(sb.toString());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1782073742883</Id>
					<Name><![CDATA[couleurBlackboard]]></Name>
					<X>-570</X><Y>560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Pouls du bus : nombre d'alertes en attente de traitement.
if (board == null) return new java.awt.Color(0x95A5A6);
int n = board.alertesPubliees.size();
if (n > 3) return new java.awt.Color(0xC0392B);
if (n > 0) return new java.awt.Color(0xE67E22);
return new java.awt.Color(0x2980B9);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1782073742885</Id>
					<Name><![CDATA[texteBlackboard]]></Name>
					<X>-570</X><Y>540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (board == null) return "BlackboardAgent — bus partage";
int n = board.alertesPubliees.size();
return "BlackboardAgent — bus partage (" + n + (n == 1 ? " alerte en attente)" : " alertes en attente)");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782073921093</Id>
					<Name><![CDATA[initTacticals]]></Name>
					<X>-570</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Creer 4 TacticalAgent (un par macro-processus SCOR principal, Return inclus)
// Code SCOR propre a chaque tactique : ce sont des holons de PLANIFICATION
// (P2 a P5 dans la nomenclature SCOR P1..P5), distinct du macro-processus
// qu'ils supervisent (idMacroProcessus = sS/sM/sD/sR).
String[] macros = {"sS", "sM", "sD", "sR"};
String[] codesTactiques = {"sP2", "sP3", "sP4", "sP5"};
for (int i = 0; i < macros.length; i++) {
    TacticalAgent ta = add_tacticals();
    ta.idMacroProcessus = macros[i];
    ta.monCodeSCOR = codesTactiques[i];
    ta.seuilEscalade = 10.0;
}
board.logEvent("[HOLON] 4 TacticalAgents initialises (sP2=Source, sP3=Make, sP4=Deliver, sP5=Return)");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1799300000012</Id>
					<Name><![CDATA[initSupervisorsMacro]]></Name>
					<X>-570</X><Y>620</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Coordinateurs validés par stratégie et macro-processus.
// MTS : CA-sS1, CA-sM1, CA-sD1, CA-sR
// MTO : CA-sS2, CA-sM2, CA-sD2, CA-sR
// ETO : CA-sS3, CA-sM3, CA-sD3, CA-sR
String[][] defs = {
    {"CA-sS1", "sS", "sS1", "MTS"},
    {"CA-sM1", "sM", "sM1", "MTS"},
    {"CA-sD1", "sD", "sD1", "MTS"},
    {"CA-sS2", "sS", "sS2", "MTO"},
    {"CA-sM2", "sM", "sM2", "MTO"},
    {"CA-sD2", "sD", "sD2", "MTO"},
    {"CA-sS3", "sS", "sS3", "ETO"},
    {"CA-sM3", "sM", "sM3", "ETO"},
    {"CA-sD3", "sD", "sD3", "ETO"},
    {"CA-sR",  "sR", "sR",  "TRANSVERSAL"}
};
for (String[] d : defs) {
    CoordinatorAgent c = add_supervisorsMacro();
    c.idAgentCoordinateur = d[0];
    c.idMacroProcessus = d[1];
    c.monCodeSCOR = d[2];
    c.strategieRealisation = d[3];
}
board.logEvent("[HOLON] 10 CoordinatorAgents initialisés : MTS, MTO, ETO et Return partagé");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
