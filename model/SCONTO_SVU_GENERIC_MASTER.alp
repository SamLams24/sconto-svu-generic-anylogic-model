				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1781966000001</Id>
					<Name><![CDATA[executionBruteColumns]]></Name>
					<X>-440</X><Y>3840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "N° sequentiel de la trace",
    "Temps de simulation (secondes)",
    "Identifiant de l'entite concernee",
    "Emetteur de la mesure (poste/agent)",
    "Identifiant du poste",
    "Code SCOR (niveau 3)",
    "Type d'evenement",
    "Nom métier de la mesure",
    "Valeur brute mesuree",
    "Unite de la valeur",
    "Commentaire explicatif (formule, contexte)"
};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781966000002</Id>
					<Name><![CDATA[executionBruteRows]]></Name>
					<X>-440</X><Y>3870</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (tracesBrutes == null || tracesBrutes.isEmpty()) {
    return emptyRows(modeExecution ? "Simulation en cours, aucune trace" : "Simulation non démarrée", executionBruteColumns().length);
}

java.util.ArrayList<TraceData> propres = new java.util.ArrayList<TraceData>();
for (TraceData r : tracesBrutes) {
    if (r == null) continue;
    String ent = r.idEntite == null ? "" : r.idEntite.toUpperCase(java.util.Locale.ROOT);
    String em = r.emetteur == null ? "" : r.emetteur.toUpperCase(java.util.Locale.ROOT);
    if (ent.startsWith("VISUEL_") || ent.contains("TRACE_VISUEL") || em.contains("VISUEL-FLOW")) continue;
    propres.add(r);
}

if (propres.isEmpty()) {
    return emptyRows("Aucune trace métier brute exportable", executionBruteColumns().length);
}

Object[][] rows = new Object[propres.size()][executionBruteColumns().length];

for (int i = 0; i < propres.size(); i++) {
    TraceData r = propres.get(i);

    rows[i][0] = String.valueOf(r.id);
    rows[i][1] = fmt1(r.t);
    rows[i][2] = r.idEntite;
    rows[i][3] = r.emetteur;
    rows[i][4] = nettoyerIdPosteTrace(r.idPoste, r.evenement, r.emetteur);
    rows[i][5] = nettoyerCodeSCORTraceAvecContexte(r.codeSCOR, r.evenement, r.emetteur);
    rows[i][6] = r.evenement;
    String mesureLisible = r.mesure == null ? "" : r.mesure;
    if ("Temps de traitement".equalsIgnoreCase(mesureLisible)) mesureLisible = "Temps de traitement";
    else if ("Temps d’attente".equalsIgnoreCase(mesureLisible)) mesureLisible = "Temps d'attente";
    else if ("Temps utile".equalsIgnoreCase(mesureLisible)) mesureLisible = "Temps utile";
    else if ("EFFICACITE_CYCLE".equalsIgnoreCase(mesureLisible) || "PCE".equalsIgnoreCase(mesureLisible)) mesureLisible = "Efficacité du cycle";
    rows[i][7] = mesureLisible;
    rows[i][8] = fmt2(r.valeurBrute);
    rows[i][9] = r.unite;
    rows[i][10] = r.commentaire;
}

return rows;]]></Body>
				</Function>
