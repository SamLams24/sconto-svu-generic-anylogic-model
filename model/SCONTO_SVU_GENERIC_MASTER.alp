                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[PosteGenericAgent p = trouverPoste(idDepuisSelectionGenerique(champPosteIdConsomme));
if (p == null) {
    getExperimentHost().showMessageDialog("❌ Poste introuvable : \"" + champPosteIdConsomme + "\"");
} else {
    p.consommeMatiere = champConsommeMatiere;
    getExperimentHost().showMessageDialog("✅ Poste \"" + p.nom + "\" : "
        + (p.consommeMatiere ? "consomme désormais la matière de la nomenclature du produit traité."
                              : "ne consomme plus de matière."));
}]]></ActionCode>
