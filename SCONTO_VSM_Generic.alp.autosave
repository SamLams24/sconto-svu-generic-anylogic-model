					<Id>1781895688678</Id>
					<Name><![CDATA[tableN3ToN1Text]]></Name>
					<X>-300</X><Y>1670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {6, 26, 12, 12, 8, 14, 22};

    StringBuilder sb = new StringBuilder();

    strategic.calculerPIGlobal();

    sb.append(tableTitle(
        "TRANSPARENCE DECISIONNELLE — AGREGEATION SCOR N3 VERS ATTRIBUTS N1",
        w
    ));

    sb.append(tableRow(new String[]{
        "Attr.",
        "Metrique N3",
        "Brut",
        "Normalise",
        "Poids",
        "Contrib.",
        "Formule"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    String[] attrs = {"RL", "RS", "AG", "CO", "AM"};

    boolean hasData = false;

    for (String attr : attrs) {
        java.util.ArrayList<MetriqueN3> lst = strategic.detailN3.get(attr);

        if (lst == null || lst.isEmpty()) continue;

        for (MetriqueN3 m : lst) {
            hasData = true;

            double contribution = m.valeurNorm * m.poids;

            sb.append(tableRow(new String[]{
                attr,
                m.nom,
                fmt3(m.valeurBrute),
                fmt3(m.valeurNorm),
                fmt2(m.poids),
                fmt3(contribution),
                "valNorm x poids"
            }, w)).append("\n");
        }
    }

    if (!hasData) {
        sb.append(tableRow(new String[]{
            "-", "Aucune metrique N3", "-", "-", "-", "-", "-"
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

    sb.append("\n");

    int[] w2 = {10, 10, 10, 10, 10, 12, 12};

    sb.append(tableTitle(
        "SCORES DES ATTRIBUTS ET PERFORMANCE INTEGREE",
        w2
    ));

    sb.append(tableRow(new String[]{
        "RL",
        "RS",
        "AG",
        "CO",
        "AM",
        "PI Global",
        "Cible PI"
    }, w2)).append("\n");

    sb.append(tableLine(w2)).append("\n");

    sb.append(tableRow(new String[]{
        fmt3(strategic.scoreRL),
        fmt3(strategic.scoreRS),
        fmt3(strategic.scoreAG),
        fmt3(strategic.scoreCO),
        fmt3(strategic.scoreAM),
        fmt3(strategic.piGlobalCourant),
        fmt3(strategic.ciblePIGlobal)
    }, w2)).append("\n");

    sb.append(tableLine(w2)).append("\n");

    return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781895852174</Id>
					<Name><![CDATA[tableFluxSupplyChainText]]></Name>
					<X>-300</X><Y>1700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {8, 14, 20, 20, 8, 12};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "TABLEAU DES FLUX SUPPLY CHAIN — APPROVISIONNEMENT, LIVRAISON, RETOUR",
        w
    ));

    sb.append(tableRow(new String[]{
        "T(s)",
        "Type flux",
        "Source",
        "Cible",
        "Qte",
        "Sens"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (fluxLogs == null || fluxLogs.isEmpty()) {
        sb.append(tableRow(new String[]{
            fmt1(time()), "-", "-", "-", "0", "Aucun"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    int debut = Math.max(0, fluxLogs.size() - 25);

    for (int i = debut; i < fluxLogs.size(); i++) {
        FluxLog f = fluxLogs.get(i);

        String sens = FluxLog.RETOUR.equals(f.typeFlux) ? "<--" : "-->";

        sb.append(tableRow(new String[]{
            fmt1(f.tEmission),
            f.typeFlux,
            f.idSource,
            f.idCible,
            String.valueOf(f.qte),
            sens
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781896034661</Id>
					<Name><![CDATA[tableDecisionsHoloniquesText]]></Name>
					<X>-300</X><Y>1730</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {12, 110};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "TABLEAU DES DECISIONS HOLONIQUES — AGENTS, ALERTES, ACTIONS",
        w
    ));

    sb.append(tableRow(new String[]{
        "Niveau",
        "Message (avec temps de simulation inclus)"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    boolean hasData = false;

    // Source corrigee : board.logEvenements est l'historique PERSISTANT (jusqu'a
    // 200 entrees) de tous les evenements holoniques. L'ancienne version lisait
    // supervisor.alertesGoulot, qui est VIDEE a chaque cycle de decision AHP
    // (voir prendreDecisionAHP()) : elle ne montrait quasiment jamais de donnees.
    if (board.logEvenements != null) {
        for (String evt : board.logEvenements) {
            if (evt.contains("HOLON") || evt.contains("AER") || evt.contains("CONFIG")
                || evt.contains("STRATEGIC") || evt.contains("GOULOT")) {
                hasData = true;

                String niveau = "AUTRE";
                if (evt.contains("HOLON-OP"))     niveau = "OPER.";
                else if (evt.contains("HOLON-TAC"))  niveau = "TACT.";
                else if (evt.contains("HOLON-SUP"))  niveau = "SUPERV.";
                else if (evt.contains("HOLON-STRAT")) niveau = "STRAT.";
                else if (evt.contains("STRATEGIC"))  niveau = "STRAT.";
                else if (evt.contains("GOULOT"))     niveau = "GOULOT";
                else if (evt.contains("CONFIG"))     niveau = "CONFIG";
                else if (evt.contains("AER"))        niveau = "AER";

                sb.append(tableRow(new String[]{ niveau, evt }, w)).append("\n");
            }
        }
    }

    if (!hasData) {
        sb.append(tableRow(new String[]{
            "INFO",
            "[T=" + fmt1(time()) + "] Aucune décision holonique enregistree"
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

    return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781896204014</Id>
					<Name><![CDATA[exporterTracesCSV]]></Name>
					<X>-300</X><Y>1760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
        java.io.PrintWriter pw = new java.io.PrintWriter(
            new java.io.FileWriter("traces_" + nomEntreprise + ".csv")
        );

        pw.println("id;t;niveau;emetteur;idEntite;idPoste;codeSCOR;evenement;mesure;valeurBrute;unite;niveauAggregation;valeurAgregee;formule;commentaire");

        for (TraceData r : tracesBrutes) {
            pw.println(String.format(
                "%d;%.3f;%s;%s;%s;%s;%s;%s;%s;%.5f;%s;%s;%.5f;%s;%s",
                r.id,
                r.t,
                r.niveau,
                r.emetteur,
                r.idEntite,
                r.idPoste,
                r.codeSCOR,
                r.evenement,
                r.mesure,
                r.valeurBrute,
                r.unite,
                r.niveauAggregation,
                r.valeurAgregee,
                r.formule,
                r.commentaire
            ));
        }

        for (TraceData r : tracesAgregees) {
            pw.println(String.format(
                "%d;%.3f;%s;%s;%s;%s;%s;%s;%s;%.5f;%s;%s;%.5f;%s;%s",
                r.id,
                r.t,
                r.niveau,
                r.emetteur,
                r.idEntite,
                r.idPoste,
                r.codeSCOR,
                r.evenement,
                r.mesure,
                r.valeurBrute,
                r.unite,
                r.niveauAggregation,
                r.valeurAgregee,
                r.formule,
                r.commentaire
            ));
        }

        pw.close();

        getExperimentHost().showMessageDialog(
            "✅ Traces exportées\n\nFichier : traces_" + nomEntreprise + ".csv"
        );

    } catch (Exception ex) {
        getExperimentHost().showMessageDialog(
            "❌ Erreur export traces\n\n" + ex.getMessage()
        );
    }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
