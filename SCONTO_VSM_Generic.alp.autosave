// ============================================================
// LAYOUT - PARALLELISME MULTI-ACTEURS (positionnement des postes)
// Chaque acteur recoit une bande verticale dediee (BAND_HEIGHT),
// et chaque chaine independante (racine) de cet acteur recoit
// sa propre ligne (LANE_HEIGHT) a l'interieur de cette bande.
// Plus de detail dans positionnerPoste().
//
// IMPORTANT : la vue suivante sur le canevas (schema holonique ADACOR)
// commence vers Y = 2699. Avec 8 emplacements d'acteurs au maximum,
// il faut donc que 8*LAYOUT_BAND_HEIGHT reste nettement sous ~800
// (soit LAYOUT_Y_BASE + 8*BAND_HEIGHT < 2699). C'est la contrainte
// dure a respecter avant toute autre consideration esthetique.
// ============================================================
public static final double LAYOUT_X_START      = 430;
public static final double LAYOUT_X_STEP        = 46;
public static final double LAYOUT_Y_BASE        = 1872;
public static final double LAYOUT_LANE_HEIGHT   = 27;
public static final double LAYOUT_BAND_HEIGHT   =120;
public static final double LAYOUT_ALT_OFFSET    = 12;

// ============================================================
// CLASSIFICATION DES MICRO-ACTIVITES SCOR NIVEAU 3 : PILOTAGE vs EXECUTION
//
// PILOTAGE  = decision, planification, ordonnancement, autorisation,
//             controle administratif/commercial (ex: Schedule, Plan,
//             Authorize, Select Carrier, Route Shipments, Invoice...).
// EXECUTION = action physique/materielle sur le flux (ex: Receive,
//             Verify, Transfer, Produce, Package, Pick, Pack, Ship...).
//
// Catalogue couvrant l'ensemble des elements de processus de niveau 3
// du referentiel SCOR (Plan, Source, Make, Deliver, Return), toutes
// variantes confondues (Stocked/MTO/ETO pour S,M,D ; Return Defective/
// MRO/Excess pour SR/DR). Un code non repertorie est classe par une
// heuristique de repli basee sur des mots-cles dans son libelle.
// ============================================================
public static final java.util.HashMap<String, String> CATALOGUE_SCOR_N3 = new java.util.HashMap<String, String>();
static {
    // --- PLAN (P1 a P5) : integralement PILOTAGE par nature -------------
    for (String fam : new String[]{"P1","P2","P3","P4","P5"}) {
        for (int i = 1; i <= 4; i++) CATALOGUE_SCOR_N3.put(fam + "." + i, "PILOTAGE");
    }

    // --- SOURCE ------------------------------------------------------------
    // S1 : Source Stocked Product
    CATALOGUE_SCOR_N3.put("S1.1", "PILOTAGE");  // Schedule Product Deliveries
    CATALOGUE_SCOR_N3.put("S1.2", "EXECUTION"); // Receive Product
    CATALOGUE_SCOR_N3.put("S1.3", "EXECUTION"); // Verify Product
    CATALOGUE_SCOR_N3.put("S1.4", "EXECUTION"); // Transfer Product
    CATALOGUE_SCOR_N3.put("S1.5", "PILOTAGE");  // Authorize Supplier Payment
    // S2 : Source MTO Product (meme structure que S1)
    CATALOGUE_SCOR_N3.put("S2.1", "PILOTAGE");
    CATALOGUE_SCOR_N3.put("S2.2", "EXECUTION");
    CATALOGUE_SCOR_N3.put("S2.3", "EXECUTION");
    CATALOGUE_SCOR_N3.put("S2.4", "EXECUTION");
    CATALOGUE_SCOR_N3.put("S2.5", "PILOTAGE");
    // S3 : Source ETO Product
    CATALOGUE_SCOR_N3.put("S3.1", "PILOTAGE");  // Identify Sources of Supply
    CATALOGUE_SCOR_N3.put("S3.2", "PILOTAGE");  // Select Final Supplier & Negotiate
    CATALOGUE_SCOR_N3.put("S3.3", "PILOTAGE");  // Schedule Product Deliveries
    CATALOGUE_SCOR_N3.put("S3.4", "EXECUTION"); // Receive Product
    CATALOGUE_SCOR_N3.put("S3.5", "EXECUTION"); // Verify Product
    CATALOGUE_SCOR_N3.put("S3.6", "EXECUTION"); // Transfer Product
    CATALOGUE_SCOR_N3.put("S3.7", "PILOTAGE");  // Authorize Supplier Payment

    // --- MAKE ----------------------------------------------------------
    // M1 : Make-to-Stock
    CATALOGUE_SCOR_N3.put("M1.1", "PILOTAGE");  // Schedule Production Activities
    CATALOGUE_SCOR_N3.put("M1.2", "EXECUTION"); // Issue Material
    CATALOGUE_SCOR_N3.put("M1.3", "EXECUTION"); // Produce and Test
    CATALOGUE_SCOR_N3.put("M1.4", "EXECUTION"); // Package
    CATALOGUE_SCOR_N3.put("M1.5", "EXECUTION"); // Stage Product
    CATALOGUE_SCOR_N3.put("M1.6", "EXECUTION"); // Release Product to Deliver
    CATALOGUE_SCOR_N3.put("M1.7", "EXECUTION"); // Waste Disposal
    // M2 : Make-to-Order
    CATALOGUE_SCOR_N3.put("M2.1", "PILOTAGE");
    CATALOGUE_SCOR_N3.put("M2.2", "EXECUTION");
    CATALOGUE_SCOR_N3.put("M2.3", "EXECUTION");
    CATALOGUE_SCOR_N3.put("M2.4", "EXECUTION");
    CATALOGUE_SCOR_N3.put("M2.5", "EXECUTION");
    CATALOGUE_SCOR_N3.put("M2.6", "EXECUTION");
    CATALOGUE_SCOR_N3.put("M2.7", "EXECUTION");
    // M3 : Engineer-to-Order
    CATALOGUE_SCOR_N3.put("M3.1", "PILOTAGE");  // Finalize Production Engineering
    CATALOGUE_SCOR_N3.put("M3.2", "PILOTAGE");  // Schedule Production Activities
    CATALOGUE_SCOR_N3.put("M3.3", "EXECUTION");
    CATALOGUE_SCOR_N3.put("M3.4", "EXECUTION");
    CATALOGUE_SCOR_N3.put("M3.5", "EXECUTION");
    CATALOGUE_SCOR_N3.put("M3.6", "EXECUTION");
    CATALOGUE_SCOR_N3.put("M3.7", "EXECUTION");
    CATALOGUE_SCOR_N3.put("M3.8", "EXECUTION");

    // --- DELIVER ----------------------------------------------------------
    // D1 : Deliver Stocked Product (catalogue complet des 15 etapes canoniques)
    CATALOGUE_SCOR_N3.put("D1.1",  "PILOTAGE");  // Process Inquiry & Quote
    CATALOGUE_SCOR_N3.put("D1.2",  "PILOTAGE");  // Receive/Enter/Validate Order
    CATALOGUE_SCOR_N3.put("D1.3",  "PILOTAGE");  // Reserve Inventory & Determine Delivery Date
    CATALOGUE_SCOR_N3.put("D1.4",  "PILOTAGE");  // Consolidate Orders
    CATALOGUE_SCOR_N3.put("D1.5",  "EXECUTION"); // Build Loads
    CATALOGUE_SCOR_N3.put("D1.6",  "PILOTAGE");  // Route Shipments
    CATALOGUE_SCOR_N3.put("D1.7",  "PILOTAGE");  // Select Carriers & Rate Shipments
    CATALOGUE_SCOR_N3.put("D1.8",  "EXECUTION"); // Receive Product from Source/Make
    CATALOGUE_SCOR_N3.put("D1.9",  "EXECUTION"); // Pick Product
    CATALOGUE_SCOR_N3.put("D1.10", "EXECUTION"); // Pack Product
    CATALOGUE_SCOR_N3.put("D1.11", "EXECUTION"); // Load Vehicle & Generate Shipping Docs
    CATALOGUE_SCOR_N3.put("D1.12", "EXECUTION"); // Ship Product
    CATALOGUE_SCOR_N3.put("D1.13", "EXECUTION"); // Receive & Verify Product by Customer
    CATALOGUE_SCOR_N3.put("D1.14", "EXECUTION"); // Install Product
    CATALOGUE_SCOR_N3.put("D1.15", "PILOTAGE");  // Invoice
    // D2 : Deliver MTO Product (meme structure, +1 etape Source/Make Product en tete)
    CATALOGUE_SCOR_N3.put("D2.1",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D2.2",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D2.3",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D2.4",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D2.5",  "EXECUTION");
    CATALOGUE_SCOR_N3.put("D2.6",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D2.7",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D2.8",  "EXECUTION");
    CATALOGUE_SCOR_N3.put("D2.9",  "EXECUTION");
    CATALOGUE_SCOR_N3.put("D2.10", "EXECUTION");
    CATALOGUE_SCOR_N3.put("D2.11", "EXECUTION");
    CATALOGUE_SCOR_N3.put("D2.12", "EXECUTION");
    CATALOGUE_SCOR_N3.put("D2.13", "EXECUTION");
    CATALOGUE_SCOR_N3.put("D2.14", "EXECUTION");
    CATALOGUE_SCOR_N3.put("D2.15", "PILOTAGE");
    // D3 : Deliver ETO Product
    CATALOGUE_SCOR_N3.put("D3.1",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D3.2",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D3.3",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D3.4",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D3.5",  "EXECUTION");
    CATALOGUE_SCOR_N3.put("D3.6",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D3.7",  "PILOTAGE");
    CATALOGUE_SCOR_N3.put("D3.8",  "EXECUTION");
    CATALOGUE_SCOR_N3.put("D3.9",  "EXECUTION");
    CATALOGUE_SCOR_N3.put("D3.10", "EXECUTION");
    CATALOGUE_SCOR_N3.put("D3.11", "EXECUTION");
    CATALOGUE_SCOR_N3.put("D3.12", "EXECUTION");
    CATALOGUE_SCOR_N3.put("D3.13", "EXECUTION");
    CATALOGUE_SCOR_N3.put("D3.14", "PILOTAGE");
    // D4 : Deliver Retail Product
    CATALOGUE_SCOR_N3.put("D4.1", "PILOTAGE");  // Generate Stocking Schedule
    CATALOGUE_SCOR_N3.put("D4.2", "EXECUTION"); // Receive Product at Store
    CATALOGUE_SCOR_N3.put("D4.3", "EXECUTION"); // Pick Product from Backroom
    CATALOGUE_SCOR_N3.put("D4.4", "EXECUTION"); // Stock Shelf
    CATALOGUE_SCOR_N3.put("D4.5", "EXECUTION"); // Fill Shopping Cart
    CATALOGUE_SCOR_N3.put("D4.6", "EXECUTION"); // Checkout
    CATALOGUE_SCOR_N3.put("D4.7", "EXECUTION"); // Deliver and/or Install

    // --- RETURN (Source Return et Deliver Return, 3 variantes chacun) -----
    // Position 1-2 = autoriser/programmer (PILOTAGE) ; position 3+ = manutention physique (EXECUTION)
    for (String fam : new String[]{"SR1","SR2","SR3","DR1","DR2","DR3"}) {
        CATALOGUE_SCOR_N3.put(fam + ".1", "PILOTAGE");  // Authorize/Identify Return
        CATALOGUE_SCOR_N3.put(fam + ".2", "PILOTAGE");  // Schedule Return Receipt/Shipment
        CATALOGUE_SCOR_N3.put(fam + ".3", "EXECUTION"); // Receive/Return Product
        CATALOGUE_SCOR_N3.put(fam + ".4", "EXECUTION"); // Transfer Defective/MRO/Excess Product
        CATALOGUE_SCOR_N3.put(fam + ".5", "EXECUTION"); // reception finale / cloture physique
    }
}

// Categorise un code SCOR de niveau 3 (ex "M1.3") en "PILOTAGE" ou "EXECUTION".
// 1) recherche directe dans le catalogue ci-dessus (couvre le referentiel SCOR standard) ;
// 2) repli sur la famille macro-processus (P => PILOTAGE) ;
// 3) repli final par mots-cles dans le libelle du poste, si fourni (couvre les
//    codes ad-hoc/personnalises qui ne figurent pas dans le catalogue standard).
public String categoriserActiviteSCOR(String codeN3, String libellePoste) {
    if (codeN3 == null) return "EXECUTION";
    String c = codeN3.trim();
    if (c.startsWith("s") && c.length() > 1 && Character.isUpperCase(c.charAt(1))) c = c.substring(1); // tolere prefixe "s"
    String direct = CATALOGUE_SCOR_N3.get(c);
    if (direct != null) return direct;

    if (c.startsWith("P")) return "PILOTAGE"; // toute famille Plan non repertoriee explicitement

    if (libellePoste != null) {
        String l = libellePoste.toLowerCase();
        String[] motsPilotage = {
            "planifi", "programm", "ordonnanc", "autoris", "valider", "valid",
            "négoci", "negoci", "sélection", "selection", "rout", "devis",
            "facturat", "facture", "invoice", "schedule", "plan", "authorize",
            "identifier les sources", "consolid", "réserv", "reserv"
        };
        for (String mot : motsPilotage) {
            if (l.contains(mot)) return "PILOTAGE";
        }
    }
    return "EXECUTION"; // repli par defaut : la majorite des activites non identifiees sont physiques
}

// Couleur de fond associee a une categorie d'acteur.
// Opacite volontairement forte (alpha ~170/255) pour rester visible
// meme a tres petite echelle, derriere les icones des postes.
// Reprend les memes 4 categories que ActeurSC (FOURNISSEUR / ENTREPRISE_FOCALE / CLIENT / ACTEUR_ANNEXE).
java.awt.Color couleurParCategorie(String categorie) {
    int alpha = 170; // 0 (invisible) a 255 (opaque) - regle l'opacite ici
    if (categorie == null) return new java.awt.Color(150, 150, 150, 50); // gris par defaut
    if (categorie.equals(ActeurSC.FOURNISSEUR))       return new java.awt.Color(20, 160, 160, 50); // teal
    if (categorie.equals(ActeurSC.ENTREPRISE_FOCALE)) return new java.awt.Color(130, 90, 200, 50);  // violet
    if (categorie.equals(ActeurSC.CLIENT))            return new java.awt.Color(230, 120, 100, 50); // corail
    return new java.awt.Color(150, 150, 150, 100); // ACTEUR_ANNEXE ou valeur inattendue : gris
}

// Couleur de la bande verticale n (0..7) : reprend la couleur de la categorie
// du n-ieme acteur de acteursSC (meme indexation que dans positionnerPoste()).
java.awt.Color couleurZoneActeur(int i) {
    if (i < 0 || i >= acteursSC.size()) return new java.awt.Color(16777215, true); // sans objet, la bande est masquee
    return couleurParCategorie(acteursSC.get(i).categorie);
}

// Libelle affiche en haut de la bande verticale n
String libelleZoneActeur(int i) {
    if (i < 0 || i >= acteursSC.size()) return "";
    ActeurSC a = acteursSC.get(i);
    return a.nom + "  (" + a.categorie + ")";
}

// La bande n correspond-elle a un acteur reellement cree ?
boolean zoneActeurVisible(int i) {
    return i >= 0 && i < acteursSC.size();
}

// Couleur de BORDURE opaque et saturee (contrairement au remplissage qui est
// volontairement transparent) : garantit que la zone reste visible/identifiable
// meme si, pour une raison quelconque, le remplissage semi-transparent ne
// ressort pas a l'ecran (recouvrement, contraste, etc.).
java.awt.Color couleurBordureZoneActeur(int i) {
    if (i < 0 || i >= acteursSC.size()) return new java.awt.Color(-6908266, true);
    String cat = acteursSC.get(i).categorie;
    if (cat == null) return new java.awt.Color(-6908266, true);
    if (cat.equals(ActeurSC.FOURNISSEUR))       return new java.awt.Color(-15425376, true); // teal opaque
    if (cat.equals(ActeurSC.ENTREPRISE_FOCALE)) return new java.awt.Color(-8234296, true);  // violet opaque
    if (cat.equals(ActeurSC.CLIENT))            return new java.awt.Color(-1673116, true);  // corail opaque
    return new java.awt.Color(-6908266, true); // gris opaque
}

// ============================================================
// AUTONOMIE COMPORTEMENTALE DES ACTEURS (politique d'appro)
// Chaque acteur FOURNISSEUR avec une politiqueAppro non vide declenche
// ses propres arrivees, totalement independantes du generateur de
// commandes client (genererCommande / Event "arrivee"). Evalue par
// l'Event cyclique "tickAppro" (voir LAYOUT_TICK_APPRO_SEC ci-dessous).
// ============================================================
public static final double LAYOUT_TICK_APPRO_SEC = 60; // frequence d'evaluation des politiques

// Parcourt tous les acteurs FOURNISSEUR et declenche une arrivee si leur
// politique le justifie a cet instant.
void evaluerApprosFournisseurs() {
    for (ActeurSC a : acteursSC) {
        if (!a.actif) continue;
        if (!ActeurSC.FOURNISSEUR.equals(a.categorie)) continue;
        if (a.politiqueAppro == null || a.politiqueAppro.isEmpty()) continue;
        // Un fournisseur passe en mode MRP est desormais pilote par le besoin net
        // (voir calculerBesoinsNets) : on ignore ici sa politique autonome.
        if (a.modeApproMRP) continue;

        boolean declenche = false;

        if (a.politiqueAppro.equals("PERIODIQUE")) {
            if (a.intervalleAppro > 0
                && (a.dernierAppro < 0 || time() - a.dernierAppro >= a.intervalleAppro)) {
                declenche = true;
            }
        } else if (a.politiqueAppro.equals("POISSON")) {
            if (a.tauxArriveePoisson > 0) {
                // Probabilite d'au moins une arrivee pendant ce tick (loi exponentielle discretisee)
                double p = 1 - Math.exp(-a.tauxArriveePoisson * LAYOUT_TICK_APPRO_SEC);
                if (getDefaultRandomGenerator().nextDouble() < p) declenche = true;
            }
        }

        if (declenche) {
            a.dernierAppro = time();
            declencherApproActeur(a);
        }
    }
}

// Injecte UNE SEULE entite-lot par livraison dans chaque poste racine de
// l'acteur "a". Cette entite represente toute la livraison (quantiteTransportee
// unites). Elle sera "eclatee" en produits individuels plus loin dans le flux
// (au poste marque estPointEclatement=true, cote entreprise). Cela evite
// d'injecter des centaines d'entites individuelles cote fournisseur, ce qui
// saturait le systeme (WIP enorme, tout en goulot).
void declencherApproActeur(ActeurSC a) {
    int qte = Math.max(1, (int) Math.round(a.quantiteParAppro));

    for (PosteGenericAgent racine : postes) {
        if (racine.idActeurResponsable == null || !racine.idActeurResponsable.equals(a.idActeur)) continue;
        if (racine.chainesPrecedents != null && !racine.chainesPrecedents.trim().isEmpty()) continue;

        java.util.ArrayList<String> route = construireRouteDepuis(racine.idPoste);
        if (route == null) {
            board.logEvent("[APPRO] " + a.nom + " : aucun scenario ne contient le poste " + racine.nom + ", arrivee ignoree.");
            ajouterSuivi("Approvisionnement", "Approvisionnement ignore", "Aucun scenario ne contient le poste " + racine.nom, a.nom, racine.nom, "SOURCE");
            continue;
        }

        FluxEntity e = add_fluxEntites();
        e.idFlux = "APPRO_" + a.idActeur + "_" + (++seqFlux);
        e.tEntreeSysteme = time();
        e.feuilleDeRoute = new java.util.ArrayList<String>(route);
        e.typeProduit = "LIVRAISON:" + a.nom;
        e.quantiteTransportee = qte;
        e.estLotAppro = true;
        e.etapeCourante = 0;
        PosteGenericAgent premier = trouverPoste(e.prochainPoste());
        if (premier != null) {
            positionnerEntiteSurPoste(e, premier);
            premier.enter.take(e);
        } else remove_fluxEntites(e);

        emettreFluxLog(FluxLog.APPRO, a.nom, racine.nom, qte);
        board.logEvent("[APPRO] " + a.nom + " livre 1 lot de " + qte + " unite(s) sur " + racine.nom);
        ajouterSuivi("Approvisionnement", "Emission d'une livraison fournisseur", "Fournisseur=" + a.nom + " | Quantite=" + qte + " | Poste racine=" + racine.nom, a.nom, racine.nom, "D1.12 -> S1.2");
    }
}

// ============================================================
// GENERATION AUTONOME AU NIVEAU POSTE (independante de l'acteur/racine)
// Un poste marque genereAutonome=true declenche lui-meme ses propres
// arrivees, en lot (quantiteParApproPoste), selon sa propre politique
// (politiqueApproPoste : "" / "PERIODIQUE" / "POISSON"). Contrairement a
// declencherApproActeur (limite aux racines d'un ActeurSC FOURNISSEUR),
// ceci fonctionne sur N'IMPORTE QUEL poste, y compris un poste avec des
// chainesPrecedents deja renseignees : il devient alors un point d'entree
// supplementaire dans son propre flux (utile pour un poste qui recoit a
// la fois d'un poste amont ET genere ses propres entites, ex. reappro
// interne). La feuille de route utilisee est celle construite a partir
// de ce poste (construireRouteAuto), pas necessairement depuis une racine.
// ============================================================
void evaluerGenerationAutonomePostes() {
    for (PosteGenericAgent p : postes) {
        if (!p.genereAutonome) continue;
        if (p.politiqueApproPoste == null || p.politiqueApproPoste.isEmpty()) continue;

        boolean declenche = false;

        if (p.politiqueApproPoste.equals("PERIODIQUE")) {
            if (p.intervalleApproPoste > 0
                && (p.dernierApproPoste < 0 || time() - p.dernierApproPoste >= p.intervalleApproPoste)) {
                declenche = true;
            }
        } else if (p.politiqueApproPoste.equals("POISSON")) {
            if (p.tauxArriveePoissonPoste > 0) {
                double prob = 1 - Math.exp(-p.tauxArriveePoissonPoste * LAYOUT_TICK_APPRO_SEC);
                if (getDefaultRandomGenerator().nextDouble() < prob) declenche = true;
            }
        }

        if (declenche) {
            p.dernierApproPoste = time();
            declencherApproPoste(p);
        }
    }
}

// Injecte quantiteParApproPoste nouvelles entites directement sur le poste p
// (en lot, en un seul evenement), en suivant la feuille de route construite
// a partir de p (construireRouteAuto couvre aussi bien une racine qu'un
// poste intermediaire rattache a la suite d'un scenario existant).
void declencherApproPoste(PosteGenericAgent p) {
    int qte = Math.max(1, (int) Math.round(p.quantiteParApproPoste));

    java.util.ArrayList<String> route = construireRouteAuto(p);
    if (route == null) {
        board.logEvent("[APPRO-POSTE] " + p.nom + " : aucun scenario ne contient ce poste, arrivee ignoree.");
        return;
    }

    String nomActeur = (p.nomActeurResponsable != null && !p.nomActeurResponsable.isEmpty())
        ? p.nomActeurResponsable : "POSTE:" + p.nom;

    for (int i = 0; i < qte; i++) {
        FluxEntity e = add_fluxEntites();
        e.idFlux = "APPRO_" + p.idPoste + "_" + (++seqFlux);
        e.tEntreeSysteme = time();
        e.feuilleDeRoute = new java.util.ArrayList<String>(route);
        e.typeProduit = "APPRO:" + p.nom;
        e.etapeCourante = 0;
        PosteGenericAgent premier = trouverPoste(e.prochainPoste());
        if (premier != null) {
            positionnerEntiteSurPoste(e, premier);
            premier.enter.take(e);
        } else remove_fluxEntites(e);
    }

    emettreFluxLog(FluxLog.APPRO, nomActeur, p.nom, qte);
    board.logEvent("[APPRO-POSTE] " + p.nom + " declenche " + qte + " arrivee(s) en lot.");
}

// Construit la feuille de route a suivre a partir d'un poste racine donne :
// 1) on privilegie un scenario qui demarre exactement sur ce poste,
// 2) sinon on rejoint le premier scenario qui le contient, a partir de ce point,
// 3) sinon (aucun scenario ne le mentionne) : null, l'arrivee est ignoree.
java.util.ArrayList<String> construireRouteDepuis(String idPosteDepart) {
    for (ScenarioFlux sc : scenarios) {
        if (!sc.sequence.isEmpty() && sc.sequence.get(0).equals(idPosteDepart)) {
            return new java.util.ArrayList<String>(sc.sequence);
        }
    }
    for (ScenarioFlux sc : scenarios) {
        int idx = sc.sequence.indexOf(idPosteDepart);
        if (idx >= 0) {
            return new java.util.ArrayList<String>(sc.sequence.subList(idx, sc.sequence.size()));
        }
    }
    return null;
}

java.util.ArrayList<String> construireRouteAuto(PosteGenericAgent racine) {
    java.util.ArrayList<String> route = construireRouteDepuis(racine.idPoste);
    if (route != null) return route;

    for (PosteGenericAgent enfant : postes) {
        if (enfant.chainesPrecedents == null || enfant.chainesPrecedents.trim().isEmpty()) continue;
        for (String nomParent : enfant.chainesPrecedents.split(",")) {
            if (nomParent.trim().equalsIgnoreCase(racine.nom)) {
                java.util.ArrayList<String> suite = construireRouteDepuis(enfant.idPoste);
                if (suite != null) {
                    java.util.ArrayList<String> complete = new java.util.ArrayList<String>();
                    complete.add(racine.idPoste);
                    complete.addAll(suite);
                    return complete;
                }
            }
        }
    }
    return null;
}

// ============================================================
// REGROUPEMENT DES OPERATIONNELS PAR CODE SCOR NIVEAU 3
// Regle : deux micro-activites partageant le meme code de groupe
// (ex "sM1.3.1" et "sM1.3.2" -> groupe "sM1.3") doivent partager le
// MEME OperationalAgent. Si, dans la sequence du scenario, elles sont
// separees par d'autres codes (ex sM1.4.1 entre les deux), ces codes
// intercales sont eux aussi absorbes dans le meme groupe : la chaine
// etant sequentielle (on ne revient jamais en arriere), reapparaitre
// plus tard avec le meme code prouve que tout l'intervalle appartient
// a la meme etape operationnelle.
// ============================================================

// Tronque un code SCOR a son niveau 3 UNIQUEMENT s'il porte un suffixe
// d'instance ajoute par la simulation. Le format SCOR standard niveau 3
// (ex "sS1.1", "sM1.3") n'a qu'UN point et est deja un code de groupe
// valide -- le tronquer effacerait le sous-processus reel (1.1, 1.2, 1.3...
// deviendraient tous "sS1"/"sM1", fusionnant a tort des etapes distinctes).
// Un DEUXIEME point (ex "sM1.3.1") signale un suffixe d'instance propre a
// la simulation -> celui-la seul est retire pour retrouver le code de groupe.
String codeGroupeL3(String code) {
    if (code == null) return null;
    int premierDot = code.indexOf('.');
    int dernierDot = code.lastIndexOf('.');
    if (premierDot < 0 || premierDot == dernierDot) {
        return code;
    }
    return code.substring(0, dernierDot);
}

// Retrouve l'OperationalAgent qui porte actuellement ce poste (quel que
// soit le groupe auquel il a deja ete rattache) en cherchant dans postesLies.
OperationalAgent trouverOperationalParPosteLie(PosteGenericAgent p) {
    for (OperationalAgent op : opAgents) {
        if (op.postesLies.contains(p)) return op;
    }
    return null;
}

// ============================================================
// CODE COURT D'ACTEUR (pour prefixe d'affichage ET clef de regroupement)
// Heuristique : on retire les mots-outils / roles generiques (fournisseur,
// client, sa, du, de, des...), puis :
//  - s'il reste un mot, on le tronque a 3 lettres (ex "ZENER SA Togo" -> "ZEN",
//    "Fournisseur du GPL" -> "GPL" garde tel quel car <=4 lettres),
//  - sinon on retombe sur les 3 premieres lettres du nom complet.
// Cette fonction ne sert qu'a l'AFFICHAGE (prefixe "[XXX]") : la clef
// utilisee pour regrouper/agreger les KPI est basee sur idActeurResponsable
// (garanti unique), jamais sur ce code court (qui peut theoriquement se
// repeter entre deux acteurs au nom proche sans que ca fausse les donnees).
// ============================================================
String acteurCourtF(String nomActeur) {
    if (nomActeur == null || nomActeur.trim().isEmpty()) return "???";
    java.util.HashSet<String> motsOutils = new java.util.HashSet<String>(java.util.Arrays.asList(
        "DE", "DU", "DES", "LA", "LE", "LES", "SA", "ET", "UN", "UNE", "SARL", "LTD",
        "GENERIQUE", "GENERIC", "FOURNISSEUR", "FOURNISSEURS", "CLIENT", "CLIENTS",
        "ENTREPRISE", "SOCIETE", "ANNEXE"
    ));
    String[] mots = nomActeur.trim().split("\\s+");
    for (String m : mots) {
        String mu = m.toUpperCase();
        if (motsOutils.contains(mu)) continue;
        if (mu.length() <= 4) return mu;          // deja court / probable acronyme (ex "GPL")
        return mu.substring(0, 3);                // tronque a 3 lettres
    }
    // Rien trouve (tous mots-outils) : repli sur les 3 premieres lettres du nom brut
    String brut = mots[0].toUpperCase();
    return brut.length() <= 3 ? brut : brut.substring(0, 3);
}

// ============================================================
// CLEF D'AGREGATION / DE REGROUPEMENT OPERATIONNEL
// (idActeurResponsable, code SCOR niveau 3) : GARANTIT que deux acteurs
// differents portant le meme code SCOR (ex "M1.3" chez un fournisseur ET
// chez l'entreprise focale) restent deux ressources/OA/KPI distincts.
// Utilisee a la fois pour : regrouper les OperationalAgent (1 par clef),
// et indexer les KPI (kpiParPoste), pour que les deux restent synchronises.
// ============================================================
String cleKPI(PosteGenericAgent p) {
    if (p == null) return "?";
    String acteur = (p.idActeurResponsable != null && !p.idActeurResponsable.isEmpty())
        ? p.idActeurResponsable : "ACTEUR_INCONNU";
    return acteur + "|" + codeGroupeL3(p.codeSCOR);
}

// Libelle lisible pour l'affichage (badges, pastilles) : "[ZEN] M1.3"
String libelleGroupeF(PosteGenericAgent p) {
    if (p == null) return "?";
    return "[" + acteurCourtF(p.nomActeurResponsable) + "] " + codeGroupeL3(p.codeSCOR);
}

// ============================================================
// REGROUPEMENT OPERATIONNEL GLOBAL (remplace l'ancien algorithme par
// "plage premiere->derniere occurrence dans UN scenario", qui fusionnait
// a tort des dizaines de postes de plusieurs acteurs des qu'un meme code
// SCOR N3 revenait loin dans la sequence -- voir diagnostic).
//
// Nouvelle regle, simple et robuste : 1 OperationalAgent par couple
// (acteur, code SCOR niveau 3), sur TOUS les postes du modele, quel que
// soit leur ordre ou leur repartition entre plusieurs scenarios.
// A appeler apres tout chargement/modification de la configuration
// (JSON, ajout manuel de poste ou de scenario).
// ============================================================
void recalculerTousLesGroupesOperationnels() {
    java.util.LinkedHashMap<String, java.util.ArrayList<PosteGenericAgent>> groupes =
        new java.util.LinkedHashMap<String, java.util.ArrayList<PosteGenericAgent>>();

    for (PosteGenericAgent p : postes) {
        String cle = cleKPI(p);
        java.util.ArrayList<PosteGenericAgent> liste = groupes.get(cle);
        if (liste == null) { liste = new java.util.ArrayList<PosteGenericAgent>(); groupes.put(cle, liste); }
        liste.add(p);
    }

    int nbFusions = 0;
    for (java.util.Map.Entry<String, java.util.ArrayList<PosteGenericAgent>> entry : groupes.entrySet()) {
        java.util.ArrayList<PosteGenericAgent> liste = entry.getValue();
        if (liste.isEmpty()) continue;

        PosteGenericAgent posteSurvivant = liste.get(0);
        OperationalAgent opSurvivant = trouverOperationalParPosteLie(posteSurvivant);
        if (opSurvivant == null) {
            // Aucun OA ne porte encore ce poste (config chargee sans creation prealable) :
            // on en cree un neuf, propre au groupe.
            opSurvivant = add_opAgents();
            opSurvivant.initialiser(posteSurvivant, entry.getKey());
        } else {
            opSurvivant.codeSCOR = entry.getKey();
        }
        opSurvivant.libelleAffichage = libelleGroupeF(posteSurvivant);
        opSurvivant.categorieOP = categoriserActiviteSCOR(codeGroupeL3(posteSurvivant.codeSCOR), posteSurvivant.nom);
        opSurvivant.idActeurSC = posteSurvivant.idActeurResponsable;
        opSurvivant.nomActeurSC = posteSurvivant.nomActeurResponsable;

        for (int i = 1; i < liste.size(); i++) {
            PosteGenericAgent p = liste.get(i);
            OperationalAgent opActuel = trouverOperationalParPosteLie(p);
            if (opActuel == null) {
                // Poste sans OA prealable : simplement rattache au survivant.
                opSurvivant.ajouterPosteLie(p);
                continue;
            }
            if (opActuel == opSurvivant) continue;

            for (PosteGenericAgent pp : new java.util.ArrayList<PosteGenericAgent>(opActuel.postesLies)) {
                if (!opSurvivant.postesLies.contains(pp)) opSurvivant.ajouterPosteLie(pp);
            }
            remove_opAgents(opActuel);
            nbFusions++;
        }
    }

    board.logEvent("[HOLON] Regroupement operationnel global recalcule : "
        + groupes.size() + " groupe(s) (acteur, SCOR N3) sur " + postes.size() + " poste(s), "
        + nbFusions + " fusion(s) effectuee(s).");
}

// ============================================================
// POLITIQUE DE STOCK MTS / MTO REELLE
// Retrouve, pour un scenario donne, le dernier poste de type STOCKAGE
// dans sa sequence (le stock de produits finis le plus proche de
// l'expedition). Utilise pour le "pull" MTS dans traiterCommande().
// ============================================================
PosteGenericAgent trouverStockFiniPourScenario(ScenarioFlux sc) {
    // Objectif : retrouver un point de stock produit fini fiable.
    // Cas important : certains scenarios de livraison directe (ex. ZENER CAS 1)
    // ne contiennent pas eux-mêmes M1.5 dans leur route, car ils partent d'une
    // commande client puis vont vers Deliver. Dans ce cas, il faut chercher le
    // magasin produit fini dans l'ensemble du modele, pas seulement dans la sequence.

    // 1) Recherche prioritaire dans la sequence du scenario.
    if (sc != null && sc.sequence != null) {
        for (int i = sc.sequence.size() - 1; i >= 0; i--) {
            PosteGenericAgent p = trouverPoste(sc.sequence.get(i));
            if (p != null && estPosteStockFini(p)) return p;
        }
    }

    // 2) Recherche globale : poste explicitement STOCKAGE ou micro-activite M1.5.
    // C'est ce qui corrige le cas ZENER CAS 1 : le stock fini existe dans le modele
    // meme si le scenario de livraison directe ne passe pas par M1.5.
    for (PosteGenericAgent p : postes) {
        if (p != null && estPosteStockFini(p)) return p;
    }

    return null;
}

boolean estPosteStockFini(PosteGenericAgent p) {
    if (p == null) return false;

    if (p.typePoste == TypePoste.STOCKAGE) return true;

    String code = p.codeSCOR == null ? "" : p.codeSCOR.trim().toUpperCase(java.util.Locale.ROOT);
    String nomP = keyAnim(p.nom);

    // M1.5 = Stage / buffer / transfert vers magasin produits finis.
    if (code.startsWith("M1.5")) return true;

    return nomP.contains("MAGASIN PRODUITS FINIS")
        || nomP.contains("PRODUITS FINIS")
        || nomP.contains("PRODUIT FINI")
        || nomP.contains("BUFFER")
        || nomP.contains("STOCK FINI")
        || nomP.contains("STOCKAGE FINI");
}

// Nombre de chaines racines (lignes paralleles) deja attribuees a chaque acteur
java.util.HashMap<String, Integer> nbRacinesParActeur = new java.util.HashMap<String, Integer>();

long seqTrace = 0;
long seqTraceBrute = 0;
long seqTraceAgregee = 0;
java.util.HashSet<String> commandesClotureesTracees = new java.util.HashSet<String>();
int seqFlux = 0;
int seqProduitRuntime = 0; // compteur dedie aux identifiants Produit CMD_x_F_y (ne pas le melanger avec les flux/logs)
int seqResponsabilite = 0;
int seqMachineSim = 0;
int maxTraceRows = 5000;
java.util.ArrayList<TraceData> tracesBrutes = new java.util.ArrayList<TraceData>();
java.util.ArrayList<TraceData> tracesAgregees = new java.util.ArrayList<TraceData>();

// POUR LES MOVABLES 
Movable currentMovable;
public static final int TAILLE_POOL_MESSAGES = 25; // taille du pool de messages animes (viewAnimation)

// ============================================================
// OUTILS GENERIQUES POUR TABLEAUX TEXTUELS AVEC BORDURES
// A placer dans Main
// ============================================================

String rep(String s, int n) {
    StringBuilder sb = new StringBuilder();
    for (int i = 0; i < n; i++) sb.append(s);
    return sb.toString();
}

String safe(String s) {
    if (s == null) return "";
    return s.replace("\n", " ")
            .replace("\r", " ")
            .replace("\t", " ")
            .trim();
}

String fit(String s, int width) {
    s = safe(s);

    if (width <= 0) return "";

    if (s.length() > width) {
        if (width == 1) return s.substring(0, 1);
        return s.substring(0, width - 1) + ".";
    }

    StringBuilder sb = new StringBuilder(s);
    while (sb.length() < width) sb.append(" ");
    return sb.toString();
}

String fmt0(double v) {
    if (Double.isNaN(v) || Double.isInfinite(v)) return "-";
    return String.format(java.util.Locale.US, "%.0f", v);
}

String fmt1(double v) {
    if (Double.isNaN(v) || Double.isInfinite(v)) return "-";
    return String.format(java.util.Locale.US, "%.1f", v);
}

String fmt2(double v) {
    if (Double.isNaN(v) || Double.isInfinite(v)) return "-";
    return String.format(java.util.Locale.US, "%.2f", v);
}

String tableLine(int[] widths) {
    StringBuilder sb = new StringBuilder();
    sb.append("+");
    for (int w : widths) {
        sb.append(rep("-", w + 2)).append("+");
    }
    return sb.toString();
}

String tableRow(String[] values, int[] widths) {
    StringBuilder sb = new StringBuilder();
    sb.append("|");

    for (int i = 0; i < widths.length; i++) {
        String value = i < values.length ? values[i] : "";
        sb.append(" ").append(fit(value, widths[i])).append(" |");
    }

    return sb.toString();
}

String tableTitle(String title, int[] widths) {
    String line = tableLine(widths);
    int innerWidth = line.length() - 4;

    StringBuilder sb = new StringBuilder();
    sb.append(line).append("\n");
    sb.append("| ").append(fit(title, innerWidth)).append(" |\n");
    sb.append(line).append("\n");

    return sb.toString();
}

String fmt3(double v) {
    if (Double.isNaN(v) || Double.isInfinite(v)) return "-";
    return String.format(java.util.Locale.US, "%.3f", v);
}

// ── Utilitaire : extraire la première JTable d'un conteneur (récursif) ──
javax.swing.JTable extractTable(java.awt.Container container) {
    for (java.awt.Component comp : container.getComponents()) {
        if (comp instanceof javax.swing.JTable) return (javax.swing.JTable) comp;
        if (comp instanceof javax.swing.JScrollPane) {
            java.awt.Component view = ((javax.swing.JScrollPane) comp).getViewport().getView();
            if (view instanceof javax.swing.JTable) return (javax.swing.JTable) view;
        }
        if (comp instanceof java.awt.Container) {
            javax.swing.JTable found = extractTable((java.awt.Container) comp);
            if (found != null) return found;
        }
    }
    return null;
}

// ── Utilitaire : extraire le JTabbedPane d'un conteneur (récursif) ──
javax.swing.JTabbedPane findTabbedPane(java.awt.Container container) {
    for (java.awt.Component comp : container.getComponents()) {
        if (comp instanceof javax.swing.JTabbedPane) return (javax.swing.JTabbedPane) comp;
        if (comp instanceof java.awt.Container) {
            javax.swing.JTabbedPane found = findTabbedPane((java.awt.Container) comp);
            if (found != null) return found;
        }
    }
    return null;
}

// ============================================================
// MRP — NOMENCLATURE ET CALCUL DU BESOIN NET EN MATIERES (ajout)
// Besoin Net = Besoin Brut - Stock disponible - Receptions attendues + Stock de securite
// Calcule toutes les 15s par l'agent tactique Plan Source (idMacroProcessus="sS"),
// voir TacticalAgent.cycleArbitrage.
// ============================================================
public java.util.ArrayList<FicheMatiere> fichesMatiere = new java.util.ArrayList<FicheMatiere>();
// Compteur d'entites terminees, par produit (typeProduit). Alimente le calcul
// de la prevision de demande par produit (StrategicAgent.previsionParProduit).
public java.util.HashMap<String, Long> nbTerminesParProduit = new java.util.HashMap<String, Long>();

FicheMatiere trouverFicheMatiere(String idMatiere) {
    if (idMatiere == null) return null;
    String cle = idMatiere.trim();
    for (FicheMatiere f : fichesMatiere) {
        if (f.idMatiere.equalsIgnoreCase(cle)) return f;
    }
    return null;
}

// Cree la fiche si elle n'existe pas encore, sinon met a jour ses parametres
// (le stock disponible courant n'est ecrase que si la fiche est nouvelle,
// pour ne pas remettre un stock deja consomme/reapprovisionne a sa valeur
// de depart a chaque modification des autres parametres).
FicheMatiere ajouterOuMettreAJourFicheMatiere(String idMatiere, double stockInitial, double stockSecurite,
                                               double delaiObtentionHeures, String idFournisseur) {
    if (idMatiere == null || idMatiere.trim().isEmpty()) return null;
    FicheMatiere f = trouverFicheMatiere(idMatiere);
    boolean nouvelle = (f == null);
    if (f == null) {
        f = new FicheMatiere();
        f.idMatiere = idMatiere.trim();
        fichesMatiere.add(f);
    }
    if (nouvelle) f.stockDisponible = Math.max(0, stockInitial);
    f.stockSecurite = Math.max(0, stockSecurite);
    f.delaiObtentionHeures = Math.max(0, delaiObtentionHeures);
    f.idFournisseur = idFournisseur != null ? idFournisseur.trim() : "";
    return f;
}

void supprimerFicheMatiere(String idMatiere) {
    FicheMatiere f = trouverFicheMatiere(idMatiere);
    if (f != null) fichesMatiere.remove(f);
}

// Ajoute (ou met a jour) une ligne de nomenclature pour le scenario dont
// typeProduit == idProduit. Ne fait rien si le produit n'existe pas encore
// (l'utilisateur doit d'abord creer le scenario dans la vue Configuration).
boolean ajouterLigneNomenclature(String idProduit, String idMatiere, double quantiteParUnite) {
    if (idProduit == null || idMatiere == null || idMatiere.trim().isEmpty()) return false;
    ScenarioFlux sc = null;
    for (ScenarioFlux s : scenarios) {
        if (s.typeProduit.equalsIgnoreCase(idProduit.trim())) { sc = s; break; }
    }
    if (sc == null) return false;
    for (LigneNomenclature l : sc.nomenclature) {
        if (l.idMatiere.equalsIgnoreCase(idMatiere.trim())) {
            l.quantiteParUnite = quantiteParUnite;
            return true;
        }
    }
    sc.nomenclature.add(new LigneNomenclature(idMatiere.trim(), quantiteParUnite));
    return true;
}

void supprimerLigneNomenclature(String idProduit, String idMatiere) {
    if (idProduit == null || idMatiere == null) return;
    for (ScenarioFlux s : scenarios) {
        if (s.typeProduit.equalsIgnoreCase(idProduit.trim())) {
            java.util.Iterator<LigneNomenclature> it = s.nomenclature.iterator();
            while (it.hasNext()) {
                if (it.next().idMatiere.equalsIgnoreCase(idMatiere.trim())) it.remove();
            }
            return;
        }
    }
}

// Prevision de demande (entites/heure) du produit "idProduit" : lit la carte
// tenue par l'agent strategique (voir StrategicAgent.previsionParProduit),
// alimentee par le meme lissage exponentiel que la prevision globale.
double previsionDemandeProduit(String idProduit) {
    if (strategic == null || idProduit == null) return 0;
    Double v = strategic.previsionParProduit.get(idProduit);
    return v != null ? v : 0;
}

// Calcule, pour chaque matiere declaree, le besoin net et declenche un ordre
// d'approvisionnement (reception attendue) si ce besoin est positif.
void calculerBesoinsNets() {
    if (board == null || fichesMatiere.isEmpty()) return;

    // Horizon couvert par ce cycle de calcul : la duree ecoulee depuis le
    // dernier appel (15s habituellement, cf. TacticalAgent.cycleArbitrage),
    // convertie en heures pour etre homogene avec les previsions en entites/heure.
    double maintenant = time();
    double heuresEcoulees = (dernierCalculBesoinNet < 0) ? (15.0 / 3600.0)
        : Math.max(0.0, (maintenant - dernierCalculBesoinNet) / 3600.0);
    dernierCalculBesoinNet = maintenant;

    for (FicheMatiere f : fichesMatiere) {
        // 1. Faire arriver a echeance les receptions deja en cours
        double arrivee = f.traiterEcheances(maintenant);
        if (arrivee > 0) {
            board.logEvent("[MRP] Reception matiere " + f.idMatiere + " : +" + String.format("%.1f", arrivee)
                + " (stock=" + String.format("%.1f", f.stockDisponible) + ")");
        }

        // 2. Besoin brut = somme, sur tous les produits utilisant cette matiere,
        //    de (prevision du produit x quantite nomenclature x horizon du cycle)
        double besoinBrut = 0;
        for (ScenarioFlux sc : scenarios) {
            double qte = sc.quantitePour(f.idMatiere);
            if (qte > 0) {
                double prevision = previsionDemandeProduit(sc.typeProduit); // entites/heure
                besoinBrut += prevision * qte * heuresEcoulees;
            }
        }

        double receptionsAttendues = f.totalReceptionsAttendues();
        double besoinNet = besoinBrut - f.stockDisponible - receptionsAttendues + f.stockSecurite;

        // Tracabilite : toujours mise a jour, meme si le besoin net est negatif ou nul
        f.dernierBesoinBrut = besoinBrut;
        f.dernierStockDispo = f.stockDisponible;
        f.dernieresReceptionsAttendues = receptionsAttendues;
        f.dernierBesoinNet = besoinNet;
        f.dernierCalcul = maintenant;

        if (besoinNet > 0.0001) {
            double dateArrivee = maintenant + f.delaiObtentionHeures * 3600.0;
            ReceptionAttendue r = new ReceptionAttendue(besoinNet, dateArrivee);
            r.dateCommande = maintenant;
            f.receptionsAttendues.add(r);
            f.dernierOrdrePasse = besoinNet;
            board.logEvent("[MRP] Besoin net " + f.idMatiere + " = " + String.format("%.2f", besoinNet)
                + " -> ordre passe (arrivee prevue dans " + String.format("%.1f", f.delaiObtentionHeures) + "h)");
        } else {
            f.dernierOrdrePasse = 0;
        }
    }
}
double dernierCalculBesoinNet = -1;

// Decremente le stock des matieres consommees par une unite de "idProduit"
// traitee sur un poste marque consommeMatiere=true (voir PosteGenericAgent).
// Appele depuis l'action de sortie du poste (Exit.onExit).
void consommerMatieresPour(String idProduit) {
    if (idProduit == null) return;
    for (ScenarioFlux sc : scenarios) {
        if (!sc.typeProduit.equalsIgnoreCase(idProduit.trim())) continue;
        for (LigneNomenclature l : sc.nomenclature) {
            FicheMatiere f = trouverFicheMatiere(l.idMatiere);
            if (f != null) {
                double avant = f.stockDisponible;
                if (avant + 1e-9 < l.quantiteParUnite) {
                    ajouterSuiviDetaille(
                        "Alerte matiere",
                        "Stock matiere insuffisant pendant la production",
                        "Une micro-activite consomme une matiere dont le stock disponible est inferieur au besoin unitaire.",
                        "Agent operationnel de pilotage Make",
                        "Agent Machine / Agent Produit",
                        "Matiere " + l.idMatiere,
                        "Besoin=" + String.format("%.2f", l.quantiteParUnite) + " ; disponible=" + String.format("%.2f", avant),
                        "Stock matiere",
                        "Production Make",
                        "Stock matiere -> poste de fabrication",
                        "M1.3 / MRP",
                        "Continuer en mode degrade et signaler un besoin net.",
                        "Stock insuffisant",
                        "Stock consomme a zero",
                        "Besoin net ; rupture matiere ; risque retard"
                    );
                }
                f.stockDisponible = Math.max(0, f.stockDisponible - l.quantiteParUnite);
            }
        }
        return;
    }
}

// Rapport texte (config) : liste des fiches matiere et de leurs parametres
String getRapportFichesMatiereConfig() {
    if (fichesMatiere.isEmpty()) return "Aucune matière configurée.";
    StringBuilder sb = new StringBuilder();
    sb.append("═══ FICHES MATIÈRE CONFIGURÉES ═══\n\n");
    for (FicheMatiere f : fichesMatiere) {
        sb.append("▸ ").append(f.idMatiere).append("\n");
        sb.append("   Stock disponible   : ").append(String.format("%.1f", f.stockDisponible)).append("\n");
        sb.append("   Stock de sécurité  : ").append(String.format("%.1f", f.stockSecurite)).append("\n");
        sb.append("   Délai d'obtention  : ").append(String.format("%.1f", f.delaiObtentionHeures)).append(" h\n");
        sb.append("   Fournisseur        : ").append(f.idFournisseur.isEmpty() ? "(non lié)" : f.idFournisseur).append("\n\n");
    }
    return sb.toString();
}

// Rapport texte (execution) : dernier calcul de besoin net, matiere par matiere
String getRapportBesoinsMatieres() {
    if (fichesMatiere.isEmpty()) return "Aucune matière configurée.\n\nAllez dans Configuration > Configurer nomenclature pour en ajouter.";
    StringBuilder sb = new StringBuilder();
    sb.append("═══ BESOINS MATIÈRES (dernier calcul) ═══\n\n");
    for (FicheMatiere f : fichesMatiere) {
        sb.append("Matière : ").append(f.idMatiere).append("\n");
        sb.append("   Besoin brut          : ").append(String.format("%.2f", f.dernierBesoinBrut)).append("\n");
        sb.append("   Stock disponible     : ").append(String.format("%.2f", f.dernierStockDispo)).append("\n");
        sb.append("   Réceptions attendues : ").append(String.format("%.2f", f.dernieresReceptionsAttendues)).append("\n");
        sb.append("   Stock de sécurité    : ").append(String.format("%.2f", f.stockSecurite)).append("\n");
        sb.append("   ─────────────────────────────\n");
        sb.append("   BESOIN NET           : ").append(String.format("%.2f", f.dernierBesoinNet)).append("\n");
        sb.append("   Décision             : ").append(f.dernierOrdrePasse > 0
            ? ("Ordre passé (" + String.format("%.2f", f.dernierOrdrePasse) + ")") : "Aucun ordre").append("\n\n");
    }
    return sb.toString();
}

// ============================================================================
// ANIMATION VIEWANIMATION - CORRECTIONS DE PORTAGE ANCIENNE VERSION
// ============================================================================
// Ces méthodes complètent les Functions AnyLogic existantes sans remplacer la
// logique métier. Elles corrigent :
//  - la résolution stricte des noms dans puppets,
//  - l'alias ENTREPRISE -> entreprise focale,
//  - les flux informationnels visibles avant modeExecution,
//  - le portage générique des messages SP1->SP2/SP3/SP4/SP5,
//  - les véhicules sourcingTruck/deliveryTruck via Movable.type="Vehicle".
public boolean fluxInfoInitialDejaDeclenche = false;
// Coordonnees de presentation des agents statiques deja dessines dans viewAnimation.
// IMPORTANT : les agents fixes (AO/ASup/AT/AS) sont les vrais points d'ancrage.
// Les collections dynamiques ne doivent pas creer de nouveaux acteurs visuels.
public java.util.Map<String, double[]> puppetXY = new java.util.LinkedHashMap<String, double[]>();

String keyAnim(String s) {
    if (s == null) return "";
    String r = s.trim().replace('\u00A0', ' ');
    r = r.replaceAll("\\s+", " ");
    try {
        r = java.text.Normalizer.normalize(r, java.text.Normalizer.Form.NFD)
            .replaceAll("\\p{M}", "");
    } catch (Exception ignore) {}
    return r.toUpperCase(java.util.Locale.ROOT);
}

String normaliserCategorieActeur(String c) {
    String k = keyAnim(c);
    if (k.isEmpty()) return ActeurSC.ENTREPRISE_FOCALE;
    if (k.equals("FOURNISSEUR") || k.equals("SUPPLIER") || k.equals("SOURCE")) return ActeurSC.FOURNISSEUR;
    if (k.equals("ENTREPRISE") || k.equals("ENTREPRISE FOCALE") || k.equals("ENTREPRISE_FOCALE")
        || k.equals("FOCALE") || k.equals("MANUFACTURER") || k.equals("ENTREPRISE PRINCIPALE")) return ActeurSC.ENTREPRISE_FOCALE;
    if (k.equals("CLIENT") || k.equals("CUSTOMER") || k.equals("DELIVER")) return ActeurSC.CLIENT;
    if (k.equals("ACTEUR ANNEXE") || k.equals("ACTEUR_ANNEXE") || k.equals("ANNEXE")) return ActeurSC.ACTEUR_ANNEXE;
    return c == null ? ActeurSC.ENTREPRISE_FOCALE : c.trim().toUpperCase(java.util.Locale.ROOT);
}

void registerPuppetIfAbsent(String key, Movable m) {
    String k = keyAnim(key);
    if (k == null || k.isEmpty() || m == null) return;
    if (!puppets.containsKey(k)) puppets.put(k, m);
}


void registerPuppetAnchor(String key, Movable m, double x, double y) {
    String k = keyAnim(key);
    if (k == null || k.isEmpty() || m == null) return;
    if (!puppets.containsKey(k)) puppets.put(k, m);
    if (!puppetXY.containsKey(k)) puppetXY.put(k, new double[] { x, y });
}

void registerPuppetAnchorOverwrite(String key, Movable m, double x, double y) {
    String k = keyAnim(key);
    if (k == null || k.isEmpty() || m == null) return;
    puppets.put(k, m);
    puppetXY.put(k, new double[] { x, y });
}

double[] xyPuppet(String key) {
    // Priorite aux coordonnees reelles du Movable dans viewAnimation.
    // Cela evite que les messages/camions s'arretent sur d'anciennes
    // coordonnees codees en dur lorsque les icones ont ete deplacees.
    Movable m = puppet(key);
    if (m != null) return new double[] { m.getX(), m.getY() };

    String k = keyAnim(key);
    double[] xy = puppetXY.get(k);
    if (xy != null) return xy;

    return null;
}

void appliquerVitesseAnimation(Movable m, double vitesse) {
    if (m == null) return;
    try { m.getClass().getMethod("setSpeed", double.class).invoke(m, Math.max(1.0, vitesse)); } catch (Throwable ignored) {}
}

double dureeAnimationDepuisDistance(double distance, boolean vehicule) {
    double d = Math.max(0.001, distance);
    double vitesseReference = vehicule ? Math.max(1.0, vitesseAnimationVehicule) : Math.max(1.0, vitesseAnimationMessage);
    double minD = vehicule ? Math.max(1.0, dureeMinAnimationVehiculeSec) : Math.max(1.0, dureeMinAnimationMessageSec);
    double maxD = vehicule ? Math.max(minD, dureeMaxAnimationVehiculeSec) : Math.max(minD, dureeMaxAnimationMessageSec);
    double duree = d / vitesseReference;
    if (duree < minD) duree = minD;
    if (duree > maxD) duree = maxD;
    return duree;
}

double vitessePourRespecterDuree(double distance, double duree) {
    if (distance <= 0.001) return 1.0;
    return Math.max(1.0, distance / Math.max(0.1, duree));
}

