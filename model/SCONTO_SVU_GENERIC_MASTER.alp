public class FluxInformationnelAnime implements java.io.Serializable {
    public long ordre;
    public String emetteur;
    public String destinataire;
    public String sujet;
    public String info;

    public FluxInformationnelAnime(long ordre, String emetteur, String destinataire,
                                   String sujet, String info) {
        this.ordre = ordre;
        this.emetteur = emetteur == null ? "" : emetteur;
        this.destinataire = destinataire == null ? "" : destinataire;
        this.sujet = sujet == null ? "Message" : sujet;
        this.info = info == null ? "" : info;
    }
}

