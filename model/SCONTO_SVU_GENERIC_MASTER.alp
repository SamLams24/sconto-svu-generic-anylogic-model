				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1781647723528</Id>
					<Name><![CDATA[btnListePostes]]></Name>
					<X>930</X><Y>750</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="220" Height="30">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[StringBuilder sb = new StringBuilder();
sb.append("═══ MICRO-ACTIVITÉS CONFIGURÉES ═══\n\n");
sb.append("Total : ").append(postes.size()).append(" micro-activité(s)\n\n");
for (PosteGenericAgent p : postes) {
    sb.append("▸ ").append(p.idPoste)
      .append("  ").append(p.nom)
      .append("\n  Activité SCOR N3 : ").append(p.codeSCOR)
      .append("  |  Type : ").append(p.typePoste)
      .append("\n  Loi : ").append(p.loiTemps.distribution)
      .append("(").append(p.loiTemps.p1).append(", ").append(p.loiTemps.p2).append(")")
      .append("  |  Capacité : ").append(p.capaciteSimultanee)
      .append("\n");
}
getExperimentHost().showMessageDialog(sb.toString());]]></ActionCode>
					</BasicProperties>
					<ExtendedProperties>
						<Font Name="Dialog" Size="11" Style="1"/>
						<LabelText><![CDATA[Voir micro-activités configurées]]></LabelText>
					</ExtendedProperties>
				</Control>
