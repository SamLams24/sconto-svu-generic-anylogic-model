				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783600000010</Id>
					<Name><![CDATA[excelFileName]]></Name>
					<X>-440</X><Y>4560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// C14 : fichier de résultats corrélé au même runId que l'ABox.
String base = (nomEntreprise == null || nomEntreprise.trim().isEmpty()) ? "scenario" : nomEntreprise.trim();
base = base.replaceAll("[\s]+", "_")
           .replaceAll("[^a-zA-Z0-9_\\-]", "")
           .replaceAll("_+", "_");
if (base.isEmpty()) base = "scenario";
return "SCONTO_SVU_RESULTS_" + base + "_" + aboxEnsureRunId() + ".xlsx";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1783600000011</Id>
					<Name><![CDATA[estCelluleNumerique]]></Name>
					<X>-440</X><Y>4590</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[s]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Detecte les chaines produites par fmt0/1/2/3 ou String.valueOf(nombre)
// (format US : point decimal, jamais de separateur de milliers), pour les
// ecrire comme cellules NUMERIQUES Excel plutot que du texte. Les valeurs
// "-" (NaN/Infinite) et tout le reste (IDs, codes SCOR, texte libre) restent
// du texte.
if (s == null || s.isEmpty() || s.equals("-")) return false;
return s.matches("-?\\d+(\\.\\d+)?");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783600000012</Id>
					<Name><![CDATA[ecrireFeuilleExcel]]></Name>
					<X>-440</X><Y>4620</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[wb]]></Name>
						<Type><![CDATA[org.apache.poi.xssf.usermodel.XSSFWorkbook]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[styleEntete]]></Name>
						<Type><![CDATA[org.apache.poi.ss.usermodel.CellStyle]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[styleNormal]]></Name>
						<Type><![CDATA[org.apache.poi.ss.usermodel.CellStyle]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[nomFeuille]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[colonnes]]></Name>
						<Type><![CDATA[String[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lignes]]></Name>
						<Type><![CDATA[Object[][]]]></Type>
					</Parameter>
					<Body><![CDATA[org.apache.poi.ss.usermodel.Sheet sheet = wb.createSheet(nomFeuille);

// Ligne d'entete : reprend exactement les libelles longs deja definis dans
// les fonctions *Columns() existantes (aucune duplication de texte).
org.apache.poi.ss.usermodel.Row entete = sheet.createRow(0);
for (int c = 0; c < colonnes.length; c++) {
    org.apache.poi.ss.usermodel.Cell cell = entete.createCell(c);
    cell.setCellValue(colonnes[c]);
    cell.setCellStyle(styleEntete);
}
sheet.createFreezePane(0, 1);

// Lignes de donnees : reutilisation directe des *Rows() existantes.
// Detection numerique cellule par cellule pour un rendu Excel natif
// (nombres alignes a droite, triables, exploitables en formule/graphique).
for (int r = 0; r < lignes.length; r++) {
    org.apache.poi.ss.usermodel.Row row = sheet.createRow(r + 1);
    for (int c = 0; c < lignes[r].length && c < colonnes.length; c++) {
        Object val = lignes[r][c];
        String s = val == null ? "" : val.toString();
        org.apache.poi.ss.usermodel.Cell cell = row.createCell(c);
        if (estCelluleNumerique(s)) {
            cell.setCellValue(Double.parseDouble(s));
        } else {
            cell.setCellValue(s);
        }
        cell.setCellStyle(styleNormal);
    }
}

// Largeur automatique des colonnes, plafonnee (les commentaires longs de
// Decisions Holoniques ne doivent pas produire une colonne demesuree).
for (int c = 0; c < colonnes.length; c++) {
    try {
        sheet.autoSizeColumn(c);
        int largeurMax = 60 * 256;
        if (sheet.getColumnWidth(c) > largeurMax) sheet.setColumnWidth(c, largeurMax);
    } catch (Exception ignore) {
        // autoSizeColumn peut echouer selon l'environnement graphique : sans consequence,
        // la feuille reste exploitable avec une largeur de colonne par defaut.
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1783600000013</Id>
					<Name><![CDATA[exporterToutesLesTablesExcel]]></Name>
					<X>-440</X><Y>4650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Export periodique automatique des feuilles analytiques vers un classeur .xlsx
// unique. Reutilise directement les paires *Columns()/*Rows() qui
// alimentent deja les JTable Swing : aucune logique de collecte de donnees
// n'est dupliquee ici, seule la destination de sortie change.
//
// Ecriture en fichier temporaire puis renommage atomique : si Excel a le
// fichier final ouvert au moment de l'export, le renommage (ou la copie de
// repli) echoue proprement et est journalise sans jamais interrompre la
// simulation ; l'export suivant reessaiera au prochain cycle.

String cheminFinal = excelFileName();
String cheminTemp = cheminFinal + ".tmp";

org.apache.poi.xssf.usermodel.XSSFWorkbook wb = null;
java.io.FileOutputStream fos = null;

try {
    wb = new org.apache.poi.xssf.usermodel.XSSFWorkbook();

    org.apache.poi.ss.usermodel.CellStyle styleEntete = wb.createCellStyle();
    org.apache.poi.ss.usermodel.Font policeEntete = wb.createFont();
    policeEntete.setBold(true);
    policeEntete.setColor(org.apache.poi.ss.usermodel.IndexedColors.WHITE.getIndex());
    styleEntete.setFont(policeEntete);
    styleEntete.setFillForegroundColor(org.apache.poi.ss.usermodel.IndexedColors.DARK_BLUE.getIndex());
    styleEntete.setFillPattern(org.apache.poi.ss.usermodel.FillPatternType.SOLID_FOREGROUND);
    styleEntete.setWrapText(true);
    styleEntete.setVerticalAlignment(org.apache.poi.ss.usermodel.VerticalAlignment.CENTER);

    org.apache.poi.ss.usermodel.CellStyle styleNormal = wb.createCellStyle();
    styleNormal.setVerticalAlignment(org.apache.poi.ss.usermodel.VerticalAlignment.TOP);
    styleNormal.setWrapText(false);

    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Synthèse C14", syntheseFinaleS1Columns(), syntheseFinaleS1Rows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Multi-produit ZENER", multiProduitZenerColumns(), multiProduitZenerRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Architecture agents", architectureAgentsColumns(), architectureAgentsRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Performance par produit", performanceProduitColumns(), performanceProduitRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Acteurs", acteursChaineColumns(), acteursChaineRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Micro-Activites", microActivitesColumns(), microActivitesRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Responsabilites", responsabilitesColumns(), responsabilitesRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Machines", machinesColumns(), machinesRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "KPI par Poste", kpiParPosteColumns(), kpiParPosteRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Execution Brute", executionBruteColumns(), executionBruteRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Traces Agregees", tracesAgregeesColumns(), tracesAgregeesRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Dashboard Micro", dashboardMicroColumns(), dashboardMicroRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Dashboard Macro", dashboardMacroColumns(), dashboardMacroRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Dashboard Global", dashboardGlobalColumns(), dashboardGlobalRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Manifeste Run", manifesteRunColumns(), manifesteRunRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Historique Dashboard", historiqueDashboardColumns(), historiqueDashboardRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Pipeline SCOR vers PI", n3ToN1Columns(), n3ToN1Rows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Traçabilité performance", piTraceabilityColumns(), piTraceabilityRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Couverture métriques SCOR", piCoverageColumns(), piCoverageRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Validation C13-C14", nonRegressionColumns(), nonRegressionRows());

    // Feuilles internes de développement.
    // Pour la version de présentation aux supérieurs, elles restent désactivées par défaut
    // afin que l'export final conserve uniquement les feuilles de preuve métier.
    boolean exporterFeuillesInternesDev = false; // export final presentation : feuilles internes masquees
    if (exporterFeuillesInternesDev) {
        ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Documentation S1.5", documentationS15Columns(), documentationS15Rows());
    }

    // Catalogue officiel des 139 métriques SCOR/AHP.
    // Sécurisation : cette feuille ne doit jamais bloquer l'export complet.
    // Si une formule de simulation échoue, on exporte au minimum une ligne d'erreur
    // explicite au lieu de réutiliser silencieusement un ancien fichier Excel.
    try {
        ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Catalogue SCOR (139)", catalogueMetriquesAHPColumns(), catalogueMetriquesAHPRows());
    } catch (Throwable exCatalogue) {
        Object[][] fallbackCatalogue = new Object[][] {
            new Object[] {
                "ERREUR",
                "CATALOGUE",
                "Catalogue SCOR (139)",
                "Le catalogue n'a pas pu être généré pendant cet export",
                "-",
                "-",
                "-",
                "Erreur export catalogue",
                "Non calculée",
                "-",
                exCatalogue.getMessage()
            }
        };
        ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Catalogue SCOR (139)", catalogueMetriquesAHPColumns(), fallbackCatalogue);
        board.logEvent("[EXCEL WARN] Catalogue SCOR (139) exporté en mode fallback : " + exCatalogue.getMessage());
    }

    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Métriques SCOR calculables", metriquesSCORCalculablesColumns(), metriquesSCORCalculablesRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Flux Supply Chain", fluxSupplyChainColumns(), fluxSupplyChainRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Propagation agents et flux", fluxHierarchiqueColumns(), fluxHierarchiqueRows());
    ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Decisions Holoniques", decisionsHoloniquesColumns(), decisionsHoloniquesRows());
    try {
        ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Audit propagation AER", aerPropagationColumns(), aerPropagationRows());
    } catch (Throwable exAER) {
        Object[][] fallbackAER = new Object[][] {
            new Object[] {
                "Export de l'audit AER",
                "Erreur export — feuille de secours générée",
                exAER.getMessage(),
                "L'export des autres feuilles reste valide ; la validation AER doit être relancée après correction.",
                "Lire la feuille Décisions Holoniques et vérifier les logs AER."
            }
        };
        ecrireFeuilleExcel(wb, styleEntete, styleNormal, "Audit propagation AER", aerPropagationColumns(), fallbackAER);
        if (board != null) board.logEvent("[EXCEL WARN] Audit propagation AER exporté en mode fallback : " + exAER.getMessage());
    }

    fos = new java.io.FileOutputStream(cheminTemp);
    wb.write(fos);
    fos.close();
    fos = null;

    java.io.File fTemp = new java.io.File(cheminTemp);
    java.io.File fFinal = new java.io.File(cheminFinal);
    boolean ok = false;
    if (fFinal.exists()) {
        ok = fFinal.delete() && fTemp.renameTo(fFinal);
    } else {
        ok = fTemp.renameTo(fFinal);
    }
    if (!ok) {
        java.nio.file.Files.copy(fTemp.toPath(), fFinal.toPath(),
            java.nio.file.StandardCopyOption.REPLACE_EXISTING);
        fTemp.delete();
    }

    nbExportsExcelRealises++;
    messageStatutExcel = "Export Excel #" + nbExportsExcelRealises + " reussi a t=" + fmt1(time()) + "s -> " + cheminFinal;
    board.logEvent("[EXCEL] " + messageStatutExcel);

} catch (Exception ex) {
    messageStatutExcel = "Erreur export Excel a t=" + fmt1(time()) + "s : " + ex.getMessage();
    board.logEvent("[EXCEL ERROR] " + messageStatutExcel);
} finally {
    try { if (fos != null) fos.close(); } catch (Exception ignore) {}
    try { if (wb != null) wb.close(); } catch (Exception ignore) {}
}]]></Body>
				</Function>
