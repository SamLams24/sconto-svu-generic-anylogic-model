					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String id = idPosteDepuisSelection();
if (id.isEmpty()) {
    messageStatut = "ERREUR : selectionnez un poste dans la liste.";
    return;
}
if (champScenarioSeq == null || champScenarioSeq.trim().isEmpty()) {
    champScenarioSeq = id;
} else {
    champScenarioSeq = champScenarioSeq.trim() + "," + id;
}
messageStatut = "Sequence en cours : " + champScenarioSeq;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
