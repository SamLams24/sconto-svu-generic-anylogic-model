					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {24, 18, 14, 14, 14, 18, 12, 12};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "DASHBOARD — SYNTHESE GLOBALE DE LA SIMULATION",
        w
    ));

    sb.append(tableRow(new String[]{
        "Perimetre",
        "Nb entites finies",
        "CT moy (s)",
        "WT moy (s)",
        "LT moy (s)",
        "PCE % (avec taux VA)",
        "Rebuts",
        "Rework"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    KPIBundle g = board.kpiGlobal;

    sb.append(tableRow(new String[]{
        "Ensemble du systeme",
        String.valueOf(g.count),
        fmt2(g.avgCycleTime()),
        fmt2(g.avgWaitTime()),
        fmt2(g.avgLeadTime()),
        fmt1(g.pce() * 100),
        String.valueOf(board.totalRebuts),
        String.valueOf(board.totalRework)
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    return sb.toString();]]></Body>
