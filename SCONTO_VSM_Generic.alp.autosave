				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781968000002</Id>
					<Name><![CDATA[dashboardMicroRows]]></Name>
					<X>-440</X><Y>4070</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (postes == null || postes.isEmpty()) {
    return emptyRows("Aucune micro-activité configurée", dashboardMicroColumns().length);
}

Object[][] rows = new Object[postes.size()][dashboardMicroColumns().length];

for (int i = 0; i < postes.size(); i++) {
    PosteGenericAgent p = postes.get(i);

    KPIBundle k = null;
    if (board.kpiParMicroActivite != null) {
        k = board.kpiParMicroActivite.get(p.idPoste);
    }
    if (k == null) {
        k = board.kpiParPoste.get(cleKPI(p));
    }

    long n = k != null ? k.count : 0;
    double ct = k != null ? k.avgCycleTime() : 0;
    double wt = k != null ? k.avgWaitTime() : 0;
    double lt = k != null ? k.avgLeadTime() : 0;
    double pce = k != null ? k.pce() * 100 : 0;
    long reb = k != null ? k.nbRebut : 0;
    long rew = k != null ? k.nbRework : 0;

    int file = 0;
    try {
        file = p.queue.size();
    } catch (Exception ex) {
        file = 0;
    }

    rows[i][0] = p.idPoste;
    rows[i][1] = p.nom;
    rows[i][2] = p.codeSCOR;
    rows[i][3] = String.valueOf(n);
    rows[i][4] = fmt2(ct);
    rows[i][5] = fmt2(wt);
    rows[i][6] = fmt2(lt);
    rows[i][7] = fmt1(pce);
    rows[i][8] = String.valueOf(file);
    rows[i][9] = String.valueOf(reb);
    rows[i][10] = String.valueOf(rew);
}

return rows;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
