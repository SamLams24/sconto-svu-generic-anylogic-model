					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1781964000001</Id>
					<Name><![CDATA[machinesColumns]]></Name>
					<X>-440</X><Y>3640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Identifiant machine",
    "Nom de la machine",
    "Identifiant du poste affecte",
    "Nom de la micro-activite affectee",
    "Agent operationnel lie",
    "Type de machine",
    "Capacite (unites simultanees)",
    "Temps de cycle (secondes)",
    "MTBF - temps moyen entre pannes (secondes)",
    "MTTR - temps moyen de reparation (secondes)",
    "Disponibilite theorique = MTBF/(MTBF+MTTR)"
};]]></Body>
