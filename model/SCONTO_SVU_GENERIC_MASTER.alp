				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781969000002</Id>
					<Name><![CDATA[n3ToN1Rows]]></Name>
					<X>-440</X><Y>4290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[strategic.calculerPIGlobal();
java.util.ArrayList<Object[]> rows=new java.util.ArrayList<Object[]>();
String[] attrs={"RL","RS","AG","CO","AM"};
initialiserProfilsNormalisationDefaut();
for(String attr:attrs){
    java.util.ArrayList<MetriqueN3> lst=strategic.detailN3.get(attr); if(lst==null)continue;
    for(MetriqueN3 m:lst){ if(m==null)continue;
        String code=m.codeOfficielSCOR==null?"":m.codeOfficielSCOR.trim();
        NormalizationProfile np=normalizationProfiles.get(code.toUpperCase(java.util.Locale.ROOT));
        String scale=np==null?"NON CALIBRE":fmt3(np.bottom())+" -> "+fmt3(np.perfect());
        String source=code.isEmpty()?"Indicateur interne":sourceFormuleMetriqueSCOR(code);
        rows.add(new Object[]{attr,m.nom,(code.isEmpty()?"INTERNE":code)+(m.niveauSCOR>0?" / N"+m.niveauSCOR:""),
            fmt3(m.valeurBrute),m.unite,scale,fmt3(m.score10),m.fuzzyGrades==null?"-":m.fuzzyGrades.compact(),fmt3(m.poids),
            m.fuzzyGrades==null?"-":m.fuzzyGrades.ponderer(m.poids).compact(),source});
    }
}
if(rows.isEmpty())return emptyRows("Aucune metrique contributive au pipeline de performance",n3ToN1Columns().length);
return rows.toArray(new Object[0][]);]]></Body>
