						<ActionCode><![CDATA[if (champMatiereIdFiche == null || champMatiereIdFiche.trim().isEmpty()) {
    getExperimentHost().showMessageDialog("⚠️ Veuillez renseigner le nom de la matière.");
} else {
    ajouterOuMettreAJourFicheMatiere(champMatiereIdFiche, champMatiereStockInitial,
        champMatiereStockSecurite, champMatiereDelaiObtention, extraireIdFournisseurDepuisCombo(champMatiereFournisseur));
    getExperimentHost().showMessageDialog("✅ Fiche matière enregistrée : " + champMatiereIdFiche);
}]]></ActionCode>
