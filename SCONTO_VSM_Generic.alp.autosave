				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782600000020</Id>
					<Name><![CDATA[clearScenarioBeforeJsonLoad]]></Name>
					<X>-300</X><Y>950</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Nettoie proprement tout l'état avant chargement JSON
// 1. Stopper le mode exécution
modeExecution = false;

// 2. Supprimer les OperationalAgents dynamiques
while (opAgents.size() > 0) remove_opAgents(opAgents.get(opAgents.size() - 1));

// 3. Supprimer les postes
while (postes.size() > 0) remove_postes(postes.get(postes.size() - 1));

// 4. Vider les listes
scenarios.clear();
acteursSC.clear();
responsabilitesMicro.clear();
machinesSim.clear();
fichesMatiere.clear();

// 5. Vider les logs de flux (conserver les structures, juste vider)
if (fluxLogs != null) fluxLogs.clear();
if (tracesBrutes != null) tracesBrutes.clear();
if (tracesAgregees != null) tracesAgregees.clear();

// 6. Remettre les compteurs séquentiels
seqFlux          = 0;
seqResponsabilite = 0;
seqMachineSim    = 0;
seqTrace         = 0;

// 7. Réinitialiser les KPI courants
nbTermines = 0;
waitingTime = 0;
kpi_PI = 0; kpi_RL_score = 0; kpi_RS_score = 0;
kpi_AG_score = 0; kpi_CO_score = 0; kpi_AM_score = 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782600000021</Id>
					<Name><![CDATA[sauverScenarioJSON]]></Name>
					<X>-300</X><Y>960</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    String fichier = scenarioJsonFileName();
    java.util.Map<String,Object> root = new java.util.LinkedHashMap<String,Object>();

    // ── 1. Métadonnées ─────────────────────────────────────────────
    java.util.Map<String,Object> meta = new java.util.LinkedHashMap<String,Object>();
    meta.put("schemaVersion", "1.0");
    meta.put("modelName", "SCONTO_VSM_Generic");
    meta.put("javaPackageName", "sconto_vsm_generic");
    meta.put("createdAt", new java.util.Date().toString());
    meta.put("updatedAt", new java.util.Date().toString());
    meta.put("nomEntreprise", nomEntreprise);
    meta.put("nbActeurs", acteursSC.size());
    meta.put("nbPostes", postes.size());
    meta.put("nbScenarios", scenarios.size());
    meta.put("nbResponsabilites", responsabilitesMicro.size());
    meta.put("nbMachines", machinesSim.size());
    root.put("meta", meta);

    // ── 2. Paramètres globaux ──────────────────────────────────────
    java.util.Map<String,Object> params = new java.util.LinkedHashMap<String,Object>();
    params.put("nomEntreprise", nomEntreprise);
    params.put("champDebit", champDebit);
    params.put("chiffreAffaireParUnite", chiffreAffaireParUnite);
    params.put("champCoutHoraireMainOeuvre", champCoutHoraireMainOeuvre);
    params.put("champCoutMatierePremiereParUnite", champCoutMatierePremiereParUnite);
    params.put("champValeurActifFixe", champValeurActifFixe);
    params.put("champDelaiPaiementJours", champDelaiPaiementJours);
    params.put("champPoidsRL", champPoidsRL);
    params.put("champPoidsRS", champPoidsRS);
    params.put("champPoidsAG", champPoidsAG);
    params.put("champPoidsCO", champPoidsCO);
    params.put("champPoidsAM", champPoidsAM);
    params.put("seqFlux", seqFlux);
    params.put("seqResponsabilite", seqResponsabilite);
    params.put("seqMachineSim", seqMachineSim);
    params.put("seqTrace", seqTrace);
    root.put("parametresGlobaux", params);

    // ── 3. Acteurs ─────────────────────────────────────────────────
    java.util.List<Object> lstActeurs = new java.util.ArrayList<Object>();
    for (ActeurSC a : acteursSC) lstActeurs.add(acteurToJson(a));
    root.put("acteurs", lstActeurs);

    // ── 4. Postes / micro-activités ────────────────────────────────
    java.util.List<Object> lstPostes = new java.util.ArrayList<Object>();
    for (PosteGenericAgent p : postes) lstPostes.add(posteToJson(p));
    root.put("postes", lstPostes);

    // ── 5. Scénarios ───────────────────────────────────────────────
    java.util.List<Object> lstScenarios = new java.util.ArrayList<Object>();
    for (ScenarioFlux sc : scenarios) lstScenarios.add(scenarioToJson(sc));
    root.put("scenarios", lstScenarios);

    // ── 6. Responsabilités ─────────────────────────────────────────
    java.util.List<Object> lstResp = new java.util.ArrayList<Object>();
    for (MicroResponsabilite r : responsabilitesMicro) lstResp.add(responsabiliteToJson(r));
    root.put("responsabilites", lstResp);

    // ── 7. Machines ────────────────────────────────────────────────
    java.util.List<Object> lstMachines = new java.util.ArrayList<Object>();
    for (MachineSim mac : machinesSim) lstMachines.add(machineToJson(mac));
    root.put("machines", lstMachines);
    
    // ── 8. Fiches matière (MRP) ─────────────────────────────────────
java.util.List<Object> lstFiches = new java.util.ArrayList<Object>();
for (FicheMatiere f : fichesMatiere) {
    java.util.Map<String,Object> fm = new java.util.LinkedHashMap<String,Object>();
    fm.put("idMatiere", f.idMatiere);
    fm.put("stockDisponible", f.stockDisponible);
    fm.put("stockSecurite", f.stockSecurite);
    fm.put("delaiObtentionHeures", f.delaiObtentionHeures);
    fm.put("idFournisseur", f.idFournisseur != null ? f.idFournisseur : "");
    lstFiches.add(fm);
}
root.put("fichesMatiere", lstFiches);

    // ── Écriture JSON ──────────────────────────────────────────────
    String json = SimpleJsonWriter.toJson(root, 0);
    java.io.PrintWriter pw = new java.io.PrintWriter(
        new java.io.OutputStreamWriter(
            new java.io.FileOutputStream(fichier), java.nio.charset.StandardCharsets.UTF_8));
    pw.print(json);
    pw.close();

    messageStatut = "Config JSON sauvée : " + fichier;
    getExperimentHost().showMessageDialog(
        "✅ Configuration JSON sauvegardée\n\n"
        + "Fichier : " + fichier + "\n"
        + "Acteurs          : " + acteursSC.size() + "\n"
        + "Micro-activités  : " + postes.size() + "\n"
        + "Responsabilités  : " + responsabilitesMicro.size() + "\n"
        + "Machines         : " + machinesSim.size() + "\n"
        + "Scénarios        : " + scenarios.size()
    );

} catch (Exception ex) {
    messageStatut = "Erreur sauvegarde JSON : " + ex.getMessage();
    getExperimentHost().showMessageDialog(
        "❌ Erreur de sauvegarde JSON\n\n" + ex.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782600000022</Id>
					<Name><![CDATA[chargerScenarioJSON]]></Name>
					<X>-300</X><Y>970</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    String fichier = scenarioJsonFileName();

    // ── 1. Lecture du fichier JSON ──────────────────────────────────
    java.io.InputStream is = new java.io.FileInputStream(fichier);
    java.io.BufferedReader br = new java.io.BufferedReader(
        new java.io.InputStreamReader(is, java.nio.charset.StandardCharsets.UTF_8));
    StringBuilder sb = new StringBuilder();
    String ligne;
    while ((ligne = br.readLine()) != null) sb.append(ligne).append("\n");
    br.close();
    String jsonText = sb.toString().trim();

    // ── 2. Parsing JSON ────────────────────────────────────────────
    java.util.Map<String,Object> root = SimpleJsonParser.parse(jsonText);

    // ── 3. Vérification schemaVersion ──────────────────────────────
    Object metaObj = root.get("meta");
    if (metaObj instanceof java.util.Map) {
        java.util.Map meta = (java.util.Map) metaObj;
        String sv = jsonString(meta, "schemaVersion", "");
        if (!sv.equals("1.0")) {
            getExperimentHost().showMessageDialog(
                "⚠️ Version de schéma non reconnue : " + sv +
                "\nLe chargement peut être incomplet.");
        }
    }

    // ── 4. Bloquer si simulation en cours ──────────────────────────
    if (modeExecution) {
        getExperimentHost().showMessageDialog(
            "⚠️ Impossible de charger : la simulation est en cours.\n" +
            "Arrêtez la simulation d'abord (bouton Arrêter).");
        return;
    }

    // ── 5. Nettoyage complet de l'état courant ─────────────────────
    clearScenarioBeforeJsonLoad();

    // ── 6. Paramètres globaux ──────────────────────────────────────
    Object paramsObj = root.get("parametresGlobaux");
    if (paramsObj instanceof java.util.Map) {
        java.util.Map pg = (java.util.Map) paramsObj;
        nomEntreprise                  = jsonString(pg, "nomEntreprise", nomEntreprise);
        champDebit                     = jsonDouble(pg, "champDebit", champDebit);
        chiffreAffaireParUnite         = jsonDouble(pg, "chiffreAffaireParUnite", chiffreAffaireParUnite);
        champCoutHoraireMainOeuvre     = jsonDouble(pg, "champCoutHoraireMainOeuvre", champCoutHoraireMainOeuvre);
        champCoutMatierePremiereParUnite = jsonDouble(pg, "champCoutMatierePremiereParUnite", champCoutMatierePremiereParUnite);
        champValeurActifFixe           = jsonDouble(pg, "champValeurActifFixe", champValeurActifFixe);
        champDelaiPaiementJours        = jsonDouble(pg, "champDelaiPaiementJours", champDelaiPaiementJours);
        champPoidsRL                   = jsonDouble(pg, "champPoidsRL", champPoidsRL);
        champPoidsRS                   = jsonDouble(pg, "champPoidsRS", champPoidsRS);
        champPoidsAG                   = jsonDouble(pg, "champPoidsAG", champPoidsAG);
        champPoidsCO                   = jsonDouble(pg, "champPoidsCO", champPoidsCO);
        champPoidsAM                   = jsonDouble(pg, "champPoidsAM", champPoidsAM);
        // Restauration des compteurs
        seqFlux           = jsonInt(pg, "seqFlux", 0);
        seqResponsabilite = jsonInt(pg, "seqResponsabilite", 0);
        seqMachineSim     = jsonInt(pg, "seqMachineSim", 0);
        seqTrace          = (long) jsonDouble(pg, "seqTrace", 0.0);
    }

    // ── 7. Acteurs ─────────────────────────────────────────────────
    Object acteursObj = root.get("acteurs");
    if (acteursObj instanceof java.util.List) {
        for (Object ao : (java.util.List) acteursObj) {
            if (ao instanceof java.util.Map) {
                try { acteursSC.add(acteurFromJson((java.util.Map) ao)); }
                catch (Exception ex) { board.logEvent("[JSON WARN] acteur ignoré : " + ex.getMessage()); }
            }
        }
    }

    // ── 8. Postes — 1re passe : création ───────────────────────────
    java.util.List postesJson = new java.util.ArrayList();
    Object postesObj = root.get("postes");
    if (postesObj instanceof java.util.List) postesJson = (java.util.List) postesObj;

    for (Object po : postesJson) {
        if (!(po instanceof java.util.Map)) continue;
        java.util.Map pm = (java.util.Map) po;
        try {
            PosteGenericAgent p = add_postes();
            p.idPoste = jsonString(pm, "idPoste", "");
            p.nom     = jsonString(pm, "nom", "");
            p.codeSCOR= jsonString(pm, "codeSCOR", "");
            String tpStr = jsonString(pm, "typePoste", "TRAITEMENT");
            try { p.typePoste = TypePoste.valueOf(tpStr); }
            catch (Exception ex) { p.typePoste = TypePoste.DELAI; }
            // LoiTemps
            Object ltObj = pm.get("loiTemps");
            if (ltObj instanceof java.util.Map) {
                java.util.Map lt = (java.util.Map) ltObj;
                String dist = jsonString(lt, "distribution", "uniform");
                double p1   = jsonDouble(lt, "p1", 1.0);
                double p2   = jsonDouble(lt, "p2", 1.0);
                double p3   = jsonDouble(lt, "p3", 1.0);
                p.loiTemps = new LoiTemps(dist, p1, p2);
                p.loiTemps.p3 = p3;
            } else {
                p.loiTemps = new LoiTemps("uniform", 1.0, 1.0);
            }
            p.capaciteSimultanee          = jsonInt(pm, "capaciteSimultanee", 1);
            p.niveauStock                 = jsonDouble(pm, "niveauStock", 0.0);
            p.chainesPrecedents           = jsonString(pm, "chainesPrecedents", "");
            p.estUnPosteAlternatif        = jsonBool(pm, "estUnPosteAlternatif", false);
            p.idActeurResponsable         = jsonString(pm, "idActeurResponsable", "");
            p.nomActeurResponsable        = jsonString(pm, "nomActeurResponsable", "");
            p.categorieActeurResponsable  = jsonString(pm, "categorieActeurResponsable", "");
            p.typeAnnexeActeurResponsable = jsonString(pm, "typeAnnexeActeurResponsable", "");
            // RegleAiguillage
            Object raObj = pm.get("regleAiguillage");
            if (raObj instanceof java.util.Map) {
                java.util.Map ra = (java.util.Map) raObj;
                String tc    = jsonString(ra, "typeControle", "conformite");
                double taux  = jsonDouble(ra, "tauxTrue", 1.0);
                String cible = jsonString(ra, "idCibleEchec", "");
                p.regleAiguillage = new RegleAiguillage(tc, taux, cible.isEmpty() ? null : cible);
            }
            p.niveauISA95              = jsonString(pm, "niveauISA95", "");
            p.politiqueStock           = jsonString(pm, "politiqueStock", "");
            p.tauxVA                   = jsonDouble(pm, "tauxVA", 1.0);
            p.coutHoraireMainOeuvre    = jsonDouble(pm, "coutHoraireMainOeuvre", 0.0);
            p.coutMatierePremiereParUnite = jsonDouble(pm, "coutMatierePremiereParUnite", 0.0);
            p.valeurActifFixe          = jsonDouble(pm, "valeurActifFixe", 0.0);
            p.idsResponsabilites       = jsonStringList(pm, "idsResponsabilites");
            p.idsOperationalAgents     = jsonStringList(pm, "idsOperationalAgents");
            p.idsMachines              = jsonStringList(pm, "idsMachines");

            // Nouveaux champs (génère/attend, batch, jonction multi-amont, position manuelle) —
            // valeurs par défaut = comportement historique si absent du JSON (retro-compatible).
            p.genereAutonome           = jsonBool(pm, "genereAutonome", false);
            p.politiqueApproPoste      = jsonString(pm, "politiqueApproPoste", "");
            p.intervalleApproPoste     = jsonDouble(pm, "intervalleApproPoste", 0.0);
            p.tauxArriveePoissonPoste  = jsonDouble(pm, "tauxArriveePoissonPoste", 0.0);
            p.quantiteParApproPoste    = jsonDouble(pm, "quantiteParApproPoste", 1.0);
            p.attendTousLesPredecesseurs = jsonBool(pm, "attendTousLesPredecesseurs", false);
            int tailleLotJson          = jsonInt(pm, "tailleLot", 1);
            p.tailleLot                = Math.max(1, tailleLotJson);
            if (p.attendTousLesPredecesseurs) {
                int nbParents = 1;
                if (p.chainesPrecedents != null && !p.chainesPrecedents.trim().isEmpty()) {
                    nbParents = Math.max(1, p.chainesPrecedents.split(",").length);
                }
                p.tailleLot = nbParents;
            }
            p.positionManuelle         = jsonBool(pm, "positionManuelle", false);
            p.xManuel                  = jsonDouble(pm, "xManuel", 0.0);
            p.yManuel                  = jsonDouble(pm, "yManuel", 0.0);
            p.estPointEclatement       = jsonBool(pm, "estPointEclatement", false);
            p.consommeMatiere = jsonBool(pm, "consommeMatiere", false);
            p.nbProduitsParLot         = jsonInt(pm, "nbProduitsParLot", 1);
            p.mtbfHeures               = jsonDouble(pm, "mtbfHeures", 0.0);
            p.mttrHeures               = jsonDouble(pm, "mttrHeures", 0.0);

            // Rattacher l'acteur responsable
            ActeurSC aResp = trouverActeurParId(p.idActeurResponsable);
            if (aResp != null) aResp.ajouterMicroActivite(p.idPoste);

            // Positionner
            positionnerPoste(p);

            // Créer le OperationalAgent jumelé (holarchie ADACOR)
            OperationalAgent op = add_opAgents();
            op.initialiser(p, p.codeSCOR);
            if (!p.idsOperationalAgents.contains(op.idAgentLogique)) {
                p.idsOperationalAgents.add(op.idAgentLogique);
            }
            board.logEvent("[JSON-LOAD] Poste créé : " + p.idPoste + " / " + p.nom);

        } catch (Exception ex) {
            board.logEvent("[JSON WARN] poste ignoré : " + ex.getMessage());
        }
    }

    // ── 9. Postes — 2e passe : connexions chainesPrecedents ────────
    // Recherche par idPoste OU par nom (les deux formats sont acceptés)
    for (PosteGenericAgent p : postes) {
        if (p.chainesPrecedents == null || p.chainesPrecedents.trim().isEmpty()) continue;
        String[] parents = p.chainesPrecedents.split(",");
        for (String idParent : parents) {
            idParent = idParent.trim();
            if (idParent.isEmpty()) continue;
            // 1) Recherche par idPoste (format JSON produit par code)
            PosteGenericAgent parent = trouverPosteParNomOuId(idParent);
            if (parent != null) {
                try { p.connectTo(parent); }
                catch (Exception ex) { board.logEvent("[JSON WARN] connexion impossible " + idParent + " -> " + p.idPoste); }
            } else {
                board.logEvent("[JSON WARN] parent introuvable : " + idParent + " pour poste " + p.idPoste);
            }
        }
    }

    // ── 10. Scénarios ───────────────────────────────────────────────
    Object scenObj = root.get("scenarios");
    if (scenObj instanceof java.util.List) {
        for (Object so : (java.util.List) scenObj) {
            if (so instanceof java.util.Map) {
                try { scenarios.add(scenarioFromJson((java.util.Map) so)); }
                catch (Exception ex) { board.logEvent("[JSON WARN] scénario ignoré : " + ex.getMessage()); }
            }
        }
    }

	// ── 10bis. Fiches matière (MRP) ──────────────────────────────────
Object fichesObj = root.get("fichesMatiere");
if (fichesObj instanceof java.util.List) {
    for (Object fo : (java.util.List) fichesObj) {
        if (fo instanceof java.util.Map) {
            java.util.Map fm = (java.util.Map) fo;
            try {
                FicheMatiere f = new FicheMatiere();
                f.idMatiere = jsonString(fm, "idMatiere", "");
                f.stockDisponible = jsonDouble(fm, "stockDisponible", 0.0);
                f.stockSecurite = jsonDouble(fm, "stockSecurite", 0.0);
                f.delaiObtentionHeures = jsonDouble(fm, "delaiObtentionHeures", 0.0);
                f.idFournisseur = jsonString(fm, "idFournisseur", "");
                fichesMatiere.add(f);
            } catch (Exception ex) { board.logEvent("[JSON WARN] fiche matière ignorée : " + ex.getMessage()); }
        }
    }
}
    // ── 11. Responsabilités ─────────────────────────────────────────
    Object respObj = root.get("responsabilites");
    if (respObj instanceof java.util.List) {
        for (Object ro : (java.util.List) respObj) {
            if (!(ro instanceof java.util.Map)) continue;
            try {
                MicroResponsabilite r = responsabiliteFromJson((java.util.Map) ro);
                // Reconstituer liens croisés
                PosteGenericAgent pPoste = trouverPoste(r.idMicroActivite);
                if (pPoste != null) {
                    if (r.nomMicroActivite.isEmpty()) r.nomMicroActivite = pPoste.nom;
                    if (!pPoste.idsResponsabilites.contains(r.idResponsabilite))
                        pPoste.idsResponsabilites.add(r.idResponsabilite);
                }
                ActeurSC aAct = trouverActeurParId(r.idActeur);
                if (aAct != null) {
                    if (r.nomActeur.isEmpty()) r.nomActeur = aAct.nom;
                    if (r.categorieActeur.isEmpty()) r.categorieActeur = aAct.categorie;
                    aAct.ajouterMicroActivite(r.idMicroActivite);
                }
                // Recalcul seqResponsabilite pour éviter doublons
                try {
                    int num = Integer.parseInt(r.idResponsabilite.replace("RESP_", ""));
                    if (num > seqResponsabilite) seqResponsabilite = num;
                } catch (Exception ignore) {}
                responsabilitesMicro.add(r);
            } catch (Exception ex) { board.logEvent("[JSON WARN] responsabilité ignorée : " + ex.getMessage()); }
        }
    }

    // ── 12. Machines ────────────────────────────────────────────────
    Object machObj = root.get("machines");
    if (machObj instanceof java.util.List) {
        for (Object mo : (java.util.List) machObj) {
            if (!(mo instanceof java.util.Map)) continue;
            try {
                MachineSim mac = machineFromJson((java.util.Map) mo);
                PosteGenericAgent pPoste = trouverPoste(mac.idMicroActivite);
                if (pPoste != null) {
                    if (mac.nomMicroActivite.isEmpty()) mac.nomMicroActivite = pPoste.nom;
                    if (!pPoste.idsMachines.contains(mac.idMachine))
                        pPoste.idsMachines.add(mac.idMachine);
                }
                // Recalcul seqMachineSim
                try {
                    int num = Integer.parseInt(mac.idMachine.replace("MAC_", "").replace("MACHINE_", ""));
                    if (num > seqMachineSim) seqMachineSim = num;
                } catch (Exception ignore) {}
                machinesSim.add(mac);
            } catch (Exception ex) { board.logEvent("[JSON WARN] machine ignorée : " + ex.getMessage()); }
        }
    }

    // ── 13ter. Relayout topologique global : replace TOUS les postes de
    //    facon coherente (profondeur = colonne, bande = acteur), independamment
    //    de l'ordre de creation. Corrige les postes dessines dans la mauvaise bande.
    relayoutTousLesPostes();

    // ── 13bis. Regroupement operationnel global (1 OA par (acteur, SCOR N3)) ──
    // NECESSAIRE apres un chargement JSON : contrairement a l'ajout manuel d'un
    // scenario via l'UI, le chargement JSON ne fusionnait auparavant JAMAIS les
    // OperationalAgent crees 1 par poste -> corrige ici.
    recalculerTousLesGroupesOperationnels();

    // ── 13. Rafraîchir l'UI ─────────────────────────────────────────
    refreshActeursMicroComboBox();
    refreshMicroActiviteComboBox();
    updateRespMachineFieldsVisibility();
    rafraichirComboPostes();
    rafraichirComboScenarios();
    updateActeurAnnexeVisibility();

    // Reconstruit les stations d'animation (viewAnimation) pour representer
    // les acteurs et postes reels du scenario tout juste charge.
    creerStationsAnimation();
    fluxInfoInitialDejaDeclenche = false;
    declencherFluxInformationInitiale();

    messageStatut = "Config JSON chargée : " + postes.size() +
        " postes, " + scenarios.size() + " scénarios.";
    getExperimentHost().showMessageDialog(
        "✅ Configuration JSON chargée avec succès\n\n"
        + "Fichier : " + fichier + "\n"
        + "Acteurs          : " + acteursSC.size() + "\n"
        + "Micro-activités  : " + postes.size() + "\n"
        + "Responsabilités  : " + responsabilitesMicro.size() + "\n"
        + "Machines         : " + machinesSim.size() + "\n"
        + "Scénarios        : " + scenarios.size() + "\n\n"
        + "Vous pouvez maintenant démarrer la simulation."
    );

} catch (java.io.FileNotFoundException ex) {
    messageStatut = "Fichier JSON introuvable : " + scenarioJsonFileName();
    getExperimentHost().showMessageDialog(
        "❌ Fichier introuvable\n\n" +
        "Fichier attendu : " + scenarioJsonFileName() + "\n\n" +
        "Vérifiez que le fichier existe dans le répertoire de travail d'AnyLogic\n" +
        "(le même dossier que le fichier .alp).");
} catch (Exception ex) {
    messageStatut = "Erreur chargement JSON : " + ex.getMessage();
    getExperimentHost().showMessageDialog(
        "❌ Erreur de chargement JSON\n\n" + ex.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1782600000023</Id>
					<Name><![CDATA[migrerConfigCsvVersJson]]></Name>
					<X>-300</X><Y>980</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Migration optionnelle : charge le CSV existant puis sauvegarde en JSON
try {
    chargerConfig();   // Charge depuis le CSV historique
    sauverScenarioJSON(); // Exporte immédiatement en JSON
    messageStatut = "Migration CSV -> JSON réussie : " + scenarioJsonFileName();
    getExperimentHost().showMessageDialog(
        "✅ Migration CSV → JSON terminée\n\n" +
        "Le fichier JSON a été créé : " + scenarioJsonFileName() + "\n" +
        "Vous pouvez maintenant utiliser les boutons JSON.");
} catch (Exception ex) {
    messageStatut = "Erreur migration CSV->JSON : " + ex.getMessage();
    getExperimentHost().showMessageDialog(
        "❌ Erreur lors de la migration CSV → JSON\n\n" + ex.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781183582575</Id>
					<Name><![CDATA[kpiParPosteText]]></Name>
					<X>-300</X><Y>470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int[] w = {12, 18, 8, 8, 10, 10, 8, 8};

    StringBuilder sb = new StringBuilder();

    sb.append(tableTitle(
        "KPI PAR POSTE — AFFICHAGE DYNAMIQUE",
        w
    ));

    sb.append(tableRow(new String[]{
        "ID Poste",
        "Nom",
        "SCOR",
        "N",
        "CT moy",
        "WT moy",
        "File",
        "PCE%"
    }, w)).append("\n");

    sb.append(tableLine(w)).append("\n");

    if (postes.isEmpty()) {
        sb.append(tableRow(new String[]{
            "-", "Aucun poste", "-", "0", "0", "0", "0", "0"
        }, w)).append("\n");

        sb.append(tableLine(w)).append("\n");
        return sb.toString();
    }

    for (PosteGenericAgent p : postes) {
        KPIBundle k = null;

        if (board.kpiParMicroActivite != null) {
            k = board.kpiParMicroActivite.get(p.idPoste);
        }

        if (k == null) {
            k = board.kpiParPoste.get(cleKPI(p));
        }

        long n = k != null ? k.count : 0;
        double ct = k != null ? k.avgCycleTime() : 0;
        double wt = k != null ? k.avgWaitTime() : 0;
        double pce = k != null ? k.pce() * 100 : 0;

        int file = 0;
        try {
            file = p.queue.size();
        } catch (Exception ex) {
            file = 0;
        }

        sb.append(tableRow(new String[]{
            p.idPoste,
            p.nom,
            p.codeSCOR,
            String.valueOf(n),
            fmt2(ct),
            fmt2(wt),
            String.valueOf(file),
            fmt1(pce)
        }, w)).append("\n");
    }

    sb.append(tableLine(w)).append("\n");

    return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781183745912</Id>
					<Name><![CDATA[dernierLogEvenementsText]]></Name>
					<X>-300</X><Y>510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (board == null || board.logEvenements == null || board.logEvenements.isEmpty()) {
    return "Aucun événement enregistré pour le moment.";
}

String log = "";

java.util.List<String> evts = board.logEvenements;

int debut = Math.max(0, evts.size() - 20);

for (int i = debut; i < evts.size(); i++) {
    log += evts.get(i) + "\n";
}

return log;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781184097296</Id>
					<Name><![CDATA[pceGlobalText]]></Name>
					<X>-300</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (board == null || board.kpiGlobal == null) {
    return "PCE Global : non disponible";
}

double pce = board.kpiGlobal.pce() * 100;

String barre = "";

int nb = (int)(pce / 5);

// Sécurité : éviter que nb dépasse 20 si pce > 100
nb = Math.max(0, Math.min(20, nb));

for (int i = 0; i < 20; i++) {
    barre += (i < nb ? "█" : "░");
}

return String.format("PCE Global : %s %.1f%%", barre, pce);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1781900000031</Id>
					<Name><![CDATA[orderLeadTimeText]]></Name>
					<X>-300</X><Y>860</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double mts = board.nbMTS > 0 ? (board.sumLeadTimeMTS / board.nbMTS) / 60.0 : 0;
double mto = board.nbMTO > 0 ? (board.sumLeadTimeMTO / board.nbMTO) / 60.0 : 0;
double glob = board.kpiGlobal.avgLeadTime() / 60.0;
return "MTS : " + String.format("%.1f", mts) + " min\n"
     + "MTO : " + String.format("%.1f", mto) + " min\n"
     + "Global : " + String.format("%.1f", glob) + " min";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
