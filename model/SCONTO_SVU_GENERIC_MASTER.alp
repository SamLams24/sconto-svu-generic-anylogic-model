				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1910000000004</Id>
					<Name><![CDATA[syntheseFinaleS1Rows]]></Name>
					<X>2350</X><Y>4900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.ArrayList<Object[]> rows=new java.util.ArrayList<Object[]>();
long nSource=0,nMake=0,nDeliver=0;
try{KPIBundle k=board.kpiParMacro.get("sS");if(k!=null)nSource=k.count;}catch(Throwable ignored){}
try{KPIBundle k=board.kpiParMacro.get("sM");if(k!=null)nMake=k.count;}catch(Throwable ignored){}
try{KPIBundle k=board.kpiParMacro.get("sD");if(k!=null)nDeliver=k.count;}catch(Throwable ignored){}
String casObserve=(nSource==0&&nMake==0&&nDeliver>0)?"Cas 1 — livraison directe":((nSource==0&&nMake>0&&nDeliver>0)?"Cas 2 — production":((nSource>0&&nMake>0&&nDeliver>0)?"Cas 3 — approvisionnement + production":"Run en cours / non classé"));
double pi=strategic!=null?strategic.calculerPIGlobal():0.0;
rows.add(new Object[]{"Moteur de performance C14.1","VALIDÉ / FIGÉ","Cas 1, Cas 2 et Cas 3 validés avant C14","Valeur SCOR réelle → score 0..10 → fuzzy → attributs → PI","Pipeline SCOR vers PI ; Traçabilité performance","Bottom/perfect terrain à calibrer avant campagne expérimentale finale"});
rows.add(new Object[]{"Run courant",casObserve,"Source="+nSource+" ; Make="+nMake+" ; Deliver="+nDeliver+" ; PI="+fmt3(pi)+"/10","Le scénario est identifié depuis les flux réellement observés, pas depuis le nom du profil.","Dashboard Macro ; Flux Supply Chain","Aucune"});
rows.add(new Object[]{"Theeranuphattana / Chan-Qi adapté","VALIDÉ","Self-test : POF=6.700, B=.350, C=.650, PI référence=4.050","AHP stratégique n'est pas utilisé pour le PI.","Traçabilité performance","Poids experts configurés à documenter/calibrer"});
rows.add(new Object[]{"Ontologies C14","ACTIVES","Core 4.3.0 ; Agent 1.1.2 ; AER 1.1.2","Les attributs RL/RS/AG/CO/AM ne sont plus exportés comme pseudo-métriques N1.","ABox TTL","Validation OWL finale après génération du run"});
rows.add(new Object[]{"ABox runtime",aboxExportActif?"ACTIVE":"DESACTIVEE","exports="+nbExportsABox+" ; dernier="+(dernierFichierABox==null?"":dernierFichierABox),"Snapshot global synchronisé à la clôture de commande.",dernierFichierABox==null?"":dernierFichierABox,"Le reasoner sera exécuté sur l'ABox générée"});
rows.add(new Object[]{"ISA-95","VALIDÉ","nœuds="+isa95Hierarchy.size()+" ; affectations="+isa95Assignments.size(),"Structure industrielle conservée.","Architecture agents ; ABox TTL","Aucune"});
rows.add(new Object[]{"Architecture holonique","VALIDÉ","Coordinateurs="+supervisorsMacro.size()+" ; Pilotage="+agentsSuperviseurs.size()+" ; Exécution="+agentsExecution.size(),"Strategic > Tactical > Coordinator > OperationalPilot > OperationalExecution","Architecture agents ; Audit propagation AER","Aucune"});
rows.add(new Object[]{"Export Excel C14","ACTIVE","exports="+nbExportsExcelRealises+" ; fichier="+excelFileName(),"Le dernier export de clôture est généré juste après l'ABox au même temps simulation.",excelFileName(),"Les exports périodiques sont gelés après le snapshot final afin de ne pas écraser la preuve de clôture"});
return rows.toArray(new Object[0][]);]]></Body>
				</Function>
