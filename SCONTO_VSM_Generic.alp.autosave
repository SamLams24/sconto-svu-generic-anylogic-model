    enregistrerTraceExecutionCommande(cmd, "sD1.6.1",  "D1.6",  "PLANIFICATION_ITINERAIRE_DIRECT", 2.0, 0.0, cmd.qte, "Planification de l'itinéraire de livraison directe");
    enregistrerTraceExecutionCommande(cmd, "sD1.7.1",  "D1.7",  "SELECTION_TRANSPORTEUR_DIRECT", 1.5, 0.0, cmd.qte, "Sélection transporteur livraison directe");
    enregistrerTraceExecutionCommande(cmd, "sD1.8.1",  "D1.8",  "RECEPTION_PRODUIT_STOCK_DIRECT", 1.0, 0.0, cmd.qte, "Réception du produit depuis le stock pour Deliver");
    enregistrerTraceExecutionCommande(cmd, "sD1.9.1",  "D1.9",  "PRELEVEMENT_STOCK_DIRECT", 2.0, 0.0, cmd.qte, "Prélèvement stock fini pour livraison directe");
    enregistrerTraceExecutionCommande(cmd, "sD1.10.1", "D1.10", "CONDITIONNEMENT_DIRECT", 2.0, 0.0, cmd.qte, "Conditionnement livraison directe");
