				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1781962000001</Id>
					<Name><![CDATA[microActivitesColumns]]></Name>
					<X>-440</X><Y>3440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Identifiant du poste",
    "Nom de la micro-activite",
    "Code SCOR (niveau 3)",
    "Acteur responsable",
    "Categorie de l'acteur responsable",
    "Type de poste (Delai/Stockage/Aiguillage/Sink)",
    "Loi de temps de traitement : distribution(p1,p2)",
    "Capacite simultanee (entites en parallele)",
    "Postes precedents dans le flux (chaine)",
    "Taux de valeur ajoutee (0 a 1, part du temps comptee comme VA)",
    "Cout horaire main d'oeuvre (devise/h, 0=non renseigne)",
    "Cout matiere premiere par unite traitee (devise/unite, 0=non renseigne)",
    "Valeur de l'actif fixe declaree (devise, informatif, 0=non renseigne)"
};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781962000002</Id>
					<Name><![CDATA[microActivitesRows]]></Name>
					<X>-440</X><Y>3470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (postes == null || postes.isEmpty()) {
    return emptyRows("Aucune micro-activité configurée", microActivitesColumns().length);
}

Object[][] rows = new Object[postes.size()][microActivitesColumns().length];

for (int i = 0; i < postes.size(); i++) {
    PosteGenericAgent p = postes.get(i);

    String loi = "-";
    if (p.loiTemps != null) {
        loi = p.loiTemps.distribution + "(" + fmt2(p.loiTemps.p1) + "," + fmt2(p.loiTemps.p2) + ")";
    }

    String precedents = p.chainesPrecedents != null && !p.chainesPrecedents.trim().isEmpty()
        ? p.chainesPrecedents
        : "-";

    rows[i][0] = p.idPoste;
    rows[i][1] = p.nom;
    rows[i][2] = p.codeSCOR;
    rows[i][3] = p.nomActeurResponsable;
    rows[i][4] = p.categorieActeurResponsable;
    rows[i][5] = String.valueOf(p.typePoste);
    rows[i][6] = loi;
    rows[i][7] = String.valueOf(p.capaciteSimultanee);
    rows[i][8] = precedents;
    rows[i][9] = fmt2(p.tauxVA);
    rows[i][10] = p.coutHoraireMainOeuvre > 0 ? fmt2(p.coutHoraireMainOeuvre) : "0 (non renseigne)";
    rows[i][11] = p.coutMatierePremiereParUnite > 0 ? fmt2(p.coutMatierePremiereParUnite) : "0 (non renseigne)";
    rows[i][12] = p.valeurActifFixe > 0 ? fmt2(p.valeurActifFixe) : "0 (non renseigne)";
}

return rows;]]></Body>
				</Function>
