				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String[]]]></ReturnType>
					<Id>1781969000001</Id>
					<Name><![CDATA[n3ToN1Columns]]></Name>
					<X>-440</X><Y>4260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return new String[] {
    "Attribut SCOR (RL/RS/AG/CO/AM)",
    "Nom métier de la métrique (anglais / français)",
    "Code SCOR et niveau (N1/N2/N3 ou proxy)",
    "Valeur brute mesurée",
    "Unité de la valeur brute",
    "Valeur normalisée [0..1] (plus haut = meilleur)",
    "Poids dans l'attribut",
    "Poids personnalisé par l'utilisateur ?",
    "Contribution au score de l'attribut (norm. x poids)",
    "Rôle dans le calcul",
    "Source / preuve de calcul"
};]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Object[][]]]></ReturnType>
					<Id>1781969000002</Id>
					<Name><![CDATA[n3ToN1Rows]]></Name>
					<X>-440</X><Y>4290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[strategic.calculerPIGlobal();

java.util.ArrayList<Object[]> lignes = new java.util.ArrayList<Object[]>();

String[] attrs = {"RL", "RS", "AG", "CO", "AM"};

for (String attr : attrs) {
    java.util.ArrayList<MetriqueN3> lst = strategic.detailN3.get(attr);

    if (lst == null || lst.isEmpty()) continue;

    for (MetriqueN3 m : lst) {
        double contribution = m.valeurNorm * m.poids;
        boolean personnalise = strategic.poidsN3Personnalises.containsKey(m.nom);
        String role = (m.poids == 0)
            ? "Informatif uniquement (hors score, pas de reference comparative)"
            : "Contribue au score de l'attribut " + attr;

        lignes.add(new Object[] {
            attr,
            m.nom,
            m.codeOfficielSCOR == null || m.codeOfficielSCOR.isEmpty() ? "(proxy)" : m.codeOfficielSCOR,
            fmt3(m.valeurBrute),
            m.unite == null || m.unite.isEmpty() ? "-" : m.unite,
            fmt3(m.valeurNorm),
            fmt3(m.poids),
            personnalise ? "Oui" : "Non (1/N par defaut)",
            fmt3(contribution),
            role,
            sourcePreuveMetriqueN3(m.nom, m.valeurBrute)
        });
    }
}

if (lignes.isEmpty()) {
    return emptyRows("Aucune métrique N3 disponible", n3ToN1Columns().length);
}

return lignes.toArray(new Object[0][]);]]></Body>
				</Function>
